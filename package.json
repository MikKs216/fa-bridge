{
  "name": "fa-bridge",
  "displayName": "FA Bridge",
  "publisher": "fa-dev",
  "description": "Propojení Cursor/VS Code s editorem FormStudio (FA)",
  "version": "0.11.29",
  "repository": {
    "type": "git",
    "url": "https://github.com/fa-dev/fa-bridge"
  },
  "engines": {
    "vscode": "^1.70.2"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "FA Bridge",
      "properties": {
        "faBridge.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Povolit Pascal snippety (function, procedure, if, for, try, atd.)"
        },
        "faBridge.autoOpenPanel": {
          "type": "boolean",
          "default": true,
          "description": "Automaticky otevřít FA Bridge panel v levém panelu při spuštění"
        },
        "faBridge.faCompatibleHotkeys": {
          "type": "boolean",
          "default": false,
          "description": "Horké klávesy kompatibilní s FA (Ctrl+Q místo Alt+Q pro přepnutí do FA, Shift+Ctrl+C místo Shift+Alt+C, Shift+Ctrl+F místo Shift+Alt+F)"
        },
        "faBridge.enableFileHistory": {
          "type": "boolean",
          "default": true,
          "description": "Ukládat historii změn editovaných souborů do složky .history"
        },
        "faBridge.autoSwitchTheme": {
          "type": "boolean",
          "default": false,
          "description": "Automaticky přepínat mezi FA theme a původním theme podle typu projektu (FA projekt = automaticky FA theme)"
        },
        "faBridge.preferredTheme": {
          "type": "string",
          "default": "FA Pascal Light",
          "enum": [
            "FA Pascal Light",
            "FA Pascal Dark"
          ],
          "description": "Preferované FA barevné schéma pro FA projekty (použije se při autoSwitchTheme)"
        },
        "local-history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Zapnout/vypnout historii souborů. Když je vypnutá, panel HISTORIE se skryje."
        },
        "faHistory.maxFiles": {
          "type": "number",
          "default": 50,
          "description": "Maximální počet souborů zobrazených v panelu historie"
        },
        "faHistory.showDates": {
          "type": "boolean",
          "default": true,
          "description": "Zobrazovat datumy u verzí v panelu historie"
        }
      }
    },
    "commands": [
      {
        "command": "faBridge.setLightTheme",
        "title": "FA Bridge: Přepnout na světlý motiv"
      },
      {
        "command": "faBridge.setDarkTheme",
        "title": "FA Bridge: Přepnout na tmavý motiv"
      },
      {
        "command": "faBridge.ulozitSoubor",
        "title": "FA Bridge: Uložit soubor",
        "category": "FA Bridge",
        "description": "Uloží aktuální soubor do historie a aktivuje FA aplikaci (F2, Alt+Q)"
      },
      {
        "command": "faBridge.faDoPopredi",
        "title": "FA Bridge: FA do popředí",
        "category": "FA Bridge",
        "description": "Aktivuje FA aplikaci do popředí bez ukládání souboru (F1)"
      },
      {
        "command": "faBridge.toggleMsgv",
        "title": "FA Bridge: Toggle msgv"
      },
      {
        "command": "faBridge.toggleField",
        "title": "FA Bridge: Toggle field"
      },
      {
        "command": "faBridge.vlozitUdajSBody",
        "title": "FA Bridge: Vložit [.udaj.]"
      },
      {
        "command": "faBridge.vlozitUdajSDvojteckami",
        "title": "FA Bridge: Vložit [:udaj:]"
      },
      {
        "command": "faBridge.hledatOdZacatku",
        "title": "FA Bridge: Hledat od začátku"
      },
      {
        "command": "faBridge.openHelp",
        "title": "FA Bridge: Help (Ctrl+F1)",
        "category": "FA Bridge",
        "description": "Otevře HTML help s tématem podle slova pod kurzorem"
      },
      {
        "command": "faBridge.openFaChm",
        "title": "FA Bridge: Otevřít FA.chm (Ctrl+Alt+F1)",
        "category": "FA Bridge",
        "description": "Otevře FA.chm help soubor"
      },
      {
        "command": "faBridge.openTextSearch",
        "title": "FA Bridge: Hledat v TextSearch (Shift+Ctrl+F1)",
        "category": "FA Bridge",
        "description": "Otevře TextSearch.exe se slovem pod kurzorem"
      },
      {
        "command": "faBridge.showIntelliSenseStats",
        "title": "FA Bridge: Zobrazit statistiky IntelliSense"
      },
      {
        "command": "faBridge.goToDefinition",
        "title": "FA Bridge: Go To Definition",
        "category": "FA Bridge",
        "description": "Přejít na definici funkce nebo procedury (pouze F12, pouze v aktuálním souboru)"
      },
      {
        "command": "faBridge.compareWithPrevious",
        "title": "FA Bridge: Porovnat s předchozí verzí"
      },
      {
        "command": "faBridge.showHistoryVersions",
        "title": "FA Bridge: Zobrazit historii verzí"
      },
      {
        "command": "faHistory.showDiff",
        "title": "Zobrazit rozdíly",
        "icon": "$(diff)"
      },
      {
        "command": "faHistory.restoreFile",
        "title": "Vrátit stav souboru do tohoto bodu",
        "icon": "$(history)"
      },
      {
        "command": "faHistory.compareWithPrevious",
        "title": "Porovnat s předchozí verzí",
        "icon": "$(diff)"
      },
      {
        "command": "faHistory.refresh",
        "title": "Obnovit historii",
        "icon": "$(refresh)"
      }
    ],
    "languages": [
      {
        "id": "pascal",
        "aliases": [
          "Pascal",
          "Delphi",
          "Object Pascal"
        ],
        "extensions": [
          ".pas",
          ".p",
          ".dfm",
          ".fmx",
          ".dpr",
          ".dpk",
          ".lfm",
          ".lpr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage"
      }
    ],
    "themes": [
      {
        "label": "FA Pascal Light",
        "uiTheme": "vs",
        "path": "./themes/fa-pascal-light.json"
      },
      {
        "label": "FA Pascal Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fa-pascal-dark.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "faBridgeContainer",
          "title": "FA Bridge",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "faBridgeContainer": [
        {
          "id": "faBridgePanel",
          "name": "Příkazy"
        },
        {
          "id": "faBridgeMsgWatch",
          "name": "Msg Watch",
          "when": "true"
        },
        {
          "id": "faHistoryPanel",
          "name": "HISTORIE",
          "when": "config.local-history.enabled != false",
          "description": "Historie aktuálně otevřeného souboru"
        },
        {
          "id": "faBridgeHelp",
          "name": "NÁPOVĚDA"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "faHistory.compareWithPrevious",
          "when": "view == faHistoryPanel && viewItem == historyPatch",
          "group": "navigation"
        },
        {
          "command": "faHistory.restoreFile",
          "when": "view == faHistoryPanel && viewItem == historyPatch",
          "group": "actions"
        }
      ],
      "view/title": [
        {
          "command": "faHistory.refresh",
          "when": "view == faHistoryPanel",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "faBridge.ulozitSoubor",
        "key": "f2",
        "mac": "alt+f2",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.faDoPopredi",
        "key": "f1",
        "mac": "f1",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.faDoPopredi",
        "key": "alt+q",
        "mac": "alt+q",
        "when": "faBridge.isActive && !config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.faDoPopredi",
        "key": "ctrl+q",
        "mac": "cmd+q",
        "when": "faBridge.isActive && config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.vlozitNazevUdaje",
        "key": "alt+x",
        "mac": "alt+x",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.vlozitNazevUdaje",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.kopirovatNazevUdaje",
        "key": "shift+alt+c",
        "mac": "shift+alt+c",
        "when": "faBridge.isActive && !config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.kopirovatNazevUdaje",
        "key": "shift+ctrl+c",
        "mac": "shift+cmd+c",
        "when": "faBridge.isActive && config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.najitUdaj",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "-cursorUndo",
        "key": "ctrl+u",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.hledatPodleAktUdaje",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "faBridge.isActive && !config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.hledatPodleAktUdaje",
        "key": "shift+ctrl+f",
        "mac": "shift+cmd+f",
        "when": "faBridge.isActive && config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.toggleMsgv",
        "key": "alt+f9",
        "mac": "alt+f9",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.toggleField",
        "key": "alt+a",
        "mac": "alt+a",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.vlozitUdajSBody",
        "key": "shift+ctrl+[",
        "mac": "shift+cmd+[",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.vlozitUdajSDvojteckami",
        "key": "shift+ctrl+]",
        "mac": "shift+cmd+]",
        "when": "faBridge.isActive && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.hledatOdZacatku",
        "key": "alt+l",
        "mac": "alt+l",
        "when": "faBridge.isActive && !config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.hledatOdZacatku",
        "key": "alt+f",
        "mac": "alt+f",
        "when": "faBridge.isActive && config.faBridge.faCompatibleHotkeys && editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.goToDefinition",
        "key": "f12",
        "mac": "f12",
        "when": "editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.openHelp",
        "key": "ctrl+f1",
        "mac": "cmd+f1",
        "when": "editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.openFaChm",
        "key": "ctrl+alt+f1",
        "mac": "cmd+alt+f1",
        "when": "editorTextFocus && editorLangId == 'pascal'"
      },
      {
        "command": "faBridge.openTextSearch",
        "key": "ctrl+shift+f1",
        "mac": "cmd+shift+f1",
        "when": "editorTextFocus && editorLangId == 'pascal'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
