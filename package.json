{
  "name": "fa-bridge",
  "displayName": "FA Bridge",
  "publisher": "fa-dev",
  "description": "Propojení Cursor/VS Code s editorem FormStudio (FA)",
	"version": "0.5.25",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "FA Bridge",
      "properties": {
        "faBridge.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Povolit Pascal snippety (function, procedure, if, for, try, atd.)"
        },
        "faBridge.fsbridgePath": {
          "type": "string",
          "default": "D:\\FA DESIGN\\DataPrg\\Scripts\\.fsbridge",
          "description": "Cesta k .fsbridge složce pro komunikaci s FA (např. D:\\FA DESIGN\\DataPrg\\Scripts\\.fsbridge)"
        }
      }
    },
    "commands": [
      {
        "command": "faBridge.setLightTheme",
        "title": "FA Bridge: Přepnout na světlý motiv"
      },
      {
        "command": "faBridge.setDarkTheme",
        "title": "FA Bridge: Přepnout na tmavý motiv"
      },
      {
        "command": "faBridge.ulozitSoubor",
        "title": "FA Bridge: Uložit soubor"
      },
      {
        "command": "faBridge.toggleMsgv",
        "title": "FA Bridge: Toggle msgv"
      },
      {
        "command": "faBridge.toggleField",
        "title": "FA Bridge: Toggle field"
      },
      {
        "command": "faBridge.vlozitUdajSBody",
        "title": "FA Bridge: Vložit [.udaj.]"
      },
      {
        "command": "faBridge.vlozitUdajSDvojteckami",
        "title": "FA Bridge: Vložit [:udaj:]"
      },
      {
        "command": "faBridge.hledatOdZacatku",
        "title": "FA Bridge: Hledat od začátku"
      },
      {
        "command": "faBridge.showIntelliSenseStats",
        "title": "FA Bridge: Zobrazit statistiky IntelliSense"
      }
    ],
    "languages": [
      {
        "id": "pascal",
        "aliases": ["Pascal", "Delphi", "Object Pascal"],
        "extensions": [".pas", ".p", ".dfm", ".fmx", ".dpr", ".dpk", ".lfm", ".lpr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage"
      }
    ],
    "themes": [
      {
        "label": "FA Pascal Light",
        "uiTheme": "vs",
        "path": "./themes/fa-pascal-light.json"
      },
      {
        "label": "FA Pascal Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fa-pascal-dark.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "faBridgeContainer",
          "title": "FA Bridge",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "faBridgeContainer": [
        {
          "id": "faBridgePanel",
          "name": "Příkazy"
        },
        {
          "id": "faBridgeMsgWatch",
          "name": "Msg Watch",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.faBridgeContainer",
        "key": "shift+alt+f",
        "mac": "shift+alt+f"
      },
      {
        "command": "faBridge.ulozitSoubor",
        "key": "alt+q",
        "mac": "alt+q"
      },
      {
        "command": "faBridge.ulozitSoubor",
        "key": "ctrl+s",
        "mac": "cmd+s"
      },
      {
        "command": "faBridge.vlozitNazevUdaje",
        "key": "alt+x",
        "mac": "alt+x"
      },
      {
        "command": "faBridge.vlozitNazevUdaje",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v"
      },
      {
        "command": "faBridge.kopirovatNazevUdaje",
        "key": "shift+alt+c",
        "mac": "shift+alt+c"
      },
      {
        "command": "faBridge.najitUdaj",
        "key": "shift+alt+l",
        "mac": "shift+alt+l"
      },
      {
        "command": "faBridge.hledatPodleAktUdaje",
        "key": "shift+alt+f",
        "mac": "shift+alt+f"
      },
      {
        "command": "faBridge.toggleMsgv",
        "key": "alt+f9",
        "mac": "alt+f9"
      },
      {
        "command": "faBridge.toggleField",
        "key": "alt+a",
        "mac": "alt+a"
      },
      {
        "command": "faBridge.vlozitUdajSBody",
        "key": "shift+ctrl+[",
        "mac": "shift+cmd+["
      },
      {
        "command": "faBridge.vlozitUdajSDvojteckami",
        "key": "shift+ctrl+]",
        "mac": "shift+cmd+]"
      },
      {
        "command": "faBridge.hledatOdZacatku",
        "key": "shift+alt+z",
        "mac": "shift+alt+z"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
