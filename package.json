{
  "name": "fa-bridge",
  "displayName": "FA Bridge",
  "publisher": "fa-dev",
  "description": "Propojení Cursor/VS Code s editorem FormStudio (FA)",
	"version": "0.5.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Themes",
    "Other"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "FA Bridge",
      "properties": {
        "faBridge.enableSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Povolit Pascal snippety (function, procedure, if, for, try, atd.)"
        },
        "faBridge.fsbridgePath": {
          "type": "string",
          "default": "D:\\FA DESIGN\\DataPrg\\Scripts\\.fsbridge",
          "description": "Cesta k .fsbridge složce pro komunikaci s FA (např. D:\\FA DESIGN\\DataPrg\\Scripts\\.fsbridge)"
        }
      }
    },
    "commands": [
      {
        "command": "faBridge.setLightTheme",
        "title": "FA Bridge: Přepnout na světlý motiv"
      },
      {
        "command": "faBridge.setDarkTheme",
        "title": "FA Bridge: Přepnout na tmavý motiv"
      },
      {
        "command": "faBridge.provestInit",
        "title": "FA Návrh: Provést Init (Shift+Alt+I)",
        "icon": "$(symbol-method)"
      },
      {
        "command": "faBridge.provestCalculate",
        "title": "FA Návrh: Provést Calculate (Shift+Alt+E)",
        "icon": "$(refresh)"
      },
      {
        "command": "faBridge.provestEnable",
        "title": "FA Návrh: Provést Enable (Shift+Alt+N)",
        "icon": "$(check)"
      },
      {
        "command": "faBridge.zobrazitInfo",
        "title": "FA Návrh: Zobrazit Info (Shift+Alt+B)",
        "icon": "$(info)"
      },
      {
        "command": "faBridge.zobrazitPlatebniInformace",
        "title": "FA Návrh: Zobrazit Platební informace (Shift+Alt+P)",
        "icon": "$(credit-card)"
      },
      {
        "command": "faBridge.zobrazitPeriod",
        "title": "FA Návrh: Zobrazit Period (Shift+Alt+R)",
        "icon": "$(calendar)"
      }
    ],
    "languages": [
      {
        "id": "pascal",
        "aliases": ["Pascal", "Delphi", "Object Pascal"],
        "extensions": [".pas", ".p", ".dfm", ".fmx", ".dpr", ".dpk", ".lfm", ".lpr"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage"
      }
    ],
    "themes": [
      {
        "label": "FA Pascal Light",
        "uiTheme": "vs",
        "path": "./themes/fa-pascal-light.json"
      },
      {
        "label": "FA Pascal Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/fa-pascal-dark.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "faBridgeContainer",
          "title": "FA Bridge",
          "icon": "images/icon.png"
        }
      ]
    },
    "views": {
      "faBridgeContainer": [
        {
          "id": "faBridgePanel",
          "name": "Příkazy"
        },
        {
          "id": "faBridgeMsgWatch",
          "name": "Msg Watch",
          "when": "true"
        },
        {
          "id": "faBridgeCommunicationStatus",
          "name": "Stav komunikace",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.faBridgeContainer",
        "key": "shift+alt+f",
        "mac": "shift+alt+f"
      },
      {
        "command": "workbench.action.files.save",
        "key": "alt+q",
        "mac": "alt+q"
      },
      {
        "command": "faBridge.vlozitNazevUdaje",
        "key": "shift+alt+v",
        "mac": "shift+alt+v"
      },
      {
        "command": "faBridge.kopirovatNazevUdaje",
        "key": "shift+alt+c",
        "mac": "shift+alt+c"
      },
      {
        "command": "faBridge.najitUdaj",
        "key": "shift+alt+l",
        "mac": "shift+alt+l"
      },
      {
        "command": "faBridge.provestInit",
        "key": "shift+alt+i",
        "mac": "shift+alt+i"
      },
      {
        "command": "faBridge.provestCalculate",
        "key": "shift+alt+e",
        "mac": "shift+alt+e"
      },
      {
        "command": "faBridge.provestEnable",
        "key": "shift+alt+n",
        "mac": "shift+alt+n"
      },
      {
        "command": "faBridge.zobrazitInfo",
        "key": "shift+alt+b",
        "mac": "shift+alt+b"
      },
      {
        "command": "faBridge.zobrazitPlatebniInformace",
        "key": "shift+alt+p",
        "mac": "shift+alt+p"
      },
      {
        "command": "faBridge.zobrazitPeriod",
        "key": "shift+alt+r",
        "mac": "shift+alt+r"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
