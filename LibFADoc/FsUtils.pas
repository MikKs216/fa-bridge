{-----------------------------------------------------------------------------
UnzipFile
  Rozzipuje soubor do adresare ADstDir. Pokud tam stejne soubory existuji,
  prepise je. Pokud soubor obsahuje podadresare, vyvori je.
-----------------------------------------------------------------------------}
function UnzipFile(const ASrcFileName, ADstDir: string;
  APassword: string = ''): boolean;
var
  unzipper: TVCLUnzip;
  numUnzipped: integer;
begin
  StartWait;
  unzipper := TVCLUnzip.Create(nil);
  try
    with unzipper do begin
      ZipName := ASrcFileName;
      ReadZip;
      DoAll := TRUE;
      DestDir := ADstDir;
      RecreateDirs := TRUE;
      OverwriteMode:=Always;
      RetainAttributes := TRUE;
      PassWord:=APassword;
      numUnzipped:=Unzip;
      Result:=numUnzipped>0;
    end;
  finally
    unzipper.Free;
    StopWait;
  end;
end; {UnzipFile}

