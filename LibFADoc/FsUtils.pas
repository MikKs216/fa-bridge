{-----------------------------------------------------------------------------
StrToDateSafe
  Prevede retezec na TDateTime.
-----------------------------------------------------------------------------}

function StrToDateSafe(const AStr: string): TDateTime;
var
  datStr: string;
begin
  if AStr='' then
    Result := 0
  else if IsDate(AStr) then begin
    try
      Result := StrToDate(AStr);
    except
      Result := 0;
    end;
    if Result=0 then
      try
        datStr:=NormalizeDateStr(AStr);
        Result:=EncodeDate(StrToInt(Copy(datStr, 7, 4)),
          StrToInt(Copy(datStr, 4, 2)), StrToInt(Copy(datStr, 1, 2)));
      except
        Result := 0;
      end;
  end
  else
    Result := 0;
end; {StrToDateSafe}

{-----------------------------------------------------------------------------
DateToStrNorm
  Prevede TDateTime na retezec ve tvaru dd.mm.yyyy.
-----------------------------------------------------------------------------}

function DateToStrNorm(ADate: TDateTime): string;
var
  d, m, y: word;
begin
  Result:='';
  try
    DecodeDate(ADate, y, m, d);
    if (y>0) and (m>0) and (d>0) then
      Result:=Format('%2:d.%2:d.%4.d',[d,m,y]);
  except
  end;
end; {DateToStrNorm}

{-----------------------------------------------------------------------------
NormalizeDateStr
  Vyhodi z datumu v retezci vsechny ostatni znaky nez cisla a tecku
-----------------------------------------------------------------------------}
function NormalizeDateStr(const AStrDate: string):string;
var
  i, p1,p2: integer;
  str,den,mes: string;
begin
  Result:='';
  if (DateFormat = 'M/d/yyyy') or (DateFormat = 'MM/dd/yyyy') then begin
    Result:=AStrDate;
    p1:=Pos('/',AStrDate);
    if p1>0 then begin
      str:=Copy(AStrDate,p1+1,7);
      p2:=Pos('/',str);
      if p2>0 then begin
        den:=Copy(str,1,p2-1);
        if Length(den)=1 then
          den:='0'+den;
        mes:=Copy(AStrDate,1,p1-1);
        if Length(mes)=1 then
          mes:='0'+mes;
        Result:=den+mes+Copy(str,p2+1,4);
      end;
    end;
  end
  else if ((DateFormat<>'d.M.yyyy') and (DateFormat<>'dd.MM.yyyy')) then begin
    Result:=AStrDate;
  end
  else begin
    for i:=1 to Length(AStrDate) do
      if Pos(AStrDate[i],'0123456789.')>0 then
        Result:=Result+AStrDate[i];
  end;
end; {NormalizeDateStr}

