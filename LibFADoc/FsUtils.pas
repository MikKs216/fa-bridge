end; {NormalPath}

function GetUniqueFileName(const APath, AFileName: string): string;
const
  cMax = 1000;
var
  val, path: string;
  n: integer;
begin
  val := '';
  n := 0;
  repeat
    path := NormalPath(APath) + ChangeFileExt(ExtractFileName(AFileName), '') +
      val +
      ExtractFileExt(AFileName);
    INC(n);
    val := '(' + IntToStr(n) + ')';
  until not FileExists(path) or (n = cMax);
  if n = cMax then
    Result := ''
  else
    Result := path;
end; {GetUniqueFileName}

//vyhodi z cesty nebo nazvu souboru nepovolene znaky \ / : * ? " < > |
function CorrectPathName(APathStr: string): string;
var
  i: integer;
begin
  for i:=1 to Length(APathStr) do begin
    case APathStr[i] of
      '\', '/', ':', '*', '?', '"', '<', '>', '|': APathStr[i]:='_';
    end;
  end;
  Result:=APathStr;
end; {CorrectPathName}

