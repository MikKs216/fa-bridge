const
  coCRPDPHServiceHttp = 'http://adisrws.mfcr.cz/adistc/axis2/services/rozhraniCRPDPH.rozhraniCRPDPHSOAP';

// Vraci stav platce, v promenne vysledek text popis, v promenne ucty seznam uctu
// -1 nejde overit, napr. chyba pri pripojeni, nefunkcni sluzba
//  0 DIC nenalezeno
//  1 DIC nalezeno spolehlivy
//  2 DIC nalezeno nespolehlivy
function CheckPlatce(vatno:widestring;
  proxyAddress: string; proxyPort: string; out vysledek:string;
  out ucty:string):integer;
var
  body:utf8string;
  httpx:THttpSend;
  odpoved, nespolehlivyPlatce, ucet:string;
  vysl:Boolean;
  xdoc:IXMLDocument;
  xNodeStatus,xNodeUcty,xNodeUcet:IXMLNode;
  rootNode:IXMLNode;
  nodelist:IXMLNodeList;
  i, j: integer;
begin
  vysledek:='';
  ucty:='';

  Result:=CheckPlatceHttps(vatno, proxyAddress,proxyPort, vysledek, ucty);
  Exit;

  //StartWait;
  try try
    vatno:=Replace('CZ',vatno,'');
    body:=MakeSoapCRPDPHRequest(vatno); //Body pozadavku
    httpx:=ThttpSend.Create();
    try

      httpx.Protocol:='1.1';
      httpx.MimeType:='text/xml';
      httpx.ProxyUser:='';
      httpx.ProxyPass:='';
      if proxyAddress<>'' then begin
        httpx.ProxyHost:=proxyAddress;
        httpx.ProxyPort:=proxyPort;
      end
      else begin
        httpx.ProxyHost := '';
        httpx.ProxyPort := '';
      end;

      WriteStrToStream(httpx.Document, body);
      vysl := httpx.HTTPMethod('POST',coCRPDPHServiceHttp);
      if vysl then begin
        SetString(odpoved, PChar(httpx.Document.Memory), httpx.Document.Size);
        //Mame data z webu zjistime obsah XML
        xdoc:=TXmlDocument.Create(nil);
         try
           xdoc.LoadFromXml(odpoved);
           xdoc.Active:=True;
           nodelist:=xdoc.DocumentElement.ChildNodes;
           rootNode := nodelist.First.ChildNodes.First; //root dat
           if rootNode<>nil then begin
             xNodeStatus:=rootNode.ChildNodes.FindNode('status');
             if xNodeStatus<>nil then begin
               if (VarToStr(xNodeStatus.Attributes['statusCode'])<>'0') and
                 (VarToStr(xNodeStatus.Attributes['statusCode'])<>'1') then begin
                 vysledek:=VarToStr(xNodeStatus.Attributes['statusText']);
                 Result:=-1;
                 EXIT;
               end;

               xNodeStatus:=rootNode.ChildNodes.FindNode('statusPlatceDPH');
               if xNodeStatus=nil then begin
                 vysledek:='Chyba v XML odpovÏdi - nenalezen uzel "statusPlatceDPH"';
                 Result:=-1;
               end;

               nespolehlivyPlatce:=xNodeStatus.Attributes['nespolehlivyPlatce'];
               if nespolehlivyPlatce='NENALEZEN' then begin
                 vysledek:='Pl·tce DI» CZ'+vatno+' NENALEZEN';
                 Result:=0;
                 EXIT;
               end;
               if nespolehlivyPlatce='ANO' then begin
                 vysledek:='Pl·tce DI» CZ'+vatno+' je oznaËen jako NESPOLEHLIV› !!!';
                 Result:=2;
               end;
               if nespolehlivyPlatce='NE' then begin
                 vysledek:='Pl·tce DI» CZ'+vatno+' je veden jako spolehliv˝';
                 Result:=1;
               end;

               if xNodestatus.ChildNodes.Count>0 then begin
                 for i := 0 to xNodeStatus.ChildNodes.Count - 1 do begin
                   if xNodeStatus.ChildNodes[i].NodeName='zverejneneUcty' then begin
                     vysledek:=vysledek + #13#10'Zve¯ejnÏnÈ ˙Ëty:';
                     xNodeUcty:=xNodeStatus.ChildNodes[i];
                     if xNodeUcty.ChildNodes.Count>0 then
                       for j := 0 to xNodeUcty.ChildNodes.Count - 1 do begin
                         if xNodeUcty.ChildNodes[j].NodeName='ucet' then begin
                           xNodeUcet:=xNodeUcty.ChildNodes[j];
                           if xNodeUcet.ChildNodes.Count>0 then begin
                             if xNodeUcet.ChildNodes[0].NodeName='standardniUcet' then begin
                               ucet:=Trim(VarToStr(xNodeUcet.ChildNodes[0].Attributes['predcisli'])+'-'+
                                 VarToStr(xNodeUcet.ChildNodes[0].Attributes['cislo']))+'/'+
                                 VarToStr(xNodeUcet.ChildNodes[0].Attributes['kodBanky']);
                               if Copy(ucet,1,1)='-' then
                                 ucet:=Copy(ucet,2,99);
                               vysledek:= vysledek + #13#10'  ' +ucet;
                               ucty:=ucty + ucet + #13#10;
                             end
                             else if xNodeUcet.ChildNodes[0].NodeName='nestandardniUcet' then
                               vysledek:= vysledek + #13#10'  ' +
                                 VarToStr(xNodeUcet.ChildNodes[0].Attributes['cislo']);

                           end;
                         end;
                       end
                     else
                       vysledek:=vysledek + #13#10'Nem· û·dnÈ zve¯ejnÏnÈ ˙Ëty';
