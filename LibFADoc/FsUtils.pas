function Replace(const ASearch, AStr, AReplace: string;
  AIgnoreCase: boolean = FALSE): string;
var
  s: string;
begin
  if ASearch='' then // osetreni vyjimky v StrReplace
    Result:=AStr
  else begin
    s := AStr;
    try
    if AIgnoreCase then
      StrReplace(s, ASearch, Areplace, [rfReplaceAll, rfIgnoreCase])
    else
      StrReplace(s, ASearch, Areplace, [rfReplaceAll]);
    finally
    end;
    Result := s;
  end;  
end; {Replace}

function QuotedStr(const AString: string): string;
