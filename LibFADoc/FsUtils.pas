//CheckRodneCisloDatNar
//Vychozi funkce pro test platnosti rodneho cisla a ECP (evidencniho cisla pojistence u socialky)
// - ATestProDIC: prevzato z puvodni kontroly
//   - TRUE - pokud se jedna o 9 mistne RC, tak se neprovadi kontrola 12
//          - ACheckECP se prenastavi na FALSE, protoze DIC FO nemuze byt ECP
// - ACheckECP: TRUE - kontroluje RC a ECP
//              FALSE - kontroluje jen RC
// - ADatNar: v parametru vraci datum narozeni v pripade, ze prvnich 6 znaku RC obsahuje validni datum
// - AMsg: v parametru vraci chybove hlaseni

//prevzato z https://www.cssz.cz/standardni-kontrola-rodneho-cisla-a-evidencniho-cisla-pojistence
//"poradi + xy" je odkaz na cislo chyby, resp. poradi, na cssz
//  - chyba 5 - v podmince je zakazan rok 18xx, protoze se to takto chova i ve formulari socialky
//              (a to, ze nekdo zada do RC, kde je rok>53, 9 znaku, je pravdepodobnonejsi, ze se upsal,
//               nez ze se narodil v roce 18xx)

//Pokud po kontrolach 1-12 bude RESULT=FALSE, tak
//datum narozeni bude 0. Jedna se o tyto pripady:
//1. Dojde k chybam 1,2,3
//2. Datum z RC je chybne (6,7,8,9)
//3. ECP za lomitem nezacina cislici 6 (10,11)
//4. Desetimistne RC neni delitene 11 (12)
//V ostatnich pripadech nam funkce vrati platne datum narozeni.
//
//Pokud dojde k chybam 4,5 (res=FALSE), tak RESULT=FALSE,
//jinak, pokud res=TRUE, tak a RESULT=TRUE
function CheckRodneCisloDatNar(const ARodneCislo: string;
                              const ATestProDIC: boolean;
                              ACheckECP: boolean;
                              var ADatNar: TDateTime;
                              var AMsg: string): boolean;
var
  rc,d,m,y,c1,c2: string;
  yy,mm,dd,cc1: integer; 
  isRc, isECP: boolean;
  rok: integer; 
  datNar: TDateTime;
  res, resMod: boolean; 
const
  cChybaP1 = 'RodnÈ ËÌslo nenÌ numerickÈ.'; //1       
  cChybaP2 = 'RodnÈ ËÌslo je kratöÌ neû 9 znak˘.'; //2
  cChybaP3 = 'RodnÈ ËÌslo je delöÌ neû 10 znak˘.'; //3
  cChybaP4 = 'Koncovka rodnÈho ËÌsla "000" je nep¯Ìpustn·.'; //4
  cChybaP5 = 'Kolize E»P a rozöÌ¯enÈho tvaru R».'; //5
  cChybaP6 = 'NeplatnÈ datum narozenÌ v rodnÈm ËÌsle.'; //6
  cChybaP10 = 'Nep¯Ìpustn· koncovka E»P.'; //10,11
  cChybaP12 = 'RodnÈ ËÌslo nenÌ dÏlitelnÈ 11.'; //12
begin
  Result:=TRUE;
  res:=TRUE;
  resMod:=TRUE;
  ADatNar:=0; 
  datNar:=0;
  AMsg:='';
  //
  if ATestProDIC then
    ACheckECP:=FALSE;
  //
  if ARodneCislo='' then
    EXIT;
  rc:=Trim(Replace(' ',ARodneCislo,''));
  if Pos('/',rc)=7 then
    rc:=Copy(rc,1,6)+Copy(rc,8,4); 
  //  
  if (not IsDigit(rc)) then begin                  //poradi 1 - RodnÈ ËÌslo nenÌ numerickÈ.
    Result:=FALSE;
    AMsg:=cChybaP1;
    EXIT;    
  end;
  //  
  if (Length(rc)<9) then begin  //poradi 2 - RodnÈ ËÌslo je kratöÌ, neû 9 znak˘.
    Result:=FALSE; 
    AMsg:=cChybaP2;
    EXIT;    
  end;
  //                         
  if (Length(rc)>10) then begin  //poradi 3 - RodnÈ ËÌslo je delöÌ, neû 10 znak˘.
    Result:=FALSE;
    AMsg:=cChybaP3;
    EXIT;    
  end;
  //  
  y:=Copy(rc,1,2);
  m:=Copy(rc,3,2);
  d:=Copy(rc,5,2);   
  c1:=Copy(rc,7,2);
  c2:=Copy(rc,9,2);
    
  yy:=StrToInt(y);
  mm:=StrToInt(m);
  dd:=StrToInt(d);
  cc1:=StrToInt(c1);
  // 
  if (Length(rc)=9) and ((c1+c2)='000') then begin //poradi 4 - Koncovka rodnÈho ËÌsla 000 je nep¯Ìpustn·.
    AMsg:=cChybaP4;
    res:=FALSE;
    //Result:=FALSE;                                 //komentar, aby se naplnilo datum narozeni
  end;
  //
  isRC:=False; isECP:=False;
  if (mm>50) then                                    //- pokud je mesic > 50, pohlavi je zena, jinak je pohlavi muz
    mm := mm-50;     
  if (mm>20) then begin                              //- mesic je > 20, pri nedostatku RC v ramci dne, viz zak Ë. 53/2004 Sb  
    isRC := TRUE;
    mm := mm-20;    
  end; 
  if ACheckECP then begin   
    if (dd>40) then begin                            //- pokud je den > 40, tak E»P, jinak R»
      isECP := TRUE;    
      dd := dd-40;    
    end;      
  end;
  //                                               
  if (isRC) and (isECP) then begin                 //poradi 5 - Kolize EC a ECP (nevalidnÌ R»/E»P mÏsÌc +20 a z·roveÚ den +40).
    AMsg:=cChybaP5;
    res:=FALSE;
    //Result:=FALSE;                                 //komentar, aby se naplnilo datum narozeni
  end; 
  //
  rok := 0;    
  if (Length(c1+c2)=3) then begin                    //- Pokud dÈlka koncovky = 3, pak
    if (yy>53) then                                    //- pokud ROK > 53, pak
      //rok := StrToInt('18'+y)                        //  ROK = 18RR
      rok := 0                                         //!!!!!  NEODPOVIDA VYSE UVEDENEMU DOKUMENTU, ALE VE FORMULARI SE TO TAKTO CHOVA !!!!!! 
    else                                               //- jinak
      rok := StrToInt('19'+y);                         //  ROK = 19RR
  end                                                  
  else if (Length(c1+c2)=4) then begin               //- Pokud dÈlka koncovky = 4, pak
    if (yy>53) then                                    //- pokud ROK > 53, pak
      rok := StrToInt('19'+y)                          //  ROK = 19RR
    else                                               //- jinak
      rok := StrToInt('20'+y);                         //  ROK = 20RR
  end;
  //                                    
  if not TryEncodeDate(
      rok, mm, dd, datNar) then begin              //poradi 6,7,8,9 - platne/neplatne datum narozeni
    AMsg:=cChybaP6;
    Result:=FALSE;
    EXIT;
  end;
  //
  if isECP and (cc1<60) then begin                 //poradi 10,11 - Nep¯Ìpustn· koncovka E»P (musi byt vetsi jak 6000, resp. 600)
    AMsg:=cChybaP10;
    res:=FALSE;
    Result:=FALSE;                                   //datum narozeni bude 0
  end;                                 
  //
  if ((yy<54) or ATestProDIC) and (Length(rc)=9) then begin //prevzato z puvodni kontroly
    //EXIT; //stare a kratke nelze testovat     //nedelame exit, aby se naplnilo datum narozeni
  end
  else begin  
    if (Length(rc)=10) then begin                //poradi 12 - RodnÈ ËÌslo nenÌ dÏlitelnÈ 11.
      //Result zde nastavujeme na FALSE jen v pripade, ze kontrola na modulo 11=false (resMod=false)
      //- tzn., datum narozeni nastavujeme v pripade, ze je Result=TRUE
      resMod:=((StrToInt(y)+StrToInt(m)+StrToInt(d)+StrToInt(c1)+StrToInt(c2)) mod 11) = 0;  
      if not resMod then begin
        rc:=Copy(rc,1,9);
        resMod:=IsDigit(rc) and ((StrToInt(rc) mod 11)=10);    
      end;
      if not resMod then begin
        AMsg:=cChybaP12;
        Result:=FALSE;                               //datum narozeni bude 0
      end;             
    end;                    
  end; 
  //------zakonceni---
  if Result then
    ADatNar := datNar;
  if not res then  
    Result := FALSE;  
end;

