begin
  Result:=true;
  if AIsMailList then begin
    sMailAdr:=Replace(';',AEmailStr,',');
    sMailAdr:=StrTrimCharRight(sMailAdr,',');
    for i := 0 to CountListItems(sMailAdr) - 1 do begin
      s:=Trim(GetListItem(sMailAdr,i));
      if not IsValidEmailAddr(s) then begin
        Result:= false;
        Break;
      end;
    end;
  end
  else
    Result:=IsValidEmailAddr(AEmailStr);
end;

function ConCatStr(const AStr1, AStr2: string; const ASeparator: string = ','): string;
begin
  if (AStr1<>'') and (AStr2<>'') then
    Result:= AStr1 + ASeparator + AStr2
  else if (AStr1<>'') then
    Result:= AStr1
  else if (AStr2<>'') then
    Result:= AStr2
  else
    Result := '';
end;

//zdroj vypoctu: https://cs.wikipedia.org/wiki/Datov%C3%A1_schr%C3%A1nka
function CheckIDDS(AIdds: string): boolean;
var
  i, n, sum: integer;
  s: string;
const
  cStr = 'abcdefghijkmnpqrstuvwxyz23456789';
begin
  Result:=TRUE;
  if AIdds='' then
    Exit;
  //
  Result := Length(AIdds) = 7;
  if Result then begin
    sum := 0;
    for i := 1 to 6 do begin
      if Pos(AIdds[i], cStr) = 0 then begin
        Result := False;
        Exit;
      end;
      //
      n := Pos(AIdds[i], cStr)-1;
      if (i mod 2) = 0 then
        n := n * 2;
      sum := sum + (n div 32) + (n mod 32);
    end;
    //
    if (sum mod 32) > 0 then
      sum := 32 - (sum mod 32);
    //
    s := Copy(cStr, sum+1, 1);
    //
    Result := (s = AIdds[7]);
  end;
end;

