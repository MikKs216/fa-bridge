{function RCDatNar(ARC: string): TDateTime;
var
  Y, M, D: integer;
begin
  Result:=0;
  ARC := Trim(ARC);
  if Length(ARC) < 9 then
    exit;
  if Pos('/', ARC) >= 0 then
    ARC := StrRemoveChars(ARC, ['/']);
  Y := StrToIntDef(copy(ARC, 1, 2), -1);
  M := StrToIntDef(copy(ARC, 3, 2), -1);
  D := StrToIntDef(copy(ARC, 5, 2), -1);
  if (Y = -1) or (M = -1) or (D = -1) then
    exit;
  if (Y >= 54) and (Length(ARC) = 9) then
    Y := 1800 + Y;
  if (Y < 54) and (Length(ARC) = 9) then
    Y := 1900 + Y;
  if (Y >= 54) and (Length(ARC) = 10) then
    Y := 1900 + Y;
  if (Y < 54) and (Length(ARC) = 10) then
    Y := 2000 + Y;
  case M of
    1..12:; //Je to muz
    21..32: M := M - 20; //Zase muz
    51..62: M := M - 50; //Zena
    71..82: M := M - 70; //Opet zena
  end;
  if M < 0 then
    exit;
  try
    Result := EncodeDate(Y, M, D);
  except
    Result:=0;
  end;
end;}

function Frac2Str(ANum: double; ADigit: integer = -2): string;
var
  n: integer;
begin
  if ADigit >= 0 then
    ADigit := -2;
  n := StrToInt(StrPadRight('1', ADigit * (-1) + 1,'0'));
  Result := StrPadLeft(FloatToStr(Abs(RoundAri(Frac(RoundAri(ANum, ADigit)) * n, 0))), ADigit * (-1), '0');
end; {Frac2Str}

function IntPart2Str(ANum: double; AFormatFloat: boolean = TRUE): string;
begin
 if AFormatFloat then
    Result := FormatFloat(',0',Int(RoundAri(Abs(ANum), -5))) //zmeneno z -2 pro opravu v SK formularich
  else
    Result := FormatFloat('0',Int(RoundAri(Abs(ANum), -5))); //-"-
  if ANum < 0 then
    Result := '-'+Result;
end; {IntPart2Str}

