function IsFloat(const AStr: string): boolean;
begin
  try
    StrToFloat(Replace(cFADecimalSeparator, AStr, DecimalSeparator));
    Result := TRUE;
  except
    Result := FALSE;
  end;
end; {IsFloat}

function IsCurrencyInt(AStr: string): boolean;
begin
  try
    AStr:=Replace(cFADecimalSeparator, AStr, DecimalSeparator);
    StrToFloat(AStr);
    Result:=Pos(DecimalSeparator,AStr)=0;
  except
    Result := FALSE;
  end;
end; {IsFloat}



function IsDate(const AStr: string): boolean;
var
  datStr: string;
begin
  datStr:=NormalizeDateStr(AStr);
  Result := (Copy(datStr, 3, 1) = '.') and (Copy(datStr, 6, 1) = '.') and
    (Copy(datStr, 1, 2) >= '01') and (Copy(datStr, 1, 2) <= '31') and
    (Copy(datStr, 4, 2) >= '01') and (Copy(datStr, 4, 2) <= '12') and
    (Copy(datStr, 7, 4) >= '1000') and (Copy(datStr, 7, 4) <= '2099');
  //pokud ma formalni spravnost tak zjistime jestli je to platne datum
  if Result then
    Result:= IsValidDate(StrToIntSafe(Copy(datStr, 7, 4)),
      StrToIntSafe(Copy(datStr, 4, 2)),StrToIntSafe(Copy(datStr, 1, 2)));
  //kdyz to neni datum s teckama tak proverime jestli to neni s dateseparatorem ze systemu    
  if not Result then
    try
      StrToDate(AStr);
      Result := TRUE;
    except
      Result := FALSE;
    end;
end; {IsDate}

function IsBoolean(const AStr: string): boolean;
begin
  Result := (Uppercase(AStr) = 'TRUE') or (Uppercase(AStr) = 'FALSE') or
    (AStr = '-1') or (AStr = '0');
end; {IsBoolean}

function IsDots(const s: string): boolean;
var
  i: integer;
begin
