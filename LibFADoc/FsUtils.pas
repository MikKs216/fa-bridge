//zjisti jestli jsou vsechny znaky ve stringu velke, specialni znaky nekontroluje
function IsStringUpperCase(const s: string): boolean;
var
  i: integer;
begin
  Result := TRUE;
  for i:=1 to Length(s) do begin
    if Pos(s[i],cLowerChars)>0 then begin
      Result := FALSE;
      BREAK;
    end;
  end;
end;

//zjisti jestli jsou vsechny znaky ve stringu male, specialni znaky nekontroluje
function IsStringLowerCase(const s: string): boolean;
var
  i: integer;
begin
  Result := TRUE;
  for i:=1 to Length(s) do begin
    if Pos(s[i],cUpperChars)>0 then begin
      Result := FALSE;
      BREAK;
    end;
  end;
end;

//zjisti jestli je prvni znak a vsechny znaky za mezerami velke, specialni znaky nekontroluje
function IsStringFirstUpperCase(const s: string): boolean;
var
  i: integer;
begin
  Result := TRUE;
  for i:=1 to Length(s) do begin
    if ((i=1) or (s[i-1]=' ')) and (Pos(s[i],cLowerChars)>0) then begin
      Result := FALSE;
      BREAK;
    end;
  end;
end;

//zmeni prvni znak a vsechny znaky za mezerami na velke
function StringFirstUpperCase(const s: string): string;
var
  i: integer;
begin
  Result := '';
  for i:=1 to Length(s) do
    if (i=1) or (s[i-1]=' ') then
      Result := Result + AnsiUpperCase(s[i])
    else
      Result := Result + s[i];
end;

//zmeni velikost znaku v poradi AA->aa, aa->Aa, jinak->AA
function ChangeStringCase(const s: string): string;
begin
  if IsStringUpperCase(s) then
    Result := AnsiLowerCase(s)
  else if IsStringLowerCase(s) then
    Result := StringFirstUpperCase(s)
  else
    Result := AnsiUpperCase(s);
end;


//RemoveNonLicChar
// Jen v rozmezi
//a-97 z-122
//A-65 Z-90
function RemoveNonLicChar(const s: string): string;
var
  i, o: integer;
  zn: char;
begin
  Result := '';
  for i:=1 to Length(s) do begin
    zn := copy(s, i, 1)[1];
    o := Ord(zn);
    if ((o>=97) and (o<=122)) or
       ((o>=65) and (o<=90)) then
      Result := Result + zn;
  end;
end;

