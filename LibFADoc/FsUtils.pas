{function CheckRodneCislo(const ARodneCislo: string;
  ATestProDIC: boolean = FALSE): boolean;
var
  rc,d,m,y,c1,c2: string;
  yy,mm,dd,cc1,cc2: integer;
  ok: boolean;
begin
  Result:=TRUE;
  if ARodneCislo='' then
    EXIT;
  rc:=Replace(' ',ARodneCislo,''); // vyhodime pripadne mezery pro cizozemce
  if Length(rc)=6 then //kdyz je delka bez mezer 6, muze se jednat o ciziho obcana
    EXIT;
  rc:=Trim(ARodneCislo);
  if Pos('/',rc)=7 then
    rc:=Copy(rc,1,6)+Copy(rc,8,4); // vyhodime pripadne lomitko
  if (Length(rc)=10) or (Length(rc)=9) then begin
    y:=Copy(rc,1,2);
    m:=Copy(rc,3,2);
    d:=Copy(rc,5,2);
    c1:=Copy(rc,7,2);
    c2:=Copy(rc,9,2);
    if not IsInteger(c1) or not IsInteger(c2) or
      not IsInteger(y) or not IsInteger(m) or not IsInteger(d) then begin
      Result:=FALSE;
      EXIT;
    end;
    yy:=StrToInt(y);
    mm:=StrToInt(m);
    dd:=StrToInt(d);
    cc1:=StrToInt(c1);
    cc2:=StrToInt(c2);
    ok:=(mm>0) and (mm<13) or
      ((mm-20)>0) and ((mm-20)<13) or
      ((mm-50)>0) and ((mm-50)<13) or
      ((mm-70)>0) and ((mm-70)<13);
    if not ok or (dd<1) or (dd>31) then begin
      Result:=FALSE;
      EXIT;
    end;
    if ((yy<54) or ATestProDIC) and (Length(rc)=9) then begin
      EXIT; //stare a kratke nelze testovat
    end
    else begin
      Result:=((yy+mm+dd+cc1+cc2) mod 11) = 0;
      if not Result then begin
        rc:=Copy(rc,1,9);
        Result:=IsInteger(rc) and ((StrToInt(rc) mod 11)=10);
      end;
    end;
  end
  else begin
    Result:=FALSE; //delka neni 10 nebo 9 znaku
  end;
end;}

