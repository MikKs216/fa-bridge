//ShellOpenPdf
// Vraci FALSE, pokud neni asociace nebo neexistuje AReaderExePath - je vhodne uzivateli nahlasit
function ShellOpenPdf(const AReaderExePath, ADocumentName: string;
  ACmdType: TShellOpenCmdType; const AIniPath: string; ALicOk: boolean): boolean;
var
  ReaderExecutable, Parameters: string;
  DeviceMode: THandle;
  Device, Driver, Port: array[0..255] of Char;
  paramcount: integer;
begin
  Result:=TRUE;
  paramcount := 0;
  if AReaderExePath='' then
    ReaderExecutable := TrimRight(StrRemoveChars(
      ShellFindExecutable(ADocumentName, ''), ['"', '''']))
  else begin
    ReaderExecutable := AReaderExePath;
    if not FileExists(ReaderExecutable) then
      ReaderExecutable:='';
  end;
  if Pos('PDFEditor.exe',ReaderExecutable) > 0 then begin
    case ACmdType of
      ctOpen: begin
        Parameters := Format('"%s"', [ADocumentName]);
        paramcount := 1;
      end;
      ctPrintDefault: begin
        Parameters := Format('print "%s"', [ADocumentName]);
        paramcount := 2;
      end;
      ctPrintDialog: begin
        Parameters := Format('printdlg "%s"', [ADocumentName]);
        paramcount := 2;
      end;
    end;
    if AIniPath<>'' then begin
      Parameters := Parameters + ' "' + AIniPath + '"';
        paramcount := paramcount + 1;
    end;
    if ALicOk then begin
      if paramcount=1 then
        Parameters := Parameters + ' "" "" "verified"'
      else if paramcount=2 then
        Parameters := Parameters + ' "" "verified"'
      else if paramcount=3 then
        Parameters := Parameters + ' "verified"';
    end;
    //MsgBox Info('',Parameters,MB_OK);
    Win32Check(ShellExecEx(ReaderExecutable, Parameters));
  end
  else if Pos('PDFXCview.exe',ReaderExecutable) > 0 then begin
    case ACmdType of
      ctOpen:
        Parameters := Format('"%s"', [ADocumentName]);
      ctPrintDefault:
        Parameters := Format('/print:default=yes "%s"', [ADocumentName]);
      ctPrintDialog:
        Parameters := Format('/print "%s"', [ADocumentName]);
      ctPrintTo:
        begin
          Printer.GetPrinter(Device, Driver, Port, DeviceMode);
          Parameters := Format('/t "%s" "%s" "%s" "%s"', [ADocumentName, Device,
            Driver, Port]);
        end;
    end;
    Win32Check(ShellExecEx(ReaderExecutable, Parameters));
  end
  else if ReaderExecutable <> '' then begin
    case ACmdType of
      ctOpen:
        Parameters := Format('"%s"', [ADocumentName]);
      ctPrintDefault:
        Parameters := Format('/p /h "%s"', [ADocumentName]);
      ctPrintDialog:
        Parameters := Format('/p "%s"', [ADocumentName]);
      ctPrintTo:
        begin
          Printer.GetPrinter(Device, Driver, Port, DeviceMode);
          Parameters := Format('/t "%s" "%s" "%s" "%s"', [ADocumentName, Device,
            Driver, Port]);
        end;
    end;
    Win32Check(ShellExecEx(ReaderExecutable, Parameters));
  end
  else
    Result:=FALSE;
end;

