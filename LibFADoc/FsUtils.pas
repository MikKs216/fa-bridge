const
  Pr: array[1..19] of extended = (
    0.9, 0.99, 0.999, 0.9999, 0.99999, 0.999999, 0.9999999, 0.99999999,
    0.999999999, 0.9999999999, 0.99999999999, 0.999999999999, 0.9999999999999,
    0.99999999999999, 0.999999999999999, 0.9999999999999999,
    0.99999999999999999, 0.999999999999999999, 0.999999999999999999);

function IntPr(AValue: extended): extended;
var
  val: TFloatRec;
  dig: integer;
begin
  Result := Int(AValue);
  FloatToDecimal(val, Result, fvExtended, 18, 9999);
  dig := Max(Low(Pr), -4 + Min(19 - val.Exponent, High(Pr)));
  if (dig >= Low(Pr)) and (dig <= High(Pr)) then
    if Abs(Frac(AValue)) >= Pr[dig] then
      if AValue >= 0 then
        Result := Result + 1
      else
        Result := Result - 1
end;

function FracPr(AValue: Extended): Extended;
var
  val: TFloatRec;
  dig: integer;
begin
  Result := Frac(AValue);
  FloatToDecimal(val, AValue, fvExtended, 18, 9999);
  dig := Max(Low(Pr), -4 + Min(19 - val.Exponent, High(Pr)));
  if (dig >= Low(Pr)) and (dig <= High(Pr)) then
    if ABS(Result) >= Pr[dig] then
      Result := 0;
end;

function RoundPr(AValue: extended): extended;
begin
  if AValue > 0 then
    Result := IntPr(AValue + 0.5)
  else
    Result := IntPr(AValue - 0.5)
end; {RoundEx}

function RoundAri(const AValue: extended; const ADigit: integer = -2): extended;
begin
  Result := RoundPr(AValue * Power(10, -ADigit)) / Power(10, -ADigit);
end;

function RoundUp(const AValue: extended; const ADigit: integer = -2): extended;
var
  sgn: integer;
  val: TFloatRec;
begin
  if AValue = 0 then
    Result := 0
  else begin
    if AValue >= 0 then
      sgn := 1
    else
      sgn := -1;
    Result := IntPr(Abs(AValue) * Power(10, -ADigit)) / Power(10, -ADigit);
    FloatToDecimal(val, Result, fvExtended, 18, 9999);
    if Abs(Result - Abs(AValue)) <
      Power(10, -Max(-20, Min(19 - val.Exponent, 20) - 4)) then
      Result := sgn * Result
    else
      Result := sgn * (Result + Power(10, ADigit))
  end;
end;

function RoundDown(const AValue: extended; const ADigit: integer): extended;
begin
  Result := IntPr(AValue * Power(10, -ADigit)) / Power(10, -ADigit);
end;

//Zaohrouhleni na poloviny
// 1.24 -> 1
// 1.45 -> 1.5
// 1.7 -> 1.5
// 1.82 -> 2
//

function RoundHalfAri(const AValue: extended): extended;
var
  fr: extended;
begin
  fr := Int(Frac(AValue) * 100);
  if (fr >= 0) and (fr < 25) then
    fr := 0
  else if (fr >= 25) and (fr < 75) then
    fr := 0.5
  else if fr >= 75 then
    fr := 1;
  Result := Int(AValue) + fr;
end; {RoundHalfAri}

//Zaohrouhleni na poloviny nahoru
// 1.1 -> 1.5
// 1.6 -> 2

function RoundHalfUp(const AValue: extended): extended;
var
  fr: extended;
begin
  fr := Int(Frac(AValue) * 100);
  if fr = 0 then
    fr := 0
  else if (fr > 0) and (fr <= 50) then
    fr := 0.5
  else if fr > 50 then
    fr := 1;
  Result := Int(AValue) + fr;
end; {RoundHalfAri}

