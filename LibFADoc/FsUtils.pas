  procedure RozeberTextAdresu(const AAdrTxt: string;
    out AUlice: string; out AMisto: string; out APSC: string);
  var c,rad,psc: string;
    sl:TStringList;
    i, radekSPSC: Integer;

    procedure HledejPsc;
    var i: Integer;
    begin
      for i:= 0 to sl.Count - 1 do begin
        sl[i]:=Trim(sl[i]);
        rad:=Replace(' ',sl[i],'');
        if Copy(rad,1,3)='PS»' then begin
          APSC:=Copy(rad,4,5);
          radekSPSC:=i;
          Break;
          Exit;
        end;
        psc:=Copy(rad,1,5);
        if IsInteger(psc) then begin
          APSC:=Trim(Copy(rad,1,5));
          AMisto:=Trim(Copy(sl[i],7,200));
          radekSPSC:=i;
          Break;
        end;
      end;
    end;
  begin
    c:=AAdrTxt;
    sl:=TStringList.Create;
    try
      AUlice:='';
      AMisto:='';
      APSC:='';
      radekSPSC:=-1;
      //
      sl.Text:=Replace(',',c,#13#10);
      //
      HledejPsc;
      if radekSPSC=-1 then
        AMisto:=AAdrTxt
      else if (AMisto<>'') and (APSC<>'') then begin //psc a misto mame, poskladame cely zbytek do ulice
        for i:= 0 to sl.Count - 1 do begin
          if i<>radekSPSC then
            AUlice:=AUlice+', '+sl[i];
        end;
        if Copy(AUlice,1,2)=', ' then
          AUlice:=Copy(AUlice,3,200);
      end
      else if APSC<>'' then begin //tipneme ulici a misto z ostatnich radku nez je PSC
        for i:= 0 to sl.Count - 1 do begin
          if i<>radekSPSC then begin
            if AMisto='' then
              AMisto:=sl[i]
            else
              AUlice:=AUlice+', '+sl[i];
          end;
        end;
        if Copy(AUlice,1,2)=', ' then
          AUlice:=Copy(AUlice,3,200);
      end;
      if AUlice='' then
        AUlice:=AMisto;
    finally
      sl.Free;
    end;
  end;

