const
  WaitCursor: TCursor = crHourGlass;
var
  SaveCursor: TCursor;
  CntSetCursor: integer;
  DateFormat: string;
  {jclLI : TJclLocaleInfo;}

procedure StartWait;
begin
  if CntSetCursor = 0 then
    SaveCursor := Screen.Cursor;
  Screen.Cursor := WaitCursor;
  INC(CntSetCursor);
end; {StartWait}

procedure StopWait;
begin
  if CntSetCursor > 0 then
    DEC(CntSetCursor);
  if CntSetCursor = 0 then
    Screen.Cursor := SaveCursor;
end; {StopWait}

procedure StopWaitClear;
begin
  CntSetCursor := 0;
end;

