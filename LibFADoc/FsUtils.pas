    for i := 0 to sl.Count - 1 do begin
      p := Pos('=', sl[i]);
      if p > 0  then begin
        if ((not CaseSensitive) and (SameText(Copy(sl[i], p+1, MaxInt), AValue))) or
           (Copy(sl[i], p+1, MaxInt) = AValue) then begin
          Result := Copy(sl[i], 1, p-1);
          Break;
