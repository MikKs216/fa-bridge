//Otevre dialog pro MsgBox s uzivatelsky definovanymi tlaËitky
//Parametry:
//  ATitle - nadpis
//  AMsg - text dotazu
//  ABtn1Text,ABtn2Text,ABtn3Text - texty tlacitek, tlaËitka se zobrazi v poradi zleva (Btn1 je nevice vlevo)
//    pokud neni zadany text tlacitka, tak se tlacitko nezobrazi, ale pokud je zadany napr. text tlacitka 2,
//    ale neni zadany text tlacitka 1, tak se presto zobrazi obe
//  ADefaultBtn - defaulni tlacitko, pri stisknuti Enter se pouzije, pokud neni zadane tak je to tlacitko 1
//  ABtnWidth - sirka tlacitek (defaultne 100)
//  ADlgType - ikonka typu zpravy, zadava se cislem 0-mtWarning, 1-mtError, 2-mtInformation, 3-mtConfirmation, 4-mtCustom-nic (defaultne 3)
//  ADlgWidth - sirka okna dialogu, pokud neni zadano, tak se nastavi podle sirky tlacitek nebo textu
//
//  Funkce vraci cislo stisknuteho tlacitka (1 az 3), pokud se dialog ukonci krizkem nebo klavesou Esc,
//  tak vraci 0 - to je potreba osetrit pri volani.
//
function MsgBoxAskButtons(ACaption, AMsg: string; ABtn1Text: string; ABtn2Text: string; ABtn3Text: string;
  ADefaultBtn: Integer = 1; ABtnWidth: Integer = 100; ADlgType: integer = 3; ADlgWidth: Integer = 0): integer;
begin
  Result := FDlgUtils.MsgBoxAskButtons(ACaption, AMsg, ABtn1Text, ABtn2Text, ABtn3Text,
  ADefaultBtn, ABtnWidth, ADlgType, ADlgWidth);
end; {MsgBoxAskButtons}

function IntToHexStr(AValue: integer): string;
begin
  Result := Format('%x', [AValue]);
end; {IntToHexStr}

function HexStrToInt(AValue: string): integer;
begin
  Result := StrToInt('$' + AValue)
end; {HexStrToInt}

//prevede barvu na

function ColorToHexStr(AColor: TColor): string;
var
  red, green, blue, flag: Byte;
  function TwoDigits(const AStr: string): string;
  begin
    if Length(AStr) = 1 then
      Result := '0' + AStr
    else
      Result := AStr;
  end;
begin
  GetRGBValue(AColor, red, green, blue);
  flag := GetColorFlag(AColor);
  Result := '$' + TwoDigits(IntToHexStr(flag)) + TwoDigits(IntToHexStr(blue)) +
    TwoDigits(IntToHexStr(green)) + TwoDigits(IntToHexStr(red));
end; {ColorToHexStr}

function HexStrToColor(const AStr: string): TColor;
begin
  Result := SetRGBValue(HexStrToInt(Copy(AStr, 8, 2)), HexStrToInt(Copy(AStr, 6,
    2)),
    HexStrToInt(Copy(AStr, 4, 2)));
  Result := SetColorFlag(Result, HexStrToInt(Copy(AStr, 2, 2)));
end; {HexStrToColor}

function IsValidHexStrColor(const AStr: string): boolean;
var
  i: integer;
  function IsHexDigit(AChar: char): boolean;
  begin
    case AChar of
      '0'..'9', 'A'..'F': Result := TRUE;
    else
      Result := FALSE;
    end;
  end;
begin
  Result := Length(AStr) = 9;
  if Result then
    Result := Copy(AStr, 1, 1) = '$';
  if Result then
    for i := 2 to 9 do
      if not IsHexDigit(AStr[i]) then begin
        Result := FALSE;
        BREAK;
      end;
end; {IsValidHexStrColor}

function ColorToStr(AColor: TColor): string;
begin
  if IsLogicColor(AColor) then
    Result := LogicColorToStr(AColor)
  else
    Result := ColorToHexStr(AColor);
end; {ColorToStr}

function StrToColor(const AStr: string): TColor;
begin
  if IsValidStrLogicColor(AStr) then
    Result := StrToLogicColor(AStr)
  else if IsValidHexStrColor(AStr) then
    Result := HexStrToColor(AStr)
  else
    Result := clNone;
end; {StrToColor}

