function RCToSexCode(ARC: string; ACheckECP: boolean = FALSE): string;
var
  datNar: TDateTime;
  err: string;  
  m: integer;
begin
  Result := '';
  if (ARC <> '') then begin
    CheckRodneCisloDatNar(ARC, FALSE, ACheckECP, datNar, err);
    if (datNar > 0) then begin
      m := StrToIntSafe(Copy(ARC, 3, 2));
