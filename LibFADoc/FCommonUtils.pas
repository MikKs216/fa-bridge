function GetHTTPDocument(const AHTTPAdress: string;
  const AProxyHost: string = '';
  const AProxyPort: string = ''): string;
var
  HTTP: THTTPSend;
  slH,slD: TStringList;
begin
  HTTP := THTTPSend.Create;
  slH:= TStringList.Create;
  slD:= TStringList.Create;
  try
    HTTP.ProxyHost := AProxyHost;
    HTTP.ProxyPort := AProxyPort;
    HTTP.HTTPMethod('GET', AHTTPAdress);
    {slH.Lines.Assign(HTTP.Headers);}
    slD.LoadFromStream(HTTP.Document);
    Result:=slD.Text;
  finally
    HTTP.Free;
    slH.Free;
    slD.Free;
  end;
end;

//WebList2CSV
//  Nacte seznam z AUrl a vrati data v CSV tvaru
//  AUrl - adresa sesnamu
//  AColumns - spoupce, ktere ma vypis vrati. Pokud neni vyplneno, vraci vsechny sloupce z XML
//  Navratove parametry:
//    AHeader - popis CSV souboru, 1. veta
//    AList - data CSV soubor
//    AMsg - popis chyby
//    Result True - vse v poradku, nactlo se XML
//           False - nastala chyba
function WebList2CSV(
  const AUrl, AColumns: string;
  const AProxyServer, AProxyPort: string;
  out AHeader: string;
  out AList: string;
  out AMsg: string): boolean;

  procedure WalkXMLAll(Anode: IXMLNode; var AHeader, AList: string);
  var
    r, h: string;
    j: integer;
    nl: IXMLNodeList;
  begin
    h := '';
    r := '';
    nl := Anode.AttributeNodes;
    for j := 0 to nl.Count - 1 do begin
      if r='' then
        r := VarToStr(nl[j].Text)
      else
        r := r + ';' + VarToStr(nl[j].Text);

      if AHeader='' then begin
        if h='' then
          h := nl[j].LocalName
        else
          h := h + ';' + nl[j].LocalName;
      end;
    end;

    if h<>'' then
      AHeader := h;

    AList := AList + VarToStr(r) + #13#10;
  end;


  procedure WalkXMLClmNew(
    Anode: IXMLNode; AColumn: string;
    var AHeader, AHeaderWork: string;
    var AList, AListWork: string);
  var
    c: string;  
  begin
    if AHeader='' then begin
      if Anode.Attributes[AColumn]=null then
        c := ''
      else
        c := AColumn;

      if AHeaderWork='' then                       
        AHeaderWork := c
      else
        AHeaderWork := AHeaderWork + ';' + c;
    end;

    if AListWork='' then
      AListWork := VarToStr(Anode.Attributes[AColumn])
    else
      AListWork := AListWork + ';'+VarToStr(Anode.Attributes[AColumn]);
  end;

  procedure WalkXMLClm(
    Anode: IXMLNode; AColumns: string;
    var AHeader, AList: string);
  var
    zn, clm, r, h: string;
    i: integer;
  begin
    h := '';
    r := '';
    clm := '';
    for i := 1 to length(AColumns) do begin
      zn := copy(AColumns, i, 1);
      if (zn = ',') or (zn = ';') then begin
        WalkXMLClmNew(Anode, trim(clm), AHeader, h, AList, r);
        clm := '';
      end
      else
        clm := clm + zn;
    end;

    if (clm<>'') then
      WalkXMLClmNew(Anode, trim(clm), AHeader, h, AList, r);
    if h<>'' then
      AHeader := h;
    if AList='' then
      AList := VarToStr(r) + #13#10
    else
      AList := AList+ VarToStr(r) + #13#10;
  end;

  procedure WalkXML(Axml, AColumns: string; var AHeader, AList, AMsg: string);
  var
    XMLDoc: IXMLDocument;
    node, node1: IXMLNode;
    //node1, node2, node3, node4, node5, node6: IXMLNode;
    i: integer;
  begin
    XMLDoc:=TXMLDocument.Create(nil);
    try try
      XMLDoc.XML.Text:=Axml;
      XMLDoc.Active := TRUE;
      node:=XMLDoc.DocumentElement;

      if node <> nil then begin
        node1 := nil;
        for i := 0 to node.ChildNodes.Count - 1 do begin
          if node.ChildNodes.Nodes[i].NodeName = 'Veta' then begin
            node1 := node.ChildNodes.Nodes[i];
            if AColumns='' then
              WalkXMLAll(node1, AHeader, AList)
            else
              WalkXMLClm(node1, AColumns, AHeader, AList);
          end;
        end;
      end;
    except
      on E: Exception do begin
        AMsg:='Chyba p�i po�adavku na vyhled�n� v registru (' + E.Message + ')';
        Result:=FALSE;
      end;
    end;
    finally
      XMLDoc:=nil;
      StopWait;
    end;
  end;

var
  xmlD: string;
begin
  StartWait;
  try
    Result := IsConnectedToInternet;
    AHeader := '';
    AList := '';
    if Result then begin
      xmlD := GetHTTPDocument(AUrl, AProxyServer, AProxyPort);
      Result := pos('<Ciselnik', xmlD)>0;
      if Result then
        WalkXML(xmlD, AColumns, AHeader, AList, AMsg);
    end;
  finally
    StopWait;
  end;
end;

