//CalcQRCodeText
//http://qr-platba.cz/wp-content/uploads/QR_platba_standard_CBA.pdf

function CalcQRCodeText(
  const AIBAN: string;
  const ACastka: double;
  const AMenaUctu, APlatce, AVarSym, ASpecSym, AKonSym, AZpravaPrijemci: string): string;

  function MaxLength(
    const AText: string;
    const ALength: integer): string;
  begin
    if length(AText)>ALength then
      Result := copy(Trim(AText), 1, ALength)
    else
      Result := Trim(AText);
  end;


  function BezDiakritiky(AStr: string): string;
  var
    i: Integer;
  begin
    for i := 1 to Length(AStr) do begin
      case AStr[i] of
      '�': Result := Result + 'e';
      '�': Result := Result + 's';
      '�': Result := Result + 'c';
      '�': Result := Result + 'r';
      '�': Result := Result + 'z';
      '�': Result := Result + 'y';
      '�': Result := Result + 'a';
      '�': Result := Result + 'i';
      '�': Result := Result + 'e';
      '�': Result := Result + 'u';
      '�': Result := Result + 'u';
      '�': Result := Result + 't';
      '�': Result := Result + 'n';
      '�': Result := Result + 'd';
      '�': Result := Result + 'o';
      '�': Result := Result + 'u';


      '�': Result := Result + 'E';
      '�': Result := Result + 'S';
      '�': Result := Result + 'C';
      '�': Result := Result + 'R';
      '�': Result := Result + 'Z';
      '�': Result := Result + 'Y';
      '�': Result := Result + 'A';
      '�': Result := Result + 'I';
      '�': Result := Result + 'E';
      '�': Result := Result + 'U';
      '�': Result := Result + 'U';
      '�': Result := Result + 'T';
      '�': Result := Result + 'N';
      '�': Result := Result + 'D';
      '�': Result := Result + 'O';
      '�': Result := Result + 'U';

      else Result := Result + AStr[i];
      end;
    end;
  end;


  function NormCastka(
    const AKod:string;
    const ACastka: double): string;
  begin
    Result := AKod+MaxLength(Replace(',', FloatToStr(RoundAri(ACastka, -2)), '.'), 10)
  end;

  function NormMema(const AKod, AMenaUctu: string): string;
  begin
    if length(AMenaUctu)=3 then
      Result := AKod+UPPERCASE(AMenaUctu)
    else if UPPERCASE(AMenaUctu)='SK' then
      Result := AKod+'SKK'
    else
      Result := AKod+'CZK';
  end;

  function NormPlatce(AKod, APlatce: string): string;
  begin
    APlatce := Trim(APlatce);
    if APlatce<>'' then
      Result := AKod+MaxLength(BezDiakritiky(Replace('*', APlatce, '')), 35)
    else
      Result := '';
  end;

  function NormIBAN(AKod, AIBAN: string): string;
  begin
    AIBAN := Trim(AIBAN);
    if AIBAN<>'' then
      Result := AKod+MaxLength(Replace(' ', Replace('*', Trim(AIBAN), ''), ''), 46)
    else
      Result := '';
  end;

  function NormMsg(AKod, AMsg: string): string;
  begin
    AMsg := Trim(AMsg);
    if AMsg<>'' then
      Result := AKod+MaxLength(BezDiakritiky(Replace('*', AMsg, '')), 60)
    else
      Result := '';
  end;

  function NormVS(AKod, AVS: string): string;
  begin
    AVS := Trim(AVS);
    if AVS<>'' then
      Result := AKod+MaxLength(Replace('*', AVS, ''), 10)
    else
      Result := '';
  end;

  function NormSS(AKod, ASS: string): string;
  begin
    ASS := Trim(ASS);
    if ASS<>'' then
      Result := AKod+MaxLength(Replace('*', ASS, ''), 10)
    else
      Result := '';
  end;

  function NormKS(AKod, AKS: string): string;
  begin
    AKS := Trim(AKS);
    if AKS<>'' then
      Result := AKod+MaxLength(Replace('*', AKS, ''), 10)
    else
      Result := '';
  end;

begin
  if AIBAN<>'' then
    Result :=
      MaxLength(
        'SPD*1.0'+
        NormIBAN('*ACC:', AIBAN)+
        NormCastka('*AM:', ACastka)+
        NormMema('*CC:', AMenaUctu)+
        NormPlatce('*RN:', APlatce) +
        NormVS('*X-VS:', AVarSym)+
        NormSS('*X-SS:', ASpecSym)+
        NormKS('*X-KS:', AKonSym)+
        NormMsg('*MSG:', AZpravaPrijemci), 200)
  else
    Result := '';
end;




function ConvertBU2IBAN(const ABU, AMenaUctu: string): string;

  procedure DecodeBU(
    const ABU: string;
    var Apredcisli, Amatrika, Akodb: string);
  var
    pMinus, pLomit: integer;
    bu: string;
  begin
    bu := replace(' ', ABU, '');
    Apredcisli := '';
    Amatrika := '';
    Akodb := '';

    pMinus := pos('-', bu);
    if pMinus>0 then begin
      Apredcisli := copy(bu, 1, pMinus-1);
      bu := copy(bu, pMinus+1, length(bu)-pMinus);
    end;

    pLomit := pos('/', bu);
    if pLomit>0 then begin
      Amatrika := copy(bu, 1, pLomit-1);
      Akodb := copy(bu, pLomit+1, length(bu)-pLomit);
    end;
  end;

  function CalcState(const AMenaUctu: string): string;
  begin
    if (UPPERCASE(AMenaUctu)='SK') or (UPPERCASE(AMenaUctu)='SKK') then
      Result := 'SK'
    else
      Result := 'CZ';
  end;

  function CalcStateCode(const AStatCode: string): string;
  begin
{    if (UPPERCASE(AStatCode)='SK') then
      Result := '31'
    else
      Result := '65';}

    Result := '00';
  end;

  function CnvLetters2Num(AIBAN: string): string;
  var
    i: integer;
  begin
    AIBAN := UPPERCASE(AIBAN);
    for i := 1 to Length(AIBAN) do begin
      case AIBAN[i] of
        'A': Result := Result + '10';
        'B': Result := Result + '11';
        'C': Result := Result + '12';
        'D': Result := Result + '13';
        'E': Result := Result + '14';
        'F': Result := Result + '15';
        'G': Result := Result + '16';
        'H': Result := Result + '17';
        'I': Result := Result + '18';
        'J': Result := Result + '19';
        'K': Result := Result + '20';
        'L': Result := Result + '21';
        'M': Result := Result + '22';
        'N': Result := Result + '23';
        'O': Result := Result + '24';
        'P': Result := Result + '25';
        'Q': Result := Result + '26';
        'R': Result := Result + '27';
        'S': Result := Result + '28';
        'T': Result := Result + '29';
        'U': Result := Result + '30';
        'V': Result := Result + '31';
        'W': Result := Result + '32';
        'X': Result := Result + '33';
        'Y': Result := Result + '34';
        'Z': Result := Result + '35';
        else Result := Result + AIBAN[i];
      end;
    end;
  end;

  function CalcKontrC(const AtmpIBAN: string): string;
  var
    kontrC1, kontrC2: int64;
    ibanPrac, zbUc: string;
  begin
    ibanPrac := replace(' ', AtmpIBAN, '');
    ibanPrac := CnvLetters2Num(ibanPrac);
    kontrC1 := StrToInt64(copy(ibanPrac, 1, 18)) mod 97;
    zbUc := copy(ibanPrac, 19, length(ibanPrac)-18);
    kontrC2 := StrToInt64(IntToStr(kontrC1)+zbUc) mod 97;

    kontrC2 := 98 - kontrC2;                                     
    Result := IntToStr(kontrC2);
    Result := StrPadLeft(Result,2,'0');
  end;

var
  predcisli, matrika, kodb, tmpIBAN, statIBAN: string;
begin
  Result := '';

  if ABU<>'' then begin
    DecodeBU(ABU, predcisli, matrika, kodb);
    if (matrika<>'') and (kodb<>'') then begin
      statIBAN := CalcState(AMenaUctu);

      tmpIBAN := StrPadLeft(kodb,4,'0')+
        StrPadLeft(predcisli,6,'0')+
        StrPadLeft(matrika,10,'0')+
        statIBAN+CalcStateCode(statIBAN);

      Result := statIBAN+CalcKontrC(tmpIBAN)+
        StrPadLeft(kodb,4,'0')+
        StrPadLeft(predcisli,6,'0')+
        StrPadLeft(matrika,10,'0');
    end;
  end;
end;

function FormatIBAN(const IBAN: string): string;
var s: string;
begin
  s:=Replace(' ',IBAN,'');
  s:=Copy(s,1,4)+' '+Copy(s,5,4)+' '+Copy(s,9,4)+' '+Copy(s,13,4)+' '+
    Copy(s,17,4)+' '+Copy(s,21,4)+' '+Copy(s,25,4)+' '+Copy(s,29,4)+' '+
    Copy(s,33,4);
  Result:=Trim(s);  
end;
