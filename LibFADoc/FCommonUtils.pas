{-----------------------------------------------------------------------------
 GetSection
   Vytahne z dat ulozenych v retezci sekci predanou v ASection
   ASection se zadava vcetne hranatych zavorek.
 -----------------------------------------------------------------------------}

function GetSection(const AData, ASection: string): string;
var
  sl, sl1: TStringList;
  i: integer;
  isInValuesSection: boolean;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    isInValuesSection := FALSE;
    sl.Text := AData;
    for i := 0 to sl.Count - 1 do begin
      if isInValuesSection then
        if Copy(sl[i], 1, 1) = '[' then
          BREAK
        else
          sl1.Add(sl[i])
      else if sl[i] = ASection then
        isInValuesSection := TRUE;
    end;
    Result := sl1.Text;
  finally
    sl.Free;
    sl1.Free;
  end;
end; {GetSection}

{-----------------------------------------------------------------------------
 SetSection
   V AMainData nahradi cast ASection tim, co je v ASectionData (i na stejnou pozici, pokud tam jiz je)
 -----------------------------------------------------------------------------}

function SetSection(const AMainData, ASection, ASectionData: string): string;

  procedure WriteSecData(Asl1: TStringList; ASection, ASectionData: string);
  begin
    Asl1.Add(ASection);
    Asl1.Add(ASectionData);
  end;

var
  sl, sl1: TStringList;
  i: integer;
  isInValuesSection, writedSection: boolean;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    isInValuesSection := FALSE;
    writedSection := false;

    sl.Text := AMainData;
    for i := 0 to sl.Count - 1 do begin
      if sl[i] = ASection then
        isInValuesSection := TRUE
      else if Copy(sl[i], 1, 1) = '[' then begin
        isInValuesSection := false;
        if writedSection=false then begin
          WriteSecData(sl1, ASection, ASectionData);
          writedSection := true;
        end;
      end;

      if isInValuesSection=false then
        sl1.Add(sl[i]);
    end;

    if writedSection=false then
      WriteSecData(sl1, ASection, ASectionData);

    Result := sl1.Text;
  finally
    sl.Free;
    sl1.Free;
  end;
end; {SetSection}

