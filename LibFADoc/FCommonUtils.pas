//2: large 120 DPI
function GetFontTypes:Integer;
var
  dc:HDC;
  pix: Integer;
begin
  dc:=GetDC(0);
  try
  Result:=0;
  pix:=GetDeviceCaps(dc,LOGPIXELSX);
  case pix of
    96: Result:=1;
    97..120: Result:=2;
    121..250: Result:=3;
  end;
  finally
    ReleaseDC(0,dc);
  end;
end;{GetFontTypes}

