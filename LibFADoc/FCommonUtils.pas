function CheckIBAN(IBAN: string): boolean;
var
  a: char;
  v, l, rest: Integer;
  alpha: string;
  number: Longint;
begin
  Result:=TRUE;
  if IBAN='' then
    EXIT;
  IBAN:=Replace(' ',IBAN,'');
  if (Length(IBAN)<5) or (Length(IBAN)>34) or IsInteger(Copy(IBAN,1,2))
    or not IsInteger(Copy(IBAN,3,2)) then begin
    Result:=FALSE;
    EXIT;
  end;
  IBAN := IBAN + Copy(IBAN, 1, 4);
  Delete(IBAN, 1, 4);
  for a := 'A' to 'Z' do
    IBAN := StringReplace(IBAN, a, IntToStr(Ord(a) - 55), [rfReplaceAll]);
  v := 1;
  l := 9;
  rest := 0;
  alpha := '';
  try
    while v <= Length(IBAN) do
    begin
      if l > Length(IBAN) then l := Length(IBAN);
      alpha := alpha + Copy(IBAN, v, l);
      number := StrToInt(alpha);
      rest := number mod 97;
      v := v + l;
      alpha := IntToStr(rest);
      l := 9 - Length(alpha);
    end;
  except
    rest := 0;
  end;
  Result := rest = 1;
end;

{-----------------------------------------------------------------------------
ZipFile
  Zazipuje soubor (nebo soubory - muze obsahovat masku) do souboru
  ADstFileName. Nezipuje adres��e.
-----------------------------------------------------------------------------}

function ZipFile(const ASrcFileName, ADstFileName, AComment: string;
  const APassword: string = ''): boolean;
var
  zipper: TVCLZip;
  numzipped: integer;
begin
  StartWait;
  zipper := TVCLZip.Create(nil);
  try
    try
      DeleteFile(ADstFileName); //soubor musime predem smazat jinak je problem s pravy mezi ruznymi uzivateli
    except
    end;
    with zipper do begin
      ZipName := ADstFileName;
      if AComment<>'' then
        ZipComment := AComment;
      FilesList.Add(ASrcFileName);
      Recurse := FALSE;
      StorePaths := FALSE;
      PackLevel := 9;
      Password:=APassword;
      numzipped := Zip;
      Result:=numZipped>0;
    end;
  finally
    zipper.Free;
    StopWait;
  end;
end; {ZipFile}

{
//  nove pomoci ZipForge
procedure ZipFileF(const ASrcFileName, ADstFileName: string;
  const AComment: string = '';
  const APassword: string = '');
var
  zip: TZipForge;
begin
  zip := TZipForge.Create(nil);
  try
    zip.FileName := ADstFileName;
    zip.SpanningOptions.AdvancedNaming:=False;
    zip.SpanningMode:= smNone;
    zip.OpenArchive();

    zip.CompressionLevel := clMax;
    zip.Options.StorePath := spNoPath;
    zip.Comment := AComment;
    zip.Password := APassword;
    try
      zip.BeginUpdate();
      zip.AddFiles(ASrcFileNames);
      zip.EndUpdate();
    finally
      zip.CloseArchive();
    end;
  finally
    FreeAndNil(zip);
  end;
end;} {ZipFile}

{-----------------------------------------------------------------------------
UnzipFile
  Rozzipuje soubor do adresare ADstDir. Pokud tam stejne soubory existuji,
  prepise je. Pokud soubor obsahuje podadresare, vyvori je.
-----------------------------------------------------------------------------}
function UnzipFile(const ASrcFileName, ADstDir: string;
  APassword: string = ''): boolean;
var
  unzipper: TVCLUnzip;
  numUnzipped: integer;
begin
  StartWait;
  unzipper := TVCLUnzip.Create(nil);
  try
    with unzipper do begin
      ZipName := ASrcFileName;
      ReadZip;
      DoAll := TRUE;
      DestDir := ADstDir;
      RecreateDirs := TRUE;
      OverwriteMode:=Always;
      RetainAttributes := TRUE;
      PassWord:=APassword;
      numUnzipped:=Unzip;
      Result:=numUnzipped>0;
    end;
  finally
    unzipper.Free;
    StopWait;
  end;
end; {UnzipFile}

{-----------------------------------------------------------------------------
GetZipFileComment
  Vraci komentar ze zip souboru.
-----------------------------------------------------------------------------}
function GetZipFileComment(const AFileName: string): string;
var
  unzipper: TVCLUnzip;
begin
  StartWait;
  unzipper := TVCLUnzip.Create(nil);
  try
    with unzipper do begin
      ZipName := AFileName;
      ReadZip;
      Result := ZipComment;
    end;
  finally
    unzipper.Free;
    StopWait;
  end;
end; {GetZipFileComment}

{-----------------------------------------------------------------------------
LoadMtFromZip
  Nacte obsah tabulky z definice
-----------------------------------------------------------------------------}
function LoadMemTableFromZip(AMt: TkbmMemTable; const AZipFileName: string;
  const APassword: string = ''): boolean;
var
  unzipper: TVCLUnzip;
  st: TMemoryStream;
begin
  StartWait;
  unzipper := TVCLUnzip.Create(nil);
  st:= TMemoryStream.Create;
  try
    with unzipper do begin
      ZipName := AZipFileName;
      //
      PassWord:=APassword;
      try
        Result:=CheckArchive;
      except
        Result:=FALSE;
      end;
      if Result then
        Result:=UnZipToStream( st, AMt.Name)=1;
      if Result then begin
        st.Seek(0, soFromBeginning);
        AMt.LoadFromStream(st);
      end;
    end;
  finally
    unzipper.Free;
    st.Free;
    StopWait;
  end;
end; {LoadMtFromZip}

{-----------------------------------------------------------------------------
LoadTextFromZip
  Nacte obsah textoveho souboru z definice
-----------------------------------------------------------------------------}
function LoadTextFromZip(const AZipFileName, ATextFileName: string;
  out AText: string; const APassword: string = ''): boolean;
var
  unzipper: TVCLUnzip;
  st: TMemoryStream;
  sl: TstringList;
begin
  StartWait;
  unzipper := TVCLUnzip.Create(nil);
  st:= TMemoryStream.Create;
  sl:= TstringList.Create;
  try
    with unzipper do begin
      ZipName := AZipFileName;
      //
      PassWord:=APassword;
      try
        Result:=CheckArchive;
      except
        Result:=FALSE;
      end;
      //zkusime bez hesla - pozdeji odstranit
      if not Result then begin
        PassWord:='';
        try
          Result:=CheckArchive;
        except
          Result:=FALSE;
        end;
      end;
      //
      if Result then
        Result:=UnZipToStream( st, ATextFileName)=1;
      if Result then begin
        st.Seek(0, soFromBeginning);
        sl.LoadFromStream(st);
        AText:=sl.Text;
      end;
    end;
  finally
    unzipper.Free;
    st.Free;
    sl.Free;
    StopWait;
  end;
end; {LoadTextFromZip}

