//prevede seznam typu rozmezi hodnot (1,3,5..6) na seznam cisel
//pokud je nektere cislo vetsi nez ALimit, nezaradi jej do vysledku

function DecodeIntegerList(ACSVList: string; ALimit: integer): string;
var
  i, j: integer;
  s, mn, mx: string;
begin
  ACSVList := StrTrimCharRight(ACSVList, ',');
  Result := '';
  for i := 0 to CountListItems(ACSVList) - 1 do begin
    s := GetListItem(ACSVList, i);
    if IsInteger(s) then begin
      if StrToInt(s)<=ALimit then
        Result := Result + ',' + s;
    end
    else if Pos('..', s) > 0 then begin
      mn := Copy(s, 1, Pos('..', s) - 1);
      mx := Copy(s, Pos('..', s) + 2, maxint);
      if IsInteger(mn) and IsInteger(mx) then
        for j := StrToInt(mn) to StrToInt(mx) do begin
          if j<=ALimit then
            Result := Result + ',' + IntToStr(j);
        end;
    end
    else if Pos('-', s) > 0 then begin
      mn := Copy(s, 1, Pos('-', s) - 1);
      mx := Copy(s, Pos('-', s) + 1, maxint);
      if IsInteger(mn) and IsInteger(mx) then
        for j := StrToInt(mn) to StrToInt(mx) do begin
          if j<=ALimit then
            Result := Result + ',' + IntToStr(j);
        end;
    end;
  end;
  Result := StrTrimCharLeft(Result, ',');
end; {DecodeIntegerList}

function CheckValidIntegerList(ACSVList: string): boolean;
var
  i: integer;
  s, mn, mx: string;
  ok: boolean;
begin
  ACSVList := StrTrimCharRight(ACSVList, ',');
  ok := TRUE;
  for i := 0 to CountListItems(ACSVList) - 1 do begin
    s := GetListItem(ACSVList, i);
    if Pos('..', s) > 0 then begin
      mn := Copy(s, 1, Pos('..', s) - 1);
      mx := Copy(s, Pos('..', s) + 2, maxint);
      if not IsInteger(mn) or not IsInteger(mx) or (StrToInt(mx) < StrToInt(mn)) then
        ok := FALSE;
      BREAK;
    end
    else if Pos('-', s) > 0 then begin
      mn := Copy(s, 1, Pos('-', s) - 1);
      mx := Copy(s, Pos('-', s) + 1, maxint);
      if not IsInteger(mn) or not IsInteger(mx) or (StrToInt(mx) < StrToInt(mn)) then begin
        ok := FALSE;
        BREAK;
      end;
    end
    else if not IsInteger(s) then
      ok := FALSE;
  end;
  Result := ok;
end; {CheckValidIntegerList}

