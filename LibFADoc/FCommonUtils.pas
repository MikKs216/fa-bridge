function StringToCharSet(const Txt: string): TSysCharSet;
var
  CP: PChar;
begin
  Result := [];
  if Txt = '' then
    Exit;
  CP := PChar(Txt);
  while CP^ <> #0 do
  begin
    Include(Result, CP^);
    Inc(CP);
  end;
end;

{------------------------------------------------------------------------------
TrimCharsLeft
  Odstrani zleva vsechny vyjmenovane znaky
Vstup:
  AChars ... znaky pro odstraneni ulozene za sebou v retezci, napr.: ',. ;'
------------------------------------------------------------------------------}
function TrimCharsLeft(const AStr: string; const AChars: string): string;
var
  chs: TSysCharSet;
begin
  Result := AStr;
  if Length(AChars)>0 then begin
    chs := StringToCharSet(AChars);
    Result := StrTrimCharsLeft(AStr, chs);
  end;
end; {TrimCharsLeft}

{------------------------------------------------------------------------------
TrimCharsRight
  Odstrani zprava vsechny vyjmenovane znaky
Vstup:
  AChars ... znaky pro odstraneni ulozene za sebou v retezci, napr.: ',. ;'
------------------------------------------------------------------------------}
function TrimCharsRight(const AStr: string; const AChars: string): string;
var
  chs: TSysCharSet;
begin
  Result := AStr;
  if Length(AChars)>0 then begin
    chs := StringToCharSet(AChars);
    Result := StrTrimCharsRight(AStr, chs);
  end;
end; {TrimCharsRight}

{------------------------------------------------------------------------------
TrimChars
  Odstrani zleva i zprava vsechny vyjmenovane znaky
Vstup:
  AChars ... znaky pro odstraneni ulozene za sebou v retezci, napr.: ',. ;'
------------------------------------------------------------------------------}
function TrimChars(const AStr: string; const AChars: string): string;
begin
  Result := TrimCharsRight(TrimCharsLeft(AStr, AChars),AChars);
end; {TrimChars}

{------------------------------------------------------------------------------
RemoveChars
  Odstrani vsechny vyjmenovane znaky kdekoliv v retezci
Vstup:
  AChars ... znaky pro odstraneni ulozene za sebou v retezci, napr.: ',. ;'
------------------------------------------------------------------------------}
function RemoveChars(const AStr: string; const AChars: string): string;
var
  chs: TSysCharSet;
begin
  Result := AStr;
  if Length(AChars)>0 then begin
    chs := StringToCharSet(AChars);
    Result := StrRemoveChars(AStr, chs);
  end;
end;

