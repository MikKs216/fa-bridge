//SendEmail
//  odesle zpravu i s prilohami
//  AAddress,ASubject,ABody ... email-adresa,predmet,telo zpravy
//  AAttachments ... seznam souboru k odeslani jako prilohy, muze byt nil
//  AShowDialog ... TRUE zobrazi dialog postovniho klienta pred odeslanim
//                  FALSE odesle zpravu 'skryte'
//  AErrorMsg ... navratova hodnota obsahuje chybove hlaseni
//  vraci TRUE pokud doslo k uspesnemu odeslani zpravy nebo pokud odeslani
//             stornoval sam uzivatel
//        FALSE v opacnem pripade
//

function SendEmail(AAddress, ASubject, ABody: string; AAttachments: TStringList;
  AShowDialog: boolean; out AErrorMsg: string): boolean;
begin
  AErrorMsg := '';
  Result := TRUE;
  with TJclEmail.Create do try
    try
      if AAddress='' then
        AAddress := '@';
      Subject := ASubject;
      Body := ABody;
      Recipients.Add(AAddress);
      if AAttachments <> nil then
        Attachments.AddStrings(AAttachments);
      Send(AShowDialog);
    except
      on E: Exception do begin
        AErrorMsg := E.Message;
        Result := FALSE;
      end;
    end;
  finally
    Free;
  end;
end; {SendEmail}

function VarIsNE(Value: Variant): boolean;
begin
  Result := VarIsNull(Value) or VarIsEmpty(Value) or
    ((VarType(Value) = varString) or (VarType(Value) = varOleStr)) and
    (VarToStr(Value) = '');
end; {VarIsNE}

function VarToDouble(Value: Variant): double;
begin
  if VarIsNE(Value) then
    Result := 0
  else
  try
    Result := VarAsType(Value, varDouble);
  except
    Result := 0;
  end;
end; {VarToDouble}

function VarToInt(Value: Variant): integer;
begin
  if VarIsNE(Value) then
    Result := 0
  else
  try
    Result := VarAsType(Value, varInteger);
  except
    Result := 0;
  end;
end; {VarToInt}

function VarToBool(Value: Variant): boolean;
begin
  if VarIsNE(Value) then
    Result := FALSE
  else
  try
    Result := VarAsType(Value, varBoolean);
  except
    Result := FALSE;
  end;
end; {VarToBool}

{-----------------------------------------------------------------------------
CorrectDateString
  Pokusi se rozpoznat v textu datum a prevede do zakladniho formatu
  Podporuje: (misto tecky je mozne i lomitko nebo carka)
  01.02.2003
  01.02.03
  1.2.3
  1.2
  1
  01022003
  010203
  0102
  01
  * ... dnes
  + ... zitra
  +n ... za n dnu
  - ... vcera
  -n ... pred n dny
  . ... 1.1. tohoto roku - zr
  / ... 31.12. tohoto roku - kr
  .n ... 1.1. roku n - zrn
  /n ... 31.12. roku n - krn 
  ..n ... zacatek n-teho ctvrtleti - zc
  //n ... konec n-teho ctvrtleti - kc
  po ut st ct pa so ne - den v tomto tydnu (m��e b�t i s diakritikou a nebo velkymi pismeny)
  -po ut st ct pa so ne - den v minul�m t�dnu
  -po ut st ct pa so ne - den v pristim tydnu
  -----------------------------------------------------------------------------}

function CorrectDateString(var ADat: string): boolean;
const
  cTwoDigitLimitYear = 50; //rok pod kterym se datum povazuje za minule stoleti
  cTwoLimitLastCentury = 19; //minule stoleti
var
  n, dw, dt, dx: integer;
  a, b, c, ds: string;
  d, m, y: word;
  prestupny: Boolean;

  function NormalizeYear(const AYearStr: string): string;
  begin
    Result := IntToStr(CurrentYear);
    if (Length(AYearStr) <= 2) and IsInteger(AYearStr) then begin
      if StrToInt(AYearStr) >= cTwoDigitLimitYear then
        Result := IntToStr(cTwoLimitLastCentury * 100 + StrToInt(AYearStr))
      else
        Result := IntToStr((cTwoLimitLastCentury + 1) * 100 + StrToInt(AYearStr));
    end
    else if IsInteger(AYearStr) then
      Result := AYearStr;
  end;

begin
  Result := TRUE;
  if (ADat = '') or
    ((DateFormat<>'d.M.yyyy') and (DateFormat<>'dd.MM.yyyy')) then
    EXIT;
  ADat := Replace(',', ADat, '.'); //dalsi mozne date separatory
  ADat := LowerCase(Str1250ToANSI(ADat));
  ADat := Replace('zr', ADat, '.');
  ADat := Replace('kr', ADat, '/');
  ADat := Replace('zc', ADat, '..');
  ADat := Replace('kc', ADat, '//');
  ADat := Replace('zm', ADat, '01');
  if Copy(ADat,1,2)='km' then begin
    ds:='';
    dx:=StrToIntSafe(Copy(ADat,3,2)); // mesic
    if dx>0 then begin
      if (dx=1)or(dx=3)or(dx=5)or(dx=7)or(dx=8)or(dx=10)or(dx=12) then
        ds:='31'+Copy(ADat,3,2)
      else if (dx<>2)and(dx<=12) then
        ds:='30'+Copy(ADat,3,2)
      else begin
        if StrToIntSafe(Copy(ADat,5,4))>0 then begin
          prestupny:=IsLeapYear(StrToIntSafe(NormalizeYear(Copy(ADat,5,4))))
        end
        else
          prestupny:=IsLeapYear(YearOf(Date));
        if prestupny then
          ds:='29'+Copy(ADat,3,2)
        else
          ds:='28'+Copy(ADat,3,2)
      end;
      if ds<>'' then
        ADat:=ds+Copy(ADat,5,4);
    end;
  end;

  //------ dny v tydnu -------------------
  dw:=DayOfWeek(Date);
  if dw=1 then //po=1, ne=7
    dw:=7
  else
    dw:=dw-1;
  dt:=0;
  if ADat='po' then dt:=1
  else if ADat='ut' then dt:=2
  else if ADat='st' then dt:=3
  else if ADat='ct' then dt:=4
  else if ADat='pa' then dt:=5
  else if ADat='so' then dt:=6
  else if ADat='ne' then dt:=7
  else if Copy(ADat,1,1)='+' then begin
    ds:=Copy(ADat,2,Length(ADat)-1);
    if ds='po' then dt:=1
    else if ds='ut' then dt:=2
    else if ds='st' then dt:=3
    else if ds='ct' then dt:=4
    else if ds='pa' then dt:=5
    else if ds='so' then dt:=6
    else if ds='ne' then dt:=7;
    if dt>0 then
      dt:=dt+7;
  end
  else if Copy(ADat,1,1)='-' then begin
    ds:=Copy(ADat,2,Length(ADat)-1);
    if ds='po' then dt:=-1
    else if ds='ut' then dt:=-2
    else if ds='st' then dt:=-3
    else if ds='ct' then dt:=-4
    else if ds='pa' then dt:=-5
    else if ds='so' then dt:=-6
    else if ds='ne' then dt:=-7;
  end;
  if dt>0 then begin
    dx:=dt-dw;
    if dx<0 then
      ADat:=IntToStr(dx)
    else if dx=0 then
      ADat:='*'
    else
      ADat:='+'+IntToStr(dx);
  end
  else if dt<0 then begin
    dt:=Abs(dt);
    dx:=dt-dw-7;
    if dx<0 then
      ADat:=IntToStr(dx)
    else if dx=0 then
      ADat:='*'
    else
      ADat:='+'+IntToStr(dx);
  end;
  //------ dny v tydnu -------------------------------------

  if Pos('/',ADat)<>1 then // pokud je lomitko na prvnim miste tak povazujeme za zkratkovou klavesu a ne za date separator
    ADat := Replace('/', ADat, '.');
  //
  a := Replace('.', ADat, '');
  if ADat = '*' then begin
    DecodeDate(Date, Y, M, D);
    ADat := Format('%.2d.%.2d.%.4d', [d, m, y]);
  end
  else if Copy(ADat, 1, 1) = '+' then begin
    n := Max(StrToIntSafe(Copy(ADat, 2, maxint)), 1);
    DecodeDate(Date + n, y, m, d);
    ADat := Format('%.2d.%.2d.%.4d', [d, m, y]);
  end
  else if Copy(ADat, 1, 1) = '-' then begin
    n := Max(StrToIntSafe(Copy(ADat, 2, maxint)), 1);
    DecodeDate(Date - n, y, m, d);
    ADat := Format('%.2d.%.2d.%.4d', [d, m, y]);
  end
  else if Copy(ADat, 1, 1) = '.' then begin
    if Copy(ADat, 2, 1) = '.' then begin    // zacatek ctvrtleti
      if Copy(ADat, 3, 1)='0' then begin  // dvoumistne ctvrtleti
        n := StrToIntSafe(Copy(ADat, 3, 2));
        ds := Copy(ADat, 5, 4);
      end                                 // jednomistne ctvrleti
      else begin
        n := StrToIntSafe(Copy(ADat, 3, 1));
        ds := Copy(ADat, 4, 4);
      end;
      if StrToIntSafe(ds)>0 then
        y:=StrToIntSafe(NormalizeYear(ds))
      else
        y := CurrentYear;
      case n of
        1: m := 1;
        2: m := 4;
        3: m := 7;
        4: m := 10;
      else
        m := 0;
      end;
        ADat := Format('%.2d.%.2d.%.4d', [1, m, y]);
    end
    else begin                              //zacatek roku
      n := Max(StrToIntSafe(Copy(ADat, 2, maxint)), 0);
      if n>0 then
        y := StrToIntSafe(NormalizeYear(IntToStr(n)))
      else
        y := CurrentYear;
      ADat := Format('%.2d.%.2d.%.4d', [1, 1, y]);
    end;
  end
  else if Copy(ADat, 1, 1) = '/' then begin
    if Copy(ADat, 2, 1) = '/' then begin     // konec ctvrtleti
      if Copy(ADat, 3, 1)='0' then begin  // dvoumistne ctvrtleti
        n := StrToIntSafe(Copy(ADat, 3, 2));
        ds := Copy(ADat, 5, 4);
      end                                 // jednomistne ctvrleti
      else begin
        n := StrToIntSafe(Copy(ADat, 3, 1));
        ds := Copy(ADat, 4, 4);
      end;
      if StrToIntSafe(ds)>0 then
        y:=StrToIntSafe(NormalizeYear(ds))
      else
        y := CurrentYear;
      case n of
        1: begin d := 31; m := 3; end;
        2: begin d := 30; m := 6; end;
        3: begin d := 30; m := 9; end;
        4: begin d := 31; m := 12; end;
      else
        m := 0;
      end;
       ADat := Format('%.2d.%.2d.%.4d', [d, m, y]);
    end
    else begin                                 // konec roku
      n := Max(StrToIntSafe(Copy(ADat, 2, maxint)), 0);
      if n>0 then
        y := StrToIntSafe(NormalizeYear(IntToStr(n)))
      else
        y := CurrentYear;
      ADat := Format('%.2d.%.2d.%.4d', [31, 12, y]);
    end;
  end
  else begin
    n := Pos('.', ADat);
    if n > 0 then begin //format s teckou
      a := Copy(ADat, 1, n - 1);
      b := Copy(ADat, n + 1, maxint);
      n := Pos('.', b);
      if n > 0 then begin //je tam i rok
        c := Copy(b, n + 1, maxint);
        b := Copy(b, 1, n - 1);
        c := NormalizeYear(c);
        {if (Length(c) <= 2) and IsInteger(c) then
          if StrToInt(c) >= cTwoDigitLimitYear then
            c := IntToStr(cTwoLimitLastCentury * 100 + StrToInt(c))
          else
            c := IntToStr((cTwoLimitLastCentury + 1) * 100 + StrToInt(c));
        if c='' then
          c := IntToStr(CurrentYear);}
      end
      else //neni tam rok
        c := IntToStr(CurrentYear);
      if b='' then begin
        DecodeDate(Date, y, m, d);
        b:=IntToStr(m);
      end;
      if IsInteger(a) and IsInteger(b) and IsInteger(c) and
        IsValidDate(StrToInt(c), StrToInt(b), StrToInt(a)) then
        ADat := Format('%.2d.%.2d.%.4d', [StrToInt(a), StrToInt(b), StrToInt(c)])
      else
        Result := FALSE;
    end
    else begin //format bez tecky
      a := Copy(ADat, 1, 2);
      b := Copy(ADat, 3, 2);
      c := Copy(ADat, 5, 4);
      DecodeDate(Date, y, m, d);
      if a = '' then begin
        Result := FALSE;
        EXIT;
      end;
      if b = '' then
        b := IntToStr(m);
      if c = '' then
        c := IntToStr(y);
      if (Length(c) <= 2) and IsInteger(c) then
        if StrToInt(c) >= cTwoDigitLimitYear then
          c := IntToStr(cTwoLimitLastCentury * 100 + StrToInt(c))
        else
          c := IntToStr((cTwoLimitLastCentury + 1) * 100 + StrToInt(c));
      if IsInteger(a) and IsInteger(b) and IsInteger(c) and
        IsValidDate(StrToInt(c), StrToInt(b), StrToInt(a)) then
        ADat := Format('%.2d.%.2d.%.4d', [StrToInt(a), StrToInt(b), StrToInt(c)])
      else
        Result := FALSE;
    end;
  end;
  ADat := Replace('.',ADat,DateSeparator);
end; {CorrectDateString}

{-----------------------------------------------------------------------------
CorrectNumberString
  Odstrani vsechny neciselne znaky, pak otestuje jestli je to cislo,
  pro zadani AInteger otestuje jestli je to cele cislo.
  Vraci v ANum upravenou hodnotu a veysledku funkce jestli se to podarilo
  (t.j. vysledek je desetinne cislo, resp. cele cislo)
-----------------------------------------------------------------------------}
function CorrectNumberString(var ANum: string; AInteger: boolean = FALSE): boolean;
var
  i: integer;
  val: string;
begin
  val:='';
  ANum:=Trim(ANum);
  for i:=1 to Length(ANum) do begin
    {//cislo
    if (ANum[i]>='0') and (ANum[i]<='9') then
      val := val + ANum[i];
    //minus
    if (i=1) and (ANum[i]='-') then
      val := val + ANum[i];}
    //
    //decimal separator
    if not AInteger and
      ((ANum[i]=DecimalSeparator) or
      (ANum[i]='.') or
      (ANum[i]=',')) then
      val := val + DecimalSeparator
    else // a vsechny ostatni znaky
      val := val + ANum[i];
  end;
  ANum := val;
  Result := IsFloat(ANum) or (ANum='');
end; {CorrectNumberString}

{-----------------------------------------------------------------------------
GetPrgVersion
  Vraci textovou hodnotu parametru AValueName ulozenou na samostatnem radku
  ve stringu ASlString ve tvaru value_name=string_value.
-----------------------------------------------------------------------------}

function GetPrgVersion(AFileName: string = ''): string;
var
  Size, Size2: DWord;
  Pt, Pt2: Pointer;
  MajorVersion, MinorVersion, ReleaseVersion, BuildVersion: string;
begin
  if AFileName='' then
    AFileName := Application.ExeName;
  Size := GetFileVersionInfoSize(PChar(AFileName), Size2);
  if Size <= 0 then
  begin
    Result := '';
    Exit;
  end;
  GetMem(Pt, Size);
  try
    GetFileVersionInfo(PChar(AFileName), 0, Size, Pt);
    VerQueryValue(Pt, '\', Pt2, Size2);
    with TVSFixedFileInfo(Pt2^) do
    begin
      MajorVersion := IntToStr(HiWord(dwFileVersionMS));
      MinorVersion := IntToStr(LoWord(dwFileVersionMS));
      ReleaseVersion := IntToStr(HiWord(dwFileVersionLS));
      BuildVersion := IntToStr(LoWord(dwFileVersionLS));
    end;
  finally
    FreeMem(Pt);
  end;
  Result := MajorVersion + '.' + MinorVersion + '.' +
    ReleaseVersion + '.' + BuildVersion;
end; {GetPrgVersion}

function GetWinUserName: string;
const
  cMaxNamelength = 128;
var
  name: array[0..cMaxNamelength] of char;
  l, i: LongWord;
begin
  Result := '';
  l := cMaxNamelength + 1;
  if GetUserName(name, l) then begin
    i := 0;
    while (i < l) and (name[i] <> #0) do begin
      Result := Result + name[i];
      INC(i);
    end;
  end;
end; {GetWinUserName}

{-----------------------------------------------------------------------------
 SearchFiles
  Vyhleda soubory odpovidajici masce AMask v adresari ADir
  (bez lomitka na konci), pripadne i v podadresarich (dle AWithSubDirs)
  a vraci uplne cesty k nim v textu oddelenem CRLF.
 -----------------------------------------------------------------------------}

function SearchFiles(const ADir, AMask: string; AWithSubDirs: boolean): string;
var
  srFile: TSearchRec;
  found: boolean;
  sl: TstringList;
begin
  begin
    if DirectoryExists(ADir) then begin
      found := FindFirst(ADir + '\*.*', faAnyFile, srFile) = 0;
      sl := TstringList.Create;
      try
        while found do begin
          if (srFile.Name[1] <> '.') and
            ((srFile.Attr and faVolumeID) = 0) then begin
            if AWithSubDirs and ((srFile.Attr and faDirectory) <> 0) then
              sl.Text := sl.Text + SearchFiles(ADir + '\' + srFile.Name, AMask,
                AWithSubDirs)
            else if MatchesMask(srFile.Name, AMask) then
              sl.Add(ADir + '\' + srFile.Name);
          end;
          Application.ProcessMessages;
          found := FindNext(srFile) = 0;
        end;
        Result := sl.Text;
      finally
        sl.Free;
        FindClose(srFile);
      end;
    end
    else
      Result := '';
  end;
end; {SearchFiles}

function TryDeleteDirectory(const ADir: string; AWithSubDirs: boolean = false;
  const AMsg: string = ''): Boolean;
begin
  if AWithSubDirs then begin
    Result:=DelTree(ADir);
    if not Result then begin
      Sleep(1000);
      Result:=DelTree(ADir);
      if not Result and (AMsg<>'') then
        MsgBoxErr('','Nepoda�ilo se smazat slo�ku '+ADir+'. '+AMsg,MB_OK);
    end;
  end
  else begin
    Result:=DeleteDirectory(ADir,false);
    if not Result then begin
      Sleep(1000);
      Result:=DeleteDirectory(ADir,false);
      if not Result and (AMsg<>'') then
        MsgBoxErr('','Nepoda�ilo se smazat slo�ku '+ADir+'. '+AMsg,MB_OK);
    end;
  end;
end; {TryDeleteDirectory}

function DefaultPrinter: string;
var
  device, driver, port: PChar;
  handle: THandle;
begin
  GetMem(device, 255);
  GetMem(driver, 255);
  GetMem(port, 255);
  try
    Printer.GetPrinter(device, driver, port, handle);
    Result := device;
  except
    Result := '';
  end;
  if device <> nil then FreeMem(device, 255);
  if driver <> nil then FreeMem(driver, 255);
  if port <> nil then FreeMem(port, 255);
end; {DefaultPrinter}

function SetValidFileName(const AFileName: string): string;
begin
  // Vyhodi znaky \ / : * ? " < > | �
  Result := AFileName;
  Result := Replace('\', Result, '');
  Result := Replace('/', Result, '');
  Result := Replace(':', Result, '');
  Result := Replace('*', Result, '');
  Result := Replace('?', Result, '');
  Result := Replace('"', Result, '');
  Result := Replace('<', Result, '');
  Result := Replace('>', Result, '');
  Result := Replace('|', Result, '');
  Result := Replace('�', Result, '');
  Result := Replace('...', Result, '.');
  Result := Replace('..', Result, '.');
end; {SetValidFileName}

function SetValidFileNameTrim(const AFileName: string): string;
var
  fn,ex: string;
begin
  Result := SetValidFileName(AFileName);
  fn:=PathExtractFileNameNoExt(Result);
  ex:=ExtractFileExt(Result);
  // Odstrani mezery, pomlcku, tecku, carku, strednik na konci
  fn := StrTrimCharRight(fn,' ');
  fn := StrTrimCharRight(fn,'-');
  fn := StrTrimCharRight(fn,'.');
  fn := StrTrimCharRight(fn,',');
  fn := StrTrimCharRight(fn,';');
  fn := StrTrimCharRight(fn,' ');
  Result := fn+ex;
end; {SetValidFileName}

procedure DeleteFiles(APath, AFileSpec: string);
var
  lSearchRec:TSearchRec;
  lPath:string;
begin
  lPath := IncludeTrailingPathDelimiter(APath);
  if FindFirst(lPath+AFileSpec,faAnyFile,lSearchRec) = 0 then
  begin
    try
      repeat
        SysUtils.DeleteFile(lPath+lSearchRec.Name);
      until SysUtils.FindNext(lSearchRec) <> 0;
    finally
      SysUtils.FindClose(lSearchRec);  // Free resources on successful find
    end;
  end;
end;

const
  cItemName = 'Item';
  cItemCountName = 'ItemCount';

procedure SaveStringsToIni(AStrings: TStrings;
  const AIniFileName, ASection, AIdent: string);
var
  i, j: integer;
  iniFile: TMemIniFile;
begin
  iniFile := TMemIniFile.Create(AIniFileName);
  try
    j := 0;
    for i := 0 to AStrings.Count - 1 do
      if AStrings[i] <> '' then begin
        iniFile.WriteString(ASection, AIdent + cItemName + IntToStr(j),
          AStrings[i]);
        INC(j);
      end;
    iniFile.WriteInteger(ASection, AIdent + cItemCountName, j);
    iniFile.UpdateFile;
  finally
    iniFile.Free;
  end;
end; {SaveStringsToIni}

procedure LoadStringsFromIni(AStrings: TStrings;
  const AIniFileName, ASection, AIdent: string);
var
  i: integer;
  iniFile: TMemIniFile;
begin
  iniFile := TMemIniFile.Create(AIniFileName);
  try
    AStrings.Clear;
    for i := 0 to iniFile.ReadInteger(ASection, AIdent + cItemCountName, 0) - 1
      do
      AStrings.Add(iniFile.ReadString(ASection,
        AIdent + cItemName + IntToStr(i), ''));
  finally
    iniFile.Free;
  end;
end; {LoadStringsFromIni}

