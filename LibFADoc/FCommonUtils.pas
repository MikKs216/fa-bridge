procedure CheckFormPosition(var ALeft, ATop: integer; AWidth: integer);
var
  w, h: integer;
begin
  w := GetSystemMetrics(SM_CXVIRTUALSCREEN);
  h := GetSystemMetrics(SM_CYVIRTUALSCREEN);

  if ALeft+AWidth-200<0 then
    ALeft := 100
  else if ALeft+200>w then
