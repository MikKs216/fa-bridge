function CheckICO(const AIC: string): boolean;
var
  i, j, l: integer;
  ic: string;
begin
  Result:=TRUE;
  if AIC='' then
    EXIT;
  if (Length(AIC)>8) or not IsInteger(AIC) then begin
    Result:=FALSE;
    EXIT;
  end;
  //reseni dle kontroly CSSZ, overeno podle kontrol DIC na MFCR
  ic:=StrPadLeft(Trim(AIC),8,'0');
  j:=0;
  for i:=1 to 7 do begin
    l:=StrToInt(Copy(ic,i,1));
    j:=j+l*(9-i);
  end;
  j:=(11 - (j mod 11)) mod 10;
  l:=StrToInt(Copy(ic,8,1));
  Result:=l=j;
end;

//CheckDIC
//
function CheckDIC(const ADIC: string;
  APravnickaOsoba: boolean = FALSE; ATestovatTypOsoby: boolean = FALSE): boolean;
var
  cis: string;
begin

  Result:=TRUE;
  if ADIC='' then
    EXIT;
  if (Length(ADIC)<3) or
    IsInteger(Copy(ADIC,1,1)) or IsInteger(Copy(ADIC,2,1)) then begin
    Result:=FALSE;
    EXIT;
  end
  else if UpperCase(Copy(ADIC,1,2))='CZ' then begin //cizi staty netestujeme
    cis := Copy(ADIC,3,20);
    if ATestovatTypOsoby then begin
      if APravnickaOsoba then begin
        if Length(cis)>8 then begin
          if (Length(cis)=10) and(CheckRodneCislo(cis,TRUE)) then  //#5882 - pokud se jedna o validni DIC FO,
            Result:=FALSE                                          //  tak to nemuze byt validni DIC PO
          else
            Result:=TRUE;
        end
        else
          Result:=CheckICO(cis);
      end
      else
        Result:=CheckRodneCislo(cis,TRUE);
    end
    else begin
      if Length(cis)>8 then begin
        if (Length(cis)=10) then                                   //vlozeno po domluve s Petrou na zaklade #5882 
          Result:=CheckRodneCislo(cis,TRUE)
        else
          Result:=TRUE;
      end
      else
        Result:=CheckICO(cis) or CheckRodneCislo(cis,TRUE);
    end;
  end;
end;

