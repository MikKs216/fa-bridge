  Arguments: ver1:string; ver2:string; major:Boolean; minor:Boolean; release:Boolean
  Result:    integer
  Porovnava verze progamu na pozice major,minor verze a to - ver1>ver2 : 1, ver1=ver2 : 0, ver1<ver2 -1
-------------------------------------------------------------------------------}
function ComparePrgVersion(ver1:string; ver2:string; major:Boolean; minor:Boolean; release:Boolean):integer;
var
  maj1,min1,rel1,maj2,min2,rel2:integer;
begin
   Result := 0;
   maj1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1));
   Delete(ver1,1,Pos('.',ver1));
   min1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1));
   Delete(ver1,1,Pos('.',ver1));
   if pos('.',ver1)>0 then
     rel1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1))
   else
     rel1:=StrToInt(Copy(ver1,1,Length(ver1)));

   maj2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1));
   Delete(ver2,1,Pos('.',ver2));
   min2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1));
   Delete(ver2,1,Pos('.',ver2));
   if pos('.',ver2)>0 then
     rel2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1))
   else
     rel2:=StrToInt(Copy(ver2,1,Length(ver2)));

   if major then begin
     if maj1>maj2 then
       Result:=1
     else if maj1<maj2 then
        Result:=-1;
     Exit;
   end
   else if minor then begin
     if min1>min2 then
       Result:=1
     else if min1<min2 then
        Result:=-1;
     Exit;
   end
   else if release then begin
     if rel1>rel2 then
       Result:=1
     else if rel1<rel2 then
        Result:=-1;
     Exit;
   end;
end;{Compare prg version}

//CompareVersion
// Porovna ver1 a ver2 a vraci ver1>ver2 : 1, ver1=ver2 : 0, ver1<ver2 -1
// pokud je major, minor, release false, tak tuto pozici ignoruje
// Funguje jinak nez ComparePrgVersion - ta slouzi jen pro aktualizace
//
function CompareVersion(ver1:string; ver2:string):integer;
var
  maj1,min1,rel1,maj2,min2,rel2:integer;
begin
   Result := 0;
   maj1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1));
   Delete(ver1,1,Pos('.',ver1));
   min1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1));
   Delete(ver1,1,Pos('.',ver1));
   if pos('.',ver1)>0 then
     rel1:=StrToInt(Copy(ver1,1,pos('.',ver1)-1))
   else
     rel1:=StrToInt(Copy(ver1,1,Length(ver1)));

   maj2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1));
   Delete(ver2,1,Pos('.',ver2));
   min2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1));
   Delete(ver2,1,Pos('.',ver2));
   if pos('.',ver2)>0 then
     rel2:=StrToInt(Copy(ver2,1,pos('.',ver2)-1))
   else
     rel2:=StrToInt(Copy(ver2,1,Length(ver2)));

   if maj1>maj2 then
     Result:=1
   else if maj1<maj2 then
      Result:=-1;
   if Result<>0 then
     Exit;

   if min1>min2 then
     Result:=1
   else if min1<min2 then
      Result:=-1;
   if Result<>0 then
     Exit;

   if rel1>rel2 then
     Result:=1
   else if rel1<rel2 then
    Result:=-1;
end;

//XMLStrToWindows1250
//Prevede xml text (nebo xml soubor) AFileOrStr na Windows1250 text
//Pokud AFileOrStr neni platny xml text (nebo soubor), tak vrac� puvodni text
function XMLStrToWindows1250(const AFileOrStr: string): string;
var
  XMLDoc: IXMLDocument;
begin
  XMLDoc := TXMLDocument.Create(nil) ;
  try
    try
      if FileExists(AFileOrStr) then
        XMLDoc.LoadFromFile(AFileOrStr)
      else
        XMLDoc.XML.Text := AFileOrStr;
      XMLDoc.Active := TRUE;
      XMLDoc.SetEncoding('Windows-1250');
      Result := XMLDoc.XML.Text;
    except
      Result := AFileOrStr;
    end;
  finally
    XMLDoc.Active := FALSE;
    XMLDoc := nil ;
  end;
end;{XMLStrToWindows1250 }

//Zakazane znaky nahradi mezerou - Restricted chars <#32 a jine nez #9 #10 #13
function XMLNormChars(const AXmlStr: string): string;
var
  i: Integer;
begin
  Result:=AXmlStr;
  for i:=1 to Length(Result) do
    if (Result[i]<#32)and(Result[i]<>#9)and(Result[i]<>#10)and(Result[i]<>#13) then
      Result[i]:=#32;
  Result:=Replace('&',Result,'&amp;');
  Result:=Replace('<',Result,'&lt;');
  Result:=Replace('>',Result,'&gt;');
  Result:=Replace('''',Result,'&apos;');
  Result:=Replace('"',Result,'&quot;');
end;


