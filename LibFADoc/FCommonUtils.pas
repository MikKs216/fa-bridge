end; {NormalPath}

function GetUniqueFileName(const APath, AFileName: string): string;
const
  cMax = 1000;
var
  val, path: string;
  n: integer;
begin
  val := '';
  n := 0;
  repeat
    path := NormalPath(APath) + ChangeFileExt(ExtractFileName(AFileName), '') +
      val +
      ExtractFileExt(AFileName);
    INC(n);
    val := '(' + IntToStr(n) + ')';
  until not FileExists(path) or (n = cMax);
  if n = cMax then
    Result := ''
  else
    Result := path;
end; {GetUniqueFileName}

//vyhodi z cesty nebo nazvu souboru nepovolene znaky \ / : * ? " < > |
function CorrectPathName(APathStr: string): string;
var
  i: integer;
begin
  for i:=1 to Length(APathStr) do begin
    case APathStr[i] of
      '\', '/', ':', '*', '?', '"', '<', '>', '|': APathStr[i]:='_';
    end;
  end;
  Result:=APathStr;
end; {CorrectPathName}

(*
//Aritmeticke zaokrouhlovani na cele cislo
//  nepouziva bankovni zaokrouhlovani
//  pomoci round odstanime rozdil na nepodstatnych mistech
//
function RoundFullNumber(AValue: extended): extended;
var
  x: extended;
begin
  if AValue > 0 then
    x:=AValue + 0.5
  else
    x:=AValue - 0.5;
  //pokud je hodnota nepresna tak zaokrouhlime
  if SameValue(x,Round(x)) then
    x:=Round(x);
  Result := Int(x);
end;

//Aritmeticke zaokrouhlovani
//  nepouziva bankovni zaokrouhlovani

function RoundAri(const AValue: extended;
  const ADigit: integer = -2): extended;
var
  LFactor: extended;
begin
  LFactor := IntPower(10, ADigit);
  Result:=RoundFullNumber(AValue / LFactor) * LFactor;
end; {RoundAri}

function RoundUp(const AValue: extended;
  const ADigit: integer = -2): extended;
var
  a: extended;
begin
  a:=RoundAri(AValue,-7)*Power(10,-ADigit); //odstranime drobne na 8 a dalsim des. miste
  if SameValue(a,Round(a)) then
    a:=Round(a);
  Result:=Ceil(a)*Power(10,ADigit);
end; {RoundUpTo}

function RoundDown(const AValue: extended;
  const ADigit: integer = -2): extended;
var
  a: extended;
begin
  a:=RoundAri(AValue,-7)*Power(10,-ADigit); //odstranime drobne na 8 a dalsim des.  miste
  if SameValue(a,Round(a)) then
    a:=Round(a);
  Result:=Floor(a)*Power(10,ADigit);
end; {RoundDownTo}
