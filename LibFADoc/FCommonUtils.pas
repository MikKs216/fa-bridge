function CheckBU(const ABU: string): boolean;
const
  vaha: array [1..10] of integer = (1,2,4,8,5,10,9,7,3,6);
var
  pref,bu: string;

  function Test(const c: string): boolean;
  var
    a, i, j: integer;
  begin
    a:=0;
    j:=1;
    Result:=TRUE;
    for i:=Length(c) downto 1 do begin
      if not IsInteger(Copy(c,i,1)) then begin
        Result:=FALSE;
        EXIT;
      end;
      a:=a+StrToInt(Copy(c,i,1))*vaha[j];
      INC(j);
      Result:=(a mod 11) = 0;
    end;
  end;
begin
  Result:=TRUE;
  if ABU='' then
    EXIT;
  pref:='';
  bu:=Replace(' ',ABU,'');
  if Pos('/',bu)>0 then
    bu:=Copy(bu,1,Pos('/',bu)-1);
  if (Pos('-',bu)>0) and ((Length(bu)-Pos('-',bu))>3) then begin
    pref:=Copy(bu,1,Pos('-',bu)-1);
    bu:=Copy(bu,Pos('-',bu)+1,20);
  end
  else begin
    bu:=bu;
  end;
  bu:=Replace('-',bu,''); //vyhodit dalsi pripadne pomlcky
  if Length(bu)>10 then begin
    pref:=Copy(bu,1,Length(bu)-10);
    bu:=Copy(bu,Length(bu)-9,20);
  end;
  Result:=test(bu);
  if pref<>'' then
    Result:=Result and Test(pref);
end;

