{
  "_comment": "Toto jsou části, které je potřeba PŘIDAT do existujícího package.json",
  
  "contributes": {
    "_comment_views": "Přidat do contributes.views.explorer pole:",
    "views": {
      "explorer": [
        {
          "id": "faHistoryPanel",
          "name": "HISTORIE",
          "when": "config.local-history.enabled != false",
          "weight": 100,
          "description": "Historie aktuálně otevřeného souboru"
        }
      ]
    },
    
    "_comment_commands": "Přidat do contributes.commands pole:",
    "commands": [
      {
        "command": "faHistory.showDiff",
        "title": "Zobrazit rozdíly",
        "icon": "$(diff)"
      },
      {
        "command": "faHistory.restoreFile",
        "title": "Vrátit stav souboru do tohoto bodu",
        "icon": "$(history)"
      },
      {
        "command": "faHistory.refresh",
        "title": "Obnovit historii",
        "icon": "$(refresh)"
      }
    ],
    
    "_comment_menus": "Přidat do contributes.menus objekt:",
    "menus": {
      "view/item/context": [
        {
          "command": "faHistory.showDiff",
          "when": "view == faHistoryPanel && viewItem == historyPatch",
          "group": "navigation"
        },
        {
          "command": "faHistory.restoreFile",
          "when": "view == faHistoryPanel && viewItem == historyPatch",
          "group": "actions"
        }
      ],
      "view/title": [
        {
          "command": "faHistory.refresh",
          "when": "view == faHistoryPanel",
          "group": "navigation"
        }
      ]
    },
    
    "_comment_configuration": "Přidat do contributes.configuration.properties objekt:",
    "configuration": {
      "properties": {
        "local-history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Zapnout/vypnout historii souborů. Když je vypnutá, panel HISTORIE se skryje."
        },
        "faHistory.maxFiles": {
          "type": "number",
          "default": 50,
          "description": "Maximální počet souborů zobrazených v panelu historie"
        },
        "faHistory.showDates": {
          "type": "boolean",
          "default": true,
          "description": "Zobrazovat datumy u verzí v panelu historie"
        }
      }
    }
  },
  
  "_comment_version": "Aktualizovat verzi na 0.5.78 nebo vyšší:",
  "version": "0.5.78"
}

