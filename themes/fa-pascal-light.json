{
  "name": "FA Pascal Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editorLineNumber.foreground": "#999999",
    "editorLineNumber.activeForeground": "#000000",
    "editor.selectionBackground": "#ADD6FF",
    "editor.inactiveSelectionBackground": "#E5EBF1",
    "editor.lineHighlightBackground": "#F5F5F5",
    "editorCursor.foreground": "#000000",
    "editorWhitespace.foreground": "#BFBFBF",
    "editor.findMatchBackground": "#FFA500",
    "editor.findMatchHighlightBackground": "#FFD4A3",
    "editor.findMatchBorder": "#FF6600",
    "editor.findMatchHighlightBorder": "#FFB366",
    "editorBracketMatch.background": "#90EE90",
    "editorBracketMatch.border": "#00AA00"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword.pascal",
        "keyword.control.pascal",
        "keyword.operator.pascal"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type (function, procedure, etc.)",
      "scope": [
        "storage.type.function.pascal",
        "storage.type.prototype.pascal"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function name declaration",
      "scope": [
        "entity.name.function.pascal",
        "entity.name.function.prototype.pascal"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": ""
      }
    },
    {
      "name": "FA Custom Functions",
      "scope": [
        "support.function.fa.pascal"
      ],
      "settings": {
        "foreground": "#C000C0",
        "fontStyle": ""
      }
    },
    {
      "name": "FA Form Field Reference",
      "scope": [
        "entity.name.field.fa.pascal"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Data Types",
      "scope": [
        "storage.support.type.pascal"
      ],
      "settings": {
        "foreground": "#000080"
      }
    },
    {
      "name": "String",
      "scope": [
        "string.quoted.single.pascal",
        "string.other.pascal"
      ],
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric.pascal",
        "constant.numeric.hex.pascal"
      ],
      "settings": {
        "foreground": "#ff74ff"
      }
    },
    {
      "name": "Constants (true, false, nil)",
      "scope": [
        "constant.language.pascal"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Compiler Directives",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Special Variables (self, result)",
      "scope": [
        "token.variable"
      ],
      "settings": {
        "foreground": "#000080",
        "fontStyle": "italic"
      }
    }
  ]
}
















