function TfmDefs.CheckAbsoluteItems(ATL: TcxTreeList; const AIndex: integer): integer;
begin
  Result := Min(ATL.AbsoluteCount, AIndex);
end;

function TfmDefs.ShowFrms(AGroupNo: integer): boolean;
var
  nd, ndBase: TcxTreeListNode;
begin
  nd := cxTvGroups.AbsoluteItems[CheckAbsoluteItems(cxTvGroups, AGroupNo)];
  if (nd<>nil) then begin
    if {nd.HasChildren} (nd.Level = 0) then begin
      Result := AGroupNo=0;
    end
    else begin
      ndBase := nd.Parent;

      if (ndBase<>nil) then begin
        Result := ndBase.AbsoluteIndex=0;
      end
      else
        Result := true;
    end;
  end
  else
    Result := true;
end;

