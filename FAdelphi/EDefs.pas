//UpdFavDef
// Zaktualizuje oblibene definice formularu na novejsi vzor
procedure TfmDefs.UpdFavDef;


  function FindNewDefId(
    const ADefId: string;
    out ANewDefId: string): Boolean;
  var
    dId: string;
  begin
    Result := false;
    ANewDefId := '';
    mtDefs.First;
    while not mtDefs.Eof do begin
      if (mtDefsPreviousDefId.AsString=ADefId) then begin
        if (mtDefsPlatnostDo.AsDateTime=0) then begin
          ANewDefId := mtDefsDefID.AsString;
          mtDefs.Last;
          Result := true;
        end
        else begin
          dId := mtDefsDefID.AsString;
          Result := FindNewDefId(mtDefsDefID.AsString, ANewDefId);
          mtDefs.Locate(mtDefsDefID.FieldName, dId, []);
        end;
      end;
      mtDefs.Next;
    end;
  end;

  function DefIsActual(const ADefId: string): Boolean;
  begin
    Result := false;
    if mtDefs.Locate(mtDefsDefID.FieldName, ADefId, []) then
      Result := (mtDefsPlatnostDo.AsDateTime=0);
  end;

  procedure UpdFavDef;
  var
    newDid: string;
    poradi: integer;
  begin
    mtFavoriteDefs.First;
    poradi := mtFavoriteDefs.RecordCount - 1;
    while not mtFavoriteDefs.EOF do begin
      if (DefIsActual(mtFavoriteDefsDefID.AsString)=false) and
        FindNewDefId(mtFavoriteDefsDefID.AsString, newDid) then begin

        if mtSelectDefs.Locate(mtSelectDefsDefID.FieldName, mtFavoriteDefsDefID.AsString, []) then begin
          poradi := mtSelectDefsFavoriteOrder.AsInteger;
          mtSelectDefs.Edit;
          mtSelectDefsFavorite.Value := FALSE;
          mtSelectDefsFavoriteOrder.Clear;
          mtSelectDefs.Post;
        end;

        if mtSelectDefs.Locate(mtSelectDefsDefID.FieldName, newDid, [])then begin
          if (mtSelectDefsFavorite.Value <> true) then begin
            mtSelectDefs.Edit;
            mtSelectDefsFavorite.Value := true;
            if mtSelectDefsFavoriteOrder.AsInteger=0 then
              mtSelectDefsFavoriteOrder.AsInteger := poradi;
            mtSelectDefs.Post;
          end;
        end;

        //Oblibene
        mtFavoriteDefs.Edit;
        mtFavoriteDefsDefID.AsString := newDid;
        mtFavoriteDefs.Post;
      end;

      mtFavoriteDefs.Next;
    end;
  end;

  procedure InitmtSelectDefsFav;
  begin
    mtSelectDefs.First;
    while not mtSelectDefs.EOF do begin
      if not mtFavoriteDefs.Locate(mtFavoriteDefsDefID.FieldName, mtSelectDefsDefID.AsString, []) then begin
        mtSelectDefs.Edit;
        mtSelectDefsFavorite.Value := FALSE;
        mtSelectDefsFavoriteOrder.Clear;
        mtSelectDefs.Post;
      end;
      mtSelectDefs.Next;
    end;
  end;

var
  dIdS, dIdF, dIdD: string;
  fSD: boolean;
begin
  dIdF := mtFavoriteDefsDefID.AsString;
  dIdD := mtDefsDefID.AsString;
  dIdS := mtSelectDefsDefID.AsString;

  fSD := mtSelectDefs.Filtered;
  mtSelectDefs.Filtered := false;

  mtSelectDefs.DisableControls;
  mtDefs.DisableControls;
  mtFavoriteDefs.DisableControls;
  try
    if (mtDefs.Active=False) then
      mtDefs.Open;

    UpdFavDef;
    mtSelectDefs.Filtered := fSD;
    InitmtSelectDefsFav;

  finally
    mtSelectDefs.EnableControls;
    mtDefs.EnableControls;
    mtFavoriteDefs.EnableControls;
  end;

  mtFavoriteDefs.Locate(mtFavoriteDefsDefID.FieldName, dIdF, []);
  mtDefs.Locate(mtDefsDefID.FieldName, dIdD, []);
  mtSelectDefs.Locate(mtSelectDefsDefID.FieldName, dIdS, []);
end;

//Reakce na prepnuti mezi single a multi monitorem
//wparam je stav novy tedy 0 je jeden monitor, 1 je vice monitoru
procedure TfmDefs.OnMonitorChange(var Msg: TMessage);
{$IFNDEF STANDALONE}
var
  ini: TMemIniFile;
  iniFileName:string;
  l,t:Integer;
  mm:Boolean;
  sekce:string;
{$ENDIF STANDALONE}
begin
{$IFNDEF STANDALONE}
  iniFileName := GetFormsIniPath;
  mm:= iff(Msg.WParam=1,True,False);
  sekce:=GetPosSectionName(mm,Self.Name);

  //2. nacist spravne pozice z ini - sekce multimon nebo singlemon
  ini := TMemIniFile.Create(iniFileName);
  try
    Self.Left:=ini.ReadInteger(sekce, 'Left', FLeftPosition);
    Self.Top:=ini.ReadInteger(sekce, 'Top', FTopPosition);
  finally
    ini.Free;
  end;
  BringToFront;
{$ENDIF STANDALONE}
end;//OnMonitorChange



