procedure TfmDefs.ShowDisableInfo;
begin
  if paFindMain.Visible=true then begin
    paEnabledFormInfo.Visible:=false;
    paDisabledFormInfo.Visible:=false;
    //laFavorites.Caption:=sMsgFavoritesInfo
  end
  else begin
    if cxTabCntrMain.TabIndex=0 then begin
      if ShowFrms(GetGroupNo) then begin
        //laFavorites.Caption := sMsgFavoritesInfo;
        paEnabledFormInfo.Visible:=mtSelectDefsEnabledInLic.Value;
        //paEnabledFormInfo.Visible:=mtSelectDefsValidTo.Value>0;
        paDisabledFormInfo.Visible:=not paEnabledFormInfo.Visible;
        {laFavorites.Visible:=True;
        paFavorites.Visible:=True;}
      end
      else begin
        paEnabledFormInfo.Visible:=false;
        paDisabledFormInfo.Visible:=false;
      end;
    end
    else if cxTabCntrMain.TabIndex=1 then begin
      paEnabledFormInfo.Visible:=true;
      paDisabledFormInfo.Visible:=false;
      //laFavorites.Caption := sMsgFavoritesOutOfDate;
    end
    else if cxTabCntrMain.TabIndex=2 then begin
      paEnabledFormInfo.Visible:=True;
      paDisabledFormInfo.Visible:=false;
    end
  end;

  //paDisabledFormInfo.Visible:=not paEnabledFormInfo.Visible;
end;

