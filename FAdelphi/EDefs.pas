procedure TfmDefs.InitTable;
var
  i, j, k: integer;
  node: TCxTreeListNode;
  sl, sl1: TStringList;
  disabledGroup: boolean;
  year: integer;
  iniFileName, s: string;
  iniFile: TMemIniFile;
  fltd: boolean;

  function AddNode(const AText: string): TCxTreeListNode;
  begin
    Result := cxTvGroups.Add;
    Result.Values[0]:=AText;
  end;

  function AddChildNode(ANode: TCxTreeListNode; const AText: string):
      TCxTreeListNode;
  begin
    if ANode <> nil then begin
      Result := ANode.AddChild;
      Result.Values[0]:=AText;
    end
    else
      Result := nil;
  end;

begin
  //
  StartWait;
  mtGroups.DisableControls;
  cxTvGroups.BeginUpdate;
  sl:= TStringList.Create;
  sl.Sorted:=TRUE;
  mtGroupsParam.Open;
  mtSelectDefs.DisableControls;
  fltd:=mtSelectDefs.Filtered;
  mtSelectDefs.Filtered:=false;

  //mtSelectDefs.AfterScroll := nil;
  try
  {$IFNDEF  STEREONX}
    if FileExists(NormalPath(GetCurrentUserRootPath)+cGroupsFileName) then
      mtGroupsParam.LoadFromFile(NormalPath(GetCurrentUserRootPath)+cGroupsFileName);
  {$ELSE}
    //#MR 2025
    if FileExists(NormalPath(GetCurrentUserRootPath)+'Forms'+PathDelim+cGroupsFileName) then
      mtGroupsParam.LoadFromFile(NormalPath(GetCurrentUserRootPath)+'Forms'+PathDelim+cGroupsFileName);
  {$ENDIF}
    //
    // nacteni mtFavoriteDefs z ini
    {$IFDEF STANDALONE}
      iniFileName:=GfaMain.GetIniFileName;
    {$ELSE STANDALONE}
      iniFileName := GetFormsIniPath;
    {$ENDIF STANDALONE}
    iniFile := TMemIniFile.Create(iniFileName);
    try
      s := iniFile.ReadString(Name, 'FavoriteDefs', '');
    finally
      iniFile.Free;
    end;
    s:=Replace(cCRLFAlternate,s,cCRLF);
    sl1:=TStringList.Create;
    try
      sl1.Text:=s;
      sl1.SaveToFile(GetFavoritesFormsPath);
      if FileExists(GetFavoritesFormsPath) then begin
        if not mtFavoriteDefs.Active then
          mtFavoriteDefs.Open;
        mtFavoriteDefs.LoadFromFile(GetFavoritesFormsPath);
      end;
    finally
      sl1.Free;
    end;
    //
    mtDefs.First;
    i:=1;
    while not mtDefs.EOF do begin
      {$IFDEF STANDALONE}
      disabledGroup:= mtGroupsParam.Locate(mtGroupsParamGroup.FieldName,
        mtDefsSkupina.Value, [loCaseInsensitive]) and
        not mtGroupsParamSelect.Value;
      {$ELSE STANDALONE}
      disabledGroup:= FALSE; //vyber skupin uz je provedeny ve FS
      {$ENDIF STANDALONE}
      if not disabledGroup then begin
        //
        if IsDefVisibleForLic(mtDefsDefID.Value, mtDefsVersion.Value) and
          (Pos(cIdNstDef,mtDefsDefID.Value)<=0) and
          not mtDefsBezTisku.Value and
          (mtDefsDefID.Value<>Copy(FTxtFileName,1,
            Length(FTxtFileName)-4)) then begin
          if mtDefsPlatnostDo.Value<=0  then begin
            //
            if not sl.Find(mtDefsSkupina.Value,k) then
              sl.Add(mtDefsSkupina.Value);
            //
            mtSelectDefs.Append;
            mtSelectDefsID.Value:=i;
            mtSelectDefsPoradi.Value:=mtDefsPoradi.Value;
            mtSelectDefsDefID.Value:=mtDefsDefID.Value;
            mtSelectDefsGroup.Value:=mtDefsSkupina.Value;
            mtSelectDefsSubGroup.Value:=mtDefsPodskupina.Value;
            mtSelectDefsName.Value:=mtDefsNazev.Value;
            mtSelectDefsBarva.Value:=mtDefsBarva.Value;
            mtSelectDefsPreviousDefId.Value:=mtDefsPreviousDefId.Value;
            mtSelectDefsEpoId.Value:=mtDefsEpoId.Value;
            mtSelectDefsFormKey.Value:=mtDefsFormKey.Value;
            mtSelectDefsNameShort.Value:=mtDefsNameShort.Value;
            mtSelectDefsRegGr.Value:=mtDefsRegGr.Value;
            mtSelectDefsValidFrom.Value:=mtDefsPlatnostOd.Value;
            if mtDefsPlatnostDo.Value>0 then
              mtSelectDefsValidTo.Value:=mtDefsPlatnostDo.Value
            else
              mtSelectDefsValidTo.Clear;
            mtSelectDefsYear.Value:=sMsgAktualni;
            mtSelectDefsVariantySestav.Value:=mtDefsVariantySestav.Value;
            mtSelectDefsFavorite.Value:=FALSE;
            mtSelectDefsFavoriteOrder.Clear;
            mtSelectDefsEnabledInLic.Value:=FIsLicStart or IsDefEnableForLic(mtDefsDefID.Value);
            //
            mtSelectDefs.Post;
            INC(i);
            year:=cRokDefinicSNeukoncenouPlatnosti;
          end
          else
            year:=YearOf(mtDefsPlatnostDo.Value);
          for j:=YearOf(mtDefsPlatnostOd.Value) to year do begin
            mtSelectDefs.Append;
            mtSelectDefsID.Value:=i;
            mtSelectDefsPoradi.Value:=mtDefsPoradi.Value;
            mtSelectDefsDefID.Value:=mtDefsDefID.Value;
            mtSelectDefsGroup.Value:=mtDefsSkupina.Value;
            mtSelectDefsSubGroup.Value:=mtDefsPodskupina.Value;
            mtSelectDefsName.Value:=mtDefsNazev.Value;
            mtSelectDefsBarva.Value:=mtDefsBarva.Value;
            mtSelectDefsPreviousDefId.Value:=mtDefsPreviousDefId.Value;
            mtSelectDefsEpoId.Value:=mtDefsEpoId.Value;
            mtSelectDefsFormKey.Value:=mtDefsFormKey.Value;
            mtSelectDefsNameShort.Value:=mtDefsNameShort.Value;
            mtSelectDefsRegGr.Value:=mtDefsRegGr.Value;
            mtSelectDefsValidFrom.Value:=mtDefsPlatnostOd.Value;
            if mtDefsPlatnostDo.Value>0 then
              mtSelectDefsValidTo.Value:=mtDefsPlatnostDo.Value
            else
              mtSelectDefsValidTo.Clear;
            mtSelectDefsYear.Value:=IntToStr(j);
            mtSelectDefsVariantySestav.Value:=mtDefsVariantySestav.Value;
            mtSelectDefsFavorite.Value:=FALSE;
            mtSelectDefsFavoriteOrder.Clear;
            mtSelectDefsEnabledInLic.Value:=FIsLicStart or IsDefEnableForLic(mtDefsDefID.Value);
            //
            mtSelectDefs.Post;
            INC(i);
          end;
        end;
      end;
      mtDefs.Next;
    end;
    //mtDefs.Close;
    //
    //nastaveni oblibenych
    mtFavoriteDefs.First;
    while not mtFavoriteDefs.EOF do begin
      if mtSelectDefs.Locate(mtSelectDefsDefID.FieldName,
        mtFavoriteDefsDefID.Value,[]) then begin
          mtSelectDefs.Edit;
          mtSelectDefsFavorite.Value:=TRUE;
          mtSelectDefsFavoriteOrder.Value:=mtFavoriteDefsFavoriteOrder.Value;
          mtSelectDefs.Post;
      end;
      mtFavoriteDefs.Next;
    end;
    //
    node := AddNode(sMsgFrmGroups);
    for i:=0 to sl.Count-1 do
      AddChildNode(node, sl[i]);

    cxTvGroups.FullExpand;
    //
    SetPopupMenuItems;
    ShowDisableInfo;
  finally
    //mtSelectDefs.AfterScroll := mtSelectDefsAfterScroll;
    //mtSelectDefsAfterScroll(nil);
    ShowDisableInfo;
    mtSelectDefs.Filtered:=fltd;
    mtSelectDefs.EnableControls;

    cxTvGroups.EndUpdate;
    mtGroups.EnableControls;
    mtGroupsParam.Close;
    sl.Free;
    StopWait;
  end;
end; {InitTable}


procedure TfmDefs.InitmtDefs(ADefsStream: TStream);
begin
  if ADefsStream<>nil then begin
    ADefsStream.Seek(0, soFromBeginning);
    mtDefs.LoadFromStream(ADefsStream);
  end
  else begin
    if FileExists(NormalPath(GetDefsPath)+cFormDefinitionList) then
      mtDefs.LoadFromFile(NormalPath(GetDefsPath)+cFormDefinitionList)
    else begin
      MessageErr(Caption,sMsgFDLNotExist,[MBOK]);
      Close;
      EXIT;
    end;
  end;
end;

//Init
procedure TfmDefs.Init(ADefsStream: TStream);
  procedure CloseMt(mt: TkbmMemTable);
  begin
    if mt.Active then
      mt.Close;
    mt.EmptyTable;
  end;

const
  cUserFormDefinitionList = 'DefsUser.fdl';
var
  userName, serialNumber: string;
  zakazatTextoveVzory: boolean;
begin
//  LoadFormStateFromIni;

  if not gForceReloadDefs and FInitialized then
    Exit;

  FInitialized:=TRUE;
  StartWait;
  try

    CloseMt(mtSelectDefs);
    CloseMt(mtDefs);
    CloseMt(mtGroups);
    CloseMt(mtDefsUser);
    CloseMt(mtGroupsParam);
    CloseMt(mtFavoriteDefs);
    CloseMt(mtLegisTexts);
    CloseMt(mtImportedTexts);
    CloseMt(mtUserTexts);
    CloseMt(mtFavoriteTexts);
    CloseMt(mtFind);

    mtFavoriteDefs.Open;
    mtFavoriteTexts.Open;
    mtFind.Open;

    grFindTableView.BeginUpdate;
    grTextsDBBandedTableView1.BeginUpdate;
    grFrmsDBBandedTableView1.BeginUpdate;
    mtFind.DisableControls;
    //mtSelectDefs.DisableControls;
    grFrmsDBBandedTableView3.BeginUpdate;
    grTextsDBBandedTableView2.BeginUpdate;
    mtGroups.DisableControls;
    cxTvGroups.BeginUpdate;

    //
    mtSelectDefs.EmptyTable;
    mtSelectDefs.Open;
    mtDefs.EmptyTable;
    mtDefs.Open;
    cxTvGroups.Clear;

    InitmtDefs(ADefsStream);


    //pripojeni uzivatelskych definic
    if FileExists(NormalPath(GetDefsPath)+cUserFormDefinitionList) then begin
      mtDefsUser.Open;
      mtDefsUser.LoadFromFile(NormalPath(GetDefsPath)+cUserFormDefinitionList);
      mtDefsUser.First;
      while not mtDefsUser.EOF do begin
        mtDefs.Append;
        CopyRec(mtDefsUser,mtDefs);
        mtDefs.Post;
        mtDefsUser.Next;
      end;
      mtDefsUser.Close;
    end;
    // priprava pro testovani na licenci
    FIsLicStart:=IsLicStart;
    if not FIsLicStart and ReadLicence(userName, serialNumber) and
      IsLicInfoValid(userName,serialNumber) then begin
      FModuleChars:=Copy(ExtractProductionNumber(serialNumber),7,maxint);
      FSerialNumber:=serialNumber;
    end
    else
      FModuleChars:='';
{$IFDEF STANDALONE}
    if GFaMain.IsInSlaveState then begin //kdyz je ve slave rezimu tak se podivame na Stereo
      FModuleChars:=FModuleChars+ReadLicStereo;
      if (Pos(cLicModuleF,FModuleChars)<=0)and(Pos('M',FModuleChars)>0) then
        FModuleChars := FModuleChars+cLicModuleF;//kdyz neni licence na zav.cinnost tak ji povolime pokud je licence na mzdy
    end;
{$ENDIF STANDALONE}
    //
    InitTable;
    LoadTexts;

    //
    {$IFDEF STANDALONE}
    mtGroups.DisableControls;
    mtGroupsParam.Open;
    try
      {$IFNDEF  STEREONX}
      if FileExists(NormalPath(GetCurrentUserRootPath)+cGroupsFileName) then
        mtGroupsParam.LoadFromFile(NormalPath(GetCurrentUserRootPath)+cGroupsFileName);
      {$ELSE}
       //#MR 2025
       if FileExists(NormalPath(GetCurrentUserRootPath)+'Forms'+PathDelim+cGroupsFileName) then
        mtGroupsParam.LoadFromFile(NormalPath(GetCurrentUserRootPath)+'Forms'+PathDelim+cGroupsFileName);
      {$ENDIF}

      zakazatTextoveVzory:= mtGroupsParam.Locate(mtGroupsParamGroup.FieldName,
        cGroupTextDocument, [loCaseInsensitive]) and
        not mtGroupsParamSelect.Value;
    finally
      mtGroupsParam.Close;
      mtGroups.EnableControls;
    end;
    {$ELSE STANDALONE}
    zakazatTextoveVzory:=(dmMain.mtSelDefGr.Locate(
      dmMain.mtSelDefGrGroup.FieldName,
      cGroupTextDocument, [loCaseInsensitive]) and
      not dmMain.mtSelDefGrSelect.Value) or
      AccDefGrRO(cGroupTextDocument) or AccDefGrHidden(cGroupTextDocument);
    {$ENDIF STANDALONE}
    {if not zakazatTextoveVzory then begin
      cxTabControl2.Tabs[1].Visible:=TRUE;
    end;}
    LoadFormStateFromIni;
    {if zakazatTextoveVzory then begin
      cxTabControl2.TabIndex:=0;
      cxTabControl2.Tabs[1].Visible:=FALSE;
    end;}
  finally
    grFindTableView.EndUpdate;
    grTextsDBBandedTableView1.EndUpdate;
    grFrmsDBBandedTableView1.EndUpdate;
    mtFind.EnableControls;
    //mtSelectDefs.EnableControls;
    grFrmsDBBandedTableView3.EndUpdate;
    grTextsDBBandedTableView2.EndUpdate;
    mtGroups.EnableControls;
    cxTvGroups.EndUpdate;
    gForceReloadDefs:=False;
    StopWait;
  end;
end; {Init}

function SelectDef(
  ADefsStream: TStream; ALeft, ATop: integer;                                         
  AParamDefColor: boolean;
  out AReportVariants: string; out ADefName: string;
  out ATextDocument: string): string;
begin
  Result:='';
  //formular se vytvari uz v projektu, tady nevytvarime
  try
    with fmDefs do begin

      FLeftPosition:=ALeft;
      FTopPosition:=ATop;
      FParamDefColor:=AParamDefColor;
      FIDSelectedDef:='';
      FDefName:='';
      FTextDocument:='';
      FReportVariantsList:='';

    {
      FIDSelectedDef:='';
      FDefName:='';
      FTextDocument:='';
      FIDSelected:=-1;
      FLastGroupNo:=0;
      FLastFndTVNo:=0;
      FLastGroupTextNo:=0;
      FTabNo:=0;
      FLeftPosition:=ALeft;
      FTopPosition:=ATop;
      FParamDefColor:=AParamDefColor;
      FReportVariantsList:='';
      FTabsChangeEventEnabled:=TRUE;
      FTabsFavChangeEventEnabled:=TRUE;
      FIsInProgramMode:=FALSE;
      FTextsReadOnlyState:=TRUE;
      }
      Init(ADefsStream);
      ShowModal;
      Result := FIDSelectedDef;
      ADefName := FDefName;
      ATextDocument := FTextDocument;
      AReportVariants:=FReportVariantsList;
    end;
  finally
    //if fmDefs<>nil then begin
      //fmDefs.Free;
      //fmDefs:=nil;
    //end;
  end;
end;

function GetFormKey(DefID: string): string;
var fn, fn1, fn2: string;
  v: variant;
begin
  Result:='';
  //formular se vytvari uz v projektu, tady nevytvarime
  try
    with fmDefs do begin
      if FileExists(NormalPath(GetDefsPath)+cFormDefinitionList) then begin
        fn:=NormalPath(GetDefsPath)+cFormDefinitionList;
      try
        mtDefsWork.Close;
        mtDefsWork.EmptyTable;
        mtDefsWork.Open;
        mtDefsWork.LoadFromFile(fn);
        fn1:= mtDefsWorkDefID.FieldName;
        fn2:= mtDefsWorkFormKey.FieldName;
        v := mtDefsWork.Lookup(fn1, DefID, fn2);
        if v=null then
          v:=DefID;
        Result:= VarToStr(v);
      finally
          mtDefsWork.Close;
      end;
    end;
  end;
  except
  end;
end;

