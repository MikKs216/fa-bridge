// Slouzi pro nastaveni viditelnosti definic v seznamu
function TfmDefs.IsDefVisibleForLic(const ADefID, ADefVersion: string): boolean;
var
  verzePrg, vDef, vPrg: string;
  vd,vp: integer;
begin
  verzePrg := GetPrgVersion(Application.ExeName);
  vDef:=Copy(ADefVersion,1,Pos('.',ADefVersion)-1);
  vPrg:=Copy(verzePrg,1,Pos('.',verzePrg)-1);
  if IsInteger(vDef) then begin
    vd:=StrToIntSafe(vDef);
    vp:=StrToIntSafe(vPrg);
    Result:=(vd<=vp);
  end
  else // kdyz nema definice platnou verzi
    Result:=true;
end;

function TfmDefs.IsDefEnableForLic(const ADefID: string): boolean;
begin
  Result:=
    (Copy(ADefID,1,1)<>'d') or //nedanove
    (Copy(ADefID,1,1)='d')and(
      (Copy(ADefID,2,1)='z') or //danove zakladni
      (Copy(ADefID,2,1)='r') or //registrace
      (Copy(ADefID,2,1)='x') or //textove vzory
    (Pos(Uppercase(Copy(ADefID,2,1)),FModuleChars)>0)); //ostatni - testujeme primo tady, funkce z LicUtils trva dlouho protoze cte registry
end;

