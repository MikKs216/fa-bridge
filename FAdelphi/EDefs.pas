procedure TfmDefs.miTextMoveFavoriteUpClick(Sender: TObject);
var
  currentOrder: integer;
  sl: TStringList;
  bm: string;
begin
  grTextsDBBandedTableView2.BeginUpdate;
  sl := TStringList.Create;
  FIsInProgramMode:=TRUE;
  try
    sl.Sorted:=TRUE;
    currentOrder:=mtImportedTextsFavoriteOrder.Value;
    //
    bm:=mtImportedTexts.Bookmark;
    mtImportedTexts.First;
    while not mtImportedTexts.EOF do begin
      if mtImportedTextsFavorite.Value and
        (mtImportedTextsFavoriteOrder.Value<currentOrder) then
        sl.Add(IntToStr(mtImportedTextsFavoriteOrder.Value));
      mtImportedTexts.Next;
    end;
    mtImportedTexts.Bookmark:=bm;
    //
    if sl.Count>0 then begin
      mtImportedTexts.Edit;
      mtImportedTextsFavoriteOrder.Value:=maxint;
      mtImportedTexts.Post;
      //
      if mtImportedTexts.Locate(mtImportedTextsFavoriteOrder.FieldName,
        sl[sl.Count-1],[]) then begin
        mtImportedTexts.Edit;
        mtImportedTextsFavoriteOrder.Value:=currentOrder;
        mtImportedTexts.Post;
      end;
      //
      mtImportedTexts.Bookmark:=bm;
      mtImportedTexts.Edit;
      mtImportedTextsFavoriteOrder.Value:=StrToInt(sl[sl.Count-1]);
      mtImportedTexts.Post;
      //
      // totez v mtFavoriteTexts
      if mtFavoriteTexts.Locate(mtFavoriteTextsFavoriteOrder.FieldName,
        currentOrder,[]) then begin
        mtFavoriteTexts.Edit;
        mtFavoritetextsFavoriteOrder.Value:=maxint;
        mtFavoriteTexts.Post;
      end;
      if mtFavoriteTexts.Locate(mtFavoriteTextsFavoriteOrder.FieldName,
        sl[sl.Count-1],[]) then begin
        mtFavoriteTexts.Edit;
        mtFavoriteTextsFavoriteOrder.Value:=currentOrder;
        mtFavoriteTexts.Post;
      end;
      if mtFavoriteTexts.Locate(mtFavoriteTextsFavoriteOrder.FieldName,
        maxint,[]) then begin
        mtFavoriteTexts.Edit;
        mtFavoriteTextsFavoriteOrder.Value:=StrToInt(sl[sl.Count-1]);
        mtFavoriteTexts.Post;
      end;
    end;
  finally
    FIsInProgramMode:=FALSE;
    grTextsDBBandedTableView2.EndUpdate;
    sl.Free;
  end;
end;

