procedure TfmDefs.btPrevodTextsClick(Sender: TObject);
var
  fldID, fldNazev, fldSkupina, fldPodskupina, fldDokument, fldKomentar: TField;
  i,k: integer;

begin
  StartWait;
  mtImportedTexts.Open;
  mtImportedTexts.DisableControls;
  rveDokument.DataSource:=nil;
  rveKomentar.DataSource:=nil;
  mtLegisTexts.DisableControls;
  mtImportedTexts.EmptyTable;
  FIsInProgramMode:=TRUE;
  try
    with mtLegisTexts do begin
      LoadFromFile(NormalPath(GetDataPrgPath)+'vzory.dat');
      Open;
      fldID:=FindField('id');
      fldNazev:=FindField('jmeno');
      fldSkupina:=FindField('kategorie');
      fldPodskupina:=FindField('problematika1');
      fldDokument:=FindField('dokument');
      fldKomentar:=FindField('komentar');
      if (fldID<>nil)and (fldNazev<>nil) and (fldSkupina<>nil) and
        (fldPodskupina<>nil) and (fldDokument<>nil) and
        (fldKomentar<>nil) then begin
        First;
        i:=1;
        while not EOF do begin
          if (fldSkupina.AsString='DaÚovÈ')or(fldSkupina.AsString='PracovnÌ')or
            (fldSkupina.AsString='ObchodnÌ') then begin
            mtImportedTexts.Append;
            mtImportedTextsID.Value:=fldID.AsString;
            mtImportedTextsNazev.Value:=fldNazev.AsString;
            mtImportedTextsSkupina.Value:=fldSkupina.AsString;
            mtImportedTextsPodskupina.Value:=fldPodskupina.AsString;
            mtImportedTextsDokument.Value:=fldDokument.Value;
            mtImportedTextsKomentar.Value:=fldKomentar.Value;
            mtImportedTextsFavorite.Value:=FALSE;
            mtImportedTextsPoradi.Value:=i;
            mtImportedTextsType.Value:=0;
            i:=i+1;
            mtImportedTexts.Post;
          end;
          mtLegisTexts.Next;
        end;
      end;
      Close;
    end;
    mtImportedTexts.SaveToFile(NormalPath(GfaMain.DirWorkPath)+'mtImportedTexts');
    ZipFile(NormalPath(GfaMain.DirWorkPath)+'mtImportedTexts',
      NormalPath(GfaMain.DirDefsPath)+FTxtFileName,'', gp);
  finally
    FIsInProgramMode:=FALSE;
    rveDokument.DataSource:=dsImportedTexts;
    rveKomentar.DataSource:=dsImportedTexts;
    mtImportedTexts.EnableControls;
    mtLegisTexts.EnableControls;
    StopWait;
  end;
end;

