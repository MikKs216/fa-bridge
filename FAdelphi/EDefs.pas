procedure TfmDefs.SaveFormStateToIni;
var
  iniFile: TMemIniFile;
  iniFileName, s: string;
  sl: TStringList;
  sekce:string;
begin
{$IFDEF STANDALONE}
  if not GfaMain.CanWriteToIniFile then EXIT;
  iniFileName:=GfaMain.GetIniFileName;
{$ELSE STANDALONE}
  iniFileName := GetFormsIniPath;
{$ENDIF STANDALONE}
  iniFile := TMemIniFile.Create(iniFileName);
  try

    sekce:=GetPosSectionName(GMultimonitor,Self.Name);

    iniFile.WriteInteger(sekce, 'Left', Left);
    iniFile.WriteInteger(sekce, 'Top', Top);

    iniFile.WriteInteger(Name, 'Width', Width);
    iniFile.WriteInteger(Name, 'Height', Height);
    //
    iniFile.WriteInteger(Name, 'FLastFndTVNo', FLastFndTVNo);
    iniFile.WriteInteger(Name, 'LastGroupNo', FLastGroupNo);
    iniFile.WriteInteger(Name, 'LastGroupTextNo', FLastGroupTextNo);
    iniFile.WriteInteger(Name, 'LastID', FIDSelected);
    iniFile.WriteString(Name, 'LastTextID', FIDSelectedTextID);
    //
    iniFile.WriteInteger(Name, 'TabIndex', FTabNo);
    iniFile.WriteInteger(Name, 'TabTextIndex', FTextTabNo);
    //
    iniFile.WriteInteger(Name, 'TextSplitBar1', {grTexts.Width}FgrTextsWidth);
    if FIsLicStart then
      iniFile.WriteInteger(Name, 'TextSplitBar2', rveKomentar.Height);

    iniFile.WriteInteger(Name, 'FindTextSplitBar1', paFindPreview.Width);
    iniFile.WriteInteger(Name, 'FindTextSplitBar2', rvFindKom.Height);

    // ulozeni mtFavoriteDefs do ini
    mtFavoriteDefs.SaveToFile(GetFavoritesFormsPath);
    sl:=TStringList.Create;
    try
      sl.LoadFromFile(GetFavoritesFormsPath);
      s:=sl.Text;
      s:=Replace(cCRLF,s,cCRLFAlternate);
      iniFile.WriteString(Name, 'FavoriteDefs', s);
    finally
      sl.Free;
    end;
    //
    // ulozeni mtFavoriteTexts do ini
    mtFavoriteTexts.SaveToFile(GetFavoritesTextsPath);
    sl:=TStringList.Create;
    try
      sl.LoadFromFile(GetFavoritesTextsPath);
      s:=sl.Text;
      s:=Replace(cCRLF,s,cCRLFAlternate);
      iniFile.WriteString(Name, 'FavoriteTexts', s);
    finally
      sl.Free;
    end;
    //
    SaveMemIni(iniFile);
  finally
    iniFile.Free;
  end;
  try
    //Sleep(100); //nastavala chyba ze soubor je blokovan - 21.5.2018 - docasne povoleno, nepodarilo se to navodit a je mozne, ze byla chyba u DX, kterou opravili. 
    grFrmsDBBandedTableView1.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
    //Sleep(100);
    grFrmsDBBandedTableView2.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
    //Sleep(100);
    grFrmsDBBandedTableView3.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
    //Sleep(100);
    grTextsDBBandedTableView1.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
    //Sleep(100);
    grTextsDBBandedTableView2.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
    //Sleep(100);
    grFindTableView.StoreToIniFile(iniFileName, FALSE, [gsoUseFilter]);
  except
  end;
end; {SaveStateFormToIni}

procedure TfmDefs.LoadFormStateFromIni;
var
  iniFile: TMemIniFile;
  iniFileName: string;
  l,t: Integer;
  ms: TMemoryStream;
  sekce:string;
begin
{$IFDEF STANDALONE}
  iniFileName:=GfaMain.GetIniFileName;
{$ELSE STANDALONE}
  iniFileName := GetFormsIniPath;
{$ENDIF STANDALONE}
  iniFile := TMemIniFile.Create(iniFileName);
  ms := TMemoryStream.Create;
  try
    if GetKeyState(VK_SHIFT) >= 0 then begin
      grFrmsDBBandedTableView1.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);
      grFrmsDBBandedTableView2.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);
      grFrmsDBBandedTableView3.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);
      grTextsDBBandedTableView1.StoreToStream(ms);

      grTextsDBBandedTableView1.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);

      grTextsDBBandedTableView1Skupina.GroupIndex := -1;
      if grTextsDBBandedTableView1Skupina.GroupIndex<>0 then begin
        ms.Seek(0, soFromBeginning);
        grTextsDBBandedTableView1.RestoreFromStream(ms);
      end;

      grTextsDBBandedTableView2.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);
      grFindTableView.RestoreFromIniFile(iniFileName, TRUE, FALSE, [gsoUseFilter]);
    end;
    //
    FTabNo:=iniFile.ReadInteger(Name, 'TabIndex', 0);
    FTextTabNo:=iniFile.ReadInteger(Name, 'TabTextIndex', 0);
    FLastGroupNo:=iniFile.ReadInteger(Name, 'LastGroupNo', 0);
    FLastGroupTextNo:=iniFile.ReadInteger(Name, 'LastGroupTextNo', 0);
    FLastFndTVNo:=iniFile.ReadInteger(Name, 'FLastFndTVNo', 0);
    //
    FIdSelected:=iniFile.ReadInteger(Name, 'LastID', -1);
    FIDSelectedTextID:=iniFile.ReadString(Name, 'LastTextID', '');

    grTexts.Width:=iniFile.ReadInteger(Name, 'TextSplitBar1', 409);
    if FIsLicStart then
      rveKomentar.Height:=iniFile.ReadInteger(Name, 'TextSplitBar2', 87);

    paFindPreview.Width:=iniFile.ReadInteger(Name, 'FindTextSplitBar1', paFindPreview.Width);
    rvFindKom.Height:=iniFile.ReadInteger(Name, 'FindTextSplitBar2', 87);

    rveKomentar.Visible := FIsLicStart;
    splKomentar.Visible := rveKomentar.Visible;


    if FIdSelected>-1 then
      mtSelectDefs.Locate(mtSelectDefsID.FieldName,FIdSelected,[]) //musi byt i zde, protoze v nastavovani filtru se pozice uklada do FIdSelected
    else
      grFrmsDBBandedTableView1.DataController.GotoFirst;

    FgrTextsWidth := grTexts.Width;
  finally
    iniFile.Free;
    ms.Free;
  end;
end; {LoadFormStateFromIni}

procedure TfmDefs.LoadFormPositionFromIni;
var
  iniFile: TMemIniFile;
  iniFileName: string;
  l,t, w, h: Integer;
  sekce:string;
  recWndPlmt:TWindowPlacement;
begin
{$IFDEF STANDALONE}
  iniFileName:=GfaMain.GetIniFileName;
{$ELSE STANDALONE}
  iniFileName := GetFormsIniPath;
{$ENDIF STANDALONE}
  iniFile := TMemIniFile.Create(iniFileName);
{$IFDEF STANDALONE}
  l:=iniFile.ReadInteger(Name, 'Left', FLeftPosition);
  t:=iniFile.ReadInteger(Name, 'Top', FTopPosition);
  Width := iniFile.ReadInteger(Name, 'Width', cDefaultWidth);
  Height := iniFile.ReadInteger(Name, 'Height', cDefaultHeight);
  CheckFormPosition(l,t,Width);
  Left:=l;
  Top:=t;
{$ELSE STANDALONE}
  w := iniFile.ReadInteger(Name, 'Width', cDefaultWidth);
  h := iniFile.ReadInteger(Name, 'Height', cDefaultHeight);
  sekce:=  GetPosSectionName(GMultimonitor,self.Name);
  l:=iniFile.ReadInteger(sekce, 'Left', FLeftPosition);
  t:=iniFile.ReadInteger(sekce, 'Top', FTopPosition);

  Width := w;
  Height := h;

  GetTopLeftOnPrimary(GMultimonitor,Rect(l,t,l+Self.Width,t+self.Height),t,l);
  recWndPlmt.length:=SizeOf(TWindowPlacement); // toto se musi pouzit misto prirazeni Top a Left - chyba Delphi pri nastavovani u vice monitoru
  recWndPlmt.rcNormalPosition.Top := t;
  recWndPlmt.rcNormalPosition.Left := l;
  recWndPlmt.rcNormalPosition.Bottom := t+self.Height;
  recWndPlmt.rcNormalPosition.Right := l+Self.Width;
  recWndPlmt.showCMD := SW_NORMAL;
  SetWindowPlacement(Self.Handle, @recWndPlmt);
{$ENDIF STANDALONE}
end; {LoadFormPositionFromIni}

