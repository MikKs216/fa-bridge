procedure TfmDefs.SetTab;

  procedure SetStarsi;
  begin
    paLeft1.Width:=0;
    Splitter1.Width:=0;
    grFrmsLevel1.GridView:=grFrmsDBBandedTableView2;
    tlFav.Visible := False;

    if paVzors.Visible then begin
      paVzors.Visible := false;
      paForms.Visible := true;
    end;

    laFavorites.Visible:=FALSE;
    paFavorites.Visible:=FALSE;
    miFrmRozbalitSbalitVis(true);

    FrmApplyFiltersAktualni('('+mtSelectDefsYear.FieldName+'<>'''+sMsgAktualni+''') and ('+
      mtSelectDefsValidTo.FieldName +'>0)');

    //sbalime roky
    grFrmsDBBandedTableView2.DataController.Groups.FullCollapse;
  end;

  function GetFilterGroup(AGroupNo: integer): string;
  begin
    if (IsFirstTxtVzGr(AGroupNo)) or (cxTvGroups.FocusedNode=nil)  then
      Result := ''
    else
      Result := '('+mtImportedTextsSkupina.FieldName+
        '='''+cxTvGroups.FocusedNode.Values[0]+''')';
  end;

  procedure SetTextGroup(AGroupNo: integer);
  begin
    if cxTvGroups.Count=0 then
      EXIT;

    if cxTvGroups.AbsoluteItems[AGroupNo]<>nil then begin
      cxTvGroups.Select(cxTvGroups.AbsoluteItems[AGroupNo]);
      cxTvGroups.FocusedNode:=cxTvGroups.AbsoluteItems[AGroupNo];
    end
    else begin
      cxTvGroups.Select(cxTvGroups.AbsoluteItems[0]);
      cxTvGroups.FocusedNode:=cxTvGroups.AbsoluteItems[0];
    end;

    FLastGroupTextNo:=AGroupNo;
  end;

  procedure AktualniTxtVzInitCtrls;
  begin
    grTextsLevel1.GridView:=grTextsDBBandedTableView1;
    grTextsDBBandedTableView1.OptionsView.GroupByBox := false;
    laFavorites.Visible:=FALSE;
    paFavorites.Visible:=FALSE;

    grTexts.Width := FgrTextsWidth;
    grTexts.Align := alLeft;
    grTexts.Width := FgrTextsWidth;
    splitterTexts.Visible:=true;
    splitterTexts.Align := alRight;
    splitterTexts.Align := alLeft;
    paTxtVzPreview.Visible:=True;
    grTexts.Width := FgrTextsWidth;

    grTexts.Width := FgrTextsWidth;
    grTexts.OnResize := grTextsResize;
  end;

  procedure SetAktualniTxtVz;
  var
    filtr: string;
  begin
    AktualniTxtVzInitCtrls;

    SetTextGroup(GetGroupNo);

    miTextFavoriteDeleteAll.Visible := false;
    miTextMoveFavoriteUp.Visible := false;
    miTextMoveFavoriteDown.Visible := false;

    miTxtVzSbalitskupiny.Visible := true;
    miTxtVzRozbalitskupiny.Visible := true;
    miTxtVzRozSb.Visible := true;

    filtr := GetFilterGroup(GetGroupNo);
    TxtVzApplyFiltersAktualni(filtr);
    if (cxTvGroups.FocusedNode<>nil) and
      (GetGroupNo>0) then
      mtImportedTexts.Locate(mtImportedTextsID.FieldName,
        FIDSelectedTextID,[]);
  end;

  procedure AktualniInit;
  begin
    cxTvGroups.Visible := true;
    laContent.FocusControl := cxTvGroups;

    if paLeft1.Width<188 then begin
      paLeft1.Width:=188;
      Splitter1.Width:=3;
      Splitter1.Align:=alRight;
      Splitter1.Align:=alLeft;
    end;
  end;

  procedure SetAktualniFrm;
  var
    filtr: string;
  begin
    grFrmsLevel1.GridView := grFrmsDBBandedTableView1;
    cxTvGroups.Visible := True;
    tlFav.Visible := False;
    laFavorites.Visible:=FALSE;
    paFavorites.Visible:=FALSE;

    miFrmRozbalitSbalitVis(false);

    SetGroup(GetGroupNo);
    filtr :=
      ConCatExpr('('+mtFindYear.FieldName+'='''+sMsgAktualni+''')', GetGroupFilter(GetGroupNo), 'AND');

    FrmApplyFiltersAktualni(filtr);
    //
    if (cxTvGroups.FocusedNode<>nil) and
      (GetGroupNo>0) then
      mtSelectDefs.Locate(mtSelectDefsID.FieldName,FIdSelected,[]);
  end;

  procedure SetAktualni;
  var
    showFrm: boolean;
  begin
    AktualniInit;

    showFrm := ShowFrms(GetGroupNo);
    paVzors.Visible := not showFrm;
    paForms.Visible := showFrm;

    if showFrm then
      SetAktualniFrm
    else
      SetAktualniTxtVz;
  end;

  procedure SetOblibeneFrm;
  begin
    laFavorites.Visible:=TRUE;
    paFavorites.Visible:=TRUE;
    miFrmRozbalitSbalitVis(false);

    FrmApplyFiltersAktualni(mtSelectDefsFavorite.FieldName);
    grFrmsLevel1.GridView:=grFrmsDBBandedTableView3;

    mtSelectDefs.Locate(mtSelectDefsID.FieldName,FIdSelected,[]);
    grFrmsDBBandedTableView3.DataController.Groups.FullExpand;
  end;

  procedure SetOblibeneTxtVz;
  begin
    grTexts.OnResize := nil;
    grTextsLevel1.GridView:=grTextsDBBandedTableView2;
    laFavorites.Visible:=TRUE;
    paFavorites.Visible:=TRUE;
    paEnabledFormInfo.Visible := True;
    paDisabledFormInfo.Visible := False;

    miTextFavoriteDeleteAll.Visible := true;
    miTextMoveFavoriteUp.Visible := true;
    miTextMoveFavoriteDown.Visible := true;

    miTxtVzSbalitskupiny.Visible := False;
    miTxtVzRozbalitskupiny.Visible := False;
    miTxtVzRozSb.Visible := False;

    FgrTextsWidth := grTexts.Width;
    paTxtVzPreview.Visible:=False;
    grTexts.Align := alClient;
    splitterTexts.Visible:=False;

    TxtVzApplyFiltersAktualni(mtImportedTextsFavorite.FieldName);
    mtImportedTexts.Locate(mtImportedTextsID.FieldName,FIDSelectedTextID,[]);
  end;

  function AddNode(const AText: string): TCxTreeListNode;
  begin
    Result := tlFav.Add;
    Result.Values[0]:=AText;
  end;

  procedure InittlFav;
  begin
    if tlFav.AbsoluteCount=0 then begin
      AddNode(sMsgFrmGroups);
      if IsLicModule(cLicModuleVzory) or (FLocalVersion = cLocalVersionSK) then
        AddNode(sMsgTxtVzGroups);

      SetTlFavFrmAbsoluteIndex(FLastFndTVNo);
    end;
  end;

  procedure FavCommonInit;
  begin
    laFavorites.Visible:=FALSE;
    paFavorites.Visible:=FALSE;

    if paLeft1.Width<>188 then begin
      paLeft1.Width:=188;
      Splitter1.Width:=3;
      Splitter1.Align:=alRight;
      Splitter1.Align:=alLeft;
    end;
    InittlFav;
    tlFav.Visible := True;
    cxTvGroups.Visible := False;
    laContent.FocusControl := tlFav;
  end;


  procedure SetFavTab;
  begin
    FgrTextsWidth := grTexts.Width;
    FavCommonInit;
    paVzors.Visible := not IsTlFavFrm;
    paForms.Visible := IsTlFavFrm;

    laFavorites.Visible:=True;
    paFavorites.Visible:=True;


    if IsTlFavFrm then
      SetOblibeneFrm
    else
      SetOblibeneTxtVz;

    FLastFndTVNo:=GetTlFavFrmAbsoluteIndex;
  end;

begin
  AktualniTxtVzInitCtrls;

  case cxTabCntrMain.TabIndex of
    0: begin
      SetAktualni;
    end;
    1: begin
      SetStarsi;
    end;
    2: begin
      SetFavTab;
    end;
  end;
  FTabNo := cxTabCntrMain.TabIndex;
  SetPopupMenuItems;
  ShowDisableInfo;
end;

procedure TfmDefs.FrmApplyFiltersAktualni(const AFiltr: string);
var
  id: integer;
begin
  mtSelectDefs.DisableControls;
  try
    id:=mtSelectDefsID.Value;
    //
    mtSelectDefs.Filtered := FALSE;
      if AFiltr <> '' then begin
        mtSelectDefs.Filter := AFiltr;
        mtSelectDefs.Filtered := TRUE;
      end;

  if (id<0) or
    not mtSelectDefs.Locate(mtSelectDefsID.FieldName,id,[]) then
    grFrms.ActiveView.DataController.GotoFirst;
  finally
    mtSelectDefs.EnableControls;
  end;
  mtSelectDefs.Refresh;
end;


procedure TfmDefs.SetGroup(AGroupNo: integer);
begin
  if cxTvGroups.Count=0 then
    EXIT;

  if (cxTvGroups.AbsoluteCount>AGroupNo)and (cxTvGroups.AbsoluteItems[AGroupNo]<>nil) then begin
    cxTvGroups.Select(cxTvGroups.AbsoluteItems[AGroupNo]);
    cxTvGroups.FocusedNode:=cxTvGroups.AbsoluteItems[AGroupNo];
  end
