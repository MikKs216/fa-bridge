procedure TfmDefs.miMoveFavoriteUpClick(Sender: TObject);
var
  currentOrder: integer;
  sl: TStringList;
  bm: string;
begin
  grFrmsDBBandedTableView3.BeginUpdate;
  sl := TStringList.Create;
  try
    sl.Sorted:=TRUE;
    currentOrder:=mtSelectDefsFavoriteOrder.Value;
    //
    bm:=mtSelectDefs.Bookmark;
    mtSelectDefs.First;
    while not mtSelectDefs.EOF do begin
      if mtSelectDefsFavorite.Value and
        (mtSelectDefsFavoriteOrder.Value<currentOrder) then
        sl.Add(IntToStr(mtSelectDefsFavoriteOrder.Value));
