procedure TfmDefs.DoFindFrmsVz(const AFndTxt: string);

  procedure InitPanels;
  var
    visFnd: boolean;
  begin
    visFnd := ShowFindPanel;
    if paFindMain.Visible <> visFnd then begin
      paFindMain.Visible := visFnd;
      laVysledkyCap.Visible := visFnd;
      cxTabCntrMain.Visible := not visFnd;
      paFormsAndVzors.Visible := not visFnd;
      Application.ProcessMessages;
    end;

    laFavorites.Visible:=FALSE;
    paFavorites.Visible:=FALSE;
  end;

  procedure NaplnMtFind;
  var
    dId: string;
  begin
    if mtFind.RecordCount=0 then begin
      dId := mtSelectDefsDefID.Value;
      mtSelectDefs.First;
      while not mtSelectDefs.EOF do begin
        if ((cbFilterStarsi.Checked=false) and (mtSelectDefsYear.Value=sMsgAktualni)) or (cbFilterStarsi.Checked=true) then begin
          mtFind.Insert;
          mtFindFrmID.Value := mtSelectDefsID.Value;
          mtFindDefID.Value := mtSelectDefsDefID.Value;
          mtFindValidFrom.Value := mtSelectDefsValidFrom.Value;
          mtFindValidTo.Value := mtSelectDefsValidTo.Value;
          mtFindGroup.Value := mtSelectDefsGroup.Value;
          mtFindVariantySestav.Value := mtSelectDefsVariantySestav.Value;
          mtFindSubGroup.Value := mtSelectDefsSubGroup.Value;
          mtFindName.Value := mtSelectDefsName.Value;
          mtFindBarva.Value := mtSelectDefsBarva.Value;
          mtFindYear.Value := mtSelectDefsYear.Value;
          mtFindType.Value := coFrmGroups;
          mtFindTypeCap.Value := sMsgFrmGroups;
          mtFindInFilter.Value := true;
          mtFind.Post;
        end;

        mtSelectDefs.Next;
      end;
      mtSelectDefs.Locate(mtSelectDefsDefID.FieldName, dId, []);

      if IsLicModule(cLicModuleVzory) or (FLocalVersion = cLocalVersionSK) then begin
        dId := mtImportedTextsId.Value;
        mtImportedTexts.First;
        while not mtImportedTexts.EOF do begin
          mtFind.Insert;
          mtFindID.Value := mtImportedTextsID.Value;
          //mtFindPlatnostOd.Value := mtImportedTextsPlatnostOd.Value;
          //mtFindPlatnostDo.Value := mtImportedTextsPlatnostDo.Value;
          mtFindGroup.Value := mtImportedTextsSkupina.Value;
          mtFindSubGroup.Value := mtImportedTextsPodskupina.Value;
          mtFindName.Value := mtImportedTextsNazev.Value;
          mtFindDokument.Value := mtImportedTextsDokument.Value;
          mtFindKomentar.Value := mtImportedTextsKomentar.Value;
          mtFindYear.Value := sMsgAktualni;
          //mtFindBarva.Value := mtImportedTextsBarva.Value;
          mtFindType.Value := coTxtVzGroups;
          mtFindTypeCap.Value := sMsgTxtVzGroups;
          mtFindInFilter.Value := true;
          mtFind.Post;

          mtImportedTexts.Next;
        end;
        mtImportedTexts.Locate(mtImportedTextsId.FieldName, dId, []);
      end;
      
    end;
  end;

  procedure MtFindClearF;
  begin
    with mtFind do begin
      if ShowFindPanel then begin
        if Filtered then
          Filtered:=FALSE;
        First;
        while not EOF do begin
          if mtFindInFilter.Value=false then begin
            Edit;
            mtFindInFilter.Value:=True;
            Post;
          end;
          Next;
        end;
      end
    end;
  end;

  function CalcFilterFrms(const AFilterStr: string): string;
  var
    fndTxt: string;
  begin
    Result := '';
    with mtFind do begin
      if AFilterStr<>'' then begin
        if cbFilterStarsi.Checked then
          Result := '('+mtFindYear.FieldName+'<>'''+sMsgAktualni+''')'
        else
          Result := '('+mtFindYear.FieldName+'='''+sMsgAktualni+''')';

        fndTxt := AnsiUpperCase(AFilterStr);
        First;
        while not EOF do begin
          if (mtFindType.AsString=coFrmGroups) and (mtFindInFilter.Value) then begin
            if not (
              (Pos(fndTxt, AnsiUpperCase(mtFindDefID.Value))>0) or
              (Pos(fndTxt, AnsiUpperCase(mtFindName.Value))>0)) then begin
              Edit;
              mtFindInFilter.Value:=false;
              Post;
            end;
          end;
          Next;
        end;
        if pos('InFilter', Result)=0 then
          Result := ConCatExpr(Result, '(InFilter)', 'AND');
      end;
    end;
  end;

  procedure ApplyFindFilters(const AFilter: string);
  begin
    if AFilter <> '' then begin
      mtFind.Filter:=AFilter;
      if mtFind.Filtered <> TRUE then
        mtFind.Filtered := TRUE;
    end
    else
      mtFind.Filtered := FALSE;
  end;

  function FindInRtf(const AStr: string; ASt: TMemoryStream): boolean;
  begin
    ASt.Clear;
    mtFindDokument.SaveToStream(ASt);
    ASt.Seek(0, soFromBeginning);
    RichEdit1.Lines.LoadFromStream(ASt);
    Result:=RichEdit1.FindText(AStr,0,maxint,[])>=0;
  end;

  function CalcFilterTxtVz(const AFilterStr: string): string;
  var
    st: TMemoryStream;
  var
    fndTxt: string;
  begin
    Result := '';
    st:=TMemoryStream.Create;
    try
      with mtFind do begin
        if AFilterStr<>'' then begin
          fndTxt := AnsiUpperCase(AFilterStr);
          First;
          while not EOF do begin
            if (mtFindType.AsString=coTxtVzGroups) and (mtFindInFilter.Value) then begin
              if not ((Pos(fndTxt, AnsiUpperCase(mtFindName.Value))>0) or
                (cbSearchInTexts.Checked and
                FindInRTF(AFilterStr, st))) then begin
                Edit;
                mtFindInFilter.Value:=False;
                Post;
              end;
            end;
            Next;
          end;
          Result := '(InFilter)';
        end;
      end;
    finally
      st.Free;
    end;
  end;

var
  {idTxt, }filtr: string;
  //idFrm: integer;
  filtDefs, filtrImpTxt: boolean;
begin
  StartWait;
  if mtFind.Active = false then
    mtFind.Open;

  {if mtFindID.Value<>'' then
    idTxt:=mtFindID.Value
  else
    idTxt:='';

  if mtFindFrmID.Value>0 then
    idFrm:=mtFindFrmID.Value
  else
    idFrm := 0;}

  grFindTableView.BeginUpdate;
  grTextsDBBandedTableView1.BeginUpdate;
  grFrmsDBBandedTableView1.BeginUpdate;
  mtFind.DisableControls;
  mtSelectDefs.DisableControls;
  mtImportedTexts.DisableControls;
  filtDefs := mtSelectDefs.Filtered;
  filtrImpTxt := mtImportedTexts.Filtered;
  mtSelectDefs.Filtered := FALSE;
  mtImportedTexts.Filtered := FALSE;
  rvFindDoc.DataSource := nil;
  rvFindKom.DataSource := nil;
  rveDokument.DataSource:=nil;
  rveKomentar.DataSource:=nil;
  //mtSelectDefs.AfterScroll := nil;
  try
    mtFind.Filtered:=FALSE;
    InitPanels;

    NaplnMtFind;

{    if length(FOldFindingTxt)>length(AFndTxt) then
      MtFindClearF;}

    MtFindClearF;

    FOldFindingTxt := AFndTxt;

    filtr :=
      ConCatExpr(CalcFilterFrms(AFndTxt), CalcFilterTxtVz(AFndTxt), 'and');
    ApplyFindFilters(filtr);

    rvFindDoc.DataSource := dsFind;
    rvFindKom.DataSource := dsFind;

    mtSelectDefs.Filtered := filtDefs;
    mtImportedTexts.Filtered := filtrImpTxt;

    {if (idFrm=0) or
      not mtFind.Locate(mtFindFrmID.FieldName,idFrm,[]) then begin
      if (idTxt='') or
        not mtFind.Locate(mtFindID.FieldName,idTxt,[]) then begin
        if not mtFind.Locate(mtFindType.FieldName,coFrmGroups,[]) then begin
          grFind.ActiveView.DataController.GotoFirst;
        end;
      end;
    end;}
    grFind.ActiveView.DataController.GotoFirst;
    ShowDisableInfo;

  finally
    //mtSelectDefs.AfterScroll := mtSelectDefsAfterScroll;
    rveDokument.DataSource:=dsImportedTexts;
    rveKomentar.DataSource:=dsImportedTexts;
    grFindTableView.EndUpdate;
    grTextsDBBandedTableView1.EndUpdate;
    grFrmsDBBandedTableView1.EndUpdate;
    mtFind.EnableControls;
    mtSelectDefs.EnableControls;
    mtImportedTexts.EnableControls;
    StopWait;
  end;

  grFind.ActiveView.DataController.Groups.FullExpand;
end;

