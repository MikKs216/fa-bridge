procedure TfmDefs.LoadTexts;
var
  sl, sl1: TStringList;
  node: TCxTreeListNode;
  iniFileName, s, txt: string;
  iniFile: TMemIniFile;

  function AddNode(const AText: string): TCxTreeListNode;
  begin
    Result := cxTvGroups.Add;
    Result.Values[0]:=AText;
  end;

  function AddChildNode(ANode: TCxTreeListNode; const AText: string):
      TCxTreeListNode;
  begin
    if ANode <> nil then begin
      Result := ANode.AddChild;
      Result.Values[0]:=AText;
    end
    else
      Result := nil;
  end;
var
  k: integer;
begin
  if mtImportedTexts.Active then
    EXIT;
  //
  StartWait;
  mtImportedTexts.Open;
  mtImportedTexts.DisableControls;
  rveDokument.DataSource:=nil;
  rveKomentar.DataSource:=nil;
  FIsInProgramMode:=TRUE;
  sl:= TStringList.Create;
  sl.Sorted:=TRUE;
  try
    {$IFDEF STANDALONE}
     if FileExists(NormalPath(GetDataPrgPath)+cUserTextsFileName) then
       mtUserTexts.LoadFromFile(NormalPath(GetDataPrgPath)+cUserTextsFileName);
     mtUserTexts.Open;
    {$ENDIF STANDALONE}
    // nacteni mtFavoriteTexts z ini
    {$IFDEF STANDALONE}
      iniFileName:=GfaMain.GetIniFileName;
    {$ELSE STANDALONE}
      iniFileName := GetFormsIniPath;
    {$ENDIF STANDALONE}
    iniFile := TMemIniFile.Create(iniFileName);
    try
      s := iniFile.ReadString(Name, 'FavoriteTexts', '');
    finally
      iniFile.Free;
    end;
    s:=Replace(cCRLFAlternate,s,cCRLF);
    sl1:=TStringList.Create;
    try
      sl1.Text:=s;
      sl1.SaveToFile(GetFavoritesTextsPath);
      if FileExists(GetFavoritesTextsPath) then begin
        mtFavoriteTexts.LoadFromFile(GetFavoritesTextsPath);
      end;
    finally
      sl1.Free;
    end;
    //nacist distribucni vzory
    if FileExists(NormalPath(GfaMain.DirDefsPath)+FTxtFileName) then begin
      if not LoadMemTableFromZip(mtImportedTexts,
        NormalPath(GfaMain.DirDefsPath)+FTxtFileName,gp) then
        MessageInfo(Caption, sMsgNoTextTemplates, [MBOK]);
    end;
    //nacist polozky obsahu
    txt:=sMsgFiktivniDokument1+#13#10#13#10+
      sMsgFiktivniDokument2+': ................................'#13#10+
      sMsgFiktivniDokument3+': ................................'#13#10#13#10+
      sMsgFiktivniDokument4+': ..... '+
      sMsgFiktivniDokument5+': ................................'#13#10#13#10+
      sMsgFiktivniDokument6;
    mtImportedTexts.First;
    while not mtImportedTexts.EOF do begin
      if not sl.Find(mtImportedTextsSkupina.Value,k) then
        sl.Add(mtImportedTextsSkupina.Value);
      //
      if FIsLicStart then begin
        mtImportedTexts.Edit;
        mtImportedTextsDokument.AsString:=txt;
        mtImportedTextsKomentar.AsString:=sMsgInfoTextDocument;
        mtImportedTexts.Post;
      end;
      //
      mtImportedTexts.Next;
    end;
    //pripojit vlastni vzory
    {$IFDEF STANDALONE}
    mtUserTexts.First;
    while not mtUserTexts.EOF do begin
      mtImportedTexts.Append;
      CopyRec(mtUserTexts,mtImportedTexts);
      if not sl.Find(mtImportedTextsSkupina.Value,k) then
        sl.Add(mtImportedTextsSkupina.Value);
      mtImportedTextsType.Value:=1;
      mtImportedTexts.Post;
      mtUserTexts.Next;
    end;
    {$ELSE STANDALONE}
    dmMain.qUsrTxs.First;
    while not dmMain.qUsrTxs.EOF do begin
      mtImportedTexts.Append;
      CopyRec(dmMain.qUsrTxs,mtImportedTexts);
      if not sl.Find(mtImportedTextsSkupina.Value,k) then
        sl.Add(mtImportedTextsSkupina.Value);
      mtImportedTextsType.Value:=1;
      mtImportedTexts.Post;
      dmMain.qUsrTxs.Next;
    end;
    {$ENDIF STANDALONE}
    //vytvorit obsah
    if IsLicModule(cLicModuleVzory) or (FLocalVersion = cLocalVersionSK) then
      node := AddNode(sMsgTxtVzGroups);
    {for i:=0 to sl.Count-1 do
      if sl[i]<>'' then
        AddChildNode(node, sl[i]);}
    cxTvGroups.FullExpand;
    //nastavit oblibene
    mtFavoriteTexts.First;
    while not mtFavoriteTexts.EOF do begin
      if mtImportedTexts.Locate(mtImportedtextsID.FieldName,
        mtFavoriteTextsTextID.Value,[]) then begin
          mtImportedTexts.Edit;
          mtImportedTextsFavorite.Value:=TRUE;
          mtImportedTextsFavoriteOrder.Value:=mtFavoriteTextsFavoriteOrder.Value;
          mtImportedTexts.Post;
      end;
      mtFavoritetexts.Next;
    end;
    //nastavit posledni nebo prvni zaznam
    if FIDSelectedTextID<>'' then
      mtImportedTexts.Locate(mtImportedTextsID.FieldName,FIDSelectedTextID,[])
    else
      mtImportedTexts.First;
  finally
    FIsInProgramMode:=FALSE;
    rveDokument.DataSource:=dsImportedTexts;
    rveKomentar.DataSource:=dsImportedTexts;
    mtImportedTexts.EnableControls;
    sl.Free;
    StopWait;
  end;
end;

function TfmDefs.CreateTextDocument(const ANazev: string; ADokument: TDBRichViewEdit): string;
var
  st: TMemoryStream;
  sl: TStringList;
begin
  st:= TmemoryStream.Create;
  sl:= TStringList.Create;
  try
    ADokument.SaveRTFToStream(st,FALSE);//rveDokument
    st.Seek(0, soFromBeginning);
    sl.LoadFromStream(st);
    Result:='[FormHead]'#13#10+
      'DefID='+FDefIDTextDocument+#13#10#13#10+
      '[Values]'#13#10+
      'DATUM='+DateToStr(date)+#13#10+
      'NAZEV='+ANazev+#13#10+//mtImportedTextsNazev.Value
      'PREJITNATEXT=True'#13#10#13#10+
{      '[Comment]'#13#10+
      mtImportedTextsNazev.Value+#13#10#13#10+}
      '[Appendix]'#13#10+sl.Text;
   finally
     st.Free;
     sl.Free;
   end;
end;

