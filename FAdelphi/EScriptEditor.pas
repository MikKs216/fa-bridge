function EditScript(const AScript, ACaption: string): string;
begin
  if fmScriptEditor <> nil then begin  //mohl byt otevreny jiny sript v unmodal rezimu
    fmScriptEditor.Free;
    fmScriptEditor:=nil;
  end;
  fmScriptEditor:=TfmScriptEditor.Create(nil);
  try
    with fmScriptEditor do begin
      LoadFormStateFromIni;
      Caption := ACaption;
      paHeader.Visible := FALSE;
      UpdateEditors(False);
      ActiveScript.Lines.Text := AScript;
      SetCursorPos(0,0);
      GfaMain.dxBarButtonSave.Enabled := FALSE;
      ActiveScript.PopupMenu:=pmModalScript;
      fmScriptEditor.ShowModal
    end;
    Result := fmScriptEditor.ActiveScript.Lines.Text;
  finally
    fmScriptEditor.Free;
    fmScriptEditor:=nil;
  end;
end; {EditScript}

procedure EditScriptUnModal(const AScript, ACaption: string);
begin
  if fmScriptEditor <> nil then begin
    with fmScriptEditor do begin
      Caption := ACaption;
      //{$--IFDEF UCURSOR} nepouzito
      //ActiveScript.Lines.Text := AScript;
      //{$--ENDIF UCURSOR}
      SetCursorPos;
      if IsDebugMode and (PopupMenu1a.Items.Count > 0) then
        ActiveScript.PopupMenu := PopupMenu1a
      else
        ActiveScript.PopupMenu:=PopupMenu1;
      //FIsChanged:= FALSE;
      BringToFrontEx;
    end;
  end
  else begin
    fmScriptEditor:=TfmScriptEditor.Create(nil);
    with fmScriptEditor do begin
      LoadFormStateFromIni;
      Caption := ACaption;
      paHeader.Visible := TRUE;
      UpdateEditors(False);
      ActiveScript.Lines.Text := AScript;
      SetCursorPos(0,0);
      ActiveScript.PopupMenu:=PopupMenu1;
      FIsChanged:= FALSE;
      fmScriptEditor.Show;
    end;
  end;
end; {EditScriptUnModal}

