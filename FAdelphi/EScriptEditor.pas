const
  cMacroFileName = 'macro.file';
  cMacroListFileName = 'macro.list';
  cMacroZipFileExt = '.mcs';

//z nazvu (popisu) makra vraci klavesovou zkratku
//(ta je vzdy za posledni levou kulatou zavorkou a konci druhy znak od konce!!!)  
function MacroGetShortCutFromName(const AMacroName: string): string;
var
  p: integer;
  zn: string;
begin
  p := Length(AMacroName);
  repeat
    Dec(p);
    zn := Copy(AMacroName, p, 1);
  until (zn = '(');
  Result := Copy(AMacroName, p+1, Length(AMacroName)-p-1);
end;

// Transform TShortCut to use for RegisterHotKey
procedure MacroShortCutToHotKey(HotKey: TShortCut; var Key : Word; var Modifiers: Uint);
var
  Shift: TShiftState;
begin
  ShortCutToKey(HotKey, Key, Shift);
  Modifiers := 0;
  if (ssShift in Shift) then
  Modifiers := Modifiers or MOD_SHIFT;
  if (ssAlt in Shift) then
  Modifiers := Modifiers or MOD_ALT;
  if (ssCtrl in Shift) then
  Modifiers := Modifiers or MOD_CONTROL;
end;

// WM_HOTKEY Hotkey Handler
procedure TfmScriptEditor.WMHotKey(var Msg: TWMHotKey);
var
  i, hotKeyId, hotKeyIndex: Integer;
  sl : TStringList;
begin
  if not ActiveScript.Focused then
    Exit;
  //
  sl := TStringList.Create;
  try
    hotKeyIndex := -1;
    for i := 0 to FMacroList.Count - 1 do begin
      sl.CommaText := FMacroList[i];
      hotKeyId := StrToIntSafe(sl[0]);
      if Msg.HotKey = hotKeyId then begin
        hotKeyIndex := i;
        Break;
      end;
    end;
    //
    if hotKeyIndex > -1 then begin
      ecMacroRecorder1.Play(hotKeyIndex);
      //zmeny provedene makrem promitne i do druheho skritu
      if IsSecondScriptVisible then begin
        UnActiveScript.OnChange := nil;
        UnActiveScript.BeginUpdate;
        try
          UnActiveScript.Lines.Text := ActiveScript.Lines.Text;
        finally
          UnActiveScript.EndUpdate(False);
          UnActiveScript.OnChange := meScriptChange;
        end;
      end;
    end;
  finally
    sl.Free;
  end;
end;

//z macroRecorderu smaze makro, odpovidajici klavesove zkratce 
procedure TfmScriptEditor.MacroDeleteMacroByShortCut(const AShortCutName: string);
var
  i: integer;
begin
  for i := ecMacroRecorder1.Count - 1 downto 0 do
    if MacroGetShortCutFromName(ecMacroRecorder1.Macros[i].Name) = AShortCutName then
      ecMacroRecorder1.DeleteMacro(i);
end;

//register Hotkey
procedure TfmScriptEditor.MacroShortCutRegister;
var
  Key : Word;
  Modifiers: UINT;
  i, hotKeyId: integer;
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    for i := 0 to FMacroList.Count - 1 do begin
      sl.CommaText := FMacroList[i];
      MacroShortCutToHotKey(TextToShortCut(sl[1]), Key, Modifiers);
      hotKeyId := GlobalAddAtom(PAnsiChar('MyMacro_'+IntToStr(i)));
      RegisterHotKey(Handle, hotKeyId, Modifiers, Key);
      sl[0] := IntToStr(hotKeyId);
      FMacroList[i] := sl.CommaText;
    end;
  finally
    sl.Free;
  end;
end;

// Remove Hotkey
procedure TfmScriptEditor.MacroShortCutUnRegister;
var
  i, hotKeyId: integer;
  sl : TStringList;
begin
  sl := TStringList.Create;
  try
    for i := 0 to FMacroList.Count - 1 do begin
      sl.CommaText := FMacroList[i];
      hotKeyId := StrToIntSafe(sl[0]);
      UnRegisterHotKey(Handle, hotKeyId);
      GlobalDeleteAtom(hotKeyId);
    end;
  finally
    sl.Free;
  end;
end;

//- ulozi makra a kl. zkratky maker do souboru
//- preregistruje klavesove zkratky
procedure TfmScriptEditor.MacrosSaveToFile;
var
  tmpDir: string;
  i: integer;
begin
  tmpDir := GetEnvironmentVariable('TEMP')+'\'+CreateGUIDString+'\';
  ForceDirectories(tmpDir);
  try
    //odregistujeme klavesove zkratky maker
    MacroShortCutUnRegister;
    //ulozime makra do souboru
    ecMacroRecorder1.SaveToFile(tmpDir+cMacroFileName);
    //ulozime klavesove zkratky maker do FMacroList a do souboru
    FMacroList.Clear;
    for i := 0 to ecMacroRecorder1.Count - 1 do
      FMacroList.Add('0,'+MacroGetShortCutFromName(ecMacroRecorder1.Macros[i].Name));
    //
    FMacroList.SaveToFile(tmpDir+cMacroListFileName);
    ZipFile(tmpDir+'*.*', ChangeFileExt(Application.ExeName, cMacroZipFileExt), '');
    //registujeme klavesove zkratky maker
    MacroShortCutRegister;
  finally
    if DirectoryExists(tmpDir) then
      DeleteDirectory(tmpDir,false);
  end;
end;

//- nacte makra a kl. zkratky maker ze souboru
//- zaregistruje klavesove zkratky
procedure TfmScriptEditor.MacrosLoadFromFile;
var
  tmpDir, fn: string;
begin
  if FMacroList = nil then
    FMacroList := TStringList.Create;
  //hleda soubor maker
  fn := ChangeFileExt(Application.ExeName, cMacroZipFileExt);
  if not FileExists(fn) then
    Exit;
  //
  tmpDir := GetEnvironmentVariable('TEMP')+'\'+CreateGUIDString+'\';
  ForceDirectories(tmpDir);
  try
    //rozzipuje soubor maker
    UnZipFile(ChangeFileExt(Application.ExeName, cMacroZipFileExt), tmpDir);
    //nacte makra
    fn := tmpDir+cMacroFileName;
    if FileExists(fn) then
      ecMacroRecorder1.LoadFromFile(fn);
    //nacte klavesove zkratky maker
    fn := tmpDir+cMacroListFileName;
    if FileExists(fn) then begin
      FMacroList.LoadFromFile(fn);
      //registujeme klavesove zkratky maker
      MacroShortCutRegister;
    end;
  finally
    if DirectoryExists(tmpDir) then
      DeleteDirectory(tmpDir,false);
  end;
end;

//naformatuje nazev (popis) makra na tvar: "Nazev makra (klavesova zkratka)"
//a makra ulozi
procedure TfmScriptEditor.MacroSetName(const AName, AShortCut: string; AMacroIndex: integer);
begin
  if AMacroIndex < ecMacroRecorder1.Count then
    ecMacroRecorder1.Macros[AMacroIndex].Name := Format('%s   (%s)', [AName, AShortCut]);
