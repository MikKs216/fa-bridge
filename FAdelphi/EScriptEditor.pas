procedure TfmScriptEditor.SaveScript(ABringMainToFront: boolean = TRUE);
var
  isChangingScript, btSaveEnabled: boolean;
begin
  if (GfaMain.ScripterT.Running) then begin
    MsgBoxErr(Caption, 'Definici nelze uložit, protože je spuštìno debagování.', MB_OK);
    Exit;
  end;
  //
  btSaveEnabled:=GfaMain.dxBarButtonSave.Enabled;
  isChangingScript:=GfaMain.FIsChangingScript;
  GfaMain.FIsChangingScript:=TRUE; //aby se neprovadelo calculate
  try
    (*if (FDebugForm <> nil) then begin
      SaveBreaks;
      FDebugForm.Scripter.CurrentScript.Breaks.Clear;
    end;*)
    ActiveScript.Lines.SaveToFile(NormalPath(GetExePath)+'Script.txt');
    if IsDebugMode then
      GfaMain.AcceptFormScript(ChangeScriptCompiling(False, False))
    else
      GfaMain.AcceptFormScript(ActiveScript.Lines.Text);
    //
    FIsChanged:= FALSE;
    GfaMain.SaveFormScript;
    GfaMain.ReloadListBoxes;
    BringToFront;
    //pokud je pri ulozeni otevrene okno pro debugovani, tak ho dame do popredi
    //v opacnem pripade zobrazime okno FA
    (*if (FDebugForm <> nil) then begin
      FDebugForm.Scripter := GfaMain.ScripterT;
      FDebugForm.AdvMemo1.SyntaxStyles := TMSStyler1;
      FDebugForm.CenterMemoSetCursor(ActiveScript.CaretPos.X, ActiveScript.CaretPos.Y);
      LoadBreaks;
      FDebugForm.BringToFront;
    end
    else*) begin
      if ABringMainToFront then
        GfaMain.BringToFront;
    end;
  finally
    GfaMain.dxBarButtonSave.Enabled := btSaveEnabled;
    GfaMain.FIsChangingScript:=isChangingScript;
  end;
  //
  if IsDebugMode then begin
    ChangeScriptCompiling(ckShowScriptCompiled.Checked);
    PrepareScriptToRun;
  end;
end;

