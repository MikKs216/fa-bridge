procedure TfmScriptEditor.AddWatch(AStrWatch: string; AShowDialog: boolean);
var
  fmWatchProperties: TfmWatchPropertiesLegacy;
  str: string;

  procedure CheckPlaceHolderItem;
  begin
    { ensure that one empty item always be present at the bottom of watch list.
      this item is a place holder for a new watch }
    with fmWatchViewer,List,Items do
      if (Count=0) or (Items[Count-1]<>'') then
        Add('');
  end;

begin
  if (not IsDebugMode) or (fmWatchViewer = nil) then
    Exit;
  //
  str := AStrWatch;
  if (str = '') then begin //puvodni
    if AShowDialog then begin
      fmWatchViewer.Show;
      fmWatchViewer.AddWatch;
    end;
  end
  else begin
    with fmWatchViewer, List do begin
      CheckPlaceHolderItem;
      ItemIndex := Items.Count-1;
      //
      fmwatchProperties := TfmWatchPropertiesLegacy.Create(self);
      with List , fmWatchProperties do
      begin
        DebugWatches := GfaMain.ScripterT.CurrentScript.VirtualMachine.DebugWatches;
        DebugWatch := DebugWatches.Add;
        DebugWatch.Expression := str;
        DebugWatch.Enabled := true;
        //DebugWatches.Evaluate(DebugWatch);
        DebugWatch := TatDebugWatch(DebugWatch);
        if (not AShowDialog) or (ShowModal = mrOk) then begin
          { vincula o item apresentado ao objeto de watch correspondente }
          if Assigned(DebugWatch) then
            Items.Objects[ItemIndex] := DebugWatch;
          fmWatchViewer.Refresh;
          fmWatchViewer.Show;
          CheckPlaceHolderItem;
        end;
      end;
      fmWatchProperties.Free;
    end;
  end;
end;

