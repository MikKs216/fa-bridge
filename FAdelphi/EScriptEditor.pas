procedure TfmScriptEditor.ApplicationEvents1Message(var Msg: tagMSG;
  var Handled: Boolean);
var
  nam: string;
  codeBlock: TCodeBlock;

  procedure SetToggleBookmark(ABookmark: integer);
  var
    tl: Integer;
  begin
    if (GetKeyState(VK_CONTROL) < 0) then begin
      if (GetKeyState(VK_SHIFT) < 0) then begin
        ActiveScript.ToggleBookmark(ABookmark);
        //nastavime bookmark i u druheho scriptu
        tl := UnActiveScript.TopLine;
        UnActiveScript.CaretPos := ActiveScript.CaretPos;
        UnActiveScript.ToggleBookmark(ABookmark);
        UnActiveScript.TopLine := tl;
      end
      else begin
        ActiveScript.GotoBookmark(ABookmark);
        if ActiveScript.Bookmarks[ABookmark] > -1 then
          CenterMemo;
      end;
      Handled := TRUE;
    end;
  end;

begin
  if Active then begin
    if (ActiveControl is TSyntaxMemo) then
      FIsCtrlReturnFromScript := False;
    //Klavesa Alt+ ...
    if Msg.message = WM_SYSKEYDOWN then begin
      if (ActiveControl is TSyntaxMemo) then begin
        //Alt + W
        if (Msg.wParam = 87) then begin  //pri ladeni, zmena skriptu na kompilovany/normalni rezim
          if IsDebugMode then begin
            ckShowScriptCompiled.Checked := not ckShowScriptCompiled.Checked;
            Handled := TRUE;
          end;
        end
      end;
    end;      
    //Ostatni klavesy
    if Msg.message = WM_KEYDOWN then begin
      if (ActiveControl is TSyntaxMemo) then begin
        //Ctrl + [Shift] + [
        if (Msg.wParam = 219) and (GetKeyState(VK_CONTROL)<0) then begin  //vlozi do skriptu [..]
          ActiveScript.InsertText('[.');
          if (GetKeyState(VK_SHIFT)<0) then begin //pokud je navic zmacknuty Shift, tak vlozi [.NazevFieldu.]
            nam:=GfaMain.FLastFieldName;
            if nam <> '' then
              ActiveScript.InsertText(nam);
          end;
          ActiveScript.InsertText('.]');
          Handled := TRUE;
          EXIT;
        end
        //Ctrl + [Shift] + ]        
        else if (Msg.wParam = 221) and (GetKeyState(VK_CONTROL)<0) then begin  //vlozi do skriptu [::]
          ActiveScript.InsertText('[:');
          if (GetKeyState(VK_SHIFT)<0) then begin//pokud je navic zmacknuty Shift, tak vlozi [:NazevFieldu:]
            nam:=GfaMain.FLastFieldName;
            if nam <> '' then
              ActiveScript.InsertText(nam);
          end;
          ActiveScript.InsertText(':]');
          Handled := TRUE;
          EXIT;
        end
        //Ctrl + S
        else if (Msg.wParam = 83) and (GetKeyState(VK_CONTROL)<0) then begin  //ulozeni skriptu
          if paHeader.Visible and btnDebugNew.Enabled then
            SaveScript;
          Handled := TRUE;
        end
        //Ctrl + W
        else if (Msg.wParam = 87) and (GetKeyState(VK_CONTROL)<0) then begin  //vstup do/vystu z debagovani
          if paHeader.Visible and btnDebugNew.Enabled then
            btnDebugNewClick(nil);
          Handled := TRUE;          
        end
        //Ctrl + Q
        else if (Msg.wParam = 81) and (GetKeyState(VK_CONTROL)<0) then begin  //prepnuti do mainu
          miActiveFormClick(nil);
          Handled := TRUE;
        end;
        //F8
        if (Msg.wParam = VK_F8) then begin
          if not IsDebugMode then begin
            if (GetKeyState(VK_CONTROL)<0) then
              miMacroRecOrStopClick(nil)
            else
              miMacroEditClick(nil);
            Handled := TRUE;
          end;
        end;
        //Ctrl + [Shift] + 1-6
        case Msg.wParam of
          49: SetToggleBookmark(1);
          50: SetToggleBookmark(2);
          51: SetToggleBookmark(3);
          52: SetToggleBookmark(4);
          53: SetToggleBookmark(5);
          54: SetToggleBookmark(6);
        end;
        //Ctrl+Enter
        if (Msg.wParam = VK_RETURN) and (GetKeyState(VK_CONTROL)<0) then begin
          codeBlock := GetCodeBlockByCaption(ActiveScript.WordAtPos(ActiveScript.CaretPos));
          if (codeBlock <> nil) then
            ActiveScript_InsertCodeBlock(codeBlock, TRUE)
          else begin
            FIsCtrlReturnFromScript := TRUE;
            ShowCodeLists(TRUE);
            ScrCodeList1.ItemIndex := -1;
            ScrCodeList1.SetFocus;
          end;
          Handled := TRUE;
        end;
      end;
      //
      if (ActiveControl is TScrCodeList) then begin
        if (Msg.wParam = VK_ESCAPE) then
          ActiveScript.SetFocus
        else if (Msg.wParam = VK_RETURN) and FIsCtrlReturnFromScript and (ScrCodeList1.ItemIndex > -1) then
          ActiveScript_InsertCodeBlock(ScrCodeList1.CodeBlocks.Items[ScrCodeList1.ItemIndex], TRUE);
      end;
    end;
    //
    FIsForScroll := False;
    if (Msg.message = WM_MOUSEWHEEL) or
       (Msg.wParam = VK_UP) or
       (Msg.wParam = VK_DOWN) then begin
      if IsSecondScriptVisible and (GetKeyState(VK_CONTROL)<0) then
        FIsForScroll := True;
    end;
    //
    {if (Msg.message = WM_MOUSEWHEEL) and IsSecondScriptVisible and (GetKeyState(VK_CONTROL)>=0) then
        GetCursorPos;
    end;}
  end;
end;

