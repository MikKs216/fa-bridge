//jedna se o volani standardniho okna od E-Control s tim, ze skryvam vetsinu tlacitek
//!!! hlavne tlacitko "rename" neni mozne zobrazit, protoze by mohlo dojit ke smazani klavesove zkratky z nazvu (popisu) 
function TfmScriptEditor.MacroEdit(ACanPlay: boolean): Boolean;
var
  md: TMacrosEditDlg;
begin
  Result := False;
  md := TMacrosEditDlg.Create(nil);
  try
    md.MacroRecorder := ecMacroRecorder1;
    md.Button3.Visible := ACanPlay;    //play macro
    md.Button4.Visible := False;       //rename macro
    md.Button12.Visible := False;      //add macro
    md.Button6.Visible := False;       //change command
    md.Button8.Visible := False;       //add command
    md.Button7.Visible := False;       //delete command
    md.Button9.Visible := False;       //clear command
