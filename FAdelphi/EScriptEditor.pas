  //v pripade, ze funkce AFncName obsahuje pouze dva parametry, tak prida treti parametr cKodAlpha
  procedure UpravVolaniIncFncStat(AFncName: string);
  var
    s: string;
    i, n, p, d: Integer;
  begin
    n := StrStrCount(scr, AFncName);
    for i := 1 to n do begin
      p := StrNPos(scr, AFncName, i);
      s := Copy(scr, p + Length(AFncName) - 1, MaxInt);
      d := Pos(cPravaZav, s) - 1;
      s := Copy(s, 1, d);
      if CountListItems(s) = 2 then begin
        s := s + ', ''' + cKodAlpha + '''';
      end;
      Delete(scr, p + Length(AFncName) - 1, d);
      Insert(s, scr, p + Length(AFncName) - 1);
    end;
  end;

  //vyhleda funkci AFncName a pokud neobsahuje zadny parametr (tzn. za nazvem funkce neni kulata zavorka),
  //tak prida text: ('')
  procedure UpravVolaniIncFncRozsahUZ(AFncName: string);
  var
    s: string;
    i, j, n, p, d: Integer;
  begin
    n := StrStrCount(scr, AFncName);
    for i := 1 to n do begin
      p := StrNPos(scr, AFncName, i);
      s := Copy(scr, p + Length(AFncName), MaxInt);
      for j := 1 to Length(s) do
        if (Ord(s[j])>32) then begin
          if (s[j] <> cLevaZav) then
            Insert(cObeZavApo, scr, p + Length(AFncName));
          Break;
        end;
    end;
  end;

  //vlozi include konstantu, pokud ve skriptu chybi
  procedure VlozIncConst(const AConstName, AConstText: string);
  var
    p, pCo: Integer;
  begin
    p := FindWordPos(cDataToXML, scr);
    pCo := FindWordPos(AConstName, scr);
    if p > 0 then begin
      if (pCo = 0) or (pCo > p) then begin
        Insert(AConstText, scr, p);
      end;
    end;
  end;

  //zjistuje, zda na pozici P zacina sdilena cast skriptu
  //- TRUE - v P vraci pozici posledniho znaku sdileneho skriptu
  //- FALSE - hodnota P se nemeni
  function IsInclude(const S: string; var P: integer): boolean;
  var
    inComLom, inComSloz, inComKul: boolean;
    i, pZal: integer;
    incStopName: string;
  begin
    Result := False;
    //
    if (S[P] = '{') and SameText(Copy(S, P, Length(cIncStart)), cIncStart) then begin
      incStopName := Copy(S, P + Length(cIncStart), MaxInt);
      incStopName := cIncStop + Copy(incStopName, 1, Pos('}',incStopName));
      //
      i := P+Length(cIncStart);
      repeat
        Inc(i);
        //
        if (S[i] = '{') and SameText(Copy(S, i, Length(incStopName)), incStopName) then begin
          P := i+Length(incStopName);
          Result := True;
          Break;
        end;
      until (i >= Length(S)) or (Result);
    end;
  end;

  //zjistuje, zda se na pozici P nachazi komentar
  //- TRUE - v P vraci pozici posledniho znaku komentare
  //- FALSE - hodnota P se nemeni
  //AInApo - pokud je True, tzn. prochazime text mezi apostrofy a v tom pripade komentare netestujeme
  //ALastChar - pomocny znak, diky kteremu se s komentarem pracuje jinym zpusobem
  //          - pokud je znak zadan (to je jen v pripade, ze se zpracovavaji const a var),
  //            tak se s komentarem nepracuje standardne, ale kopiruje se spolu s const a var
  //            (jedna se vetsinou o jednoradkove komentare prave ke const a var)
  function IsComment(const S: string; var P: integer; AInApo: Boolean = False; ALastChar: Char = #0): boolean;
  var
    inComLom, inComSloz, inComKul: boolean;
    i, pZal: integer;
  begin
    Result := False;
    if AInApo then
      Exit;
    //
    pZal := P;
    inComLom:=False; inComSloz:=False; inComKul:=False;
    if (S[P] = '(') and (S[P+1] = '*') and (not inComSloz) and (not inComLom) then
      inComKul := True;
    if (S[P] = '{') and (not inComKul) and (not inComLom) then
      InComSloz := True;
    if (S[P] = '/') and (S[P+1] = '/') and (not inComKul) and (not inComSloz) then
      inComLom := True;
    //
    Result := inComKul or InComSloz or inComLom;
    //
    if Result then
      if (ALastChar > #13) then begin
        Result := False;
        Exit;
      end;
    //
    if Result then begin //zde asi doplnit testovani, ze nize uvedene znaky najou ani v komentari, ani v apostrofu
      for i := P+1 to Length(S) do begin
        if inComKul and (S[i] = '*') and (S[i+1] = ')') then begin
          P := i+1;
          Break;
        end
        else if InComSloz and (S[i] = '}') then begin
          P := i;
          Break;
        end
        else if (S[i] = #13) and (S[i+1] = #10) and (inComLom) then begin
          P := i-1;
          Break;
        end;
      end;
      if P = pZal then
        P :=  i-1;
    end;
  end;

  //zjistuje, zda se na pozici P nachazi funkce nebo procedura
  //v Ln vraci delku slova "procedure" nebo "function", podle toho, zda byla nalezena procedura nebo funkce
  function IsFncOrProc(const S: string; const P: integer; var Ln: integer): boolean;
  var
    str: string;
  begin
    Result := False;
    //
    str := Copy(S, P, MaxInt);
    //testuje, zda je na pozici 1 procedura nebo funkce
    if (FindWordPos(cProc, str, False) = 1) or (FindWordPos(cFnc, str, False) = 1) then begin
      if (FindWordPos(cProc, str, False) = 1) then  //pokud byla nalezena procedura,
        Ln := Length(cProc)                      //tak si zapamatujeme 9
      else
        Ln := Length(cFnc);                      //u funkce 8
      //
      if (P = 1) then                            //pokud je procedura/funkce hned na zacatku skript,
        Result := True                           //tak ok
      else begin                                 //jinak overime, zda je procedura/funkce na pozici 2 v pripade, ze hledame na pozici P-1
        str := Copy(S, P-1, MaxInt);
        if (FindWordPos(cProc, str, False) = 2) or (FindWordPos(cFnc, str, False) = 2) then
          Result := True;
      end;
    end;
  end;

  //prochazi text S od znaku AFrom do znaku ATo a u kazdeho znaku testuje, zda se nejedna o komentar
  //ty znaky, ktere spadaji do komentare zapise do ASl
  function GetCommentIntList(const S: string; const AFrom, ATo: integer; var ASl: TStringList): boolean;
  var
    i, j, iz: Integer;
    inApo: boolean;
  begin
    inApo:=False;
    i := AFrom;
    repeat
      Inc(i);
      iz := i;
      //
      if (S[i] = cApostrof) then
        inApo := not inApo;
      //
      if IsComment(S, i, inApo) then
        for j := iz to i do
          ASl.Add(IntToStr(j));
    until (i >= ATo);
    Result := (ASl.Count > 0);
  end;

  //testuje, zda se pozice APos (jedna se vlastne o pozici slova W v textu S) vyskytuje ve stringlistu ASl
  //- pokud NE, vraci puvodni pozici APos
  //- pokud ANO, hleda prvni vyskyt slova W v textu S, ktery neni zakomentarovany
  //  (pokud takovy vyskyt nenalezne, vraci 0)
  function GetUnCommentWordPos(const S, W: string; const AFrom, APos: integer;
                               var ASl: TStringList; AGenComment: boolean = False): integer;
  var
    p: Integer;
  begin
    p := APos;
    if (p > 0) and (ASl.IndexOf(IntToStr(p)) > -1) then begin
      repeat
        p := FindWordPos(W, S, False, p+1);
        if AGenComment then begin
          ASl.Clear;
          GetCommentIntList(S, AFrom, p, ASl);
        end;
      until (ASl.IndexOf(IntToStr(p)) = -1) or (p = 0);
    end;
    Result := p;
  end;

  //zjistuje, zda se na pozici P nachazi funkce nebo procedura
  //- TRUE - v P vraci pozici posledniho znaku funkce
  //       - v L vraci pozici prvni proc/fnc v ramci celeho skriptu (nastavuje se jen pro prvnim vyskytu proc/fnc, tzn. kdyz je L=0)
  //- FALSE - hodnota P se nemeni
  function IsFncOrProcPos(const S: string; var P, L: integer): boolean;
  var
    c, p1, pStart, pBeg, pFin, pExc, pCase, pEnd, pProc, pFnc, ln: Integer;
    slIntList: TStringList;
  begin
    ln := 0;
    Result := False;
    //if p = 1116 then //pro testovani
      //c := 0;
    Result := IsFncOrProc(S, P, ln);
    //testujeme, zda za slovem procedure/functiona a mezerou nasleduje alpha znak nebo _ (coz je jediny pripustny nazev proc/fnc)
    //- pokud totiz mame konstantu pojmenovanou napr "coProcedure", tak po odmazani "co" zustane "procedure" a predchozi hledani je v Resultu TRUE
    if Result then begin
      for p1 := P+ln to Length(S) do begin
        if (Ord(S[p1])>32) then begin
          if not (StrIsAlpha(S[p1]) or (S[p1] = '_')) then
            Result := False;
          Break;
        end;
      end;
    end;
    //nyni najdeme konec procedury/funkce a do "P" nastavime pozici posledniho znaku
    if Result then begin
      if L = 0 then
        L := P;
      c := 0;
      pStart := FindWordPos(cBegin, S, False, P);
      //zjistime, zda procedura obsahuje podprocedury, ...
      pProc := FindWordPos(cProc, S, False, P+1);
      pFnc := FindWordPos(cFnc, S, False, P+1);
      pEnd := FindWordPos(cEnd, S, False, P+1);
      p1 := P;
      //... pokud obsahuje, tak zpracujeme pomoci rekurze
      while ((pProc > 0) and (pProc < pStart)) or ((pFnc > 0) and (pFnc < pStart)) do begin
        repeat
          Inc(p1);
          if not IsComment(S, p1) then
            IsFncOrProcPos(S, p1, L);
        until (p1 >= pStart);
        //
        pStart := FindWordPos(cBegin, S, False, p1);
        pProc := FindWordPos(cProc, S, False, p1);
        pFnc := FindWordPos(cFnc, S, False, p1);
      end;
      //vlastni hledani pozice posledniho znaku (pStart je prvni begin ve funkci)
      if pStart > 0 then begin
        slIntList := TStringList.Create;
        try
          Inc(c);
          repeat
            pBeg := FindWordPos(cBegin, S, False, pStart+1);
            pFin := FindWordPos(cFinally, S, False, pStart+1);
            pExc := FindWordPos(cExcept, S, False, pStart+1);
            pCase := FindWordPos(cCase, S, False, pStart+1);
            //hledame prvni "end", ktery neni v komentari
            pEnd := FindWordPos(cEnd, S, False, pStart+1);
            slIntList.Clear;
            GetCommentIntList(S, pStart, pEnd, slIntList);
            if (slIntList.Count > 0) then begin
              pEnd := GetUnCommentWordPos(S, cEnd, pStart, pEnd, slIntList, True);
              pBeg := GetUnCommentWordPos(S, cBegin, pStart, pBeg, slIntList);
              pFin := GetUnCommentWordPos(S, cFinally, pStart, pFin, slIntList);
              pExc := GetUnCommentWordPos(S, cExcept, pStart, pExc, slIntList);
              pCase := GetUnCommentWordPos(S, cCase, pStart, pCase, slIntList);
            end;
            //
            if pEnd = 0 then begin
              c := 0;
              pStart := Length(s);
            end
            else begin
              p1 := 0;
              if pBeg > 0 then
                p1 := pBeg;
              if pFin > 0 then
                if p1 > 0 then
                  p1 := Min(p1, pFin)
                else
                  p1 := pFin;
              if pExc > 0 then
                if p1 > 0 then
                  p1 := Min(p1, pExc)
                else
                  p1 := pExc;
              if pCase > 0 then
                if p1 > 0 then
                  p1 := Min(p1, pCase)
                else
                  p1 := pCase;
              if p1 > 0 then
                pStart := Max(0, p1)
              else
                pStart := 0;
              if (pStart = 0) or (pStart > pEnd) then begin
                Dec(c);
                pStart := pEnd;
              end
              else
                Inc(c)
            end;
          until (c = 0);
        finally
          slIntList.Free;
        end;
      end;
      if pStart > 0 then
        P := pStart+Length(cEnd);
      for p1 := P to Length(S) do begin
        if (Ord(S[p1])>32) then begin
          if (S[p1] = ';') then
            P := p1;
          Break;
        end;
      end;
    end;
  end;

  //v parametrech vsech funkci a procedur odstrani "const"
  //v parametrech vsech funkci a procedur zmeni "out" za "var"
  procedure ReplaceFncParam;
  var
    s, s1, zn: string;
    i, j, n, d, pLZ, pPZ, pST, l: Integer;
    inZav, inApo: boolean;
  begin
    inApo:=False;
    i := 0;
    //prochazime cely skript znak po znaku
    repeat
      Inc(i);
      //sdilene skripty nezpracovavame
      if not IsInclude(scr, i) then begin
        if (scr[i] = cApostrof) then
          inApo := not inApo;
        //komentare nezpracovavame
        if (not IsComment(scr, i, inApo)) then begin
          //if i = 261 then  //pro testovani
            //d:=0;
          //u kazdeho znaku testujeme, zda zacina procedura nebo funkce
          if ((Copy(scr, i, Length(cProc)) = cProc) or (Copy(scr, i, Length(cFnc)) = cFnc)) and
             IsFncOrProc(scr, i, l) then begin   //IsFncOrProcPos zde nelze pouzit, protoze by nahrazeni nefungovalo v podprocedurach
            s1 := '';
            pLZ:=0; pPZ:=0; pST:=0;
            inZav:=False; inApo:=False;
            s := Copy(scr, i, MaxInt);           //do "s" ulozime skript od zacatku funkce/procedury
            j := 0;
            repeat                               //prochazime skript od zacatku funkce/procedury
              Inc(j);
              //
              if (not IsComment(s, j)) then begin
                zn := s[j];
                if (zn = cApostrof) then           //pokud narazime na apostrof,
                  inApo := not inApo;              //tak si zapamatujeme (resp. se jedna o konec textu v apostrofu)
                if not inApo then begin            //pokud se nejedna o text v apostrofu, tak pokracujeme
                  if (zn = cLevaZav) then begin    //pokud narazime na levou zavorku,
                    if (pLZ = 0) then
                      pLZ := j;                    //tak si zapamatujeme jeji pozici
                    inZav := True;                 //a nastavime priznak "jsme v zavorce"
                  end;
                  if inZav then begin              //pokud jsme v zavorce,
                    if (zn = cPravaZav) then begin //tak pokud narazime na pravou zavorku,
                      if (pPZ = 0) then
                        pPZ := j;                  //tak si zapamatujeme jeji pozici
                      inZav := False;              //a nastavime priznak "nejsme v zavorce"
                    end;
                  end;
                  if not inZav then begin          //pokud v zavorce nejsme,
                    if (zn = cStrednik) then begin //tak pokud narazime na strednik,
                      if (pST = 0) then
                        pST := j;                  //tak si zapamatujeme jeho pozici
                    end;
                  end;
                end;
                //
                if (j = Length(s)) then begin      //pokud se nenasel strednik (napr uplne na konci skriptu, nebo uvnitr komentare)
                  if ((pLZ > 0) and (pPZ > pLZ)) then
                    s1 := Copy(s, 1, pPZ);
                  Break;
                end
                else if ((pST > 0) and (pLZ = 0) and (pPZ = 0)) or   //kopirujeme text po strednik
                        ((pLZ > 0) and (pPZ > pLZ) and (pST > pLZ) and (pST > pPZ))then begin
                  s1 := Copy(s, 1, pST);
                  Break;
                end;
              end;
            until (j >= Length(s));
            //
            if (s1 <> '') then begin               //jestlize funkce/procedura ma parametry, tak pokracujeme
              d := Length(s1);
              repeat                               //hledame a mazeme "const "
                n := FindWordPos(cConst, s1);
                if (n > 0) then
                  Delete(s1, n, Length(cConst)+1);
              until (n = 0);
              //
              repeat                               //hledame a nahrazujeme "out" za "var"
                n := FindWordPos(cOut, s1, False, n+1);
                if (n > 0) then begin
                  Delete(s1, n, Length(cOut));
                  Insert(cVar, s1, n);
                end;
              until (n = 0);
              //
              s1 := Replace(cObeZav, s1, '');      //nahrazujeme zavorky: ()
              //
              Delete(scr, i, d);
              Insert(s1, scr, i);
            end;
          end;
        end;
      end;
    until (i >= Length(scr));
  end;

  //presune globalni konstanty (const) a promenne (var), ktere jsou mezi funkcemi a procedurami, na zacatek skriptu
  procedure MoveConstVar2Top;
  var
    i, c: Integer;
    topLineNo, firstFncLineNo, incStartPos: integer;  //prvni vyskyt konstanty nebo promenne, prvni vyskyt proc/fnc, pozice prvniho include
    constVarStr: string;
    sl, sl1: TStringList;
    dltd, inApo, wasFncOrProc: Boolean;
    ch: Char;
  begin
    constVarStr := '';
    topLineNo := 0;
    firstFncLineNo := 0;
    dltd := False;
    inApo := False;
    i := 0;
    ch := #0;
    wasFncOrProc := False;
    incStartPos := Pos(cIncStart, scr);
    //prochazime cely skript znak po znaku
    repeat
      if not dltd then
        Inc(i);
      dltd := False;
      //
      //sdilene skripty nezpracovavame
      if not IsInclude(scr, i) then begin
        if (scr[i] = cApostrof) then
          inApo := not inApo;
        //if scr[i] = '/' then  //pro testovani
        //if i = 573 then  //pro testovani
          //c := 0;
        //komentare nezpracovavame
        if (not IsComment(scr, i, inApo, ch)) then begin
          //procedurey nezpracovavame
          if not IsFncOrProcPos(scr, i, firstFncLineNo) then begin
            //zapamatujeme si pozici prvniho vyskytu konstanty nebo promenne
            //(prvni znak, ktery neni komentar ani proc/fnc)
            //na tuto pozici budeme presouvat konstanty a promenne, ktere jsou mezi proc/fnc
            if (topLineNo = 0) and (Ord(scr[i]) > 32) then
              topLineNo := i;
            //vkladame vsechny znaky, krome odradkovani
            constVarStr := constVarStr + scr[i];
            if not wasFncOrProc then
              ch := scr[i];
            if (Ord(scr[i]) > 32) then begin
              Delete(scr, i, 1);
              dltd := True;
              wasFncOrProc := False;
            end;
          end
          else begin
            ch := #0;
            wasFncOrProc := True;
          end;
        end
        else
          ch := #0;
      end;
    until (i >= Length(scr));
    //vlozime konstanty a promenne na zacatek skriptu a odstranime prebytecne prazdne radky
    if Trim(constVarStr) <> '' then begin
      topLineNo := Min(topLineNo, firstFncLineNo);
      if incStartPos > 0 then
        topLineNo := Min(topLineNo, incStartPos);
      Insert(constVarStr, scr, topLineNo);
      //odstraneni prazdnych radku
      sl := TStringList.Create;
      sl1 := TStringList.Create;
      try
        sl.Text := scr;
        c := 0;
        //pokud je vice prazdnych radku za sebou, tak zustane jen 1
        for i := 0 to sl.Count - 1 do begin
          if Trim(sl[i]) <> '' then begin
            sl1.Add(sl[i]);
            c := 0;
          end
          else begin
            Inc(c);
            if c = 1 then
              sl1.Add('');
          end;
        end;
        //odstraneni prazdneho radku na zacatku
        for i := 0 to sl1.Count - 1 do
          if sl1[i] = '' then
            sl1.Delete(i)
          else
            Break;
        //
        scr := sl1.Text;
      finally
        sl.Free;
        sl1.Free;
      end;
    end;
  end;

  function AddCharRight(AStr, AChar: string): string;
  begin
    AStr := Trim(AStr);
    if Copy(AStr, Length(AStr), 1) = AChar then
      Result := AStr
    else
      Result := AStr + AChar;
  end;

function TrimCSVList(const AStringListText: string): string;
var
  sl, sl1: TStringList;
  i: integer;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    sl.CommaText := AStringListText;
    for i := 0 to sl.Count - 1 do
      if sl[i] <> '' then
        sl1.Add(sl[i]);
    Result := sl1.CommaText;
  finally
    sl.Free;
    sl1.Free;
  end;
end;

  procedure InitFncVar;
  var
    s, s1, s2, s3, zn: string;
    i, j, p, d, pBeg, l, k: Integer;
    inZav, inApo, inVar: boolean;
    varStr: string;
    sl1, sl2: TStringList;
  begin
    varStr := '';
    inApo:=False;
    i := 0;
    //prochazime cely skript znak po znaku
    repeat
      Inc(i);
      //sdilene skripty nezpracovavame
      if not IsInclude(scr, i) then begin
        if (scr[i] = cApostrof) then
          inApo := not inApo;
        //komentare nezpracovavame
        if (not IsComment(scr, i, inApo)) then begin
          //if i = 261 then  //pro testovani
            //d:=0;
          //u kazdeho znaku testujeme, zda zacina procedura nebo funkce
          if (SameText(Copy(scr, i, Length(cProc)), cProc) or SameText(Copy(scr, i, Length(cFnc)), cFnc)) and
             IsFncOrProc(scr, i, l) then begin   //IsFncOrProcPos zde nelze pouzit, protoze by nahrazeni nefungovalo v podprocedurach
            s1 := '';
            varStr := '';
            pBeg:=0;
            inZav:=False; inApo:=False; inVar:=False;
            s := Copy(scr, i, MaxInt);           //do "s" ulozime skript od zacatku funkce/procedury
            j := 1;
            repeat                               //prochazime skript od zacatku funkce/procedury
              Inc(j);
              //
              if (not IsComment(s, j)) then begin
                //procedurey nezpracovavame
                if not IsFncOrProcPos(s, j, l) then begin
                  zn := s[j];
                  if (zn = cApostrof) then           //pokud narazime na apostrof,
                    inApo := not inApo;              //tak si zapamatujeme (resp. se jedna o konec textu v apostrofu)
                  if not inApo then begin            //pokud se nejedna o text v apostrofu, tak pokracujeme
                    if (zn = cLevaZav) then          //pokud narazime na levou zavorku,
                      inZav := True;                 //a nastavime priznak "jsme v zavorce"
                    if inZav then                    //pokud jsme v zavorce,
                      if (zn = cPravaZav) then       //tak pokud narazime na pravou zavorku,
                        inZav := False;              //a nastavime priznak "nejsme v zavorce"
                    if not inZav then begin          //pokud v zavorce nejsme,
                      s1 := Copy(s, j, MaxInt);
                      if FindWordPos(cVar, s1) = 1 then begin
                        inVar := True;
                        //
                        j := j+Length(cVar);
                        zn := s[j];
                      end;
                      if inVar then
                        if FindWordPos(cConst, s1) = 1 then
                          inVar := False;
                      if FindWordPos(cBegin, s1) = 1 then begin
                        pBeg := j;
                        Break;
                      end;
                      if inVar then begin
                        varStr := varStr + zn;
                        if zn = ';' then
                          varStr := varStr + cCRLF;
                      end;
                    end;
                  end;
                end;
              end;
            until (j >= Length(s));
            //
            varStr := Trim(varStr);
            if (varStr <> '') then begin
              sl1 := TStringList.Create;
              sl2 := TStringList.Create;
              try
                s2 := '';
                sl1.Text := varStr;
                for k := 0 to sl1.Count - 1 do begin
                  s1 := Trim(sl1[k]);
                  if s1 <> '' then begin
                    if (Pos(':', s1) > 0) and (Pos(':', s1) < Length(s1)) then
                      s1 := AddCharRight(s1, ';');
                    //
                    if (Pos(':', s1) > 0) or (Pos(';', s1) > 0) then begin
                      s2 := s2 + s1;
                    end
                    else
                      s2 := s2 + AddCharRight(s1, ',');
                    //
                    if (Pos(':', s2) > 0) and (Pos(':', s2) < Length(s2)) then
                      s2 := AddCharRight(StrTrimCharRight(s2, ','), ';');
                    //
                    if (Pos(';', s2) > 0) or (k = sl1.Count - 1) then begin
                      if (Pos(':', s2) > 0) then
                        s2 := TrimCSVList(Replace(' ', Copy(s2, 1, Pos(':', s2)-1), ',')) + Copy(s2, Pos(':', s2), MaxInt)
                      else
                        s2 := TrimCSVList(Replace(' ', s2, ','));
                      sl2.Add(AddCharRight(s2, ';'));
                      s2 := '';
                    end;
                  end;
                end;
                //
                sl1.Text := sl2.Text;
                sl2.Clear;
                varStr := '';
                for k := 0 to sl1.Count - 1 do begin
                  s1 := Trim(sl1[k]);
                  p := Pos(':', s1);
                  if (p > 0) then begin
                    s2 := Copy(s1, 1, p-1);
                    if Pos(';', s1) > 0 then
                      s3 := Trim(Copy(s1, p+1, Pos(';', s1)-(p+1)))
                    else
                      s3 := Trim(Copy(s1, p+1, MaxInt));
                    //
                    if SameText(s3, cStrVar) then
                      sl2.Add('  '+Replace(',', s2, cStrInit)+cStrInit)
                    else if SameText(s3, cIntVar) then
                      sl2.Add('  '+Replace(',', s2, cIntInit)+cIntInit)
                    else if SameText(s3, cDoubleVar) then
                      sl2.Add('  '+Replace(',', s2, cDoubleInit)+cDoubleInit)
                    else if SameText(s3, cBoolVar) then
                      sl2.Add('  '+Replace(',', s2, cBoolInit)+cBoolInit)
                    else if SameText(s3, cCurrVar) then
                      sl2.Add('  '+Replace(',', s2, cCurrInit)+cCurrInit)
                    else if SameText(s3, cDateTimeVar) then
                      sl2.Add('  '+Replace(',', s2, cDateTimeInit)+cDateTimeInit)
                    else if SameText(s3, cDateVar) then
                      sl2.Add('  '+Replace(',', s2, cDateInit)+cDateInit)
                    else if SameText(s3, cWordVar) then
                      sl2.Add('  '+Replace(',', s2, cWordInit)+cWordInit);
                  end;
                end;
                //
                if sl2.Count > 0 then begin
                  sl2.Insert(0, '  '+cInitBeginText);
                  sl2.Insert(0, cBegin);
                  sl2.Add('  '+cInitEndText);
                  //
                  varStr := sl2.Text;
                end;
              finally
                sl1.Free;
                sl2.Free;
              end;
            end;
            //
            if (varStr <> '') and (pBeg > 0) then begin
              Delete(s, pBeg, Length(cBegin));
              Insert(Trim(varStr), s, pBeg);
              Delete(scr, i, Length(s));
              Insert(s, scr, i);
            end;
          end;
        end;
      end;
    until (i >= Length(scr));
  end;

begin
  StartWait;
  try
    scr := AScript;
    if scr <> '' then begin
      //--- RESOURCESTRINGY ---
      scr := Replace(cRes, scr, cConst, true);
      //--- INCLUDE SKRIPTY ---
      loadScr := False;
      //pokud skript obsahuje sdileny skript IncEPOPrilN, tak vymenime direktivu za IncEPOPrilTMS
      if (Pos(cIncEPOPrilStartN,scr) > 0) and (Pos(cIncEPOPrilStopN,scr) > 0) then begin
        Insert(cIncEPOConst, scr, Pos(cIncEPOPrilStartN,scr));
        scr := Replace(cIncEPOPrilStartN, scr, cIncEPOPrilStartTMS);
        scr := Replace(cIncEPOPrilStopN, scr, cIncEPOPrilStopTMS);
        //
        VlozIncConst(cDefRozvahaNev, cDefRozvahaNevText);
        VlozIncConst(cDefRozvahaRO, cDefRozvahaROText);
        VlozIncConst(cDefVZZNev, cDefVZZNevText);
        VlozIncConst(cDefVZZRO, cDefVZZROText);
        //
        UpravVolaniIncFncRozsahUZ(cFncGetRozsahUVRoz);
        UpravVolaniIncFncRozsahUZ(cFncGetRozsahUVVzz);
        //
        loadScr := True;
      end;
      //pokud skript obsahuje sdileny skript IncEPOPril, tak vymenime direktivu za IncEPOPril1TMS
      if (Pos(cIncEPOPrilStart,scr) > 0) and (Pos(cIncEPOPrilStop,scr) > 0) then begin
        scr := Replace(cIncEPOPrilStart, scr, cIncEPOPrilStart1TMS);
        scr := Replace(cIncEPOPrilStop, scr, cIncEPOPrilStop1TMS);
        //
        loadScr := True;
      end;
      //pokud skript obsahuje sdileny skript IncSpolFunkce, tak vymenime direktivu za IncSpolFunkceTMS
      //a upravime parametry ve volani funkci a IncSpolFce_OnChangeKodStatuSetStat a IncSpolFce_OnChangeStatSetKodStatu
      if (Pos(cIncSpolFunkceStart,scr) > 0) and (Pos(cIncSpolFunkceStop,scr) > 0) then begin
        scr := Replace(cIncSpolFunkceStart, scr, cIncSpolFunkceStartTMS);
        scr := Replace(cIncSpolFunkceStop, scr, cIncSpolFunkceStopTMS);
        loadScr := True;
        //
        UpravVolaniIncFncStat(cFncOnChangeKodStatu);
        UpravVolaniIncFncStat(cFncOnChangeStat);
      end;
      //pokud skript obsahuje sdileny skript IncFDFPrint, tak vymenime direktivu za IncFDFPrintTMS
      if (Pos(cIncFDFPrintStart,scr) > 0) and (Pos(cIncFDFPrintStop,scr) > 0) then begin
        scr := Replace(cIncFDFPrintStart, scr, cIncFDFPrintStartTMS);
        scr := Replace(cIncFDFPrintStop, scr, cIncFDFPrintStopTMS);
        //
        loadScr := True;
      end;
      //vlastni vymena include skriptu
      {$IFNDEF FINALBUILD}
      if loadScr then
        GfaMain.LoadIncludeScripts(True, scr); //scr je vyplneny, tzn. nebude se zvedat verze
      {$ENDIF FINALBUILD}

      //--- NAHRAZENI Const a Out v parametrech funkci
      {$ifdef profiler}GfaMain.timelog('--- start ReplaceFncParam'); {$endif profiler}
      ReplaceFncParam;
      {$ifdef profiler}GfaMain.timelog('--- stop ReplaceFncParam'); {$endif profiler}
      //--- PRESUNUTI Const a Var na zacatek skriptu
      {$ifdef profiler}GfaMain.timelog('--- start MoveConstVar2Top'); {$endif profiler}
      MoveConstVar2Top;
      {$ifdef profiler}GfaMain.timelog('--- stop MoveConstVar2Top'); {$endif profiler}
      //--- INICIALIZACE LOKALNICH PROMENNYCH
      {$ifdef profiler}GfaMain.timelog('--- start ReplaceFncParam'); {$endif profiler}
      if Pos(cInitBeginText, scr) = 0 then
        InitFncVar;
    end;
    //
    Result := scr;
  finally
    StopWait;
  end;
end;

