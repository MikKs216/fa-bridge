procedure TfmScriptEditor.SaveFormStateToIni;
var
  iniFile: TMemIniFile;
begin
  //if not GfaMain.CanWriteToIniFile then EXIT;
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    iniFile.WriteInteger(Name, 'Left', Left);
    iniFile.WriteInteger(Name, 'Top', Top);
    iniFile.WriteInteger(Name, 'Width', Width);
    iniFile.WriteInteger(Name, 'Height', Height);
    iniFile.WriteBool(Name, 'DisableFolding', meScript.DisableFolding);
    iniFile.WriteInteger(Name, 'ScrCodeListWidth', ScrCodeList1.Width);
    iniFile.WriteBool(Name, 'miShowCodeLists', miShowCodeLists.Checked);
    iniFile.WriteString(Name, 'CodeBlocks', CodeBlocksToIniStr);
    SaveMemIni(iniFile);
  finally
    iniFile.Free;
  end;
end;{SaveStateFormToIni}

procedure TfmScriptEditor.LoadFormStateFromIni;
var
  iniFile: TMemIniFile;
begin
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    Left := iniFile.ReadInteger(Name, 'Left', 307);
    Top := iniFile.ReadInteger(Name, 'Top', 192);
    Width := iniFile.ReadInteger(Name, 'Width', 686);
    Height := iniFile.ReadInteger(Name, 'Height', 375);
    meScript.DisableFolding := iniFile.ReadBool(Name, 'DisableFolding', False);
    ScrCodeList1.Width := iniFile.ReadInteger(Name, 'ScrCodeListWidth', 200);
    LoadCodeBlocksFromIniStr(iniFile.ReadString(Name, 'CodeBlocks', ''));
    miShowCodeLists.Checked := iniFile.ReadBool(Name, 'miShowCodeLists', TRUE);
    ShowCodeLists(miShowCodeLists.Checked);
  finally
    iniFile.Free;
  end;
end; {LoadStateFormIni}

