end;

//OnKeyDown na udaji pro zadani kl. zkratky  v dialogu pro zadani klavesove zkratky a nazvu noveho makra
procedure TfmAskStrShortCut.ShortCutKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
var
  sc: TShortCut;
begin
  if (Shift = [ssAlt]) then
    // Process the ALT-A keypress
    IgnoreOneMenuChar := true; // Kill the Beep.
  //
  if Key <= 46 then begin
    (Sender as TEdit).Text := '';
    if (ssShift in Shift) then
      (Sender as TEdit).Text := 'Shift+';
    if (ssCtrl in Shift) then
      (Sender as TEdit).Text := (Sender as TEdit).Text + 'Ctrl+';
    if (ssAlt in Shift) then
      (Sender as TEdit).Text := (Sender as TEdit).Text + 'Alt+';
    if SameText((Sender as TEdit).Text, 'Shift+') then
      (Sender as TEdit).Text := '';
  end
  else begin
    sc := ShortCut(Key, Shift);
    (Sender as TEdit).Text := ShortCutToText(sc);
  end;
  (Sender as TEdit).SelStart := Length((Sender as TEdit).Text);
end;

//zamezi napsani nesmyslu, protoze kdyz se napr. znackne jen klavesa "A", tak se v udaji objevi "aA"
procedure TfmAskStrShortCut.ShortCutKeyPress(Sender: TObject; var Key: Char);
begin
  Key := #0;
end;

//zajisti, aby se kl. zkratka smazala, pokud neni uplna, tzn. zmacku jen Alt a pustim, tak aby se "Alt+" smazalo
procedure TfmAskStrShortCut.ShortCutKeyUp(Sender: TObject; var Key: Word; Shift: TShiftState);
var
  sc: TShortCut;
begin
  sc := TextToShortCut((Sender as TEdit).Text);
  ShortCutToKey(sc, Key, Shift);
  if Key <= 32 then
    (Sender as TEdit).Text := '';
end;

//dialog pro zadani klavesove zkratky a nazvu noveho makra
function TfmScriptEditor.AskStrShortCut(var AValue1: string; var AValue2: string; var AFocus2NdEdit: boolean): TModalResult;
var
  frm: TfmAskStrShortCut;
  btnOk, btnCancel: TButton;
  lbOd, lbDo: TLabel;
  edNazev, edKlavesa: TEdit;
begin
  Result := mrCancel;
  frm := TfmAskStrShortCut.CreateNew(Self);
  try
    btnOk := TButton.Create(frm);
    btnCancel := TButton.Create(frm);
    lbOd := TLabel.Create(frm);
    lbDo := TLabel.Create(frm);
    edNazev := TEdit.Create(frm);
    edKlavesa := TEdit.Create(frm);

    frm.BorderStyle := bsDialog;
    frm.Caption := 'Spustit zaznamenávání makra';
    frm.Position := poOwnerFormCenter;
    frm.KeyPreview := True;
    frm.OnKeyDown := frm.FormKeyDown;

    lbOd.Parent := frm;
    lbOd.Caption := 'Název';
    lbOd.Top := 12;
    lbOd.Left := 12;

    edNazev.Parent := frm;
    edNazev.Text := AValue1;
    edNazev.Top := 8;
    edNazev.Left := lbOd.Left+lbOd.Width+13;
    edNazev.Width := 230;

    edKlavesa.Parent := frm;
    edKlavesa.Text := AValue2;
    edKlavesa.Top := edNazev.Top+edNazev.Height+4;;
    edKlavesa.Left := edNazev.Left;
    edKlavesa.Width := 120;
    edKlavesa.OnKeyDown := frm.ShortCutKeyDown;
    edKlavesa.OnKeyPress := frm.ShortCutKeyPress;
    edKlavesa.OnKeyUp := frm.ShortCutKeyUp;

    lbDo.Parent := frm;
    lbDo.Caption := 'Klávesa';
    lbDo.Top := edKlavesa.Top+4;
    lbDo.Left := lbOd.Left;

//    btnCancel.Parent := frm;
    btnCancel.Caption := 'Storno';
    btnCancel.Default := false;
    btnCancel.ModalResult := mrCancel;
    btnCancel.Top := edKlavesa.Top + edKlavesa.Height + 12;
    btnCancel.Left := edKlavesa.Left + edNazev.Width - btnCancel.Width;

    btnOk.Parent := frm;
    btnOk.Caption := 'OK';
    btnOk.Default := true;
    btnOk.ModalResult := mrOk;
    btnOk.Top := btnCancel.Top;
    btnOk.Left := btnCancel.Left - btnOk.Width - 4;

    btnCancel.Parent := frm; //musi byt az za btnOk, kvuli TabOrder

    frm.Width := edKlavesa.Left+edNazev.Width+16;
    frm.Height := btnCancel.Top+btnCancel.Height+38;

    if AFocus2NdEdit then begin
      frm.ActiveControl := edKlavesa;
    end;

    Result := frm.ShowModal;
    AValue1 := edNazev.Text;
    AValue2 := edKlavesa.Text;
  finally
    frm.Free;
  end;
end;

