end;

procedure TfmScriptEditor.meScriptTextChanged(Sender: TObject; Pos, Count,
  LineChange: Integer);
var
  iLine: Integer;

  procedure UpdateLines(var A: TStringList);
  var
    i: Integer;
  begin
    for i := A.Count - 1 downto 0 do
      if StrToInt(A[i]) > iLine then begin
        if (LineChange < 0) and (StrToInt(A[i]) <= iLine - LineChange) then
          A.Delete(i)
        else
          A[i] := IntToStr(StrToInt(A[i]) + LineChange);
      end;
  end;

begin
  if not IsDebugMode then
    Exit;
  //
  if LineChange <> 0 then begin
    iLine := ActiveScript.StrPosToCaretPos(Pos).Y;
    UpdateLines(FBreakPoints);
    UpdateLines(FSynMemoExecLines);
  end;
  //
  SaveBreaksPt;
end;

