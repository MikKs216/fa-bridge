//prochazi vsechny klavesove zkratky pouzite v systemu a vraci true, pokud pozadovana zkratka je registrovana
function TfmScriptEditor.IsShortCutUsedInSystem(ASC: TShortCut): Boolean;
var
  i, j: Integer;
begin
  Result := False;
  //klavesove zkratky v SyntKeyMapping1
  for i := 0 to SyntKeyMapping1.Items.Count - 1 do
    for j := 0 to SyntKeyMapping1.Items[i].KeyStrokes.Count - 1 do
      if TextToShortCut(SyntKeyMapping1.Items[i].KeyStrokes.Items[j].AsString) = ASC then begin
        Result := True;
        Break;
      end;
  //klavesove zkratky v PopupMenu1
  if not Result then
    for i := 0 to PopupMenu1.Items.Count - 1 do
      if PopupMenu1.Items[i].ShortCut = ASC then begin
        Result := True;
        Break;
      end;
  //klavesove zkratky v PopupMenu2
  if not Result then
    for i := 0 to PopupMenu2.Items.Count - 1 do
      if PopupMenu2.Items[i].ShortCut = ASC then begin
        Result := True;
        Break;
      end;
end;

//prochazi klavesove zkratky maker a vraci true, pokud pozadovana zkratka je registrovana
function TfmScriptEditor.IsShortCutUsedInMacros(ASC: TShortCut): Boolean;
var
  i: Integer;
  sl: TStringList;
begin
  Result := False;
  sl := TStringList.Create;
  try
    //klavesove zkratky maker
    for i := 0 to FMacroList.Count - 1 do begin
      sl.CommaText := FMacroList[i];
      if TextToShortCut(sl[1]) = ASC then begin
        Result := True;
        Break;
      end;
    end;
  finally
    sl.Free;
  end;
end;

//pokud je ecMacroRecorder1 v rezimu nahravani makra, tak nahravani zastavi,
//jinak zobrazi dialog pro zadani nazvu a klavesove zkratky nahravaneho makra
procedure TfmScriptEditor.miMacroRecOrStopClick(Sender: TObject);
var
  str1, str2, str2tmp: string;
  stisk: word;
  foc2NdFld, replaceSC: boolean;
begin
  if ecMacroRecorder1.Recording then begin
    ecMacroRecorder1.Stop;
    MacroSetName(FMacroName, FMacroShortCut, ecMacroRecorder1.Count-1);
  end
  else begin
    MacroShortCutUnRegister; //musime odregistrovat, jinak v dialogu pro zadani klavesove zkratky nahravaneho makra nelze pouzit zkratku, pro kterou je jiz makro registrovano
    //dialog s dotazem na nazev makra a kl. zkratku
    str1:='';
    str2:='';
    str2tmp:='';
    foc2NdFld:=False;
    repeat
      replaceSC := False;
      stisk:=AskStrShortCut(str1, str2, foc2NdFld);
      if stisk = mrOk then begin
        str2tmp:=str2;
        if str2='' then
          MsgBoxErr(Caption, 'Zadejte klávesovou zkratku.', MB_OK)
        else if IsShortCutUsedInSystem(TextToShortCut(str2)) then begin
          str2tmp:='';
          MsgBoxErr(Caption, 'Tuto klávesu již používá editor.', MB_OK);
        end
        else if IsShortCutUsedInMacros(TextToShortCut(str2)) then begin
          if MsgBoxWarn(Caption, 'Makro s touto klávesou je již definováno. Chcete jej pøepsat?', MB_OKCANCEL) = mrCancel then
            str2tmp:=''
          else
            replaceSC := True;
        end;
        //
        foc2NdFld:=True;
      end;
    until (str2tmp <> '') or (stisk=mrCancel);
    if stisk<>mrCancel then begin
      if replaceSC then
        MacroDeleteMacroByShortCut(str2);      
      FMacroName := str1;
      FMacroShortCut := str2;
      ecMacroRecorder1.Start;
    end
    else
      MacroShortCutRegister;
  end;
end;

