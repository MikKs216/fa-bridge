procedure TfmShowDebugExpression.FormKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
begin
  if Key = 27 then
    (Sender as TForm).Close;
end;

function EvalWatch(AExpression: string): TScriptValue;
var
  v: variant;
  dw: TatDebugWatch;

const
  cEmptyString = '''''';
begin
  AExpression := Trim(AExpression);
  if (AExpression = '') then begin
    Result := cEmptyString;
    Exit;
  end;
  //
  dw := GfaMain.ScripterT.CurrentScript.VirtualMachine.DebugWatches.Add;
  dw.Expression := AExpression;
  dw.Enabled := true;
  GfaMain.ScripterT.CurrentScript.VirtualMachine.DebugWatches.CompileAndEvaluate(dw);
  if dw.WatchStatus = wsEvaluated then begin
    try
      Result := VarToStr(dw.LastResult);
      if (Result = '') then
        Result := cEmptyString;
    except
      Result := VarTypeAsText(VarType(dw.LastResult));
    end;
  end
  else if dw.WatchStatus = wsCompileError then
    Result := Format('%s: (compile error on expression)',[AExpression])
  else if dw.WatchStatus = wsRuntimeError then
    Result := Format('%s: (runtime error on expression)',[AExpression])
  else
    Result := 'null';
end;

//OnKeyDown na udaji pro zadani kl. zkratky  v dialogu pro zadani klavesove zkratky a nazvu noveho makra
procedure TfmShowDebugExpression.ExpressionKeyDown(Sender: TObject; var Key: Word; Shift: TShiftState);
var
  sc: TShortCut;
  i: integer;
begin
  if (Key = VK_RETURN) then begin
    for i := 0 to self.ComponentCount - 1 do
      if Self.Components[i] is TMemo then
        TMemo(Self.Components[i]).Lines.Text := EvalWatch((Sender as TEdit).Text);
    //
    (Sender as TEdit).SelStart := 0;
    (Sender as TEdit).SelLength := Length((Sender as TEdit).Text);
  end;
end;

