procedure TfmScriptEditor.UpdateEditors(const ATwoEditors: boolean);
var
  scrIsChanged: boolean;
begin
  if ATwoEditors then begin
    meScript.Align := alTop;
    meScript.Height := Round(meScript.Height/2);
    Splitter1.Visible := True;
    scrIsChanged := FIsChanged;
    try
      meScript2.Lines.Text := meScript.Lines.Text;
      meScript2.Visible := True;
    finally
      FIsChanged := scrIsChanged;
    end;
    //
    meScript2.DisableFolding := meScript.DisableFolding;
  end
  else begin
    Splitter1.Visible := False;
    meScript2.Visible := False;
    meScript.Align := alClient;
    SetActiveScript(meScript);
  end;
