//zajisti zobrazeni tecek v gutter, kde lze pridat breakpoint
procedure TfmScriptEditor.DisplayLineAttr(inst:pSimplifiedCode);
var line,x:integer;
begin
  { extract source line from instruction debuginfo }
  line := LineNumberFromInstruction(inst);

  if Assigned(inst) and (line>-1) and (line<ActiveScript.Lines.Count) then begin
    { generated executable code }
    if InstructionIsExecutable(GfaMain.ScripterT,inst) then begin
      //if FSynMemoExecLines.IndexOf(IntToStr(Line)) = -1 then
      if not FSynMemoExecLines.Find(IntToStr(Line), x) then
        FSynMemoExecLines.Add(IntToStr(line));
    end;
  end;
end;

