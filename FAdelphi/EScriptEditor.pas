function TfmScriptEditor.TranslateScrFromCompileToNormal(AScr: string): string;
var
  i, p: Integer;
  scr, scrResult, s, fldName: string;

const
  cLeftFldBracket = '[.';
  cRightFldBracket = '.]';
  cLeftFldBracketAsString = '[:';
  cRightFldBracketAsString = ':]';
  cLeftFldBracketNumber = '[*';
  cRightFldBracketNumber = '*]';
  cLeftFldBracketNumberStr = '[=';
  cRightFldBracketNumberStr = '=]';

  cLeftPartOfField = ' GetMTVField(''';
  cRightPartOfField = ''').Value ';
  cRightPartOfFieldAsString = ''').AsString ';

  cLeftPartOfFieldNumber = ' GetMTVFieldValue(''';
  cRightPartOfFieldNumber = ''',''*]'') ';
  cRightPartOfFieldNumberStr = ''',''=]'') ';

  cIni = 'if (GScriptState = ssInit) or (GScriptState = ssDefault) and (UpperCase(GScriptFieldName)=UpperCase(';
  cIno = 'if GScriptState = ssInit then ';
  cDef = 'if (GScriptState = ssDefault) and (UpperCase(GScriptFieldName)=UpperCase(';
begin
  if (AScr='') then
    Exit;
  //  
  scr := AScr;
  scrResult := '';
  i := 0;
  //prochazime cely skript znak po znaku
  repeat
    Inc(i);
    //GetMTVField('').AsString - > [::]
    //GetMTVField('').Value - > [..]    
    if Copy(scr, i, Length(cLeftPartOfField)) = cLeftPartOfField then begin
      s := Copy(scr, i+Length(cLeftPartOfField), MaxInt);
      i := i + Length(cLeftPartOfField);
      p := Pos('''', s);
      fldName := Copy(s, 1, p-1);
      s := Copy(s, p, MaxInt);
      i := i + Length(fldName)-1;
      //[::]
      if Copy(s, 1, Length(cRightPartOfFieldAsString)) = cRightPartOfFieldAsString then begin
        scrResult := scrResult + cLeftFldBracketAsString + fldName + cRightFldBracketAsString;
        i := i + Length(cRightPartOfFieldAsString);
      end
      //[..]
      else if Copy(s, 1, Length(cRightPartOfField)) = cRightPartOfField then begin
        scrResult := scrResult + cLeftFldBracket + fldName + cRightFldBracket;
        i := i + Length(cRightPartOfField);
      end;
    end
    //GetMTVFieldValue('', '=]') - > [==]
    //GetMTVFieldValue('', '*]') - > [**]
    else if Copy(scr, i, Length(cLeftPartOfFieldNumber)) = cLeftPartOfFieldNumber then begin
      s := Copy(scr, i+Length(cLeftPartOfFieldNumber), MaxInt);
      i := i + Length(cLeftPartOfFieldNumber);
      p := Pos('''', s);
      fldName := Copy(s, 1, p-1);
      s := Copy(s, p, MaxInt);
      i := i + Length(fldName)-1;
      //[==]
      if Copy(s, 1, Length(cRightPartOfFieldNumberStr)) = cRightPartOfFieldNumberStr then begin
        scrResult := scrResult + cLeftFldBracketNumberStr + fldName + cRightFldBracketNumberStr;
        i := i + Length(cRightPartOfFieldNumberStr);
      end
      //[**]
      else if Copy(s, 1, Length(cRightPartOfFieldNumber)) = cRightPartOfFieldNumber then begin
        scrResult := scrResult + cLeftFldBracketNumber + fldName + cRightFldBracketNumber;
        i := i + Length(cRightPartOfFieldNumber);
      end;
    end
    //ini
    else if Copy(scr, i, Length(cIni)) = cIni then begin
      s := Copy(scr, i+Length(cIni), MaxInt);
      i := i + Length(cIni);
      p := Pos('ini(', AnsiLowerCase(s));
      i := i + p - 1; //1 odecitame, protoze "p" je pozice "ini(" (ale my vlastne potrebujeme delku mezi "i" a "ini("
      scrResult := scrResult + scr[i];
    end
    //ino
    else if Copy(scr, i, Length(cIno)) = cIno then begin
      s := Copy(scr, i+Length(cIno), MaxInt);
      i := i + Length(cIno);
      p := Pos('ino(', AnsiLowerCase(s));
      i := i + p - 1; //1 odecitame, protoze "p" je pozice "ino(" (ale my vlastne potrebujeme delku mezi "i" a "ino("
      scrResult := scrResult + scr[i];
    end
    //def
    else if Copy(scr, i, Length(cDef)) = cDef then begin
      s := Copy(scr, i+Length(cDef), MaxInt);
      i := i + Length(cDef);
      p := Pos('def(', AnsiLowerCase(s));
      i := i + p - 1; //1 odecitame, protoze "p" je pozice "def(" (ale my vlastne potrebujeme delku mezi "i" a "def("
      scrResult := scrResult + scr[i];
    end
    else
      scrResult := scrResult + scr[i];
  until (i >= Length(scr));
  Result := scrResult;
end;

//Prevede skript z normalniho (jak zapisujeme do mema) do kompilovaneho (jak je ulozen v GfaMain.ScripterT) a zpet
//pracujeme s meScript a ne s ActiveScript, protoze druhy skript nemuze byt pri debugovani nikdy visible (IsSecondScriptVisible je vzdy FALSE)
function TfmScriptEditor.ChangeScriptCompiling(ACompiled: boolean; AAssignToMemo: Boolean = TRUE): string;
var
  scr: string;
  tl: Integer;
  isChanged: Boolean;
begin
  tl := meScript.TopLine;
  isChanged := FIsChanged;
  meScript.BeginUpdate;
  StartWait;
  try
    scr := meScript.Text;
    if ACompiled then begin
//      SaveStringToFile(scr, 'd:\scrToCompilePred.txt');
      //i kdyz menime na compiled, tak napred transformujeme do normalu
      // (protoze kdyz uz je skript compilovany, tak dochazi pri TranslateIniProcs ke zdvojeni podminek)
      scr := TranslateScrFromCompileToNormal(scr);
      scr := GfaMain.TranslateFieldNames(scr);
      scr := GfaMain.TranslateIniProcs(scr);
//      SaveStringToFile(scr, 'd:\scrCompilePo.txt');
    end
    else begin
//      SaveStringToFile(scr, 'd:\scrToNormalPred.txt');
      scr := TranslateScrFromCompileToNormal(scr);
//      SaveStringToFile(scr, 'd:\scrNormalPo.txt');
    end;
    Result := scr;
    if AAssignToMemo then
      meScript.Text := scr;
  finally
    meScript.TopLine := tl;
    StopWait;
    meScript.EndUpdate;
    FIsChanged := isChanged;
  end;
end;

procedure TfmScriptEditor.ckShowScriptCompiledClick(Sender: TObject);
begin
  if FIsChanged then
    SaveScript(False)
  else
    ChangeScriptCompiling(ckShowScriptCompiled.Checked);
  //
  ActiveScript.SetFocus;
end;

