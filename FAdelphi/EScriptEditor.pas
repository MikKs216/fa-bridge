//zobrazi sipku u aktualniho radku pri debagovani
procedure TfmScriptEditor.ShowExecutionPoint;
var curline : integer;
begin
  curline := LineNumberFromInstruction(GfaMain.ScripterT.NextInstruction );
  //
  // Show line of current execution point (if it is collapsed)
  if curline<>FCurrentLine then begin
    FCurrentLine := curline;
    ActiveScript.ShowLine(FCurrentLine);
    if FCurrentLine > -1 then
      ActiveScript.CaretPos := Point(0, FCurrentLine);
    ActiveScript.Invalidate;

    if fmWatchViewer.Visible then
      fmWatchViewer.Refresh;
  end;

  if FUpdateWatches then begin
    if fmWatchViewer.Visible then
      fmWatchViewer.Refresh;
    FUpdateWatches := false;
  end;
end;

function TfmScriptEditor.IsBreakPt(Line: integer): boolean;
begin
  Result := False;
  if (IsDebugMode) and (FBreakPoints <> nil) then
    Result := FBreakPoints.IndexOf(IntToStr(Line)) <> -1;
end;

