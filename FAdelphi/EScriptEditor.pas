function TfmScriptEditor.CodeBlockToStr(ACodeBlock: TCodeBlock): string;
var
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    sl.Add(ACodeBlock.Caption);
    sl.Add(IntToStr(ACodeBlock.Tag));
    sl.Add(Replace(cCRLF,ACodeBlock.Code.Text, cCRLFAlternate));
    Result := sl.CommaText;
  finally
    sl.Free;
  end;
end;

function TfmScriptEditor.CodeBlocksToIniStr: string;
var
  i: integer;
  str: string;
begin
  str := '';
  for i := 0 to ScrCodeList1.CodeBlocks.Count - 1 do
    AddStrLine(str, CodeBlockToStr(ScrCodeList1.CodeBlocks.Items[i]));
  //
  Result := Replace(cCRLF, str, '#13#10');
end;

procedure TfmScriptEditor.AddCodeBlockFromStr(ACodeBlockStr: string);
var
  sl: TStringList;
  codeBlock: TCodeBlock;
begin
  sl := TStringList.Create;
  try
    sl.CommaText := ACodeBlockStr;
    //
    codeBlock := ScrCodeList1.CodeBlocks.Add('');
    codeBlock.Code.Text := Replace(cCRLFAlternate,sl[2], cCRLF);
    codeBlock.Caption := sl[0];
    codeBlock.Tag := StrToIntSafe(sl[1]);
  finally
    sl.Free;
  end;

end;

procedure TfmScriptEditor.LoadCodeBlocksFromIniStr(ACodeBlocksStr: string);
var
  sl: TStringList;
  i: integer;
begin
  sl := TStringList.Create;
  try
    sl.Text := Replace('#13#10', ACodeBlocksStr, cCRLF);
    if sl.Count > 0 then begin
      ScrCodeList1.CodeBlocks.Clear;
      for i := 0 to sl.Count - 1 do
        AddCodeBlockFromStr(sl[i]);
    end;
  finally
    sl.Free;
  end;

end;

procedure TfmScriptEditor.miCodeListAddDefaultClick(Sender: TObject);
var
  i, res: integer;
  slUser, slDefault: TStringList;
const
  cDefaultCodeList =
    '"function,fnc",1,"function MyFunction(): string;ÿ#beginÿ#  Result := '''';ÿ#end;ÿ#"'+cCRLF+
    '"procedure,proc",1,"procedure MyProcedure();ÿ#beginÿ#ÿ#end;ÿ#"'+cCRLF+
    'if,1,"  if TRUE then beginÿ#ÿ#  end;ÿ#"'+cCRLF+
    'sl,1,"  sl: TStringList;ÿ#beginÿ#  sl := TStringList.Create;ÿ#  tryÿ#ÿ#  finallyÿ#    sl.Free;ÿ#  end;ÿ#"'+cCRLF+ //varÿ#
    'for,1,"  for i := 0 to sl.Count - 1 do beginÿ#ÿ#  end;ÿ#"'+cCRLF+
    'try,1,"  tryÿ#ÿ#  finallyÿ#ÿ#  end;ÿ#"'+cCRLF+
    'repeat,1,"  repeatÿ#ÿ#  until ();ÿ#"'+cCRLF+
    'while,1,"  while () do beginÿ#ÿ#  end;ÿ#"'+cCRLF+
    'case,1,"  case pocet ofÿ#    0: beginÿ#         Result := 0;ÿ#       end;ÿ#    1: Result := 1;ÿ#  elseÿ#    Result := -1;ÿ#  end;ÿ#"';
begin
  slUser := TStringList.Create;
  slDefault := TStringList.Create;
  try
    for i := 0 to ScrCodeList1.CodeBlocks.Count - 1 do                          //zjistime, jestli existuje vlastni blok
      if ScrCodeList1.CodeBlocks.Items[i].Tag = 0 then                          //a pokud ano,
        slUser.Add(CodeBlockToStr(ScrCodeList1.CodeBlocks.Items[i])); //tak si ho ulozime
    //
    if slUser.Count > 0 then                                                    //pokud vlastni blok existuje,
      res:=MsgBoxWarn(Caption, 'Chceš pøi obnovì výchozích blokù smazat i vlastní bloky?', MB_YESNOCANCEL) //tak se zeptame na smazani
    else
      res := IDYES;                                                             //pokud vlastni blok neni, tak nic
    if (res = IDCANCEL) then
      Exit;
    //
    slDefault.Text := cDefaultCodeList;
    ScrCodeList1.CodeBlocks.Clear;                                              //vse smzeme
    for i := 0 to slDefault.Count - 1 do begin                                  //pridame defaultni
      AddCodeBlockFromStr(slDefault[i]);
    end;
    if (res = IDNO) then                                                        //pridame vlastni
      for i := 0 to slUser.Count - 1 do
        AddCodeBlockFromStr(slUser[i]);
  finally
    slUser.Free;
    slDefault.Free;
  end;

  {ulozi vse z ScrCodeList do souboru
  sl := TStringList.Create;
  try
    for i := 0 to ScrCodeList1.CodeBlocks.Count - 1 do
      sl.Add(Replace(cCRLF,ScrCodeList1.CodeBlocks.Items[i].Code.Text, cCRLFAlternate));
    sl.SaveToFile('d:\slCodeList.txt');
  finally
    sl.Free;
  end;}
end;

