procedure TfmScriptEditor.CheckRunningMode;
begin
   { is script source was modified then ask user to recompile and rerun }
   
   if FIsChanged and (FLastModifiedAnswer<>mrNo) then begin
      if GfaMain.ScripterT.Running then begin
        FLastModifiedAnswer := MessageDlg('Ve skriptu byla provedena zmìna. Spustit znovu?',mtConfirmation,[mbYes,mbNo,mbCancel],0);
        case FLastModifiedAnswer of
          mrYes : PrepareScriptToRun;
          mrCancel: Abort;
        end;
      end
      else
        PrepareScriptToRun;
   end;
end;

procedure TfmScriptEditor.PrepareScriptToRun;
var inst : pSimplifiedCode;
    c : integer;
    scr: TStrings;
begin
  try
    with GfaMain.ScripterT do begin
      GfaMain.ScripterT.Halt;
      if Running then begin
        Abort;
      end;

      if FIsChanged then begin
        SaveScript;

        { reassign script source }
        scr := TStrings.Create;
        scr := ActiveScript.Lines;
        scr.Text := GfaMain.TranslateFieldNames(scr.Text);
        scr.Text := GfaMain.TranslateIniProcs(scr.Text);
        //SaveStringToFile(scr.Text, 'd:\scr.txt');
        //SourceCode.Assign(scr);
        SourceCode := scr;

        //SourceCode.Assign(ActiveScript.Lines);

        { compile all source }
        Compile;
      end;

      { solve absolute addressing before to handle break points }
      SolveAbsoluteAddressing;

      { set all break points }
      SetBreakPt;

      FCurrentLine := -1;
      FSynMemoExecLines.Clear;

      { update script memo with compilation results }
      meScript.BeginUpdate;
      if not ExpandedDebugInfo then ExpandDebugInfo;
      inst := FirstInstruction;
      while inst <> nil do
      begin
        DisplayLineAttr(inst);
        inst := inst^.Next;
      end;
      meScript.EndUpdate;

      FIsChanged := false;
      //scr.Free;  //- pokud se povoli, tak se meScript vyprazdni
    end;
  finally
    //
  end;
end;

