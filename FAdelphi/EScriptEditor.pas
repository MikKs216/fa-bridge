procedure TfmScriptEditor.CreateDebugMode;

  procedure LoadWatches;
  var
    i: integer;
  begin
    if FWatches = nil then
      Exit;
    fmWatchViewer.Scripter.CurrentScript.VirtualMachine.DebugWatches.Clear;
    if (FWatches.Count > 0) then begin
      for i := 0 to FWatches.Count - 1 do
        AddWatch(FWatches[i], False);
    end
    else
      fmWatchViewer.Show;
    //
    fmScriptEditor.BringToFront;
  end;

  procedure LoadFromIni;
  var
    iniFile: TMemIniFile;
  begin
    if fmWatchViewer <> nil then begin
      iniFile := TMemIniFile.Create(GetIniFileName);
      try
        fmWatchViewer.Left := iniFile.ReadInteger(cIniWatchViewerFormSection, 'Left', Left+200);
        fmWatchViewer.Top := iniFile.ReadInteger(cIniWatchViewerFormSection, 'Top', Top+200);
        fmWatchViewer.Width := iniFile.ReadInteger(cIniWatchViewerFormSection, 'Width', 450);
        fmWatchViewer.Height := iniFile.ReadInteger(cIniWatchViewerFormSection, 'Height', 140);
        //
        LoadWatches;
      finally
        iniFile.Free;
      end;
    end;
  end;

begin
  //SyntEdit
  FBreakPoints := TStringList.Create;
  FCurrentLine := -1;
  FSynMemoExecLines := TStringList.Create;
  //{SyntEdit}

  FUpdateWatches := false;

  with GfaMain.ScripterT do begin
    { activate scripter on debug mode }
    OnDebugHook := ScriptDebug;
    OnRunningChanged := ScriptDebug;
    OnPauseChanged := ScriptDebug;
    OnBreakpointStop := BreakpointStop;
  end;

  ChangeScriptCompiling(ckShowScriptCompiled.Checked);
  PrepareScriptToRun;

  fmWatchViewer := TfmWatchViewer.Create(self);
  fmWatchViewer.Scripter := GfaMain.ScripterT;
  LoadFromIni;

  if PopupMenu1a.Items.Count = 0 then
    CreatePopupMenuDebugItems;
  ActiveScript.PopupMenu := PopupMenu1a;
end;

procedure TfmScriptEditor.DestroyDebugMode;

  procedure SaveWatches;
  var
    i: integer;
  begin
    if FWatches = nil then
      FWatches := TStringList.Create
    else
      FWatches.Clear;
    //
    for i := 0 to fmWatchViewer.Scripter.CurrentScript.VirtualMachine.DebugWatches.Count - 1 do
      FWatches.Add(fmWatchViewer.Scripter.CurrentScript.VirtualMachine.DebugWatches.Items[i].Expression);
  end;

  procedure SaveToIni;
  var
    iniFile: TMemIniFile;
  begin
    if fmWatchViewer <> nil then begin
      iniFile := TMemIniFile.Create(GetIniFileName);
      try
        iniFile.WriteInteger(cIniWatchViewerFormSection, 'Left', fmWatchViewer.Left);
        iniFile.WriteInteger(cIniWatchViewerFormSection, 'Top', fmWatchViewer.Top);
        iniFile.WriteInteger(cIniWatchViewerFormSection, 'Width', fmWatchViewer.Width);
        iniFile.WriteInteger(cIniWatchViewerFormSection, 'Height', fmWatchViewer.Height);
        SaveMemIni(iniFile);
        //
        SaveWatches;
      finally
        iniFile.Free;
      end;
    end;
  end;

begin
  GfaMain.ScripterT.Halt;
  UnsetBreakPt;
  with GfaMain.ScripterT do begin
    OnDebugHook := nil;
    OnRunningChanged := nil;
    OnPauseChanged := nil;
    OnBreakpointStop := nil;
  end;

  ActiveScript.PopupMenu := PopupMenu1;

  FBreakPoints.Free;
  FSynMemoExecLines.Free;
  SaveToIni;
  fmWatchViewer.Free;
  ChangeScriptCompiling(False);
  ActiveScript.Invalidate;
end;

