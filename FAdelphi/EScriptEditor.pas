function TfmScriptEditor.AskStrCodeBlock(var AValue1: string; var AValue2: string): TModalResult;
var
  frm: TfmAskStrCodeBlock;
  btnOk, btnCancel: TButton;
  lbCaption: TLabel;
  edCaption: TEdit;
  meCodeScript: TScrMemo;
begin
  Result := mrCancel;
  frm := TfmAskStrCodeBlock.CreateNew(Self);
  try
    btnOk := TButton.Create(frm);
    btnCancel := TButton.Create(frm);
    lbCaption := TLabel.Create(frm);
    edCaption := TEdit.Create(frm);
    meCodeScript := TScrMemo.Create(frm);

    //frm.BorderStyle := bsDialog;
    frm.Caption := 'CodeBlock Editor';
    frm.Position := poOwnerFormCenter;
    frm.KeyPreview := True;
    frm.OnKeyDown := frm.FormKeyDown;
    frm.Width := 350;
    frm.Height := 265;

    lbCaption.Parent := frm;
    lbCaption.Caption := 'Zkratka';
    lbCaption.Top := 12;
    lbCaption.Left := 12;

    edCaption.Parent := frm;
    edCaption.Text := AValue1;
    edCaption.Font.Name := 'MS Sans Serif';
    edCaption.Font.Size := 10;
    edCaption.Top := 8;
    edCaption.Left := lbCaption.Left+lbCaption.Width+12;
    edCaption.Anchors := [akLeft, akTop, akRight];
    edCaption.Width := 279;//232


    meCodeScript.Parent := frm;
    meCodeScript.Gutter.Visible := False;
    meCodeScript.SyntaxStyles := TMSStyler1;
    meCodeScript.Lines.Text := AValue2;
    meCodeScript.Top := edCaption.Top+edCaption.Height+4;;
    meCodeScript.Left := lbCaption.Left;
    meCodeScript.Anchors := [akLeft, akTop, akRight, akBottom];
    meCodeScript.Width := 310;
    meCodeScript.Height := 150;


//    btnCancel.Parent := frm;
    btnCancel.Caption := 'Storno';
    btnCancel.Default := false;
    btnCancel.ModalResult := mrCancel;
    btnCancel.Top := meCodeScript.Top + meCodeScript.Height + 12;
    btnCancel.Left := meCodeScript.Left + meCodeScript.Width - btnCancel.Width;
    btnCancel.Anchors := [akRight, akBottom];

    btnOk.Parent := frm;
    btnOk.Caption := 'OK';
    btnOk.Default := true;
    btnOk.ModalResult := mrOk;
    btnOk.Top := btnCancel.Top;
    btnOk.Left := btnCancel.Left - btnOk.Width - 4;
