procedure TfmScriptEditor.TryCompileTMS(ATryReportScript: boolean; ACompileDC: boolean);
var
  scr, s: string;
  st: TMemoryStream;
  errExp: string;  

  function DoTryCompile(ACompileStr: string; AScriptType: integer): boolean;
  begin
    Result := False;
    with GfaMain do begin
      if AScriptType = 1 then
        workScripterT.OnCompileError := WSOnCompileReportError
      else
        workScripterT.OnCompileError := WSOnCompileError;
      //
      try
        workScripterT.SourceCode.Text := ACompileStr;
        workScripterT.Compile;
        //
        Result := True;
      finally
          workScripterT.OnCompileError := nil;
      end;
    end;
  end;

  function DoTryExecute(ACompileStr: string; AScriptType: integer): boolean;
  begin
    Result := False;
    with GfaMain do begin
      workScripterT.OnRuntimeError := WSOnCompilePDSError;
      //
      try
        workScripterT.SourceCode.Text := ACompileStr;
        workScripterT.Execute();
        //
        Result := True;
      finally
        workScripterT.OnRuntimeError := nil;
      end;
    end;
  end;

begin
  with GfaMain do begin
    StartWait;
    try
      s := '';
      scr := TranslateFieldNames(ActiveScript.Lines.Text);
      scr := TranslateIniProcs(scr);
      {$IFNDEF FINALBUILD}
      if not GfaMain.FNewScripter  then begin
        if ACompileDC then begin
          //pomoci kompilace skriptu v DC zjistime, jestli skript neobsahuje chyby, ktere jsou pruchodne v TMS, ale ne v DC
          //(pokud totiz skript obsahuje takove chyby, tak kontrola spadne v AddComponent2WorkScripter)
          WorkScripter.Script.Clear;
          WorkScripter.Script.Add(scr);
          st := TMemoryStream.Create;
          try
            try
              WorkScripter.SaveCompiledScriptToStream(st);
            except
              Exit;
            end;
          finally
            st.Free;
          end;
        end;
        //
        AddComponent2WorkScripter(True);
      end
      else
        s := 'Definice je již pøevedena do TMS. ';
      {$ENDIF FINALBUILD}
      //
      if DoTryCompile(scr, 0) then
        AddStrLine(s, 'Skript je kompatibilní s TMS.');
      //
      if ATryReportScript then begin
        scr := TranslateFieldNames(mtDefReportScript.AsString);
        scr := TranslateIniProcs(scr);
        if DoTryCompile(scr, 1) then
          AddStrLine(s, 'Skript sestavy je kompatibilní s TMS.');
        //
        {$IFNDEF FINALBUILD}
        if IsFDRValid(FDefFileName, errExp) then
          AddStrLine(s, 'Všechna PDS jsou kompatibilní s TMS.')
        else begin
          {scr := TranslateFieldNames('result :='+errExp);
          scr := TranslateIniProcs(scr);
          DoTryExecute(scr, 2);}
          Application.MessageBox(PChar('PDS Error.'+cCRLF+errExp),    //MsgBoxErr zde nepouzivam, protoze se zobrazi na spatne pozici
                                 PChar(Caption),
                                 MB_ICONERROR + MB_OK);
          Exit;
        end;
        {$ENDIF FINALBUILD}
      end;
    finally
      StopWait;
    end;
    //
    ShowMessage(s);
  end;
end;

