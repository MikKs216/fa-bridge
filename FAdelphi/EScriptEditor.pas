function TfmScriptEditor.ValidCodeBlockCaption(const ACaption: string): boolean;
var
  i: integer;
  sl: TStringList;
begin
  Result := TRUE;
  sl := TStringList.Create;
  try
    sl.CommaText := ACaption;
    for i := 0 to sl.Count - 1 do begin
      if not StrIsAlphaNum(sl[i]) then begin
        Result := FALSE;
        Break;
      end;
    end;
  finally
    sl.Free;
  end;
end;

function TfmScriptEditor.AskForCodeBlockText(var ACodeBlockCaption, ACodeBlockText: string): boolean;
var
  codeCaption, codeText: string;
  stisk: word;
  captionOK: boolean;
begin
  Result:=False;
  codeCaption := ACodeBlockCaption;
  codeText := ACodeBlockText;

  repeat
    captionOK := TRUE;
    stisk:=AskStrCodeBlock(codeCaption, codeText);
    if stisk = mrOk then begin
      if (codeCaption <> '') then begin
        captionOK := ValidCodeBlockCaption(codeCaption);
        if not captionOK then
          MsgBoxWarn(Caption, 'Zkratka mùže obsahovat jen alfanumerické znaky.', MB_OK);
      end;
    end;
  until (captionOK) or (stisk=mrCancel);
  //
  if stisk<>mrCancel then begin
    ACodeBlockCaption := codeCaption;
    ACodeBlockText := codeText;
    Result := TRUE;
  end;
end;

procedure TfmScriptEditor.AddCodeBlockText(ACodeBlockCaption, ACodeBlockText: string);
var
  codeCaption, codeText: string;
  sl: TStringList;
begin
  codeCaption := ACodeBlockCaption;
  codeText := ACodeBlockText;
  if AskForCodeBlockText(codeCaption, codeText) then begin
    sl := TStringList.Create;
    try
      sl.Add(codeCaption);
      sl.Add('0');
      sl.Add(Replace(cCRLF, codeText, cCRLFAlternate));
      AddCodeBlockFromStr(sl.CommaText);
    finally
      sl.Free;
    end;
  end;
end;

procedure TfmScriptEditor.EditCodeBlock(ACodeBlock: TCodeBlock);
var
  codeCaption, codeText: string;
begin
  codeCaption := ACodeBlock.Caption;
  codeText := ACodeBlock.Code.Text;
  if AskForCodeBlockText(codeCaption, codeText) then begin
    ScrCodeList1.CodeBlocks.Items[ScrCodeList1.ItemIndex].Caption := codeCaption;  
    ScrCodeList1.CodeBlocks.Items[ScrCodeList1.ItemIndex].Code.Text := codeText;
  end;
end;

