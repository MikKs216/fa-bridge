// After toggle break point or changing current line
// we have to invalidate editor because it does not know about these changes.

procedure TfmScriptEditor.ToggleBreakpoint(Line: integer);
begin
  if not IsDebugMode then
    Exit;
  //
  GfaMain.ScripterT.DebugToggleBreakLine(line + 1);
  if IsBreakPt(Line) then
    FBreakPoints.Delete(FBreakPoints.IndexOf(IntToStr(Line)))
  else
    FBreakPoints.Add(IntToStr(Line));
  ActiveScript.Invalidate;
  //
  SaveBreaksPt;
end;

