//zobrazi dialog pro hledani a  
//AFindSpecificText
//  - TRUE - do pole pro hledani predvyplni udaj ATextToFind (napr. nazev aktualniho udaje ve formulari pri Ctrl+Shift+F)
//  - FALSE - AutoFill=TRUE, tzn. do pole pro hledani predvyplni text pod kurzorem
//          - vyplneny ATextToFind v tomto pripade slouzi jen pro rucni upravu historie (hledane slovo je vzdy na zacatku a sipkou dole prochazime posledne hledana slova)
//ATextToFind
//  -viz. predchozi radek
procedure TfmScriptEditor.ShowDialogFind(AFindSpecificText: Boolean; ATextToFind: string);
var
  isExecute: boolean;
  hist: string;
  ix: integer;
begin
  MacroShortCutUnRegister;
  try
    isExecute := False;
    LoadFindDialogProperties;
    //
    hist := SyntFindDialog1.History.Text;
    if (ATextToFind <> '') then begin
      ix := SyntFindDialog1.History.IndexOf(ATextToFind);
      if ix > -1 then
        SyntFindDialog1.History.Delete(ix);
      SyntFindDialog1.History.Insert(0, ATextToFind);
    end;
    //
    SyntFindDialog1.Control := ActiveScript;
    if AFindSpecificText then begin
      SyntFindDialog1.AutoFill := False;
      try
        SyntFindDialog1.FindText := ATextToFind;
        if SyntFindDialog1.Execute then
          isExecute := True;
      finally
        SyntFindDialog1.AutoFill := True;
      end;
    end
    else begin
      if SyntFindDialog1.Execute then
        isExecute := True;
    end;
    //
    if (ATextToFind <> '') and (not isExecute) then
      SyntFindDialog1.History.Text := hist;
    //
    SaveFindDialogProperties;
  finally
    MacroShortCutRegister;
  end;
end;

