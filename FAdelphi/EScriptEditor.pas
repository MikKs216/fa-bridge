procedure TfmScriptEditor.SaveFindDialogProperties;
var
  iniFile: TMemIniFile;
begin
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    with iniFile do begin
      WriteBool(cIniFindSection, 'ftCaseSensitive', (ftCaseSensitive in SyntFindDialog1.Flags));
      WriteBool(cIniFindSection, 'ftWholeWordOnly', (ftWholeWordOnly in SyntFindDialog1.Flags));
      WriteBool(cIniFindSection, 'ftRegularExpr', (ftRegularExpr in SyntFindDialog1.Flags));
      WriteBool(cIniFindSection, 'ftEntireScope', (ftEntireScope in SyntFindDialog1.Flags));
      WriteBool(cIniFindSection, 'ftBackward', (ftBackward in SyntFindDialog1.Flags));
      WriteString(cIniFindSection, 'History', Replace(#13#10, SyntFindDialog1.History.Text, '#13#10'));
      SaveMemIni(iniFile);
    end;
  finally
    iniFile.Free;
  end;
end;

//nacte nastaveni dialogu hledani
procedure TfmScriptEditor.LoadFindDialogProperties;
var
  iniFile: TMemIniFile;
  history: string;
begin
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    SyntFindDialog1.Flags := [];
    with iniFile do Begin
      if ReadBool(cIniFindSection, 'ftCaseSensitive', False) then
        SyntFindDialog1.Flags := SyntFindDialog1.Flags + [ftCaseSensitive];
      if ReadBool(cIniFindSection, 'ftWholeWordOnly', False) then
        SyntFindDialog1.Flags := SyntFindDialog1.Flags + [ftWholeWordOnly];
      if ReadBool(cIniFindSection, 'ftRegularExpr', False) then
        SyntFindDialog1.Flags := SyntFindDialog1.Flags + [ftRegularExpr];
      if ReadBool(cIniFindSection, 'ftEntireScope', False) then
        SyntFindDialog1.Flags := SyntFindDialog1.Flags + [ftEntireScope];
      if ReadBool(cIniFindSection, 'ftBackward', False) then
        SyntFindDialog1.Flags := SyntFindDialog1.Flags + [ftBackward];
      history := ReadString(cIniFindSection, 'History', '');
      if history <> '' then
        SyntFindDialog1.History.Text := Replace('#13#10', history, #13#10);
    End;
  finally
    iniFile.Free;
  end;
end;

