procedure TfmScriptEditor.meScriptGetTokenHint(Sender: TObject;
  TokenIndex: Integer; var HintText: string);
var
  ht, tStr: string;

  function GetDebugHint(AExpression: string): string;
  var
    v: variant;
    s: string;
    vt: Integer;
  begin
    try
      v := EvaluateWatch(GfaMain.ScripterT, AExpression);
      if v <> null then begin
        //s := v;
        //Result := AExpression + '=' + s;
        s := AExpression + '=';
        vt := vartype(v);
        case vt of
          varString: Result := s + '''' + VarToStr(v) + '''';
          {varInteger: Result := s + VarToStr(v) +': integer';
          varDouble: Result := s + VarToStr(v) +': double';
          varString: Result := s + '''' + VarToStr(v) + '''' +': string';
          varByte: Result := s + VarToStr(v) +': byte';
          varWord: Result := s + VarToStr(v) +': word';
          varBoolean: Result := s + VarToStr(v) +': boolean';
          varDate: Result := s + VarToStr(v) +': TDateTime';
          varArray: Result := s + VarToStr(v) +': array';}
        else
          Result := s + VarToStr(v);
        end;
      end;
    except
    end;
  end;

begin
  try
    if (FSlFnc <> nil) and ((Sender as TSyntaxMemo).SyntObj <> nil) then
      with (Sender as TSyntaxMemo).SyntObj do begin
        tStr := TagStr[TokenIndex];
        if IsDebugMode and (GfaMain.ScripterT.Running) then
          ht := GetDebugHint(tStr)
        else
          ht := FSlFnc.Values[tStr];
        if ht <> '' then
          HintText := Replace('#13#10', ht, cCRLF);
      end;
  except
   on E: Exception do
     HintText := E.Message;
  end;
end;

function GetCharFromVKey( vkey: word ): String;
var
  keystate: TKeyboardState;
  retcode: Integer;
begin
  Win32Check( GetKeyboardState( keystate ));
  SetLength( Result, 2 );
  retcode := ToAscii( vkey,
                MapVirtualKey( vkey, 0 ),
                keystate,
                @Result[1],
                0 );
  Case retcode Of
    0: Result := ''; // no character
    1: SetLength(Result,1);
    2: ;
  Else
    Result := ''; // retcode < 0 indicates a dead key
  End;
end;

//- nastavovani a testovani "setTl" je z duvodu, ze kdyz se stiska klavesa Ctrl a nic dalsiho,
//  tak neaktivni skript zacal "poskakovat"
//- ze stejneho duvodu je "UnActiveScript.CaretPos := ActiveScript.CaretPos" vlozeno az do podminek
procedure TfmScriptEditor.meScriptKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  tl: Integer;
  s: string;
  setTl: boolean;
begin
  if IsDebugMode and (GfaMain.ScripterT.Running) then
    if (Key = VK_Return) or (Key = VK_DELETE) or (Key = VK_BACK) then
      Key := 0;
  //
  if IsSecondScriptVisible then begin
    tl := UnActiveScript.TopLine;
    UnActiveScript.OnKeyDown := nil;
    UnActiveScript.BeginUpdate;
    try
      setTl := False;
      s :=GetCharFromVKey(Key);
      if (s <> '') and  (Ord(Char(s[1])) >= 32) then begin
        UnActiveScript.CaretPos := ActiveScript.CaretPos;
        SendMessage(UnActiveScript.Handle, WM_CHAR, Ord(Char(s[1])), MakeLong(0, MapVirtualKey(key, 0)));
        setTl := True;
      end
      else if (Key < 17) or (Key > 19) then begin   //18=Alt
        UnActiveScript.CaretPos := ActiveScript.CaretPos;
        SendMessage(UnActiveScript.Handle, WM_KEYDOWN, key, MakeLong(0, MapVirtualKey(key, 0)));
        setTl := True;
      end;
    finally
      if setTl then
        UnActiveScript.TopLine := tl;
      UnActiveScript.EndUpdate(True);
      UnActiveScript.OnKeyDown := meScriptKeyDown;
    end;
  end;

{  if IsSecondScriptVisible then begin
    //SendMessage(UnActiveScript.Handle, WM_KEYDOWN, Key, MakeLong(0, MapVirtualKey(key, 0)));
    //UnActiveScript.Perform(WM_KEYDOWN, Key, 0);
    //  SendMessage(UnActiveScript.Handle, WM_KEYDOWN, key, MakeLong(0, MapVirtualKey(key, 0)));
      //SendMessage(UnActiveScript.Handle, WM_KEYUP, key, MakeLong(0, MapVirtualKey(key, 0)));
     //PostMessage(UnActiveScript.Handle, WM_KEYDOWN, key, MakeLong(0, MapVirtualKey(key, 0)));
    //PostMessage(UnActiveScript.Handle, WM_KEYUP, key, MakeLong(0, MapVirtualKey(key, 0) or $C0000000));
      //UnActiveScript.CaretPos := cp;
      //UnActiveScript.TopLine := tl;
  end;}
end;

