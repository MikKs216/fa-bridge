procedure TfmScriptEditor.ShowInExtEditor;
var
  h: HWND;
  fn, fne, fnp, fns, posstr: string;
  i, x, y: integer;
  ok: Boolean;
const
  msgEdit = 'JE OTEVØENÝ EXTERNÍ EDIOR';
  msgOpen = 'Èekám na otevøení externího editoru';
  nTime = 60;
begin
  if MsgBoxAsk(Caption, 'Chceš skuteènì otevøít externí editor?', MB_YESNO) = mrNo then
    Exit;
  //  
  fn:=SaveEditedText;
  fns:=fn;
  fne:=GetCodeEditorPath+'EditPadPro7\EditPadPro7.exe';
  fn:='/l'+IntToStr(ActiveScript.CaretPos.Y+1)+' /c'+IntToStr(ActiveScript.CaretPos.X+1)+' "'+fn+'"';

  ActiveScript.ReadOnly:=True;
  ActiveScript.Enabled:=False;
  mxStatusBar1.Panels[0].Text:=msgOpen;
  mxStatusBar1.Panels[1].Text:='';

  miSaveCursor.Visible:=false;
  miSetCursor.Visible:=false;
  miGotoLine.Visible:=false;
  miInserttemplate.Visible:=false;
  miCheckScript.Visible:=false;
  miSaveScript.Visible:=false;
  miSaveIncludeScripts.Visible:=false;
  miExtEditor.Visible:=false;
  miShowDialogFindField.Visible:=false;
  miPasteFildName.Visible:=false;
  miCopyFildName.Visible:=false;
  miFindFiledInForm.Visible:=false;

  ShellExec(fne,fn);

  i:=0;
  repeat
    Inc(i);
    Refresh;
    Application.ProcessMessages;
    Sleep(300);
    if Length(mxStatusBar1.Panels[1].Text)>+4 then
      mxStatusBar1.Panels[1].Text:=''
    else
      mxStatusBar1.Panels[1].Text:=mxStatusBar1.Panels[1].Text+'.';
    Refresh;
  until (FindWindow('TFormEditPadPro7', NIL)>0) or (i>nTime);

  ok:=true;
  if i<=60 then begin
    FIsWaitingEditor:=True; //je pouzito take jako indikace zavreni formulare
    mxStatusBar1.Panels[0].Text:=msgEdit;
    repeat
      if not FIsWaitingEditor then
        Break;

      Refresh;
      Application.ProcessMessages;
      Sleep(300);
      if Length(mxStatusBar1.Panels[1].Text)>+4 then
        mxStatusBar1.Panels[1].Text:=''
      else
        mxStatusBar1.Panels[1].Text:=mxStatusBar1.Panels[1].Text+'.';
      Refresh;
    until FindWindow('TFormEditPadPro7', NIL)=0;
  end
  else begin
    MsgBoxWarn(Caption,'Nepodaøilo se otevøít externí editor. Zkontrolujte jeho dostupnost.',MB_OK);
    ok:=false;
  end;

  FIsWaitingEditor:=False;
  ActiveScript.ReadOnly:=False;
  ActiveScript.Enabled:=True;

  miSaveCursor.Visible:=false;
  miSetCursor.Visible:=true;
  miGotoLine.Visible:=true;
  miInserttemplate.Visible:=true;
  miCheckScript.Visible:=true;
  miSaveScript.Visible:=true;
  miSaveIncludeScripts.Visible:=true;
  miExtEditor.Visible:=true;
  miShowDialogFindField.Visible:=true;
  miPasteFildName.Visible:=true;
  miCopyFildName.Visible:=true;
  miFindFiledInForm.Visible:=true;

  LoadEditedText(fns);

  if ok then begin
    fnp:=GetCodeEditorPath+'EditorPos.txt';
    if FileExists(fnp) then begin
      posstr:=LoadStringFromFile(fnp);
      x:=StrToIntSafe(GetStringLine(posstr,1));
      y:=StrToIntSafe(GetStringLine(posstr,0));
      ActiveScript.CaretPos := Point(x-1, y-1);
      if GetStringLine(posstr,2)='1' then //jakoby stidknout Ctrl+S
        SaveScript;
    end;
  end;

  mxStatusBar1.Panels[0].Text:='';
  mxStatusBar1.Panels[1].Text:='';
end;

