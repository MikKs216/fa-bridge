procedure TfmScriptEditor.FormCloseQuery(Sender: TObject;
  var CanClose: Boolean);
var
  res: integer;
  isChangingScript: boolean;
begin
  try
     { confirm script debugging termination on close } //nemelo by nastavat, protoze je pri ladeni zakazana editace (viz. meScriptKeyPress)
     if GfaMain.ScripterT.Running then begin
       if (MessageDlg('Probíhá ladìní skriptu. Ukonèit?',mtConfirmation,[mbYes,mbNo,mbCancel],0)<>mrYes) then begin //Script debug session in progress. Terminate
         CanClose := false;
         Abort;
       end
       else begin
         GfaMain.ScripterT.Halt;
         if FIsChanged then begin
           MsgBoxWarn(Caption,'Ve skriptu byly provedeny zmìny, skript nejprve uložte.',MB_OK);
           CanClose := false;
           Abort;
         end
         else
           CanClose := true;
       end;
     end;

    if FIsWaitingEditor then begin
      CanClose := false;
      res:=MsgBoxWarn(Caption,'Je otevøený externí editor. Chcete pøesto teï zavøít editor skriptu?',MB_YESNO);
      if res = IDYES then begin
        FIsWaitingEditor:=false;
        CanClose := true;
      end;
      Exit;
    end;

    if (ActiveScript.PopupMenu<>pmModalScript) and FIsChanged then begin
      res:=MsgBoxAsk(Caption, 'Uložit definici?', MB_YESNOCANCEL);
      if res = IDYES then begin
        ActiveScript.Lines.SaveToFile(NormalPath(GetExePath)+'Script.txt');
        if IsDebugMode then
          GfaMain.AcceptFormScript(ChangeScriptCompiling(False, False))
        else
          GfaMain.AcceptFormScript(ActiveScript.Lines.Text);
        isChangingScript:=GfaMain.FIsChangingScript;
        GfaMain.FIsChangingScript:=TRUE; //aby se neprovadelo calculate
        try
          FIsChanged:= FALSE;
          GfaMain.SaveFormScript;
        finally
          GfaMain.FIsChangingScript:=isChangingScript;
        end;
      end
      else begin
        CanClose := not (res = IDCANCEL);
        FIsChanged := (res = IDCANCEL);
      end;
    end;
  finally
     FCanClose := CanClose;
  end;
end;

