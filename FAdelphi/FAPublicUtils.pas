//AData ... kdyz je prazdne provede se init, jinak se init neprovadi
//AAddedData .. naplni pri vytvareni noveho formulare po initu, pri otevirani
//              formulare kdyz je neprazdne AData se doplni AAddedData po naplneni dat, ale nema to moc prakticky vyznam
//              format pridavanych dat staci jen nazevudaje=hodnota v jedn radcich
function DoOpenFormNested(ALevel: integer; const AEPOFilePath: string; ALeft, ATop, AWidth, AHeight: integer): string;
var
  leftPos, topPos, widthPos, heightPos: integer;
{$IFDEF FA_APP}
  fm, fmOld: TFaMain;
{$ENDIF FA_APP}
begin
  Result:='';
{$IFDEF FA_APP}
  fm:=nil;
  {if FNestedMainForm[Alevel]<>nil then begin
    MessageWarn('','Vložený formulář nelze otevřít, protože je již otevřen jiný vložený formulář. Nejprve je třeba jej zavřít.',[MBOK]);
    EXIT;
  end;}
  StartWait;
  gFormOpening:=True;
  fmOld:=GFaMain;
  try
    if ALevel=1 then begin
      if GFaMain.mtTskp.Active then
        FNestedDefName:=GFaMain.mtTskpDefID.Value
      else
        FNestedDefName:='';
    end;
    fm:=TfaMain.Create(Application);
    with fm do begin
      Visible:=FALSE;

      leftPos:=ALeft;
      topPos:=ATop;
      widthPos:=AWidth;
      heightPos:=AHeight;

      FEPOFilePath:=AEPOFilePath;

      if WindowState=wsNormal then begin
        Left:=leftPos;
        Top:=topPos;
        Width:=widthPos;
        Height:=heightPos;
        if AEPOFilePath<>'' then begin
          Height:=10;//heightPos;
          FShowLoadingWindow:=1; // priznak aby se zobrazilo okno Loading
        end;

        paInfo.Visible := GfaMain.paInfo.Visible;
        paCheck.Visible := GfaMain.paCheck.Visible;
        paBottom.Height := GfaMain.paBottom.Height;
        InitPaBottom(paInfo.Visible, paCheck.Visible, false);

        paContent.Height := GfaMain.paContent.Height;
        paComment.Height := GfaMain.paComment.Height;
        paLeft.Width := GfaMain.paLeft.Width;
      end;

      FNestedLevel:=Alevel;
      FNestedState:=TRUE;
      FNestedData[Alevel]:='';
      FNestedMainForm[Alevel]:=fm;
      FNestedMainFormState[Alevel]:=1;
      FNestedCommandSelector:=nstSelOpen;
      FNestedMainLocked:=GfaMain.FStateFormLocked;
    end;
  finally
    gFormOpening:=False;
    StopWait;
  end;
  fm.ShowModal;
  GFaMain:=fmOld;
  {$IFNDEF STANDALONE}
  GFaMain.LoadStoredStrings;
  {$ENDIF STANDALONE}
  if fm<>nil then
    FreeAndNil(fm);
  Result:=FNestedData[Alevel];
  if FNestedLevel=2 then
    FNestedLevel:=1;
{$ENDIF FA_APP}
end; {DoOpenFormNested}

function DoPrepareReportFormNested(ALevel: integer;
  const ADstFileName: string; ALeft, ATop, AWidth, AHeight: integer): string;
var
  leftPos, topPos, widthPos: integer;
{$IFDEF FA_APP}
  fm, fmOld: TFaMain;
{$ENDIF FA_APP}
begin
  Result:='';
{$IFDEF FA_APP}
  StartWait;
  fmOld:=GFaMain;
  FNestedPrepareReportState:=TRUE;
  try
    gFormOpening:=True;
    try
      if ALevel=1 then begin
        if GFaMain.mtTskp.Active then
          FNestedDefName:=GFaMain.mtTskpDefID.Value
        else
          FNestedDefName:='';
      end;
      fm:=TfaMain.Create(Application);
      with fm do begin
        Visible:=FALSE;

        leftPos:=ALeft;
        topPos:=ATop;
        widthPos:=AWidth;
        //heightPos:=AHeight;
        
        if WindowState=wsNormal then begin
          Left:=leftPos;
          Top:=topPos;
          Width:=widthPos;//widthPos;   //otvirame formular v malickem okne
          Height:=10;//heightPos;
          FShowLoadingWindow:=1; // priznak aby se zobrazilo okno Loading
        end;
        FNestedLevel:=Alevel;
        FNestedState:=TRUE;
        FNestedData[Alevel]:='';
        FNestedMainForm[Alevel]:=fm;
        FNestedMainFormState[Alevel]:=1;
        FNestedCommandSelector:=nstSelOpen;
        FNestedMainLocked:=FStateFormLocked;
      end;
      FNestedDstFileName:=ADstFileName;
    finally
      gFormOpening:=False;
    end;
    fm.ShowModal;
    Result:=FNestedDstFileName;
  finally
    FNestedPrepareReportState:=FALSE;
    StopWait;
  end;
  GFaMain:=fmOld;
  if fm<>nil then
    FreeAndNil(fm);
  if FNestedLevel=2 then
    FNestedLevel:=1;
{$ENDIF FA_APP}
end; {DoPrepareReportFormNested}

{-----------------------------------------------------------------------------
 DoFAPrintForm
   Otevre Form asistent a formular se stavajicicmi daty ulozenymi v AFormStreamData
   a vytiskne jej.
   Vstup: AIDForm ... identifikator formulare
          AFormStreamData ... data formulare

   Po zavolani muzeme zkusit dat focus zpatky na okno klientu.
   Melo by se to vytisknout na pozadi.
 -----------------------------------------------------------------------------}

{$IFDEF FA_APP}
function DoFAPrintForm(AClientID: integer;
  AFormStreamData: TMemoryStream;
  ASendMail: boolean;
  AOnlyPrepareFile: boolean;
  AProcGetFormFromDBGUID: TProcGetFormFromDBGUID;
  var AOutPdfFileName: string;
  ALeft: integer=-1; ATop: integer=0): TfaMain;
begin
  StartWait;
  try
    FProcGetFormFromDBGUID := AProcGetFormFromDBGUID;

    gFormOpening:=True;
    try
      //Result:=TfaMain.Create(Application);
      Result := CreateFAinstance;
    finally
      gFormOpening:=False;
    end;
    with Result do begin
      FClientID := AClientID;
      gFormOpening:=True;
      try
        FOpenFromDoPrint := TRUE;
        Visible:=FALSE;
        if WindowState=wsNormal then begin
          if ALeft>=0 then begin
            Left:=ALeft;
            Top:=ATop;
          end;
          //neudavaji se rozmeny, protoze to vzkdycky zobrazuje loading okno
          FShowLoadingWindow:=2; // priznak aby se zobrazilo okno Loading
          Width:=660;
          Height:=160;
        end;
        Show;
      finally
        gFormOpening:=False;
      end;
      DoPrintForm(AFormStreamData, ASendMail, AOnlyPrepareFile, AoutPdfFileName);
      try
        Close;
      except
      end;
    end;
  finally
    StopWait;
  end;
end; {DoFaPrintForm}
{$ENDIF FA_APP}

