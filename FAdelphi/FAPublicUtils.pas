  out AIdOut: Integer;
  out ATypeOut: string;
  out ADataOut: string): boolean;
begin
  //FProcDoVyberAttach -> AdresUtils.DoVyberAttach
  Result := FProcDoVyberAttach(AClientID, AData, AIdOut, ATypeOut, ADataOut);
end;} {DoAttachments}

