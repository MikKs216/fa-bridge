  {ehshelprouter,}
{$ENDIF STANDALONE}

{$IFDEF FA_APP}
  Main,
{$ENDIF FA_APP}
  Res_FA, SpolFuncConst;

type
  TProcSaveDefToDB =
    function (const ADefId: string): boolean;
  TProcSaveFormToDB =
    function(
    const AIDForm: integer;
    const AIDDef, ATxtDefName: string;
    AStream: TMemoryStream;
    ALocked: boolean;
    const APPExpiration: TDateTime;
    const AComment, ACommentAll, ASysComment, ACharacteristics, AFillingNumber, APeriod: string;
    APeriodFrom, APeriodTo, AFillingDate: TDateTime;
    APeriodYear, AState: integer;
    AModifiedTime, AOpenedTime: integer;
    AAddHistory: boolean; AStoredStrings: TMemoryStream): boolean;
  TProcSaveNewFormToDB =
    function(
      const AClientId: integer;
      out AFormId: integer;
      var AGuid: string;
      const AIDDef: string;
      AStream: TMemoryStream;
      ALocked: boolean;
      const APPExpiration: TDateTime;
      const AComment, ASysComment, ACharacteristics, AFillingNumber, APeriod: string;
      APeriodFrom, APeriodTo, AFillingDate: TDateTime;
      APeriodYear, AState: integer;
      AModifiedTime, AOpenedTime: integer;
      AAddHistory: boolean; AStoredStrings: TMemoryStream): boolean;
  TProcSavePaymentInfo =
    function (const AKlientID: integer; const ADatePayment: TDateTime;
      const AText: string; const AValue: double;
      const AAccount: string=''; const ABank: string='';
      const ASpecSym: string='';
      const AVarSym: string=''; const AKonSym: string='';
      const AIBAN: string=''; const ASwift: string='';
      const AFormId: integer=-1; const AFormName: string = '';
      const AComment: string = ''):boolean;

  TProcWriteZast2Adr =
    procedure (
      const AKlientID: integer; //Klient ID
      const AIDForm: integer; //ID Formulare
      const AType: string; // typ zastupovani - text "Plna moc", "Mandatni smlouva"
      const AForOffice: string; //instituce /vuci komu je zastupovani "FU", ZP" CU", "SSP"...
      const ASubject: string; //Predmet
      const AGeneration: boolean; //Generalni zastupovani?
      const AValidityFrom: TDateTime; //Platnost zastupovani od
      const AValidityTo: TDateTime; //Platnost zastupovani do
      const AComment: string); //Poznamka

  TProcNotifyCancelEditForm =
