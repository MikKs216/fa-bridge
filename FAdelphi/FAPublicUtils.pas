  var AFormStreamData: TMemoryStream;
  out ATxtDefName: string;
  out ALocked: boolean;
  out APPExpiration: TDateTime;
  out AComment: string; out ASysComment: string;
  out ACharacteristics: string; out APeriod: string;
  out AFillingDate: TDateTime;
  out AFillingNumber: string;
  out APeriodFrom: TDateTime; out APeriodTo: TDateTime;
  out APeriodYear: integer;
  out AState: integer): TfaMain;  //pridat workState
begin
  StartWait;
  try
    gFormOpening:=True;
    try
      //Result:=TfaMain.Create(Application);
      Result := CreateFAinstance;
    finally
      gFormOpening:=False;
    end;
    with Result do begin
      gFormOpening:=True;
      try
        Visible:=FALSE;
        if WindowState=wsNormal then begin
          //neurcujeme umisteni ani velikost, okno loding si to poresi automaticky. Vola se to jen z klientu, kde setjne nezadame umisteni.
          FShowLoadingWindow:=2; // priznak aby se zobrazilo okno Loading
          Width:=660;
          Height:=160;
        end;
        Show;
      finally
        gFormOpening:=False;
      end;

      ATxtDefName := '';

      DoGetFormInfo(AFormStreamData, ATxtDefName, ALocked, APPExpiration,
        AComment,ASysComment,
        ACharacteristics,APeriod,APeriodFrom,APeriodTo,APeriodYear,
        AFillingNumber, AFillingDate, AState);
