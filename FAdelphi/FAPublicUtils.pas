//CloseAllFaForms
//  Zavre vsechny okna, - je to z duvodu, ze FA neni MDI
function CloseAllFaForms: boolean;
var
  i: integer;
begin
  Result := true;
{$IFDEF FA_APP}
  try
    for i := Application.ComponentCount - 1 downto 0 do begin
      if cUsePermanentFA then begin //Permanentni FA
        //
        if Application.Components[i] is TfaMain then begin
          // perm okno 1
          if TfaMain(Application.Components[i]) = GfaWindowForm1 then begin
            if GfaWindowForm1.FClientID=0 then begin // je zavrene, tak ho zrusiem
              GfaWindowForm1.Destroy;
              GfaWindowForm1:=nil;
            end
            else begin
              GfaWindowForm1.FSClose;
              if GfaWindowForm1.FClientID=0 then begin
                GfaWindowForm1.Destroy;
                GfaWindowForm1:=nil;
              end;
            end;
          end
          // perm okno 2
          else if TfaMain(Application.Components[i]) = GfaWindowForm2 then begin
            if GfaWindowForm2.FClientID=0 then begin
              GfaWindowForm2.Destroy;
              GfaWindowForm2:=nil;
            end
            else begin
              GfaWindowForm2.FSClose;
              if GfaWindowForm2.FClientID=0 then begin
                GfaWindowForm2.Destroy;
                GfaWindowForm2:=nil;
              end;
            end;
          end
          // perm okno 3
          else if TfaMain(Application.Components[i]) = GfaWindowForm3 then begin
            if GfaWindowForm3.FClientID=0 then begin
              GfaWindowForm3.Destroy;
              GfaWindowForm3:=nil;
            end
            else begin
              GfaWindowForm3.FSClose;
              if GfaWindowForm3.FClientID=0 then begin
                GfaWindowForm3.Destroy;
                GfaWindowForm3:=nil;
              end;
            end;
          end
          // perm okno 4
          else if TfaMain(Application.Components[i]) = GfaWindowForm4 then begin
            if GfaWindowForm4.FClientID=0 then begin
              GfaWindowForm4.Destroy;
              GfaWindowForm4:=nil;
            end
            else begin
              GfaWindowForm4.FSClose;
              if GfaWindowForm4.FClientID=0 then begin
                GfaWindowForm4.Destroy;
                GfaWindowForm4:=nil;
              end;
            end;
          end
          // perm okno 5
          else if TfaMain(Application.Components[i]) = GfaWindowForm5 then begin
            if GfaWindowForm5.FClientID=0 then begin
              GfaWindowForm5.Destroy;
              GfaWindowForm5:=nil;
            end
            else begin
              GfaWindowForm5.FSClose;
              if GfaWindowForm5.FClientID=0 then begin
                GfaWindowForm5.Destroy;
                GfaWindowForm5:=nil;
              end;
            end;
          end
          // bezne dalsi okno
          else
            TfaMain(Application.Components[i]).FSClose;
        end;
      end
      else begin
        if (Application.Components[i] is TfaMain) then
          TfaMain(Application.Components[i]).FSClose;
      end;
    end;
  except //kvuli caste chybe List index out of bounds - toto uz by nastat nemelo - otocil jsem poradi zavirani v cyklu for - Mik 10.7.2019
    on e:EListError do begin
    end;
  end;

  Application.ProcessMessages;

  try
    for i := 0 to Application.ComponentCount - 1 do begin
      if (Application.Components[i] is TfaMain) then begin
        Result := false;
        Exit;
      end;
    end;
  except //kvuli caste chybe List index out of bounds
    on e:EListError do begin
    end;
  end;
{$ENDIF FA_APP}
end;{CloseAllFaForms}

