{$IFDEF FA_APP}
function CreateFAinstance: TFaMain;
begin
  Result := nil;
  if cUsePermanentFA then begin //pouzivat permanentni FA
    //zkusime prvni permanentni formular
    if GfaWindowForm1=nil then begin
      Result := TfaMain.Create(Application);
      GfaWindowForm1 := Result;
    end
    else begin
      if GfaWindowForm1.FClientID = 0 then begin // kdyz neni nacteny zadny formular, tak je FClientID=0 a muzeme jej pouzit
        TfaMain(GfaWindowForm1).InitFAVars;
        Result := GfaWindowForm1;
      end;
    end;
    //
    if Result = nil then begin
      //zkusime druhy permanentni formular
      if GfaWindowForm2=nil then begin
        Result := TfaMain.Create(Application);
        GfaWindowForm2 := Result;
      end
      else begin
        if GfaWindowForm2.FClientID = 0 then begin
          TfaMain(GfaWindowForm2).InitFAVars;
          Result := GfaWindowForm2;
        end;
      end;
    end;
    //
    if Result = nil then begin
      //zkusime treti permanentni formular
      if GfaWindowForm3=nil then begin
        Result := TfaMain.Create(Application);
        GfaWindowForm3 := Result;
      end
      else begin
        if GfaWindowForm3.FClientID = 0 then begin
          TfaMain(GfaWindowForm3).InitFAVars;
          Result := GfaWindowForm3;
        end;
      end;
    end;
    //
    if Result = nil then begin
      //zkusime 4. permanentni formular
      if GfaWindowForm4=nil then begin
        Result := TfaMain.Create(Application);
        GfaWindowForm4 := Result;
      end
      else begin
        if GfaWindowForm4.FClientID = 0 then begin
          TfaMain(GfaWindowForm4).InitFAVars;
          Result := GfaWindowForm4;
        end;
      end;
    end;
    //
    if Result = nil then begin
      //zkusime 5. permanentni formular
      if GfaWindowForm5=nil then begin
        Result := TfaMain.Create(Application);
        GfaWindowForm5 := Result;
      end
      else begin
        if GfaWindowForm5.FClientID = 0 then begin
          TfaMain(GfaWindowForm5).InitFAVars;
          Result := GfaWindowForm5;
        end;
      end;
    end;
  end;
  //jinak vytvorime novy puvodnim zpusobem
  if Result = nil then
    Result := TfaMain.Create(Application);
  //Permanentni okna FA - konec
end;
{$ENDIF FA_APP}

