      FGetVykaz := AGetVykaz;
      FIsVykazExists := AIsVykazExists;
      FGetLogo := AGetLogo;
      FGetLogoInFile := AGetLogoInFile;
      FGetStoredStrings := AGetStoredStrings;
      FSetStoredStrings := ASetStoredStrings;
      FSelKlientParams := ASelKlientParams;
      FSelKlientAdresy := ASelKlientAdresy;
      FSelKlientOsoby := ASelKlientOsoby;
      FSelKlientDoc := ASelKlientDoc;
      FSelKlientBankUc := ASelKlientBankUc;
      FIsPayment4Frm := AIsPayment4Frm;
      FDelPayment4Frm := ADelPayment4Frm;
      AEpoMsgErr := '';

      Result := CreateFAinstance;
    finally
      gFormOpening:=False;
    end;

    with Result do begin
      gFormOpening:=True;
      try
        Visible:=FALSE;
        if WindowState=wsNormal then begin
          if AEPOFilePath<>'' then begin
            //neurcujeme umisteni ani velikost, okno loding si to poresi automaticky. Vola se to jen z klientu, kde setjne nezadame umisteni.
            FShowLoadingWindow:=2; // priznak aby se zobrazilo okno Loading
