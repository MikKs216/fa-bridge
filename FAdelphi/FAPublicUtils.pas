{-----------------------------------------------------------------------------
 SaveFormToDB
   Ulozi data formulare do databaze, vola ji FA pro ulozeni dat.
   Vstup: AIDForm ... ID formulare
          AStream ... data formulare v memory streamu
          ALocked ... informace jestli je formular zamceny
          AComment ... informace, ktere uzivatel zapsal do kratke poznamky,
                    mely by se zobrazovat v seznamu formularu
   Vraci: TRUE ... pokud se ulozeni podarilo
 -----------------------------------------------------------------------------}

function SaveFormToDB(
  AIDForm: integer;
  AStream: TMemoryStream;
  ALocked: boolean;
  const APPExpiration: TDateTime;
  const AComment, ACommentAll, ASysComment, ACharacteristics, APeriod, AFillingNumber: string;
  AFillingDate: TDateTime;
  APeriodFrom, APeriodTo: TDateTime;
  APeriodYear: integer;
  AModifiedTime, AOpenedTime: integer; AStoredStrings: TMemoryStream;
  AIDDef, ATxtDefName: string;
  AWorkState: integer; AAddHistory: boolean = True): boolean;
begin
  //FSaveFormToDB ->  AdresFunkce.SaveFormToAdres

  Result := FSaveFormToDB(
    AIDForm, AIDDef, ATxtDefName,
    AStream, ALocked, APPExpiration,
    AComment, ACommentAll, ASysComment,
