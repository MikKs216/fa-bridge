      const AKlientID: integer; //id klienta
      const AName: string; //Nazev vkladaneho souboru i s priponou
      const AComment: string; //Poznamka
      const ACommentMemo: string; //Poznamka (text)
      const AMark: string; //Znacka
      const ACode: string; //Kod
      const ADate: TDateTime; //Datum dokumentu
      const AState: string; //Stav
      const AGiveTo: string; //Predano komu
      const AReceive: boolean; //Přijatý dokument?
      const AContens: string; //Obsah dokumentu
      const APath: string);  //Cesta (i s vkladanym souborem)
                             //Pokud se nema vlozit zadny soubor, pouze vytvorit zaznam v dokumentech, APath je prazdny
                             // Soubor se vlozi do databaze zkomprimovany nebo nezpomprimovany podle nastaveni programu
      const AFormId: integer=-1; // Id formulare
      const AFormName: string = ''); // Nazev formulare
   Vraci Id zapsaneho dokumentu      
 -----------------------------------------------------------------------------}

function WriteDoc2Adr(
  const AKlientID: integer;
  const AName: string;
  const AComment: string;
  const ACommentMemo: string;
  const AMark: string;
  const ACode: string;
  const ADate: TDateTime;
  const AState: string;
  const AGiveTo: string;
  const AReceive: boolean;
  const AContens: string;
  const APath: string;
  const AFormId: integer=-1; // Id formulare
  const AFormName: string = ''; // Nazev formulare
  const AFrom: string = ''; // Pro datove schranky - Odesílatel
  const ARecipient: string = ''; // Pro datove schranky - Příjemce
  const ADelivery: TDateTime = 0; // Pro datove schranky - Datum doručení
  const AFolder: string = ''; // Pro datove schranky - Složka
  const AFolderType: string = '' // Pro datove schranky - Typ složkay
  ): integer;
var
  ftype: string;
  id, id2: Integer;
begin
  if AFolderType='' then
    ftype := cTypeFolderDoc
  else
    ftype := AFolderType;

  //FWriteDoc2Adr -> AdresFunkce.AddDoc2Adr
  if FWriteDoc2Adr(
    id, id2,
    AKlientID, AName, AComment, ACommentMemo, AMark, ACode, ADate,
    AState, AGiveTo, AReceive, AContens, APath,
    AFormId, AFormName,
    AFrom, ARecipient, ADelivery, AFolder, ftype) then
    Result := id2
  else
    Result:=-1; // kdyz se zapis nepovede  
end; {WriteDoc2Adr}


