procedure TfmDSZprava.NactiPrilohu;
var
  fileList: string;
  sl: TStringList;
  i: integer;
  drv, pth, fil, ext, pthI: string;
begin
  pthI := GetStringLineValue(FParams, 'ImportDir');
  if pthI<>'' then
    OpenDialog1.InitialDir := pthI;


  if ShowOpenFileDialog('Všechny soubory (*.*)|*.*', '', TRUE, fileList) then begin
    sl:= TStringList.Create;
    sl.Text:=fileList;
    try
      for i:=0 to sl.Count-1 do begin
        //kontroly
        PathExtractElements(sl[i],drv, pth, fil, ext);
        ext:=LowerCase(ext);
        AttachmentTestExt(ext);
        //
        taPrilohy.Append;
        taPrilohySoubor.Value:=ExtractFileName(sl[i]);
        taPrilohyCesta.Value:=sl[i];
        if taPrilohySoubor.Value<>'' then
          taPrilohy.Post
        else
          taPrilohy.Cancel;
      end;

      AttachmentTestSize;
      btSmazatSoubor.Enabled:=taPrilohy.RecordCount>0;
    finally
      sl.Free;
    end;
  end;
  if grPrilohyView1.ViewData.RecordCount>0 then begin
    grPrilohyView1.Controller.ClearSelection;
    grPrilohyView1.ViewData.Records[grPrilohyView1.ViewData.RecordCount-1].Focused := True;
    grPrilohyView1.Controller.FocusedRecord.Selected := True;
  end;
  NastavFileButton;
end;

procedure TfmDSZprava.SmazPrilohu;
var
  i, n: integer;
begin
  if grPrilohyView1.Controller.SelectedRowCount>0 then begin
    if MessageAsk(Caption, 'Chcete smazat vybrané přílohy?', [MBYES, MBNO])=
      MRYES then begin
      grPrilohyView1.Controller.DeleteSelection;

      NastavFileButton;
      grPrilohyView1.Controller.ClearSelection;
      if grPrilohyView1.ViewData.RecordCount>0 then begin
        grPrilohyView1.ViewData.Records[0].Focused := True;
        grPrilohyView1.Controller.FocusedRecord.Selected := True;
      end;
    end;
  end;
end;

