      {$ELSE STANDALONE}
      btUlozitAdresu.Visible:=TRUE;
      btUlozitAdresuO.Visible:=TRUE;
      btVybratAdresu.Visible:=TRUE;
      {$ENDIF STANDALONE}
      if AOdeslana then begin
        Caption:='Datová schránka - odeslaná zpráva';
        btUlozitAdresuO.Visible := True;
        btUlozitAdresu.Visible := False;
      end
      else begin
        Caption:='Datová schránka - přijatá zpráva';
        btUlozitAdresu.Visible := True;
        btUlozitAdresuO.Visible := False;
      end;
      
      FTest:=ATest;
      FJmeno:=AJmeno;
      FHeslo:=AHeslo;
      FCertif:=ACertif;
      if AOnlySaveToDoc then
        SetToDoc
      else
        ShowModal;
      if FPrepareNewMessage then begin
        IDDSPrijemce:=FIDDSPrijemce;
        IDDSOdesilatele:=FIDDSOdesilatele;
        Prijemce:=FPrijemce;
        Odesilatel:=FOdesilatel;
        Vec:=FVec;
        NaseCisloJednaci:=FCisloJednaciNase;
        NaseZnacka:=FSpZnackaNase;
        VaseCisloJednaci:=FCisloJednaciVase;
        VaseZnacka:=FSpZnackaVase;
        PrepareNewMessage:=FPrepareNewMessage;
        Soubory:=FSoubory;
        Test:=FTest;
        Jmeno:=FJmeno;
        Heslo:=FHeslo;
        Certif:=FCertif;
        Prihlasit:=FPrihlasit;
      end;
    end;
  finally
    fmDSZprava.Free;
    fmDSZprava:=nil;
  end;
  if PrepareNewMessage then
    PripravitOdpoved(AClientID, ADostupnyArchiv,
      Test, Jmeno, Heslo, Certif,Prihlasit,
      IDDSPrijemce, Prijemce, IDDSOdesilatele, Odesilatel, Vec,
      NaseCisloJednaci, NaseZnacka, VaseCisloJednaci, VaseZnacka,
      Soubory, AClientAndPar);
end; {OpenMessage}

procedure OpenMessageFromZip(AClientID: integer;
  const AFileName: string; const AClientAndPar: string;
  AWriteDoc2Adr: TProcWriteDoc2Adr;
  AFindDoc: TProcFindDoc);
var
  Jmeno, Heslo, Certif, IDDSPrijemce, IDDSOdesilatele, Prijemce, Odesilatel, Vec,
  NaseCisloJednaci, NaseZnacka, VaseCisloJednaci, VaseZnacka, Soubory: string;
  PrepareNewMessage, Test, Prihlasit: boolean;

begin
  fmDSZprava:=TfmDSZprava.Create(nil);
  try
    with fmDSZprava do begin
      FClientID:=AClientID;
      {$IFNDEF STANDALONE}
      FWriteDoc2Adr := AWriteDoc2Adr;
      FFindDoc := AFindDoc;
      {$ENDIF STANDALONE}
      FRezim:=cRezimZeSouboru;
      {$IFDEF STANDALONE}
      FDostupnyArchiv:=FALSE;
      {$ELSE STANDALONE}
      FDostupnyArchiv:=TRUE;
      {$ENDIF STANDALONE}
      FParams:=AClientAndPar;
      FPrihlasit:=TRUE;
      RozbalZpravu(AFileName);

      ShowModal;

      if FPrepareNewMessage then begin
        IDDSPrijemce:=FIDDSPrijemce;
        IDDSOdesilatele:=FIDDSOdesilatele;
        Prijemce:=FPrijemce;
        Odesilatel:=FOdesilatel;
        Vec:=FVec;
        NaseCisloJednaci:=FCisloJednaciNase;
        NaseZnacka:=FSpZnackaNase;
        VaseCisloJednaci:=FCisloJednaciVase;
        VaseZnacka:=FSpZnackaVase;
        PrepareNewMessage:=FPrepareNewMessage;
        Soubory:=FSoubory;

        Test:=StrToBoolSafe(GetStringLineValue(AClientAndPar, cISDS1TestBox));
        Jmeno:=GetStringLineValue(AClientAndPar, cISDS1UsrId);
        Heslo:=GetStringLineValue(AClientAndPar, cISDS1Pswd);
        Certif :=GetStringLineValue(AClientAndPar, cISDS1Cert);
        
        Prihlasit:=FPrihlasit;
      end;
    end;
  finally
    fmDSZprava.Free;
    fmDSZprava:=nil;
  end;
  if PrepareNewMessage then
    PripravitOdpoved(AClientID, FALSE, Test, Jmeno, Heslo, Certif,Prihlasit,
      IDDSPrijemce, Prijemce, IDDSOdesilatele, Odesilatel, Vec,
      NaseCisloJednaci, NaseZnacka, VaseCisloJednaci, VaseZnacka, Soubory,
      AClientAndPar);
end;

//vraci true pokud uzivatel zpravu odeslal
function NewMessage(AClientID: integer;
  ADostupnyArchiv: boolean;
  ATest: boolean; const AJmeno, AHeslo, ACertif:string;
  APrihlasit:Boolean;
  AIDDSPrijemce, APrijemce, AIDDSOdesilatele, AOdesilatel, AVec,
  ACisloJednaciNase, ASpZnackaNase, ACisloJednaciVase, ASpZnackaVase,
  ASeznamSouboru: string; AFormID: integer;
  const AClientAndPar: string;
  AIsOdpoved: Boolean = False): boolean;
begin
  fmDSZprava:=TfmDSZprava.Create(nil);
  try
    with fmDSZprava do begin
      FClientID:=AClientID;
      FOdeslanaZprava:=TRUE;
      FDostupnyArchiv:=ADostupnyArchiv;
      FRezim:=cRezimNova;
      FTest:=ATest;
      FJmeno:=AJmeno;
      FHeslo:=AHeslo;
      FIDDSPrijemce:=AIDDSPrijemce;
      FIDDSOdesilatele:=AIDDSOdesilatele;
      FOdesilatel:=AOdesilatel;
      FPrijemce:=APrijemce;
      FVec:=AVec;
      FCisloJednaciNase:=ACisloJednaciNase;
      FSpZnackaNase:=ASpZnackaNase;
      FCisloJednaciVase:=ACisloJednaciVase;
      FSpZnackaVase:=ASpZnackaVase;
      FSoubory:=ASeznamSouboru;
      FFormID:=AFormID;
      FPrihlasit:=APrihlasit;
      FCertif:=ACertif;
      FParams:=AClientAndPar;
      FSent:=false;
      FIsOdpoved:=AIsOdpoved;
      gLastSentIDDS:='';
      gLastSentDateDS:='';
      ShowModal;
      Result:=FSent;
    end;
  finally
    fmDSZprava.Free;
    fmDSZprava:=nil;
  end;
end; {NewMessage}

function DSNewMessage(AClientID: integer;
  ADostupnyArchiv: boolean;
  const AClientAndPar: string;
