procedure TfmDSZprava.FormActivate(Sender: TObject);
var
  sl, slOdes: TStringList;
  res, i, p: integer;
begin
  if FRezim=cRezimOtevreni then begin //Otevreni
    SetFields;
    if StrToBoolSafe(GetStringLineValue(FParams, cSave2DocPodaniPril)) then
      UlozZpravuDoDokumentu(res);
    grPrilohy.SetFocus;
  end
  else if FRezim=cRezimNova then begin //Nova zprava
    btUlozitAdresu.Enabled:=FALSE;
    if FParams<>'' then begin
      sl:=TStringList.Create;
      try
        sl.Text:=FParams;
        cbOdesilatel.Properties.Items.Clear;
        if sl.Values[cISDS1UsrId]<>'' then begin
          if (sl.Values[cISDS2UsrId]='') and (sl.Values[cISDS3UsrId]='') then begin
            if FOdesilatel<>'' then
              cbOdesilatel.Properties.Items.Add(FOdesilatel)
            else
              cbOdesilatel.Properties.Items.Add(sl.Values[cISDS1Name]+
              ' [UID1: '+sl.Values[cISDS1UsrId]+'] (IDDS: '+sl.Values[cISDS1IdDs]+')');
            if FIDDSOdesilatele<>'' then
              edIDDSOdesilatele.Text:=FIDDSOdesilatele
            else
              edIDDSOdesilatele.Text:=sl.Values[cISDS1IdDs];
            if edIDDSOdesilatele.Text='' then
              MessageWarn(Caption, 'V nastavení klienta není zadané ID datové schránky. Doporučujeme zadat ID datové schránky v nastavení klienta.', [MBOK]);
            //Pokud je odesilatel stejny jako prijemce, tak prijemce vyprazdnime
            if sl.Values[cISDS1IdDs]=FIDDSPrijemce then begin
              FIDDSPrijemce:='';
              FPrijemce:='';
            end;
          end
          else begin
            if sl.Values[cISDS1Name]<>'' then
              cbOdesilatel.Properties.Items.Add(sl.Values[cISDS1Name]+
              ' [UID1: '+sl.Values[cISDS1UsrId]+'] (IDDS: '+sl.Values[cISDS1IdDs]+')')
            else
              cbOdesilatel.Properties.Items.Add(FOdesilatel+
              ' [UID1: '+sl.Values[cISDS1UsrId]+'] (IDDS: '+sl.Values[cISDS1IdDs]+')');
          end;
        end;

        if sl.Values[cISDS2UsrId]<>'' then begin
          if sl.Values[cISDS2Name]<>'' then
            cbOdesilatel.Properties.Items.Add(sl.Values[cISDS2Name]+
            ' [UID2: '+sl.Values[cISDS2UsrId]+'] (IDDS: '+sl.Values[cISDS2IdDs]+')')
          else
            cbOdesilatel.Properties.Items.Add('Oprávněná osoba'+
            ' [UID2: '+sl.Values[cISDS2UsrId]+'] (IDDS: '+sl.Values[cISDS2IdDs]+')');
        end;

        if sl.Values[cISDS3UsrId]<>'' then begin
          if sl.Values[cISDS3Name]<>'' then
            cbOdesilatel.Properties.Items.Add(sl.Values[cISDS3Name]+
            ' [UID3: '+sl.Values[cISDS3UsrId]+'] (IDDS: '+sl.Values[cISDS3IdDs]+')')
          else
            cbOdesilatel.Properties.Items.Add('Uživatel'+
            ' [UID3: '+sl.Values[cISDS3UsrId]+'] (IDDS: '+sl.Values[cISDS3IdDs]+')');
        end;

        //19.12.2023 (Marek)
        //Pokusime se najit odesilatele
        //(nebude fungovat, pokud je odesilatelem "opravnena osoba" (a pravdepodobne i "uživatel") v pripade,
        // ze v nastaveni programu, resp v nastaveni uzivatelu, neni zadano IDDS)
        //6.2.2024 (Marek)
        //Vyhledani odesilatele se nyni provadi jen pri "Odpovedet" a "Predat"
        //(zarazena nova promenna FIsOdpoved,
        // ktera se nastavuje v procedure NewMessage dle parametru AIsOdpoved)
        if cbOdesilatel.Properties.Items.Count>=1 then begin
          if FIsOdpoved and ((FIDDSOdesilatele <> '') or (FOdesilatel <> '')) then begin
            slOdes:=TStringList.Create;
            try
              slOdes.Text := cbOdesilatel.Properties.Items.Text;
              for i := 0 to slOdes.Count - 1 do begin
                if ((FIDDSOdesilatele <> '') and (Pos(FIDDSOdesilatele, slOdes[i]) > 0)) or
                   ((FOdesilatel <> '') and (Pos(FOdesilatel, slOdes[i]) > 0)) then begin
                  cbOdesilatel.Text:=cbOdesilatel.Properties.Items[i];
                  Break;
                end;
              end;
            finally
              slOdes.Free;
            end;
          end;
          if cbOdesilatel.Text = '' then          
            cbOdesilatel.Text:=cbOdesilatel.Properties.Items[cbOdesilatel.Properties.Items.Count-1];
        end;
      finally
        sl.Free;
      end;
    end
    else begin
      cbOdesilatel.Properties.Items.Add(FOdesilatel);
      cbOdesilatel.Text:=FOdesilatel;
      edIDDSOdesilatele.Text:=FIDDSOdesilatele;
    end;

    edIDDSPrijemce.Text:=FIDDSPrijemce;
    edPrijemce.Text:=FPrijemce;
    edVec.Text:=FVec;
    edNaseCisloJednaci.Text:=FCisloJednaciNase;
    edNaseZnacka.Text:=FSpZnackaNase;
    edVaseCisloJednaci.Text:=FCisloJednaciVase;
    edVaseZnacka.Text:=FSpZnackaVase;

    sl:=TStringList.Create;
    try
      sl.CommaText:=FSoubory;
      for i:=0 to sl.Count-1 do begin
        p:=Pos('|',sl[i]); // novy oddelovac
        if p<=0 then
          p:=Pos('=',sl[i]); //puvodni oddelovac
        taPrilohy.Append;
        if p>0 then begin
          taPrilohySoubor.Value:=Replace('"',Copy(sl[i],1,p-1),'');
          taPrilohyCesta.Value:=Replace('"',Copy(sl[i],p+1,maxint),'');
        end
        else begin
          taPrilohySoubor.Value:=Replace('"',ExtractFileName(sl[i]),'');
          taPrilohyCesta.Value:=Replace('"',sl[i],'');
        end;
        if taPrilohySoubor.Value<>'' then
          taPrilohy.Post
        else
          taPrilohy.Cancel;
      end;
      taPrilohy.First;
      if grPrilohyView1.ViewData.RecordCount>0 then begin
        grPrilohyView1.ViewData.Records[0].Focused := True;
        grPrilohyView1.Controller.FocusedRecord.Selected := True;
      end;
    finally
      sl.Free;
    end;

    NastavFileButton;
    edIDDSPrijemce.SetFocus;
  end
  else begin
    NastavFileButton;
    grPrilohy.SetFocus;
  end;

  NastavControls(not FOdeslanaZprava, FRezim=cRezimNova);
end;

