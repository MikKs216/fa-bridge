procedure TfmDSZprava.OdesliZpravu;
var
  fileList, idList, idds, msg: string;
  retCode, retMsg, res, msgID: WideString;
  ISDSManager: TISDSManager;
  resC, i, siz: integer;
  vysledek,retCode2,retMsg2: WideString;
  udalosti: string;
  p, pZ: integer;
  d: TDateTime;
begin
  if taPrilohy.RecordCount=0 then begin
    MessageWarn(Caption, 'Zpráva nemůže být odeslána protože neobsahuje žádnou přílohu. '+
      'Nejprve vložte soubor(y) do příloh.', [MBOK]);
    EXIT;
  end;
  //kontrola velikosti priloh
  taPrilohy.DisableControls;
  try
    taPrilohy.First;
    siz:=0;
    while not taPrilohy.EOF do begin
      siz:=siz+FileGetSize(taPrilohyCesta.Value);
      taPrilohy.Next;
    end;
    if siz>cPrilohyMaxVel then begin //10485760 10 MB
      MessageWarn(Caption, 'Velikost vložených souborů je větší než povolený limit. Vložte soubory do maximální velikosti 20 MB. ', [MBOK]);
      EXIT;
    end;
  finally
    taPrilohy.EnableControls;
  end;

  if edIDDSPrijemce.Text='' then begin
    MessageWarn(Caption, 'Není zadán příjemce - ID datové schránky. Zprávu nelze odeslat.', [MBOK]);
    EXIT;
  end;

  if FTest then
    MessageWarn(Caption, 'Jste přihlášen(a) ke zkušební datové schránce. '+
      'Zpráva bude odeslaná na testovací server.', [MBOK]);

  if taPrilohy.RecordCount>1 then begin
    taPrilohy.DisableControls;
    try
      taPrilohy.First;
      while not taPrilohy.EOF do begin
        fileList:=fileList + taPrilohyCesta.Value + #13;
        taPrilohy.Next;
      end;
      fileList:=StrTrimCharRight(fileList,#13);
      taPrilohy.First;
    finally
      taPrilohy.EnableControls;
    end;
  end
  else if taPrilohy.RecordCount=1 then
    fileList:=taPrilohyCesta.Value;

  if TestAndRegisterISDSManager(TRUE, msg) then begin
    ISDSManager:= TISDSManager.Create(nil);
    try
      idList:=Replace(';',edIDDSPrijemce.Text,',');
      if Pos(',',idList)=0 then begin
        if MessageAsk(Caption, 'Odeslat zprávu do datové schránky?',
          [MBYES, MBNO])=MRYES then begin
          StartW('Probíhá odesílání zprávy ...');
          try

{    function OdesliZpravu(test: WordBool; const jmeno: WideString; const heslo: WideString;
                          const certifikat: WideString; prihlasit: WordBool;
                          const schrankaPrijemce: WideString; const anotace: WideString;
                          substDelivery: WordBool; legalTitleLaw: Integer;
                          const legalTitlePar: WideString; const legalTitlePoint: WideString;
                          const legalTitleSect: WideString; legalTitleYear: Integer;
                          const recipientIdent: WideString; const recipientOrgUnit: WideString;
                          recipientOrgUnitNum: Integer; const recipientRefNumber: WideString;
                          const senderIdent: WideString; const senderOrgUnit: WideString;
                          senderOrgUnitNum: Integer; const senderRefNumber: WideString;
                          const toHands: WideString; personalDelivery: WordBool; ovm: WordBool;
                          const fileList: WideString; out sendMessageID: WideString;
                          out retCode: WideString; out retMsg: WideString): WordBool; safecall;
 }


            if ISDSManager.OdesliZpravu(FTest, FJmeno, FHeslo,FCertif,FPrihlasit, idList,
              edVec.Text,
              not cbZakazatDoruceniFikci.Checked, StrToIntSafe(edZmocneniZakon.Text),
                edZmocneniOdstavec.Text,edZmocneniPismeno.Text,edZmocneniParagraf.Text,
                StrToIntSafe(edZmocneniRok.Text),edVaseZnacka.Text,'',-1,edVaseCisloJednaci.Text,
                edNaseZnacka.Text,'',-1,edNaseCisloJednaci.Text,edKRukam.Text,
                cbDoVlastnichRukou.Checked,FALSE,fileList,msgID,retCode,retMsg) then begin
              FSent:=True;
              edIDZPravy.Text:=msgID;
              btOdeslatZPravu.Enabled:=FALSE;
              //12.4.2023 (Marek)
              //- IDDS odesilatele a cas podani se nyni natahuji z dorucenky
              //- #5201 - IDDS odesilatele se nyni "propise" i do Sterea
              gLastSentDateDS := FormatDateTime('dd.mm.yyyy hh:nn:ss',Now);
              if ISDSManager.StahniDorucenku(FTest,FJmeno,FHeslo,FCertif,FPrihlasit,msgID,
                vysledek,retCode2,retMsg2) then begin
                udalosti:=GetCsvFieldByName(vysledek,'Udalosti', 1);
                p := Pos(';EV0:', udalosti);
                if p>0 then begin
                  pZ := p;
                  repeat
                    Dec(pZ);
                  until (Copy(udalosti,pZ,1)='#') or (pZ=1);
                  udalosti := Copy(udalosti, pZ , p-1);
                  if TryStrToDateTime(udalosti, d) then
                    gLastSentDateDS := udalosti;
                end;
                gLastSentIDDS:=idList+' [z '+GetCsvFieldByName(vysledek,'OdesilIDSchr', 1)+']'+' ('+msgID+')';
              end
              //stav pred 12.4.2023 (Marek)
              else begin
                {$IFDEF STANDALONE}
                gLastSentIDDS:=idList+' ('+msgID+')';
                {$ELSE STANDALONE}
                gLastSentIDDS:=idList+' [z '+edIDDSOdesilatele.Text+']'+' ('+msgID+')'; //nastaveno 12.12.2016 podle pozadavku z hotline
                {$ENDIF STANDALONE}
              end;
              {zruseno 12.12.2016 podle pozadavku z hotline
              if (edIDDSOdesilatele.Text<>GetStringLineValue(FParams, cISDS1IdDs)) then
                gLastSentIDDS:=idList+' [z '+edIDDSOdesilatele.Text+']'+' ('+msgID+')'
              else
                gLastSentIDDS:=idList+' ('+msgID+')';
                }
              {$IFNDEF STANDALONE}
              if StrToBoolSafe(GetStringLineValue(FParams, cSave2DocPodani)) and //cSave2DocPodani ... ukladat do archivu odesilane formulare
                ((edIDDSOdesilatele.Text=GetStringLineValue(FParams, cISDS1IdDs)) or
                 (GetStringLineValue(FParams, cISDS1IdDs)='')) then
                UlozZpravuDoDokumentu(resC);
              {$ENDIF STANDALONE}
              MessageInfo(Caption,'Zpráva byla odeslána',[MBOK]);
            end
            else begin
              if CheckMsgUnauthorized(retMsg) then
                MessageErr(Caption, 'Chyba při přihlášení k datové schránce. Nesprávné přihlašovací údaje.', [MBOK])
              else
                MessageErr(Caption, 'Chyba při odesílání zprávy, '+ retCode + ': ' + retMsg, [MBOK]);
            end;
          finally
            StopW;
          end;
        end;
      end
      else begin
        if MessageAsk(Caption, 'Je zadáno více příjemců, zpráva bude odeslána samostatně každému z nich. Chcete odeslat zprávu více příjemcům?',
          [MBYES, MBNO]) = MRYES then begin
          if CountListItems(idList)>0 then begin
            for i:=0 to CountListItems(idList)-1 do begin
              idds:=GetListItem(idList,i);
              StartW('Probíhá odesílání zprávy '+IntToStr(i+1)+'. příjemci ...');
              try
                if ISDSManager.OdesliZpravu(FTest, FJmeno, FHeslo, FCertif,FPrihlasit, idds,
                  edVec.Text,
                  not cbZakazatDoruceniFikci.Checked, StrToIntSafe(edZmocneniZakon.Text),
                    edZmocneniParagraf.Text,edZmocneniOdstavec.Text,edZmocneniPismeno.Text,
                    StrToIntSafe(edZmocneniRok.Text),edVaseZnacka.Text,'',-1,edVaseCisloJednaci.Text,
                    edNaseZnacka.Text,'',-1,edNaseCisloJednaci.Text,edKRukam.Text,
                    cbDoVlastnichRukou.Checked,FALSE,fileList,msgID,retCode,retMsg) then begin
                  edIDZPravy.Text:=msgID;
                  btOdeslatZPravu.Enabled:=FALSE;
                  {$IFNDEF STANDALONE}
                  if StrToBoolSafe(GetStringLineValue(FParams, cSave2DocPodani)) and //cSave2DocPodani ... ukladat do archivu odesilane formulare
                    ((edIDDSOdesilatele.Text=GetStringLineValue(FParams, cISDS1IdDs)) or
                     (GetStringLineValue(FParams, cISDS1IdDs)='')) then
                    UlozZpravuDoDokumentu(resC);
                  {$ENDIF STANDALONE}
                end
                else begin
                  if CheckMsgUnauthorized(retMsg) then
                    MessageErr(Caption, 'Chyba při přihlášení k datové schránce. Nesprávné přihlašovací údaje.', [MBOK])
                  else
                    MessageErr(Caption, 'Chyba při odesílání zprávy, '+ retCode + ': ' + retMsg, [MBOK]);
                end;
              finally
                StopWait;
                sb1.Panels[1].Text:='Zpráva byla odeslána';
                Refresh;
              end;
              MessageInfo(Caption,'Odeslání bylo dokončeno',[MBOK]);
            end;
          end;
        end;
      end;
    finally
      ISDSManager.Free;
      StopWait;
    end;
  end
  else
    Close;
end;

function TfmDSZprava.ShowOpenFileDialog(const AFilter, ADefaultExt: string;
  AMultiLine: boolean; out AFiles: string): boolean;
begin
  if AMultiLine then
    OpenDialog1.Options := OpenDialog1.Options + [ofAllowMultiSelect]
  else
    OpenDialog1.Options := OpenDialog1.Options - [ofAllowMultiSelect];
  OpenDialog1.DefaultExt := ADefaultExt;
  OpenDialog1.Filter := AFilter;
  Result:=OpenDialog1.Execute;
  if Result then
    AFiles:=OpenDialog1.Files.Text
  else
    AFiles:='';
end;


procedure TfmDSZprava.AttachmentTestSize;
var
  siz: integer;
begin
  taPrilohy.DisableControls;
  try
    taPrilohy.First;
    siz:=0;
    while not taPrilohy.EOF do begin
      siz:=siz+FileGetSize(taPrilohyCesta.Value);
      taPrilohy.Next;
    end;
    if siz>cPrilohyMaxVel then
      MessageWarn(Caption, 'Velikost vložených souborů je větší než povolený limit. Vložte soubory do maximální velikosti 20 MB. ', [MBOK]);
  finally
    taPrilohy.EnableControls;
  end;
end;

