//ulozi opis v PDF
procedure TfmDSZprava.UlozOpis(const AFileName: string);
var
  fnrtf: string;
  st: TMemoryStream;
  resol: Integer;
begin
  StartWait;
  st := TMemoryStream.Create;
  try try
    // PripravOpis(FALSE); tady to nesmi byt

    rvInfo.SaveRVFToStream(st, FALSE);
    st.Seek(0, soFromBeginning);
    RVReportHelper.RichView.LoadRVFFromStream(st);
    // nastaveni rozliseni
    resol:=GetDPIForPDFrender;
    gtPDFEngine.InputXRes:=resol;
    gtPDFEngine.InputYRes:=resol;

    //vlozeni fontu (https://www.gnostice.com/nl_article.asp?id=29&t=How_To_Selectively_)
    //gtPDFEngine.Preferences.EmbedTrueTypeFonts := etfFull;

    //
    gtPDFEngine.FileName := AFileName;
    gtRichViewInterface.RenderDocument(RVReportHelper);
    RVReportHelper.Clear;
  except
    on E: Exception do begin
      MessageErr(Caption, Format(sMsgErrUlozeniOpisuZpravy,[E.Message]), [MBOK]);
    end;
  end;
  finally
    st.Free;
    StopWait;
  end;
end;

//ulozi obsah zpravy v TXT pro zabaleni dszip
procedure TfmDSZprava.UlozObsah(const AFileName: string);
begin
  StartWait;
  try
    PripravOpis(FALSE);
    rvInfo.SaveText(AFileName, 80);
  finally
    StopWait;
  end;
end;

//sbali zpravu s prilohami do dszip souboru
function TfmDSZprava.SbalZpravu(const AZipName: string): boolean;
var
  dr, zfofile: string;
begin
  Result:=FALSE;
  StartWait;
  try
    dr:=DirWorkDSPath+'\zip';
    if DirectoryExists(dr) then
      if not TryDeleteDirectory(dr, False, 'Datová zpráva '+edIDZpravy.Text+' nebude uložena.') then
        Exit;

    ForceDirectories(dr);
    UlozObsah(dr+'\'+cIdDSFileName);

    zfofile := DirWorkDSPath+'\'+edIDZpravy.Text+'.zfo';
    if FileExists(zfofile) then
      FileCopy(zfofile, dr+'\'+edIDZpravy.Text+'.zfo',TRUE);

    taPrilohy.DisableControls;
    try
      taPrilohy.First;
      while not taPrilohy.EOF do begin
        FileCopy(taPrilohyCesta.Value,
          dr+'\'+ExtractFileName(taPrilohyCesta.Value),TRUE);
        taPrilohy.Next;
      end;
    finally
      taPrilohy.First;
      taPrilohy.EnableControls;
    end;
    Result:=ZipFile(dr+'\*.*', AZipName, 'Komprimované soubory zprávy z datové schránky', '');
  finally
    StopWait;
  end;
end;

function TfmDSZprava.RozbalZpravu(const AFileName: string): boolean;
var
  i: integer;
  sl: TStringList;
  ok: boolean;
begin
  Result:=FALSE;
  StartWait;
  sl:= TStringList.Create;
  try
    DelTree(DirWorkDSPath);
    Result:=UnZipFile(AFileName, DirWorkDSPath);
    if FileExists(DirWorkDSPath+'\'+cIdDSFileName) then begin
      sl.Text:=LoadStringFromFile(DirWorkDSPath+'\'+cIdDSFileName);
      cbOdesilatel.Properties.Items.Add(sl.Values[cIdOdesilatel]);
      cbOdesilatel.Text:=sl.Values[cIdOdesilatel];
      edIDDSOdesilatele.Text:=sl.Values[cIdISDSOdesilatel];
      edPrijemce.Text:=sl.Values[cIdPrijemce];
      edIDDSPrijemce.Text:=sl.Values[cIdISDSPrijemce];
      edVec.Text:=sl.Values[cIdVec];
      edZmocneniZakon.Text:=sl.Values[cIdZmocneniZakon];
      edZmocneniRok.Text:=sl.Values[cIdZmocneniRok];
      edZmocneniParagraf.Text:=sl.Values[cIdZmocneniParagraf];
      edZmocneniOdstavec.Text:=sl.Values[cIdZmocneniOdstavec];
      edZmocneniPismeno.Text:=sl.Values[cIdZmocneniPismeno];
      edNaseCisloJednaci.Text:=sl.Values[cIdNaseCisloJednaci];
      edNaseZnacka.Text:=sl.Values[cIdNaseSpisovaZnacka];
      edVaseCisloJednaci.Text:=sl.Values[cIdVaseCisloJednaci];
      edVaseZnacka.Text:=sl.Values[cIdVaseSpisovaZnacka];
      edKRukam.Text:=sl.Values[cIdKRukam];
      cbDoVlastnichRukou.Checked:=StrToBoolSafe(sl.Values[cIdDovlastnichRukou]);
      //cbZakazatDoruceniFikci.Checked:=StrToBoolSafe(sl.Values[cIdZakazanoDoruceniFikci]);
      edIDZpravy.Text:=sl.Values[cIdIDZpravy];
      edDodani.Text:=sl.Values[cIdDodano];
      edDoruceni.Text:=sl.Values[cIdDoruceno];
      FOdeslanaZprava:=StrToBoolSafe(sl.Values[cIdOdeslanaZprava]);
      ok:=FALSE;
      FMappingFiles:='';
      for i:=0 to sl.Count-1 do begin
        if ok and (sl[i]<>'') then begin
          taPrilohy.Append;
          taPrilohySoubor.Value:=sl[i];
          taPrilohyCesta.Value:=DirWorkDSPath+'\'+sl[i];
          if taPrilohySoubor.Value<>'' then
            taPrilohy.Post
          else
            taPrilohy.Cancel;
          FMappingFiles:=FMAppingFiles+sl[i]+'='+DirWorkDSPath+'\'+sl[i];
          if i<sl.Count-1 then
            FMappingFiles:=FMAppingFiles+#13#10;
        end
        else
          ok:= sl[i]=cIdSoubory;
      end;
    end;
  finally
    sl.Free;
    StopWait;
  end;
end;

