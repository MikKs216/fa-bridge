procedure TfmDSZprava.WMDROPFILES(var AMsg: TWMDROPFILES);
var
  files : LongInt;
  i : LongInt;
  buffer : array [0..255] of Char;
  idNewDoc, frmId: integer;
begin
  if btVlozitSoubor.Enabled then begin //jen u nove 
    files := DragQueryFile(AMsg.Drop, UINT (-1), nil, 0);

    taPrilohy.DisableControls;
    try
      for i := 0 to files - 1 do begin
        DragQueryFile(AMsg.Drop, i, @buffer, SizeOf(Buffer));
        AttachmentTestExt(ExtractFileExt(buffer));

        taPrilohy.Insert;
        taPrilohyCesta.AsString := buffer;
        taPrilohySoubor.AsString := ExtractFileName(buffer);
        taPrilohy.Post;
      end;
    finally
      taPrilohy.EnableControls;
    end;

    AttachmentTestSize;
    btSmazatSoubor.Enabled:=taPrilohy.RecordCount>0;
    NastavFileButton;
  end;
end;

end.
