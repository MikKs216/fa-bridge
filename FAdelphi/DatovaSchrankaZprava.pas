procedure TfmDSZprava.btVyhledatSchrankuClick(Sender: TObject);
var
  IDDS, nazevAdresata: string;
  zadano: boolean;
begin
  if (FJmeno='') or (FHeslo='') then begin
    zadano:=ZadejPrihlasovaciUdaje(FJmeno, FHeslo, FTest, FCertif);
    zadano:= zadano and (FJmeno<>'') and (FHeslo<>'');
  end
  else
    zadano:=TRUE;
  if zadano then begin
    IDDS:=HledejSchrankuSUlozenim(FTest, FJmeno, FHeslo,FCertif,FPrihlasit,
      nazevAdresata,FClientID);
    if IDDS<>'' then begin
      edIDDSPrijemce.Text:=StrTrimCharleft(edIDDSPrijemce.Text+','+IDDS,',');
      if edPrijemce.Text='' then begin
        edPrijemce.Text:=nazevAdresata;
        btUlozitAdresu.Enabled:=TRUE;
      end
      else begin
        edPrijemce.Text:='';
        btUlozitAdresu.Enabled:=TRUE;
      end;
    end;
    SetPrijemce;
  end
  else
    MessageInfo(Caption, 'Nebyly zadány přihlašovací údaje k datové schránce. Přihlášení nebylo provedeno.',[MBOK]);
end;

