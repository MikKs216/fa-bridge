procedure TfmDSZprava.NactiPrilohuOdKlienta;
var
  fnD, fnW, docRec: string;
  docId2: integer;
  drv, pth, fil, ext: string;
begin
  {$IFNDEF STANDALONE}
  if SelKlientDoc(FClientID, 'Vyberte dokument', 'Name,Path,Date,Comment', docRec) then begin
    docId2 := StrToIntSafe(GetStringLineValue(docRec, 'ID2'));
    if docId2>0 then begin
      fnD := GetDoc(FClientID, docId2);
      CreateDir(GetWorkPath); 
      fnW := GetUniqueFileName(GetWorkPath, ExtractFileName(fnD));
      if CopyFile(PChar(fnD), PChar(fnW), True) then begin
        PathExtractElements(fnW, drv, pth, fil, ext);
        ext:=LowerCase(ext);
        AttachmentTestExt(ext);
        //
        taPrilohy.Append;
        taPrilohySoubor.Value:=ExtractFileName(fnW);
        taPrilohyCesta.Value:=fnW;
        if taPrilohySoubor.Value<>'' then
          taPrilohy.Post
        else
          taPrilohy.Cancel;
      end;

      AttachmentTestSize;
      btSmazatSoubor.Enabled:=taPrilohy.RecordCount>0;
    end;
  end;

  if grPrilohyView1.ViewData.RecordCount>0 then begin
    grPrilohyView1.Controller.ClearSelection;
    grPrilohyView1.ViewData.Records[grPrilohyView1.ViewData.RecordCount-1].Focused := True;
    grPrilohyView1.Controller.FocusedRecord.Selected := True;
  end;
  NastavFileButton;
  {$ENDIF STANDALONE}
end;


