function TfmDSZprava.UlozZpravuDoDokumentu(out AResCode: integer): boolean;
{$IFNDEF STANDALONE}
var
  nam,pth,stav,slozka, typSlozky: string;
  deliveryTime: TDateTime;
{$ENDIF STANDALONE}
begin
  Result:=TRUE;
  AResCode := 0;
{$IFNDEF STANDALONE}
  if FDostupnyArchiv then begin
    nam:='zprava.dszip';
    pth := NormalPath(GfaMain.DirWorkPath) + nam;
    if SbalZpravu(pth) then begin
      if FOdeslanaZprava then begin
        stav:=SDSMsgStavO;
        slozka:=cDocumentFolderSentDS;
        typSlozky:=cTypeFolderSentDS;
      end
      else begin
        stav:=SDSMsgStavP;
        slozka:=cDocumentFolderRecDS;
        typSlozky:=cTypeFolderRecDS;
      end;
      if not FindDoc(FClientID,edIDZpravy.Text,slozka,typSlozky,deliveryTime) then begin { or (edIDZpravy.Text='') to bylo drive, nevim duvod}
        if WriteDoc2Adr(FClientID, nam, SDSMsgCap, SestavOpis,
          edVaseZnacka.Text,edIDZpravy.Text,DSStrToDateTime(edDodani.Text),stav,edKRukam.Text,
          not FOdeslanaZprava,edVec.Text,pth,FFormID,'',
          JoinCaptionDS(cbOdesilatel.Text,edIDDSOdesilatele.Text),
          JoinCaptionDS(edPrijemce.Text,edIDDSPrijemce.Text),
          DSStrToDateTime(edDoruceni.Text),slozka,typSlozky) = -1 then
          MessageWarn(Caption,
           'Zprávu '+edIDZpravy.Text+' se nepodařilo uložit do archivu dokmentů. Zkuste otevřít tuto zprávu a zkontrolovat, že se poté do dokumentů uloží nebo spusťte kontrolu datových schránek.', [MBOK]);
      end
      else begin
        Result:=FALSE;
        AResCode := 1;
      end;
    end
    else begin
      Result:=FALSE;
      AResCode := 2;
    end;
  end;
{$ENDIF STANDALONE}
end;

{function TfmDSZprava.DSStrToDateTime(const AStr: string): TDateTime;
var
  tf: TFormatSettings;
  dat, tim: TDateTime;
begin
  Result:=0;
  if edDoruceni.Text<>'' then begin
    tf.DateSeparator:='.';
    tf.TimeSeparator:=':';
    tf.ShortDateFormat:='d.M.yyyy';
    tf.LongDateFormat:='dd.MM.yyyy';
    tf.ShortTimeFormat:='H:m:s';
    tf.LongTimeFormat:='HH:mm:ss';
    try
      dat:=StrToDate(Copy(edDoruceni.Text,1,Pos(' ',AStr)-1),tf);
      tim:=StrToTime(Copy(edDoruceni.Text,Pos(' ',AStr)+1,maxint),tf);
      Result:=dat+tim;
    except
      Result:=0;
    end;
  end;
end;}

