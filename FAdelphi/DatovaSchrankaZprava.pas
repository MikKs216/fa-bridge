procedure TfmDSZprava.SetFields;
var
  sl: TStringList;
  i, p: integer;
  osVer: string;
begin
  StartWait;
  sl:=TStringList.Create;
  try
    cbOdesilatel.Properties.Items.Clear;
    cbOdesilatel.Properties.Items.Add(
      GetCsvFieldByName(FCsvMessageInfo,'Sender', 1) + ', ' +
      GetCsvFieldByName(FCsvMessageInfo,'SenderAddress', 1));
    cbOdesilatel.Text:=cbOdesilatel.Properties.Items[0];
    edPrijemce.Text:=GetCsvFieldByName(FCsvMessageInfo,'Recipient', 1) + ', ' +
      GetCsvFieldByName(FCsvMessageInfo,'RecipientAddress', 1);
    edVec.Text:=GetCsvFieldByName(FCsvMessageInfo,'Annotation', 1);
    edZmocneniZakon.Text:=GetCsvFieldByName(FCsvMessageInfo,'LegalTitleLaw', 1);
    if edZmocneniZakon.Text='0' then
      edZmocneniZakon.Text:='';
    edZmocneniRok.Text:=GetCsvFieldByName(FCsvMessageInfo,'LegalTitleYear', 1);
    if edZmocneniRok.Text='0' then
      edZmocneniRok.Text:='';
    edZmocneniParagraf.Text:=GetCsvFieldByName(FCsvMessageInfo,'LegalTitleSect', 1);
    edZmocneniOdstavec.Text:=GetCsvFieldByName(FCsvMessageInfo,'LegalTitlePar', 1);
    edZmocneniPismeno.Text:=GetCsvFieldByName(FCsvMessageInfo,'LegalTitlePoint', 1);
    edNaseCisloJednaci.Text:=GetCsvFieldByName(FCsvMessageInfo,'SenderRefNumber', 1);
    edNaseZnacka.Text:=GetCsvFieldByName(FCsvMessageInfo,'SenderIdent', 1);
    edVaseCisloJednaci.Text:=GetCsvFieldByName(FCsvMessageInfo,'RecipientRefNumber', 1);
    edVaseZnacka.Text:=GetCsvFieldByName(FCsvMessageInfo,'RecipientIdent', 1);
    edKrukam.Text:=GetCsvFieldByName(FCsvMessageInfo,'ToHands', 1);
    cbDoVlastnichRukou.Checked:=StrToBoolSafe(GetCsvFieldByName(FCsvMessageInfo,'PersonalDelivery', 1));
    //cbZakazatDoruceniFikci.Checked:=not StrToBoolSafe(GetCsvFieldByName(FCsvMessageInfo,'AllowSubstDelivery', 1));
    cbZakazatDoruceniFikci.Checked:=False; //tento udaj se nepouziva - neni ani na webu #1877
    edIDZpravy.Text:=GetCsvFieldByName(FCsvMessageInfo,'MsgID', 1);
    edDodani.Text:=GetCsvFieldByName(FCsvMessageInfo,'DeliveryTime', 1);
    edDoruceni.Text:=GetCsvFieldByName(FCsvMessageInfo,'AcceptanceTime', 1);
    edIDDSOdesilatele.Text:=GetCsvFieldByName(FCsvMessageInfo,'IDSender', 1);
    edIDDSPrijemce.Text:=GetCsvFieldByName(FCsvMessageInfo,'IDRecipient', 1);
    cbVODZ.Checked:=StrToBoolSafe(GetCsvFieldByName(FCsvMessageInfo,'VODZ', 1)); //#5716
    //
    sl.Text:=FMappingFiles;
    for i:=0 to sl.Count-1 do begin
      p:=Pos('|',sl[i]); //novy oddelovac
      if p<=0 then
        p:=Pos('=',sl[i]); //puvodni oddelovac
      taPrilohy.Append;
      taPrilohySoubor.Value:=Replace('"',Copy(sl[i],1,p-1),'');
      taPrilohyCesta.Value:=Replace('"',Copy(sl[i],p+1,maxint),'');
      if taPrilohySoubor.Value<>'' then
        taPrilohy.Post
      else
        taPrilohy.Cancel;
    end;
    taPrilohy.First;
    if grPrilohyView1.ViewData.RecordCount>0 then begin
      grPrilohyView1.ViewData.Records[0].Focused := True;
      grPrilohyView1.Controller.FocusedRecord.Selected := True;
    end;
    NastavFileButton;
    laBezSouboruInfo.Visible:=FOdeslanaZprava;
    paWarnOldSystem.Visible:=not FOdeslanaZprava and IsOldWindowsVersion(osVer);
    laVoDZ.Visible:=cbVODZ.Checked;
  finally
    StopWait;
    sl.Free;
  end;
end;

