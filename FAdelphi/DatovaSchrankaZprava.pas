procedure TfmDSZprava.UlozPrilohuDoDokumentu;
{$IFNDEF STANDALONE}
var
  i, n: integer;
  fn,stav, slozka, typSlozky: string;
{$ENDIF STANDALONE}
begin
{$IFNDEF STANDALONE}
  if FOdeslanaZprava then begin
    stav:='';
    slozka:=cDocumentFolderSentDS;
    typSlozky:=cTypeFolderSentDS;
  end
  else begin
    stav:='Přečteno';
    slozka:=cDocumentFolderRecDS;
    typSlozky:=cTypeFolderRecDS;
  end;

  if grPrilohyView1.Controller.SelectedRowCount=0 then
    grPrilohyView1.Controller.SelectAll;

  n:=0;
  for i:=0 to grPrilohyView1.ViewData.RecordCount-1 do begin
    if grPrilohyView1.ViewData.Records[i].Selected then
      n:=n+1;
  end;
  if n>0 then begin
    for i:=0 to grPrilohyView1.Controller.SelectedRowCount-1 do begin
      grPrilohyView1.Controller.SelectedRows[i].Focused:=TRUE;
      WriteDoc2Adr(FClientID,taPrilohySoubor.Value,'Soubor z datové schránky',SestavOpis,
        edVaseZnacka.Text,'IDDS'+edIDZpravy.Text,Date,stav,edKRukam.Text,not FOdeslanaZprava,
        edVec.Text+' ['+taPrilohySoubor.Value+']',taPrilohyCesta.Value,-1,'',
        JoinCaptionDS(cbOdesilatel.Text,edIDDSOdesilatele.Text),
        JoinCaptionDS(edPrijemce.Text,edIDDSPrijemce.Text),
        DSStrToDateTime(edDoruceni.Text),slozka,typSlozky);
      if grPrilohyView1.Controller.SelectedRowCount=1 then
        MessageInfo(Caption,'Soubor byl uložen do archivu dokumentů.', [MBOK])
      else
        MessageInfo(Caption,'Vybrané soubory byly uloženy do archivu dokumentů.', [MBOK]);
    end;
  end;
