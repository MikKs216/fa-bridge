procedure TfmDSZprava.PripravOpis(AProTisk: boolean);
var
  i: integer;
  vysledek,retCode,retMsg: WideString;
  msg, udalosti: string;
  ISDSManager: TISDSManager;
  sl, sl1: TStringList;
const
  br = '___________________________________________________________________________________________________';
begin
  StartWait;
  try
    rvInfo.Clear;
    if AproTisk then begin
      sl:=TStringList.Create;
      sl1:=TStringList.Create;
      try
        if TestAndRegisterISDSManager(TRUE, msg) then begin
          ISDSManager:= TISDSManager.Create(nil);
          try
           if ISDSManager.StahniDorucenku(FTest,FJmeno,FHeslo,FCertif,FPrihlasit,edIDZpravy.Text,
             vysledek,retCode,retMsg) then begin
             udalosti:=GetCsvFieldByName(vysledek,'Udalosti', 1);
             sl.Text:=Replace('#',udalosti,#13#10);
             for i:=0 to sl.Count - 1 do begin
               sl1.Add('- '+Copy(sl[i],1,Pos(';',sl[i])-1)+' '+Copy(sl[i],Pos(';',sl[i])+1,maxint));
               //sl1.Add(Copy(sl[i],Pos(';',sl[i])+1,maxint));
             end;
           end;
          finally
            ISDSManager.Free;
          end;
        end;
        //
        if sl1.Count>0 then
          rvInfo.AddNL('Opis datové zprávy - doručenka',1,0)
        else
          rvInfo.AddNL('Opis datové zprávy',1,0);
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Odesílatel: '+cbOdesilatel.Text+' (IDDS: '+edIDDSOdesilatele.Text+')',0,0);
        //rvInfo.AddNL('IDDS: '+edIDDSOdesilatele.Text,0,0);
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Příjemce: '+edPrijemce.Text+' (IDDS: '+edIDDSPrijemce.Text+')',0,0);
        //rvInfo.AddNL('IDDS: '+edIDDSPrijemce.Text,0,0);
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Věc: '+edVec.Text,2,0);
        rvInfo.AddNL(br,0,0);
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Datum a čas doručení: '+edDoruceni.Text,0,0);
        rvInfo.AddNL('Datum a čas dodání: '+edDodani.Text,0,0);
        rvInfo.AddNL('ID zprávy: '+edIDZpravy.Text,0,0);
        if edZmocneniZakon.Text<>'' then
          rvInfo.AddNL('Zmocnění: '+edZmocneniZakon.Text+ ' / '+
            edZmocneniRok.Text+ ' § '+edZmocneniParagraf.Text+
            ' odstavec '+edZmocneniOdstavec.Text+
            ' písmeno ' +edZmocneniPismeno.Text,0,0)
        else
          rvInfo.AddNL('Zmocnění:',0,0);
        rvInfo.AddNL('Naše číslo jednací: '+edNaseCisloJednaci.Text,0,0);
        rvInfo.AddNL('Naše spisová značka: '+edNaseZnacka.Text,0,0);
        rvInfo.AddNL('Vaše číslo jednací: '+edVaseCisloJednaci.Text,0,0);
        rvInfo.AddNL('Vaše spisová značka: '+edVaseZnacka.Text,0,0);
        rvInfo.AddNL('K rukám: '+edKRukam.Text,0,0);
        if cbDoVlastnichRukou.Checked then
          rvInfo.AddNL('Do vlastních rukou: Ano',0,0)
        else
          rvInfo.AddNL('Do vlastních rukou: Ne',0,0);
        //if cbZakazatDoruceniFikci.Checked then
          //rvInfo.AddNL('Zakázáno doručení fikcí',0,0);
        rvInfo.AddNL(br,0,0);
        rvInfo.AddNL('',0,0);
        if taPrilohy.RecordCount>0 then begin
          rvInfo.AddNL('Přiložené soubory:',2,0);
          taPrilohy.DisableControls;
          try
            taPrilohy.First;
            while not taPrilohy.EOF do begin
              rvInfo.AddNL('- '+ExtractFileName(taPrilohyCesta.Value),0,0);
              taPrilohy.Next;
            end;
          finally
            taPrilohy.EnableControls;
          end;
          rvInfo.AddNL(br,0,0);
          rvInfo.AddNL('',0,0);
        end;
        if sl1.Count>0 then begin
          rvInfo.AddNL('Události zprávy:',2,0);
          for i:= 0 to sl1.Count - 1 do
            rvInfo.AddNL(sl1[i],0,0);
          rvInfo.AddNL(br,0,0);
          rvInfo.AddNL('',0,0);
        end;
      finally
        sl.Free;
        sl1.Free;
      end;
    end
    else begin
      rvInfo.AddNL('Opis datové zprávy',1,0);
      rvInfo.AddNL('',0,0);
      rvInfo.AddNL(cIdOdesilatel+'='+cbOdesilatel.Text,0,0);
      rvInfo.AddNL(cIdISDSOdesilatel+'='+edIDDSOdesilatele.Text,0,0);
      rvInfo.AddNL(cIdPrijemce+'='+edPrijemce.Text,0,0);
      rvInfo.AddNL(cIdISDSPrijemce+'='+edIDDSPrijemce.Text,0,0);
      rvInfo.AddNL(cIdVec+'='+edVec.Text,2,0);
      rvInfo.AddNL(cIdZmocneniZakon+'='+edZmocneniZakon.Text,0,0);
      rvInfo.AddNL(cIdZmocneniRok+'='+edZmocneniRok.Text,0,0);
      rvInfo.AddNL(cIdZmocneniParagraf+'='+edZmocneniParagraf.Text,0,0);
      rvInfo.AddNL(cIdZmocneniOdstavec+'='+edZmocneniOdstavec.Text,0,0);
      rvInfo.AddNL(cIdZmocneniPismeno+'='+edZmocneniPismeno.Text,0,0);
      rvInfo.AddNL(cIdNaseCisloJednaci+'='+edNaseCisloJednaci.Text,0,0);
      rvInfo.AddNL(cIdNaseSpisovaZnacka+'='+edNaseZnacka.Text,0,0);
      rvInfo.AddNL(cIdVaseCisloJednaci+'='+edVaseCisloJednaci.Text,0,0);
      rvInfo.AddNL(cIdVaseSpisovaZnacka+'='+edVaseZnacka.Text,0,0);
      rvInfo.AddNL(cIdKRukam+'='+edKRukam.Text,0,0);
      rvInfo.AddNL(cIdDovlastnichRukou+'='+BoolToStr(cbDoVlastnichRukou.Checked),0,0);
      //rvInfo.AddNL(cIdZakazanoDoruceniFikci+'='+BoolToStr(cbZakazatDoruceniFikci.Checked),0,0);
      rvInfo.AddNL(cIdIDZpravy+'='+edIDZpravy.Text,0,0);
      rvInfo.AddNL(cIdDodano+'='+edDodani.Text,0,0);
      rvInfo.AddNL(cIdDoruceno+'='+edDoruceni.Text,0,0);
      rvInfo.AddNL(cIdOdeslanaZprava+'='+BoolToStr(FOdeslanaZprava),0,0);
      rvInfo.AddNL('',0,0);
      if taPrilohy.RecordCount>0 then begin
        rvInfo.AddNL(cIdSoubory,0,0);
        taPrilohy.DisableControls;
        try
          taPrilohy.First;
          while not taPrilohy.EOF do begin
            rvInfo.AddNL(ExtractFileName(taPrilohyCesta.Value),0,0);
            taPrilohy.Next;
          end;
        finally
          taPrilohy.EnableControls;
        end;
      end;
    end;
    rvInfo.Format;
  finally
    StopWait;
  end;
end;

