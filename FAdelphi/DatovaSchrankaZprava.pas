procedure TfmDSZprava.DoPrilSendEmail(AAll: boolean);

  function CalcEmail: string;
  var
    outDataAdr: string;
  begin
    Result := '';
  {$IFNDEF STANDALONE}
    if (FClientID>-1) and (SelKlientAdresy(FClientID, SSelectDS,
        'Description,Name,LastName,Email,City,Street', outDataAdr, saOnlyEmails, '')) then begin
      Result := GetStringLineValue(outDataAdr,'Email');
    end;
  {$ENDIF}
      if Result='' then
        Result := '@';
  end;
var
  email, errorMsg: string;
  sl: TStringList;
  bm: TBookmarkStr;
begin
  sl := TStringList.Create;
  try
    if not AAll then begin
      sl.Add(taPrilohyCesta.AsString);
      email := CalcEmail;
      FCommonUtils.SendEmail(email, Format(sMsgAppendixSubject,[ExtractFileName(taPrilohyCesta.AsString)]), '', sl, true, errorMsg);
    end
    else begin
      bm:=taPrilohy.Bookmark;
      try
        with taPrilohy do begin
          First;
          while not EOF do begin
            sl.Add(taPrilohyCesta.AsString);
            Next;
          end;
        end;
      finally
        taPrilohy.Bookmark:=bm;
      end;

      email := CalcEmail;
      FCommonUtils.SendEmail(email, sMsgAppendixAllSubject, '', sl, true, errorMsg);
    end;
  finally
    sl.Free;
  end;
end;


