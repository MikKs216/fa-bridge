//vraci true kdyz uzivatel odeslal pres datovou schranku a skutecne podani odeslal
function SendDSElFilling(const ADoc, AFormName: string): boolean;
var
  msg, fn, err, mailadr, comm, outfilename: string;
  sl: TStringList;
  sel: Boolean;
const
  eptxt = 'K - Typ písemnosti DADPIS nemůže být podán bez uznávaného elektronického podpisu.';
begin
  Result:=false;
  sl := TStringList.Create;
  try
    if TestToMF(ADoc,msg,fn) then begin
      GfaMain.FScriptFillingZip:=False; // musime zrusit zipovani protoze pres DS se posila XML
      sl.Text:=fn;

      comm := '';
      if GfaMain.mtValues.Active then begin
        comm := GetListItem(GfaMain.GetPeriod, 3) + ' ' + GfaMain.GetSysComment;
        if comm <> '' then
          comm := ', ' + comm;
      end;

      if msg='' then begin
        if StartCounterZero then
          EXIT;
        sel := GfaMain.SelectDS(mailadr);
        if sel then
          Result:=GfaMain.SendISDSOrEmail(mailadr,AFormName+comm,'',sl,TRUE,err,outfilename);
      end
      else begin
        msg:='Byly zjištěny následující chyby:'+#13#10#13#10+
          msg+#13#10'Chcete formulář takto odeslat přes datovou schránku?';
        if EpShowResult('Kontrola formuláře na serveru České daňové správy',msg,TRUE) then begin
          if StartCounterZero then
            EXIT;
          sel := GfaMain.SelectDS(mailadr);
          if sel then
            Result:=GfaMain.SendISDSOrEmail(mailadr,AFormName+comm,'',sl,TRUE,err,outfilename);
        end;
      end;
    end
    else begin
      //kdyz se posila podani obecne pisemnosti, vraci kontrola kritickou chybu ze nejde podat bez podpisu, coz u datove schranky nema vyznam
      GfaMain.FScriptFillingZip:=False; // musime zrusit zipovani protoze pres DS se posila XML
      sl.Text:=fn;
      if Pos(eptxt,msg)>0 then begin
        //pokud je to jedina chyba tak ignorujeme
        if Pos('2.',msg)=0 then begin
          if StartCounterZero then
            EXIT;
          sel := GfaMain.SelectEmail(mailadr);
          if sel then
            Result:=GfaMain.SendISDSOrEmail(mailadr,AFormName,'',sl,TRUE,err,outfilename);
        end
        // jinak zobrazime chyby a dovolime podat
        else begin
          msg:='Byly zjištěny následující chyby:'+#13#10#13#10+
            Replace(eptxt,msg,'')+#13#10'Chcete formulář takto odeslat přes datovou schránku?';
          if EpShowResult('Kontrola formuláře na serveru České daňové správy',msg,TRUE) then begin
            if StartCounterZero then
              EXIT;
            sel := GfaMain.SelectEmail(mailadr);
            if sel then
              Result:=GfaMain.SendISDSOrEmail(mailadr,AFormName,'',sl,TRUE,err,outfilename);
          end;
        end;
      end
      else begin
        msg:='Byly zjištěny tyto nepropustné chyby:'+#13#10#13#10+
          msg+#13#10'Formulář nelze s těmito chybami podat.';
        EpShowResult('Kontrola formuláře na serveru České daňové správy',msg,FALSE);
      end;
    end;
  finally
    sl.Free;
  end;
end; {SendDSElFilling}

function ExportElFilling(const ADoc: string; ASaveDialog: TSaveDialog;
  var OutFileName: string; AWithoutDialog: boolean = false): boolean;
var
  msg, fn, err: string;

  function ExpFilling(AWithoutDialog: boolean): boolean;
  var fn: string;
  begin
    Result:=False;
    try
      {$IFDEF FINALBUILD}
      if StartCounterZero then
        EXIT;
      {$ENDIF FINALBUILD}

      with ASaveDialog do begin
        FileName := OutFileName;
        if GfaMain.FPdfPassword<>'' then begin // budeme heslovat
          DefaultExt := cCompressedZipDefaultExt;
          Filter := cZIPOpenSaveFilter;
          FileName := ExtractFilePath(FileName)+Copy(ExtractFileName(FileName),1,Length(ExtractFileName(FileName))-Length(ExtractFileExt(FileName)))+cAppDuverne+cCompressedZipDefaultExt;
        end
        else begin
          DefaultExt := cXMLDefaultExt;
          Filter := cXMLEPOpenSaveFilter;
        end;
        EIInitSaveDlgExport(ASaveDialog, ClientParam('Description'));

        if AWithoutDialog or Execute then
          if not FileExists(FileName) or
            (MessageAsk('',
            Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then begin
              if GfaMain.FPdfPassword<>'' then begin
                fn:=GetUniqueFileName(GfaMain.DirWorkPath,ExtractFileName(ChangeFileExt(FileName,cXMLDefaultExt)));
                SaveStringToFile(Adoc, fn);
                if AWithoutDialog then
                  FileName := GetUniqueFileName(GfaMain.DirWorkPath,ExtractFileName(FileName));
                ZipFile(fn,FileName,'',GfaMain.FPdfPassword);
                DeleteFile(fn);
              end
              else
                SaveStringToFile(Adoc, FileName);
              OutFileName:=FileName;
              Result:=True;
            end;
      end;
    finally
      GfaMain.FPdfPassword:=''; // musime zajistit vyprazdneni
    end;
  end;

begin
  Result:=false;
  if TestToMF(ADoc,msg,fn) then begin
    GfaMain.FScriptFillingZip:=False; // musime zrusit zipovani protoze pres DS se posila XML
    if msg='' then begin
      Result:=ExpFilling(AWithoutDialog);
    end
    else begin
      msg:='Byly zjištěny následující chyby:'+#13#10#13#10+
        msg+#13#10'Chcete formulář takto vyexportovat?';
      if EpShowResult('Kontrola formuláře na serveru České daňové správy',msg,TRUE) then begin
        Result:=ExpFilling(AWithoutDialog);
      end;
    end;
  end
  else begin
    GfaMain.FScriptFillingZip:=False; // musime zrusit zipovani protoze pres DS se posila XML
    msg:='Byly zjištěny tyto nepropustné chyby:'+#13#10#13#10+
      msg+#13#10'Chcete formulář takto vyexportovat?';
    if EpShowResult('Kontrola formuláře na serveru České daňové správy',msg,TRUE) then begin
      Result:=ExpFilling(AWithoutDialog);
    end;
  end;
end; {ExportElFilling}

function FormatDate(const ADateStr: string): string;
begin
  Result:=StrTrimCharLeft(Copy(ADateStr,9,2),'0') + DateSeparator +
    StrTrimCharLeft(Copy(ADateStr,6,2),'0') + DateSeparator +
    Copy(ADateStr,1,4) + ' ' + Copy(ADateStr,12,8);
  //2004-08-03T10:26:29
end;

function FormatCheck(const AStr: string): string;
begin
  if Length(AStr)<>32 then
    Result:=AStr
  else
    Result:=Copy(AStr,1,5) + '-' + Copy(AStr,6,5) + '-' + Copy(AStr,11,5) + '-' +
      Copy(AStr,16,2) + '-' +
      Copy(AStr,18,5) + '-' + Copy(AStr,23,5) + '-' + Copy(AStr,28,5);
  //5441360bf6515e92674f93f968a1e558
end;

