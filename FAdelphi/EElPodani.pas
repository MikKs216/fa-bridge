procedure TfmElPodani.SaveFormStateToIni;
var iniFile: TRKSIniFile;

  function SettingsEpoToLog: string;

    function BoolToStr(value: Boolean): string;
    begin
      if value then
        Result := '1'
      else
        Result := '0';
    end;

    function EscapeValue(const value: string): string;
    begin
      // Pokud řetězec obsahuje čárku, tečku nebo dvojtečku, dej do uvozovek
      if (Pos(',', value) > 0) or (Pos('.', value) > 0) or (Pos(':', value) > 0) then
        Result := '"' + value + '"'
      else
        Result := value;
    end;

  var
    values: array[1..6] of string;
    i: Integer;
  begin
    try
      // Vytvoř pole hodnot v pořadí deklarace
      values[1] := BoolToStr(edProxyServer.Text <> '');
      values[2] := BoolToStr(edProxyPort.Text <> '');
      values[3] := BoolToStr(edEmail.Text <> '');
      values[4] := BoolToStr(cbTestovaci.Checked);
      values[5] := BoolToStr(cxOpenSSLSendMode.Checked);
      values[6] := IntToStr(seServerTimeOut.Value);

      // Vytvoř výsledný řetězec ve formátu 2xx:nn.hodnota,nn.hodnota,...
      Result := '';
      for i := 1 to 6 do
      begin
        Result := Result + Format('%d.%s', [i, values[i]]);
        if i < 6 then
          Result := Result + ',';
      end;
    except
    end;
  end;

begin
  LogStat('e3');
  LogStat('E3:' + SettingsEpoToLog, true);
  if not GfaMain.CanWriteToIniFile then EXIT;
  iniFile := TRKSIniFile.Create(GfaMain.GetIniFileName);
  try
    iniFile.WriteInteger(Name, 'Left', Left);
    iniFile.WriteInteger(Name, 'Top', Top);
    iniFile.WriteString(Name, 'ProxyServer', edProxyServer.Text);
    iniFile.WriteString(Name, 'ProxyPort', edProxyPort.Text);
    iniFile.WriteString(Name, 'Email', edEmail.Text);
    iniFile.WriteBool(Name, 'TestovaciPodani', cbTestovaci.Checked);
    iniFile.WriteBool(Name, 'OpenSSLSendMode', cxOpenSSLSendMode.Checked);
    iniFile.WriteInteger(Name, 'ServerTimeOut', seServerTimeOut.Value);
    if CbCertificates.Properties.Items.Count>0 then
      iniFile.WriteString(Name, 'CertificateHash',
      MFCRModule.Certificates.GetCertificateThumbprint(
      CbCertificates.ItemIndex));
  finally
    iniFile.Free;
  end;
end;

