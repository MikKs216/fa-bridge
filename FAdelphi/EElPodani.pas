      str:=GetFillingSubjectInfo(self,FDoc, 'c_ufo');
      if str<>'' then
        rvInfo.AddNL('Finančnímu úřadu: '+
          VarToStr(LstLookup('FU', Date, 'CisloFU',str,'Nazev')),3,0);
      str:=GetFillingSubjectInfo(self,FDoc,'dic');
      if str<>'' then
        rvInfo.AddNL('DIČ: CZ'+str,3,0);
      if GetFillingSubjectInfo(self,FDoc, 'rod_c')<>'' then
        rvInfo.AddNL('Rodné číslo: '+GetFillingSubjectInfo(self,FDoc, 'rod_c'),3,0);
      rvInfo.AddNL('Jméno, název: '+
        Trim(GetFillingSubjectInfo(self,FDoc, 'titul')+' '+
        GetFillingSubjectInfo(self,FDoc, 'jmeno')+' '+
        GetFillingSubjectInfo(self,FDoc, 'prijmeni')+' '+
        GetFillingSubjectInfo(self,FDoc, 'zkrobchjm')),3,0);
      rvInfo.AddNL('Ulice a číslo: '+GetFillingSubjectInfo(self,FDoc, 'ulice')+' '+
        GetFillingSubjectInfo(self,FDoc, 'c_pop'),3,0);
      rvInfo.AddNL('PSČ, obec: '+Trim(GetFillingSubjectInfo(self,FDoc, 'psc')+' '+
        GetFillingSubjectInfo(self,FDoc, 'naz_obce')),3,0);

      rvInfo.AddNL('',0,0);
      rvInfo.AddNL('Písemnost: '+GetFillingSubjectInfo(self,FDoc, 'k_uladis','VetaD')+' '+
          GFaMain.mtDefName.Value,3,0);
      rvInfo.AddNL('Identifikace zařízení: Spolecne technicke zarizeni spravcu dane',3,0);
      rvInfo.AddNL('Datum a čas podání: '+GFaMain.mtTskpFillingDate.Value,3,0);
      rvInfo.AddNL('Podací číslo, heslo: '+GFaMain.mtTskpFillingNumber.Value+', '+
        GFaMain.mtTskpFillingPassword.Value,3,0);
      p:=Pos(cCRLF,Replace(cCRLFAlternate,
        GFaMain.mtTskpFillingTimeStampSignature.Value,cCRLF));
      if p>0 then begin
        rvInfo.AddNL('Název souboru: '+
          Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,1,p-1),3,0);
        rvInfo.AddNL('Kontrolní číslo: '+
          Replace(cCRLF, Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,p+2,maxint), ', '),3,0);
      end
      else
        rvInfo.AddNL('Název souboru, kontrolní číslo: '+
          GFaMain.mtTskpFillingTimeStampSignature.Value,3,0);
      sl:=TStringList.Create;
      try
        sl.Text:=GfaMain.GetCharacteristics;
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Informace o dokumentu:',3,0);
        for j:=0 to sl.Count-1 do
          rvInfo.AddNL('  '+sl[j],3,0);
      finally
        sl.Free;
      end;
      rvInfo.AddNL('',0,0);
      rvInfo.Format;
    end
    else begin
      p:=Pos(cCRLF,Replace(cCRLFAlternate,
        GFaMain.mtTskpFillingTimeStampSignature.Value,cCRLF));
      rvInfo.Clear;
      rvInfo.AddNL('Opis potvrzení elektronického podání',1,0);
      rvInfo.AddNL('',0,0);
      rvInfo.AddNL('Formulář: '+GFaMain.mtDefName.Value,3,0);
      if p>0 then
        rvInfo.AddNL('Zdravotní pojišťovna: '+
          Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,1,p-1),3,0);
      rvInfo.AddNL('Datum a čas podání: '+GFaMain.mtTskpFillingDate.Value,3,0);
      rvInfo.AddNL('Podací číslo: '+GFaMain.mtTskpFillingNumber.Value,3,0);
      if p>0 then
        rvInfo.AddNL('Soubor: '+
          Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,p+2,maxint),3,0);
      sl:=TStringList.Create;
      try
        sl.Text:=GfaMain.GetCharacteristics;
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Informace o dokumentu:',3,0);
        for j:=0 to sl.Count-1 do
          rvInfo.AddNL('  '+sl[j],3,0);
      finally
        sl.Free;
      end;
      rvInfo.AddNL('',0,0);
      rvInfo.Format;
    end;
  end
  else if GFaMain.mtTskpFillingState.Value = cFillingStateFilledOffline then
    MessageInfo(Caption,'Formulář byl podán v režimu off-line, je potřeba dodatečně zjistit stav.',[MBOK])
  else
    MessageInfo(Caption,'Formulář nebyl dosud podán',[MBOK]);
end;

procedure TfmElPodani.btFunctionClick(Sender: TObject);
var
  oldAlignment: TPopupAlignment;
  p: TPoint;
begin
  Application.ProcessMessages;
  PostMessage(Handle, WM_KEYDOWN, VK_DOWN, 0);
  with PopupMenu1 do begin
    oldAlignment := Alignment;
    try
      //Alignment:=paRight;
      PopupComponent := nil;
      p := Panel1.ClientToScreen(Point(btFunction.Left,
        btFunction.Top + btFunction.Height));
      Popup(p.x, p.y);
    finally
      Alignment := oldAlignment;
    end;
  end;
end;

procedure TfmElPodani.miShowXMLClick(Sender: TObject);
begin
  if StartCounterZero then
