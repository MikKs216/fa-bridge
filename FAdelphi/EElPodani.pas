function TfmElPodani.GetCerfificateInfo: string;
var
  Cert: TCertificateWrapper;
begin
  if CbCertificates.Properties.Items.Count < 1 then
    begin
      // Pokud je combo box prazdny, nic se nezobrazuje
      Result := '';
    end
  else
    begin
      // Nacteni certifikatu z combo boxu do promenne
      Cert := TCertificateWrapper(CbCertificates.Properties.Items.Objects[CbCertificates.ItemIndex]);
      Result := cEPOfilled + ': ' +
        StrTrimCharRight(StrTrimCharRight(
        Cert.SerialNumber+', '+
        Cert.SubjectFieldCommonName + ', ' +
        Cert.SubjectOrganization,' '),',');
    end;
end;

// Zobrazeni detailu certifikatu na formular

procedure TfmElPodani.CerfificateComboDisplay;
var
  Cert: TCertificateWrapper;
begin
  if CbCertificates.Properties.Items.Count < 1 then
    begin
      // Pokud je combo box prazdny, nic se nezobrazuje
      LabelCertificate.Caption := '';
    end
  else
    begin
      // Nacteni certifikatu z combo boxu do promenne
      Cert := TCertificateWrapper(CbCertificates.Properties.Items.Objects[CbCertificates.ItemIndex]);
      // Zobrazeni nekterych hodnot
      LabelCertificate.Caption :=
       'Seriove cislo: ' + Cert.SerialNumber + #13#10 +
       'Subjekt: ' + Cert.SubjectFieldCommonName + #13#10 +
       'Organizace: '+ Cert.SubjectOrganization + #13#10 +
       'Vystavitel: ' + Cert.IssuerFieldCommonName + #13#10 +
       'Platnost od: ' + DateTimeToStr(Cert.ValidFromDate) + #13#10 +
       'Platnost do: ' + DateTimeToStr(Cert.ValidToDate) + #13#10;
    end;
end;

// Nacteni certifikatu do combo boxu

procedure TfmElPodani.CertificateComboLoad;
var
  CertCount: Integer;
  I, nSelect, DisplayIndex: Integer;
  org, validToStr, displayText: string;
  Cert: TCertificateWrapper;
begin
  StartWait;
  try
    nSelect:=-1;
    DisplayIndex:=0;
    // Pocet certifikatu
    CertCount := MFCRModule.Certificates.Count;
    // Smazani hodnot
    CbCertificates.Clear;
    if CertCount > 0 then
      begin
        // Pokud existuji nejake certifikaty, povolit combo box
        CbCertificates.Enabled := TRUE;
        // Nacteni pouze kvalifikovanych certifikatu
        for I := 0 to MFCRModule.Certificates.Count - 1 do begin
          Cert := MFCRModule.Certificates.Certificate(I);
          
          // Filtrovat jen kvalifikovane certifikaty
          if (not GfaMain.UseFCommAPI) or Cert.IsQualified then
          begin
            // Platnost do ve formatu (->2.6.2026)
            validToStr := FormatDateTime('d.m.yyyy', Cert.ValidToDate);
            validToStr := ' (do ' + validToStr + ')';
            
            // Sestaveni textu pro zobrazeni
            // Pokud je SubjectFieldCommonName stejne jako SubjectOrganization, nezobrazuj ho
            if Trim(Cert.SubjectFieldCommonName) <> '' then
            begin
              // Pokud je SubjectFieldCommonName stejne jako SubjectOrganization, zobraz jen organizaci
              if SameText(Trim(Cert.SubjectFieldCommonName), Trim(Cert.SubjectOrganization)) then
              begin
                // Jsou stejne - zobraz jen organizaci
                if Trim(Cert.SubjectOrganization) <> '' then
                  displayText := Cert.SubjectOrganization +
                                ' - ' +
                                Cert.IssuerFieldCommonName +
                                validToStr
                else
                  displayText := Cert.SubjectFieldCommonName +
                                ' - ' +
                                Cert.IssuerFieldCommonName +
                                validToStr;
              end
              else
              begin
                // Jsou ruzne - zobraz oba
                if Cert.SubjectOrganization<>'' then
                  org:=' - '+ Cert.SubjectOrganization
                else
                  org:='';
                displayText := Cert.SubjectFieldCommonName + org +
                              ' - ' +
                              Cert.IssuerFieldCommonName +
                              validToStr;
              end;
            end
            else if Trim(Cert.SubjectOrganization) <> '' then
              displayText := Cert.SubjectOrganization +
                            ' - ' +
                            Cert.IssuerFieldCommonName +
                            validToStr
            else
              displayText := Cert.SubjectName +
                            ' - ' +
                            Cert.IssuerFieldCommonName +
                            validToStr;
            
            CbCertificates.Properties.Items.AddObject(displayText, Cert);
            
            // Nastaveni vyberu podle posledniho nastaveneho
            if Cert.Thumbprint = FHash then
              nSelect := DisplayIndex;
            
            Inc(DisplayIndex);
          end;
        end;
        
        // Nastaveni vyberu podle posledniho nastaveneho nebo na prvni
        if nSelect >= 0 then
          CbCertificates.ItemIndex := nSelect
        else if CbCertificates.Properties.Items.Count > 0 then
          CbCertificates.ItemIndex := 0;
        // Zobrazeni prvniho certifikatu na formular
        //CerfificateComboDisplay;
      end
    else
      CbCertificates.Enabled := FALSE;
   //
   btShowCertificate.Enabled:=CbCertificates.Properties.Items.Count>0;
   btSend.Enabled:=CbCertificates.Properties.Items.Count>0;
   btAskState.Enabled:= 
   (CbCertificates.Properties.Items.Count>0) and ((edCislo.Text<>'') and (edHeslo.Text<>'')) and not cbTestovaciServer.Checked;
   finally
     btSave.Enabled:=TRUE;
     StopWait;
   end;
end;

procedure TfmElPodani.Init;
var
  doc: TStringList;
  i: integer;
  certLoaded: boolean;
  pth: string;
begin
  StartWait;
  //nastaveni pro podani na PZP
  if FTypDoc<>'' then begin
    Caption:=sMsgPZPCaption;
    edHeslo.Visible:=FALSE;
    laHeslo.Visible:=FALSE;
    cbTestovaciServer.Visible:=FALSE;
    btAskState.Visible:=FALSE;
    //
    cxGroupBox3.Enabled:=FALSE;
    Label8.Enabled:=FALSE;
    edEmail.Enabled:=FALSE;
    cxGroupBox1.Enabled:=FALSE;
    laProxyServer.Enabled:=FALSE;
    edProxyServer.Enabled:=FALSE;
    laProxyPort.Enabled:=FALSE;
    edProxyPort.Enabled:=FALSE;
    {$IFDEF ELPODANITEST}
    cbTestovaci.Visible:=TRUE;
    cxGroupBox1.Enabled:=TRUE;
    {$ELSE ELPODANITEST}
    cbTestovaci.Visible:=FALSE;
    cbTestovaci.Checked:=FALSE;
    {$ENDIF ELPODANITEST}
    //
    miShowXML.Visible:=FALSE;
  end;
  //
  MFCRModule.FPotvrzeni:='';
  miSavePotvrzeni.Enabled:=FALSE;
  cxPageControl1.ActivePage:=cxTabSheetFilling;
  mxStatusBar.Panels[0].Text := 'Probíhá vyhledávání certifikátů ...';
  Invalidate;
  Refresh;
  doc:=TStringList.Create;
  btPrint.Enabled:=FALSE;
  miSaveInfo.Enabled:=FALSE;
  btClose.Enabled:=FALSE;
  btAskState.Enabled:=TRUE;
  try
    {rvOpis.Clear;}
    doc.Text:=FDoc;
    if FTypDoc='' then
      doc.SaveToFile(NormalPath(GFaMain.DirWorkPath) + cElPodaniWorkFileName);
    miOdeslatDoDS.Visible:=FALSE; //FTypDoc=''; zruseno, je to sam volba v menu Soubor
    //jinak to ukladame az ve vlastnim podani, protoze potrebujeme ulozit do souboru urciteho jmena
    {for i:=0 to doc.Count-1 do
      rvOpis.AddNL(doc[i],0,0);
    rvOpis.Format;}
    //
    certLoaded:=FALSE;
    
    // Rozhodnuti podle UseFCommAPI
    if GfaMain.UseFCommAPI then
    begin
      // NOVA VARIANT: fcomm API
      // Zajistit dostupnost FComm API (synchronne - musime pockat)
      mxStatusBar.Panels[0].Text := 'Kontrola komunikačního modulu ...';
      Invalidate;
      Refresh;
      
      // Zajistit dostupnost fcomm API (synchronni kontrola)
      try
        GfaMain.EnsureFCommAPIAvailable(False);  // False = sync
      except
        on E: Exception do
        begin
          MessageErr(Caption, Format('Komunikacni modul fcomm.exe není dostupný: %s', [E.Message]),
            [MBOK]);
          EXIT;
        end;
      end;
      
      // API je dostupne - nacteni certifikatu
      try
        MFCRModule.CertificatesLoad;
        certLoaded:=TRUE;
      except
        on E: Exception do
        begin
          MessageErr(Caption, Format('Chyba při čtení certifikátů přes API: %s. Ukončete a znovu spusťte program.',
            [E.Message]), [MBOK]);
        end;
      end;
    end
    else
    begin
      // PUVODNI VARIANT: CAPICOM
      try
        MFCRModule.CertificatesLoad;
        certLoaded:=TRUE;
      except
        pth:=NormalPath(ExtractFilePath(Application.ExeName))+'capicom.dll';
        if FileExists(pth) then begin
          ShellExecute(Handle, nil, PChar('regsvr32'),
            PChar('/s "'+pth+'"'), nil,SW_SHOWNORMAL);
          Sleep(2000);
        end
        else begin
          MessageErr(Caption, 'Nenalezena knihovna capicom.dll. Problém patrně odstraníte reinstalací programu.',
            [MBOK]);
          EXIT;
        end;
        try
          MFCRModule.CertificatesLoad;
          certLoaded:=TRUE;
        except
          on E: EOleSysError do begin
            MessageErr(Caption, Format('Chyba při čtení certifikátů: %s. Příčinou může být chybějící knihovna capicom.dll. Zkuste spustit dávku comobjreg.bat v adresáři programu, zavřít dialog elektronického podání a zkusit el. podání znovu.',
              [E.Message]), [MBOK]);
          end;
        end;
      end;
    end;

    if certLoaded then begin
      CertificateComboLoad;
      //
      rvInfo.Clear;
      if CbCertificates.Properties.Items.Count<=0 then
        rvInfo.AddNL('Není k dispozici žádný kvalifikovaný certifikát pro podpis. Pro elektronické podání je potřeba mít nainstalovaný certifikát pro elektronický podpis.',0,0)
      else
        rvInfo.AddNL('Před odesláním dokumentu nebo zjištěním stavu podání musíte být připojeni na internet.',0,0);
      rvInfo.Format;
      //
      edCislo.Text:=GFaMain.mtTskpFillingNumber.Value;
      edHeslo.Text:=GFaMain.mtTskpFillingPassword.Value;
      edDatumOdeslani.Text:= GFaMain.mtTskpFillingDate.Value;

      if GFaMain.mtTskpFillingState.Value=cFillingStateFilled then
        lblStavPodani.Caption:='Podáno'
      else if GFaMain.mtTskpFillingState.Value=cFillingStateFilledOffline then begin
        lblStavPodani.Caption:='Offline';
        btAskState.Enabled:=FALSE;
      end
      else
        lblStavPodani.Caption:='';
      if edCislo.Text<>'' then begin
        if FTypDoc<>'' then //formular na PZP, neumoznuje dotaz na stav
          rvInfo.AddNL('Formulář byl již elektronicky podán '+
            GFaMain.mtTskpFillingDate.Value +
            '. Podací číslo je uvedeno v editačním poli vpravo.',0,0)
        else begin
          if GFaMain.mtTskpFillingState.Value=cFillingStateFilled then
            rvInfo.AddNL('Formulář byl již elektronicky podán '+
              GFaMain.mtTskpFillingDate.Value +
              '. Podací číslo je uvedeno v editačním poli vpravo. Tlačítkem "Zjistit stav podání" můžete zjistit stav podání.',0,0)
          else if GFaMain.mtTskpFillingState.Value=cFillingStateFilledOffline then
            rvInfo.AddNL('Formulář byl elektronicky podán v off-line režimu (nadlimitní velikost) '+
              GFaMain.mtTskpFillingDate.Value +
              '. Podací číslo je uvedeno v editačním poli vpravo. Až bude dostupná možnost zjištění stavu, ověřte stav podání tlačítkem  "Zjistit stav podání".',0,0)
        end;
        rvInfo.Format;
      end
      else if GFaMain.mtValues.ReadOnly then begin
        rvInfo.AddNL('Formulář je zamknutý nebo pouze pro čtení, nebude do něj možné uložit informace o podání.',0,0);
        rvInfo.Format;
      end;
    end
    else begin
      rvInfo.Clear;
      rvInfo.AddNL('Nepodařilo se načíst certifikát pro podpis.',0,0);
      rvInfo.Format;
    end;
  finally
    doc.Free;
    mxStatusBar.Panels[0].Text := '';
    btPrint.Enabled:=TRUE;
    miSaveInfo.Enabled:=TRUE;
    btClose.Enabled:=TRUE;
    StopWait;
  end;
end;

procedure TfmElPodani.btShowCertificateClick(Sender: TObject);
begin
  MFCRModule.Certificates.Display(CbCertificates.ItemIndex);
end;

procedure TfmElPodani.SendToMF;
var
  Errors: TReceiptErrors;
  I: Integer;
  RI: TReceiptInformation;
  workXMLFileName, workZIPFileName, workXMLPdpFileName, workXMLPtvFileName: string;
  sl,sl1: TStringList;
  j,k, fClientIDwork: integer;
  params, str, msg, msg1, fn: string;
  offline:Boolean;
  {IFNDEF STANDALONE}
  tmpFileName: string;
  fs: TFileStream;
  {ENDIF STANDALONE}
  DoSaveForm, doSend: Boolean;
begin
  DoSaveForm:=false;
  btPrint.Enabled:=FALSE;
  miSaveInfo.Enabled:=FALSE;
  btClose.Enabled:=FALSE;
  try
    if cbTestovaciServer.Checked then
      MessageWarn('', 'Podání bude provedeno na testovací server MF', [MBOK]);
    if cbTestovaci.Checked then
      MessageWarn('', 'Podání bude odesláno na server MF jako testovací, jen na kontrolu bez vlastního podání.', [MBOK]);

    if edCislo.Text<>'' then begin
      if MessageWarn(Caption, 'Formulář již byl elektronicky podán (pod číslem '+
        edCislo.Text+'). Chcete jej nyní odeslat na server MF znovu?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;
    if GFaMain.mtValues.ReadOnly then begin
      if MessageAsk(Caption,
      'Formulář je zamknutý nebo pouze pro čtení, nebude do něj možné uložit informace o podání. '+
      'Chcete přesto provést elektronické podání?',
      [MBYES, MBNO]) <> IDYES then
      EXIT;
    end
    else begin
      if MessageAsk(Caption, 'Chcete nyní odeslat formulář na server MF a tím provést elektronické podání?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;

    workXMLFileName := NormalPath(GFaMain.DirWorkPath) + cElPodaniWorkFileName;
    workXMLPdpFileName := NormalPath(GFaMain.DirWorkPath) + cElPodaniPdpWorkFileName;
    workXMLPtvFileName := NormalPath(GFaMain.DirWorkPath) + cElPodaniPtvWorkFileName;
    if FileExists(workXMLFileName) then begin
      rvInfo.Clear;

      rvInfo.AddNL('Probíhá kontrola dokumentu ...',0,0);
      rvInfo.Format;


      TestToMF(FDoc,msg,fn,false,cbTestovaciServer.Checked);
      if msg<>'' then begin
        msg1:='Byly zjištěny následující chyby:'+#13#10#13#10+
          msg+#13#10'Chcete formulář takto podat?';
        if not EpShowResult('Kontrola formuláře na serveru České daňové správy',msg1,TRUE) then begin
          rvInfo.Clear;
          rvInfo.AddNL('Podání bylo přerušeno. Dokument obsahuje chyby:',0,0);
          sl1:=TStringList.Create;
          sl1.Text:=msg;
          try
            for k := 0 to sl1.Count - 1 do
              rvInfo.AddNL(sl1[k],0,0);
          finally
            sl1.Free;
          end;
          rvInfo.Format;
          EXIT;
        end;
      end;

      rvInfo.Clear;
      rvInfo.AddNL('Probíhá odesílání dokumentu ...',0,0);
      rvInfo.Format;

      MFCRModule.ProxySettings.ProxyServer := EdProxyServer.Text;
      MFCRModule.ProxySettings.ProxyPort := StrToIntSafe(EdProxyPort.Text);
      MFCRModule.ServerTimeOut:=seServerTimeOut.Value;

      if GfaMain.FScriptFillingZip then begin
        workZIPFileName:=ChangeFileExt(workXMLFileName,'.zip');
        ZipFile(workXMLFileName,workZIPFileName,'');
      end;

      mxStatusBar.Panels[0].Text := 'Probíhá podepisování dokumentu ...';
      Invalidate;
      Refresh;
      try
      if GfaMain.FScriptFillingZip then
        MFCRModule.Certificates.SignDocument(CbCertificates.ItemIndex, workZIPFileName, workXMLPdpFileName)
      else
        MFCRModule.Certificates.SignDocument(CbCertificates.ItemIndex, workXMLFileName, workXMLPdpFileName);
      except
        on E: Exception do begin
          MessageErr(Caption, Format(sMsgErrSadaKlicuNeniDefinovana,[E.Message]), [MBOK]);
        end;
      end;

      mxStatusBar.Panels[0].Text := 'Probíhá odesílání dokumentu. Operace může trvat i několik minut, v závislosti na odzevě serveru. Čekejte ...';

      Invalidate;
      Refresh;

      GFaMain.mtTskp.Edit;
      GFaMain.mtTskpFillingNumber.Value := '';
      GFaMain.mtTskpFillingPassword.Value := '';
      GFaMain.mtTskpFillingURL.Value := '';
      GFaMain.mtTskpFillingState.Value := cFillingStateNone;
      GFaMain.mtTskpFillingTimeStampDate.Value := '';
      GFaMain.mtTskpFillingTimeStampSignature.Value := '';
      GFaMain.mtTskp.Post;
      GFaMain.SetChangeFlag(TRUE);

      params:='';
      if cbTestovaci.Checked and (Pos('@',edEmail.Text)>0) then
        params:='?test=1&email='+edEmail.Text
      else if cbTestovaci.Checked then
        params:='?test=1'
      else if Pos('@',edEmail.Text)>0 then
        params:='?email='+edEmail.Text;

      StartWait;
      fmElPodaniProgress:=EpProgressStart('Elektronické podání','Probíhá kontrola na serveru Finanční správy, vyčkejte prosím ...');
      offline:=False;
      try try
        Errors := MFCRModule.SendDocument(workXMLPdpFileName, workXMLPtvFileName, params, cbTestovaciServer.Checked,cxOpenSSLSendMode.Checked);
      finally
        fClientIDwork := GfaMain.FClientID;
        EpProgressStop(fmElPodaniProgress);
        GfaMain.FClientID := fClientIDwork; //nekdy se to uvnitr nepochopitelne vynuluje
        StopWait;
        mxStatusBar.Panels[0].Text := '';
      end;
      except
        on E: Exception do begin
          ShowMessage(E.Message);
        end;
      end;

      offline:= (OfflineInfo.OfflineID<>'');  //OfflineInfo je naplneno SendDocument

      Invalidate;
      Refresh;
      rvInfo.Clear;

      if (not offline) then begin
        //pokud neni offline
        if (Length(Errors) < 1) then begin
          try
            RI := MFCRModule.ReceiptInformation(workXMLPtvFileName);
