          GFaMain.mtTskpFillingPassword.Value:=OfflineInfo.OfflinePassword;
          GFaMain.mtTskpFillingDate.Value:=DateToStr(OfflineInfo.Datum);
          GFaMain.mtTskpFillingState.Value := cFillingStateFilledOffline;
          GFaMain.SetChangeFlag(TRUE);
          GFaMain.mtTskp.Post;
          DoSaveForm:=True;
        end;

        rvInfo.AddNL('Podání bylo odesláno na společné technické zařízení správců daně.',0,0);
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Podání obsahuje nadlimitní počet záznamů a proto bylo zařazeno do fronty ke zpracování později. '+
          'Podací číslo a heslo je k dispozici pro dotazování na stav. Uložte formulář '+
          'a později ověřte jeho stav tlačítkem "Zjistit stav podání".',2,0);
        rvInfo.Format;
      end;

      if DoSaveForm then begin
        if GfaMain.FDoLockFormAfterFilling then
          GfaMain.SetLockFlag(TRUE);
        GfaMain.SaveFormWithoutCheck;
        //MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání (podací číslo '+edCislo.Text+') a formulář byl uložen.',MB_OK);
        GfaMain.ShowHintSb('Byly zapsány informace o podání a formulář byl uložen.');
      end;
    end;
  finally
    btPrint.Enabled:=TRUE;
    miSaveInfo.Enabled:=TRUE;
    btClose.Enabled:=TRUE;
  end;
end;

procedure TfmElPodani.SendToPZP;
var
  pth: string;
  sl: TStringList;
  j: integer;
  {$IFNDEF STANDALONE}
  tmpFileName, tmpXMLFileName: string;
  {$ENDIF STANDALONE}

  PZPDLL: TPZPDLL;
  ID_Podani:Integer;
  ZP, ZP_Cert_SN, ZP_Cert_IDN, Sluzba, DataIn, Chyba, Varovani,
  DataOut, XML_IN, XML_OUT, InternalWarning: WideString;
  TimeOut:Smallint;

  DoSaveForm: Boolean;

  {cZP:array[0..5] of WideString = ('CNZP','OZP','RBP','ZPMA','ZPS','PILOT');
  cSluzba:array[0..2] of WideString = ('VYU','HOZ','PPPZ');}

  function HtmToText(AText: string): string;
  var
    inTag: boolean;
    i: integer;

    function ConvertISOLatin2ToWin1250(InS:String):String;
    const InPage  = '����������������̩�خ����������ϫ�';  //ISO-8859-2 (ISO Latin 2)
    const OutPage = '����������������̊�؎����������ύ�';  //Windows 1250
    var PomI, Pozice:Integer;
        Ch:WideChar;
    begin
      result:='';
      for PomI:=1 to length(InS) do
      begin
        Ch:=WideChar(InS[PomI]);
        Pozice:=Pos(Ch, InPage);
        if Pozice>0 then
          Ch:=OutPage[Pozice];
        result:=result+ch;
      end;
    end;

  begin
    Result:='';
    inTag:=FALSE;
    if Pos('<HTML',UpperCase(Atext))>0 then begin
      AText:=ConvertISOLatin2ToWin1250(AText);
      AText:=Replace('&nbsp;',AText,' ');
      AText:=Replace('<br>',AText,' ');
      AText:=Replace('<BR>',AText,' ');
      for i:=1 to Length(AText) do begin
        if AText[i]='<' then
          inTag:=TRUE;
        if not inTag then
          Result:=Result+AText[i];
        if AText[i]='>' then
          inTag:=FALSE;
      end;
      for i:=1 to 100 do begin
        Result:=Replace(#13#10,Result,' ');
        Result:=Replace(#10,Result,' ');
        Result:=Replace(#13,Result,' ');
      end;
      for i:=1 to 100 do
        Result:=Replace('  ',Result,' ');
    end
    else
      Result:=Atext;
  end;

  function GetTag(AText, ATag: string): string;
  var
    p,p1: integer;
  begin
    p:=Pos('<'+ATag+'>',AText);
    p1:=Pos('</'+ATag+'>',AText);
    if (p<>0) and (p1<>0) then
      Result:=Copy(AText,p+Length(ATag)+2,p1-p-1)
    else
      Result:='';
  end;

begin
  StartWait;
  DoSaveForm:=false;
  FPotvrzeniZP:='';
  btPrint.Enabled:=FALSE;
  miSaveInfo.Enabled:=FALSE;
  btClose.Enabled:=FALSE;
  {$IFNDEF ELPODANITEST}
  cbTestovaci.Checked:=FALSE;
  {$ENDIF ELPODANITEST}
  try
    if cbTestovaci.Checked then
      MessageWarn('', 'Podání bude odesláno na server jako testovací, jen na kontrolu bez vlastního podání.', [MBOK]);

    if edCislo.Text<>'' then begin
      if MessageWarn(Caption, 'Formulář již byl elektronicky podán (pod číslem '+
        edCislo.Text+'). Chcete jej nyní odeslat na server znovu?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;
    if GFaMain.mtValues.ReadOnly then begin
      if MessageAsk(Caption,
      'Formulář je zamknutý nebo pouze pro čtení, nebude do něj možné uložit informace o podání. '+
      'Chcete přesto provést elektronické podání?',
      [MBYES, MBNO]) <> IDYES then
      EXIT;
    end
    else begin
      if MessageAsk(Caption, 'Chcete nyní odeslat formulář na server PZP a tím provést elektronické podání?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;
    //
    mxStatusBar.Panels[0].Text := 'Probíhá odesílání dokumentu. Operace může trvat i několik minut, v závislosti na odzevě serveru...';
    Invalidate;
    Refresh;

    GFaMain.mtTskp.Edit;
    GFaMain.mtTskpFillingNumber.Value := '';
    GFaMain.mtTskpFillingPassword.Value := '';
    GFaMain.mtTskpFillingURL.Value := '';
    GFaMain.mtTskpFillingState.Value := cFillingStateNone;
    GFaMain.mtTskpFillingTimeStampDate.Value := '';
    GFaMain.mtTskpFillingTimeStampSignature.Value := '';
    GFaMain.mtTskp.Post;
    GFaMain.SetChangeFlag(TRUE);

    //
    try
      PZPDLL:=TPZPDLL.Create(self);
      if PZPDLL.Init<>S_OK then begin
        MessageErr(Caption, 'Chyba při inicializaci knihovny ASSECOPZP.dll. Podání nebylo provedeno. Problém odstraníte reinstalací programu.',
          [MBOK]);
        EXIT;
      end;
    except
      pth:=NormalPath(ExtractFilePath(Application.ExeName))+'ASSECOPZP.dll';
      if FileExists(pth) then begin
        ShellExecute(Handle, nil, PChar('regsvr32'),
          PChar('/s "'+pth+'"'), nil,SW_SHOWNORMAL);
        Sleep(2000);
      end
      else begin
        MessageErr(Caption, 'Nenalezena knihovna ASSECOPZP.dll. Podání nebylo provedeno. Problém patrně odstraníte reinstalací programu.',
          [MBOK]);
        EXIT;
      end;
      PZPDLL:=TPZPDLL.Create(self);
      if PZPDLL.Init<>S_OK then begin
        MessageErr(Caption, 'Chyba při inicializaci knihovny ASSECOPZP.dll. Podání nebylo provedeno. Problém by měl jít vyřešit reinstalací programu.', [MBOK]);
        EXIT;
      end;
    end;
    //
    try
      if Pos(',',FTypDoc)>0 then
        DataIn:=NormalPath(GFaMain.DirWorkPath) + Copy(FTypDoc,Pos(',',FTypDoc)+1,80)
      else begin
        MessageErr(Caption, 'Nedefinovaný soubor v definici formuláře. Aktualizujte definici formuláře.',
          [MBOK]);
        EXIT;
      end;
      {$IFDEF ELPODANITEST}
      if cbTestovaci.Checked then
        FDoc:=Replace('217',FDoc,'999');
      {$ENDIF ELPODANITEST}
      SaveStringToFile(FDoc,DataIn);
      if cbTestovaci.Checked then
        ZP:='PILOT'
      else
        ZP:=Copy(FTypDoc,1,Pos('-',FTypDoc)-1);
      Sluzba:=Copy(FTypDoc,Pos('-',FTypDoc)+1,80);
      Sluzba:=Copy(Sluzba,1,Pos(',',Sluzba)-1);
      Timeout:=seServerTimeOut.Value;
      ZP_Cert_SN:='';
      ZP_Cert_IDN:='';
      rvInfo.Clear;
      rvInfo.AddNL('Probíhá odesílání dokumentu. V komunikačním dialogu Portálu ZP vyberte certifikát, potvrďte komunikační dialog, poté '+
        'bude potřeba ještě jednou vybrat certifikát pro autorizaci přístupu k Portálu ZP. Nakonec vyčkejte na dokončení podání.',0,0);
      rvInfo.Format;
      //Volani knihovny
      PZPDLL.Run(ZP, ZP_Cert_SN, ZP_Cert_IDN, Sluzba, DataIn, Timeout, ID_Podani, Chyba, Varovani, DataOut, InternalWarning, XML_In, XML_Out);
      FDatumPodani:= DateToStr(now);
      //Zpracovani vysledku
      {---
      rvInfo.Clear;
      rvInfo.AddNL('ID Podani: '+IntToStr(ID_Podani),3,0);
      rvInfo.AddNL('Chyba: '+Chyba,3,0);
      rvInfo.AddNL('Varovani: '+Varovani,3,0);
      rvInfo.AddNL('InternalWarning: '+InternalWarning,3,0);
      rvInfo.AddNL('DataOut: '+DataOut,3,0);
      rvInfo.AddNL(' ',3,0);
      rvInfo.AddNL('XML_Out: '+XML_Out,3,0);
      rvInfo.Format;
      ---}
    finally
      PZPDLL.Free;
    end;
    rvInfo.Clear;
    if Chyba = '0' then begin
      edCislo.Text:=IntToStr(ID_Podani);

      if not GFaMain.mtValues.ReadOnly then begin
        GFaMain.mtTskp.Edit;
        GFaMain.mtTskpFillingNumber.Value:=IntToStr(ID_Podani);
        GFaMain.mtTskpFillingPassword.Value:=IntToStr(ID_Podani);
        GFaMain.mtTskpFillingDate.Value:=FDatumPodani;
        GFaMain.mtTskpFillingState.Value := cFillingStateFilled;
        GFaMain.mtTskpFillingTimeStampSignature.Value := ZP + cCRLF +
          ExtractFileName(DataIn);
        GFaMain.SetChangeFlag(TRUE);
        GFaMain.mtTskp.Post;
        DoSaveForm:=true;
      end;

      rvInfo.AddNL('Podání bylo odesláno na portál zdravotních pojišťoven.',0,0);
      rvInfo.AddNL('',0,0);
      rvInfo.AddNL('Opis potvrzení elektronického podání',1,0);
      rvInfo.AddNL('',0,0);
      rvInfo.AddNL('Formulář: '+GFaMain.mtDefName.Value,3,0);
      rvInfo.AddNL('Zdravotní pojišťovna: '+ ZP,3,0);
      rvInfo.AddNL('Datum a čas podání: '+FDatumPodani,3,0);
      rvInfo.AddNL('Podací číslo: '+IntToStr(ID_Podani),3,0);
      rvInfo.AddNL('Název souboru: '+ExtractFileName(DataIn),3,0);
      sl:=TStringList.Create;
      try
        sl.Text:=GfaMain.GetCharacteristics;
        rvInfo.AddNL('',0,0);
        rvInfo.AddNL('Informace o dokumentu:',3,0);
        for j:=0 to sl.Count-1 do
          rvInfo.AddNL('  '+sl[j],3,0);
      finally
        sl.Free;
      end;
      rvInfo.AddNL('',0,0);
      rvInfo.Format;
      FPotvrzeniZP:=GetTag(XML_Out,'Podpis');
      FPotvrzeniZP:=Replace('<!--P4ZP SIGNATURE-->',DataOut,FPotvrzeniZP);

      {$IFNDEF STANDALONE}
      if DataIn<>'' then begin
        tmpFileName:=GetTmpFileName;
        rvInfo.SaveText(tmpFileName, 80);
        tmpXMLFileName:=NormalPath(GFaMain.DirWorkPath) + cElPodaniZPWorkFileName;
        SaveStringToFile(DataIn, tmpXMLFileName);
        try
          GfaMain.WritePdfToDocs('El. pod�n� '+GFaMain.mtDefName.Value,
            tmpXMLFileName,TRUE,LoadStringFromFile(tmpFileName));
        finally
          if FileExists(tmpFileName) then
            DeleteFile(tmpFileName);
          if FileExists(tmpXMLFileName) then
            DeleteFile(tmpXMLFileName);
        end;
      end;
      //original potvrzeni
      if (DataOut<>'') and
        (GfaMain.FParamSave2DocElPodaniPotvrzeni) then begin
        tmpFileName:=NormalPath(GfaMain.DirWorkPath)+'PotvrzeniZP.htm';
        SaveStringToFile(DataOut,tmpFileName);
        try
          GfaMain.WritePdfToDocs('El. pod�n� - potvrzen� '+GFaMain.mtDefName.Value,
            tmpFileName,TRUE,cMsgEPPotvrzeni);
        finally
          if FileExists(tmpFileName) then
            DeleteFile(tmpFileName);
        end;
      end;
      {$ENDIF STANDALONE}

      if GFaMain.mtValues.ReadOnly then begin
        rvInfo.AddNL('Informace o podání nebyly zapsány do formuláře, protože je zamknutý nebo pouze pro čtení.',0,0);
        rvInfo.Format;
      end;

      miSavePotvrzeni.Enabled:=TRUE;
    end
    else begin
      rvInfo.AddNL('Dokument nebyl přijat, obsahuje chyby.',0,0);
      rvInfo.AddNL('Číslo chyby: '+Chyba,0,0);
      rvInfo.AddNL('Popis chyby: '+HtmToText(DataOut),0,0);
      rvInfo.AddNL('Upozornění: '+Varovani,0,0);
      rvInfo.AddNL('ID podání: '+IntToStr(ID_Podani),0,0);
      rvInfo.AddNL('',0,0);
      rvInfo.AddNL('XML_Out: '+XML_Out,0,0);
      rvInfo.Format;
    end;
    if DoSaveForm then begin
      if GfaMain.FDoLockFormAfterFilling then
        GfaMain.SetLockFlag(TRUE);
      GfaMain.SaveFormWithoutCheck;
      MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání a formulář byl uložen.',MB_OK);
    end;
  finally
    btPrint.Enabled:=TRUE;
    miSaveInfo.Enabled:=TRUE;
    btClose.Enabled:=TRUE;
    StopWait;
  end;
end;

// Vraci True, pokud podani neobsahuje zavazne chyby (K, N, S)
//
function TestToMF(const ADoc: string; out ARes: string; out AFileName: string;
  ACreateMFCRModule: Boolean = true; ANatestovaciServer: Boolean = false): boolean;
var
  Errors: TReceiptErrors;
  i,timeout: integer;
  workXMLPdpFileName, workZIPPdpFileName, workXMLPtvFileName: string;
  sl: TStringList;
  params, proxyServer, proxyPort, formName: string;
  iniFile: TRKSIniFile;
  openSSL, nepropustnaChyba: boolean;
  fClientIDwork: integer;
  XMLDoc: IXMLDocument;
  childN: IXMLNodeList;
  slCsv: TStringList;

const
  eptxt = 'I - V důsledku uživatelského nastavení nebylo podání zkontrolováno.'+cCRLF;
begin
  fClientIDwork:=GfaMain.FClientID;
  ARes:='';
  AFileName:='';
  Result:=True;
  SaveStringToFile(ADoc,NormalPath(GFaMain.DirWorkPath) + cElPodaniPdpWorkFileName);
  workXMLPdpFileName := NormalPath(GFaMain.DirWorkPath) + cElPodaniPdpWorkFileName;

  if GfaMain.FSkipEPOList <> '' then begin
    slCsv:= TStringList.Create;
    XMLDoc:=TXMLDocument.Create(fmElPodani);
    XMLDoc.LoadFromXml(ADoc);
    XMLDoc.Active := TRUE;
    try
      slCsv.CommaText := GfaMain.FSkipEPOList;
      if XMLDoc.DocumentElement.NodeName = 'Pisemnost' then begin
        childN := XMLDoc.DocumentElement.ChildNodes;
        if (childN.Count >= 1) then begin
          for i := 0 to slCsv.Count - 1 do begin
            if slCsv[i] = (Copy(UpperCase(childN[0].NodeName), 1, Length(slCsv[i]))) then begin
              ARes := eptxt;
              AFileName:=workXMLPdpFileName;
              Exit;
            end;
          end;
        end;
      end;
    finally
      slCsv.Free;
      XMLDoc.Active := FALSE;
      XMLDoc := nil;
    end;
  end;

  if GfaMain.FScriptFillingZip then begin
    workZIPPdpFileName:=ChangeFileExt(workXMLPdpFileName,'.zip');
    ZipFile(workXMLPdpFileName,workZIPPdpFileName,'');
    FileCopy(workXMLPdpFileName,workXMLPdpFileName+'.bck',true); //ulozime pro obnoveni
    FileCopy(workZIPPdpFileName,workXMLPdpFileName,true);
  end;

  AFileName:=workXMLPdpFileName;

  if GfaMain.CheckScriptDirective(cScriptDirective_OnlyCertFilling) then //netestovat ve formularich, ktere se daji podat jen podepsane
    Exit;

  Result:=FALSE;
  StartWait;
  sl := TStringList.Create;
  try try
    GfaMain.ShowHintSb('Probíhá kontrola podání na serveru České daňové správy ...'); //#3305
    //fmElPodaniProgress:=EpProgressStart('Kontrola podání na serveru České daňové správy','Probíhá komunikace, počkejte prosím na dokončení operace ...');

    iniFile := TRKSIniFile.Create(GfaMain.GetIniFileName);
    try
      formName:='fmElPodani';
      proxyServer := iniFile.ReadString(formName, 'ProxyServer', '');
      proxyPort := iniFile.ReadString(formName, 'ProxyPort', '');
      openSSL := iniFile.ReadBool(formName, 'OpenSSLSendMode', FALSE);
      timeout:=iniFile.ReadInteger(formName, 'ServerTimeOut', 300);
    finally
      iniFile.Free;
    end;
    workXMLPtvFileName := NormalPath(GFaMain.DirWorkPath) + cElPodaniPtvWorkFileName;
    if FileExists(workXMLPdpFileName) then begin
      if ACreateMFCRModule then
        Application.CreateForm(TMFCRModule, MFCRModule);
      try
        MFCRModule.ProxySettings.ProxyServer := proxyServer;
        MFCRModule.ProxySettings.ProxyPort := StrToIntSafe(proxyPort);
        MFCRModule.ServerTimeOut:=timeout;
        params:='?test=1';
        Errors := MFCRModule.SendDocument(workXMLPdpFileName, workXMLPtvFileName,
          params, ANaTestovaciServer{testovaci server}, openSSL, TRUE{bez podpisu});
      finally
        if ACreateMFCRModule then begin
          MFCRModule.Free;
          MFCRModule:=nil;
        end;
      end;
      nepropustnaChyba:=FALSE;
      if Length(Errors) < 1 then begin
        Result:=TRUE;
        ARes:='';
      end
      else begin
        Result:=TRUE;
        for i := Low(Errors) to High(Errors) do begin
          if Errors[i].ErrorType<>'I' then
            sl.Add(IntToStr(i+1) + '. ' + Errors[i].ErrorType +
             ' - ' + Errors[i].ErrorText)
          else if Pos('klasifikováno jako rozsáhlé',Errors[i].ErrorText)>0 then
            sl.Add('Jedná se o rozsáhlé podání u kterého kontrola porobíhne později, až po jeho podání. ');
          nepropustnaChyba:=(Errors[i].ErrorType='K')or
            {(Errors[i].ErrorType='N') or } // ta je zavazna ale propustna
            (Errors[i].ErrorType='S');
          if Result then
            Result:=not nepropustnaChyba;
        end;
        ARes:=sl.Text;
      end;
    end;
  except
    on E: Exception do begin
      ARes:='Chyba při pokusu o kontrolu: '+E.Message;
      Result:=TRUE;
    end;
  end;
  if GfaMain.FScriptFillingZip then //vratime soubor do stavu pred zipovanim, protoze se pouziva pro odeslani datovou schrankou
    FileCopy(workXMLPdpFileName+'.bck',workXMLPdpFileName,true);
  finally
    sl.Free;
    //EpProgressStop(fmElPodaniProgress); //#3305
    GfaMain.ShowHintSb('');
    GfaMain.FClientID:=fClientIDwork; //nekdy se to uvnitr nepochopitelne vynuluje
    StopWait;
  end;
end; {TestToMF}


procedure TfmElPodani.btSendClick(Sender: TObject);
begin
  {$IFNDEF ELPODANITEST}
  if StartCounterZero then
    EXIT;
  {$ENDIF ELPODANITEST}

  if FTypDoc='' then
    SendToMF
  else
    SendToPZP;
end;

procedure TfmElPodani.btAskStateClick(Sender: TObject);
var
  DS: TDeliveryState;
  posZav: integer;
  offline:Boolean;
  offlineID:string;
  offlinePwd:string;
  offlineOdp: string;
  offlineDatum: string;
  seznamChyb:TReceiptErrors;
  odp:Integer;
  i:Integer;
  RI:TReceiptInformation;
begin
  //nacteni zda je offline podani
  offline := GFaMain.mtTskpFillingState.Value=cFillingStateFilledOffline;
  if offline then begin
    offlineID := GFaMain.mtTskpFillingNumber.Value;
    offlinePwd := GFaMain.mtTskpFillingPassword.Value;
    offlineDatum := GFaMain.mtTskpFillingDate.Value;
  end;

  StartWait;
  mxStatusBar.Panels[0].Text := 'Probíhá dotaz na stav podání. Operace může trvat i několik minut, v závislosti na odzevě serveru. Čekejte ...';
  Invalidate;
  Refresh;
  try
    if not offline then begin
      try
        MFCRModule.ProxySettings.ProxyServer := EdProxyServer.Text;
        MFCRModule.ProxySettings.ProxyPort := StrToIntSafe(EdProxyPort.Text);
        MFCRModule.ServerTimeOut:=seServerTimeOut.Value;
        DS := MFCRModule.DeliveryState(edCislo.Text, edHeslo.Text);
        rvInfo.Clear;
        if DS.stav_podpre_text<>'' then begin
          rvInfo.AddNL('Stav podání č. ' + edCislo.Text + ': ' +
            DS.stav_podpre_text,0,0);
          rvInfo.AddNL('Podrobnosti:',0,0);
          rvInfo.AddNL('  Uloženo do centrální databáze MF dne '+
            Copy(DS.d_podani,9,2)+'.'+Copy(DS.d_podani,6,2)+'.'+
            Copy(DS.d_podani,1,4) + ' v '+ DS.cas_podani,0,0);
          rvInfo.AddNL('  Určeno pro FÚ č. ' + DS.c_ufo_prij,0,0);
          posZav:=Pos('(',DS.stav_podapl_text);
          if posZav>0 then
            rvInfo.AddNL('  Stav podání na FÚ: ' +
              Copy(DS.stav_podapl_text,1,posZav-1),0,0)
          else
            rvInfo.AddNL('  Stav podání na FÚ: ' + DS.stav_podapl_text,0,0);
          if DS.d_pripodapl<>'' then
            rvInfo.AddNL('  Datum zpracování na FÚ: ' +
            Copy(DS.d_pripodapl,9,2)+'.'+Copy(DS.d_pripodapl,6,2)+'.'+
            Copy(DS.d_pripodapl,1,4),0,0);
          if DS.pozn_pripodapl<>'' then
            rvInfo.AddNL('  Poznámka (odůvodnění odmítnutí): ' +
            DS.pozn_pripodapl,0,0);
        end
        else
          rvInfo.AddNL('Podání ' + edCislo.Text + ' nebylo nalezeno.',0,0);
        rvInfo.Format;
      except
        on E: Exception do begin
          rvInfo.AddNL(E.Message,0,0);
          rvInfo.Format;
        end;
      end;
    end
    else begin
      //dotaz na offline stav
      try
        odp:= MFCRModule.QueryOfflineState(offlineID,offlinePwd, edProxyServer.Text, StrToIntSafe(EdProxyPort.Text),seServerTimeOut.Value,
           offlineOdp, cxOpenSSLSendMode.Checked, cbTestovaciServer.Checked);
        if odp=1 then begin
          //predano ke zpracovani - jsme stále ve stavu čekání
          //nic nedelat, nic se nezmenilo
          rvInfo.AddNL('Stav podání: Předáno ke zpracování',0,0);
        end
        else if odp=3 then begin
          //neprijato jsou tam chyby musíme rozparsovat chyby
          //zrusit stav priznani offline
          rvInfo.AddNL('Stav podání: Nepřijato',0,0);
          rvInfo.AddNL('Podání obsahuje chyby:',0,0);

          seznamChyb:=MFCRModule.GetChybyOffline(offlineOdp);
          for i := Low(seznamChyb) to High(seznamChyb) do begin
             rvInfo.AddNL(Format('%s %s',[seznamChyb[i].ErrorType,seznamChyb[i].ErrorText] ),0,0);
          end;

        end
        else begin
          //Prijato offlineOdp obsahuje to co je vraceno po beznem odeslani.
          //zrusit stav priznani offline
           RI:=MFCRModule.GetRIFromString(OfflineOdp);

           edCislo.Text:=RI.ReceiptNumber;
           edHeslo.Text:=RI.ReceiptPassword;

           edDatumOdeslani.Text:= RI.ReceiptDate;
           lblStavPodani.Caption:='Podáno';

           if not GFaMain.mtValues.ReadOnly then begin
             GFaMain.mtTskp.Edit;
             GFaMain.mtTskpFillingNumber.Value:=RI.ReceiptNumber;
             GFaMain.mtTskpFillingPassword.Value:=RI.ReceiptPassword;
             GFaMain.mtTskpFillingDate.Value:=FormatDate(RI.ReceiptDate);
             GFaMain.mtTskpFillingState.Value := cFillingStateFilled;
             GFaMain.mtTskpFillingTimeStampSignature.Value :=
               RI.ReceiptFileName+cCRLF+FormatCheck(RI.ReceiptCheck);
             GFaMain.mtTskp.Post;
             if GfaMain.FDoLockFormAfterFilling then
               GfaMain.SetLockFlag(TRUE);
             GfaMain.SaveFormWithoutCheck;
             //MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání a formulář byl uložen.',MB_OK);
             GfaMain.ShowHintSb('Byly zapsány informace o podání a formulář byl uložen.');
           end;
        end;
      except
        on E: Exception do begin
          rvInfo.AddNL(E.Message,0,0);
          rvInfo.Format;
        end;
      end;
    end;
  finally
    mxStatusBar.Panels[0].Text := '';
    StopWait;
  end;
end;

{$IFNDEF STANDALONE}
// Pro zjisteni stavu podani z klientu
// Vraci: true kdyz doslo ke zmene dat formulare - zmenil se stav off-line na podano
//        je treba data formulare zapsat do databaze, jinak false
//        AResult: text s informacemi o stavu
//
function CheckFillingState(var AFrmData: string; out AResult: string): boolean;
var
  DS: TDeliveryState;
  posZav: integer;
  offline:Boolean;
  offlineID:string;
  offlinePwd:string;
  offlineOdp: string;
  offlineDatum: string;
  seznamChyb:TReceiptErrors;
  odp:Integer;
  i:Integer;
  RI:TReceiptInformation;
  section: string;

  fillingNumber: string;
  fillingPassword: string;
  fillingDate: string;
  fillingState: string;
  fillingURL: string;
  fillingTimeStampDate: string;
  fillingTimeStampSignature: string;

  iniFile: TRKSIniFile;
  proxyServer: string;
  proxyPort: integer;
  serverTimeOut: Integer;
  openSSLSendMode: Boolean;
  data, dataSec: TStringList;
  posunRadku: Integer;

const
  cFillingNumber = 'FillingNumber';
  cFillingPassword = 'FillingPassword';
  cFillingDate = 'FillingDate';
  cFillingState = 'FillingState';
  cFillingURL: string = 'FillingURL';
  cFillingTimeStampDate = 'FillingTimeStampDate';
  cFillingTimeStampSignature = 'FillingTimeStampSignature';

  procedure GetProxySettings;
  begin
    iniFile := TRKSIniFile.Create(GetFormsIniPath);
    try
      proxyServer := iniFile.ReadString('fmElPodani', 'ProxyServer', '');
      MFCRModule.ProxySettings.ProxyServer := proxyServer;
      proxyPort := StrToIntSafe(iniFile.ReadString('fmElPodani', 'ProxyPort', ''));
      MFCRModule.ProxySettings.ProxyPort := proxyPort;
      serverTimeOut := iniFile.ReadInteger('fmElPodani', 'ServerTimeOut', 300);
      MFCRModule.ServerTimeOut := serverTimeOut;
      openSSLSendMode := iniFile.ReadBool('fmElPodani', 'OpenSSLSendMode', FALSE);
    finally
      iniFile.Free;
    end;
  end;

begin
  StartWait;
  Application.CreateForm(TMFCRModule, MFCRModule);
  try
    GetProxySettings;
    //vytahnuti dat o podani z dat formulare
    section := GetSection(AFrmData, cFormHeadLabel);
    fillingNumber := GetStringLineValue(section,cFillingNumber);
    fillingPassword := GetStringLineValue(section,cFillingPassword);
    fillingDate := GetStringLineValue(section,cFillingDate);
    fillingState := GetStringLineValue(section,cFillingState);
    fillingURL := GetStringLineValue(section,cFillingURL);
    fillingTimeStampDate := GetStringLineValue(section,cFillingTimeStampDate);
    fillingTimeStampSignature := GetStringLineValue(section,cFillingTimeStampSignature);

    if Pos(cDSfilled,fillingTimeStampSignature)>0 then begin
      Result:=False;
      AResult:='Formulář byl podán přes datovou schránku dne '+fillingDate+#13#10+
        'ID zprávy: '+Replace(cDSfilled+':',fillingTimeStampSignature,'')+#13#10+
        'Při tomto způsobu podání nelze zjistit více.'+cCRLF;
      Exit;
    end
    else if (fillingNumber='')and(fillingPassword='')  then begin
      Result:=False;
      AResult:='Formulář nebyl elektronicky podán.'+cCRLF;
      Exit;
    end
    else if (fillingNumber=fillingPassword)  then begin //PZP
      Result:=False;
      AResult:='U tohoto typu formuláře nelze zjistit stav. Není to formulář Ministerstva financí.'+cCRLF;
      Exit;
    end
    else if (fillingNumber='')and(fillingPassword<>'') then begin // CSSZ
      Result:=False;
      AResult:='U tohoto typu formuláře nelze zjistit stav. Není to formulář Ministerstva financí.'+cCRLF;
      Exit;
    end;

    //nacteni zda je offline podani
    offline := StrToIntSafe(fillingState)=cFillingStateFilledOffline;
    if offline then begin
      offlineID := fillingNumber;
      offlinePwd := fillingPassword;
      offlineDatum := fillingDate;
    end;

    AResult:='';
    Result:=False;
    if not offline then begin
      try
        DS := MFCRModule.DeliveryState(fillingNumber, fillingPassword);
        if DS.stav_podpre_text<>'' then begin
          AResult:=AResult+'Stav podání č. ' + fillingNumber + ': ' + DS.stav_podpre_text+cCRLF;
          AResult:=AResult+'Podrobnosti:'+cCRLF;
          AResult:=AResult+'  Uloženo do centrální databáze MF dne '+
            Copy(DS.d_podani,9,2)+'.'+Copy(DS.d_podani,6,2)+'.'+
            Copy(DS.d_podani,1,4) + ' v '+ DS.cas_podani+cCRLF;
          AResult:=AResult+'  Určeno pro FÚ č. ' + DS.c_ufo_prij+cCRLF;
          posZav:=Pos('(',DS.stav_podapl_text);
          if posZav>0 then
            AResult:=AResult+'  Stav podání na FÚ: ' + Copy(DS.stav_podapl_text,1,posZav-1)+cCRLF
          else
            AResult:=AResult+'  Stav podání na FÚ: ' + DS.stav_podapl_text+cCRLF;
          if DS.d_pripodapl<>'' then
            AResult:=AResult+'  Datum zpracování na FÚ: ' +
            Copy(DS.d_pripodapl,9,2)+'.'+Copy(DS.d_pripodapl,6,2)+'.'+
            Copy(DS.d_pripodapl,1,4)+cCRLF;
          if DS.pozn_pripodapl<>'' then
            AResult:=AResult+'  Poznámka (odůvodnění odmítnutí): ' +
            DS.pozn_pripodapl+cCRLF;
        end
        else
          AResult:='Podání ' + fillingNumber + ' nebylo nalezeno.'+cCRLF;
      except
        on E: Exception do begin
          AResult:=E.Message;
        end;
      end;
    end
    else begin
      //dotaz na offline stav
      try
        odp:= MFCRModule.QueryOfflineState(offlineID,offlinePwd, proxyServer, proxyPort,
          serverTimeOut, offlineOdp, openSSLSendMode, False);
        if odp=1 then begin
          //predano ke zpracovani - jsme stále ve stavu čekání
          //nic nedelat, nic se nezmenilo
          AResult:=AResult+'Stav podání č. ' + fillingNumber + ': Off-line - předáno ke zpracování'+cCRLF;
        end
        else if odp=3 then begin
          //neprijato jsou tam chyby musíme rozparsovat chyby
          //zrusit stav priznani offline
          AResult:=AResult+'Stav podání č. ' + fillingNumber + ': Off-line - nepřijato'+cCRLF;
          AResult:=AResult+'Podání obsahuje chyby:'+cCRLF;

          seznamChyb:=MFCRModule.GetChybyOffline(offlineOdp);
          for i := Low(seznamChyb) to High(seznamChyb) do begin
             AResult:=AResult+Format('%s %s',[seznamChyb[i].ErrorType,seznamChyb[i].ErrorText] )+cCRLF;
          end;
        end
        else begin
          //Prijato offlineOdp obsahuje to co je vraceno po beznem odeslani.
          //zrusit stav priznani offline
           RI:=MFCRModule.GetRIFromString(OfflineOdp);

           AResult:=AResult+'Stav podání č. ' + fillingNumber +
             ': Off-line - podání bylo přijato, byl změněn stav na "podáno".'+cCRLF;
           AResult:=AResult+'Pro podrobnější informace o podání proveďte znovu zjištění stavu.'+cCRLF;

           data:=TStringList.Create;
           dataSec:=TStringList.Create;
           try
             data.Text:=AFrmData;
             dataSec.Text:=section;
             posunRadku:=data.IndexOf(cFormHeadLabel)+1;
             for i := 0 to dataSec.Count - 1 do begin
               if Pos(cFillingNumber,dataSec[i])>0 then
                 data[i+posunRadku]:=cFillingNumber+'='+RI.ReceiptNumber;
               if Pos(cFillingPassword,dataSec[i])>0 then
                 data[i+posunRadku]:=cFillingPassword+'='+RI.ReceiptPassword;
               if Pos(cFillingDate,dataSec[i])>0 then
                 data[i+posunRadku]:=cFillingDate+'='+FormatDate(RI.ReceiptDate);
               if Pos(cFillingState,dataSec[i])>0 then
                 data[i+posunRadku]:=cFillingState+'='+IntToStr(cFillingStateFilled);
               if Pos(cFillingTimeStampSignature,dataSec[i])>0 then
                 data[i+posunRadku]:=cFillingTimeStampSignature+'='+RI.ReceiptFileName+cCRLF+FormatCheck(RI.ReceiptCheck);
               end;
               AFrmData:=data.Text;
           finally
             data.Free;
             dataSec.Free;
           end;

           Result:=True;
        end;
      except
        on E: Exception do begin
          AResult:=E.Message;
        end;
      end;
    end;
    //Msgv(AResult);
  finally
    MFCRModule.Free;
    MFCRModule:=nil;
    StopWait;
  end;
end;
{$ENDIF STANDALONE}

