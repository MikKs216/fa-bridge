  ShellExecute(0, nil,
    PChar(NormalPath(GFaMain.DirWorkPath) + cElPodaniWorkFileName),
    nil, nil, SW_SHOWNORMAL);
end;

procedure TfmElPodani.miNacistXMLZeSouboruClick(Sender: TObject);
var
  workfilename:string;
  doc: TStringList;
  i: integer;
begin
  if MessageAsk(Caption, 'Chcete načíst soubor s datovou zprávou pro el. podání ze souboru?' ,[MBYES, MBNO])=IDNO then
    EXIT;
  workfilename := NormalPath(GFaMain.DirWorkPath) + cElPodaniWorkFileName;
  if OpenFileDialog.Execute then begin
    FileCopy(OpenFileDialog.FileName,workfilename,true);
    doc:=TStringList.Create;
    try
      {rvOpis.Clear;}
      doc.LoadFromFile(workfilename);
      {for i:=0 to doc.Count-1 do
        rvOpis.AddNL(doc[i],0,0);
      rvOpis.Format;}
      MessageInfo(Caption, 'Soubor s datovou zprávou byl načten. Můžete jej zkontrolovat funkcí Zobrazit obsah podání v XML.' ,[MBOK]);
    finally
      doc.Free;
    end;
  end;
end;

