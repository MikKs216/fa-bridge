function TestAndRegisterISDSManager(ASilent: boolean; out AMsg: string): boolean;
var
  ISDSManager,ISDSManager1: TISDSManager;
  res, pth, pth1: string;

  function IsDotNet2Installed: boolean;
  begin
    Result:=FALSE;
    with TRegistry.Create do try
      try
        RootKey := HKEY_LOCAL_MACHINE;
        //Result:=KeyExists('SOFTWARE\Microsoft\.NETFramework\Policy\v2.0');
        Result:=true; // Je potreba pro beh pod Win 8
      except
      end;
    finally
      Free;
    end;
  end;

begin
  Result:=FALSE;
  AMsg:='';
  //Framework
  if not IsDotNet2Installed then begin
    AMsg:='Není nainstalován .NET framework (4.5 nebo vyšší) potřebný pro komunikaci s datovou schránkou. Nainstalujte jej. '+
      'Instalační soubor .NET framework najdete na www.microsoft.cz.';
    if not ASilent then
      MessageErr('', AMsg, [MBOK]);
    EXIT;
  end;
  //ISDSManager
  ISDSManager:= TISDSManager.Create(nil);
  try try
    res:=ISDSManager.ToString;
    Result:=TRUE;
  except
    //Regasm
    pth:=GetWindowsFolder + '\Microsoft.NET\Framework\v4.0.30319\regasm.exe';
    if not FileExists(pth) then begin
      AMsg:='Nenalezen program Windows\Microsoft.NET\Framework\v4.0.30319\regasm.exe. Patrně není k dispozici .NET framework.';
      if not ASilent then
        MessageErr('', AMsg, [MBOK]);
      EXIT;
    end;
    pth1:=ExtractFilePath(Application.ExeName)+'ManagerISDS.dll';
    if not FileExists(pth1) then begin
      AMsg:='Nenalezena knihovna ManagerISDS.dll ve složce s programem. Problém patrně odstraníte reinstalací programu.';
      if not ASilent then
        MessageErr('', AMsg, [MBOK]);
      EXIT;
    end;
    ShellExecute(0, nil, PChar('"'+pth+'"'),
      PChar('"'+pth1+'"'), PChar('/codebase'), SW_SHOWNORMAL);
    Sleep(3000);

    ISDSManager1:= TISDSManager.Create(nil);
    try try
      res:=ISDSManager1.ToString;
      if res<>'' then
        Result:=TRUE;
    except
      on E: Exception do begin
        AMsg:='Objekt ManagerISDS.dll není zaregistrován. Ukončete program, spusťte soubor ISDScomobjreg.bat ve složce programu. '+
          'Pokud bude problém přetrvávat, kontaktujte technickou podporu. Chyba: '+E.Message;
        if not ASilent then
          MessageErr('', AMsg, [MBOK]);
      end;
    end
    finally
      ISDSManager1.Free;
      ISDSManager1:=nil;
    end;
  end
  finally
    ISDSManager.Free;
    ISDSManager:=nil;
  end;
end;

end.

