procedure TfmDatovaSchranka.LoadFormStateFromIni;
var
  iniFile: TMemIniFile;
  l,t: Integer;
begin
  grZpravyViewDorucene.RestoreFromIniFile(GetIniFileName, TRUE, FALSE,
    [gsoUseFilter],'GridViewDorucene');
  grZpravyViewOdeslane.RestoreFromIniFile(GetIniFileName, TRUE, FALSE,
    [gsoUseFilter],'GridViewOdeslane');
  //
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    grZpravyViewDorucene.OptionsView.DataRowHeight:=iniFile.ReadInteger(Name,
      'PrijateGridRowHigh', 45);
    grZpravyViewOdeslane.OptionsView.DataRowHeight:=iniFile.ReadInteger(Name,
      'OdeslaneGridRowHigh', 45);
    cbObdobi.ItemIndex:=0;
    cbObdobi.ItemIndex := iniFile.ReadInteger(Name, 'ObdobiIndex', 5);

{$IFDEF STANDALONE}
  {$IFDEF DSAPP}
    l:=iniFile.ReadInteger(Name, 'Left', 0);
    t:=iniFile.ReadInteger(Name, 'Top', 0);
  {$ELSE DSAPP}
    l:=iniFile.ReadInteger(Name, 'Left',
      GfaMain.Left+GfaMain.paLeft.Width+5);
    t:=iniFile.ReadInteger(Name, 'Top',
      GfaMain.Top+80);
  {$ENDIF DSAPP}
{$ELSE STANDALONE}
    l:=iniFile.ReadInteger(Name, 'Left', 0);
    t:=iniFile.ReadInteger(Name, 'Top', 0);
{$ENDIF STANDALONE}
    Width:=iniFile.ReadInteger(Name, 'Width', 952);
    Height:=iniFile.ReadInteger(Name, 'Height', 532);

    CheckFormPosition(l,t,Width);
    Left:=l;
    Top:=t;
  finally
    iniFile.Free;
  end;
end;

procedure TfmDatovaSchranka.SaveFormStateToIni;
var
  iniFile: TMemIniFile;
begin
  grZpravyViewDorucene.StoreToIniFile(GetIniFileName, FALSE, [gsoUseFilter],
    'GridViewDorucene');
  grZpravyViewOdeslane.StoreToIniFile(GetIniFileName, FALSE, [gsoUseFilter],
    'GridViewOdeslane');
  //
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
    iniFile.WriteInteger(Name, 'PrijateGridRowHigh',
      grZpravyViewDorucene.OptionsView.DataRowHeight);
    iniFile.WriteInteger(Name, 'OdeslaneGridRowHigh',
      grZpravyViewOdeslane.OptionsView.DataRowHeight);
    iniFile.WriteInteger(Name, 'ObdobiIndex', cbObdobi.ItemIndex);
    iniFile.WriteInteger(Name, 'Left', Left);
    iniFile.WriteInteger(Name, 'Top', Top);
    iniFile.WriteInteger(Name, 'Width', Width);
    iniFile.WriteInteger(Name, 'Height', Height);

    try
      SaveMemIni(iniFile);
    except  // osetreni, kdyz nejsou prava k zapisu, tak nezapisujeme
    end;
  finally
    iniFile.Free;
  end;
end;

function TfmDatovaSchranka.NactiSeznamZprav: string;
var
  retCode, retMsg, retString, tString: WideString;
  res: WordBool;
  ISDSManager: TISDSManager;
  msg: string;
  datOd,datDo: TDateTime;
  isErr, ok, inField: boolean;
  i: integer;
  {s, c, m, ss: string;}
begin
  DisableFormControls;
  Result:='';
  isErr:=FALSE;
  StartW('Probíhá inicializace přístupu do datové schránky ...');
  try
    ok:=TestAndRegisterISDSManager(FALSE, msg);
  finally
    StopW;
  end;

  if (FPrihlJmeno='')and(FPrihlHeslo='') then
    ok:=ZadejPrihlasovaciUdaje(FPrihlJmeno, FPrihlHeslo, FTest, FCertif);

  if ok then begin
    StartW('Probíhá přenos seznamu zpráv z datové schránky ...');
    ISDSManager:= TISDSManager.Create(nil);
    try
      if cxDatumOd.Date>0 then
        datOd:=cxDatumOd.Date
      else
        datOd:=1;
      if cxDatumDo.Date>0 then
        datDo:=cxDatumDo.Date
      else
        datDo:=Date+9000; //posunujeme aby, kdyz si uzivatel posune syst. datum zpet o par let aby porad byl prostor
      if ISDSManager.ZjistiPrijateOdeslaneZpravy(FTest, FPrihlJmeno, FPrihlHeslo, FCertif,FPrihlasit,
        datOd,datDo+1,-1,-1{1023},0,1000, //max pocet zprav
        retString, retCode, retMsg) then begin

        {
        c:=retCode;
        m:=retMsg;
        ss:=retString;
        s:='DatOd: '+DateToStr(datOd)+#13#10+
          'DatDo: '+DateToStr(datDo+1)+#13#10+
          'retCode: '+c+#13#10+
          'retMsg: '+m+#13#10+
          'retString: '+#13#10+ss;
        SaveStringToFile(s,GetExePath+'DSmsgProtocol.txt');
        }

        //oestreni moznych CRLF uvnitr udaju
        inField := false;
        tString := '';
        for i:=1 to Length(retString) do begin
          if retString[i]='"' then begin
            inField := not inField;
            tString:=tString+retString[i];
          end
          else begin
            if inField then begin
              if ((retString[i]<>#13) and (retString[i]<>#10)) then
                tString:=tString+retString[i];
            end
            else begin
                tString:=tString+retString[i];
            end;
          end;
        end;
        //

        Result:=tString;
      end
      else if CheckMsgUnauthorized(retMsg) then begin
        MessageWarn(Caption, 'Chyba při přihlášení k datové schránce. Nesprávné přihlašovací údaje.',[MBOK]);
        isErr:=TRUE;
      end
      else
        MessageErr(Caption, 'Chyba při čtení seznamu zpráv, '+
          retCode + ': ' + retMsg, [MBOK]);
    finally
      ISDSManager.Free;
      StopW;
      EnableFormControls;
      if isErr then
        btNovaZprava.Enabled:=FALSE;
    end;
  end
  else
    Close;
end;

function CheckMsgUnauthorized(const AMsg: string): Boolean;
begin
  Result := (Pos('UNAUTHORIZED',UpperCase(AMsg))>0) or
    (Pos('401:',AMsg)>0);
end;

//Nacte zpravu podle ID zpravy pomoci webove sluzby a otevre ji ve formulari
// pro prijate zpravy
procedure TfmDatovaSchranka.NactiZpravu(AOnlySaveToDoc: boolean = FALSE);
var
  retCode, retMsg, retString, mappingNames: WideString;
  retCodeZfo, retMsgZfo: WideString;
  res: WordBool;
  ISDSManager: TISDSManager;
  idmsg,msg: string;
  ok, resZfo: boolean;
begin
  DisableFormControls;
  try
    ok:=TRUE;
    idmsg:=IntToStr(taZpravyIDZpravy.Value);

    if (not taZpravyVOZ.AsBoolean) then begin //#5716 VODZ
      ok:=FALSE;
      if TestAndRegisterISDSManager(FALSE, msg) then begin
        StartW('Probíhá přenos zprávy '+idmsg+' z datové schránky ...');
        ISDSManager:= TISDSManager.Create(nil);
        try
          if DirectoryExists(DirWorkDSPath) then
            ClearDirWorkDS;
          ForceDirectories(DirWorkDSPath);

          if ISDSManager.StahniZpravu(FTest, FPrihlJmeno, FPrihlHeslo, FCertif, FPrihlasit, idmsg,
            DirWorkDSPath, retString, mappingNames, retCode, retMsg) then begin

            resZfo:=ISDSManager.StahniZpravuZFO(FTest, FPrihlJmeno, FPrihlHeslo, FCertif, FPrihlasit, idmsg,
              DirWorkDSPath, retCodeZfo, retMsgZfo);
            ok:=TRUE;
            if not AOnlySaveToDoc then begin
              taZpravy.Edit;
              taZpravyTypZpravy.Value:='P';
              taZpravy.Post;
            end;
      //      Memo1.Lines.Text:=retString;
      //      Memo2.Lines.Text:=mappingNames;
      //      ShowMessage('ok '+ retCode + ': ' + retMsg + #13#10#13#10 + retString);
          end
          else if AOnlySaveToDoc and ((Pos('StatusCode: 1206',retMsg)>0) or (Pos('StatusCode: 1207',retMsg)>0)) then
          else
            MessageErr(Caption, 'Chyba při čtení zprávy, '+ retCode + ': ' + retMsg,
            [MBOK]);
        finally
          ISDSManager.Free;
          StopW;
        end;
      end
      else
        Close;
    end;

    if ok then
      OpenMessage(FClientID, FDostupnyArchiv,
        FTest, FPrihlJmeno, FPrihlHeslo, FCertif, FPrihlasit,
        CsvNazvySloupcu+#13#10+taZpravyCsvZaznam.Value, mappingNames,
        FClientAndPar, FALSE, AOnlySaveToDoc);
  finally
    EnableFormControls;
  end;
end;{NactiZpravu}

// pro odeslane zpravy
procedure TfmDatovaSchranka.DoZobrazZpravu(AOnlySaveToDoc: boolean = FALSE);
var
  retCode, retMsg, retString, mappingNames: WideString;
  res: WordBool;
  ISDSManager: TISDSManager;
  idmsg,msg, filname: string;
  ok: boolean;
begin
  idmsg:=IntToStr(taZpravyIDZpravy.Value);
  ok:=TRUE;
  if (not taZpravyVOZ.AsBoolean) then begin   //#5716 neni velkoobjemova zprava
    ok:=FALSE;
    //Zprava neni velkoobjemova
    if TestAndRegisterISDSManager(FALSE, msg) then begin
      StartW('Probíhá přenos zprávy '+idmsg+' z datové schránky ...');
      ISDSManager:= TISDSManager.Create(nil);
      try
        if DirectoryExists(DirWorkDSPath) then
          ClearDirWorkDS;
        ForceDirectories(DirWorkDSPath);
        filname:=NormalPath(DirWorkDSPath)+idmsg+'.zfo';

        if ISDSManager.StahniOdeslanouZpravu(FTest, FPrihlJmeno, FPrihlHeslo,
          FCertif, FPrihlasit, idmsg, filname, retCode, retMsg) then begin
          mappingNames:=ExtractFileName(filname)+'='+filname;
          ok:=TRUE;
    //      Memo1.Lines.Text:=retString;
    //      Memo2.Lines.Text:=mappingNames;
    //      ShowMessage('ok '+ retCode + ': ' + retMsg + #13#10#13#10 + retString);
        end
        else if AOnlySaveToDoc and ((Pos('StatusCode: 1206',retMsg)>0) or (Pos('StatusCode: 1207',retMsg)>0)) then
           //nedelat nic ale pozdeji sem muzeme dat jen prvni hlaseni
        else begin
          MessageErr(Caption, 'Chyba při čtení zprávy, '+ retCode + ': ' + retMsg,
          [MBOK]);
        end;
      finally
        ISDSManager.Free;
        StopW;
      end;
    end
    else
      Close; //neregistrovan isds
  end;

  if ok then
    OpenMessage(FClientID, FDostupnyArchiv,
      FTest, FPrihlJmeno, FPrihlHeslo, FCertif, FPrihlasit,
      CsvNazvySloupcu+#13#10+taZpravyCsvZaznam.Value, mappingNames,
      FClientAndPar, TRUE, AOnlySaveToDoc);
end;{DoZobrazZpravu}

procedure TfmDatovaSchranka.ZobrazZpravu(AOnlySaveToDoc: boolean = FALSE);
begin
  DisableFormControls;
  try
    DoZobrazZpravu(AOnlySaveToDoc);
  finally
    EnableFormControls;
  end;
end;



