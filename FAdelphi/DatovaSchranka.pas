function CalcTypZpravy(const ATyp, AStav: string): string;
begin
  Result := '';
  if ATyp='P' then begin
    if AStav='7' then
      Result:=coDSMsgPrijata//'P' //dorucene a prectene
    else
      Result:=coDSMsgDorucena;//'D'; //dorucene
  end
  else begin
    Result:=Atyp;
  end;
end;

procedure ProtCaption(AProt: TStringList);
begin
{$IFNDEF STANDALONE}
  if (AProt<>nil) then begin
    AProt.Insert(0,Format(sMsgDatSchProtCap,[Application.Title]));
    AProt.Insert(1,'');
    AProt.Insert(1,'');
    //AProt.Insert(1,'');
  end;
{$ENDIF}
end;

procedure ProtHeader(
  var AProt: TStringList;
  const AKlientCap: string);
begin
{$IFNDEF STANDALONE}
  if (AProt<>nil) then begin
    AProt.Add(Format('Klient: %s ',[AKlientCap]));
    AProt.Add('--------------------------------------------------------------------------------');
  end;
{$ENDIF}
end;

procedure Prot2Add(
  var AProt: TStringList;
  const AVOZ: boolean;
  const ATypZpravy, AStavZpravy, AOdesilatel, APrijemce, AVec: string;
  const AIdZpravy: integer;
  const ACasDodani: TDateTime);
var
  t, d, p, adr: string;
begin
{$IFNDEF STANDALONEaa}
  if AVOZ and (AProt<>nil) then begin
    t := CalcTypZpravy(ATypZpravy, AStavZpravy);

    if t=coDSMsgPrijata then begin
      d := sMsgDatSchProtPrijata;                                    
      p := sMsgDatSchProtOd;
      adr := AOdesilatel;
    end
    else if t=coDSMsgDorucena then begin
      d := sMsgDatSchProtPrijata;//sMsgDatSchProtDorucena;
      p := sMsgDatSchProtOd;
      adr := AOdesilatel;
    end
    else begin
      d := sMsgDatSchProtOdeslana;
      p := sMsgDatSchProtPro;
      adr := APrijemce;
    end;

    AProt.Add(Format(sMsgDatSchProtAdd,
      [d, AIdZpravy, DateToStr(ACasDodani),
      p, adr, AVec]));
  end;
{$ENDIF}
end;

function CalcCasDodani(ASl: TStringList; AIx: integer): TDateTime;
var
  dtstr: string;
begin
  Result := 0;
  dtstr:=GetCsvFieldByName(Asl[0]+#13#10+Asl[AIx],'DeliveryTime', 1);
  if dtstr<>'' then begin
    dtstr:=Replace('/',dtstr,'.');  //'2/1/2015 3:09:46' is not a valid date and time.
    dtstr:=Replace(' PM',dtstr,''); //'2/1/2015 3:09:46 PM' is not a valid date and time.
    dtstr:=Replace(' AM',dtstr,'');
    dtstr:=Replace('. ',dtstr,'.'); //'25. 5. 2015 7:50:13' is not a valid date and time.
    Result := StrToDateTime(dtstr);
  end;
end;


//Vraci true, pokud se podarilo najit za carkou a mezerou petimistne cislo
//
function RozdelAdresu(const AVyhledanaSchranka: string; out AJmeno: string;
  out APSC: string; out AMisto: string; out AICO: string): boolean;
var
  p: integer;
const
  cIc= 'IČ:';
begin
  Result:=FALSE;
  AJmeno:=AVyhledanaSchranka;
  AICO:='';
  APsc:='';
  AMisto:='';
  p:=Pos(cIc,AJmeno);
  if p>0 then begin
    AICO:=StrTrimCharLeft(Copy(AJmeno,p+Length(cIc)+1,maxint),'0');
    AJmeno:=Copy(AVyhledanaSchranka,1,p-1);
    AJmeno:=Trim(AJmeno);
    AJmeno:=StrTrimCharRight(AJmeno,',');
    p:=Pos(', ',AJmeno);
    if IsInteger(Copy(AJmeno,p+2,5)) then begin
      APSC:=Copy(AJmeno,p+2,5);
      AMisto:=Copy(AJmeno,p+8);
      AJmeno:=Copy(AJmeno,1,p-1);
      Result:=TRUE;
    end;
  end;
end;

function JoinCaptionDS(const AJmeno: string; AIDDS: string): string;
begin
  if AIDDS<>'' then
    Result:=Trim(AJmeno+' ['+AIDDS+']')
  else
    Result:=AJmeno;
end;

function ZjistiPocetNovychZprav(
  const AClientId: integer;
  ATest: boolean;
  AJmeno: string;
  AHeslo: string;
  AHash:string;
  APrihlasit:Boolean;
  out AErrCode: string;
  AProtokol: TStringList): integer;
var
  retCode, retMsg, retString: WideString;
  res: WordBool;
  ISDSManager: TISDSManager;
  msg, typ, stav: string;
  sl: TStringList;
  i: integer;
  voz, first: boolean;
begin
  first := true;
  if (AJmeno='') and (AHeslo='') then
    Result:=0
  else begin
    Result:=-1;
    if TestAndRegisterISDSManager(TRUE, msg) then begin
      ISDSManager:= TISDSManager.Create(nil);
      try
        if ISDSManager.ZjistiPrijateOdeslaneZpravy(ATest, AJmeno, AHeslo,AHash,APrihlasit,
          0,Date+1,-1,{-1}1023,0,1000, //max pocet zprav
          retString, retCode, retMsg) then begin
          Result:=0;
          sl:=TStringList.Create;
          try
            sl.Text:=retString;
            for i:=1 to sl.Count-1 do begin
              typ:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'TypZpravy', 1);
              stav:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'MessageStatus', 1);

              voz := StrToBoolSafe(GetCsvFieldByName(sl[0]+#13#10+sl[i],'VODZ', 1));
              if voz then begin
                if first then begin
                  if AProtokol.Text<>'' then begin
                    AProtokol.Add('');
                    AProtokol.Add('');
                  end;

{$IFNDEF STANDALONE}
                  ProtHeader(AProtokol, GetAdresNameInform(AClientID));
{$ENDIF}
                end;

                Prot2Add(AProtokol, voz,
                  VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'TypZpravy', 1)),
                  VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'MessageStatus', 1)),
                  VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'Sender', 1)),
                  VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'Recipient', 1)),
                  VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'Annotation', 1)),
                  StrToIntSafe(VarToStr(GetCsvFieldByName(sl[0]+#13#10+sl[i],'MsgID', 1))),
                  CalcCasDodani(sl, i));

                first := false;
              end;

              if (typ='P') and (stav<>'7') then
                INC(Result);
            end;
          finally
            sl.Free;
          end;
        end
        else if CheckMsgUnauthorized(retMsg) then begin
          AErrCode:='Chyba při přihlášení k datové schránce. Nesprávné přihlašovací údaje.';
        end
        else
          AErrCode:='Chyba při čtení seznamu zpráv, '+
            retCode + ': ' + retMsg;
      finally
        ISDSManager.Free;
      end;
    end
    else
      AErrCode:=msg;
  end;
end;

procedure OpenDS(AClientID: integer;
  ADostupnyArchiv: boolean;
  AClientAndPar: string; ATest: boolean = FALSE;
  AJmeno: string = ''; AHeslo: string = '';
  AKlientNazev: string = ''; AIDDS: string = ''; ACertif: string = '';
  AUkladatPrijateDoArchivu: boolean = FALSE);
var
  ok: boolean;
begin
  if (AJmeno='')or(AHeslo='') then
    ok:=ZadejPrihlasovaciUdaje(AJmeno, AHeslo, ATest, ACertif)
  else
    ok:=TRUE;
  if ok then begin
    fmDatovaSchranka:=TfmDatovaSchranka.Create(nil);
    try
      with fmDatovaSchranka do begin
        FClientID:=AClientID;
        FDostupnyArchiv:=ADostupnyArchiv;
        FTest:=ATest;
        FClientAndPar:=AClientAndPar;
        FPrihlJmeno:=AJmeno;
        FUkladatPrijateDoArchivu:=AUkladatPrijateDoArchivu;

        FPrihlHeslo:=AHeslo;
        FCertif := ACertif;
        Caption:='Datová schránka - ' + JoinCaptionDS(AKlientNazev,AIDDS);
        ShowModal;
      end;
    finally
      fmDatovaSchranka.Free;
      fmDatovaSchranka:=nil;
    end;
  end
  else
    MessageInfo('', 'Nebyly zadány přihlašovací údaje k datové schránce. Přihlášení bylo stornováno.',[MBOK]);
end; {OpenDS}


