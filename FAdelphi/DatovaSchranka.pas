  pbLoad.Position:=30;
  pbLoad.Refresh;
  csvData:=NactiSeznamZprav;
  pbLoad.Visible:=FALSE;
  CsvStringToTaZpravy(csvData,'D');
  //tcZalozky.TabIndex:=0;

  btOtevrit.Enabled:=taZpravy.RecordCount>0;
end;

