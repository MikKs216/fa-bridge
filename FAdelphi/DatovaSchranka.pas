procedure TfmDatovaSchranka.CsvStringToTaZpravy(
  const AText: string;
  const ATypZpravy: string);
var
  sl, slProt: TStringList;
  i: integer;
  first: boolean;
  typ, dtstr, logMsg: string;
  deliveryTime: TDateTime;
begin
  StartW('Probíhá přenos seznamu zpráv z datové schránky ...');
  pbLoad.Visible:=TRUE;
  pbLoad.Position:=0;
  first := true;
  DisableFormControls;
  taZpravy.DisableControls;
  tcZalozky.Enabled := false;
  sl:=TStringList.Create;
  slProt:=TStringList.Create;
  try
    meProt.Lines.Clear;
    sl.Text:=AText;
    if sl.Count>0 then begin
      CsvNazvySloupcu:=sl[0];
      pbLoad.Properties.Max:=sl.Count-1;
    end;
    for i:=1 to sl.Count-1 do begin
      pbLoad.Position:=i;
      taZpravy.Append;
      try
        typ:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'TypZpravy', 1);
        taZpravyIDZpravy.Value:=StrToIntSafe(GetCsvFieldByName(sl[0]+#13#10+sl[i],'MsgID', 1));
        taZpravyVec.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'Annotation', 1);
        taZpravyStav.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'MessageStatus', 1);

        taZpravyTypZpravy.Value := CalcTypZpravy(typ, taZpravyStav.Value);

        {if typ='P' then begin
          if taZpravyStav.Value='7' then
            taZpravyTypZpravy.Value:=coTypZpravyP//'P' //dorucene a prectene
          else
            taZpravyTypZpravy.Value:=coTypZpravyD;//'D'; //dorucene
        end
        else begin
          taZpravyTypZpravy.Value:=typ;
        end;}
        
        taZpravyOdesilatelNazev.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'Sender', 1);
        taZpravyOdesilatelAdresa.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'SenderAddress', 1);
        taZpravyPrijemceNazev.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'Recipient', 1);
        taZpravyPrijemceAdresa.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'RecipientAddress', 1);

        taZpravyCisloJednaciNase.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'SenderRefNumber', 1);
        taZpravyCisloJednaciVase.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'RecipientRefNumber', 1);
        taZpravySpisZnNase.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'SenderIdent', 1);
        taZpravySpisZnVase.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'RecipientIdent', 1);
        taZpravyKRukam.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'ToHands', 1);
        taZpravyDoVlastnichRukou.Value:=StrToBoolSafe(GetCsvFieldByName(sl[0]+#13#10+sl[i],'PersonalDelivery', 1));
        {dtstr:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'DeliveryTime', 1);
        if dtstr<>'' then begin
          dtstr:=Replace('/',dtstr,'.');  //'2/1/2015 3:09:46' is not a valid date and time.
          dtstr:=Replace(' PM',dtstr,''); //'2/1/2015 3:09:46 PM' is not a valid date and time.
          dtstr:=Replace(' AM',dtstr,'');
          dtstr:=Replace('. ',dtstr,'.'); //'25. 5. 2015 7:50:13' is not a valid date and time.
          taZpravyCasDodani.Value:=StrToDateTime(dtstr);
        end;}
        taZpravyCasDodani.Value:= CalcCasDodani(sl, i);
        dtstr:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'AcceptanceTime', 1);
        if dtstr<>'' then begin
          dtstr:=Replace('/',dtstr,'.');
          dtstr:=Replace(' PM',dtstr,'');
          dtstr:=Replace(' AM',dtstr,'');
          dtstr:=Replace('. ',dtstr,'.');
          taZpravyCasDoruceni.Value:=StrToDateTime(dtstr);
        end;
        taZpravyVelikostPriloh.Value:=StrToIntSafe(GetCsvFieldByName(sl[0]+#13#10+sl[i],'AttachmentSize', 1));
        taZpravyOdesilatelIDDS.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'IDSender', 1);
        taZpravyPrijemceIDDS.Value:=GetCsvFieldByName(sl[0]+#13#10+sl[i],'IDRecipient', 1);
        //taZpravyVOZ.AsBoolean := taZpravyVelikostPriloh.AsInteger>50; //#5716
        taZpravyVOZ.AsBoolean := StrToBoolSafe(GetCsvFieldByName(sl[0]+#13#10+sl[i],'VODZ', 1));
        taZpravyCsvZaznam.Value:=sl[i];

        {$IFNDEF STANDALONE}
        if FDostupnyArchiv and StrToBoolSafe(GetStringLineValue(FClientAndPar, cSave2DocPodaniPril)) and (taZpravyVOZ.AsBoolean=False) then begin
          //nize se muze doplnit volani aktualizace pro problematicke obdobi
          if taZpravyTypZpravy.Value='P' then begin // prectena
            if not FindDoc(FClientID,IntToStr(taZpravyIDZpravy.Value),cDocumentFolderRecDS, cTypeFolderRecDS, deliveryTime) then begin
              taZpravyWarning.Value:='Zpráva mohla být přečtená mimo FORM studio';
              NactiZpravu(TRUE);
            end;
          end
          else if taZpravyTypZpravy.Value='O' then begin
            deliveryTime:=0;
            if not FindDoc(FClientID,IntToStr(taZpravyIDZpravy.Value),cDocumentFolderSentDS,cTypeFolderSentDS,deliveryTime) then
              DoZobrazZpravu(TRUE)
            else if (taZpravyCasDoruceni.Value>0) and (deliveryTime=0) then begin
              UpdateDoc(FClientID,IntToStr(taZpravyIDZpravy.Value),
                cDocumentFolderSentDS, cTypeFolderSentDS, sl[0]+#13#10+sl[i]);
              //proverime ze se spravne zapsalo do dokumentu vcetne dat                                
              if not IsExistDocData(FClientID,IntToStr(taZpravyIDZpravy.Value),cDocumentFolderSentDS, cTypeFolderSentDS, logMsg) then
                raise Exception.Create('DocDataLost'+#13#10+'(1 - '+logMsg+')');
            end
            else begin
              if not IsExistDocData(FClientID,IntToStr(taZpravyIDZpravy.Value),cDocumentFolderSentDS, cTypeFolderSentDS, logMsg) then begin
                UpdateDoc(FClientID,IntToStr(taZpravyIDZpravy.Value),
                  cDocumentFolderSentDS, cTypeFolderSentDS, sl[0]+#13#10+sl[i]);
                if not IsExistDocData(FClientID,IntToStr(taZpravyIDZpravy.Value),cDocumentFolderSentDS, cTypeFolderSentDS, logMsg) then
                  raise Exception.Create('DocDataLost'+#13#10+'(2 - '+logMsg+')');
              end;
            end;
          end;
        end;
        {$ENDIF STANDALONE}

        if taZpravyVOZ.AsBoolean then begin
          if first then begin
{$IFNDEF STANDALONE}
              ProtHeader(slProt, GetAdresNameInform(FClientID));
{$ENDIF}

            first := false;
          end;

          Prot2Add(slProt, taZpravyVOZ.AsBoolean,
            taZpravyTypZpravy.AsString, taZpravyStav.AsString,
            taZpravyOdesilatelNazev.AsString, taZpravyPrijemceNazev.AsString,
            taZpravyVec.AsString,
            taZpravyIDZpravy.AsInteger, taZpravyCasDodani.AsDateTime);
        end;
      finally
        taZpravy.Post;
      end;
      {$IFNDEF STANDALONE}
      if StrToBoolSafe(GetStringLineValue(FClientAndPar, cSave2DocPodaniPril)) then
        taZpravy.Refresh;
      {$ENDIF STANDALONE}
    end;
    taZpravy.First;


    if (slProt.Text<>'')
      {$IFNDEF STANDALONE}
      and (dmMain.mtParamSave2DocPodaniPril.AsBoolean=true)
      {$ENDIF STANDALONE}
    then begin
      ProtCaption(slProt);
      meProt.Lines.Clear;
      meProt.Lines.Add(slProt.Text);//5716DS
  {$IFNDEF DSAPP}
      if tcZalozky.Properties.Tabs.Count<3 then
        tcZalozky.Properties.Tabs.Add(sMsgDatSchTab);
      tcZalozky.TabIndex := 2;
  {$ENDIF DSAPP}
    end;
    
  finally
    sl.Free;
    slProt.Free;
    StopW;
    pbLoad.Visible:=FALSE;
    EnableFormControls;
    taZpravy.EnableControls;
    tcZalozky.Enabled := true;
  end;
end;

procedure TfmDatovaSchranka.NactiZpravyZaObdobi;
var
  csvData: string;
begin
  taZpravy.EmptyTable;
  pbLoad.Visible:=TRUE;
