procedure Cal(const AFieldName: string; AValue: variant);
begin
  CalN(AFieldName, AValue); //namet #2165
  (*
  with GfaMain do begin
    if not FParamDisableCalcFieldEnabled then begin
      TryEditMtValues;
      GetMTVField(AFieldName).AsVariant := AValue;
    end
    else if mtFields.FindKey([UpperCase(AFieldName)])
      {mtFields.Locate(mtFieldsName.FieldName, AFieldName, //opt
      [loCaseInsensitive])} then
      if mtFieldsIsCalculated.Value then begin
        TryEditMtValues;
        GetMTVField(AFieldName).AsVariant := AValue;
      end;
  end;
  *)
end; {Cal}

//nova funkce, ktera zajisti ze ciselne udaje se zaokrouhli na pocet des. mist podle udaje do ktereo se prirazuje
procedure CalN(const AFieldName: string; AValue: variant);
begin
  with GfaMain do begin
    if mtFields.FindKey([UpperCase(AFieldName)]) then begin
      if (mtFieldsDataType.Value = cNumericTypeValue) or
        (mtFieldsDataType.Value = cCurrencyTypeValue) then begin
        if (not FParamDisableCalcFieldEnabled) or mtFieldsIsCalculated.Value then begin
          TryEditMtValues;
          if AValue=null then
            GetMTVField(AFieldName).Value := null
          else
            GetMTVField(AFieldName).Value :=
              RoundAri(VarToDouble(AValue),-1*mtFieldsDataTypeLength.Value);
        end;
      end
      else begin
        if not FParamDisableCalcFieldEnabled or mtFieldsIsCalculated.Value then begin
          TryEditMtValues;
          GetMTVField(AFieldName).AsVariant := AValue;
        end;
      end;
    end;
  end;
end;

procedure Ini(const AFieldName: string; AValue: variant);
begin
  with GfaMain do begin
    //Default
    if GScriptState = ssDefault then begin
      {if UpperCase(AFieldName) = UpperCase(GScriptFieldName) then} //opt
      if AnsiSameText(AFieldName,GScriptFieldName) then begin
        TryEditMtValues;
        GetMTVField(AFieldName).AsVariant := AValue;
      end;
    end
    //Init
    else if GScriptState = ssInit then begin
      TryEditMtValues;
      GetMTVField(AFieldName).AsVariant := AValue;
    end;
  end;
end; {Ini}

procedure Ino(const AFieldName: string; AValue: variant);
begin
  with GfaMain do
    if GScriptState = ssInit then
      Ini(AFieldName, AValue);
end;

procedure Def(const AFieldName: string; AValue: variant);
begin
  with GfaMain do
    if GScriptState = ssDefault then
      Ini(AFieldName, AValue);
end;

procedure Ena(const AFieldName: string; ACond: boolean);
var
  c: TControl;
  i: integer;
  fld: TField;
begin
  with GfaMain do begin
    if mtFields.FindKey([UpperCase(AFieldName)])
      {mtFields.Locate(mtFieldsName.FieldName, //opt
      AFieldName, [loCaseInsensitive])} and
      (not FParamDisableCalcFieldEnabled or mtFieldsIsSetForEnabling.Value) and
      not ACond and {FParamClearFldAtDisable and} // nepouziva se
      not mtFieldsHasCalc.Value and not mtValues.ReadOnly then begin
      fld := GetMTVField(AFieldName);
      if fld is TBooleanField then begin
        if fld.AsBoolean then begin
          TryEditMtValues;
          fld.AsBoolean := FALSE;
        end;
      end
      else begin
        if fld.AsVariant <> Null then begin
          TryEditMtValues;
          fld.AsVariant := Null;
        end;
      end;
    end;

    for i := 0 to sbForm.ControlCount - 1 do begin
      c := sbForm.Controls[i];
      {if UpperCase(c.Name) = UpperCase(AFieldName) then} //opt
      if AnsiSameText(c.Name,AFieldName) then
        if not FParamDisableCalcFieldEnabled then
          SetReadOnlyControl(c, not ACond, cDefaultDisableFldColor)
        else begin
          if mtFieldsIsSetForEnabling.Value then
            SetReadOnlyControl(c, not ACond, cDefaultDisableFldColor)
          else
            SetReadOnlyControl(c, FALSE, cDefaultDisableFldColor);
        end;
    end;
  end;
end; {Ena}

procedure Chk(const AFieldName: string; ACond: boolean; const AMsg: string;
  AKind: integer = 0);
begin
  with GfaMain do begin
    if ACond then begin
      if not mtChecking.Active then
        mtChecking.Open;
      mtChecking.Append;
      mtCheckingFieldName.Value := AFieldName;
      mtCheckingMessage.Value := AMsg;
      if AKind=10 then
        mtCheckingKind.Value := 4 //chyba EP
      else if AKind=11 then
        mtCheckingKind.Value := 5 //warn EP
      else
        mtCheckingKind.Value := AKind;
      mtChecking.Post;
    end;
  end;
end; {Chk}

procedure Lst(const AFieldName: string;
  const AListName: string; AForDate: TDateTime; const AListFieldName: string;
  const AColumns:string = ''; const AFilter:string = '');
var
  val: variant;
  aStr, txtval: string;
  i: integer;
begin
  with GfaMain do begin
    TryPostMtValues;
    if CountListItems(AFieldName)=2 then begin
      if (GetListItem(AFieldName,0) = GfaMain.FScriptFieldName) and mtValues.Active then begin
        val := OpenListModal(AListName, AForDate, Replace(',',AListFieldName,';'),
          VarArrayOf([GetMTVField(GetListItem(AFieldName,0)).Value,
          GetMTVField(GetListItem(AFieldName,1)).Value]),
          AListFieldName, AColumns, AFilter, GfaMain.Left + 5, GfaMain.Top + 30);
        if (val <> null) and not FStateFormLocked and not mtValues.ReadOnly then begin
          aStr:=VarToStr(val);
          mtValues.Edit;
          GfaMain.SetChangeFlag(True);
          for i:=0 to CountListItems(AFieldName)-1 do begin
            GetMTVField(GetListItem(AFieldName,i)).AsString :=
              GetListItem(aStr,i);
          end;
        end;
      end;
    end
    else begin
      if (AFieldName = GfaMain.FScriptFieldName) and mtValues.Active then begin
        if (CEdit <> nil) and CEdit.Focused then begin
          txtval:=CEdit.EditingText;
          val := OpenListModal(AListName, AForDate, AListFieldName,
            txtval, AListFieldName, AColumns, AFilter, GfaMain.Left + 5, GfaMain.Top + 30);
          if (val <> null) and not FStateFormLocked and
            not mtValues.ReadOnly then begin
            CEdit.EditingText := VarToStr(val);
            CEdit.Text := CEdit.EditingText;
          end;
        end
        else begin
          val := OpenListModal(AListName, AForDate, AListFieldName,
            GetMTVField(AFieldName).Value, AListFieldName, AColumns, AFilter,
            GfaMain.Left + 5, GfaMain.Top + 30);
          if (val <> null) and not FStateFormLocked and
            not mtValues.ReadOnly then begin
            mtValues.Edit;
            GfaMain.SetChangeFlag(True);
            GetMTVField(AFieldName).AsVariant := val;
          end;
        end;
      end;
    end;
  end;
end; {Lst}

procedure SimpleLst(const AFieldName: string; const AListValues: string;
  const AColumnsWidth: string = ''; AResultColumnIndex: integer = 0;
  const ACaption: string = ''; const AColumnNames: string = '';
  const AInitValue: string = '');
var
  val: variant;
  initVal: string;
begin
  with GfaMain do begin
    if (AFieldName = FScriptFieldName) and mtValues.Active then begin
      if (CEdit <> nil) and CEdit.Focused then begin
        if UpperCase(Copy(AListValues,1,4))='PROC' then begin
          if FNewScripter then
            ScripterT.ExecuteSubRoutine(Copy(AListValues,6,maxint))
          else
            Scripter.CallNoParamsMethod(Copy(AListValues,6,maxint));
        end
        else begin
          if AInitValue<>'' then
            initVal:=AInitValue
          else begin
            if AnsiSameText(CEdit.Hint,AFieldName) then
              initVal := CEdit.EditingText;
          end;
          val := OpenSimpleList(AListValues, initVal, AColumnsWidth,
            AResultColumnIndex, ACaption, AColumnNames);
          if (val <> null) and not FStateFormLocked and
            not mtValues.ReadOnly then
            CEdit.EditingText := VarToStr(val);
        end;
      end
      else if (ActiveControl <> nil) and (ActiveControl.Parent <> nil) and
        (ActiveControl.Parent is TCxDBMemoEx) then begin
        if UpperCase(Copy(AListValues,1,4))='PROC' then begin
          if FNewScripter then
            ScripterT.ExecuteSubRoutine(Copy(AListValues,6,maxint))
          else
            Scripter.CallNoParamsMethod(Copy(AListValues,6,maxint));
        end
        else begin
          if AInitValue<>'' then
            initVal:=AInitValue
          else begin
            if AnsiSameText(ActiveControl.Parent.Name,AFieldName) then
              initVal := TCxDBMemoEx(ActiveControl.Parent).EditingText;
          end;
          val := OpenSimpleList(AListValues, initVal, AColumnsWidth,
            AResultColumnIndex, ACaption, AColumnNames);
          if (val <> null) and not FStateFormLocked and
            not mtValues.ReadOnly then
            TCxDBMemoEx(ActiveControl.Parent).EditingText := VarToStr(val);
        end;    
      end;
    end;
  end;
end; {SimpleLst}

