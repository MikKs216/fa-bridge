function ReplaceXmlStr(const AStr: string): string;
begin
  Result := Replace('&amp;', AStr, '&');
  Result := Replace('&lt;', Result, '<');
  Result := Replace('&gt;', Result, '>');
  Result := Replace('&apos;', Result, '''');
  Result := Replace('&quot;', Result, '"');
end; {ReplaceXmlStr}

function TryEncodeDateTimeEx(const AYear,AMonth,ADay,AHour,AMinute,ASecond,
  AMilliSecond : word; out AValue : TDateTime): Boolean;
var
  lDate, LTime : TDateTime;
begin
  Result := False;
  if (AYear >= 1) and (AYear <= 9999) and (AMonth >= 1) and (AMonth <= 12) and
     (ADay >= 1) and (ADay <= DaysInAMonth(AYear,AMonth)) then begin
    lDate := EncodeDate(AYear, AMonth, ADay);
    Result := TRUE;
  end;
  if Result then begin
    if (AHour >= 0) and (AHour <= 23) and (AMinute >= 0) and (AMinute <= 59) and
       (ASecond >= 0) and (ASecond <= 59) and
       (AMilliSecond >= 0) and (AMilliSecond <= 999) then begin
      LTime := EncodeTime(AHour,AMinute,ASecond,AMilliSecond);
      AValue := lDate + LTime;
    end
    else
     AValue := lDate;
  end;
end;

//prevede textovou podobu datumu ve formatu DateTimeFormat na datum (dle systemoveho nastaveni)
//DateTimeFormat - format (maska), napr YYYY-MM-DD, ve kterem je nacitane datum
//DateTimeStr - textova podoba datumu, napr 2013-04-01
//cerpano z http://users.atw.hu/delphicikk/listaz.php?id=2189&oldal=11
function DateTimeStrEval(const DateTimeFormat: string;
  const DateTimeStr: string): TDateTime;
var
  i, ii, iii: integer;
  Retvar: TDateTime;
  Tmp,
    Fmt, Data, Mask, Spec: string;
  Year, Month, Day, Hour,
    Minute, Second, MSec: word;
  AmPm: integer;
begin
  Year := 1;
  Month := 1;
  Day := 1;
  Hour := 0;
  Minute := 0;
  Second := 0;
  MSec := 0;
  Fmt := UpperCase(DateTimeFormat);
  Data := UpperCase(DateTimeStr);
  i := 1;
  Mask := '';
  AmPm := 0;

  while (i < length(Fmt)) and (length(Data) > 0) do
  begin
//    if Fmt[i] in ['A', 'P', 'D', 'M', 'Y', 'H', 'N', 'S', 'Z'] then    //zmena pro skripter
    if (Fmt[i] = 'A') or
       (Fmt[i] = 'P') or
       (Fmt[i] = 'D') or
       (Fmt[i] = 'M') or
       (Fmt[i] = 'Y') or
       (Fmt[i] = 'H') or
       (Fmt[i] = 'N') or
       (Fmt[i] = 'S') or
       (Fmt[i] = 'Z') then
    begin
      // Start of a date specifier
      Mask := Fmt[i];
      ii := i + 1;

      // Keep going till not valid specifier
      while true do
      begin
        if ii > length(Fmt) then
          Break; // End of specifier string
        Spec := Mask + Fmt[ii];

        if (Spec = 'D') or (Spec = 'DD') or (Spec = 'DDD') or (Spec = 'DDDD') or
          (Spec = 'M') or (Spec = 'MM') or (Spec = 'MMM') or (Spec = 'MMMM') or
          (Spec = 'YY') or (Spec = 'YYY') or (Spec = 'YYYY') or
          (Spec = 'HH') or (Spec = 'NN') or (Spec = 'SS') or
          (Spec = 'ZZ') or (Spec = 'ZZZ') or
          (Spec = 'AP') or (Spec = 'AM') or (Spec = 'AMP') or
          (Spec = 'AMPM') then
        begin
          Mask := Spec;
          inc(ii);
        end
        else
        begin
          // End of or Invalid specifier
          Break;
        end;
      end;

      // Got a valid specifier ? - evaluate it from data string
      if (Mask <> '') and (length(Data) > 0) then
      begin
        // Day 1..31
        if (Mask = 'DD') or (Mask = 'D') then
        begin
          Day := StrToIntDef(trim(copy(Data, 1, 2)), 0);
          if (Day = 0) then begin
            Day := StrToIntDef(trim(copy(Data, 1, 1)), 0);
            delete(Data, 1, 1);
          end
          else
            delete(Data, 1, 2);
        end;

        // Day Sun..Sat (Just remove from data string)
        if Mask = 'DDD' then
          delete(Data, 1, 3);

        // Day Sunday..Saturday (Just remove from data string LEN)
        if Mask = 'DDDD' then
        begin
          Tmp := copy(Data, 1, 3);
          for iii := 1 to 7 do
          begin
            if Tmp = Uppercase(copy(LongDayNames[iii], 1, 3)) then
            begin
              delete(Data, 1, length(LongDayNames[iii]));
              Break;
            end;
          end;
        end;

        // Month 1..12
        if (Mask = 'MM') or (Mask = 'M') then
        begin
          Month := StrToIntDef(trim(copy(Data, 1, 2)), 0);
          if (Month = 0) then begin
            Month := StrToIntDef(trim(copy(Data, 1, 1)), 0);
            delete(Data, 1, 1);
          end
          else
            delete(Data, 1, 2);
        end;

        // Month Jan..Dec
        if Mask = 'MMM' then
        begin
          Tmp := copy(Data, 1, 3);
          for iii := 1 to 12 do
          begin
            if Tmp = Uppercase(copy(LongMonthNames[iii], 1, 3)) then
            begin
              Month := iii;
              delete(Data, 1, 3);
              Break;
            end;
          end;
        end;

        // Month January..December
        if Mask = 'MMMM' then
        begin
          Tmp := copy(Data, 1, 3);
          for iii := 1 to 12 do
          begin
            if Tmp = Uppercase(copy(LongMonthNames[iii], 1, 3)) then
            begin
              Month := iii;
              delete(Data, 1, length(LongMonthNames[iii]));
              Break;
            end;
          end;
        end;

        // Year 2 Digit
        if Mask = 'YY' then
        begin
          Year := StrToIntDef(copy(Data, 1, 2), 0);
          delete(Data, 1, 2);
          if Year < TwoDigitYearCenturyWindow then
            Year := (YearOf(Date) div 100) * 100 + Year
          else
            Year := (YearOf(Date) div 100 - 1) * 100 + Year;
        end;

        // Year 4 Digit
        if Mask = 'YYYY' then
        begin
          Year := StrToIntDef(copy(Data, 1, 4), 0);
          delete(Data, 1, 4);
        end;

        // Hours
        if Mask = 'HH' then
        begin
          Hour := StrToIntDef(trim(copy(Data, 1, 2)), 0);
          delete(Data, 1, 2);
        end;

        // Minutes
        if Mask = 'NN' then
        begin
          Minute := StrToIntDef(trim(copy(Data, 1, 2)), 0);
          delete(Data, 1, 2);
        end;

        // Seconds
        if Mask = 'SS' then
        begin
          Second := StrToIntDef(trim(copy(Data, 1, 2)), 0);
          delete(Data, 1, 2);
        end;

        // Milliseconds
        if (Mask = 'ZZ') or (Mask = 'ZZZ') then
        begin
          MSec := StrToIntDef(trim(copy(Data, 1, 3)), 0);
          delete(Data, 1, 3);
        end;

        // AmPm A or P flag
        if (Mask = 'AP') then
        begin
          if Data[1] = 'A' then
            AmPm := -1
          else
            AmPm := 1;
          delete(Data, 1, 1);
        end;

        // AmPm AM or PM flag
        if (Mask = 'AM') or (Mask = 'AMP') or (Mask = 'AMPM') then
        begin
          if copy(Data, 1, 2) = 'AM' then
            AmPm := -1
          else
            AmPm := 1;
          delete(Data, 1, 2);
        end;

        Mask := '';
        i := ii;
      end;
    end
    else
    begin
      // Remove delimiter from data string
      if length(Data) > 1 then
        delete(Data, 1, 1);
      inc(i);
    end;
  end;

  if AmPm = 1 then
    Hour := Hour + 12;
  if not TryEncodeDateTimeEx(Year, Month, Day, Hour, Minute, Second, MSec, Retvar) then  //zmena pro skripter, funkce dephi TryEncodeDateTime hazela AV
    Retvar := 0.0;
  Result := Retvar;
end;

function GetFillingInfo: string;
begin
  Result:='';
  if GFaMain.mtTskpFillingTimeStampSignature.Value<>'' then begin
    Result:=
      sMsgFillingInfo1+#13#10+
      sMsgFillingInfo2+' '+GfaMain.mtTskpFillingDate.Value;
    if GfaMain.mtTskpFillingNumber.Value<>'' then begin
      Result:=Result+#13#10+sMsgFillingInfo3+' '+GfaMain.mtTskpFillingNumber.Value;
      if GfaMain.mtTskpFillingNumber.Value<>GfaMain.mtTskpFillingPassword.Value then //u podani na ZP se uklada do hesla take podaci cislo, tak aby to tady nelezlo dvakrat
        Result:=Result+#13#10+sMsgFillingInfo4+' '+GfaMain.mtTskpFillingPassword.Value;

      if Pos(cEPOfilled, GFaMain.mtTskpFillingTimeStampSignature.Value) > 0 then //je ulozeno
      begin                                                                                   
        Result:=Result+#13#10+ Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,
          Pos(cEPOfilled, GFaMain.mtTskpFillingTimeStampSignature.Value),
          Length(GFaMain.mtTskpFillingTimeStampSignature.Value));
      end;
    end
    else begin //FillingNumber je prazdne, je pravdepodobne ze je to podani na CSSZ, tak zobrazime TimeStampSignature
      if GfaMain.mtTskpFillingPassword.Value<>'' then
        Result:=Result+#13#10+sMsgFillingInfo6+':'+#13#10+GfaMain.mtTskpFillingTimeStampSignature.Value;
    end;
    if Pos(cDSfilled,GFaMain.mtTskpFillingTimeStampSignature.Value)>0 then begin
      if Pos(':',GFaMain.mtTskpFillingTimeStampSignature.Value)>0 then
        Result:=Result+#13#10+sMsgFillingInfo5+#13#10+'id: '+
          Copy(GFaMain.mtTskpFillingTimeStampSignature.Value,
            Pos(':',GFaMain.mtTskpFillingTimeStampSignature.Value)+1,MaxInt)
      else
        Result:=Result+#13#10+sMsgFillingInfo5;
    end;
  end;
end;

