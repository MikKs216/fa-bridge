procedure InsertLogoToPDF(const APDFName: string; APosX: integer; APosY: integer;
  AWidthMax: integer = 100; AheightMax: integer = 80; const AImgPath: string = '');
var
  Lib:TPDFLibrary;
  Doc:TPDFDocument;
  PB:TPDFPaintBox;
  Img : TPDFImage;
  i: integer;
  pomer: double;
  ms: TMemoryStream;
  logoExists: boolean;
begin
  Lib := TPDFLibrary.Create('KASTNER software s.r.o.','5TXV2-L2RPY-J7ULE-N7ETG-ERRFM');
  try
    logoExists := FALSE;
    Doc := TPDFDocument.Create(Lib);
    try
      Doc.LoadFromFile(NormalPath(GfaMain.DirWorkPath)+APDFName);
      if AImgPath<>'' then begin
        if FileExists(AImgPath) then begin
          Img := TPDFImage.CreateFromFile(Lib,AImgPath,0);
          logoExists := TRUE;
        end
      end
      else begin
        {$IFDEF STANDALONE}
        if FileExists(NormalPath(ExtractFilePath(Application.ExeName))+'logo.bmp') then begin
          Img := TPDFImage.CreateFromFile(Lib,
            NormalPath(ExtractFilePath(Application.ExeName))+'logo.bmp',0);
          logoExists := TRUE;
        end
        else if FileExists(NormalPath(ExtractFilePath(Application.ExeName))+'logo.jpg') then begin
          Img := TPDFImage.CreateFromFile(Lib,
            NormalPath(ExtractFilePath(Application.ExeName))+'logo.jpg',0);
          logoExists := TRUE;
        end;
        {$ELSE STANDALONE}
        ms:=TMemoryStream.Create;
        try
          logoExists := GetLogo(GfaMain.FClientID, ms) > 0;
          if logoExists then
            Img := TPDFImage.CreateFromStream(Lib,ms,0);
        finally
          ms.Free;
          ms:=nil;
        end;
        {$ENDIF STANDALONE}
      end;
      if logoExists then begin
        try
          i := Doc.ImageAppend(Img,victJPEG);
          PB := Doc.Pages[0].PaintBox;
          pomer := Img.Width/Img.Height;
          if pomer>=(AWidthMax/AHeightMax) then
            PB.ShowImage(i, APosX, APosY, AWidthMax, Round(AWidthMax/pomer), 0 )
          else
            PB.ShowImage(i, APosX, APosY, Round(AHeightMax*pomer), AHeightMax, 0 );
        finally
          Img.Free;
        end;
      end;
      Doc.SaveToFile(NormalPath(GfaMain.DirWorkPath)+'logowork.pdf');
    finally
      Doc.Free;
    end;
    if FileExists(NormalPath(GfaMain.DirWorkPath)+'logowork.pdf') then begin
      DeleteFile(NormalPath(GfaMain.DirWorkPath)+APDFName);
      RenameFile(NormalPath(GfaMain.DirWorkPath)+'logowork.pdf',
        NormalPath(GfaMain.DirWorkPath)+APDFName);
    end;
  finally
    Lib.Free;
  end;
end;

