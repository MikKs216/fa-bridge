function ConvertAFlags2TMsgDlgButtons(const AFlags: longint): TMsgDlgButtons;
{  TMsgDlgBtn = (mbYes, mbNo, mbOK, mbCancel, mbAbort, mbRetry, mbIgnore,
    mbAll, mbNoToAll, mbYesToAll, mbHelp);

MB_OK 	OK
MB_OKCANCEL 	OK
MB_ABORTRETRYIGNORE
MB_YESNOCANCEL 	Yes
MB_YESNO 	Yes
MB_RETRYCANCEL
MB_HELP}
begin
  if AFlags=MB_OK then
    Result := [MBOK]
  else if AFlags=MB_OKCANCEL then
    Result := [MBOK, MBCANCEL]
  else if AFlags=MB_YESNO then
    Result := [MBYES, MBNO]
  else if AFlags=MB_YESNOCANCEL then
    Result := [MBYES, MBNO, MBCANCEL]
  else
    Result := [];
end;

