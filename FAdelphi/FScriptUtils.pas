//Zkusi zjistit jestli je v clipboardu postovni adresa a pokud je, tak rozebere
// a preda ve tvaru csv: psc,"obec","ulice","jmeno1","jmeno2","jmeno3"
// kterykoliv udaj muze byt pradny ale odelovace tam budou vzdycky, takze se da
// priradit podle poradi udaju napr.: a:=GetAdrClip; GetListItem(a,3) ... vezme 4. udaj
{  Porozumi adrese zadane takto:
   1.         2.         3.                4.
   jmeno2     jmeno1     jmeno1 nebo ulice  jmeno
   jmeno1     ulice      psc obec          psc obec, ulice
   ulice      psc obec
   psc obec                                (i s dvema radky jmena nebozadnym)

   5. nebo totez kdyz je misto noveho radku carka
}
function GetAdrClip: string;
var c,rad,psc,zaPsc,obec,ulice,msgshow: string;
  sl,sl1:TStringList;
  i,radekSpsc: Integer;

  procedure HledejPscZepredu;
  var i: Integer;
  begin
    for i:= 0 to sl.Count - 1 do begin
      rad:=Trim(sl[i]);
      psc:=Replace(' ',Copy(rad,1,6),'');
      if IsInteger(psc) then begin
        Result:=Result+psc+',';
        zaPsc:=Trim(Copy(rad,7,200));
        if Pos(',',zaPsc)>0 then begin
          obec:=Copy(zaPsc,1,Pos(',',zaPsc)-1);
          ulice:=Copy(zaPsc,Pos(',',zaPsc)+1,200);
          Result:=Result+'"'+obec+'","'+ulice+'"';
          radekSpsc:=i;
          Break;
        end
        else begin
          obec:=zaPsc;
          Result:=Result+'"'+obec+'"';
          radekSpsc:=i;
          Break;
        end;
      end;
    end;
  end;
  procedure HledejPscZezadu;
  var i: Integer;
  begin
    for i:= sl.Count - 1 downto 0 do begin
      rad:=Trim(sl[i]);
      psc:=Replace(' ',Copy(rad,Length(rad)-5,6),'');
      if IsInteger(psc) then begin
        Result:=Result+psc+',';
        zaPsc:=Trim(Copy(rad,1,Length(rad)-6));
        if Pos(',',zaPsc)>0 then begin
          obec:=Copy(zaPsc,1,Pos(',',zaPsc)-1);
          ulice:=Copy(zaPsc,Pos(',',zaPsc)+1,200);
          Result:=Result+'"'+obec+'","'+ulice+'"';
          radekSpsc:=i;
          Break;
        end
        else begin
          obec:=zaPsc;
          Result:=Result+'"'+obec+'"';
          radekSpsc:=i;
          Break;
        end;
      end;
    end;
  end;
begin
  Result:='';
  c:=ClipBoard.AsText;
  sl:=TStringList.Create;
  sl1:=TStringList.Create;
  try
    sl1.Text:=c;
    //vyhodime prazdne radky
    for i:= 0 to sl1.Count - 1 do begin
      if Trim(sl1[i])<>'' then
        sl.Add(Trim(sl1[i]));
    end;
    //hledame psc na zacatku radku
    radekSpsc:=-1;
    obec:='';
    ulice:='';
    //if sl.Count=1 then
    sl.Text:=Replace(',',sl.Text,#13#10);
    //
    HledejPscZepredu;
    //kdyz nebylo psc na zacatku tak zkusime hledat psc na konci radku
    if radekSpsc=-1 then
      HledejPscZezadu;
    //ani zezadu se nenaslo - zapiseme radky jak jdou po sobe
    if radekSpsc=-1 then begin
      Result:='';
      for i:= sl.Count - 1 downto 0 do
        Result:=Result+',"'+sl[i]+'"';
    end
    else begin
      //nasel se radek s psc
      if radekSpsc=1 then
        Result:=Result+',"'+sl[radekSpsc-1]+'"'
      else if radekSpsc=2 then
        Result:=Result+',"'+sl[radekSpsc-1]+'","'+sl[radekSpsc-2]+'"'
      else if radekSpsc=3 then
        Result:=Result+',"'+sl[radekSpsc-1]+'","'+sl[radekSpsc-2]+'","'+sl[radekSpsc-3]+'"'
      else if radekSpsc>3 then
        Result:=Result+',"'+sl[radekSpsc-1]+'","'+sl[radekSpsc-2]+'","'+sl[radekSpsc-3]+'","'+sl[radekSpsc-4]+'"'
      else if (radekSpsc=0) and (sl.Count>1) then
        Result:=Result+',"'+sl[1]+'"';
    end;
    Result:=Result+',,,,,';
  finally
    sl.Free;
    sl1.Free;
  end;

  msgshow:=Trim(Trim(GetListItem(Result,5))+' '+Trim(GetListItem(Result,4))+' '+
    Trim(GetListItem(Result,3))+' '+Trim(GetListItem(Result,2))+' '+
    Trim(GetListItem(Result,0))+' '+Trim(GetListItem(Result,1)));
  if msgshow='' then begin
    MsgBoxInfo(GfaMain.Caption, sMsgEmptyClipboard, MB_OK);
    Result:='';
  end
  else if MsgBoxAsk(GfaMain.Caption, sMsgAskGetClipboard+' ('+sMsgAskGetClipboard1+': '+msgshow+')',
    MB_YESNO)<>IDYES then begin
    Result:='';
  end;
end;

