{EncDate
   Zakoduje datum dle jednotlivych slozek. Pokud AYear neni v rozsahu
   1..9999 pouzije aktualni rok, Pokud AMonth neni v rozsahu 1..12 pouzije 1,
   pokud ADay neni v rozsahu 1..posledni den mesice, pouzije 1.
   Argumenty mohou byt i nezadane.
}

function EncDate(AYear: Word = 0; AMonth: Word = 1; ADay: Word = 1): TDateTime;
begin
  if (AYear < 1) or (AYear > 9999) then
    AYear := CurrentYear;
  if (AMonth < 1) or (AMonth > 12) then
    AMonth := 1;
  if (ADay < 1) or (ADay > DaysInAMonth(AYear, AMonth)) then
    ADay := 1;
  Result := EncodeDate(AYear, AMonth, ADay);
end; {EncDate}

function AppendToText(const AText, ALine: string; ANewLine: boolean): string;
begin
  if AText = '' then
    Result := ALine
  else if ALine = '' then
    Result := AText
  else if ANewLine then
    Result := AText + cCRLF + ALine
  else
    Result := AText + ', ' + ALine
end; {AppendToText}

