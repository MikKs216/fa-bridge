function CreateHBWithImportCSV(const ABaUcet,
  AKodBanky, AFormatHB: string;
  const APrevPrikCsv, APrevPrikPCsv, ABoFirmaCsv, AFirmaUctCsv: string;
  var AOutText, AMsg: string): boolean;
begin
  if dmPrevPrik = nil then
    Application.CreateForm(TdmPrevPrik, dmPrevPrik);
  try
    Result := dmPrevPrik.CreateHBWithImportCSV(ABaUcet, AKodBanky, AFormatHB,
      APrevPrikCsv, APrevPrikPCsv, ABoFirmaCsv, AFirmaUctCsv, AOutText, AMsg);
  finally
    dmPrevPrik.Free;
    dmPrevPrik:=nil;
  end;
end;

