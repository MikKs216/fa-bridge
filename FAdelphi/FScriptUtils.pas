//treti verze
function PackPDF3(const APDFNameIn: string; const APDFNameOut: string): boolean;
var
  gtPDFDocument: TgtPDFDocument;
begin
  Result:=True;
  gtPDFDocument := TgtPDFDocument.Create(nil);
  try try
    if FileExists(GetDataPrgPath+'blank.pdf') then
      gtPDFDocument.LoadFromFile(GetDataPrgPath+'blank.pdf');
    gtPDFDocument.AppendPagesFrom(APDFNameIn,'1-'); //pripadna neexistence souboru nebo poskozeni se automaticky nahlasi dale
    gtPDFDocument.DeletePages('1');                 // stava se, ze to pri opakovanem nacteni spadne, proto vracime false
    gtPDFDocument.SaveToFile(APDFNameOut);          // a pouzijeme na to pak jiny zpusob pakovani
  except
    Result:=False;
  end;
  finally
    gtPDFDocument.Free;
  end;
end;

procedure PackPDF(const APDFNameIn: string; const APDFNameOut: string);
begin
  if not PackPDF3(APDFNameIn,APDFNameOut) then // kdyz neprojde zpusob 3, zkusime zpusob 2
    PackPDF2(APDFNameIn,APDFNameOut);
end;

