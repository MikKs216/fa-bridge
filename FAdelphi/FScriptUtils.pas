 -----------------------------------------------------------------------------}

function GetValidDateStrFmt(ADate: TDateTime;
  AFmt: string = 'DD.MM.YYYY'): string;
begin
  if ADate > 0 then
    Result := FormatDateTime(AFmt, ADate)
  else
    Result := '';
end; {GetValidDateStr}

function ValidValue(const ASrcFieldNames: string; AValue: Variant;
  AZeroValueClear: boolean = FALSE): Variant;
var
  i: integer;
  fld: TField;
  allIsNull: boolean;
begin
  allIsNull := TRUE;
  for i := 1 to CountListItems(ASrcFieldNames) do begin
    fld := GetMTVField(GetListItem(ASrcFieldNames, i - 1));
    if (fld <> nil) and (VarType(fld.Value)= varString) then begin
      if fld.Value<>'' then
        allIsNull := FALSE;
    end
    else begin
      if (fld <> nil) and not fld.IsNull then
        allIsNull := FALSE;
    end;
  end;
  if allIsNull then
    Result := null
  else
    Result := AValue;
  if AZeroValueClear and
    ((VarType(Result)= varInteger)or(VarType(Result)= varDouble)or
      (VarType(Result)= varCurrency)) and (Result=0) then
      Result := null;
end; {ValidValue}

