function GetForms(const ADefID: string; AMultiselect: boolean = FALSE;
  const ACaption: string = '';AOrder: string = ''): string;
var
  formList, sl: TStringList;
  i, j: integer;
  guids,idDef: string;
{$IFDEF STANDALONE}
  ok: boolean;
{$ENDIF STANDALONE}
begin
  Result := '';
  formList := TStringList.Create;
  sl := TStringList.Create;
  try
    GfaMain.FScriptGetFormsIDDefs:='';
    GfaMain.GetFormsExGUID(ADefID, guids,
      AMultiselect, ACaption, IntToStr(GfaMain.FDatabaseIDForm), AOrder);
    formList.Text := guids;
{$IFDEF STANDALONE}
    for i := 0 to formList.Count - 1 do begin
      if ExtractFileExt(formList[i])=cFRMXDefaultExt then //#2822
        sl.Text := GetSection(GfaMain.GetFormXMLDataText(formList[i]),cFormHeadLabel)
      else
        sl.Text := GetSection(GfaMain.GetFormDataText(formList[i]),cFormHeadLabel);
      idDef := sl.Values[GfaMain.mtTskpDefID.FieldName];
      GfaMain.FScriptGetFormsIDDefs := AddValueToList(GfaMain.FScriptGetFormsIDDefs, idDef);
    end;
    //kontrola vyberu formularu se stejnou definici
    if (formList.Count > 0) and (GfaMain.FSlaveState = ssNone) then begin
      for i := 0 to formList.Count - 1 do begin
        if ExtractFileExt(formList[i])=cFRMXDefaultExt then
          sl.Text := GetSection(GfaMain.GetFormXMLDataText(formList[i]), cFormHeadLabel)
        else
          sl.Text := GetSection(LoadStringFromFile(formList[i]), cFormHeadLabel);
        idDef := sl.Values[GfaMain.mtTskpDefID.FieldName];
        GfaMain.FScriptGetFormsIDDefs := AddValueToList(GfaMain.FScriptGetFormsIDDefs, idDef);
        ok := FALSE;
        for j := 0 to CountListItems(ADefID) - 1 do begin
          if idDef = GetListItem(ADefID, j) then
            ok := TRUE;
        end;
        if not OK then begin
          MessageWarn(GfaMain.Caption, Format(SmsgNoCorrectDefinition,
            [formList[i]]), [MBOK]);
          formList.Delete(i);
        end;
      end;
    end;
{$ELSE STANDALONE}
    for i := 0 to formList.Count - 1 do begin
      sl.Text := GetSection(GfaMain.GetFormDataText(formList[i]),
        cFormHeadLabel);
      idDef := sl.Values[GfaMain.mtTskpDefID.FieldName];
      GfaMain.FScriptGetFormsIDDefs := AddValueToList(GfaMain.FScriptGetFormsIDDefs, idDef);
    end;
    for i := 0 to formList.Count - 1 do begin
      sl.Text := GetSection(GfaMain.GetFormDataText(formList[i]),
        cFormHeadLabel);
      idDef := sl.Values[GfaMain.mtTskpDefID.FieldName];
      GfaMain.FScriptGetFormsIDDefs := AddValueToList(GfaMain.FScriptGetFormsIDDefs, idDef);
    end;
{$ENDIF STANDALONE}
    if formList.Count = 1 then
      Result := formList[0]
    else
      Result := formList.Text;
  finally
    formList.Free;
    sl.Free;
  end;
end; {GetForms}

