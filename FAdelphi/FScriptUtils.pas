//vygeneruje parametry obdobi pro ulozeni do tabulky formularu
//ve formatu yyyy,dd.mm.yyyy,dd.mm.yyyy,text
//poradi si s:
//  'yyyy'                    rok
//  'yyyy,m'                  rok n-ty mesic
//  'yyyy,n,q'                rok n-te ctvrtleti
//  'dd.mm.yyyy'              datum
//  'dd.mm.yyyy,dd.mm.yyyy'   obdobi od data do data
//  ''                        nezadane datum - da dnesni

function CalcPeriod(const APeriod: string): string;
const
  dlm = ',';
var
  n: integer;
  s, s2, s3, d, d2, y, m, qrt, a, b: string;
begin
  try
    s := '';
    s2 := '';
    s3 := '';
    y := '';
    m := '';
    qrt := '';
    d := '';
    d2 := '';
    if APeriod = '' then begin //''
      DateTimeToString(d, cFADateMask, Date);
    end
    else begin
      n := CountListItems(APeriod);
      if n > 0 then begin
        s := GetListItem(APeriod, 0);
        if IsInteger(s) then
          y := s
        else if IsDate(s) then
          d := s;
      end;
      if n > 1 then begin
        s2 := GetListItem(APeriod, 1);
        if (n > 2) and (GetListItem(APeriod, 2) <> '') then
          begin //je treti parametr
          s3 := GetListItem(APeriod, 2);
          if (UpperCase(s3) = 'Q') and
            IsInteger(s2) then
            qrt := s2;
        end
        else begin
          if IsInteger(s2) and (GetListItem(APeriod, 1) <> '') then
            m := s2
          else if IsDate(s2) then
            d2 := s2;
        end;
      end;
    end;
    //
    if (d <> '') and (d2 <> '') then
      Result := IntToStr(YearOf(StrToDate(d2))) + dlm + d + dlm + d2 + dlm + '"'
        + d + '..' + d2 + '"'
    else if (d <> '') then
      Result := IntToStr(YearOf(StrToDate(d))) + dlm + d + dlm + d + dlm + d
    else if (y <> '') and (qrt <> '') then begin
      if qrt = '1' then begin
        a := DateToStr(EncodeDate(StrToInt(y), 1, 1));
        b := DateToStr(EncodeDate(StrToInt(y), 3, 31));
      end
      else if qrt = '2' then begin
        a := DateToStr(EncodeDate(StrToInt(y), 4, 1));
        b := DateToStr(EncodeDate(StrToInt(y), 6, 30));
      end
      else if qrt = '3' then begin
        a := DateToStr(EncodeDate(StrToInt(y), 7, 1));
        b := DateToStr(EncodeDate(StrToInt(y), 9, 30));
      end
      else if qrt = '4' then begin
        a := DateToStr(EncodeDate(StrToInt(y), 10, 1));
        b := DateToStr(EncodeDate(StrToInt(y), 12, 31));
      end;
      Result := Result + y + dlm + a + dlm + b + dlm + '"' + y + ' ' + qrt + '. '
        + sQrt + '"'
    end
    else if (y <> '') and (m <> '') then
      Result := y + dlm +
        '01' + DateSeparator + StrPadLeft(m, 2, '0') + DateSeparator + y + dlm +
        StrPadLeft(IntToStr(DaysInAMonth(StrToInt(y), StrToInt(m))), 2, '0') +
        DateSeparator + m + DateSeparator + y + dlm +
        '"' + y + ' ' + m + '. ' + sMonth + '"'
    else if y <> '' then
      Result := y + dlm + '01' + DateSeparator + '01' + DateSeparator + y + dlm
        +
        '31' + DateSeparator + '12' + DateSeparator + y + dlm + y;
  except
    Result := dlm + dlm + dlm;
  end;
end;

//AmountByWords
//  castka slovy
//  vraci hodnotu vyjadrenou slovy
//
type
  TSlovniRod = (srM, srZ, srS);

function AmountByWords(AValue: extended;
  AUpperFirstChar: boolean = FALSE): string;

  function Jednotky(AValue: integer; ARod: TSlovniRod): string;

    function OdectiMax(var AValue: integer): string;
    begin
      if AValue >= 900 then begin
        Result := s900;
        DEC(AValue, 900);
      end
      else if AValue >= 800 then begin
        Result := s800;
        DEC(AValue, 800);
      end
      else if AValue >= 700 then begin
        Result := s700;
        DEC(AValue, 700);
      end
      else if AValue >= 600 then begin
        Result := s600;
        DEC(AValue, 600);
      end
      else if AValue >= 500 then begin
        Result := s500;
        DEC(AValue, 500);
      end
      else if AValue >= 400 then begin
        Result := s400;
        DEC(AValue, 400);
      end
      else if AValue >= 300 then begin
        Result := s300;
        DEC(AValue, 300);
      end
      else if AValue >= 200 then begin
        Result := s200;
        DEC(AValue, 200);
      end
      else if AValue >= 100 then begin
        Result := s100;
        DEC(AValue, 100);
      end
      else if AValue >= 90 then begin
        Result := s90;
        DEC(AValue, 90);
      end
      else if AValue >= 80 then begin
        Result := s80;
        DEC(AValue, 80);
      end
      else if AValue >= 70 then begin
        Result := s70;
        DEC(AValue, 70);
      end
      else if AValue >= 60 then begin
        Result := s60;
        DEC(AValue, 60);
      end
      else if AValue >= 50 then begin
        Result := s50;
        DEC(AValue, 50);
      end
      else if AValue >= 40 then begin
        Result := s40;
        DEC(AValue, 40);
      end
      else if AValue >= 30 then begin
        Result := s30;
        DEC(AValue, 30);
      end
      else if AValue >= 20 then begin
        Result := s20;
        DEC(AValue, 20);
      end
      else if AValue >= 19 then begin
        Result := s19;
        DEC(AValue, 19);
      end
      else if AValue >= 18 then begin
        Result := s18;
        DEC(AValue, 18);
      end
      else if AValue >= 17 then begin
        Result := s17;
        DEC(AValue, 17);
      end
      else if AValue >= 16 then begin
        Result := s16;
        DEC(AValue, 16);
      end
      else if AValue >= 15 then begin
        Result := s15;
        DEC(AValue, 15);
      end
      else if AValue >= 14 then begin
        Result := s14;
        DEC(AValue, 14);
      end
      else if AValue >= 13 then begin
        Result := s13;
        DEC(AValue, 13);
      end
      else if AValue >= 12 then begin
        Result := s12;
        DEC(AValue, 12);
      end
      else if AValue >= 11 then begin
        Result := s11;
        DEC(AValue, 11);
      end
      else if AValue >= 10 then begin
        Result := s10;
        DEC(AValue, 10);
      end
      else if AValue >= 9 then begin
        Result := s9;
        DEC(AValue, 9);
      end
      else if AValue >= 8 then begin
        Result := s8;
        DEC(AValue, 8);
      end
      else if AValue >= 7 then begin
        Result := s7;
        DEC(AValue, 7);
      end
      else if AValue >= 6 then begin
        Result := s6;
        DEC(AValue, 6);
      end
      else if AValue >= 5 then begin
        Result := s5;
        DEC(AValue, 5);
      end
      else if AValue >= 4 then begin
        Result := s4;
        DEC(AValue, 4);
      end
      else if AValue >= 3 then begin
        Result := s3;
        DEC(AValue, 3);
      end
      else if AValue >= 2 then begin
        DEC(AValue, 2);
        case ARod of
          srM: Result := sdva;
        else
          Result := sdve;
        end;
      end
      else if AValue >= 1 then begin
        DEC(AValue, 1);
        case ARod of
          srM: Result := sjeden;
          srZ: Result := sjedna;
        else
          Result := sjedno;
        end;
      end
      else begin
        Result := '';
      end;
    end; {OdectiMax}
  begin
    Result := '';
    while AValue > 0 do
      Result := Result + OdectiMax(AValue);
  end; {Jednotky}

  function HasLast1(AValue: integer): boolean;
  begin
    Result := (AValue mod 10 = 1) and (AValue mod 20 <> 11);
  end; {hasLast1}

  function HasLast234(AValue: integer): boolean;
  var
    m10, m20: integer;
  begin
    m10 := AValue mod 10;
    m20 := AValue mod 20;
    Result := (m10 = 2) and (m20 <> 12) or (m10 = 3) and (m20 <> 13) or (m10 = 4)
      and (m20 <> 14);
  end; {HasLast234}

  function Tisice(AValue: integer): string;
  begin
    if AValue = 0 then
      Result := ''
    else begin
      Result := Jednotky(AValue, srM);
      if HasLast234(AValue) then
        Result := Result + stisice
      else
        Result := Result + stisic;
    end;
  end; {Tisice}

  function Miliony(AValue: integer): string;
  begin
    if AValue = 0 then
      Result := ''
    else begin
      Result := Jednotky(AValue, srM);
      if HasLast1(AValue) then
        Result := Result + smilion
      else if HasLast234(AValue) then
        Result := Result + smiliony
      else
        Result := Result + smilionu;
    end;
  end; {Miliony}

  function Miliardy(AValue: integer): string;
  begin
    if AValue = 0 then
      Result := ''
    else begin
      Result := Jednotky(AValue, srZ);
      if HasLast1(AValue) then
        Result := Result + smiliarda
      else if HasLast234(AValue) then
        Result := Result + smiliardy
      else
        Result := Result + smiliard;
    end;
  end; {Miliardy}
var
  v: integer;
begin
  if (AValue > MaxInt) or (AValue < -MaxInt) then
    Result := FloatToStr(AValue)
  else begin
    v := Round(Int(Abs(AValue)));
    if v = 0 then
      Result := snula
    else begin
      if AValue < 0 then
        Result := sminus
      else
        Result := '';
      Result := Trim(Result + ' ' + Miliardy(v div Round(1E9)));
      v := v mod Round(1E9);
      Result := Trim(Result + ' ' + Miliony(v div Round(1E6)));
      v := v mod Round(1E6);
      Result := Trim(Result + ' ' + Tisice(v div Round(1E3)));
      v := v mod Round(1E3);
      Result := Trim(Result + ' ' + Jednotky(v, srZ));
    end;
  end;
  if AUpperFirstChar then
    Result := AnsiUpperCase(Copy(Result, 1, 1)) + Copy(Result, 2, maxint);
end; {AmountByWords}

