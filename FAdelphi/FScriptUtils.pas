function GetValidDateStr(ADate: TDateTime; ADateString: string = ''): string;
begin
  if ADate > 0 then
    if ADateString <> '' then
      Result := ADateString
    else
      Result := DateToStr(ADate)
  else
    Result := '';
end; {GetValidDateStr}

