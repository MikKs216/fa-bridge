procedure DoPrintForm(const AFormData: string;
   ASendMail: boolean; AOnlyPrepareFile: boolean; var AOutPDFFileName: string);
var
  sl: TStringList;
  st: TMemoryStream;
  gfaMainStore: TfaMain;
  dkResultTemp, dkResultFileName: string;
begin
  sl:= TStringList.Create;
  st:= TMemoryStream.Create;
  sl.Text:=AFormData;
  sl.SaveToStream(st);

  //zapamatujeme si DKresult.txt puvodniho formulare
  {$IFNDEF  STEREONX}
    dkResultFileName:=NormalPath(ExtractFilePath(Application.ExeName)) + 'DKresult.txt';
  {$ELSE}
    //#MR 2025 DKresult je bud u exe nebo v podslozce Forms allUser nebo Useer 
    dkResultFileName:=NormalPath(SpolFunkce.gFUserDataPath) + 'DKresult.txt';
  {$ENDIF}

  if FileExists(dkResultFileName) then
    dkResultTemp:=LoadStringFromFile(dkResultFileName);

  if GfaMain.mtValues.State in [dsEdit, dsInsert] then
    GfaMain.mtValues.Post;    
  gfaMainStore:=GfaMain;
  try
      {$IFDEF STANDALONE}
    DoFAPrintForm(
      GfaMain.FClientID, st, ASendMail, AOnlyPrepareFile,
      nil,
      AOutPDFFileName, GfaMain.Left, GfaMain.Top);
      {$ELSE STANDALONE}
    {$IFDEF FA_APP}
    DoFAPrintForm(
      GfaMain.FClientID, st, ASendMail, AOnlyPrepareFile,
      FProcGetFormFromDBGUID,  //oprava 12.12.2017 #2519
      AOutPDFFileName, GfaMain.Left, GfaMain.Top);
    {$ENDIF FA_APP}
      {$ENDIF STANDALONE}
  finally
    GfaMain:=gfaMainStore;
    //obnovime DKresult.txt puvodniho formulare, ktery byl prepsan volanym formularem
    if FileExists(dkResultFileName) then
      SaveStringToFile(dkResultTemp,dkResultFileName);
    sl.Free;
    st.Free;
  end;
end;

