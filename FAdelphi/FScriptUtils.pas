//Specialni funkce pro podporu tisku vice priloh z jednoho fomulare, kde jsou
//  tabulky prepinane z dat ulozenych v textu (napr silnicni dan)
//Podle tabulek vygeneruje PDF a dalsi scripty k nim, kde jsou data z tabulky
//  Vstup: ATableDataText ... data tabulky v textu ve formatu ini, pripdane
//                            muze byt decimal separator nahrazen strednikem ;
//         APDFFileName ... nazev sestavy prilohy
//         ARowsInPriloha ... pocet radku v jedne priloze
//         AShiftRows ... pocet radku na zakladnim formulari
//         APageCount ... pocet stran, pokud jej chceme nastavit uz ze scriptu,
//                        jinak pocita podle potreb silnicni dane
//  Vraci: seznam priloh

function CreatePrintDataForTable(const ATableDataText,
  ADPFFileName: string; ARowsInPriloha, AShiftRows: integer;
  APageCount: integer = -1): string;
var
  sl: TStringList;
  maxcr, pocetPriloh, i, j, k, newRow, posRovn: integer;
  pdfFileName: string;
begin
  StartWait;
  Result := '';
  sl := TStringList.Create;
  try
    //zjistit nejvyssi cislo radku
    sl.Text := ATableDataText;
    sl.Sorted := TRUE;
    if sl.Count > 0 then
      maxcr := StrToIntSafe(Copy(sl[sl.Count - 1], 2, 4))
    else
      maxcr := 0;
    //pocet priloh
    if APageCount=-1 then
      pocetPriloh :=
        (maxcr + ARowsInPriloha - AShiftRows - 1) div ARowsInPriloha
    else
      pocetPriloh:=APageCount;
    //
    for i := 1 to pocetPriloh do begin
      //vytvorit dalsi PDF
      pdfFileName := GetUniqueFileName(GfaMain.DirWorkPath, ADPFFileName);
      CopyFile(PChar(NormalPath(GfaMain.DirWorkPath) + ADPFFileName),
        PChar(pdfFileName), FALSE);
      //tvorit result - seznam pdf
      Result := Result + ',' + ExtractFileName(pdfFileName);
      //vytvorit dalsi pds se zmenou radku v nazvech udaju
      sl.Clear;
      sl.Sorted := FALSE;
      sl.Text := LoadStringFromFile(ChangeFileExt(NormalPath(GfaMain.DirWorkPath)
        +
        ADPFFileName, '.pds'));
      for j := 0 to sl.Count - 1 do begin
        for k := AShiftRows + 1 to AShiftRows + 1 + ARowsInPriloha do begin
          newRow := (i - 1) * ARowsInPriloha + k;
          //zmena cisla radku
          if Pos('T' + StrPadLeft(IntToStr(k), 4, '0'), sl[j]) > 0 then begin
            sl[j] := Replace('T' + StrPadLeft(IntToStr(k), 4, '0'), sl[j],
              'T' + StrPadLeft(IntToStr(newRow), 4, '0'));
            BREAK;
          end;
        end;
        if Copy(sl[j], 1, 1) = '@' then
          begin //nahrazeni hodnotou z Gsl - pracovniho stringlistu
          posRovn := Pos('=', sl[j]);
          sl[j] := '$' + Gsl.Values[Copy(sl[j], 2, posRovn - 2)] +
            Copy(sl[j], posRovn, maxint);
        end;
      end;
      SaveStringToFile(sl.Text, ChangeFileExt(pdfFileName, '.pds'));
      //doplnit data o udaje ulozene v textu
      //...
    end;
    Result := StrTrimCharLeft(Result, ',');
  finally
    sl.Free;
    StopWait;
  end;
end;

