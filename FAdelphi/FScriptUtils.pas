//test jestli existuje libovolny .NET Framework
//  zdroj https://msdn.microsoft.com/cs-cz/library/hh925568%28v=vs.110%29.aspx
function CheckDotNet: boolean;
var
  key: string;
begin
  Result:=False;
  with TRegistry.Create do
  try
    RootKey := HKEY_LOCAL_MACHINE;
    key := 'SOFTWARE\Microsoft\NET Framework Setup\NDP';
    Result := KeyExists(key);
  finally
    Free;
  end
end;

// Spusti cs-script a preda mu script v retezci a pripadne parametr
//  ACscs = false ... spusti csws.exe - winform
//          true  ... spusti cscs.exe - konzolovou aplikaci
//
procedure RunDotNetStript(const AScript: string; const AParams: string = ''; ACscs: Boolean = False; const AParamsRef: string = '');
var
  sfn,scr,s, parRef: string;
begin
  if CheckDotNet then begin

    sfn := GfaMain.mtTskpDefID.Value+'.cs';
    sfn:=GetUniqueFileName(GfaMain.DirWorkPath,sfn);
    //
    if Copy(AScript,1,1)=':' then begin
      s:=GfaMain.mtDefScript.Value;
      s:=Copy(s,Pos(AScript+':',s)+Length(AScript)+1,MaxInt);
      s:=Copy(s,1, Pos(AScript+':',s)-1);
    end
    else
      s:=AScript;
    SaveStringToFile(s,sfn);
    parRef:='';
    if AParamsRef<>'' then
      parRef:=AParamsRef+' ';
    if ACscs then
      ShellOpenAndWait(NormalPath(ExtractFilePath(Application.ExeName))+cCsScriptDir+'\cscs.exe','/nl '+parRef+'"'+sfn+'" "'+AParams+'"')
    else
      ShellOpenAndWait(NormalPath(ExtractFilePath(Application.ExeName))+cCsScriptDir+'\csws.exe','/nl '+parRef+'"'+sfn+'" "'+AParams+'"');
  end
  else
   MsgBoxWarn(GfaMain.Caption, sNeniDotNet, MB_OK);
end;

