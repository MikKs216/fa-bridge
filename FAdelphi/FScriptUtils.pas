      ClientParam('BankAccount')));
    AddStrLine(data, 'KodBankyPlatce=' + ExtractBankCode(
      ClientParam('BankAccount')));
    AddStrLine(data, 'CastkaPlatce=' + Replace(DecimalSeparator,
      FloatToStr(RoundAri(AValue, -2)), cFADecimalSeparator));
    AddStrLine(data, 'DnePlatce=' + DateToStr(ADatePayment));
    AddStrLine(data, 'CislUctuR1=' + ExtractBankAccount(AAccount));
    AddStrLine(data, 'KodBankyR1=' + ExtractBankCode(AAccount));
    AddStrLine(data, 'CastkaR1=' + Replace(DecimalSeparator,
      FloatToStr(RoundAri(AValue, -2)), cFADecimalSeparator));
    AddStrLine(data, 'VarSymR1=' + AVarSym);
    AddStrLine(data, 'KonSym2R1=' + AConSym);
    AddStrLine(data, 'SpecSymR1=' + ASpecSym);
    AddStrLine(data, 'VnitrniPotreba=' + AText);
    AddStrLine(data, 'Dne=' + DateToStr(Date));
    AddStrLine(data, 'Misto=' + ClientParam('City'));
    AddStrLine(data, 'PrKUhrade=True');
    AddStrLine(data, 'ckTisknoutQRCode=True');
    //
{$IFDEF STANDALONE}
    CreateDir(GfaMain.DirFormsPath);
    paymentOrderFileName := GetUniqueFileName(GfaMain.DirFormsPath,
      sPaymentOrderFileName + cDataDefaultExt);
    SaveStringToFile(data, paymentOrderFileName);
    MessageInfo(GFaMain.Caption, SMsgPaymentOrderCreated, [MBOK]);
    OpenFAStandalone(paymentOrderFileName);
{$ELSE STANDALONE}
    MessageInfo(GFaMain.Caption, SMsgPaymentOrderCreated, [MBOK]);
    if GFaMain.FLocalVersion=cLocalVersionSK then
      AdrSaveNewForm(GfaMain.FClientID, guid, cnusk_03PrikazkUhr, data)
    else
      AdrSaveNewForm(GfaMain.FClientID, guid, cnu_03PrikazkUhr, data);
{$ENDIF STANDALONE}
  end;
end; {CreatePaymentOrder}

