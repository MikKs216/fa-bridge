//zformatuje PSC na tvar xxx xx
//  pokud je text delsi nez 6 znaku, tak vraci beze zmen

function NormalZipCodeCzech(APSC: string): string;
begin
  if Length(APSC) > 6 then
    Result := APSC
  else begin
    APSC := Replace(' ', APSC, '');
    Result := Copy(APSC, 1, 3) + ' ' + Copy(APSC, 4, 2);
  end;
end;

function ExtractBankAccount(const ABankAccount: string): string;
var
  p: integer;
begin
  p := Pos('/', ABankAccount);
  if p > 0 then
    Result := Copy(ABankAccount, 1, p - 1)
  else
    Result := ABankAccount;
end;

function ExtractBankCode(const ABankAccount: string): string;
var
  p: integer;
begin
  p := Pos('/', ABankAccount);
  if (p > 0) and (p < Length(ABankAccount)) then
    Result := Copy(ABankAccount, p + 1, 255)
  else begin
    if (Length(ABankAccount)<=11) and not IsInteger(ABankAccount) then
      Result:=ABankAccount
    else
      Result := '';
  end;
end;

//BreakStreet
//  Oddeleni nazvu ulice od cisla domu (post number)

procedure BreakStreet(const AStreetAndNum: string; out AStreet, APostNo:
  string);
var
  i: integer;
begin
  AStreet := '';
  APostNo := '';
  for i := Length(AStreetAndNum) downto 0 do begin
    if Copy(AStreetAndNum, i, 1) = ' ' then
      Exit;
    AStreet := copy(AStreetAndNum, 1, i - 2);
    APostNo := copy(AStreetAndNum, i, Length(AStreetAndNum) - i + 1);
  end;
end; {BreakStreet}

//ExtractStreetFromStreetAndNum
//  Ulice bez cisla popisneho

function ExtractStreetFromStreetAndNum(AStreetAndNum: string): string;
var
  s: string;
begin
  BreakStreet(AStreetAndNum, Result, s);
end; {ExtractStreetFromFullStreet}

