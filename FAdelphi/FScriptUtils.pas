{-----------------------------------------------------------------------------
Fukce ...NestedSection
   Nested sections se ukladaji jako ini soubory, ale kazda sekce musi byt
   ukoncena [/NazevSekce], tyto sekce uz obsahuji vnorene
   sekce uz ve formatu standardniho ini souboru.
   Napr.:
   [NestedSection1]
   [Sec1]
   a=1
   b=2
   [Sec2]
   c=3
   d=4
   [/NestedSection1]

   ASectionName se zadava bez hranatych zavorek.
   Pro praci s NestedSections je potreba pouzivat zasadne nasleduji funkce,
   nepouzivat proste prirazeni pro pridani sekce, protoze pred pocatecnim tagem
   musi byt zapsan novy radek.
 -----------------------------------------------------------------------------}

function GetNestedSection(const AData, ASectionName: string): string;
var
  sl, sl1: TStringList;
  i: integer;
  isInValuesSection: boolean;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    isInValuesSection := FALSE;
    sl.Text := AData;
    for i := 0 to sl.Count - 1 do begin
      if isInValuesSection then
        if sl[i] = '[/'+ASectionName+']' then
          BREAK
        else
          sl1.Add(sl[i])
      else if sl[i] = '['+ASectionName+']' then
        isInValuesSection := TRUE;
    end;
    Result := sl1.Text;
  finally
    sl.Free;
    sl1.Free;
  end;
end; {GetNestedSection}

function AddNestedSection(const AData, ASectionName,
  ASectionData: string): string;
var
  sl, sl1: TStringList;
  i: integer;
begin
  Result:=AData;
  if Result='' then begin
    Result:='['+sNestedSecID+']';
  end
  else begin //odstranit sNestedSecID na konci
    sl:= TStringList.Create;
    sl1:= TStringList.Create;
    try
      sl.Text:=Result;
      for i:=0 to sl.Count-1 do begin
        if sl[i]<>'[/'+sNestedSecID+']' then
          sl1.Add(sl[i]);
      end;
      Result:=sl1.Text;
    finally
      sl.Free;
      sl1.Free;
    end;
  end;
  Result:=Trim(Result+#13#10+'['+ASectionName+']'+#13#10+
    ASectionData+{#13#10+}'[/'+ASectionName+']');
  Result:=Result+#13#10+'[/'+sNestedSecID+']';
end; {AddNestedSection}

function DeleteNestedSection(const AData, ASectionName: string): string;
var
  sl, sl1: TStringList;
  i: integer;
  isInValuesSection: boolean;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    isInValuesSection := FALSE;
    sl.Text := AData;
    for i := 0 to sl.Count - 1 do begin
      if sl[i] = '['+ASectionName+']' then
        isInValuesSection := TRUE;
      if not isInValuesSection then
        sl1.Add(sl[i]);
      if sl[i] = '[/'+ASectionName+']' then
        isInValuesSection := FALSE;
    end;
    Result := sl1.Text;
    Result:=Replace(#13#10#13#10,Result,#13#10);
  finally
    sl.Free;
    sl1.Free;
  end;
end; {DeleteNestedSection}

function ReplaceNestedSection(const AData, ASectionName,
  ASectionData: string): string;
begin
  Result:=DeleteNestedSection(AData,ASectionName);
  Result:=AddNestedSection(Result,ASectionName,ASectionData);
  Result:=Replace(#13#10#13#10,Result,#13#10);
end; {ReplaceNestedSection}

