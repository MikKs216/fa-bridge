function SelectDir(const Caption: string; const Root: WideString; var Directory: string): Boolean;
begin
  //Result:=SelectDirectory(Caption, Root, Directory);
  Result:=false;
  if Root<>'' then
    FSelectedDir:=Root;
  if Win32MajorVersion >= 6 then
    with TFileOpenDialog.Create(nil) do
      try
        Title := Caption;
        Options := [fdoPickFolders, fdoPathMustExist, fdoForceFileSystem];
        OkButtonLabel := SSelectDirButton;
        DefaultFolder := FSelectedDir;
        FileName := FSelectedDir;
        if Execute then begin
          Directory:=Filename;
          FSelectedDir:=FileName;
          Result:=true;
        end;
      finally
        Free;
      end
  else
    if SelectDirectory(Caption, ExtractFileDrive(FSelectedDir), FSelectedDir,
      [sdNewUI, sdNewFolder]) then begin
      Directory:=FSelectedDir;
      Result:=true;
    end;
end;

