//Rozdeli adresu zadanou v jednom radku
//predpokladany format: ulice cislo_popisne;psc misto (nebo misto stredniku carka)

procedure SplitAddress(const AAdresa: string; out AUlice, APSC, AMisto: string);
var
  konec: string;
  function IsDigitsOrSpace(const AStr: string): boolean;
  var i: integer;
  begin
    Result := TRUE;
    for i := 1 to Length(AStr) do
      if not ((Copy(AStr, i, 1) >= '0') and (Copy(AStr, i, 1) <= '9') or
        (Copy(AStr, i, 1) = ' ')) then begin
        Result := FALSE;
        BREAK;
      end;
  end;
begin
  if Pos(';', AAdresa) > 0 then begin
    AUlice := Copy(AAdresa, 1, Pos(';', AAdresa) - 1);
    konec := Trim(Copy(AAdresa, Pos(';', AAdresa) + 1, maxint));
  end
  else if Pos(',', AAdresa) > 0 then begin
    AUlice := Copy(AAdresa, 1, Pos(',', AAdresa) - 1);
    konec := Trim(Copy(AAdresa, Pos(',', AAdresa) + 1, maxint));
  end
  else begin
    AUlice := '';
    konec := AAdresa;
  end;
  if IsDigitsOrSpace(Copy(konec, 1, 6)) and (Length(konec) > 5) then begin
    APSC := Replace(' ', Copy(konec, 1, 6), '');
    AMisto := Trim(Copy(konec, 7, maxint));
  end
  else begin
    APSC := '';
    AMisto := konec;
  end;
end;

function StreetFromAddress(AAdresa: string): string;
var
  ulice, psc, misto: string;
begin
  SplitAddress(AAdresa, ulice, psc, misto);
