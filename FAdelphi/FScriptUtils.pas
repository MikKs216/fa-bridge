function IsValueInSimpleList(const AValue, AListValues: string;
  AColumnIndex: integer = 0): boolean;
var
  i: integer;
  vals: TStringList;
begin
  StartWait;
  Result:=FALSE;
  vals := TStringList.Create;
  try
    if Pos('|',AListValues)>0 then
      vals.Text:=Replace('|',AListValues,#13#10)
    else
      vals.Text:=Replace(';',AListValues,#13#10);
    if (AColumnIndex>=0) and
      (AColumnIndex<=(CountListItems(vals[0])-1)) then begin
      for i:=0 to vals.Count-1 do begin
        if GetListItem(vals[i],AColumnIndex)=AValue then begin
          Result:= TRUE;
          BREAK;
        end;
      end;
    end;
  finally
    vals.Free;
    StopWait;
  end;
end;

