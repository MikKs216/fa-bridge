//Vraci cast retezce pred znakem, pokud neni obsazen tak vraci prazdny retezec.

function ExtractBeforeChar(const AStr: string; const AChar: string = '/'):
  string;
var
  p: integer;
begin
  p := Pos(AChar, AStr);
  if p > 0 then
    Result := Copy(AStr, 1, p - 1)
  else
    Result := '';
end;

//Vraci cast retezce za znakem, pokud neni obsazen tak vraci cely retezec.

function ExtractAfterChar(const AStr: string; const AChar: string = '/'):
  string;
var
  p: integer;
begin
  p := Pos(AChar, AStr);
  if p > 0 then
    Result := Copy(AStr, p + 1, maxint)
  else
    Result := AStr;
end;

