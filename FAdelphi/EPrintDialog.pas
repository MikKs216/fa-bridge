//081102 Zmena rozmeru podle DPI
procedure TfmPrintDialog.SetExpand(ASiroky: boolean; AVysoky: boolean);
var
  koef:double;

  procedure Nizky;
  begin
    Self.Height:=Round(381*koef);
    rgNastaveni.Height:=Round(285*koef);
    paDalsiMoznosti.Height:=Round(60*koef);
    VertLine.Height:=281;
  end;

begin
  case GetFontTypes of
    0,1: koef:=1;
    2: koef:=120/96;
    3: koef:=150/96;
  end;

  if AVysoky then begin
    Self.Height:=Round(467*koef);//487
    rgNastaveni.Height:=Round(383*koef);//403
    paDalsiMoznosti.Height:=Round(209*koef);//229
    VertLine.Height:=Round(379*koef);//399
  end
  else begin
    Nizky;
  end;

  if ASiroky then begin
    Width := Round(685*koef);
    btExpand.Caption := sReportExpandOn;
    VertLine.Visible := True;
  end
  else begin
    Width := Round(369*koef);
    btExpand.Caption := sReportExpandOf;
    VertLine.Visible := false;
    //Soucasne musime zmensit vysku
    Nizky;
  end;

  if IsInteger(GfaMain.FLocalEnlargeWindow) then begin
    Width := Width * StrToIntSafe(GfaMain.FLocalEnlargeWindow) div 100;
    Height := Height* StrToIntSafe(GfaMain.FLocalEnlargeWindow) div 100;
  end;

  rgNastaveni.Visible := ASiroky;
  btEmail.Visible := ASiroky;
  FExpanded := ASiroky;
end;

