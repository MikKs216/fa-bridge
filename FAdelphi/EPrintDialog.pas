function OpenPrintDialog(const AReportVariants: string; const ASelPages: string;
  out ARepDefFileName: string;
  out APrint: boolean;
  out AMail: boolean;
  out AReportSettings: TReportSettings;
  AFDFPrint:Boolean; ALeft: Integer; ATop: Integer): boolean;
begin
  if fmPrintDialog = nil then
    fmPrintDialog:=TfmPrintDialog.Create(nil);
  try
    with fmPrintDialog do begin
      FRepDefFileName:='';
      FPrint:=FALSE;
      FMail:=FALSE;

      Left:=ALeft;
      Top:=ATop;
      LoadFormStateFromIni;
      LoadReportParamsFromIni;

      FReportVariants:=AReportVariants;
      FSelPAges:=ASelPages;
      FFDFPrint:=AFDFPrint;
      Init(FReportVariants, FSelPages, FFDFPrint);

      LogStat('t');
      fmPrintDialog.ShowModal;
      Result:= FRepDefFileName<>'';
      if Result then begin
        ARepDefFileName:=FRepDefFileName;
        APrint:=FPrint;
        AMail:=FMail;
        AReportSettings:=FReportSettings;
      end;
      if fmPrintDialog.FExitCancel and (GfaMain <> nil) then
        GfaMain.BringToFront;
    end;
  finally
    fmPrintDialog.Free;
    fmPrintDialog := nil;
  end;
end; {OpenPrintDialog}

procedure TfmPrintDialog.Init(const AReportVariants: string;
  const ASelPages: string; AFDFPrint: boolean);
var
  sl, sl1, slSort: TstringList;
  i, ix, p: integer;
  restrictReportOptions: string;
  changeSelect, disableCheckboxes: boolean;
  stValue, stName, readerExePath: string;
begin
  StartWait;
  try
    if ASelPAges<>'' then begin
      rbPagesSelected.Checked := TRUE;
      edSelectedPages.Text := ASelPages;
    end;

    //varianta formulare
    cbReportVariants.Properties.Items.Clear;
    cbReportVariants.Properties.Items.Add(sReportVariantBasic);
    cbReportVariants.Enabled := AReportVariants <> '';

    ix:=0;
    if AReportVariants <> '' then
    begin
      slSort := TstringList.Create;
      slSort.Sorted := True;
      sl := TstringList.Create;
      sl.CommaText := Replace(' ',AReportVariants,'_');
      sl1 := TstringList.Create;
      sl1.Text := GfaMain.FReportVariantsTexts;
      try
        if sl1.Count > 0 then begin
          for i := 0 to sl1.Count - 1 do begin
            p := Pos('=', sl1[i]);
            if p > 0 then begin
              stName := Copy(sl1[i],1,p-1);
              stValue := Copy(sl1[i],p+1,MaxInt);
              if (stValue <> '') and (IsItemInList(sl.CommaText, stName)) then
                slSort.Add(stValue);
            end;
          end;
          ix:=slSort.IndexOf(FVariantName);
          if ix=-1 then
            ix:=0
          else
            ix:=ix+1;  
        end
        else begin
          for i := 0 to sl.Count - 1 do begin
            slSort.Add(Replace('_',sl[i],' '));
            if Replace('_',sl[i],' ')=FVariantName then
              ix:=i+1;
          end;
        end;
        //
        for i := 0 to slSort.Count - 1 do
          cbReportVariants.Properties.Items.Add(slSort[i]);
      finally
        sl.Free;
        sl1.Free;
        slSort.Free;
      end;
    end;
    if GfaMain.FParamSavePrintParamsForDefinitions and (ix>=0) then
      cbReportVariants.ItemIndex := ix
    else
      cbReportVariants.ItemIndex := 0;
    //
    restrictReportOptions := GfaMain.GetRestrictReportOptions;
      //pro nastaveni povoleni obsahu tisku
    if restrictReportOptions <> '' then begin
      rbFilledForm.Enabled := Copy(restrictReportOptions, 1, 1) = '1';
      rbWithoutBackground.Enabled := Copy(restrictReportOptions, 2, 1) = '1';
      rbEmptyForm.Enabled := Copy(restrictReportOptions, 3, 1) = '1';
      rbOnlyValues.Enabled := Copy(restrictReportOptions, 4, 1) = '1';
      changeSelect := not rbFilledForm.Enabled and rbFilledForm.Checked or
        not rbWithoutBackground.Enabled and rbWithoutBackground.Checked or
        not rbEmptyForm.Enabled and rbEmptyForm.Checked or
        not rbOnlyValues.Enabled and rbOnlyValues.Checked;
      if changeSelect then begin
        if rbFilledForm.Enabled then
          rbFilledForm.Checked := TRUE
        else if rbWithoutBackground.Enabled then
          rbWithoutBackground.Checked := TRUE
        else if rbEmptyForm.Enabled then
          rbEmptyForm.Checked := TRUE
        else if rbOnlyValues.Enabled then
          rbOnlyValues.Checked := TRUE;
      end;
    end
    else begin
      rbFilledForm.Enabled := TRUE;
      rbWithoutBackground.Enabled := TRUE;
      rbEmptyForm.Enabled := TRUE;
      rbOnlyValues.Enabled := TRUE;
    end;
    //
    //081102 Pokud je po inicializaci nezadany zpusob zobrazeni PDF tak udelame inicializaci na EditorReader
    if not rbInternalReader.Checked and not rbEditorReader.Checked and not rbExternalReader.Checked and not rbUserDefinedPDF.Checked then
      rbEditorReader.Checked := True;

    cbPrintWithDialog.Enabled := not disableCheckboxes;
    readerExePath:=GetPDFEditor;
    if (Pos('PDFXCview.exe',readerExePath) > 0) and rbEditorReader.Checked then begin
      cbPrintWithDialog.Checked := false;
      cbPrintWithDialog.Enabled := false;
    end;

    FRepDefFileName:='';
    FPrint:=FALSE;
    FMail:=FALSE;

    //nastaveni pro FDF print
    cbFDFprint.Visible:=AFDFPrint;
    if not cbFDFprint.Visible then
      cbFDFprint.Checked:=false;
    disableCheckboxes:=AFDFPrint and cbFDFprint.Checked;
    if disableCheckboxes then begin // formular umoznuje FDF print a je zaskrtnute
      cbReportVariants.Enabled := false;
      rbFilledForm.Enabled := false;
      rbWithoutBackground.Enabled := false;
      rbEmptyForm.Enabled := false;
      rbOnlyValues.Enabled := false;
      rbExternalReader.Checked := True;
    end;

    rbPagesAll.Enabled := not disableCheckboxes;
    rbPagesOdd.Enabled := not disableCheckboxes;
    rbPagesEven.Enabled := not disableCheckboxes;
    rbPagesOddThenEven.Enabled := not disableCheckboxes;
    rbPagesSelected.Enabled := not disableCheckboxes;
    edCopies.Enabled := not disableCheckboxes;
    edSelectedPages.Enabled := not disableCheckboxes;
    btEmail.Enabled := not disableCheckboxes;
    btPrint.Enabled := not disableCheckboxes;

    cbNulNumValueFillZero.Enabled := not disableCheckboxes;
    //cbZeroValueClear.Enabled := not disableCheckboxes; // tento nechame povoleny
    cbNofilledStrike.Enabled := not disableCheckboxes;
    cbUseUserFont.Enabled := not disableCheckboxes;
    btFont.Enabled := not disableCheckboxes and cbUseUserFont.Checked;
    cbUseSignature.Enabled := not disableCheckboxes;
    cbUseSignatureInText.Enabled := not disableCheckboxes and cbUseSignature.Checked;
    btCertificate.Enabled := not disableCheckboxes and cbUseSignature.Checked;
    rbExternalReader.Enabled := not disableCheckboxes;
    chkMorePrint.Enabled := not disableCheckboxes;
    rbInternalReader.Enabled := not disableCheckboxes;
    rbEditorReader.Enabled := not disableCheckboxes;
    rbUserDefinedPDF.Enabled := not disableCheckboxes;
    edCMDPreview.Enabled := not disableCheckboxes and rbUserDefinedPDF.Checked;
    edCMDPrint.Enabled := not disableCheckboxes and rbUserDefinedPDF.Checked;
    cbUseClientIdentification.Enabled := not disableCheckboxes;
    cbUsePrgIdentification.Enabled := not disableCheckboxes;

  finally
    StopWait;
  end;
end; {Init}

procedure TfmPrintDialog.DoReport(APrint: boolean; AMail: boolean = FALSE);
var       
  repDefFileName: string;
  reportSettings: TReportSettings;
  logEntry: string;
begin
  if rbPagesSelected.Checked and
    ((edSelectedPages.Text = '') or
    not CheckValidIntegerList(edSelectedPages.Text)) then
    if MessageAsk(Caption, sMsgErrSelectedPages, [MBYES,MBNO]) = IDNO then
      EXIT;
  //
  with GfaMain do begin
    if cbReportVariants.Enabled and
      (cbreportVariants.Text <> sReportVariantBasic) then begin
      if GfaMain.FReportVariantsTexts <> '' then
        repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
          mtDefID.Value + '#' +
          GetStringLineName(GfaMain.FReportVariantsTexts, cbreportVariants.Text) +
          cReportDefaultExt
      else
        repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
          mtDefID.Value + '#' + cbreportVariants.Text + cReportDefaultExt;
    end
    else
      repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
        mtDefID.Value + cReportDefaultExt;
    //
    //nastavit report settings
    with reportSettings do begin
      PrintForm := rbFilledForm.Checked or rbWithoutBackground.Checked or
        rbEmptyForm.Checked;
      PrintValues := rbFilledForm.Checked or rbWithoutBackground.Checked or
        rbOnlyValues.Checked;
      RemoveBackground := rbWithoutBackground.Checked;
      NoFilledStrike := cbNofilledStrike.Checked;
      ZeroValueClear := cbZeroValueClear.Checked;
      NulNumValueFillZero := cbNulNumValueFillZero.Checked;
      UseClientIdentification := cbUseClientIdentification.Checked;
      UsePrgIdentification := cbUsePrgIdentification.Checked;
      PrintWithDialog := cbPrintWithDialog.Checked;
      UseUserFont := cbUseUserFont.Checked;
      FontName := FFontName;
      FontSize := FFontSize;
      FontBold := FFontBold;
      FontItalic := FFontItalic;
      FontColor := FFontColor;
      ShiftX := edShiftX.Value;
      ShiftY := edShiftY.Value;
      //
      RepPagesAll := rbPagesAll.Checked;
      RepPagesOdd := rbPagesOdd.Checked;
      RepPagesEven := rbPagesEven.Checked;
      RepPagesOddThenEven := rbPagesOddThenEven.Checked;
      RepPagesSelected := rbPagesSelected.Checked;
      RepSelectedPAges := edSelectedPages.Text;
      RepCopies := edCopies.Value;
      RepInternalReader := rbInternalReader.Checked;
      RepEditorReader := rbEditorReader.Checked;
      RepExternalReader := rbExternalReader.Checked;
      RepUserDefined := rbUserDefinedPDF.Checked;
      CMDShow := edCMDPreview.Text;
      CMDPrint := edCMDPrint.Text;

      //
      UseSignature := cbUseSignature.Checked;
      UseSignatureInText := cbUseSignatureInText.Checked;
      SignatureHash := FSignatureHash;
      SignatureSubject := FSignatureSubject;
      //
      FVariantName:=cbreportVariants.Text;
      VariantName := FVariantName;
      FDFPrint := cbFDFprint.Checked;
    end;
    FReportSettingsVariantName := FVariantName;
    SaveReportParamsToIni;
    FRepDefFileName:=repDefFileName;
    FPrint:=APrint;
    FMail:=AMail;
    FReportSettings:=reportSettings;

    logEntry := ReportSettingsToLog(reportSettings);
    LogStat('R:' + logEntry, true);
  end;
  Close;
end; {DoReport}

procedure TfmPrintDialog.btPreviewClick(Sender: TObject);
begin
  DoReport(FALSE);
  FExitCancel := FALSE;
end;

procedure TfmPrintDialog.FormKeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #27 then begin
    Close;
  end;
end;

procedure TfmPrintDialog.btPrintClick(Sender: TObject);
begin
  DoReport(TRUE);
  FExitCancel := FALSE;
end;

procedure TfmPrintDialog.btFontClick(Sender: TObject);
begin
  with PdfFontDialog1, SelectedFontInfo do begin
    FontName := FFontName;
    FontSize := FFontSize;
    if FFontBold and FFontItalic then
      FontStyle := [fsBold, fsItalic]
    else begin
      if FFontBold then
        FontStyle := [fsBold];
      if FFontItalic then
        FontStyle := [fsItalic];
    end;
    FontColor := FFontColor;
    if Execute then begin
      FFontName := FontName;
      FFontSize := FontSize;
      FFontBold := fsBold in FontStyle;
      FFontItalic := fsItalic in FontStyle;
      FFontColor := FontColor;
    end;
  end;
end;

procedure TfmPrintDialog.LoadFormStateFromIni;
var iniFile: TMemIniFile;
  l,t: Integer;
begin
  iniFile := TMemIniFile.Create(GfaMain.GetIniFileName);
  try
    if Left=0 then
      Left := iniFile.ReadInteger(Name, 'Left', GfaMain.Left + 5);
    if Top=0 then
      Top := iniFile.ReadInteger(Name, 'Top', GfaMain.Top + 30);
    l:=Left; t:=Top; CheckFormPosition(l,t,Width); Left:=l; Top:=t;
    FExpanded := iniFile.ReadBool(Name, 'Expanded',TRUE);
    FExtendedTisk:= iniFile.ReadBool(Name,'ExtendedPrint',FALSE);
    //SetExtended(FExtendedTisk);
    chkMorePrint.Checked:=FExtendedTisk;
    SetExpand(FExpanded,chkMorePrint.Checked);

    //edCMDPreview.Text:= iniFile.ReadString(Name, 'CMDPreview', '');
    //edCMDPrint.Text:= iniFile.ReadString(Name, 'CMDPrint', '');
  finally
    iniFile.Free;
  end;
end;

procedure TfmPrintDialog.LoadReportParamsFromIni;
var
  iniFile: TMemIniFile;
  section, defID: string;
  canFdfPrint: boolean;
begin
  iniFile := TMemIniFile.Create(GfaMain.GetIniFileName);
  try
    with GfaMain do begin
      if FNestedState then
        defID:=FNestedDefName
      else
        defID:=mtTskpDefID.Value;
      if FParamSavePrintParamsForDefinitions and mtTskp.Active then
        section := cIniRepSetSection + '_' + defID
      else
        section := cIniRepSetSection;
    end;
    rbFilledForm.Checked := iniFile.ReadBool(section, rbFilledForm.Name, TRUE);
    rbWithoutBackground.Checked := iniFile.ReadBool(section, cRemoveBackground, TRUE);
    rbOnlyValues.Checked := iniFile.ReadBool(section, rbOnlyValues.Name, FALSE);
    rbEmptyForm.Checked := iniFile.ReadBool(section, rbEmptyForm.Name, FALSE);

    if not rbFilledForm.Checked and not rbWithoutBackground.Checked and
      not rbOnlyValues.Checked and not rbEmptyForm.Checked then
      rbFilledForm.Checked:=true;

    cbNofilledStrike.Checked := iniFile.ReadBool(section,
      cNoFilledStrike, FALSE);
    cbZeroValueClear.Checked := iniFile.ReadBool(section,
      cZeroValueClear, GFaMain.FLocalVersion=cLocalVersionSK); //u SK lokalizace TRUE
    cbNulNumValueFillZero.Checked := iniFile.ReadBool(section,
      cNulNumValueFillZero, FALSE);
    cbUseClientIdentification.Checked := iniFile.ReadBool(section,
      cUseClientIdentification, TRUE);
    cbUsePrgIdentification.Checked := iniFile.ReadBool(section,
      cUsePrgIdentification, TRUE);
    cbPrintWithDialog.Checked := iniFile.ReadBool(section,
      cPrintWithDialog, FALSE);
    cbUseUserFont.Checked := iniFile.ReadBool(section,
      cUseUserFont, FALSE);
    btFont.Enabled:=cbUseUserFont.Checked;
    FFontName := iniFile.ReadString(section, cFontName, 'Courier');
    FFontSize := iniFile.ReadInteger(section, cFontSize, 12);
    FFontBold := iniFile.ReadBool(section, cFontBold, FALSE);
    FFontItalic := iniFile.ReadBool(section, cFontItalic, FALSE);
    FFontColor := StrToColor(iniFile.ReadString(section, cFontColor,
      ColorToStr(clBlack)));
    edShiftX.Value := iniFile.ReadInteger(section, cShiftX, 0);
    edShiftY.Value := iniFile.ReadInteger(section, cShiftY, 0);
    //
    rbPagesAll.Checked := iniFile.ReadBool(section, cRepPagesAll, TRUE);
    rbPagesOdd.Checked := iniFile.ReadBool(section, cRepPagesOdd, FALSE);
    rbPagesEven.Checked := iniFile.ReadBool(section, cRepPagesEven, FALSE);
    rbPagesOddThenEven.Checked := iniFile.ReadBool(section,
      cRepPagesOddThenEven, FALSE);
    rbPagesSelected.Checked := iniFile.ReadBool(section, cRepPagesSelected,
      FALSE);

    if not rbPagesAll.Checked and not rbPagesOdd.Checked and
      not rbPagesEven.Checked and not rbPagesOddThenEven.Checked and
      not rbPagesSelected.Checked then
      rbPagesAll.Checked:=true;

    edSelectedPages.Text := iniFile.ReadString(section, cRepSelectedPages, '');
    edCopies.Value := iniFile.ReadInteger(section, cRepCopies, 1);

    rbInternalReader.Checked := iniFile.ReadBool(section, cRepOpenReaderInWindow, FALSE); //z duvodu kompatibility ponechano puvodni zmatecne oznaceni
    rbEditorReader.Checked := iniFile.ReadBool(section, cRepEditorReader, TRUE);
    rbExternalReader.Checked := iniFile.ReadBool(section, cRepExternalReader, FALSE) or
      iniFile.ReadBool(section, cRepInternalReader, FALSE);
    rbUserDefinedPDF.Checked := iniFile.ReadBool(section, cRepOpenUserDefWindow, FALSE);
    SaveReaderParams;

    edCMDPreview.Text := iniFile.ReadString(section, cRepUserCMDPreview,'');
    edCMDPrint.Text := iniFile.ReadString(section, cRepUserCMDPrint,'');

    cbUseSignature.Checked := iniFile.ReadBool(section,
      cRepUseSignature, FALSE);
    cbUseSignatureInText.Checked := iniFile.ReadBool(section,
      cRepUseSignatureInText, FALSE);
    FSignatureHash := iniFile.ReadString(section,
      cRepSignatureHash, '');
    FSignatureSubject := iniFile.ReadString(section,
      cRepSignatureSubject, '');

    FVariantName := iniFile.ReadString(section, cRepVariantName, '');

    btCertificate.Enabled:=cbUseSignature.Checked;
    cbUseSignatureInText.Enabled:=cbUseSignature.Checked;

    canFdfPrint:=GfaMain.GetReportFDFPrint;
    cbFDFPrint.Checked:=iniFile.ReadBool(section, cRepFDFPrint, canFdfPrint);

    SetEnableSelectedPages;
    //
    SetContentControls;
  finally
    iniFile.Free;
  end;
end;

procedure TfmPrintDialog.SaveReaderParams;
begin
  FInternalReader:=rbInternalReader.Checked;
  FEditorReader:=rbEditorReader.Checked;
  FExternalReader:=rbExternalReader.Checked;
  FUserDefinedPDF:=rbUserDefinedPDF.Checked;
end;

procedure TfmPrintDialog.RestoreReaderParams;
begin
  rbInternalReader.Checked:=FInternalReader;
  rbEditorReader.Checked:=FEditorReader;
  rbExternalReader.Checked:=FExternalReader;
  rbUserDefinedPDF.Checked:=FUserDefinedPDF;
end;

procedure TfmPrintDialog.SaveFormStateToIni;
var iniFile: TMemIniFile;
begin
  if not GfaMain.CanWriteToIniFile then EXIT;
  iniFile := TMemIniFile.Create(GfaMain.GetIniFileName);
  try
    iniFile.WriteInteger(Name, 'Left', Left);
    iniFile.WriteInteger(Name, 'Top', Top);
    iniFile.WriteBool(Name, 'Expanded', FExpanded);
    iniFile.WriteBool(Name,'ExtendedPrint',chkMorePrint.Checked);
    //iniFile.WriteString(Name, 'CMDPreview', edCMDPreview.Text);
    //iniFile.WriteString(Name, 'CMDPrint', edCMDPrint.Text);
    SaveMemIni(iniFile);
  finally
    iniFile.Free;
  end;
end;

procedure TfmPrintDialog.SaveReportParamsToIni;
var
  iniFile: TMemIniFile;
  section, defID: string;
begin
  {if not GfaMain.CanWriteToIniFile then EXIT;} //tady zapisujeme vzdy aby se predalo nastaveni do nested forms
  iniFile := TMemIniFile.Create(GfaMain.GetIniFileName);
  try
    with GfaMain do begin
      if FNestedState then
        defID:=FNestedDefName
      else
        defID:=mtTskpDefID.Value;
      if FParamSavePrintParamsForDefinitions and mtTskp.Active then
        section := cIniRepSetSection + '_' + defID
      else
        section := cIniRepSetSection;
    end;
    iniFile.WriteBool(section, cPrintForm, rbFilledForm.Checked or
      rbWithoutBackground.Checked or rbEmptyForm.Checked);
    iniFile.WriteBool(section, cPrintValues, rbFilledForm.Checked or
      rbWithoutBackground.Checked or rbOnlyValues.Checked);
    iniFile.WriteBool(section, cRemoveBackground,
      rbWithoutBackground.Checked);

    iniFile.WriteBool(section, rbFilledForm.Name, rbFilledForm.Checked);
    iniFile.WriteBool(section, rbOnlyValues.Name, rbOnlyValues.Checked);
    iniFile.WriteBool(section, rbEmptyForm.Name, rbEmptyForm.Checked);

    iniFile.WriteBool(section, cNoFilledStrike, cbNofilledStrike.Checked);
    iniFile.WriteBool(section, cZeroValueClear, cbZeroValueClear.Checked);
    iniFile.WriteBool(section, cNulNumValueFillZero,
      cbNulNumValueFillZero.Checked);
    iniFile.WriteBool(section, cUseClientIdentification,
      cbUseClientIdentification.Checked);
    iniFile.WriteBool(section, cUsePrgIdentification,
      cbUsePrgIdentification.Checked);
    iniFile.WriteBool(section, cPrintWithDialog,
      cbPrintWithDialog.Checked);
    iniFile.WriteBool(section, cUseUserFont,
      cbUseUserFont.Checked);
    iniFile.WriteString(section, cFontName, FFontName);
    iniFile.WriteInteger(section, cFontSize, FFontSize);
    iniFile.WriteBool(section, cFontBold, FFontBold);
    iniFile.WriteBool(section, cFontItalic, FFontItalic);
    iniFile.WriteString(section, cFontColor, ColorToStr(FFontColor));
    iniFile.WriteInteger(section, cShiftX, edShiftX.Value);
    iniFile.WriteInteger(section, cShiftY, edShiftY.Value);
    //
    iniFile.WriteBool(section, cRepPagesAll, rbPagesAll.Checked);
    iniFile.WriteBool(section, cRepPagesOdd, rbPagesOdd.Checked);
    iniFile.WriteBool(section, cRepPagesEven, rbPagesEven.Checked);
    iniFile.WriteBool(section, cRepPagesOddThenEven,
      rbPagesOddThenEven.Checked);
    iniFile.WriteBool(section, cRepPagesSelected, rbPagesSelected.Checked);
    iniFile.WriteString(section, cRepSelectedPages, edSelectedPages.Text);
    iniFile.WriteInteger(section, cRepCopies, edCopies.Value);
    if not cbFDFprint.Checked then begin // kdyz je FDF print neukladame
      iniFile.WriteBool(section, cRepOpenReaderInWindow, rbInternalReader.Checked); //z duvodu kompatibility ponechano puvodni zmatecne oznaceni
      iniFile.WriteBool(section, cRepEditorReader, rbEditorReader.Checked);
      iniFile.WriteBool(section, cRepExternalReader, rbExternalReader.Checked);
      iniFile.WriteBool(section, cRepOpenUserDefWindow,rbUserDefinedPDF.Checked);
      iniFile.WriteString(section, cRepUserCMDPreview,edCMDPreview.Text);
      iniFile.WriteString(section, cRepUserCMDPrint,edCMDPrint.Text);
    end;
    //
    iniFile.WriteBool(section, cRepUseSignature, cbUseSignature.Checked);
    iniFile.WriteBool(section, cRepUseSignatureInText,
      cbUseSignatureInText.Checked);
    iniFile.WriteString(section, cRepSignatureHash, FSignatureHash);
    iniFile.WriteString(section, cRepSignatureSubject, FSignatureSubject);
    //
    iniFile.WriteString(section, cRepVariantName, FVariantName);
    iniFile.WriteBool(section, cRepFDFPrint, cbFDFPrint.Checked);

    SaveMemIni(iniFile);
  finally
    iniFile.Free;
  end;
end;

procedure TfmPrintDialog.SetContentControls;
begin
  paShift.Enabled := rbOnlyValues.Checked;
  laShift.Enabled := rbOnlyValues.Checked;
  laShiftB1.Enabled := rbOnlyValues.Checked;
  laShiftY.Enabled := rbOnlyValues.Checked;
  laShiftB2.Enabled := rbOnlyValues.Checked;
  edShiftX.Enabled := rbOnlyValues.Checked;
  edShiftY.Enabled := rbOnlyValues.Checked;
  //
  if rbFilledForm.Checked then begin
    imMicroPreview.Picture := Image1.Picture;
    imMicroPreview.Transparent := FALSE;
    imMicroPreview.Left := 0;
    imMicroPreview.Top := 0;
  end
  else if rbWithoutBackground.Checked then begin
    imMicroPreview.Picture := Image1.Picture;
    imMicroPreview.Transparent := TRUE;
    imMicroPreview.Left := 0;
    imMicroPreview.Top := 0;
  end
  else if rbEmptyForm.Checked then begin
    imMicroPreview.Picture := Image2.Picture;
    imMicroPreview.Transparent := FALSE;
    imMicroPreview.Left := 0;
    imMicroPreview.Top := 0;
  end
  else if rbOnlyValues.Checked then begin
    imMicroPreview.Picture := Image3.Picture;
    imMicroPreview.Transparent := TRUE;
    imMicroPreview.Left := 0 + edShiftX.Value div 10;
    imMicroPreview.Top := 0 + edShiftY.Value div 10;
  end
end;

