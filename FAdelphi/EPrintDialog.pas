  hash, subject: string;
begin
  hash := FSignatureHash;
  subject := FSignatureSubject;
  hash := SelectCertificate(hash, subject, Left+5, Top+30);
  if hash<>'' then begin
    FSignatureHash := hash;
    FSignatureSubject := subject;
  end;
end;

