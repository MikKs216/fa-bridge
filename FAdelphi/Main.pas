procedure TfaMain.SavePage;
var
  s: string;
  st: TMemoryStream;
  i: integer;
  c: TControl;
  desTms: TIDEFormDesigner;
begin
  StartWait;
  try
    if (mtContentImageHeight.Value>0) or (IsPaintBoxReadyForUse) then
    begin
      with sbForm.VertScrollBar do
      begin
        Position := 0;
      end;
    end;

    HideEdit;
    if mtContent.Active and (mtContent.RecordCount > 0) then
    begin //pokud v obsahu nic neni neni, nebylo by co a kam ukladat
      SetCalcEdits(TRUE);
      HideClientBorder;
      HidePaintBox;
      st := TMemoryStream.Create;
      try
        if FNewScripter then begin
          {$IFNDEF FINALBUILD}
          if tmsDesigner <> nil then begin //designovani TMS v tmsDesigneru
            tmsDesigner.SaveDesignerComponentsToStream(st, FControlsNamesList);
            st.Seek(0, soFromBeginning);
          end
          else begin                       //designovani TMS v DC designeru
            desTms := TIDEFormDesigner.Create(self);
            sbForm.OnEnter := nil;
            sbForm.OnMouseWheelDown := nil;
            sbForm.OnMouseWheelUp := nil;
            try
              UpdateControlsToList(sbForm, FControlsNamesList);
              desTms.SaveComponentToStream(st, sbForm, dfmBinary);
            finally
              sbForm.OnEnter := sbFormEnter;
              sbForm.OnMouseWheelDown := sbFormMouseWheelDown;
              sbForm.OnMouseWheelUp := sbFormMouseWheelUp;
              desTms.Free;
              FControlsListFree;
            end;
          end;
          {$ENDIF FINALBUILD}
        end
        else
          Designer.SaveComponentToStream(sbForm, st);
        //st.SaveToFile('d:\saveDC.txt');
        //
        mtContent.Edit;
        mtContentSectionForm.Value := '';
        mtContentSectionForm.LoadFromStream(st);

        //zapsani vysky obrazku na strance
        for i := 0 to sbForm.ControlCount - 1 do begin
          c := sbForm.Controls[i];
          if (c is TImage) and (TImage(c).Left<2) and (TImage(c).Top<2) then
          begin
            mtContentImageHeight.Value:=TImage(c).Height;
            mtContentImageWidth.Value:=TImage(c).Width;
            BREAK;
          end;
        end;

        mtContent.Post;
        SavePageFieldsDef;
      finally
        st.Free;
      end;
      ShowClientBorder;
      ShowPaintBox;
      if IsPaintBoxReadyForUse then
        PaintBox.SendToBack;
    end;
  finally
    StopWait;
  end;
end; {SavePage}

//nacteni strany formulare ze zaznamu obsahu

procedure TfaMain.LoadPage;
const
  cShortCutCtrlB = 16450;
  cSubstFontName = 'Tahoma';
var
  st: TMemoryStream;
  formWasChanged: boolean;
  i: integer;
  c: TControl;
begin
{$ifdef profiler}timelog('--- start LoadPage'); {$endif profiler}
  formWasChanged := FStateFormWasChanged;
  FOldEdit := nil;
  try
    if not FIsLoadingContent then begin
      HideClientBorder;
      if mtContent.Active and (mtContent.RecordCount > 0) then begin
        paCbAppendix.Visible := (mtContentPage.Value = cAppendixID) and
          (mtDefID.Value<>FDefIDTextDocument);
        HidePaintBox;
        FCurrPage := mtContent.RecNo-1;
        if FCurrPage > FMaxPage then
          FCurrPage := -1;
        if mtContentPage.Value = cNotesID then begin
          FLastNotesZoom:=reNotes.ViewProperty.ZoomPercent;
          if mtTskp.Active then begin
            if mtTskp.RecordCount > 0 then
              reNotes.DataField := mtTskpNotes.FieldName;
          end
          else
            reNotes.Clear;
          reNotes.ViewProperty.ZoomPercent:=FLastNotesZoom;
          if FFirstLoadPage then begin //musi byt az tady, neda se resit drive
            mtTskp.Edit;
            SetNotesMargins;
            mtTskp.Post; //aby se to ulozilo do rtf ve fieldu
            FFirstLoadPage:=False;
          end;
          sbNotes.Visible := TRUE;
          sbNotes.BringToFront;
          //
          dxBarButtonGotoBookmark.ShortCut:=0;
          dxBarButtonTextEditorFunction.Visible := ivAlways;
          {SetToolBarTextEditorVisible(TRUE);}
        end
        else if mtContentPage.Value = cAppendixID then begin
          //nastaveni cbPrintAppendix
          cbPrintAppendix.Checked:=
            StrToBoolSafe(GetFormUserSetting(cUSPrintAppendix));
          FLastNotesZoom:=reNotes.ViewProperty.ZoomPercent;
          if mtTskp.Active then begin
            if mtTskp.RecordCount > 0 then
              reNotes.DataField := mtTskpAppendix.FieldName;
          end
          else
            reNotes.Clear;
          reNotes.ViewProperty.ZoomPercent:=FLastNotesZoom;
          if FFirstLoadPage then begin //musi byt az tady, neda se resit drive
            mtTskp.Edit;
            SetNotesMargins;
            mtTskp.Post;
            FFirstLoadPage:=False;
          end;
          sbNotes.Visible := TRUE;
          sbNotes.BringToFront;
          //
          dxBarButtonGotoBookmark.ShortCut:=0;
          dxBarButtonTextEditorFunction.Visible := ivAlways;
          {SetToolBarTextEditorVisible(TRUE);}
        end
        else if mtContentSectionForm.Value <> '' then
        begin // pokud byla uz strana ulozena
          dxBarButtonGotoBookmark.ShortCut:=cShortCutCtrlB;
          dxBarButtonTextEditorFunction.Visible := ivNever;
          {SetToolBarTextEditorVisible(FALSE);}
          sbNotes.Visible := FALSE;
          sbForm.BringToFront;
          HideEdit;
          st := TMemoryStream.Create;
          try
            mtContentSectionForm.SaveToStream(st);
            st.Seek(0, soFromBeginning);
            //st.SaveToFile('d:\stream.dat');
            sbForm.Visible := FALSE;
            EmptyPage;
            try
              if FNewScripter then
                LoadComponentFromStream(sbForm, st)
              else
                Designer.LoadComponentFromStream(sbForm, st);
              //  
              sbForm.Parent := paForm;
              sbForm.Color := sbBackGround.Color;
            finally
              sbForm.Visible := TRUE;
              ShowPaintBox;
              if IsPaintBoxReadyForUse then
                PaintBox.SendToBack;
            end;
          finally
            st.Free;
          end;

          //nahrada fontu controlsu podle pozadavku v localization.ini
          if FLocalFontName<>'' then begin
            for i := 0 to sbForm.ControlCount - 1 do begin
              c := sbForm.Controls[i];
              if (c is TLabel) and (TLabel(c).Font.Name='MS Sans Serif') then
                TLabel(c).Font.Name:=FLocalFontName
              else if (c is TfaEdit ) and (TfaEdit(c).Font.Name='MS Sans Serif') then
                TfaEdit(c).Font.Name:=FLocalFontName
              else if (c is TcxDBTextEditEx) and (TcxDBTextEditEx(c).Style.Font.Name='MS Sans Serif') then
                TcxDBTextEditEx(c).Style.Font.Name:=FLocalFontName
              else if (c is TcxDBCheckBoxEx) and (TcxDBCheckBoxEx(c).Style.Font.Name='MS Sans Serif') then
                TcxDBCheckBoxEx(c).Style.Font.Name:=FLocalFontName
              else if (c is TcxDBMemoEx) and (TcxDBMemoEx(c).Style.Font.Name='MS Sans Serif') then
                TcxDBMemoEx(c).Style.Font.Name:=FLocalFontName
              else if (c is TButton) and (TButton(c).Font.Name='MS Sans Serif') then
                TButton(c).Font.Name:=FLocalFontName
              else if (c is TpsvWebLabel) and (TpsvWebLabel(c).Font.Name='MS Sans Serif') then
                TpsvWebLabel(c).Font.Name:=FLocalFontName;
            end;
            sbForm.Refresh;
          end;
          //

          ConnectMtValues;
          //zobrazit edit
          if not dxBarButtonDesignMode.Down then begin
            FActuallyControl := GetFirstControl;
            CEdit.PopupMenu := pmForm;
          end
          else // v design modu priradit popup menu
            CEdit.PopupMenu := pmDesign;
        end
        else begin //kdyz nebyla strana ulozena, nacist prazdnou
          dxBarButtonGotoBookmark.ShortCut:=cShortCutCtrlB;
          dxBarButtonTextEditorFunction.Visible := ivNever;
          {SetToolBarTextEditorVisible(FALSE);}
          sbNotes.Visible := FALSE;
          sbForm.BringToFront;
          EmptyPage;
          ShowPaintBox;
        end;
        ShowClientBorder;
      end
      //kdyz neni nic v obsahu
      else begin
        dxBarButtonGotoBookmark.ShortCut:=cShortCutCtrlB;
        dxBarButtonTextEditorFunction.Visible := ivNever;
        {SetToolBarTextEditorVisible(FALSE);}
        sbNotes.Visible := FALSE;
        sbForm.BringToFront;
        HideEdit;
      end;
      ClearReInfo;
      SetCalcEdits(FStateFormDisabledCalc, TRUE);
      FActuallyControl := nil;
      //ShowActuallyControl; nemelo vyznam kvuli podmince uvnitr, nic to nedelalo
      SetCbOnClick;
    end;
  finally
    SetChangeFlag(formWasChanged);
  end;

  //zvetsovani udaju
  InitZoomParams;
  FControlsPosition.Clear;
  if tbZoom.Position <> cZoomOriginal then begin
    ZoomControlsPosition(true);
  end;
  //
  DoAfterLoadPage;
{$ifdef profiler}timelog('--- stop LoadPage'); {$endif profiler}
end; {LoadPage}

procedure TfaMain.ZoomControlsPosition(AForLoadPage: boolean);
var i,j,p: integer;
  c:TControl;
  s: string;
  f: double;
  lastControl: TControl;
begin
  HideEdit;
  if FFileOpened then begin
    if AForLoadPage or ((FLastZoom=cZoomOriginal) and (tbZoom.Position<>FLastZoom)) then
      SaveOriginalControlsPosition;

    if {(mtContentImageHeight.Value>0) and} (tbZoom.Position<>FLastZoom) or AForLoadPage then begin //podminkou jde omezit jen na formulare s obrazky na pozadi
      FLastZoom:=tbZoom.Position;
      case tbZoom.Position of
        -5: f:=0.5;
        -4: f:=0.7;
        -3: f:=0.8;
        -2: f:=0.9;
        -1: f:=0.95;
        0: f:=1.0;
        1: f:=1.1;
        2: f:=1.2;
        3: f:=1.4;
        4: f:=1.6;
        5: f:=2.0;
      end;
      laZoomProc.Caption := Format ('%3.0f %%', [f*100]);
      FPageZoom := f*100*cPdfBGPageZoomConst;
      sbForm.VertScrollBar.Position := 0;
      sbForm.HorzScrollBar.Position := 0;
      CEdit.AutoSize:=false;
      sbForm.Visible:=false;
      try
        //sbForm.ScaleBy(Round(f*100), 100); pokud by byl problem dalo by se resit i pomoci teto funkce
        for i := sbForm.ControlCount - 1 downto 0 do begin
          c:=sbForm.Controls[i];
          if (c is TImage) then begin
            TImage(c).Stretch:=True;
            TImage(c).Autosize:=False;
          end;
          if (c is TfaEdit) or (c is TcxDBCheckBox) or
            (c is TcxDBMemo) or (c is TcxListBoxEx) or
            (c is TShape) or (c is TLabel) or
            (c is TImage) or (c is TButton) or
            (c is TpsvWebLabel) or (c is TLabel) or (c is THTMLStaticText) then begin
            for j:=0 to FControlsPosition.Count - 1 do begin
              p:=Pos('=',FControlsPosition[j]);
              if Copy(FControlsPosition[j],1,p)=c.Name+'=' then begin
                s:=Copy(FControlsPosition[j],Length(c.Name)+2,MaxInt);
                if not(c is TImage) then
                  c.Left:=Round(StrToInt(GetListItem(s,0))*f);
                if not(c is TImage) then
                  c.Top:=Round(StrToInt(GetListItem(s,1))*f);
                c.Width:=Round(StrToInt(GetListItem(s,2))*f);
                c.Height:=Round(StrToInt(GetListItem(s,3))*f);

                if (c is TFaEdit) then
                  TfaEdit(c).Font.Size:=Round(StrToInt(GetListItem(s,4))*f)+2
                else if (c is TcxDBCheckBox) then
                  TcxDBCheckBox(c).Style.Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is TcxDBMemo) then
                  TcxDBMemo(c).Style.Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is TcxListBoxEx) then
                  TcxListBoxEx(c).Style.Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is TButton) then
                  TButton(c).Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is TLabel) then
                  TLabel(c).Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is TpsvWebLabel) then
                  TpsvWebLabel(c).Font.Size:=Round(StrToInt(GetListItem(s,4))*f)
                else if (c is THTMLStaticText) then
                  THTMLStaticText(c).Font.Size:=Round(StrToInt(GetListItem(s,4))*f);

                Break;
              end;
            end;
          end;
        end;
      finally
          sbForm.Visible:=true;
      end;
      //
      { // chyba #2139 pri zoomovani, opraveno 7.4.2017
      lastControl := FActuallyControl;
      FActuallyControl := GetFirstControl;
      ShowActuallyControl;
      FocusActuallyControl;
      FActuallyControl := lastControl;
      ShowActuallyControl;
      FocusActuallyControl;}
      if cxTvContent.CanFocus then // nove reseni
        cxTvContent.SetFocus;
      FocusActuallyControl;
      //
    end;
  end;
end;

procedure TfaMain.SaveOriginalControlsPosition;
var i,fs: integer;
  c:TControl;
begin
  if FControlsPosition.Text<>'' then //pri loadpage se vymaze, ukladame je jednou
    Exit;
  FControlsPosition.Clear;
  {if (mtContentImageHeight.Value>0) then} begin //podminkou jde omezit jen na formulare s obrazky na pozadi
    for i := sbForm.ControlCount - 1 downto 0 do begin
      c:=sbForm.Controls[i];
      if (c is TFaEdit) then
        fs:=TfaEdit(c).Font.Size
      else if (c is TcxDBCheckBox) then
        fs:=TcxDBCheckBox(c).Style.Font.Size
      else if (c is TcxDBMemo) then
        fs:=TcxDBMemo(c).Style.Font.Size
      else if (c is TcxListBoxEx) then
        fs:=TcxListBoxEx(c).Style.Font.Size
      else if (c is TButton) then
        fs:=TButton(c).Font.Size
      else if (c is TLabel) then
        fs:=TLabel(c).Font.Size
      else if (c is TpsvWebLabel) then
        fs:=TpsvWebLabel(c).Font.Size
      else if (c is THTMLStaticText) then
        fs:=THTMLStaticText(c).Font.Size
      else
        fs:=0;
      if (c is TfaEdit) or (c is TcxDBCheckBox) or
        (c is TcxDBMemo) or (c is TcxListBoxEx) or
        (c is TShape) or (c is TLabel) or
        (c is TImage) or (c is TButton) or
        (c is TpsvWebLabel) or (c is TLabel)
        or (c is THTMLStaticText) then begin
        FControlsPosition.Add(c.Name+'='+IntToStr(c.Left)+','+IntToStr(c.Top)+','
          +IntToStr(c.Width)+','+IntToStr(c.Height)+','+IntToStr(fs));
      end;
    end;
    //{SaveStringToFile(FControlsPosition.Text,'D:\controls.txt');}
  end;
end;

procedure TfaMain.InitZoomParams;
begin
  paZoom.Visible:={(mtContentImageHeight.Value>0) and} not paCbAppendix.Visible; //mohlo by byt v otevirani formulare, ale tady je to vse pohromade
  if (mtContentImageHeight.Value>0) or (FPDFBgFileName <> '') then
    tbZoom.Properties.Min := -5
  else
    tbZoom.Properties.Min := 0;
  if tbZoom.Position<tbZoom.Properties.Min then
    tbZoom.Position := tbZoom.Properties.Min;
  tbZoom.Properties.Max := 5;
  dxBarLargeButtonZoomUp.Enabled := tbZoom.Position < tbZoom.Properties.Max;
  dxBarLargeButtonZoomDown.Enabled := tbZoom.Position > tbZoom.Properties.Min;
end;

procedure TfaMain.tbZoomPropertiesChange(Sender: TObject);
begin
  ZoomControlsPosition(false);
end;

procedure TfaMain.ZoomUp;
begin
  if FFileOpened and not FIsDesignMode then begin
    //V poznamkach
    if mtContent.Active and
      ((mtContentPage.Value = cNotesID) or (mtContentPage.Value = cAppendixID)) then begin
        if (reNotes.ViewProperty.ZoomPercent < reNotes.ViewProperty.ZoomMax) then begin
          reNotes.ViewProperty.ZoomPercent:=reNotes.ViewProperty.ZoomPercent+10;
      end;
    end
    //na strankach formulare
    else if (tbZoom.Position < tbZoom.Properties.Max) then begin
      tbZoom.Position := tbZoom.Position + 1;
      dxBarLargeButtonZoomUp.Enabled := tbZoom.Position < tbZoom.Properties.Max;
      dxBarLargeButtonZoomDown.Enabled := tbZoom.Position > tbZoom.Properties.Min;
    end;
  end;
end;

procedure TfaMain.ZoomDown;
begin
  if FFileOpened and not FIsDesignMode then begin
    //V poznamkach
    if mtContent.Active and
      ((mtContentPage.Value = cNotesID) or (mtContentPage.Value = cAppendixID)) then begin
      if (reNotes.ViewProperty.ZoomPercent > reNotes.ViewProperty.ZoomMin) then begin
        reNotes.ViewProperty.ZoomPercent:=reNotes.ViewProperty.ZoomPercent-10;
      end;
    end
    //na strankach formulare
    else if (tbZoom.Position > tbZoom.Properties.Min) then begin
      tbZoom.Position := tbZoom.Position - 1;
      dxBarLargeButtonZoomUp.Enabled := tbZoom.Position < tbZoom.Properties.Max;
      dxBarLargeButtonZoomDown.Enabled := tbZoom.Position > tbZoom.Properties.Min;
    end;
  end;
end;

procedure TfaMain.ZoomNormal;
begin
  if FFileOpened and not FIsDesignMode then begin
    //V poznamkach
    if mtContent.Active and
      ((mtContentPage.Value = cNotesID) or (mtContentPage.Value = cAppendixID)) then begin
      reNotes.ViewProperty.ZoomPercent:=100;
    end
    //na strankach formulare
    else if (tbZoom.Position <> 6) then begin
      tbZoom.Position := 0;
      dxBarLargeButtonZoomUp.Enabled := tbZoom.Position < tbZoom.Properties.Max;
      dxBarLargeButtonZoomDown.Enabled := tbZoom.Position > tbZoom.Properties.Min;
    end;  
  end;
end;

