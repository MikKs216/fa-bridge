//FAShowNextFrm
//  prepne na jine okno FA pokud je otevreno vice formularu - oken FA
//  AFrmId - aktualni ID formulare
//  ANextFrm - true - najde dalsi FA frm
//           - false - najde predchozi FA frm
procedure TfaMain.FAShowNextFrm(
   const AFrmId: integer;
   const ANextFrm: boolean);

   procedure FindFA(
     const AFrmId: integer;
     const ANo: integer;
     var AActivatedFrm: TfaMain;
     var AFindNext, ABreak: boolean);
   begin
     ABreak := false;
     if (Application.Components[ANo] is TfaMain) then begin
       if AActivatedFrm=nil then //inicializace mimo cyklus
         AActivatedFrm := (Application.Components[ANo] as TfaMain);

       if AFindNext then begin
         AActivatedFrm := (Application.Components[ANo] as TfaMain);
         ABreak := True;
       end;

       if ((Application.Components[ANo] as TfaMain).GetFormID=AFrmId) then
         AFindNext := True;
     end;
   end;

var
   i: integer;
   activatedFrm: TfaMain;
   findNext, prerusit: boolean;
begin
   activatedFrm := nil;
   findNext := false;
   prerusit := false;
   try
     if ANextFrm then begin
       for i := 0 to Application.ComponentCount - 1 do begin
         FindFA(AFrmId, i, activatedFrm, findNext, prerusit);
         if prerusit then
           Break;
       end;
     end
     else begin //zpetne
       for i := Application.ComponentCount - 1 downto 0 do begin
         FindFA(AFrmId, i, activatedFrm, findNext, prerusit);
         if prerusit then
           Break;
       end;
     end;

     if activatedFrm<>nil then
       activatedFrm.BringToFront;
   except //kvuli caste chybe List index out of bounds
     on e:EListError do begin
     end;
   end;
end;

