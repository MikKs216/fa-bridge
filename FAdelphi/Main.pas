procedure TfaMain.SetCalcOfActuallyField(const AFieldName: string;
  ADisableCalc: boolean);
begin
  if mtFields.Active and
    mtFields.FindKey([UpperCase(AFieldName)])
    {mtFields.Locate(mtFieldsName.FieldName, AFieldName, //opt
    [loCaseInsensitive])}and mtFieldsHasCalc.Value then begin
    if mtFieldsIsCalculated.Value <> not ADisableCalc then begin
      mtFields.Edit;
      mtFieldsIsCalculated.Value := not mtFieldsIsCalculated.Value;
      mtFields.Post;
      //
      if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
        if ADisableCalc then
          SetFormUserSetting(cUSCalcDisabledForFlds,
            AddValueToList(GetFormUserSetting(cUSCalcDisabledForFlds),
            AFieldName))
        else
          SetFormUserSetting(cUSCalcDisabledForFlds,
            RemoveValueFromList(GetFormUserSetting(cUSCalcDisabledForFlds),
            AFieldName));
      end;
      //
      SetCalcEdits(FALSE);
      if not ADisableCalc then
        DoCalculate;
      FocusActuallyControl;
    end;
  end;
end; {SetCalcOfActuallyField}

procedure TfaMain.SetEnablingOfActuallyField(const AFieldName: string;
  ADisableEnabling: boolean);
begin
  if mtFields.Active and
    mtFields.FindKey([UpperCase(AFieldName)])
    {mtFields.Locate(mtFieldsName.FieldName, AFieldName, //opt
    [loCaseInsensitive])}and mtFieldsHasEnabling.Value then begin
    if mtFieldsIsSetForEnabling.Value <> not ADisableEnabling then begin
      mtFields.Edit;
      mtFieldsIsSetForEnabling.Value := not mtFieldsIsSetForEnabling.Value;
      mtFields.Post;
      //
      if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
        if ADisableEnabling then
          SetFormUserSetting(cUSEnablingDisabledForFlds,
            AddValueToList(GetFormUserSetting(cUSEnablingDisabledForFlds),
            AFieldName))
        else
          SetFormUserSetting(cUSEnablingDisabledForFlds,
            RemoveValueFromList(GetFormUserSetting(cUSEnablingDisabledForFlds),
            AFieldName));
      end;
      //
      DoEnable;
      FocusActuallyControl;
    end;
  end;
end; {SetEnablingOfActuallyField}

procedure TfaMain.dxBarButtonDisableCalcFieldClick(Sender: TObject);
var
  isCalculated, showMsg: boolean;
  nazevUdaje: string;
  c: string;
  i: Integer;
begin
  if FActuallyControl <> nil then begin
    if dxBarButtonDisableCalcField.Down and
      (MessageAsk(Caption, sAskDisableCalcFld, [MBYES, MBNO]) = IDNO) then
      dxBarButtonDisableCalcField.Down := FALSE
    else begin
      showMsg := TControl(FActuallyControl).Name = CEdit.Name;
      if showMsg then
        nazevUdaje := TControl(FActuallyControl).Hint
      else
        nazevUdaje := TControl(FActuallyControl).Name;
      isCalculated := VarToBool(mtFields.Lookup(mtFieldsName.FieldName,
        UpperCase(nazevUdaje), mtFieldsIsCalculated.FieldName));
      SetCalcOfActuallyField(nazevUdaje, isCalculated);
      if showMsg then begin
        {MessageInfo(Caption, sMsgVypnotyVypocet, [MBOK]);}
        //kdyz se to vola z lok. menu tak musime preskocit aby se obnovilo zobrazeni
        if mtFields.FindKey([UpperCase(CEdit.Hint)]) then begin
          c:=CEdit.Hint;
          if cxTvContent.CanFocus then
            cxTvContent.SetFocus;
          for i := 0 to sbForm.ControlCount - 1 do begin
            if sbForm.Controls[i].Name = c then begin
              FActuallyControl:=sbForm.Controls[i];
              Break;
            end;
          end;
          FocusActuallyControl;
        end;
      end;
    end;
  end;
end;

procedure TfaMain.dxBarButtonEnableFieldEditClick(Sender: TObject);
var
  c: string;
  i: Integer;
begin
  if FActuallyControl <> nil then begin
    if mtFields.Active then begin
      if FActuallyControl=CEdit then begin
        if mtFields.FindKey([UpperCase(CEdit.Hint)]) then begin
          SetEnablingOfActuallyField(CEdit.Hint,
            mtFieldsIsSetForEnabling.Value);
          c:=CEdit.Hint;
          if cxTvContent.CanFocus then
