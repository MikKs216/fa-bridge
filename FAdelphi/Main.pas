procedure TfaMain.SetDesignContent(AActive: boolean);
var
  stateFormWasChanged: boolean;
begin
  cxContentDBTableView1.OptionsData.Appending := AActive;
  cxContentDBTableView1.OptionsData.Inserting := AActive;
  cxContentDBTableView1.OptionsData.Deleting := AActive;
  cxContentDBTableView1.OptionsData.Editing := AActive;
  cxContentDBTableView1.OptionsSelection.CellSelect := AActive;
  cxContentDBTableView1.OptionsView.Header := AActive;
  cxContentDBTableView1.OptionsCustomize.ColumnHorzSizing := AActive;
  if AActive then begin
    ShowContentAsTable;
    FPaLeftWidthRun := paLeft.Width;
    paLeft.Width := FPaLeftWidthInDesignMode;
    LoadDesignContentGridFromIni;
  end
  else begin
    SaveDesignContentGridToIni;
    FPaLeftWidthInDesignMode := paLeft.Width;
    paLeft.Width := FPaLeftWidthRun;
    if paLeft.Width = paLeft.Constraints.MinWidth then
      ShowContentAsMinList
    else begin
      ShowContentAsTreeView;
      cxTvContent.GotoBOF;
      if (cxTvContent.FocusedNode <> nil) and
        (cxTvContent.FocusedNode.Values[1] <> '') then begin
        stateFormWasChanged := FStateFormWasChanged;
        mtContent.Locate(mtContentKey.FieldName,
          cxTvContent.FocusedNode.Values[1], []);
        SetChangeFlag(stateFormWasChanged);
      end;
    end;
  end;
end; {SetDesignContent}

