  if WindowState <> wsNormal then EXIT;
{$ENDIF STANDALONE}
  if FShowLoadingWindow<>0 then EXIT;

  if CanWriteToIniFile then begin
    iniFile := TMemIniFile.Create(GetIniFileName);
