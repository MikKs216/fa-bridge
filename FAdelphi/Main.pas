function TfaMain.SaveDataDef(const AFileName: string;
  ASaveCompiledScript: boolean = FALSE): boolean;
var
  bm: TBookmarkStr;
  archivePath: string;
begin
  FCanClose := FALSE;
  try
    if not ASaveCompiledScript then begin
      mtDef.Edit;
      mtDefCompiledScript.Clear;
      mtDef.Post;
      CheckAndLoadScript; //zapise do mtFields informace ze scriptu
      //
      {$IFDEF FINALBUILD}
      if FParamSaveDefBakFile then
        DeleteFile(ChangeFileExt(AFileName, '.bak'));
      RenameFile(AFileName, ChangeFileExt(AFileName, '.bak'));
      {$ENDIF FINALBUILD}
    end;
    //
    PrepareDirWork;
    //
    bm := mtContent.Bookmark;
    FIsLoadingContent := TRUE;
    try
      {mtContent.DefaultFormat:=mtPrgTablesFormat;}
      mtContent.DefaultFormat := mtSaveFormat;
      mtContent.SaveToFile(NormalPath(DirWorkPath) + mtContent.Name);
    finally
      mtContent.Bookmark := bm;
      FIsLoadingContent := FALSE;
    end;
    mtFields.DefaultFormat := mtPrgTablesFormat;
    mtFields.SaveToFile(NormalPath(DirWorkPath) + mtFields.Name);
    mtFieldsInfo.DefaultFormat := mtPrgTablesFormat;
    mtFieldsInfo.SaveToFile(NormalPath(DirWorkPath) + mtFieldsInfo.Name);

    mtDef.DefaultFormat := mtPrgTablesFormat;
    mtDef.SaveToFile(NormalPath(DirWorkPath) + mtDef.Name);
    if mtValues.Active then begin
      if dxBarButtonDesignMode.Down then
        GenMtValues(TRUE,FALSE)
      else if not ASaveCompiledScript then
        GenMtValues;
      SaveStringToFile(StoreMtValuesDef, NormalPath(DirWorkPath) + mtValues.Name);
    end;
    if FNewScripter then
      FControlsNamesList.SaveToFile(NormalPath(DirWorkPath) + cControlsNamesListFN);
    //
    {$IFNDEF FINALBUILD}
    if FParamSaveDefBakFile then //v design modu mazeme soubor az tady, kdyby k necemu doslo
      DeleteFile(ChangeFileExt(AFileName, '.bak'));
    //ulozime i do archivu
    archivePath:=NormalPath(ExtractFilePath(Application.ExeName))+'Archiv';
    if not DirectoryExists(archivePath) then
      CreateDir(archivePath);
    if DirectoryExists(archivePath) then
      CopyFile(PChar(AFileName),
      PChar(GetUniqueFileName(archivePath,ExtractFileName(AFileName))), FALSE);
    //
    RenameFile(AFileName, ChangeFileExt(AFileName, '.bak'));
    {$ENDIF FINALBUILD}
  {$IFDEF EXTERNALDESIGNER}
    Result := ZipFile(NormalPath(DirWorkPath) + '*.', AFileName, GetDefInfo,
      cExternalPass);
  {$ELSE EXTERNALDESIGNER}
    Result := ZipFile(NormalPath(DirWorkPath) + '*.', AFileName, GetDefInfo,
      dpsw);
  {$ENDIF EXTERNALDESIGNER}
    //
    ConnectMtValues;
  finally
    FCanClose := TRUE;
  end;
end; {SaveDataDef}
//pripravi informace o definici pro zapis do komentare zipu

