//SetDataFormField
//Nastaví textovou hodnotu udaje v datech predanych v parametru ADataString.
//Vraci data z parametru ADataString se zmenenou hodnotou udaje.

function TfaMain.SetDataFormField(const ADataString: string;
  const AFieldName, AFieldValue: string): string;
var
  sl, sl1: TStringList;
  i: integer;
  isInValuesSection, found: boolean;
begin
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    found:=FALSE;
    sl.Text := ADataString;
    for i:=0 to sl.Count-1 do begin
      if Copy(sl[i],1,1)='[' then
        isInValuesSection:=FALSE;
      if sl[i]=cFormValuesLabel then
        isInValuesSection:=TRUE;
      if isInValuesSection and (Pos('=',sl[i])>0) and
        (UpperCase(Trim(Copy(sl[i],1,Pos('=',sl[i])-1)))=
        UpperCase(AFieldName)) then begin
        sl[i]:=Trim(Copy(sl[i],1,Pos('=',sl[i])-1))+'='+AFieldValue;
        found:=TRUE;
      end;
    end;
    if not found then begin
      for i:=0 to sl.Count-1 do begin
        sl1.Add(sl[i]);
        if Copy(sl[i],1,Length(cFormValuesLabel))=cFormValuesLabel then
          sl1.Add(UpperCase(AFieldName)+'='+AFieldValue);

      end;
    end;
    if found then
      Result:=sl.Text
    else
      Result:=sl1.Text;
  finally
    sl.Free;
    sl1.Free;
  end;
end; {SetDataFormField}

