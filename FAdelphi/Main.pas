      sl.Clear;
      st.Clear;
      //
      sl.Text := GetFormData;
      //musime ulozit i do AStreamForm aby se data po calculate vratila do databaze
      sl.SaveToStream(AStreamForm);
      AStreamForm.Seek(0, soFromBeginning);
      //StoredStrings
      mtStoredStrings.SaveToStream(stSS);
      stSS.Seek(0, soFromBeginning);
     //
      s := GetPeriod;
      APeriodYear := StrToIntSafe(GetListItem(s, 0));
      APeriodFrom := StrToDateSafe(GetListItem(s, 1));
      APeriodTo := StrToDateSafe(GetListItem(s, 2));
