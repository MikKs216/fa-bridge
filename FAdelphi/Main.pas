//zobrazi edit nad AfaEdit

procedure TfaMain.ShowEdit(AfaEdit: TfaEdit);
var
  rect: TRECT;
begin
  if Designer.Active then
    EXIT;
  {$IFNDEF FINALBUILD}
  if tmsDesigner <> nil then
    EXIT;
  {$ENDIF FINALBUILD}

  if AfaEdit <> nil then begin

    if FOldEdit <> nil then begin
      rect.Left := FOldEdit.Left - 1;
      rect.Right := FOldEdit.Left + FOldEdit.Width + 2;
      rect.Top := FOldEdit.Top - 1;
      rect.Bottom := FOldEdit.Top + FOldEdit.Height + 2;
      InvalidateRect(sbForm.Handle, @rect, true);
    end;

    if CEdit.EditModified then
      CEdit.PostEditValue;

    HideEdit;
    CEdit.Parent := sbForm;

    Cedit.Perform(WM_SETREDRAW, 0, 0);
    CEdit.Left := AfaEdit.Left - 1;
    CEdit.Top := AfaEdit.Top - 1;
    CEdit.Width := AfaEdit.Width + 2;

    CEdit.Height := AfaEdit.Height + 2;
    CEdit.Style.Font:=AfaEdit.Font;

    CEdit.Style.BorderColor := AfaEdit.BorderColor;
    CEdit.FldType := AfaEdit.FldType;
    CEdit.FldTypeDecimalPlaces := AfaEdit.FldTypeDecimalPlaces;
    CEdit.RestrictLength := AfaEdit.RestrictLength;
    {CEdit.Style.BorderStyle := ebsSingle;}//opt
    CEdit.SelectedColor := AfaEdit.SelectedColor;
    CEdit.NextDirection := AfaEdit.NextDirection;
    CEdit.NextField := AfaEdit.NextField;
    CEdit.NextFieldBack := AfaEdit.NextFieldBack;
    //do hintu si ulozime nazev udaje, nezobrazuje se
    CEdit.Hint := AfaEdit.Name;
    CEdit.DisplayFormat := AfaEdit.DisplayFormat;
    CEdit.Style.Color := AfaEdit.Color;
    CEdit.SelectedColor := AfaEdit.Color;
    CEdit.Style.Font.Color := AfaEdit.Font.Color;
    //nastaveni vypoctenych udaju
    CEdit.Properties.ReadOnly := AfaEdit.Tag = 1;
    CEdit.DataBinding.DataSource := AfaEdit.DataSource;
    CEdit.DataBinding.DataField := AfaEdit.DataField;
    //nastaveni borderinfo
    CEdit.HighlightList := AfaEdit.HighlightList;
    CEdit.HighlightDefVal := AfaEdit.HighlightDefVal;
    CEdit.HighlightListColor := AfaEdit.HighlightListColor;
    CEdit.HighlightDefValColor := AfaEdit.HighlightDefValColor;
    //
    CEdit.OnMouseDown := DoOnMouseDown;
    CEdit.Perform(WM_SETREDRAW, 1, 0);
    CEdit.UpdateInEdit;
    CEdit.SelectAll;
    CEDit.InvalidateRect(CEdit.VisibleBounds, true);
    FOldEdit := AfaEdit;
    FEditingState := FALSE;
    CEditEnter(CEdit);
  end;
end; {ShowEdit}

//znevidilelni edit

procedure TfaMain.HideEdit;
begin
  try
    if (CEdit <> nil) and (CEdit.Parent <> nil) and (CEdit.Parent <> sbBackGround) then begin
      CEditExit(CEdit);//opt
      CEdit.DataBinding.DataField := '';
      CEdit.Parent := sbBackGround;
    end;
  except
  end;  
end; {HideEdit}

//vstoupi do editace

procedure TfaMain.SetEditState(AEditing: boolean);
begin
  if (CEdit <> nil) and CEdit.Focused then begin
    if AEditing then begin
      if CEdit.Text <> '' then begin
        CEdit.SelStart := maxint;
        CEdit.SelLength := maxint;
        FEditingState := TRUE;
      end;
    end
    else begin
      CEdit.SelStart := 0;
      CEdit.SelLength := maxint;
      FEditingState := FALSE;
    end;
  end
  else if (ActiveControl<>nil) and (ActiveControl.Parent<>nil) and
    (ActiveControl.Parent is TCxDBMemoEx) then
    with TCxDBMemoEx(ActiveControl.Parent) do begin
      if AEditing then begin
        if Text <> '' then begin
          SelStart := maxint;
          SelLength := maxint;
          FEditingState := TRUE;
        end;
      end
      else begin
        SelStart := 0;
        SelLength := maxint;
        FEditingState := FALSE;
      end;
    end;
end; {SetEditState}

//zobrazi aktualni control (pokud je to TfaEdit), jinak nedela nic

procedure TfaMain.ShowActuallyControl;
begin
  if (FActuallyControl <> nil) and (FActuallyControl is TfaEdit) then
    ShowEdit(TfaEdit(FActuallyControl));
end; {ShowActuallyControl}

//nastavi editaci (edit, nebo focus) na aktualni control
//  doplnit dalsi controls pro editaci

procedure TfaMain.FocusActuallyControl;
begin
  if FActuallyControl <> nil then begin
    {if FActuallyControl <> CEdit then
      HideEdit;}
    if FActuallyControl is TfaEdit then begin
      ShowEdit(TfaEdit(FActuallyControl));
      if (CEdit <> nil) and CEdit.CanFocus then begin
        CEdit.SetFocus;
        {$IFDEF UCURSOR}
        FBridge.WriteFieldText(CEdit.Hint);
        {$ENDIF UCURSOR}
      end;
    end
    else begin
      //HideEdit;
      if FActuallyControl is TcxDBCheckBox then begin
        if TcxDBCheckBox(FActuallyControl).CanFocus then
          TcxDBCheckBox(FActuallyControl).SetFocus;
      end
      else if FActuallyControl is TcxDBMemo then begin
        if TcxDBMemo(FActuallyControl).CanFocus then
          TcxDBMemo(FActuallyControl).SetFocus;
      end
      else if FActuallyControl is TcxListBoxEx then begin
        if TcxListBoxEx(FActuallyControl).CanFocus then
          TcxListBoxEx(FActuallyControl).SetFocus;
      end
      else if FActuallyControl is TDBRichViewEdit then begin
        if TRichEdit(FActuallyControl).CanFocus then
          TRichEdit(FActuallyControl).SetFocus;
      end;
    end;

    {Kvuli chybe zobrazovani s obrazky na pozadi. Muselo byt zruseno protoze
     nefungovalo tlacitko u editu.

    if not (FActuallyControl is TfaEdit) and (CEdit <> nil) then
      CEdit.Visible := FALSE;
    }

    //
    ShowFieldInstruction;
    ShowFieldState;
    faFieldHelp.Enabled := IsFocusedField and
      not FIsActiveFieldInstruction;
    //nastaveni HistView
    if (FActuallyControl <> CEdit) and
      (FActuallyControl <> FLastActuallyControl) and FHistViewHasWrite then begin
      mtHistView.Append;
      mtHistViewComponentName.Value := FActuallyControl.Name;
      mtHistView.Post;
      INC(FHistViewIndex);
      dxBarButtonHistoryBack.Enabled := TRUE;
      dxBarButtonHistoryForward.Enabled := FALSE;
    end;
    FLastActuallyControl := FActuallyControl;
  end
  else if cxTvContent.CanFocus then
    cxTvContent.SetFocus
  else if cxContent.CanFocus then
    cxContent.SetFocus;
end; {FocusActuallyControl}

//najde prvni control a nastavi na nej focus

procedure TfaMain.FocusFirstControl;
begin
  FActuallyControl := GetFirstControl;
  FocusActuallyControl;
end; {FocusFirstControl}

procedure TfaMain.ScrollToActuallyControl;
begin
  SbForm.ScrollInView(FActuallyControl);
end;

