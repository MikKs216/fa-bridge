procedure TfaMain.DoCopyFrmAndClearFillingInfo(
  var AStreamForm: TMemoryStream;
  out ALocked: boolean;
  out AExpiration: TdateTime;
  out AComment: string;
  out ACommentAll: string;
  out ASysComment: string;
  out ACharacteristics: string;
  out AFillingNumber: string;
  out AFillingDate: TDateTime;
  out AWorkState: integer);
{$IFNDEF STANDALONE}
var
  lObj: TWinObj;
  reportSettings: TReportSettings;
  sl, sl1: TStringList;
  st, st1, stSS: TMemoryStream;
  s,dt, comAllNew, nl: string;

 function CalcCopieTxt(AComment: string; ANewLine: Boolean = false): string;
  var
    i, pBegin, pEnd, pCop: integer;
    zn, tBef, tCislo, tAft: string;
  begin
    pBegin := pos('(', AComment);
    pEnd  := pos(')', AComment);
    pCop := pos(sKopie, AComment);
    if (pCop>0) and (pBegin>0) and (pEnd>0) and (pBegin<pEnd) then begin
      tBef := '';
      tCislo := '';
      tAft := '';
      for i := 1 to length(AComment) do begin
        zn := copy(AComment, i, 1);
        if i<pBegin then
          tBef := tBef + zn
        else if (i>pBegin) and (i<pEnd) then
          tCislo := tCislo + zn
        else if (i>pEnd) then
          tAft := tAft + zn;
      end;
      if IsInteger(tCislo) then begin
        Result := tBef + '(' + IntToStr(StrToInt(tCislo)+1)+')'+tAft;
        //namet 3911 - odstraneni textu pred Kopie
        //Result := Trim(sKopie+ ' (' + IntToStr(StrToInt(tCislo)+1)+')'); //zruseno
      end;
    end
    else begin
      nl := ' ';
      if ANewLine then
        nl:=#13#10;
      Result := Trim(sKopie+' (1)' + nl + AComment);
    end;
  end;

{$ENDIF STANDALONE}
begin
{$IFNDEF STANDALONE}
  StartWait;
  gFormOpening:=True;
  sl:=TStringList.Create;
  sl1:=TStringList.Create;
  st := TMemoryStream.Create;
  st1 := TMemoryStream.Create;
  stSS := TMemoryStream.Create;
  try
    FDoCloseAutomatic := TRUE;
    SetFocusContent;
    FDataFileName := '';
    //vytvoreni ikony v outlookbaru
    lObj := TWinObj.Create;
    lObj.Window := self;
    lObj.WindowIcon := 1;
    lObj.WindowText := FDatabaseCaption;
    lObj.WindowIconText := Copy(FDatabaseCaption, 1, Max(1,
      Pos(' ', FDatabaseCaption)));
    dmGlobObj.gFAllWindow.AddObj(lObj);
    Application.MainForm.Perform(Msg_UpdateListWindow, 1, 0);
    FSaveHistoryToDB := FALSE;
    //
    AStreamForm.Seek(0, soFromBeginning);
    sl.LoadFromStream(AStreamForm);
    AStreamForm.Seek(0, soFromBeginning);
    AStreamForm.Clear;

    if OpenFileDataString(sl.Text) then begin
      ApplyMainCaption(mtDefName.Value);
      FStateFormLocked := false;
      ALocked := FStateFormLocked;

      //
      reComment.SaveTextToStream('', st1, 0, FALSE, FALSE);
      st1.Seek(0, soFromBeginning);
      sl1.Clear;
      sl1.LoadFromStream(st1);
      ACommentAll := sl1.Text;
      comAllNew := sl1.Text;
      if sl1.Count = 0 then begin
        AComment := sKopie+' (1)';
        comAllNew := sKopie+' (1)';
      end
      else if sl1.Count = 1 then begin
        AComment := CalcCopieTxt(sl1[0]);
        comAllNew := CalcCopieTxt(sl1[0], true);
      end
      else begin
        if sl1[0]='' then begin
          AComment := CalcCopieTxt(sl1[1]);
          sl1.Delete(0);
          comAllNew := CalcCopieTxt(sl1.Text, true);
          ACommentAll := sl1.Text;
        end
        else begin
          AComment := CalcCopieTxt(sl1[0]);
          comAllNew := CalcCopieTxt(sl1.Text, true);
        end;
      end;
      sl1.Clear;
      st.Clear;
      st1.Clear;
      //

      FScriptState := ssDoClearFillingInfo;
      try
        mtTskp.Edit;
        try
          mtTskpFillingDate.Value:='';
          mtTskpFillingNumber.Value:='';
          mtTskpFillingPassword.Value:='';
          mtTskpFillingURL.Value:='';
          mtTskpFillingState.Clear;
          mtTskpFillingTimeStampDate.Value:='';
          mtTskpFillingTimeStampSignature.Value:='';
          mtTskpComment.Value:=comAllnew;
        finally
          mtTskp.Post;
        end;

        if FNewScripter then
          ScripterT_ExecuteSubRoutine(sScriptProcName_OnClearFillingInfo)
        else
          Scripter.CallNoParamsMethod(sScriptProcName_OnClearFillingInfo);
      finally
        FScriptState := ssNoActive;
      end;

      ASysComment:=GetSysComment;
      ACharacteristics:=GetCharacteristics;
      SetTskpInfo;
      sl.Clear;
      sl.Text := GetFormData;
      //musime ulozit i do AStreamForm aby se data po calculate vratila do databaze
      sl.SaveToStream(AStreamForm);
      AStreamForm.Seek(0, soFromBeginning);
      //StoredStrings
      mtStoredStrings.SaveToStream(stSS);
      stSS.Seek(0, soFromBeginning);
     //
      if Pos(' ',mtTskpFillingDate.Value)>0 then
        dt:=Copy(mtTskpFillingDate.Value,1,Pos(' ',mtTskpFillingDate.Value)-1)
      else
        dt:=mtTskpFillingDate.Value;
      AFillingDate := StrToDateSafe(dt);
      AFillingNumber := mtTskpFillingNumber.Value;
      AWorkState := mtTskpWorkState.Value;
      AExpiration := StrToDateSafe(mtTskpExpirationDate.Value);
      //
      SetChangeFlag(FALSE);
    end
    else
      AStreamForm := nil;
    while not FCanClose do
      Application.ProcessMessages;
    CloseForm;
  finally
    sl.Free;
    sl1.Free;
    st.Free;
    st1.Free;
    stSS.Free;
    gFormOpening:=False;
    StopWait;
