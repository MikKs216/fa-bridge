    if FNewScripter then
      ScripterT_ExecuteSubRoutine(sScriptProcNameOnClick + '_' +
        TControl(Sender).Name)
    else
      Scripter.CallNoParamsMethod(sScriptProcNameOnClick + '_' +
        TControl(Sender).Name);
  end;
end; {HTMLStaticTextClick}

//odkaz (anchor) musi byt zapsat ve tvaru: "GotoFld:NazevUdaje" nebo
//"GotoFnc:NazevFunkce" odpovidajici ve skriptu: OnClick_NazevFunkce
procedure TfaMain.HTMLStaticTextAnchorClick(Sender: TObject; Anchor: string);
var
  anch, gtName: string;
begin
  if Sender is THTMLStaticText then begin
    anch := Copy(Anchor, 1, 7);
    gtName := Copy(Anchor, 9, MaxInt);
    if SameText(anch, 'GotoFnc') then begin
      if FNewScripter then
        ScripterT_ExecuteSubRoutine(sScriptProcNameOnClick + '_' + gtName)
      else
        Scripter.CallNoParamsMethod(sScriptProcNameOnClick + '_' + gtName);
    end
    else if SameText(anch, 'GotoFld') then begin
      FGotoFieldName := gtName;
      PostMessage(Handle, WM_USERGotoField, 0, 0);
    end;
  end;
end; {HTMLStaticTextAnchorClick}

