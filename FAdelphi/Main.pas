//vraci Top u vsech komponent mimo CxDBCheckBox, kde vraci hodnotu nizsi
//  CxDBCheckBox ma standardne vysku 21 a nevejde se tak do radku s edity
//  pro posun kurzoru budeme brat v uvahu jen vysku ramecku boxu

function TfaMain.TopC(AControl: TControl): integer;
begin
  if AControl is TCxDBCheckBox then
    Result := AControl.Top + 7
  else
    Result := AControl.Top;
end; {TopC}

//vraci Height u vsech komponent mimo CxDBCheckBox, kde vraci hodnotu nizsi
//  CxDBCheckBox ma standardne vysku 21 a nevejde se tak do radku s edity
//  pro posun kurzoru budeme brat v uvahu jen vysku ramecku boxu

function TfaMain.HeightC(AControl: TControl): integer;
begin
  if AControl is TCxDBCheckBox then
    Result := AControl.Height - 8
  else
    Result := AControl.Height;
end; {HeightC}

//zjisti jestli je AControl editacni componenta, kterou podporujeme a je visible

function TfaMain.IsControlEditable(AC: TControl;
  ACanReadOnly: boolean = FALSE): boolean;
begin
  Result :=
    (AC is TfaEdit) and (TfaEdit(AC).Visible) and
    ((TfaEdit(AC).Tag = 0) or ACanReadOnly) or
    (AC is TcxDBCheckBox) and (TcxDBCheckBox(AC).Visible)
    and ((TcxDBCheckBox(AC).Tag = 0) or ACanReadOnly) or
    (AC is TcxDBMemo) and (TcxDBMemo(AC).Visible)
    and ((not TcxDBMemo(AC).Properties.ReadOnly) or ACanReadOnly) or
    (AC is TcxListBoxEx) and (TcxListBoxEx(AC).Visible) or
    (AC is TRichEdit) and (TRichEdit(AC).Visible);
end; {IsControlEditable}

function TfaMain.IsControlInRow(AC1, AC2: TControl): boolean;
begin
  Result := (AC1 = nil) or (AC2 = nil) or
    ((TopC(AC2) > TopC(AC1) - HeightC(AC2) + 3{1}) and
    (TopC(AC2) < TopC(AC1) + HeightC(AC1) - 3{1}));
end; {IsControlInRow}

function TfaMain.IsControlInCol(AC1, AC2: TControl): boolean;
begin
  Result := (AC1 = nil) or (AC2 = nil) or
    ((AC2.Left > AC1.Left - AC2.Width + 3{1}) and (
    AC2.Left < AC1.Left + AC1.Width - 3{1}));
end; {IsControlInRow}

//najde control ktery nejvice nahore vlevo pod urovni ATop vcetne
//  prvni vlevo nahore je control nejvice vlevo, prekryvajici se s nejvyssim

function TfaMain.GetFirstControl(ATop: integer = -maxint;
  ACanReadOnly: boolean = FALSE): TControl;
var
  i, xmin, ymin: integer;
  c, chigh, cleft: TControl;
begin
  if sbNotes.Visible then begin
    Result := reNotes;
    EXIT;
  end;
  xmin := maxint; //nejmensi Left
  ymin := maxint; //nejmensi Top
  chigh := nil; //nejvyssi control
  cleft := nil; //nejlevejsi control v rakdu s nejvyssim
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //control ktery zacina nejvys
    if IsControlEditable(c, ACanReadOnly) and ((TopC(c)+3) >= (ATop{0})) and (TopC(c) <
      ymin) then begin
      xmin := c.Left;
      ymin := TopC(c);
      chigh := c;
    end;
  end;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //pokud je na stejnem radku jako nejvyssi jeste jiny control, tak bereme ten co je vlevo
    if IsControlEditable(c, ACanReadOnly) and ((TopC(c)+3) >= (ATop{0})) and
      IsControlInRow(chigh, c) and (c.Left < xmin) then begin
      xmin := c.Left;
      cleft := c;
    end;
  end;
  if cleft <> nil then
    Result := TControl(cleft)
  else
    Result := TControl(chigh);
end; {GetFirstControl}

//najde control ktery nejvice vpravo dole nad urovni ADown vcetne
//  posledni vpravo dole je control nejvice vlpravo, prekryvajici se s nejnizsim

function TfaMain.GetLastControl(ATop: integer = maxint;
  ACanReadOnly: boolean = FALSE): TControl;
var
  i, xmax, ymax: integer;
  c, clow, cright: TControl;
begin
  xmax := -maxint; //nejvyssi Right
  ymax := -maxint; //nejvyssi Top
  clow := nil; //nejnizsi control
  cright := nil; //nejpravejsi control v radku s nejnizsim
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //control ktery konci nejniz
    if IsControlEditable(c, ACanReadOnly) and ((TopC(c) + HeightC(c) - 3{2}) < ATop)
      and
      ((TopC(c) + HeightC(c)) > ymax) then begin
      xmax := c.Left;
      ymax := TopC(c) + HeightC(c);
      clow := c;
    end;
  end;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //pokud je na stejnem radku jako nejnizssi jeste jiny control,
    //  tak bereme ten co je vpravo
    if IsControlEditable(c, ACanReadOnly) and ((TopC(c) + HeightC(c) - 3{2}) < ATop)
      and
      IsControlInRow(clow, c) and (c.Left > xmax) then begin
      xmax := c.Left;
      cright := c;
    end;
  end;
  if cright <> nil then
    Result := TControl(cright)
  else
    Result := TControl(clow);
end; {GetLastControl}

//najde control ktery nejvice nahore vpravo od urovne ATop vcetne

