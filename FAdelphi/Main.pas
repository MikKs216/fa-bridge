procedure TfaMain.LocateTreeItem;
var
  node: TcxTreeListNode;
begin
  FIsLoadingContent := TRUE;
  try
    with cxTvContent do begin
      node := TopNode;
      while node <> nil do begin
        if node.Values[1] = IntToStr(mtContentKey.Value) then begin
          if node.CanExpand then
            node.Expand(FALSE);
          if not node.IsVisible then begin
            if (node.Parent <> nil) and node.Parent.CanExpand then begin
              node.Parent.Expand(FALSE);
              //rozbalime i parenta od parenta pokud jde o node ve treti urovni zanoreni
              if (node.Parent.Parent <> nil) and
                node.Parent.Parent.CanExpand then
                node.Parent.Parent.Expand(FALSE);
            end
            else if (FocusedNode <> nil) and FocusedNode.CanExpand then
              FocusedNode.Expand(TRUE);
          end;
          FocusedNode := node;
          BREAK;
        end;
        node := node.GetNext;
      end;
    end;
  finally
    FIsLoadingContent := FALSE;
  end;
end; {LocateTreeItem}

//vytvori novou definici

procedure TfaMain.NewDef;
var
  res: integer;
begin
  if Designer.Active then
    Designer.Active := FALSE;
  //pokud neni soubor ulozen, zeptat se na ulozeni a ulozit
  if FStateFormWasChanged then begin
    res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
      FDefFileName + '?', [MBYES, MBNO, MBCANCEL]);
    if res = IDYES then
      SaveDef
    else if res = IDCANCEL then
      EXIT;
  end;
  CloseData;
  StartWait;
  try
    SetFocusContent;
    FDefFileName := cNewDefinitionFileName;
    FMaxContentKey := 0;
    EmptyPage;
    //vytvorit novy dataset
    mtDef.Close;
    mtDef.Open;
