procedure TfaMain.SetCheckBoxes(ACbGroup, ACheckBoxName: string;
  ADisableUncheck: boolean);
var
  i, j: integer;
  c: TControl;
  sl: TStringList;
  fld: TField;
begin
  StartWait;
  sl := TStringList.Create;
  sl.CommaText := ACbGroup;
  try
    for i := 0 to sbForm.ControlCount - 1 do begin
      c := sbForm.Controls[i];
      if c is TcxDBCheckBox then
        for j := 0 to sl.Count - 1 do begin
          fld := GetMTVField(TcxDBCheckBox(c).Name);
          if sl[j] = TcxDBCheckBox(c).Name then
            //checkbox je ve sledovane skupine
            if (TcxDBCheckBox(c).Name <> ACheckBoxName) then begin
              if (fld <> nil) and fld.AsBoolean then begin
                TryEditMtValues;
                fld.AsBoolean := FALSE;
                TryPostMtValues; // po tomto kontroly nevolame, dela se to tam kde se tato proc. vola
              end;
            end
            else begin //je to aktivni control
              if ADisableUncheck and (fld <> nil) and
                not fld.AsBoolean then begin
                TryEditMtValues;
                if mtValues.State = dsEdit then
                begin //kdyz jde o stejny udaj, jehoz zmena funkci vyvolala, nemusi se edit povest
                  fld.AsBoolean := TRUE;
                  TryPostMtValues; // po tomto kontroly nevolame, dela se to tam kde se tato proc. vola
                end;
              end;
            end;
        end;
    end;
  finally
    sl.Free;
    StopWait;
  end;
end; {SetCheckBoxes}

