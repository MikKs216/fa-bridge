procedure TfaMain.CxEditPropertiesValidate(Sender: TObject;
  var DisplayValue: Variant; var ErrorText: TCaption; var Error: Boolean);
var
  value: variant;
  ctrl: TControl;
  valString: string;
begin
  value := '';
  if DisplayValue <> '' then begin
    //cislo
    if (CEdit.FldType = fldtNumber) or (CEdit.FldType = fldtCurrency) then begin
      valString := VarToStr(DisplayValue);
      if CEdit.FldTypeDecimalPlaces > 0 then begin
        if CorrectNumberString(valString)then begin  //uprava 18.9.09 zakrouhlime podle poctu zobrazovanych cislic
          DisplayValue := FloatToStr(RoundAri(StrToFloat(valString),CEdit.FldTypeDecimalPlaces*-1));
        end
        else begin
          MessageErr(Caption, Format(sMsgErrNumString, [DisplayValue]), [MBOK]);
          CEdit.Text := '';
          CEdit.EditingText := '';
          DisplayValue := '';
          EXIT;
        end;
      end
      else begin
        if CorrectNumberString(valString, TRUE) then begin
          DisplayValue := FloatToStr(RoundAri(StrToFloat(valString),0));
        end
        else begin
          MessageErr(Caption,
            Format(sMsgErrNumIntegerString, [DisplayValue]), [MBOK]);
          CEdit.Text := '';
          CEdit.EditingText := '';
          DisplayValue := '';
          EXIT;
        end;
      end;
    end
    //datum
    else if CEdit.FldType = fldtDate then begin
      valString := CEdit.Text;
      if CorrectDateString(valString) then begin
        DisplayValue := valString;
      end
      else begin
        MessageErr(Caption, Format(sMsgErrDateString, [DisplayValue]), [MBOK]);
        CEdit.Text := '';
        CEdit.EditingText := '';
        DisplayValue := '';
        EXIT;
      end;
    end
    //string
    else if CEdit.FldType = fldtString then begin
      //^ v DisplayFormat - uppercase
      if Pos('^', CEdit.DisplayFormat) > 0 then begin
        value := ANSIUpperCase(DisplayValue);
        DisplayValue := value;
      end;
    end;
    CEdit.EditingText := DisplayValue;
    CEdit.EditValue := DisplayValue;
    //
    FScriptState := ssOnValidate;
    SetGScriptFieldName;
    FScriptFldDisplayValue := DisplayValue;
    try
      if FNewScripter then
        ScripterT_ExecuteSubRoutine(sScriptProcName_OnValidate + '_' + CEdit.Hint)
      else
        Scripter.CallNoParamsMethod(sScriptProcName_OnValidate + '_' + CEdit.Hint);
    finally
      FScriptState := ssNoActive;
    end;
    //
    ctrl := GetNextControl(CEdit);
    if (ctrl <> nil) and (ctrl.Name = CEdit.Hint) then begin
      FEditingState := FALSE;
      CEdit.SelStart := 0;
      CEdit.SelLength := maxint;
    end;
    SetHistEdit(CEdit.Hint, CEdit.EditingText);
    SaveText(CEdit);
  end;
end;

{------------------------------------------------------------------------------
Evaluate
  Vraci vypoctenou hodnotu vyrazu.
Vstup:
  AStrValue ... vyraz
  ASlData ... data formulare
------------------------------------------------------------------------------}

function TfaMain.Evaluate(AStrValue: string; ASlData: TStringList): string;
begin
  AStrValue := TranslateFieldNames(AStrValue);
  if FNewScripter then begin
    workScripterT.SourceCode.Text := 'result :='+AStrValue;
    Result := VarToStr(workScripterT.Execute());
  end
  else
    Result := VarToStr(WorkScripter.Evaluate(AStrValue));
end; {Evaluate}


{------------------------------------------------------------------------------
EvaluateByMethodName
  Vraci vypoctenou hodnotu funkce ze skriptu.
Vstup:
  AMethodName ... nazev funkce
------------------------------------------------------------------------------}
function TfaMain.EvaluateByMethodName(AMethodName: string): string;
begin
  if FNewScripter then
    Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName))
  else
    Result := Scripter.CallNoParamsMethod(AMethodName);
end; {EvaluateByMethodName}

{------------------------------------------------------------------------------
EvaluateByMethodNameParam
  Vraci vypoctenou hodnotu funkce (ktera ma parametry) ze skriptu.
Vstup:
  AMethodName ... nazev funkce
  AParam ... seznam parametru funkce (max 6 parametru, je mozne rozsirit)
             - parametry mohou byt libovolneho typu
             - pri volani musi byt parametry uzavrene do hranate zavorky
------------------------------------------------------------------------------}
function TfaMain.EvaluateByMethodNameParam(AMethodName: string; AParam: variant): string;
var
  i, c: integer;
begin
  Result := '';
  if not VarIsNE(AParam) then begin
    c:=0;
    for i := VarArrayLowBound(AParam, 1) to VarArrayHighBound(AParam, 1) do
      Inc(c);
    //
    if FNewScripter then begin
      if c = 1 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0]]))
      else if c = 2 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0], AParam[1]]))
      else if c = 3 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0], AParam[1], AParam[2]]))
      else if c = 4 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0], AParam[1], AParam[2], AParam[3]]))
      else if c = 5 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0], AParam[1], AParam[2], AParam[3], AParam[4]]))
      else if c = 6 then
        Result := VarToStr(ScripterT_ExecuteSubRoutine(AMethodName, [AParam[0], AParam[1], AParam[2], AParam[3], AParam[4], AParam[5]]))
    end
    else begin
      if c = 1 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[0]])
      else if c = 2 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[1], AParam[0]])
      else if c = 3 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[2], AParam[1], AParam[0]])
      else if c = 4 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[3], AParam[2], AParam[1], AParam[0]])
      else if c = 5 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[4], AParam[3], AParam[2], AParam[1], AParam[0]])
      else if c = 6 then
        Result := Scripter.DispatchMethod(AMethodName, [AParam[5], AParam[4], AParam[3], AParam[2], AParam[1], AParam[0]])
    end;
  end
  else begin
    if FNewScripter then
      Result := ScripterT_ExecuteSubRoutine(AMethodName)
    else
      Result := Scripter.CallNoParamsMethod(AMethodName);
  end;
end; {EvaluateByMethodNameParam}


procedure TfaMain.CEditKeyPress(Sender: TObject; var Key: Char);
begin
  if CEdit.FldType = fldtString then begin
    if (CEdit.FldTypeDecimalPlaces > 0) and
      (Length(CEdit.EditingText) > CEdit.FldTypeDecimalPlaces - 1) then begin
      if CEdit.RestrictLength then begin
        case Key of
          Chr(32)..Chr(255): begin
              if CEdit.SelText = '' then
                Key := #0;
            end;
        end;
      end;
    end;
    //
    if Pos('#', CEdit.DisplayFormat) > 0 then begin
      //#6005
      //Zpracovavaji se z ASCII tabulky znaky 32-255, mimo cisla
      //Ty znaky, ktere do DisplayFormat napiseme, ty bude mozno zadat
      //1. Vykricnik nefunguje vybec, protoze slouzi k omezeni na vyber ze seznamu
      //2. Podtrzitko se musi napsat 2x "__", protoze 1x "_" vyjadruje mezeru
      //3. Strizka se musi napsat 2x "^^", protoze 1x "^" slouzi k automaticke zmene textu na velka pismena
      //4. Mrizka se musi napsat 2x "##", protoze 1x "#" slouzi zadani cislic
      //5. Pokud bychom chteli umoznit zadat i pismena (napr. "CZ" pro DIC),
      //   musi se do DisplayFormat zadat velka i mala (tzn. napr. "#CZcz")      
      if ((Ord(Key) >=32) and (Ord(Key) < 48)) or                //zpracovavame vse mimo cisla 0..9
         ((Ord(Key) > 57) and (Ord(Key) <= 255)) then begin
        if (Key = ' ') then begin                                //mezera
          if ((Pos('__', CEdit.DisplayFormat) > 0) and (StrStrCount(CEdit.DisplayFormat,'_') = 2)) or
             (StrStrCount(CEdit.DisplayFormat,'_') = 0) then     //-musi se osetrit, bud napsat podtrzitko 1x, nebo 3x (pokud chceme zadat i podtrzitko)
            Key := #0;
        end
        else if (Key = '_') then begin                           //podtrzitko
          if (Pos('__', CEdit.DisplayFormat) = 0) then           //-musi se osetrit, protoze jedno podtrzitko vyjadruje mezeru
            Key := #0;
        end
        else if (Key = '^') then begin                           //strizka
          if (Pos('^^', CEdit.DisplayFormat) = 0) then           //-musi se osetrit, protoze jedna strizka vyjadruje velka pismena
            Key := #0;                                           
        end
        else if (Key = '#') then begin                           //mrizka
          if (Pos('##', CEdit.DisplayFormat) = 0) then           //-musi se osetrit, protoze jedna mrizka vyjadruje cislice
            Key := #0;                                           
        end
        else if Pos(Key, CEdit.DisplayFormat) = 0 then
          Key := #0;
      end;
      (*case Key of
        Chr(33)..Chr(42), {Chr(46),} Chr(60)..Chr(255): begin
            Key := #0;
          end;
        '/' {Chr(47)}: begin
            if Pos('/', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        '-' {Chr(45)}: begin
            if Pos('-', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        ' ' {Chr(32)}: begin
            if Pos('_', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        '.' {Chr(46)}: begin
            if Pos('.', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        ',' {Chr(44)}: begin
            if Pos(',', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        ';' {Chr(59)}: begin
            if Pos(';', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        '+' {Chr(43)}: begin
            if Pos('+', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
        ':' {Chr(58)}: begin
            if Pos(':', CEdit.DisplayFormat) = 0 then
              Key := #0;
          end;
      end;*)
    end;
    if Pos('!', CEdit.DisplayFormat) > 0 then begin //nedovoluje psani do udaje, jen vyber ze seznamu
      if Key<>#27 then begin
        if Key<>#8 then begin
          GListPressedChar:=Key;
          PostMessage(Self.Handle, WM_KEYDOWN, VK_F12, 0);
        end;
      end;
      if Key<>#8 then  //osetreno mazani pomoci Backspace #4159
        Key := #0;
    end;
  end
  //osetreni povolenych znaku pro cisla
  else if (CEdit.FldType = fldtNumber) or (CEdit.FldType = fldtCurrency) then begin
    //zmena tecky a carky na decimalseparator
    if (Key = '.') or (Key = ',') then
      Key := DecimalSeparator;
    //povoleni pouze jednoho decimalseparatoru
    if (Key = DecimalSeparator) and (Pos(DecimalSeparator,CEdit.Text)>0) and
      (CEdit.SelText='') then
      Key := #0;
    //povoleni pouze jednoho minusu
    if (Key = '-') and (Pos('-',CEdit.Text)>0) and (CEdit.SelText='') then
      Key := #0;
    //odstraneni ostatnich znaku
    if not ((Key>='0') and (Key<='9') or (Key=DecimalSeparator) or (Key='-') or
      (Key=#8){backcpace}) then
      Key := #0;
  end
  //osetreni povolenych znaku pro datum
  else if CEdit.FldType = fldtDate then begin
    //zmena tecky a carky na decimalseparator
    if (Key = '.') or (Key = ',') then
      Key := DateSeparator;
    //nechame projit vsechno protoze zadavat jdou uz i zkratky  
(*
    if not ((Key = '+') or (Key = '*') or (Key = '-') or (Key = '/')) then begin
      //odstraneni ostatnich znaku
      if not ((Key>='0') and (Key<='9') or
        (Key=DateSeparator) or (Key=TimeSeparator) or (Key=#8){backcpace}) then
        Key := #0;
    end;
*)   
  end;
end;

procedure TfaMain.CEditKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
var
  c: char;
  oldSelStart: integer;
begin
  if Pos('!', CEdit.DisplayFormat) > 0 then begin //nedovoluje psani do udaje, jen vyber ze seznamu
    if FEditingState or (Key<>46) then begin
      Key:=0;
    end;
  end;
  if CEdit.FldType = fldtString then begin
    //Ctrl+Shift+F4 zmena velikosti znaku AA->aa, aa->Aa, jinak ->AA
    if (Key = VK_F4) and (ssCtrl in Shift) and
      (ssShift in Shift) then with CEdit do begin
      Text := ChangeStringCase(Text);
      EditingText := ChangeStringCase(EditingText);
      Key := 0;
    end
    //F4 zmena diakritiky
    else if (Key = VK_F4) and not (ssShift in Shift) and not (ssAlt in Shift)
      and not (ssCtrl in Shift) then begin
        ChangeDiakriticProc;
        Key := 0;
    end;
  end;
end;

//Ctrl+Shift+F4 zmena velikosti znaku AA->aa, aa->Aa, jinak ->AA
procedure TfaMain.ChangeCharCaseProc;
begin
  if CEdit.FldType = fldtString then begin
    with CEdit do begin
      Text := ChangeStringCase(Text);
      EditingText := ChangeStringCase(EditingText);
    end;
  end;
end;

procedure TfaMain.ChangeDiakriticProc;
var
  c: Char;
  oldSelStart: integer;
begin
  with CEdit do begin
    if SelLength = 0 then begin
      oldSelStart := SelStart;
      SelStart := SelStart - 1;
      SelLength := 1;
      if SelLength = 1 then begin
        c := ChangeDiakritic(SelText[1]);
        if c <> SelText[1] then
          SendMessage(Handle, WM_CHAR, ord(c), 0);
        SelLength := 0;
      end;
      SelStart := oldSelStart;
    end;
  end;
end;

procedure TfaMain.ChangeMemoDiakr(AMemo: TCxDBMemoEx);
var
  c: char;
  oldSelStart: integer;
begin
  //F4 zmena diakritiky
  with AMemo do begin
    if SelLength = 0 then begin
      oldSelStart := SelStart;
      SelStart := SelStart - 1;
      SelLength := 1;
      if SelLength = 1 then begin
        c := ChangeDiakritic(SelText[1]);
        if c <> SelText[1] then
          SendMessage(Handle, WM_CHAR, ord(c), 0);
        SelLength := 0;
      end;
      SelStart := oldSelStart;
    end;
  end;
end; {ChangeMemoDiakr}

