procedure TfaMain.InitModifiedTime;
begin
  FStartModifiedTime := 0;
  if mtTskp.Active and (mtTskp.RecordCount > 0) then
    FModifiedTime := mtTskpModifiedTime.Value
  else
    FModifiedTime := 0;
end;

procedure TfaMain.StartModifiedTime;
begin
  if FStartModifiedTime = 0 then
    FStartModifiedTime := now;
end;

procedure TfaMain.StopModifiedTime;
begin
  if FStartModifiedTime <> 0 then begin
    FModifiedTime := FModifiedTime + SecondsBetween(now, FStartModifiedTime);
    if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
      if not (mtTskp.State in [dsEdit, dsInsert]) then
        mtTskp.Edit;
      mtTskpModifiedTime.Value := FModifiedTime;
      mtTskp.Post;
    end;
  end;
  FStartModifiedTime := 0;
end;

procedure TfaMain.SetTskpInfo;
begin
  StopModifiedTime;
  if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
    if not (mtTskp.State in [dsEdit, dsInsert]) then
      mtTskp.Edit;
    mtTskpModifiedDate.Value := now;
    mtTskpLocked.Value := FStateFormLocked;
    mtTskp.Post;
  end;
end;

