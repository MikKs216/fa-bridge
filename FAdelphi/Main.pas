function TfaMain.ApplyRestrictReportOptions(AReportSettings: TReportSettings): TReportSettings;
var
  restrictReportOptions: string;
  vFilledForm, vWithoutBackground, vEmptyForm, vOnlyValues: boolean;
begin
  Result := AReportSettings;
  //nastaveni povoleni obsahu tisku ze scriptu
  restrictReportOptions := GetRestrictReportOptions; //doplneno 2.12.14 Mik
  if restrictReportOptions <> '' then begin
    vFilledForm := Copy(restrictReportOptions, 1, 1) = '1'; //1 ... povoleno
    vWithoutBackground := Copy(restrictReportOptions, 2, 1) = '1';
    vEmptyForm := Copy(restrictReportOptions, 3, 1) = '1';
    vOnlyValues := Copy(restrictReportOptions, 4, 1) = '1';
    with Result do begin
      PrintForm := AReportSettings.PrintForm and
        (vFilledForm or vWithoutBackground or vEmptyForm);
      PrintValues := AReportSettings.PrintValues and
        (vFilledForm or vWithoutBackground or vOnlyValues);
      RemoveBackground := AReportSettings.RemoveBackground and
        vWithoutBackground;
    end;
  end;
end;

function TfaMain.ApplyAllPages(AReportSettings: TReportSettings;
  AOnlyRestricts: boolean = FALSE): TReportSettings;
var
  restrictReportOptions: string;
begin
  Result := AReportSettings;
  with Result do begin
    if not AOnlyRestricts then begin
      RepPagesAll := TRUE;
      RepPagesOdd := FALSE;
      RepPagesEven := FALSE;
      RepPagesOddThenEven := FALSE;
      RepPagesSelected := FALSE;
      RepSelectedPAges := '';
      RepCopies := 1;
    end;
    //nastaveni jen urcitych stran ze scriptu
    restrictReportOptions := GetRestrictReportOptions;
    if Copy(restrictReportOptions,6,maxint) <> '' then begin
      RepPagesSelected := TRUE;
      RepSelectedPages := Copy(restrictReportOptions,6,maxint);
    end;
  end;
end; {ApplyAllPages}

procedure TfaMain.UnzipReportDefs(const AReportDefFileName: string);
begin
  if DirectoryExists(DirWorkPath) and
     (Pos('#', AReportDefFileName)>0) then  //Marek(8.3.2017): mazeme, protoze je problem s tiskem jaz. variant v pripade,
    DeleteFiles(DirWorkPath, '*_NOBGD.*'); // ze v FDR jaz. varianty neni pdf soubor _NOBGD, ktery je v hlavnim FDR
  UnzipFile(AReportDefFileName, DirWorkPath);
end; {UnzipReportDefs}

{-----------------------------------------------------------------------------
 GetReportVariants
   Vraci seznam dostupnych variant sestav
 -----------------------------------------------------------------------------}

function TfaMain.GetReportVariants(const ADefID: string): string;
var
  varianta: string;
  sl: TstringList;
  i: integer;
  iniFileName: string;
  iniFile: TMemIniFile;
begin
  Result := '';
  FReportVariantsIsFR3 := False;
  sl := TstringList.Create;
  try
    //seznam jazykovych variant dle ini souboru
    iniFileName := GetReportIniFileName;
    if FileExists(iniFileName) then begin
      iniFile := TMemIniFile.Create(iniFileName);
      try
        if StrToBoolSafe(iniFile.ReadString(cRepIniSectionMain, cRepIniKeyFR3RepVar, '')) then begin
          iniFile.ReadSection(cRepIniSectionRepVar, sl);
          for i := 0 to sl.Count - 1 do
            if sl[i] <> '' then
              AddStringLine(Result, sl[i]);
        end;
      finally
        iniFile.Free;
        if Result <> '' then
          FReportVariantsIsFR3 := True;
      end;
    end;
    //seznam jazykovych variant dle fdr souboru
    if Result = '' then begin
      sl.Text := SearchFiles(NormalPath(ExtractFilePath(FDefFileName)),
        ADefID + '#*' + cReportDefaultExt, FALSE);
      Result := '';
      for i := 0 to sl.Count - 1 do begin
        varianta := Replace(cReportDefaultExt,
          Copy(ExtractFileName(sl[i]), Length(ADefID) + 2, maxint), '');
        if varianta <> '' then
          AddStringLine(Result, varianta);
      end;
    end;
  finally
    sl.Free;
  end;
end; {GetReportVariants}

{-----------------------------------------------------------------------------
 SetTskpData
   Transformuje data ulozena v texu do mtTskp
 -----------------------------------------------------------------------------}

procedure TfaMain.SetTskpData(const AData: string);
var
  sl: TStringList;
  i: integer;
  fld: TField;
  a: string;
begin
  sl := TStringList.Create;
  try
    sl.Text := AData;
    with mtTskp do begin
      if not Active then
        Open;
      if RecordCount = 0 then
        Append
      else
        Edit;
      for i := 0 to Fields.Count - 1 do begin
        fld := Fields[i];
        StringToField(sl.Values[fld.FieldName], fld);
      end;
      //Comment,Notes, Appendix
      mtTskpComment.Value := '';
      mtTskpNotes.Value := '';
      mtTskpAppendix.Value := '';
      a := GetSection(AData, cFormCommentLabel);
      if a<>#13#10#13#10 then //po importu tam muzou byt prazdne radky, musime odstranit
        mtTskpComment.Value := a;
      a:='';
      a:=GetSection(AData, cFormNotesLabel);
      if a<>#13#10#13#10 then
        mtTskpNotes.Value := a;
      a:='';
      a:=GetSection(AData, cFormAppendixLabel);
      if a<>#13#10#13#10 then
        mtTskpAppendix.Value := a;
      //
      Post;
    end;
  finally
    sl.Free;
  end;
end; {SetTskpData}

{-----------------------------------------------------------------------------
 SetValuesData
   Transformuje data ulozena v textu v neformatovanem tvaru do mtValues
 -----------------------------------------------------------------------------}

procedure TfaMain.SetValuesData(const AData: string);
var
  sl: TStringList;
  i: integer;
  fld: TField;
  ro, lc: boolean;
begin
  sl := TStringList.Create;
  ro := mtValues.ReadOnly;
  mtValues.ReadOnly := FALSE;
  lc := FIsLoadingContent;
  mtValues.DisableControls;
  try
    sl.Text := AData;
    GenMtValues(TRUE, TRUE);
    InitHistTables;
    with mtValues do begin
      if not Active then
        Open;
      if RecordCount = 0 then
        Append
      else
        Edit;
      FIsLoadingContent := TRUE;
      try
        for i := 0 to Fields.Count - 1 do begin
          fld := Fields[i];
          TryEditMtValues;
          StringToField(sl.Values[fld.FieldName], fld);
        end;
      finally
        FIsLoadingContent := lc;
      end;
      TryPostMtValues;
      //SetLiveCheck(True);
      //DisplayCheck; // tady zruseno
      Refresh;
      ShowActuallyControl;
    end;
  finally
    mtValues.EnableControls;
    mtValues.ReadOnly := ro;
    sl.Free;
  end;
end; {SetValuesData}

{-----------------------------------------------------------------------------
 SetAddedValuesData
   Naplni hodnoty zadane v textu v neformatovanem tvaru do mtValues
 -----------------------------------------------------------------------------}

procedure TfaMain.SetAddedValuesData(const AData: string);
var
  sl: TStringList;
  i: integer;
  fld: TField;
begin
  StartWait;
  sl := TStringList.Create;
  FCanClose := FALSE;
  //FScriptState := ssInit;
  try
    if mtFields.Active and mtValues.Active and
      (mtValues.RecordCount > 0) and not FStateFormLocked and
      not mtValues.ReadOnly then begin
      sl.Text:=AData;
      TryEditMtValues;
      with mtValues do begin
        for i := 0 to Fields.Count - 1 do begin
          fld := Fields[i];
          if sl.Values[fld.FieldName]<>'' then
            StringToField(sl.Values[fld.FieldName], fld);
        end;
      end;
      TryPostMtValues;
      SetLiveCheck(True);
      DisplayCheck; //po otevreni
      mtValues.Refresh;
    end;
  finally
    //FScriptState := ssNoActive;
    FCanClose := TRUE;
    sl.Free;
    StopWait;
  end;
end; {SetAddedValuesData}

procedure TfaMain.SetUserSettings(const AData: string);
