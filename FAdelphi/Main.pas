function TfaMain.ReportSettingsToLog(const reportSettings: TReportSettings): string;

  function BoolToStr(value: Boolean): string;
  begin
    if value then
      Result := '1'
    else
      Result := '0';
  end;

  function EscapeValue(const value: string): string;
  begin
    // Pokud řetězec obsahuje čárku, tečku nebo dvojtečku, dej do uvozovek
    if (Pos(',', value) > 0) or (Pos('.', value) > 0) or (Pos(':', value) > 0) then
      Result := '"' + value + '"'
    else
      Result := value;
  end;

var
  values: array[1..39] of string;
  i: Integer;
begin
  try
    // Vytvoř pole hodnot v pořadí deklarace
    values[1] := BoolToStr(reportSettings.PrintForm);
    values[2] := BoolToStr(reportSettings.PrintValues);
    values[3] := BoolToStr(reportSettings.RemoveBackground);
    values[4] := BoolToStr(reportSettings.NoFilledStrike);
    values[5] := BoolToStr(reportSettings.ZeroValueClear);
    values[6] := BoolToStr(reportSettings.NulNumValueFillZero);
    values[7] := BoolToStr(reportSettings.UseClientIdentification);
    values[8] := BoolToStr(reportSettings.UsePrgIdentification);
    values[9] := BoolToStr(reportSettings.PrintWithDialog);
    values[10] := BoolToStr(reportSettings.UseUserFont);
    values[11] := EscapeValue(reportSettings.FontName);
    values[12] := IntToStr(reportSettings.FontSize);
    values[13] := BoolToStr(reportSettings.FontBold);
    values[14] := BoolToStr(reportSettings.FontItalic);
    values[15] := IntToStr(reportSettings.FontColor);
    values[16] := IntToStr(reportSettings.ShiftX);
    values[17] := IntToStr(reportSettings.ShiftY);
    values[18] := BoolToStr(reportSettings.RepPagesAll);
    values[19] := BoolToStr(reportSettings.RepPagesOdd);
    values[20] := BoolToStr(reportSettings.RepPagesEven);
    values[21] := BoolToStr(reportSettings.RepPagesOddThenEven);
    values[22] := BoolToStr(reportSettings.RepPagesSelected);
    values[23] := EscapeValue(reportSettings.RepSelectedPages);
    values[24] := IntToStr(reportSettings.RepCopies);
    values[25] := BoolToStr(reportSettings.RepInternalReader);
    values[26] := BoolToStr(reportSettings.RepEditorReader);
    values[27] := BoolToStr(reportSettings.RepExternalReader);
    values[28] := BoolToStr(reportSettings.RepUserDefined);
    values[29] := BoolToStr(reportSettings.UseSignature);
    values[30] := BoolToStr(reportSettings.UseSignatureInText);
    values[31] := BoolToStr(reportSettings.SignatureHash <> '');
    values[32] := BoolToStr(reportSettings.SignatureSubject <> '');
    values[33] := '0';//BoolToStr(reportSettings.VariantName <> '');
    values[34] := '0';//IntToStr(reportSettings.PrinterIndex);
    values[35] := '0';//BoolToStr(reportSettings.PrinterName <> '');
    values[36] := EscapeValue(reportSettings.CMDShow);
    values[37] := EscapeValue(reportSettings.CMDPrint);
    values[38] := BoolToStr(reportSettings.PrintNalezato);
    values[39] := '0';//BoolToStr(reportSettings.FDFPrint);

    // Vytvoř výsledný řetězec ve formátu 201:nn.hodnota,nn.hodnota,... 201 se dá při volání
    Result := '';
    for i := 1 to 39 do
    begin
      Result := Result + Format('%d.%s', [i, values[i]]);
      if i < 39 then
        Result := Result + ',';
    end;
  except
  end;  
end;

