function TfaMain.LoadListToWT(const AListName: string; AForDate: TDateTime; AWtNumber: Integer): boolean;
var
  mtSrc, mtDst: TkbmMemTable;
  st: TMemoryStream;
  lBinForm:TkbmBinaryStreamFormat;
  i: integer;
begin
  Result := FAPublicUtils.GetMemTable(AListName,AForDate,mtSrc);
  if Result then begin
    case AWtNumber of
      1: mtDst:=wt1;
      2: mtDst:=wt2;
      3: mtDst:=wt3;
      4: mtDst:=wt4;
      5: mtDst:=wt5;
      6: mtDst:=wt6;
      7: mtDst:=wt7;
      8: mtDst:=wt8;
      9: mtDst:=wt9;
    end;
    //
    with mtDst do begin
      if Active then
        Close;
      DeleteTable;
      FieldDefs.Clear;
      for i := 0 to mtSrc.Fields.Count - 1 do
        Fields.Add(mtSrc.Fields[i]);
      Open;
      //
      lBinForm:=TkbmBinaryStreamFormat.Create(nil); //nevim, jestli je to v poradku, protoze wt maji nastaven kbmCSVStreamFormat
      mtSrc.DefaultFormat:=lBinForm;
      mtDst.DefaultFormat:=lBinForm;
      st:= TMemoryStream.Create;
      try
        mtSrc.SaveToStream(st);
        st.Seek(0, soFromBeginning);
        Edit;
        LoadFromStream(st);
      finally
        st.Free;
        FreeAndNil(lBinForm);
      end;
    end;
  end;
end;

procedure TfaMain.CreateWtFields(ATableNameCis: integer; const AFieldNames: string);
var
  i: integer;
  ro: boolean;
  sl, sl1: TStringList;
  fld: TField;
  mt: TkbmMemTable;
  s: string;
begin
  sl:=TStringList.Create;
  sl1:=TStringList.Create;
  if ATableNameCis=1 then mt:=wt1
  else if ATableNameCis=2 then mt:=wt2
  else if ATableNameCis=3 then mt:=wt3
  else if ATableNameCis=4 then mt:=wt4
  else if ATableNameCis=5 then mt:=wt5
  else if ATableNameCis=6 then mt:=wt6
  else if ATableNameCis=7 then mt:=wt7
  else if ATableNameCis=8 then mt:=wt8
  else if ATableNameCis=9 then mt:=wt9
  else Exit;

  s:=Replace(';',AFieldNames,#$D#$A);
  try
    with mt do begin
      if Active then
        Close;
      DeleteTable;
      FieldDefs.Clear;
      sl.Text := s;//AFieldNames;
      for i := 0 to sl.Count - 1 do begin
        sl1.CommaText := sl[i];
        FieldDefs.Add(sl1[0], TFieldType(StrToInt(sl1[1])),
          StrToInt(sl1[2]), FALSE);
        fld := FieldDefs.Items[i].CreateField(mtValues);
        with fld do begin
          if fld is TStringField then begin
            TStringField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
          end
          else if fld is TIntegerField then begin
            TIntegerField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TIntegerField(fld).DisplayFormat := sl1[4];
            TIntegerField(fld).EditFormat := sl1[5];
          end
          else if fld is TFloatField then begin
            TFloatField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TFloatField(fld).DisplayFormat := sl1[4];
            TFloatField(fld).EditFormat := sl1[5];
          end
          else if fld is TDateTimeField then begin
            TDateTimeField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TDateTimeField(fld).DisplayFormat := sl1[4];
          end
          else if fld is TCurrencyField then begin
            TCurrencyField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TCurrencyField(fld).DisplayFormat := sl1[4];
            TCurrencyField(fld).EditFormat := sl1[5];
          end;
        end;
      end;
      Open;
      //zapis indexu fieldu
      //22.2.18, Marek - zakazano z duvodu, ze stejne pojmenovane udaje v mtValues a wt
      //zpusobuji chyby ve skriptu
      {for i := 0 to FieldList.Count - 1 do begin
        if mtFields.FindKey([UpperCase(FieldList[i].FieldName)]) then begin
          mtFields.Edit;
          mtFieldsFieldIndex.Value := i;
          mtFields.Post;
        end;
      end;}
    end;
  finally
    sl1.Free;
    sl.Free;
  end;
end;

