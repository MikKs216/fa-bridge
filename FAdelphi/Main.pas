procedure TfaMain.DoEditNewForm(AClientID: integer; AID: integer;
  const ADefID: string; const AGUID: string;
  const AClientParams, ADatabaseCaption: string;
  AStoredStrings: TMemoryStream; const AFillMemo: string;
  const AReportVariants: string; const AData: string;
  const AAddedData: string; out MsgErr: string);
{$IFNDEF STANDALONE}
var
  lObj: TWinObj;
  loadingStartTime, loadingFinishTime: TDateTime;
{$ENDIF STANDALONE}
begin
  LogStat('N:'+GetFormKey(ADefID));
  StartWait;
  gFormOpening:=True;
  try
    {$IFNDEF STANDALONE}
    loadingStartTime := now;
    {$ENDIF STANDALONE}
    {SaveStringToFile(AClientParams,ExtractFilePath(Application.ExeName)+
      cFormAsistentExeName+cClientParDefaultExt);}
    FFillMemo := AFillMemo;
    SetReadOnly(FALSE);
    FDatabaseIDForm := AID;
    FDatabaseGuid := AGUID;
    {$IFNDEF STANDALONE}
    FDatabaseCaption := ADatabaseCaption;
    FStartTime := now;
    FLastModifiedTime := 0;
    {$ENDIF STANDALONE}
    FClientID := AClientID;
    SetFocusContent;
    FDataFileName := '';
    FReportVariants := AReportVariants;
    EmptyPage; {A}
    if (ADefID=FDefIDTextDocument)and(AData<>'') then begin //textovy vzor
      FClientParam.Text := AClientParams;
      LoadParamsFromClientParams;
      OpenFileDataString(AData);
      ApplyMainCaption(mtDefName.Value);
      FocusFirstControl;
      PostMessage(Self.Handle, WM_KEYDOWN, VK_NEXT, 0);
      ApplyMainCaption(mtDefName.Value);
      FFileOpened := TRUE;
      SetChangeFlag(TRUE);
      {$IFNDEF STANDALONE}
      if TRUE {not FNestedState} then begin
        if (AStoredStrings<>nil) and (AStoredStrings.Size > 0) and
          not FNestedPrepareReportState then
          mtStoredStrings.LoadFromStream(AStoredStrings)
        else begin
          mtStoredStrings.Close;
          mtStoredStrings.EmptyTable;
          mtStoredStrings.Open;
        end;
      end;
      {$ENDIF STANDALONE}
    end
    else begin
      if OpenFileDef(NormalPath(DirDefsPath) + ADefID + cDefDefaultExt) then begin
        CreateMtTskp(ADefID, AID, AGUID, '', mtDefGroup.Value, mtDefSubGroup.Value);
        InitTskpInfo;
        FClientParam.Text := AClientParams;
        ShowWarningPovinneEPO;
        {$IFNDEF STANDALONE}
        LoadParamsFromClientParams;
        {$ENDIF STANDALONE}
        ApplyMainCaption(mtDefName.Value);
        if AData <> '' then begin
          SetFormData(AData);
          DoOnOpen;
        end
        else begin
          GenMtValues(TRUE, TRUE);
          DoInit;
        end;
        ReloadListBoxes; //pri otevreni formulare musime aktualizovat list boxy na prvni strane, pokud tam jsou
        if AAddedData<>'' then
          SetAddedValuesData(AAddedData);
        DoCalculate;
        SetLiveCheck(True);
        DisplayCheck; //po otevreni
        ApplyMainCaption(mtDefName.Value);
        FFileOpened := TRUE;
        FocusFirstControl;
        {$IFNDEF STANDALONE}
        if TRUE {not FNestedState} then begin
          if (AStoredStrings<>nil) and (AStoredStrings.Size > 0) and
            not FNestedPrepareReportState then
            mtStoredStrings.LoadFromStream(AStoredStrings)
          else begin
            mtStoredStrings.Close;
            mtStoredStrings.EmptyTable;
            mtStoredStrings.Open;
          end;
        end;
        {$ENDIF STANDALONE}
      end
      else begin
        if FNeedVerNew then begin
          MessageInfo(Caption, sMsgNeedVer, [MBOK]);
          CloseForm;
        end
        else
          MessageErr(Caption, Format(sDataDefErrOpen,
            [ExtractFileName(ADefID)]), [MBOK]);
      end;
    end;
    //
    {$IFNDEF STANDALONE}
    if FShowLoadingWindow<>1 then begin
      //vytvoreni ikony v outlookbaru
      lObj := TWinObj.Create;
      lObj.Window := self;
      lObj.WindowIcon := 1;
      lObj.WindowText := FDatabaseCaption;
      lObj.WindowIconText := Copy(FDatabaseCaption, 1, Max(1,
        Pos(' ', FDatabaseCaption)));
      dmGlobObj.gFAllWindow.AddObj(lObj);
      Application.MainForm.Perform(Msg_UpdateListWindow, 1, 0);
    end;
    FSaveHistoryToDB := FALSE;
    {$ENDIF STANDALONE}
  finally
    StopWait;
    {$IFNDEF STANDALONE}
    loadingFinishTime := now;    
    dmGlobObj.FrmTimesAdd(loadingFinishTime-loadingStartTime);
    {$ENDIF STANDALONE}
    gFormOpening:=False;
  end;
end; {DoEditNewForm}

