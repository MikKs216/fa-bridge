procedure TfaMain.PasteExecute(Sender: TObject);
var
  clpValue, oldStr, newEditText: string;
  numVal: double;
begin
  if not FIsDesignMode and (ActiveControl<>reComment) and
    (FActuallyControl <> nil) and (CEdit.Parent <> sbBackGround) and
    ((FActuallyControl.Name = CEdit.Hint) or (FActuallyControl = CEdit)) then begin
    clpValue:=Clipboard.AsText;
    oldStr:=CEdit.EditingText;
    newEditText:='';
    if Pos('!', CEdit.DisplayFormat) > 0 then begin //nedovoluje psani do udaje, jen vyber ze seznamu
      Exit;
    end;
    if ((CEdit.FldType = fldtNumber) or (CEdit.FldType = fldtCurrency)) then begin
      clpValue:=Replace(ThousandSeparator,clpValue,'');
      clpValue:=Replace(',',clpValue,cFADecimalSeparator);
      clpValue:=Replace(#13,clpValue,'');
      clpValue:=Replace(#10,clpValue,'');
      clpValue:=Replace(' ',clpValue,'');
      if IsFloat(clpValue) then begin
        numVal := FCommonUtils.StrToFloatSafe(clpValue);
        if (CEdit.FldTypeDecimalPlaces = 0) then
          newEditText := FloatToStr(RoundAri(numVal, 0))
        else
          newEditText := FloatToStr(numVal);
      end;
    end
    else if (CEdit.FldType = fldtDate) then begin
      if IsDate(clpValue) then
        newEditText := DateToStr(StrToDateSafe(clpValue));
    end
    else begin
      //newEditText := Replace(cCRLF,clpValue,'');
      PostMessage(ActiveControl.Handle, WM_PASTE, 0, 0);
    end;

    if newEditText<>oldStr then begin
      if CEdit.SelText<>'' then
        newEditText:=Copy(oldStr,1,CEdit.SelStart)+newEditText+
          Copy(oldStr,CEdit.SelStart+1+CEdit.SelLength,maxint)
      else
        newEditText:=Copy(oldStr,1,CEdit.CursorPos)+newEditText+
          Copy(oldStr,CEdit.CursorPos+1,maxint);
      CEdit.EditingText := newEditText;
      FEditWasModified := TRUE;
    end;
  end
  else if ActiveControl<>nil then
    PostMessage(ActiveControl.Handle, WM_PASTE, 0, 0);
end;

procedure TfaMain.CopyExecute;
begin
  if not FIsDesignMode and (ActiveControl<>reComment) and
    (FActuallyControl <> nil) and (CEdit.Parent <> sbBackGround) and
