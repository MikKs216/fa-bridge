procedure TfaMain.SetMaxContentKey;
var
  bm: TBookmarkStr;
  isLoadingContent: boolean;
begin
  StartWait;
  mtContent.DisableControls;
  bm := mtContent.Bookmark;
  isLoadingContent := FIsLoadingContent;
  FIsLoadingContent := TRUE;
  FMaxContentKey := 0;
  mtContent.First;
  try
    with mtContent do
      while not EOF do begin
        if (mtContentKey.Value > FMaxContentKey) and (mtContentKey.Value <
          cTopUserContentKey) then
          FMaxContentKey := mtContentKey.Value;
        Next;
      end;
  finally
    mtContent.Bookmark := bm;
    mtContent.EnableControls;
    FIsLoadingContent := isLoadingContent;
    StopWait;
  end;
end; {SetMaxContentKey}

