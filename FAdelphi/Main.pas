function TfaMain.mtWorkSaveToString: string;
var
  wasActive: boolean;
  st: TMemoryStream;
  sl: TStringList;
begin
  Result:='';
  with mtWork do begin
    wasActive:=Active;
    if not wasActive then
      Open;
    sl:= TStringList.Create;
    st:= TMemoryStream.Create;
    try
      mtWork.SaveToStream(st);
      st.Seek(0, soFromBeginning);
      sl.LoadFromStream(st);
      Result:=sl.Text;
    finally
      if not wasActive then
        Close;
      st.Free;
    end;
  end;
end;

procedure TfaMain.mtWorkLoadFromString(str: string);
var
  wasActive: boolean;
  st: TMemoryStream;
  sl: TStringList;
begin
  with mtWork do begin
    wasActive:=Active;
    if not wasActive then
      Open;
    sl:= TStringList.Create;
    st:= TMemoryStream.Create;
    try
      sl.Text:=str;
      sl.SaveToStream(st);
      st.Seek(0, soFromBeginning);
      mtWork.LoadFromStream(st);
    finally
      if not wasActive then
        Close;
      st.Free;
      sl.Free;
    end;
  end;
end;

