procedure TfaMain.RenderPage;
const
  cBorderSize = 0;//2;
  cFrameSize = 0;//4;
var size_x,size_y:integer;
  pageWidth,pageHeight, m, m1, m2:double;
  logpx,logpy:double;
  viewx,viewy,posunx,posuny:integer;

begin
  if FCurrPage>=0 then begin
    FIsRendering:=TRUE;
    try
      logpx := 96; //GetDeviceCaps(PaintBox.Canvas.Handle, LOGPIXELSX); //formular se nezvetsuje podle fontu tak nezvetsujeme ani paintbox, vnutime velikost jako u malych fontu
      logpy := 96; //GetDeviceCaps(PaintBox.Canvas.Handle, LOGPIXELSY);
      pageWidth := FPDF_GetPageWidth(FPageList[FCurrPage]);
      pageHeight := FPDF_GetPageHeight(FPageList[FCurrPage]);
      size_x := Round((pageWidth / 72) * logpx);
      size_y := Round((pageHeight / 72) * logpy);
      if FPageZoom=100 then begin //originalni velikost
        PaintBox.Width:=size_x + cBorderSize*2;
        PaintBox.Height:=size_y + cBorderSize*2;
      end
      else if FPageZoom>1 then begin //zvetseni/zmenseni
        PaintBox.Width:=Round((size_x*FPageZoom) / 100) + cBorderSize*2;
        PaintBox.Height:=Round((size_y*FPageZoom) / 100) + cBorderSize*2;
      end
      else if FPageZoom=1 then begin // fitWidth
        PaintBox.Width:=sbForm.Width - cBorderSize*2 - cFrameSize*2 -16;
        PaintBox.Height:=Round(PaintBox.Width*size_y/size_x);
      end
      else if FPageZoom=0 then begin //fitPage
        m1:=size_x/(sbForm.Width-cBorderSize*2-cFrameSize*2);
        m2:=size_y/(sbForm.Height-cBorderSize*2-cFrameSize*2);
        m:=Max(m1,m2);
        PaintBox.Width:=Round(size_x/m);
        PaintBox.Height:=Round(size_y/m);
      end;
      {RenderPaintBox;}
      FPDF_RenderPage(PaintBox.Canvas.Handle,FPageList[FCurrPage],
        0,0,PaintBox.Width,PaintBox.Height,0,0);
    finally
      FIsRendering:=FALSE;
    end;
  end;
end;

