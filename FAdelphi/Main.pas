//Kdyz uzivatel vybere email vraci email nebo jen zavinac, kdyz nebyl mail na vyber
//Kdyz vybere DS vraci IDDS
function TfaMain.SelectEmail(out AAdr: string; AOnlyEmail: Boolean = False;
  AShowBtnSave: boolean = false; ADefBtnSave: Boolean = false): boolean;
var
  s, nazev: string;
  isds, ok: boolean;
  sa: TSelAdresChoices;
  stdMail, stdDS, stdSave, doPDF: boolean;
  stdRes: Integer;
  fidds,femail,fnazev: string;
  defBtn: TDefAdresChoices;
begin
  AAdr := '';
  FPdfPassword := '';
  if ADefBtnSave then
    defBtn:=dDisk
  else
    defBtn:=dAuto;

  if FLocalVersion = cLocalVersionSK then begin
    {$IFNDEF STANDALONE}
    GetIDDSForDSFilling(fidds,femail,fnazev);
    if SelKlientAdresy(FClientID, SSelectEmail,
      'Description,Email,Name,LastName,City,Street', s, saOnlyEmails, '', AShowBtnSave,
      fnazev,fidds,femail,defBtn) then begin
      Result := true;
      doPDF := StrToBool(GetStringLineValue(s,'DoPDFPswd')); //heslovat?
      if doPDF then
        FPdfPassword := GetStringLineValue(s,'PDFPswd'); //heslo
      if Pos('SaveToDisk=-1',s)>0 then begin
        AAdr:=cSaveToDisk;
        Exit;
      end;
      AAdr := GetStringLineValue(s,'Email');
    end
    else
    {$ELSE STANDALONE}
      Result := false;
    {$ENDIF STANDALONE}
  end
  else begin
    {$IFNDEF STANDALONE}
    if AOnlyEmail then
      sa := saOnlyEmails
    else
      sa := saOnlyEmailsDS;
    GetIDDSForDSFilling(fidds,femail,fnazev);
    if SelKlientAdresy(FClientID, SSelectEmail,
      'Description,Email,IdDS,Name,LastName,City,Street', s, sa, '', AShowBtnSave,
      fnazev,fidds,femail,defBtn) then begin
      Result := True;
      //zjistit heslo pro PDF
      doPDF := StrToBool(GetStringLineValue(s,'DoPDFPswd')); //heslovat?
      if doPDF then
        FPdfPassword := GetStringLineValue(s,'PDFPswd'); //heslo
      //
      if Pos('SaveToDisk=-1',s)>0 then begin
        AAdr:='SAVETODISK';
        Exit;
      end;
      isds :=  StrToBoolSafe(GetStringLineValue(s,'ISDS'));
      if isds then begin
        nazev:=Trim(Trim(GetStringLineValue(s,'Name')+' '+
          GetStringLineValue(s,'LastName'))+' '+GetStringLineValue(s,'City'));
        AAdr := cIDDS + GetStringLineValue(s,'IDDS')+'#'+nazev;
      end
      else
        AAdr := GetStringLineValue(s,'Email');
    end
    else
      Result := false;
    {$ELSE STANDALONE}
    stdMail:=True;
    if AOnlyEmail then
      stdDS:=False
    else
      stdDS:=True;
    stdRes:=SelectAdr('Vyberte způsob odeslání souboru',stdMail,stdDS,AShowBtnSave,FClientParam.Values['PDFPswd']);
    Result:=True;
    if stdRes=0 then
      Result:=False
    else if stdRes=1 then
      AAdr := FClientParam.Values['Email']
    else if stdRes=2 then
      AAdr := cIDDS
    else if stdRes=3 then
      AAdr:=cSaveToDisk
    {$ENDIF STANDALONE}
  end;
end;

