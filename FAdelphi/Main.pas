    end;
  end;
end; {SaveStateFormToIni}

procedure TfaMain.LoadFormStateFromIni;

  //PositionFrmCheck
  //  Osetreni otevreni okna mimo plochu win
  procedure PositionFrmCheck(var ALeft, ATop: integer);
  var
    w, h: integer;
  begin
    w := GetSystemMetrics(SM_CXVIRTUALSCREEN);
    h := GetSystemMetrics(SM_CYVIRTUALSCREEN);
    //ShowMessage('w:'+IntToStr(w)+' ,h:'+IntToStr(h)+#13+'left:'+IntToStr(ALeft)+' ,Top:'+IntToStr(ATop));

    if ALeft+Self.Width-200<0 then
      ALeft := 0
    else if ALeft+200>w then
      ALeft := 0;

    if ATop<0 then
      ATop := 0
    else if ATop+100>h then
      ATop := 0;
  end;

  {$IFDEF STANDALONE}
  procedure InitSkin(const ASkinName: string);
  const
    coDefaultOldSkinName = 'Caramel';//'Blue';
  begin
    if ASkinName<>'' then begin
      dmFA.dxSkinController1.BeginUpdate;
      dmFA.dxSkinController1.UseSkins := TRUE;
      dmFA.dxSkinController1.NativeStyle:=False;
      dmFA.dxSkinController1.SkinName := ASkinName;//'Caramel';
      dmFA.dxSkinController1.EndUpdate;

      BarManager.LookAndFeel.SkinName := ASkinName;
      BarManager.LookAndFeel.NativeStyle := False;
      //BarManager.LookAndFeel.Kind
      BarManager.Style:=bmsUseLookAndFeel;//bmsOffice11;
    end
    else begin
      with dmFA do begin
        dxSkinController1.BeginUpdate();
        dxSkinController1.UseSkins := False;
        dxSkinController1.NativeStyle:=False;
        dxSkinController1.SkinName := coDefaultOldSkinName;
        dxSkinController1.EndUpdate();

        BarManager.LookAndFeel.SkinName := coDefaultOldSkinName;
        BarManager.LookAndFeel.NativeStyle := True;
        BarManager.Style:=bmsUseLookAndFeel;
      end;
    end;
  end;
  {$ENDIF STANDALONE}

var
  iniFile: TMemIniFile;
  l, t: integer;
  recWndPlmt:TWindowPlacement;
begin
{$IFNDEF STANDALONE}
  if WindowState <> wsNormal then EXIT;
{$ENDIF STANDALONE}
  iniFile := TMemIniFile.Create(GetIniFileName);
  try
{$IFDEF STANDALONE}
    l := iniFile.ReadInteger(Name, 'Left', 0);
    InitSkin(iniFile.ReadString('SKIN', 'SkinName', ''));
    t := iniFile.ReadInteger(Name, 'Top', 0);
    PositionFrmCheck(l, t);
    Left := l;
    Top := t;
{$ELSE STANDALONE}
    {presunuto do OnShow
    l := iniFile.ReadInteger(Name, 'Left', 62);
    t := iniFile.ReadInteger(Name, 'Top', 0);
    GetTopLeftOnPrimary(GMultimonitor,Rect(l,t,l+Self.Width,t+self.Height),t,l);

    recWndPlmt.length:=SizeOf(TWindowPlacement); // toto se musi pouzit misto prirazeni Top a Left - chyba Delphi pri nastavovani u vice monitoru
    recWndPlmt.rcNormalPosition.Top := t;
    recWndPlmt.rcNormalPosition.Left := l;
    recWndPlmt.rcNormalPosition.Bottom := t+self.Height;
    recWndPlmt.rcNormalPosition.Right := l+Self.Width;
    recWndPlmt.showCMD := SW_NORMAL;
    SetWindowPlacement(Self.Handle, @recWndPlmt);
    }
{$ENDIF STANDALONE}

    Width := iniFile.ReadInteger(Name, 'Width', cDefaultWidth);
    if Screen.Height <= 600 then begin
{$IFDEF STANDALONE}
      Height := iniFile.ReadInteger(Name, 'Height',
        Min(cDefaultHeight, Screen.Height - 30));
{$ELSE STANDALONE}
      if Application.MainForm <> nil then
        Height := iniFile.ReadInteger(Name, 'Height',
          Application.MainForm.Height)
      else
        Height := iniFile.ReadInteger(Name, 'Height',
          Min(cDefaultHeight, Screen.Height - 30));
{$ENDIF STANDALONE}
      paBottom.Height := 0;
    end
    else begin
      if FShowRibbon then
        Height := iniFile.ReadInteger(Name, 'Height', cDefaultHeight+dxRibbon.Height-50)
      else
        Height := iniFile.ReadInteger(Name, 'Height', cDefaultHeight);

      paBottom.Height := iniFile.ReadInteger(Name, 'PaBottomHeight', cDefaultBottomPanelsHeight);
      if paMain.Height<200 then
        paBottom.Height:=54;
    end;
    //kdyz je zapamatovana velmi mala velikost (po zobrazeni nested), tak nastavit standardni
    if Height<100 then
      SetDefaultView;
    //
    paLeft.Width := iniFile.ReadInteger(Name, 'PaLeftWidth', cDefaultPaLeftWidth);
    if paLeft.Width = paLeft.Constraints.MinWidth then
      FPaLeftWidth := cDefaultPaLeftWidth
    else
      FPaLeftWidth := paLeft.Width;
    FPaLeftWidthRun := FPaLeftWidth;
    paComment.Height := iniFile.ReadInteger(Name, 'paCommentHeight',
      cDefaultBottomPanelsHeight);
    //
    dxBarButtonSaveDefAlways.Down := iniFile.ReadBool(Name, 'SaveDefAlways',
      FALSE);
    //
    FDefFileName := iniFile.ReadString(Name, 'LastFileDef', '');
    dxBarSpellCheck.Down := iniFile.ReadBool(Name, 'SpellChecking', FALSE);
    FSpellCheckDictFileName :=
      iniFile.ReadString(Name, 'SpellCheckDictFileName', '');

    if FShowRibbon then
      BarManagerBar4.DockingStyle:=dsLeft
    else
      BarManagerBar4.DockingStyle:=dsTop;

    tbZoom.Position := iniFile.ReadInteger(Name, 'ZoomPosition', cZoomOriginal);
    FLastNotesZoom := iniFile.ReadInteger(Name, 'NotesZoomPercent', 100);
    reNotes.ViewProperty.ZoomPercent:=FLastNotesZoom;

    paInfo.Visible := iniFile.ReadBool(Name, 'PaInfoVisible', true);
    paCheck.Visible := iniFile.ReadBool(Name, 'PaCheckVisible', true);
    GrCheckSetStyle(iniFile.ReadBool(Name, 'PaCheckAutoHeight', false));

    InitPaBottom(paInfo.Visible, paCheck.Visible, false);
  finally
    iniFile.Free;
  end;
end; {LoadFormStateFromIni}

