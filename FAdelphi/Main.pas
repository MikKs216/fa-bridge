function TfaMain.GetElFilling: string;
var
  fillingDoc: string;

  function UpravFU(const AStr: string): string;
  var
    sl: TStringList;
    i: integer;
    cis: string;
    c: integer;
  begin
    sl:= TStringList.Create;
    try
      sl.Text:=AStr;
      for i:=0 to sl.Count-1 do begin
        cis:='';
        if Pos('c_ufo=',sl[i])>0 then begin
          cis:=Copy(Replace(' ',Replace('"',sl[i],''),''),7,maxint);
          c:=StrToIntSafe(cis);
          if (c>999) then begin
            cis:=VarToStr(LstLookup('FU13',Date,'CisloFU',cis,'C_Ufo'));
            sl[i]:='c_ufo="'+cis+'"';
          end
          else if ((c<451) or (c>464)) and (c<>13) then begin
            cis:=VarToStr(LstLookup('FU13',Date,'CisloFUPuv',cis,'C_Ufo'));
            sl[i]:='c_ufo="'+cis+'"';
          end
        end
        else if Pos('c_ufo_cil=',sl[i])>0 then begin
          cis:=Copy(Replace(' ',Replace('"',sl[i],''),''),11,maxint);
          c:=StrToIntSafe(cis);
          if (c>999) then begin
            cis:=VarToStr(LstLookup('FU13',Date,'CisloFU',cis,'C_Ufo'));
            sl[i]:='c_ufo_cil="'+cis+'"';
          end
          else if ((c<451) or (c>464)) and (c<>13) and (c<>0) then begin
            cis:=VarToStr(LstLookup('FU13',Date,'CisloFUPuv',cis,'C_Ufo'));
            sl[i]:='c_ufo_cil="'+cis+'"';
          end
        end;
      end;
      Result:=sl.Text;
    finally
      sl.Free;
    end;
  end;

begin
  StartWait;
  try
    FScriptState := ssElFilling;
    try
      FScriptFillingZip := FALSE;
      if FNewScripter then
        fillingDoc := ScripterT_ExecuteSubRoutine(sScriptProcName_ElFilling)
      else
        fillingDoc := Scripter.CallNoParamsMethod(sScriptProcName_ElFilling);

      //automaticka oprava pro stare formulare pred zmenou FU, novych se nedotkne  
      fillingDoc := UpravFU(FillingDoc);

      if (Pos('<?xml',fillingDoc)>0) and (Pos('encoding="windows-1250"',LowerCase(fillingDoc))>0) then begin
        StrReplace(fillingDoc,'encoding="windows-1250"','encoding="UTF-8"',[rfIgnoreCase]);
        Result:=AnsiToUTF8(fillingDoc);
      end
      else
        Result:=fillingDoc;
    finally
      FScriptState := ssNoActive;
    end;
  finally
    StopWait;
  end;
end; {GetElFilling}

function TfaMain.SendFillingDS: boolean;
var
  typDoc, doc: string;
  p: integer;

  procedure SaveFillingInfoAndForm;
  begin
    mtTskp.Edit;
    mtTskpFillingTimeStampSignature.Value:=cDSfilled+':'+gLastSentIDDS;
    mtTskpFillingDate.Value:=gLastSentDateDS;
    mtTskpFillingNumber.Value:='';
    mtTskpFillingPassword.Value:='';
    mtTskp.Post;
    SaveFormWithoutCheck;
    //MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání a formulář byl uložen.',MB_OK);
    ShowHintSb('Byly zapsány informace o podání a formulář byl uložen.');
  end;
begin
  Result:=false;
  if not FFileOpened then
    EXIT;
  if ShowChecking then
    EXIT;
  if FStateFormWasChanged then begin
    DoCalculate;
    TryPostMtValues;
  end;
{$IFNDEF ELPODANITEST}
{$IFDEF FINALBUILD}
  if not IsLicenceForDefOk then
    MessageInfo(Caption, sMsgDisableElFillingLic, [MBOK])
  else
  {$ENDIF FINALBUILD}
{$ENDIF ELPODANITEST}
  begin
    doc := GetElFilling;
    if (Length(doc)=0) then begin
      MessageInfo(Caption,'Obsah podání je prázdný, podání se nevytvoří.',[MBOK]);
      EXIT;
    end
    else if Copy(doc,1,2)='-1' then // kdyz nechceme zobrazovat hlaseni zde - osetri si programator formulare
      Exit;
    //CSSZ
    if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PVS:>') then begin
      if SendPVSDSElFilling(doc,mtDefName.AsString) then begin
        SaveFillingInfoAndForm;
        Result:=true;
      end;
    end
    //ZP
    else
    if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PZP:>') then begin
      MessageErr(Caption,'Formulář nelze elektronicky podat přes datovou schránku. Můžete jej podat funkcí "Podat elektronicky" nebo poslat v PDF do datové schránky.',[MBOK]);
    end
    //MF
    else begin
      if (Copy(UpperCase(doc),1,5)='<?XML') then begin
        if SendDSElFilling(doc,mtDefName.AsString) then begin
          SaveFillingInfoAndForm;
          Result:=true;
        end;
      end
      else
        MessageErr(Caption,'Chyba definice předlohy: "function Fillig; invalid XML ('+
          Copy(doc,1,40)+'...)". Proveďte aktualizaci formulářů.',[MBOK]);
    end;
  end;
end;

