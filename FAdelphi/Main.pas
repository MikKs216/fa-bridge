  if mtFields.Active and (AFldsList <> '') then
    for i := 0 to CountListItems(AFldsList) - 1 do begin
      fldName := GetListItem(AFldsList, i);
      if mtFields.FindKey([UpperCase(fldName)])
        {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
        [loCaseInsensitive])}and
        mtFieldsHasEnabling.Value then begin
        mtFields.Edit;
        mtFieldsIsSetForEnabling.Value := FALSE;
        mtFields.Post;
      end;
    end;
end; {SetEnablingsForFlds}

procedure TfaMain.SetEnablingsForAllFlds(AEnable: boolean);
var
  i: integer;
  fldName: string;
begin
  Assert(mtFields.Active, 'mtFields neni active v SetEnablingsForAllFlds');
  if mtFields.Active then begin
    mtFields.First;
    while not mtFields.EOF do begin
      if mtFieldsHasEnabling.Value then begin
