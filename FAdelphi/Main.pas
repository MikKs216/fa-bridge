end;

function TfaMain.UpravPDS(pds: string; out usedFields: string): string;
var
  s,c: string;
  sl: TStringList;
  i: integer;
begin
  sl:=TStringList.Create;
  sl.Text:=pds;
  try
    s:='';
    usedFields:='';
    for i:=0 to sl.Count-1 do begin
      c:=Copy(Trim(sl[i]),1,1);
      if (c='#') or (c='&') or (c='$') or (c='@') then
        s:=s+sl[i]+#13#10;
      if (c='@') then
        usedFields:=usedFields+#13#10+Copy(Trim(sl[i]),2,Pos('=',Trim(sl[i]))-2);
    end;
    Result:=s;
  finally
    sl.Free;
  end;
end;

function TfaMain.GenerujPDSString(const usedFields: string): string;
var
  i,pg, contentKey, imgWidth, imgHeight, pdfWidth, pdfHeight: integer;
  x,y: string;
  c: TControl;
  s,r,frmt,prokl,fs,hideChar, params: string;
  sl: TStringList;

  logpx, pageWidth: double;
  size_x: integer;
  logpy, pageHeight: double;
  size_y: integer;
begin
  s:='';
  pdfWidth:=595;
  pdfHeight:=842;
{  if mtDefVersion.Value<>'' then begin // rozmer pdf sestavy sirka, vyska
    if CountListItems(mtDefVersion.Value)=2 then begin
      pdfWidth:=GetListItem(mtDefVersion.Value,0);
      pdfHeight:=GetListItem(mtDefVersion.Value,1);
    end
    else
      MessageWarn(Caption,'ChybnÄ› zapsanĂ˝ rozmÄ›r PDF v definici formulĂˇĹ™e (ĹˇĂ­Ĺ™ka,vĂ˝Ĺˇka)',[MBOK]);
  end;
  }
  contentKey:=mtContentKey.Value;
  mtContent.DisableControls;
  if IsPaintBoxReadyForUse then begin
    imgWidth:=PaintBox.Width;
    imgHeight:=PaintBox.Height;
  end
  else begin
    imgWidth:=mtContentImageWidth.Value;
    imgHeight:=mtContentImageHeight.Value;
  end;
  sl:=TStringList.Create;
  sl.Text:=usedFields;
  try
    mtContent.First;
    pg:=0;
    while not mtContent.EOF do begin
      sbForm.HorzScrollBar.Position:=0; //jinak se obrazek vystredi a pak zapise spatne souradnice do PDS
      //----- strana formulare -----------
      pg:=pg+1;
      if mtContentPage.Value<990 then begin
        for i := 0 to sbForm.ControlCount - 1 do begin
          c := sbForm.Controls[i];
          r:='';
          fs:='';

          // format v PDS: udaj=strana,x,y[,format,velikost_fontu,vzdalenost_prokladani]

          //----- edit -----------
          if c is TfaEdit then begin
            frmt:='';
            prokl:='';
            if (TfaEdit(c).FldType=fldtString)or
              (TfaEdit(c).FldType=fldtNumber)or
              (TfaEdit(c).FldType=fldtCurrency) then begin
              if TfaEdit(c).RepAlignment=taRightJustify then
                frmt:=frmt+'R';
              if TfaEdit(c).RepNoThousandSep then
                frmt:=frmt+'T';
              if TfaEdit(c).InterlaceCount>0 then
                frmt:=frmt+IntToStr(TfaEdit(c).InterlaceCount);
              if TfaEdit(c).HideChar<>'' then
                frmt:=frmt+cHideCharSymbol+TfaEdit(c).HideChar;
            end
            else if (TfaEdit(c).FldType=fldtDate) then begin
              if TfaEdit(c).InterlaceCount>0 then
                frmt:='|';
              if TfaEdit(c).DisplayFormat<>'' then
                frmt:=frmt+LowerCase(TfaEdit(c).DisplayFormat);
              if TfaEdit(c).HideChar<>'' then
                frmt:=frmt+cHideCharSymbol+TfaEdit(c).HideChar;
            end;

            if (TfaEdit(c).InterlaceCount>0) and (TfaEdit(c).InterlaceSizeRep>0) then
              prokl:=Replace(',',FloatToStr(TfaEdit(c).InterlaceSizeRep),'.');
            if TfaEdit(c).RepFontSize>0 then
              fs:=FloatToStr(TfaEdit(c).RepFontSize);

            if (frmt='')and(prokl='')and(fs='') then
              params:=''
            else
              params:=','+frmt+','+fs+','+prokl;

            if TfaEdit(c).RepAlignment=taRightJustify then begin
              if TfaEdit(c).RepPosX=0 then
                x:=FloatToStr(RoundAri((TfaEdit(c).Left+TfaEdit(c).Width)*
                  pdfWidth/imgWidth,0))
              else
                x:=FloatToStr(TfaEdit(c).RepPosX);
            end
            else begin
              if TfaEdit(c).RepPosX=0 then
                x:=FloatToStr(RoundAri(TfaEdit(c).Left*pdfWidth/imgWidth+1,0))
              else
                x:=FloatToStr(TfaEdit(c).RepPosX);
            end;

            if TfaEdit(c).RepPosY=0 then
              y:=FloatToStr(RoundAri((imgHeight-TfaEdit(c).Top-TfaEdit(c).Height)*
                pdfHeight/imgHeight+3,0))
            else
              y:=FloatToStr(TfaEdit(c).RepPosY);

            if not TfaEdit(c).RepHide and (sl.IndexOf(TfaEdit(c).Name)=-1) then
              r:=TfaEdit(c).Name+'='+IntToStr(pg)+','+ // strana
                x+','+y+params;
          end                              //----- checkbox -----------
          else if c is TCxDBCheckBoxEx then begin
            if TCxDBCheckBoxEx(c).RepFontSize>0 then
              fs:=FloatToStr(TCxDBCheckBoxEx(c).RepFontSize);
            if (TcxDBCheckBoxEx(c).RepTrueText<>'') or (TcxDBCheckBoxEx(c).RepFalseText<>'') then
              frmt:=TcxDBCheckBoxEx(c).RepTrueText+'#'+TcxDBCheckBoxEx(c).RepFalseText
            else
              frmt:='X#';
            if not TCxDBCheckBoxEx(c).RepHide then begin
              if TCxDBCheckBoxEx(c).RepPosX=0 then
                x:=FloatToStr(RoundAri(TCxDBCheckBoxEx(c).Left*pdfWidth/imgWidth+4,0))
              else
                x:=FloatToStr(TCxDBCheckBoxEx(c).RepPosX);
              if TCxDBCheckBoxEx(c).RepPosY=0 then
                y:=FloatToStr(RoundAri((imgHeight-TCxDBCheckBoxEx(c).Top-TCxDBCheckBoxEx(c).Height)*
                  pdfHeight/imgHeight+6,0))
              else
                y:=FloatToStr(TCxDBCheckBoxEx(c).RepPosY);
              r:=TCxDBCheckBoxEx(c).Name+'='+IntToStr(pg)+','+x+','+y+','+frmt+','+fs;
            end;
          end
          //----- memo -----------
          else if c is TCxDBMemoEx then begin
            if TCxDBMemoEx(c).RepFontSize>0 then
              fs:=FloatToStr(TCxDBMemoEx(c).RepFontSize);
            frmt:='M'+ FloatToStr(RoundAri(TCxDBMemoEx(c).Width*pdfWidth/imgWidth-2,0));
            if TCxDBMemoEx(c).RepRowHeight>0 then
              frmt:=frmt+';'+FloatToStr(TCxDBMemoEx(c).RepRowHeight);
            if TCxDBMemoEx(c).RepOffsetFirstRow>0 then
              frmt:=frmt+';'+FloatToStr(TCxDBMemoEx(c).RepOffsetFirstRow);
            if not TCxDBMemoEx(c).RepHide then begin
              if TCxDBMemoEx(c).RepPosX=0 then
                x:=FloatToStr(RoundAri(TCxDBMemoEx(c).Left*pdfWidth/imgWidth+3,0))
              else
                x:=FloatToStr(TCxDBMemoEx(c).RepPosX);
              if TCxDBMemoEx(c).RepPosY=0 then
                y:=FloatToStr(RoundAri((imgHeight-TCxDBMemoEx(c).Top)*
                  pdfHeight/imgHeight-10,0))
              else
                y:=FloatToStr(TCxDBMemoEx(c).RepPosY);

              r:=TCxDBMemoEx(c).Name+'='+IntToStr(pg)+','+x+','+y+','+frmt+','+fs;
            end;
          end;    
          //----------------

          if r<>'' then
            s:=s+r+#13#10;
        end;
      end;
      //----- strana formulare -----------
      mtContent.Next;
      s:=s+#13#10;
    end;
  finally
    sl.Free;
    mtContent.Locate(mtContentKey.FieldName,contentKey, []);
    mtContent.EnableControls;
  end;
  Result:=s;
end;
{$ENDIF FINALBUILD}

