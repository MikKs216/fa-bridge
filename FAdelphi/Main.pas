procedure TfaMain.DesignerActiveChanging(Sender: TObject;
  var AllowChange: Boolean);
var
  duplicateEditName: string;
  contentKey: integer;
begin
  if Designer.Active then begin //ukonceni kresleni
    DisconnectMtValues;
    if mtContentPage.Value < cTopUserContentKey then begin
      AllowChange := CheckUniqueFieldsDef(sbForm, duplicateEditName, contentKey);
      if not AllowChange then
        MessageErr(Caption,
          Format('Název %s je už použitý na jiné straně (key=%d). Zvolte jiné jméno',
          [duplicateEditName, contentKey]), [MBOK]);
    end;
    cxContent.BringToFront;
      //pro obejiti chyby AV v mrizce pri aktivnim designeru

    if (mtContentImageHeight.Value>0) or (IsPaintBoxReadyForUse) then //je na pozadi obrazek, tak nastavime natvrdo font Courier
      SetControlsFont;
  end
  else
    cxContent.SendToBack; //pro obejiti chyby AV v mrizce pri aktivnim designeru
  if AllowChange then
    if Designer.Active then
      ShowClientBorder
    else begin
      FocusControl(nil); //kvuli divne chybe "Control '' has no parent window"
      HideClientBorder; //  ktera nastava, kdyz je focus na cxContent
      HideEdit;
      if (GetKeyState(VK_CONTROL) < 0) then
        Designer.AllowedActions := Designer.AllowedActions - [atMove]
      else
        Designer.AllowedActions := Designer.AllowedActions + [atMove];      
    end;
end;{DesignerActiveChanging}

