 SetLockFlag
   Nastavi priznak zamceneho formulare
 Vstup: ALocked ... zda je formular zamceny
 -----------------------------------------------------------------------------}

procedure TfaMain.SetLockFlag(ALock: boolean);
var
  ro: boolean;
begin
  if ALock <> FStateFormLocked then begin
    FStateFormLocked := ALock;
    ro := mtValues.ReadOnly;
    mtValues.ReadOnly := FALSE; // kvuli spravnemu nastaveni changeflagu
    try
      SetChangeFlag(TRUE);
    finally
      mtValues.ReadOnly := ro;
    end;
    SetReadOnly(ALock);
  end;
  if FStateFormLocked then begin
    mxStatusBar1.Panels[3].ImageIndex := cIndexLockPicture;
    if FStateFormReadOnlyLAN then
      mxStatusBar1.Panels[3].Hint := sSbHintReadOnly
    else
      mxStatusBar1.Panels[3].Hint := sSbFormLocked;
  end
  else begin
    mxStatusBar1.Panels[3].ImageIndex := -1;
    mxStatusBar1.Panels[3].Hint := '';
    ShowHintSb('');
  end;
end; {SetLockFlag}

function TfaMain.GetLockFlag: boolean;
begin
  Result := FStateFormLocked;
end; {GetLockFlag}

function TfaMain.LoadContent(const AFileName: string): boolean;
begin
  StartWait;
  FLastContentKey := -1;
  FIsLoadingContent := TRUE;
  mtContent.DisableControls;
  try
    mtContent.DefaultFormat := mtSaveFormat;
    Result := LoadMtFromZip(mtContent, FDefFileName, dpsw);
    if Result then
      SetMaxContentKey;
    UpdateTreeViewContent;
    mtContent.First;
  finally
    mtContent.EnableControls;
    FIsLoadingContent := FALSE;
    StopWait;
  end;
end; {LoadContent}

function TfaMain.LoadFields(const AFileName: string): boolean;
begin
  StartWait;
  try
    mtFields.DisableControls; //ma zustat trvale vypnute
    DisconnectMtValues;
    mtFields.DefaultFormat := mtPrgTablesFormat;
    Result := LoadMtFromZip(mtFields, FDefFileName, dpsw);
  finally
    StopWait;
  end;
end; {LoadFields}

function TfaMain.LoadFieldsInfo(const AFileName: string): boolean;
begin
  mtFieldsInfo.DefaultFormat := mtPrgTablesFormat;
  Result := LoadMtFromZip(mtFieldsInfo, FDefFileName, dpsw);
end; {LoadFieldsInfo}

function TfaMain.LoadMtValues(const AFileName: string): boolean;
var
  ro: boolean;
  text: string;
begin
  StartWait;
  mtValues.DisableControls;
  ro := mtValues.ReadOnly;
  mtValues.ReadOnly := FALSE;
  try
    Result := LoadTextFromZip(FDefFileName, mtValues.Name, text, dpsw);
    if Result then
    try
      Result := RestoreMtValuesDef(text);
    except
      on E: Exception do begin
        ShowMessage(Format(sMsgErrLoadmtValues, [E.Message]));
        Result := FALSE;
      end;
    end;
  finally
    mtValues.ReadOnly := ro;
    mtValues.EnableControls;
    StopWait;
  end;
end; {LoadMtValues}

function TfaMain.LoadControlsNamesList(const AFileName: string): boolean;
var
  text: string;
begin
  StartWait;
  try
    Result := LoadTextFromZip(FDefFileName, cControlsNamesListFN, text, dpsw);
    if Result then
      FControlsNamesList.Text := text
    else
      FControlsNamesList.Clear;
  finally
    StopWait;
  end;
end; {LoadControlsNamesList}

