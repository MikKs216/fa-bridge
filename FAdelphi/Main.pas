//nacteni slovniku pro kontrolu pravopisu
procedure TfaMain.LoadSpellCheckDict;
var
  dictFile,fn: string;
  sl: TStringList;
  i: integer;
begin
  {$IFNDEF STANDALONE}
  with dmGlobObj do
  {$ENDIF STANDALONE}
  begin
  StartWait;
  try try
    ShowHintSb(sMsgLoadingSpellCheckDict);
    Application.ProcessMessages;
    dictFile:=GetDataPrgPath+cSpellCheckDictFileName;
    if (ExtractFileName(FSpellCheckDictFileName)=cSpellCheckDictFileName)
      or (FSpellCheckDictFileName='') then begin //originalni slovnik
      if FileExists(dictFile) then begin
        if not mtSpellCheckDict.Active then begin
          mtSpellCheckDict.Open;
          mtSpellCheckDict.LoadFromFile(dictFile);
          //pripojeni uzivatelskeho slovniku
          //fn:=ChangeFileExt(dictFile,cSpellCheckDictDefaultExt); musime to brat podle typu instalace
          fn:=NormalPath(gFUserDataPath)+ChangeFileExt(ExtractFileName(dictFile),cSpellCheckDictDefaultExt);
          if FileExists(fn) then begin
            sl:= TStringList.Create;
            try
              sl.LoadFromFile(fn);
              for i:=0 to sl.Count-1 do begin
                mtSpellCheckDict.Append;
                mtSpellCheckDictSlovo.Value:=sl[i];
                mtSpellCheckDict.Post;
              end;
            finally
              sl.Free;
            end;
          end;
          //
          if dxBarSpellCheck.Down then
            reNotes.RichViewEdit.StartLiveSpelling;
          dxBarSpellCheck.Enabled:=TRUE;
        end
      end
      else begin
        dxBarSpellCheck.Down:=FALSE;
        dxBarSpellCheck.Enabled:=FALSE;
      end;
    end
    else begin // vybrany jiny slovnik
      dictFile:=FSpellCheckDictFileName;
      if FileExists(dictFile) then begin
        if not mtSpellCheckDict.Active then begin
          mtSpellCheckDict.Open;
          mtSpellCheckDict.EmptyTable;
          //nacteni slovniku
          sl:= TStringList.Create;
          try
            sl.LoadFromFile(dictFile);
            for i:=0 to sl.Count-1 do begin
              mtSpellCheckDict.Append;
              mtSpellCheckDictSlovo.Value:=sl[i];
              mtSpellCheckDict.Post;
            end;
          finally
            sl.Free;
          end;
          //
          if dxBarSpellCheck.Down then
            reNotes.RichViewEdit.StartLiveSpelling;
          dxBarSpellCheck.Enabled:=TRUE;
        end
      end
      else begin
        dxBarSpellCheck.Down:=FALSE;
        dxBarSpellCheck.Enabled:=FALSE;
      end;
    end;
    ShowHintSb('');
  except //kdyz se ukonci FA driv nez se slovnik nacte, muze dojit k chybe
  end
  finally
    StopWait;
  end;
  end;
end;

