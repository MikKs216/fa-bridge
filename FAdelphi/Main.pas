      pdfFileName:=pdfFileName+'.pdf';
    mtDef.Edit;
    mtDefReportScript.Value:='function ReportFiles: string;'+#13#10+
      'begin'+#13#10+
      '  Result:='''+pdfFileName+''';'+#13#10+
      'end;';
    mtDef.Post;
    //
    SaveFormScript;
  end;
  //
  {sl:=TStringList.Create;
  sl.Text:=mtDefReportScript.Value;
  try
    for i := 0 to sl.Count-1 do begin
      if Pos('.pdf',sl[i])>0 then begin
        pdfFileName:=Replace('Result',sl[i],'');
        pdfFileName:=Replace(':',pdfFileName,'');
        pdfFileName:=Replace('=',pdfFileName,'');
        pdfFileName:=Replace(';',pdfFileName,'');
        pdfFileName:=Replace('''',pdfFileName,'');
        pdfFileName:=Trim(pdfFileName);
        BREAK;
      end;
    end;
  finally
