procedure TfaMain.SetHistEdit(const AFieldName, AValue: string; AIsMemo: boolean = false);
var
  reccount, i: integer;
begin
  if FHistEditHasWrite and mtHistEdit.Active then begin
    reccount := mtHistEdit.RecordCount;
    mtHistEdit.Last;
    for i := FHistEditIndex to reccount - 1 do
      mtHistEdit.Delete;
    mtHistEdit.Append;
    mtHistEditFieldName.Value := AFieldName;
    if AIsMemo then
      mtHistEditValue.Value := FHistMemoLastValue
    else
      mtHistEditValue.Value := FHistEditLastValue;
    if mtHistEdit.State <> dsBrowse then
      mtHistEdit.Post;
    INC(FHistEditIndex);
    mtHistEdit.Append;
    mtHistEditFieldName.Value := AFieldName;
    mtHistEditValue.Value := AValue;
    if mtHistEdit.State <> dsBrowse then
      mtHistEdit.Post;
    INC(FHistEditIndex);
    faUndo1.Enabled := TRUE;
    faRedo1.Enabled := FALSE;
  end;
end;

procedure TfaMain.DoUndo;
var
  fld: TField;
begin
  if FHistEditIndex > 0 then begin
    FHistEditHasWrite := FALSE;
    try
      mtHistEdit.Prior;
      DEC(FHistEditIndex);

      GotoField(mtHistEditFieldName.Value);
      if FActuallyControl<>nil then begin
        if FActuallyControl.Name = mtHistEditFieldName.Value then begin
          fld := GetMTVField(mtHistEditFieldName.Value);
          if fld <> nil then begin
            TryEditMtValues;
            if fld is TBooleanField then
              fld.Value := StrToBoolSafe(mtHistEditValue.Value)
            else if (fld is TFloatField) or (fld is TIntegerField) or
              (fld is TCurrencyField) then
              fld.AsString := Replace(ThousandSeparator, mtHistEditValue.Value, '')
            else
              fld.AsString := mtHistEditValue.Value;
            TryPostMtValues;
            DisplayCheck; // po undo
            FHistEditLastValue := mtHistEditValue.Value;
          end;
        end;
      end;

      if FHistEditIndex > 1 then begin
        mtHistEdit.Prior;
        DEC(FHistEditIndex);
      end;
      faUndo1.Enabled := FHistEditIndex > 1;
      faRedo1.Enabled := FHistEditIndex < mtHistEdit.RecordCount;
      FHistEditLastDirectionBackward := TRUE;
    finally
      FHistEditHasWrite := TRUE;
    end;
  end;
end;

procedure TfaMain.DoRedo;
var
  fld: TField;
begin
  if FHistEditIndex < mtHistEdit.RecordCount then begin
    FHistEditHasWrite := FALSE;
    try
      if mtHistEdit.RecNo > 1 then begin
        mtHistEdit.Next;
        INC(FHistEditIndex);
      end;
      mtHistEdit.Next;
      INC(FHistEditIndex);

      GotoField(mtHistEditFieldName.Value);
      fld := GetMTVField(mtHistEditFieldName.Value);
      if fld <> nil then begin
        TryEditMtValues;
        if fld is TBooleanField then
          fld.Value := StrToBoolSafe(mtHistEditValue.Value)
        else
          fld.AsString := mtHistEditValue.Value;
        TryPostMtValues;
        DisplayCheck; // po redo
        FHistEditLastValue := mtHistEditValue.Value;
      end;

      faUndo1.Enabled := FHistEditIndex > 1;
      faRedo1.Enabled := FHistEditIndex < mtHistEdit.RecordCount;
      FHistEditLastDirectionBackward := FALSE;
    finally
      FHistEditHasWrite := TRUE;
    end;
  end;
end;

function TfaMain.IsLicenceForDefOk: boolean;
var
  verzeLic, verzeDef, vDef: string;
  vd,vp: integer;
  povoleniDleRoku, formularZakladniSkup, povoleniDleSkupiny: boolean;
begin
  if mtDef.Active then begin
    verzeLic := NarokovatelnaVerze;
    verzeDef := mtDefFormVersion.Value;
    vDef:=Copy(verzeDef,1,Pos('.',verzeDef)-1);
    if IsInteger(vDef) then begin
      vd:=StrToIntSafe(vDef);
      vp:=StrToIntSafe(verzeLic);
      povoleniDleRoku:=(vd<=vp);
    end
    else // kdyz nema definice platnou verzi
      povoleniDleRoku:=true;

    formularZakladniSkup :=
      (Copy(mtDefID.Value,1,1)<>'d') or //nedanove
      (Copy(mtDefID.Value,1,1)='d')and //danove -
      ((Copy(mtDefID.Value,2,1)='z') or //- zakladni
       (Copy(mtDefID.Value,2,1)='r') or //- registrace
       (Copy(mtDefID.Value,2,1)='x'));
    povoleniDleSkupiny := IsLicModule(UpperCase(Copy(mtDefID.Value, 2, 1)));
    Result := IsLicStart or
      (povoleniDleRoku and (formularZakladniSkup or povoleniDleSkupiny));
  end
  else
    Result := FALSE;
end;

procedure TfaMain.faUndo1Execute(Sender: TObject);
begin
  DoUndo;
end;

procedure TfaMain.faRedo1Execute(Sender: TObject);
begin
  DoRedo;
end;

procedure TfaMain.ShowFieldInfo;
var
  fldName, strActualValue, strDefaultValue, s: string;
  differentDefVal: boolean;
  restrictLength: boolean;
begin
  fldName := '';
  s := '';
  restrictLength := FALSE; ;
  if (CEdit <> nil) and CEdit.Focused then begin
    fldName := CEdit.Hint;
    restrictLength := CEdit.RestrictLength;
  end
  else if (ActiveControl <> nil) and (ActiveControl is TCxDBCheckBoxEx) then
    fldName := ActiveControl.Name
  else if (ActiveControl <> nil) and (ActiveControl.Parent <> nil) and
    (ActiveControl.Parent is TCxDBMemoEx) then
    fldName := ActiveControl.Parent.Name
  else begin
    MessageInfo(Caption, sNotExistInfo, [MBOK]);
  end;
  //
  if mtFields.Active and (fldName <> '') and
    mtFields.FindKey([UpperCase(fldName)])
    {mtFields.Locate(mtFieldsName.FieldName, fldName,
    [loCaseInsensitive])}then begin
    //identifikator
    AddStringLine(s, sFldNameCaption + ': ' + fldName);
    //typ
    if mtFieldsDataType.Value = cStringTypeValue then
      AddStringLine(s, sFldTypeCaption + ': ' + sFldTypeStringCaption)
    else if (mtFieldsDataType.Value = cNumericTypeValue) or
      (mtFieldsDataType.Value = cCurrencyTypeValue) then
      AddStringLine(s, sFldTypeCaption + ': ' + sFldTypeNumberCaption)
    else if mtFieldsDataType.Value = cDateTypeValue then
      AddStringLine(s, sFldTypeCaption + ': ' + sFldTypeDateCaption)
    else if mtFieldsDataType.Value = cBooleanTypeValue then
      AddStringLine(s, sFldTypeCaption + ': ' + sFldTypeBooleanCaption)
    else if mtFieldsDataType.Value = cMemoTypeValue then
      AddStringLine(s, sFldTypeCaption + ': ' + sFldTypeMemoCaption);
    //delka
    if (mtFieldsDataType.Value = cNumericTypeValue) or
      (mtFieldsDataType.Value = cCurrencyTypeValue) then begin
      if mtFieldsDataTypeLength.Value > 0 then
        AddStringLine(s, sFldTypeNumLengthCaption + ': ' +
          mtFieldsDataTypeLength.AsString)
      else
        AddStringLine(s, sFldTypeNumLengthIntCaption);
    end
    else if mtFieldsDataTypeLength.Value > 0 then begin
      if restrictLength then
        AddStringLine(s, sFldTypeLengthCaption + ': ' +
          mtFieldsDataTypeLength.AsString + ' (' + sFldRestrictLenght + ')')
      else
        AddStringLine(s, sFldTypeLengthCaption + ': ' +
          mtFieldsDataTypeLength.AsString + ' (' + sFldNoRestrictLenght + ')');
    end;
    //seznam
    if mtFieldsHasList.Value then
      AddStringLine(s, sFldHasListCaption);
    //defaultvalue
    if mtFieldsHasDefault.Value then begin
      AddStringLine(s, sFldHasDefValCaption);
      if FStateFormWasChanged then begin
        DoCalculate;
        TryPostMtValues;
      end;
      differentDefVal := GetFieldDefaultDifference(fldName, strDefaultValue,
        strActualValue);
      AddStringLine(s, sFldDefValueCaption + ': ' + strDefaultValue);
      AddStringLine(s, sFldValueCaption + ': ' + strActualValue);
      if differentDefVal then
        AddStringLine(s, sFldDefValDiferentCaption);
    end;
    if mtFieldsHasCalc.Value then begin
      if not FStateFormDisabledCalc and mtFieldsIsCalculated.Value then
        AddStringLine(s, sFldHasCalcCaption)
      else
        AddStringLine(s, sFldHasCalcDisableCaption);
    end;
    if mtFieldsHasEnabling.Value then begin
      if mtFieldsIsSetForEnabling.Value then
        AddStringLine(s, sFldHasEnablingCaption)
      else
        AddStringLine(s, sFldHasDisableEnablingCaption);
    end;

{$IFDEF STANDALONE}
    MessageInfo(sFieldInfoCaption, s, [MBOK]);
{$ELSE STANDALONE}
    DoOpenMemo(sFieldInfoCaption, s, true);
{$ENDIF STANDALONE}
  end
  else
    MessageInfo(Caption, sNotExistInfo, [MBOK]);
end; {ShowFieldInfo}

