  ApplyMainCaption(FDataFileName);
  ApplyFormCaption;
  SetChangeFlag(FALSE);
  FReportVariants:='';
  FReportVariantsTexts:='';
  FReportVariantsIsFR3:=FALSE;
  FActuallyControl:=nil;
  FLastActuallyControl:=nil;
{$IFDEF PROFILER}TimeLog('======== End Closing form'); {$ENDIF PROFILER}
