function MathRound(AValue: Extended): Int64; inline;
begin
  if AValue >= 0 then
    Result := Trunc(AValue + 0.5)
  else
    Result := Trunc(AValue - 0.5);
end;

function MulDiv(nNumber, nNumerator, nDenominator: Integer): Integer;
begin
  if nDenominator = 0 then
    Result := -1
  else
    Result := MathRound(Int64(nNumber) * Int64(nNumerator) / nDenominator);
end;

begin
	begin
	  inherited;

	{$IFDEF UCURSOR}
	  FScriptChangedByCursor := False; // Inicializace flagu
	{$ENDIF UCURSOR}

	{$IFDEF PROFILER}
	  FProfilerLog := TStringList.Create;
	  if FileExists(ChangeFileExt(Application.ExeName, '.tim')) then
		FProfilerLog.LoadFromFile(ChangeFileExt(Application.ExeName, '.tim'));
	  FProfilerLog.Add('=========================================');
	  FProfilerLog.Add(FormatDateTime('hh:mm:ss:zz', Time) + ' Start (Main FormCreate)');
	  FProfilerLastTime := 0;
	{$ENDIF PROFILER}

	  DateSeparator:='.';
	  ShortDateFormat:='d.M.yyyy';
	  LongDateFormat:='d. MMMM yyyy';
	  cxFormatController.BeginUpdate;
	  cxFormatController.UseDelphiDateTimeFormats:=true;
	  cxFormatController.EndUpdate;
	  cxFormatController.GetFormats;
	  cxFormatController.NotifyListeners;

	  GetRootFolder(typeOfPath, dataPath, userDataPath);
	  gFTypeOfPath := typeOfPath;
	  gFDataPath := NormalizeDir(dataPath);  //Pokud je STEREONX obsahuje slozku forms pokud je instalace All nebo current user
	  gFUserDataPath := NormalizeDir(userDataPath); //Pokud je STEREONX obsahuje slozku forms pokud je instalace All nebo current user
	{$IFDEF STANDALONE}
	  Caption := cApplicationName;
	  //test poctu spustenych instanci - nutne pro test pri zavirani
	  if not JclAppInstances.CheckInstance(cMaxInstances) then begin
		MessageWarn(Caption, sMsgOutLimitInstances, [MBOK]);
