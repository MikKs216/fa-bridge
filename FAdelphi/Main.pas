procedure TfaMain.dxBarSpellCheckAddClick(Sender: TObject);
var
  fn,s: string;
begin
  {$IFNDEF STANDALONE}
  with dmGlobObj do
  {$ENDIF STANDALONE}
  if mtSpellCheckDict.Active then begin
    mtSpellCheckDict.Append;
    mtSpellCheckDictSlovo.Value:=FSpellCheckAddedWord;
    mtSpellCheckDict.Post;
    reNotes.RichViewEdit.ClearLiveSpellingResults;
    reNotes.RichViewEdit.StartLiveSpelling;
    //
    if (ExtractFileName(FSpellCheckDictFileName)=cSpellCheckDictFileName) or
    (FSpellCheckDictFileName='') then
      fn:=NormalPath(gFUserDataPath)+
        ChangeFileExt(cSpellCheckDictFileName,cSpellCheckDictDefaultExt)
    else
      fn:=FSpellCheckDictFileName;
