procedure TfaMain.pmiSelectSameObjectsClick(Sender: TObject);
var
  i: integer;
  c, c0: TControl;
  L : TDCPersistentList;
  Pt: TPoint;
  keystate: boolean;
begin
  if (FDesignerPopUpMenuPosition.X = -1) or (FDesignerPopUpMenuPosition.Y = -1) then
    Exit;
  //
  //pokud je zmacknuty Ctrl a jsou oznacene nejake komponenty
  keystate:= (GetKeyState(VK_CONTROL) < 0) and (Designer.Designer.SelectedComponents.Count > 1);
  //
  //if Designer.Designer.SelectedComponents.Count > 0 then begin
    //c0 := TControl(Designer.Designer.SelectedComponents.Items[0]);
  c0:=FindDragTarget(FDesignerPopUpMenuPosition,False);
  if (c0 <> nil) and (c0.Parent <> nil) and (c0.Parent = sbForm) then begin
    L := TDCPersistentList.Create;
    try
      //pokud pokud je zmacknuty Ctrl, tak pripadne oznacene komponenty ve vyberu nechame
      if keystate then begin
        for i := 0 to Designer.Designer.SelectedComponents.Count - 1 do begin
          c := TControl(Designer.Designer.SelectedComponents.Items[i]);
          L.Add(c);
        end;
      end;
      //vybereme vsechny komponenty stejneho typu jako je ta, na kterou jsme kliknuli
      for i := 0 to sbForm.ControlCount - 1 do begin
        c := sbForm.Controls[i];
        if (c.ClassName = c0.ClassName) then begin
          L.Add(c);
        end;
      end;
      Designer.Designer.SetSelections(L);
    finally
      L.Free;
    end;
  end;
end;

