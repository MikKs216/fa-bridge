function TfaMain.GetScriptDirectiveNeedVer: string;
var
  sl: TStringList;
  i,p: integer;
begin
  Result:='';
  sl:=TStringList.Create;
  try
    sl.Text:=mtDefScript.Value;
    for i := 0 to sl.Count-1 do begin
      p:=Pos(cScriptDirective_NeedVer,UpperCase(sl[i]));
      if p>0 then begin
        Result:=Copy(sl[i],p+Length(cScriptDirective_NeedVer),20);
        p:=Pos('}',Result);
        if p>0 then
          Result:=Trim(Copy(Result,1,p-1))
        else
          Result:=Trim(Result);
      end;
    end;
  finally
    sl.Free;
  end;
end;

//zkontroluje script a nastavi co lze nastavit
procedure TfaMain.CheckAndLoadScript;

  function GetFieldNameFromCalcProc(const AScriptLine,
    AFunctionName: string): string;
  var
    p: integer;
    s: string;
  begin
    Result := '';
    p := Pos(UpperCase(AFunctionName) + '(', UpperCase(AScriptLine));
    if p > 0 then begin
      s := Copy(AScriptLine, p + Length(AFunctionName) + 2, maxint);
      p := Pos(''',', s);
      if p = 0 then
        p := Pos(''')', s);
      if p > 1 then
        Result := Copy(s, 1, p - 1);
    end;
  end; {GetFieldName}

  procedure InitFieldsCalcInfo;
  begin
    StartWait;
    try
      mtFields.First;
      while not mtFields.EOF do begin
        mtFields.Edit;
        mtFieldsHasCalc.Value := FALSE;
        mtFieldsIsCalculated.Value := FALSE;
        mtFieldsHasDefault.Value := FALSE;
        mtFieldsHasEnabling.Value := FALSE;
        mtFieldsIsSetForEnabling.Value := FALSE;
        mtFieldsCalcWithoutShowing.Value := FALSE;
        mtFieldsHasList.Value := FALSE;
        mtFields.Post;
        mtFields.Next;
      end;
    finally
      StopWait;
    end;
  end; {InitFieldsCalcInfo}

  procedure CheckFieldNamesInScriptGroup(var AMsgs: string);
  var
    i: integer;
    s, fldName: string;
  begin
    if FNewScripter then
      s := ScripterT_ExecuteSubRoutine(sScriptProcName_Groups)
    else
      s := Scripter.CallNoParamsMethod(sScriptProcName_Groups);
      //naplni seznam skupin
    s := Replace(';', s, ',');
    for i := 0 to CountListItems(s) - 1 do begin
      fldName := GetListItem(s, i);
      if not mtFields.FindKey([UpperCase(fldName)])
        {mtFields.Locate(mtFieldsName.FieldName, fldName,
        [loCaseInsensitive])}and (UpperCase(fldName) <>
        UpperCase(sScriptGroupDisableUncheck)) then
        AddStringLine(AMsgs, Format(sCErrUnknownField,
          [fldName, sScriptProcName_Groups]));
    end;
  end {CheckFieldNamesFromGroupFunc};

const
  cProcCalcName = 'Cal';
  cProcCalnName = 'CalN';
  cProcInitName = 'Ini';
  cProcDefaultName = 'Def';
  cProcEnaName = 'Ena';
  cProcLstName = 'Lst';
  cProcSimpleLstName = 'SimpleLst';
  cProcGotoName = 'GotoFld';
var
  sl: TstringList;
  i: integer;
  errLine, errChar: integer;
  fldName, msgs: string;
  st: TMemoryStream;
  msglog: string;
begin
  StartWait;
  msgs := '';
  try
    ShowHintSb(sSbCompilation);
    st := TMemoryStream.Create;
    try
      FScript := TranslateFieldNames(mtDefScript.Value);
      FScript := TranslateIniProcs(FScript);
      if FNewScripter then begin
        ScripterT.SourceCode.Clear;
        ScripterT.SourceCode.Text := AcceptScriptDirectives(FScript);
        try
          ScripterT.Compile;
        except
          on e: Exception do begin
            {$IFDEF UCURSOR}
            MsgBoxErr('FA - cursor editor','Chyba: ' + E.Message, MB_OK);
            {$ENDIF UCURSOR}
            raise; // Přehodí výjimku dál
          end;
        end;
      end
      else begin
        Scripter.Script.Clear;
        Scripter.Script.Add(AcceptScriptDirectives(FScript));
      end;

      if CheckScriptDirective(cScriptDirective_SaveCompiled) then begin // ulozime jen pri pouziti direktivy, jinak neukladat, ulozi se pri prvnim otevreni
        if FNewScripter then begin
          ScripterT.SaveCodeToStream(st);
          
          st.Seek(0, soFromBeginning);
          ScripterT.LoadCodeFromStream(st);
          //st.SaveToFile('d:\script.txt');
        end
        else begin
          Scripter.SaveCompiledScriptToStream(st);

          st.Seek(0, soFromBeginning);
          Scripter.LoadCompiledScriptFromStream(st);
        end;

        st.Seek(0, soFromBeginning);
        mtDef.Edit;
        try
          mtDefCompiledScript.LoadFromStream(st);
        finally
          mtDef.Post;
        end;
      end;
    finally
      st.Free;
      ShowHintSb('');
    end;

    {if not Scripter.CheckSyntaxEx(errLine,errChar,FALSE) then        //puvodne se zde volalo, ale neni treba chyba se nahlasi automaticky
      MessageWarn(Caption,Format('Chyba ve scriptu na řádku %d.',
        [errLine]),[MBOK]);}
    sl := TstringList.Create;
    sl.Text := mtDefScript.Value;
    try
      InitFieldsCalcInfo;
      for i := 0 to sl.Count - 1 do begin
        //Calculate
        //  Cal
        fldName := GetFieldNameFromCalcProc(sl[i], cProcCalcName);
        if (fldName = '') then
          fldName := GetFieldNameFromCalcProc(sl[i], cProcCalnName); //hledame cal i caln (zaokrouhlovaci cal)
        if (fldName <> '') then begin
          if mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then begin
            mtFields.Edit;
            mtFieldsHasCalc.Value := TRUE;
            mtFieldsIsCalculated.Value := TRUE;
            mtFields.Post;
          end
          else
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, sScriptProcName_Calculate, i + 1]));
        end;
        //Init
        fldName := GetFieldNameFromCalcProc(sl[i], cProcInitName);
        if (fldName <> '') then begin
          if mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then begin
            mtFields.Edit;
            mtFieldsHasDefault.Value := TRUE;
            mtFields.Post;
          end
          else
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, sScriptProcName_Init, i + 1]));
        end;
        //  Def
        fldName := GetFieldNameFromCalcProc(sl[i], cProcDefaultName);
        if (fldName <> '') then begin
          if mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then begin
            mtFields.Edit;
            mtFieldsHasDefault.Value := TRUE;
            mtFields.Post;
          end
          else
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, sScriptProcName_Init, i + 1]));
        end;
        //Enable
        fldName := GetFieldNameFromCalcProc(sl[i], cProcEnaName);
        if (fldName <> '') then begin
          if mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then begin
            mtFields.Edit;
            mtFieldsHasEnabling.Value := TRUE;
            mtFieldsIsSetForEnabling.Value := TRUE;
            mtFields.Post;
          end
          else
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, sScriptProcName_Enable, i + 1]));
        end;
        //List
        fldName := GetFieldNameFromCalcProc(sl[i], cProcLstName);
        //uprava pro naplneni vice udaju soucasne
        if fldName = '' then
          fldName := GetFieldNameFromCalcProc(sl[i], cProcSimpleLstName)
        else begin
          if CountListItems(fldName)>0 then
            fldName := GetListItem(fldName,0);
        end;
        if (fldName <> '') then begin
          if mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then begin
            mtFields.Edit;
            mtFieldsHasList.Value := TRUE;
            mtFields.Post;
          end
          else
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, sScriptProcName_Lists, i + 1]));
        end;
        //GotoFld
        fldName := GetFieldNameFromCalcProc(sl[i], cProcGotoName);
        if (fldName <> '') then begin
          if not mtFields.FindKey([UpperCase(fldName)])
            {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
            [loCaseInsensitive])}then
            if Copy(fldName,1,1)<>'+' then //aby se nehlasilo pri dyn. tvorbe jmena fieldu, napr. v silnicce
              AddStringLine(msgs, Format(sCErrUnknownFieldInLine,
                [fldName, cProcGotoName, i + 1]));
        end;
      end;
      //Nastavi udalosti pro checkboxy
      SetCbOnClick;
      {$IFNDEF FINALBUILD}
      //Group
      CheckFieldNamesInScriptGroup(msgs);
      if msgs <> '' then begin
        MessageWarn('Kontrola scriptu', msgs, [MBOK]);
      end;
      {$ENDIF FINALBUILD}
    finally
      sl.Free;
    end;
  finally
    StopWait;
  end;
end; {CheckAndLoadScript}

