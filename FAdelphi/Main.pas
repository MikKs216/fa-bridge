function TfaMain.GetPDS(const APDSFileName: string = ''): string;
const
  cReportDef = 'ReportDef';
var
  fdrFileName, pdfFileName, pdsFileName, pdsstr, pdsstrOld, pth, usedFields: string;
  sl:TstringList;
  i: integer;
begin
  if APDSFileName='' then begin
    if mtDefReportScript.Value<>'' then begin
      sl:=TStringList.Create;
      sl.Text:=mtDefReportScript.Value;
      try
        for i := 0 to 5 do begin
          if Pos('.pdf',sl[i])>0 then begin
            pdfFileName:=Replace('Result',sl[i],'');
            pdfFileName:=Replace(':',pdfFileName,'');
            pdfFileName:=Replace('=',pdfFileName,'');
            pdfFileName:=Replace(';',pdfFileName,'');
            pdfFileName:=Replace('''',pdfFileName,'');
            pdfFileName:=Trim(pdfFileName);
            BREAK;
          end;
        end;
      finally
        sl.Free;
      end;
      pdsFileName:=NormalPath(DirWorkPath)+ChangeFileExt(pdfFileName,'.pds');
    end;
  end
  else
    pdsFileName:=NormalPath(DirWorkPath)+APDSFileName;

  fdrFileName := NormalPath(ExtractFilePath(FDefFileName)) +
    mtDefID.Value + cReportDefaultExt;
  if FileExists(fdrFileName) then begin
    UnzipReportDefs(fdrFileName);
    Result:=LoadStringFromFile(pdsFileName);
  end
  else
    Result:='';
end;

