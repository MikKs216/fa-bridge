function TfaMain.SendFileViaDS(const AFileName, AFormName, APrilohy, APredmet: string): Boolean;
var
  comm, mailadr, err, outfilename, predmet, prilohy: string;
  sel: Boolean;
  sl: TStringList;
begin
  Result:= False;
  sl:= TStringList.Create;
  try
    if ShowChecking then
      EXIT;
    if FStateFormWasChanged then begin
      DoCalculate;
      TryPostMtValues;
    end;

    comm := '';
    if mtValues.Active then begin
      comm := GetListItem(GetPeriod, 3) + ' ' + GetSysComment;
      if comm <> '' then
        comm := ', ' + comm;
    end;

    if StartCounterZero then
      EXIT;

    sl.Text := AFileName;

    if APrilohy <> '' then
      sl.Text := sl.Text + #13#10 + APrilohy;

    if APredmet = '' then
      predmet := AFormName+comm
    else
      predmet := APredmet;

    sel := SelectDS(mailadr);
    if sel then
      Result:=SendISDSOrEmail(mailadr,predmet,'',sl,TRUE,err,outfilename);
  finally
    sl.Free;
  end;
end;

//vraci true kdyz je odeslano pres DS a uzivatel skutecne zpravu odeslal
function TfaMain.SendISDSOrEmail(AAddress, ASubject, ABody: string;
  AAttachments: TStringList;
  AShowDialog: boolean; out AErrorMsg: string; out ASavedFile: string): boolean;
var
  odesilatel, idds, prijemce, destDir, fn, fnfull, ex, dir: string;
  i: integer;
  ok: boolean;
begin
  Result:=False;
  ASavedFile:='';

  odesilatel:=Copy(PrepareClientAdress,1,40);
  if (IsLicProfesional or IsLicMulti or IsInSlaveState) and
    (odesilatel<>'') and (Pos(odesilatel,ASubject)<=0) then //kdyz odesilame nahled v pdf tak uz tam nazev firmy je
    ASubject:=ASubject+' - '+odesilatel;

  if Copy(AAddress,1,Length(cIDDS))=cIDDS then begin
    idds:=Copy(AAddress,Length(cIDDS)+1,maxint);
    if Pos('#',idds)>0 then begin
      prijemce:=Copy(idds,Pos('#',idds)+1,maxint);
      idds:=Copy(idds,1,Pos('#',idds)-1);
    end;
    Result:=DSNewMessage(FClientID,
{$IFDEF STANDALONE}
      FALSE,
      FClientParam.Text,
      True,
      idds,prijemce,
      ASubject,AAttachments.CommaText,0);
{$ELSE STANDALONE}
      TRUE,
      FClientParam.Text,
      True,
      idds,prijemce,
      ASubject,AAttachments.CommaText,GetFormID);
{$ENDIF STANDALONE}
  end
  else if UpperCase(Copy(AAddress,1,Length(cSaveToDisk)))=cSaveToDisk then begin
    if AAttachments.Count=1 then begin
      DoEncodeFiles(AAttachments);
      FPdfPassword:='';
      with SaveDialog1 do begin
        EIInitSaveDlgExport(SaveDialog1, ClientParam('Description'));
        DefaultExt := ExtractFileExt(AAttachments[0]);
        if LowerCase(DefaultExt) = LowerCase(cXMLDefaultExt) then
          Filter := cXMLEPOpenSaveFilter
        else if LowerCase(DefaultExt) = LowerCase(cPDFDefaultExt) then
          Filter := cPDFOpenSaveFilter
        else
          Filter := cAllOpenSaveFilter;
        FileName := (ExtractFileName(AAttachments[0]));
        if Execute then
          if not FileExists(FileName) or
            (MessageAsk('',
            Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then begin
              if FileName<>AAttachments[0] then
                FileCopy(AAttachments[0],FileName,true);
              ASavedFile := FileName;
            end;
      end;
    end
    else begin
      if FPdfPassword='' then begin //kdyz se nema heslovat tak ulozime jednotlive soubory #3561
        if SelectDir(sMsgChooseDir, EIDirGetExport(ClientParam('Description')), dir) then begin
          for i := 0 to AAttachments.Count - 1 do begin
            fn:=NormalPath(dir)+ExtractFileName(AAttachments[i]);
            if not FileExists(fn) or
            (MessageAsk('',Format(sMsgFileNotExistsAsk, [fn]), [MBYES, MBNO]) = IDYES) then
              FileCopy(AAttachments[i],fn,True);
          end;
        end;
      end
      else begin
        destDir := NormalPath(GetDirWorkPath+CreateGUIDString);
        ForceDirectories(destDir);
        for i := 0 to AAttachments.Count - 1 do begin
          FileCopy(AAttachments[i],NormalPath(destDir)+ExtractFileName(AAttachments[i]),True);
        end;
        with SaveDialog1 do begin
          EIInitSaveDlgExport(SaveDialog1, ClientParam('Description'));
          DefaultExt := cCompressedZipDefaultExt;
          Filter := cZIPOpenSaveFilter;
          if FPdfPassword='' then begin
            if ASubject='' then
              FileName := 'Komprimované soubory'+DefaultExt
            else
              FileName := ASubject +DefaultExt;
          end
          else begin
            if ASubject='' then
              FileName := 'Komprimované soubory _důverné'+DefaultExt
            else
              FileName := ASubject + '_důverné'+DefaultExt;
          end;
          if Execute then begin
            if not FileExists(FileName) or
              (MessageAsk('',
              Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then begin
                ZipFile(NormalPath(destDir)+'*.*',FileName,'',FPdfPassword);
                FPdfPassword:='';
                ASavedFile := FileName;
              end;
          end;
        end;
      end;
    end;
  end
  else begin
    prijemce:=AAddress;
    if prijemce='' then
      prijemce:='@';
    //sifrovani PDF
    DoEncodeFiles(AAttachments);
    FPdfPassword:='';
    ok:=SendEmail(prijemce, ASubject, ABody, AAttachments, AShowDialog, AErrorMsg);
    if not ok then
      MsgBoxErr(Caption,Format(sMsgSendMailErr,[AErrorMsg]),MB_OK);
  end;
end;

procedure TfaMain.DoEncodeFiles(var AFilenameList: TStringList);
var i: integer;
  fnfull,fn,ex,destDir,encoderPath: string;
begin
  try
    if FPdfPassword<>'' then begin
      for i := 0 to AFilenameList.Count - 1 do begin
        fnfull:=AFilenameList[i];
        fn:=ExtractFileName(AFilenameList[i]);
        ex:=ExtractFileExt(fn);
        if (fnfull<>'') and FileExists(fnfull) then begin
          if (UpperCase(ex)='.PDF') then begin
            fn:=GetUniqueFileName(ExtractFilePath(fnfull),Copy(fn,1,Length(fn)-Length(ex))+cAppDuverne+ex);
            encoderPath:=NormalPath(ExtractFilePath(Application.ExeName))+cPDFEncoderPath;
            if FileExists(encoderPath) then
              EncodePDF(fnfull,fn,FPdfPassword)
            else
              MsgBoxErr(Caption,Format(sMsgPDFEncryptNotExist,[encoderPath]),MB_OK);
          end
          else if (UpperCase(ex)='.XML') then begin
            fn:=GetUniqueFileName(ExtractFilePath(fnfull),Copy(fn,1,Length(fn)-Length(ex))+cAppDuverne+'.zip');
            ZipFile(fnfull,fn,'',FPdfPassword);
          end
          else if (UpperCase(ex)='.ZIP') then begin
            destDir := NormalPath(GetDirWorkPath+CreateGUIDString);
            ForceDirectories(destDir);
            UnzipFile(fnfull, DestDir);
            fn:=GetUniqueFileName(ExtractFilePath(fnfull),Copy(fn,1,Length(fn)-Length(ex))+cAppDuverne+ex);
            ZipFile(NormalPath(destDir)+'*.*',fn,'',FPdfPassword);
          end;
          AFilenameList[i]:=fn;
        end;
      end;
    end;
  finally
    FPdfPassword:='';
  end;
end;

