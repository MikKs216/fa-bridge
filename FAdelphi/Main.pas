//vraci, zda je zakladni hodnota jina nez aktualni hodnota
//  pokud ne, tak nastavi ADefaultValue a AActuallValue

function TfaMain.GetFieldDefaultDifference(const AFieldName: string;
  out ADefaultValue, AActualValue: string): boolean;
var
  actualValue, defaultValue: variant;
  statBrowse: boolean;
  pBeforePost: TDataSetNotifyEvent;

begin
  {if FStateFormWasChanged then begin
    DoCalculate;
    TryPostMtValues;
  end;}
  {FIsLoadingData:=TRUE;
  try
    TryPostMtValues;
  finally
    FIsLoadingData:=FALSE;
  end;}
  mtValues.DisableControls;
  try
    Result := FALSE;
    ADefaultValue := '';
    AActualValue := '';
    if GetMTVField(AFieldName).AsString <> '' then begin
      actualValue := GetMTVField(AFieldName).Value;
      DoDefault(AFieldName);
      defaultValue := GetMTVField(AFieldName).Value;
      Result := actualValue <> defaultValue;
      ADefaultValue := VarToStr(defaultValue);
      AActualValue := VarToStr(actualValue);
      if Result then begin
        statBrowse := mtValues.State=dsBrowse;
        TryEditMtValues;
        GetMTVField(AFieldName).AsVariant:=actualValue;
        if statBrowse then begin
          pBeforePost:=mtValues.BeforePost;
          try
            mtValues.BeforePost:=nil; //muse odpojit udalost jinak nekdy dochazelo k zacykleni
            TryPostMtValues; // tady neni potreba volat kontroly
          finally
            mtValues.BeforePost:=pBeforePost;
          end;
        end;
      end;
    end;
  finally
    if mtValues.State = dsEdit then
      mtValues.Cancel;
    mtValues.EnableControls;
  end;
end; {GetFieldDefaultDifference}

//zobrazi - aktualizuje informace o udaji na stavovem radku

procedure TfaMain.ShowFieldState;
var
  fldName: string;
  restrictLength: boolean;
begin
  fldName := '';
  ShowHintSb('');
  if (CEdit <> nil) and CEdit.Focused then begin
    fldName := CEdit.Hint;
    TestEditStringLength;
  end
  else if (ActiveControl <> nil) and
    ((ActiveControl is TCxDBCheckBoxEx) or (ActiveControl is TCxDBCheckBoxEx))
    then
    fldName := ActiveControl.Name
  else if (ActiveControl <> nil) and (ActiveControl.Parent <> nil) and
    (ActiveControl.Parent is TCxDBMemoEx) then
    fldName := ActiveControl.Parent.Name
  {else if (ActiveControl <> nil) and (ActiveControl.Parent <> nil) and
    (ActiveControl.Parent is TCxListboxEx) then
    fldName := ActiveControl.Parent.Name} //MIKMIK
  else begin
    ShowFldType('', 0, FALSE);
    ShowFldHasLookup(FALSE);
    ShowFldHasDefVal(FALSE, FALSE, '', '', FALSE);
    ShowFldCalcState(fcsNoCalc);
    ShowFldHasEnabling(fcsNoCalc);
    faDefValue.Enabled := FALSE;
    faNavigator.Enabled := FALSE;
    faOpenStrings.Enabled := FALSE;
    faFieldInfo.Enabled := FALSE;
  end;
  //
  if mtFields.Active and (fldName <> '') then begin
    if mtFields.FindKey([UpperCase(fldName)])
      {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
      [loCaseInsensitive])}then begin
      //nastavovani statusbaru
      if (CEdit <> nil) and CEdit.Focused then
        restrictLength := CEdit.RestrictLength
      else
        restrictLength := FALSE;
      ShowFldType(mtFieldsDataType.Value, mtFieldsDataTypeLength.Value,
        restrictLength);
      ShowFldHasLookup(mtFieldsHasList.Value);
      faNavigator.Enabled := CanEnableNavigator and (mtFieldsHasList.Value or
        (mtFieldsDataType.Value = 'N') or (mtFieldsDataType.Value = 'C') or
        (mtFieldsDataType.Value = 'D')) and not mtValues.readOnly;
      faOpenStrings.Enabled := CanEnableNavigator and (
        mtFieldsDataType.Value = cStringTypeValue) and not mtValues.readOnly;
      ShowFldHasDefVal(mtFieldsHasDefault.Value, FALSE,
        '', '', mtFieldsDataType.Value = cBooleanTypeValue);
      faDefValue.Enabled := mtFieldsHasDefault.Value and not mtValues.ReadOnly;
      //
      if mtFieldsHasCalc.Value then
        if not FStateFormDisabledCalc and mtFieldsIsCalculated.Value then
          ShowFldCalcState(fcsCalc)
        else
          ShowFldCalcState(fcsDisableCalc)
      else
        ShowFldCalcState(fcsNoCalc);
      if mtFieldsHasEnabling.Value then
        if mtFieldsIsSetForEnabling.Value then
          ShowFldHasEnabling(fcsCalc)
        else
          ShowFldHasEnabling(fcsDisableCalc)
      else
        ShowFldHasEnabling(fcsNoCalc);
      //nastavovani polozek menu
      dxBarButtonDisableCalcField.Enabled := mtFieldsHasCalc.Value and
        not mtValues.ReadOnly and FParamDisableCalcFieldEnabled and
        not IsTableField(mtFieldsName.Value);
      dxBarButtonDisableCalcField.Down := mtFieldsHasCalc.Value and
        not mtFieldsIsCalculated.Value;
      dxBarButtonEnableFieldEdit.Enabled := mtFieldsHasEnabling.Value and
        not mtValues.ReadOnly;
      dxBarButtonEnableFieldEdit.Down := mtFieldsHasEnabling.Value and
        not mtFieldsIsSetForEnabling.Value;
    end;
    faFieldInfo.Enabled := TRUE;
  end
  else
    faFieldInfo.Enabled := FALSE;
{$IFNDEF FINALBUILD}
  if fldName<>'' then
    FLastFieldName:=fldName;
  ShowHintSb(FLastFieldName);
{$ENDIF FINALBUILD}
end; {ShowFieldState}

