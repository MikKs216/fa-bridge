  cxContentDBTableView1DefaultCollapsed.Visible := FALSE;
  cxContentDBTableView1DefaultControlName.Visible := FALSE;
  cxContentDBTableView1.OptionsView.GridLines := glNone;
  cxContentDBTableView1.OptionsView.ScrollBars := ssVertical;
  cxContentDBTableView1Section.Width := cDefaultColunmSectionWidth;
  SetContentColumnsWidth;
  cxContent.BringToFront;
  cxTvContent.Visible := FALSE;
  laContent.FocusControl := cxContent;
