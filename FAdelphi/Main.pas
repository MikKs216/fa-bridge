function TfaMain.LoadReportSettings(const AIniFileName: string):
  TReportSettings;
var
  iniFile: TMemIniFile;
  section, defID: string;
begin
  iniFile := TMemIniFile.Create(AIniFileName);
  try
    if FNestedState then
      defID:=FNestedDefName
    else
      defID:=mtTskpDefID.Value;
    if FParamSavePrintParamsForDefinitions and mtTskp.Active then
      section := cIniRepSetSection + '_' + defID
    else
      section := cIniRepSetSection;
    with Result do begin
      PrintForm := iniFile.ReadBool(section, cPrintForm, TRUE);
      PrintValues := iniFile.ReadBool(section, cPrintValues, TRUE);
      RemoveBackground := iniFile.ReadBool(section,
        cRemoveBackground, TRUE);
      NofilledStrike := iniFile.ReadBool(section, cNoFilledStrike,
        FALSE);
      ZeroValueClear := iniFile.ReadBool(section, cZeroValueClear,
        FLocalVersion = cLocalVersionSK); // u SK lokalizace TRUE
      NulNumValueFillZero := iniFile.ReadBool(section,
        cNulNumValueFillZero, FALSE);
      UseClientIdentification := iniFile.ReadBool(section,
        cUseClientIdentification, TRUE);
      UsePrgIdentification := iniFile.ReadBool(section,
        cUsePrgIdentification, TRUE);
      PrintWithDialog := iniFile.ReadBool(section, cPrintWithDialog, FALSE);
      UseUserFont := iniFile.ReadBool(section, cUseUserFont, FALSE);
      FontName := iniFile.ReadString(section, cFontName, 'Courier');
      FontSize := iniFile.ReadInteger(section, cFontSize, 12);
      FontBold := iniFile.ReadBool(section, cFontBold, FALSE);
      FontItalic := iniFile.ReadBool(section, cFontItalic, FALSE);
      FontColor := StrToColor(iniFile.ReadString(section, cFontColor,
        ColorToStr(clBlack)));
      ShiftX := iniFile.ReadInteger(section, cShiftX, 0);
      ShiftY := iniFile.ReadInteger(section, cShiftY, 0);
      //
      RepPagesAll := iniFile.ReadBool(section, cRepPagesAll, TRUE);
      RepPagesOdd := iniFile.ReadBool(section, cRepPagesOdd, FALSE);
      RepPagesEven := iniFile.ReadBool(section, cRepPagesEven, FALSE);
      RepPagesOddThenEven := iniFile.ReadBool(section, cRepPagesOddThenEven,
        FALSE);
      RepPagesSelected := iniFile.ReadBool(section, cRepPagesSelected, FALSE);
      RepSelectedPages := iniFile.ReadString(section, cRepSelectedPages, '');
      RepCopies := iniFile.ReadInteger(section, cRepCopies, 1);
      RepInternalReader := iniFile.ReadBool(section, cRepOpenReaderInWindow,FALSE); //je to uz davno popletene
      RepEditorReader := iniFile.ReadBool(section, cRepEditorReader,True);
      RepExternalReader := iniFile.ReadBool(section, cRepExternalReader, FALSE) or //sjednoceno do jedne volby
        iniFile.ReadBool(section, cRepInternalReader, TRUE);
      RepUserDefined := iniFile.ReadBool(section, cRepOpenUserDefWindow,FALSE);
      CMDShow:= iniFile.ReadString(section, cRepUserCMDPreview, '');
      CMDPrint:= iniFile.ReadString(section, cRepUserCMDPrint, '');
      PrintNalezato:= iniFile.ReadBool(section, cRepPrintNalezato, FALSE);

      UseSignature := iniFile.ReadBool(section, cRepUseSignature, FALSE);
      UseSignatureInText := iniFile.ReadBool(section, cRepUseSignatureInText, FALSE);
      SignatureHash := iniFile.ReadString(section, cRepSignatureHash, '');
      SignatureSubject := iniFile.ReadString(section, cRepSignatureSubject, '');

      VariantName := iniFile.ReadString(section, cRepVariantName, '');

      PrinterIndex := iniFile.ReadInteger(section, cRepPrinterIndex, -1);
      PrinterName := iniFile.ReadString(section, cRepPrinterName, '');

      FDFPrint := iniFile.ReadBool(section, cRepFDFPrint, FALSE);
    end;
  finally
    iniFile.Free;
  end;
end; {LoadReportSettings}

