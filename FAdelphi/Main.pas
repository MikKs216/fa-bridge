function TfaMain.TranslateIniProcs(const AScript: string): string;
var
  sl: TStringList;
  i, pIni, pDelim: integer;

  function PosIni(const ARadek, AIniIdentificator: string): integer;
  begin
    Result := Pos(' '+AIniIdentificator+'(', AnsiUpperCase(sl[i]));
    if Result>0 then 
      Result:=Result+1
    else begin
      Result := Pos(AIniIdentificator+'(', AnsiUpperCase(sl[i]));
      if Result>1 then
        Result:=0;
    end;
  end;

begin
  sl := TStringList.Create;
  try
    sl.Text := AScript;
    for i := 0 to sl.Count - 1 do begin
      pIni := PosIni(sl[i],'INI');
      if pIni > 0 then begin
        pDelim := pIni;
        while (pDelim <= Length(sl[i])) and (Copy(sl[i], pDelim, 1) <> ',') do
          INC(pDelim);
        if Copy(sl[i], pDelim, 1) = ',' then begin
          sl[i] := Copy(sl[i], 1, pIni - 1) +
            'if (GScriptState = ssInit) or (GScriptState = ssDefault) and (UpperCase(GScriptFieldName)=UpperCase(' +
            Copy(sl[i], pIni + 4, pDelim - pIni - 4) +
            ')) then ' + Copy(sl[i], pIni, maxint);
        end;
      end;
      //Ino
      pIni := PosIni(sl[i],'INO');
      if pIni > 0 then begin
        pDelim := pIni;
        while (pDelim <= Length(sl[i])) and (Copy(sl[i], pDelim, 1) <> ',') do
          INC(pDelim);
        if Copy(sl[i], pDelim, 1) = ',' then begin
          sl[i] := Copy(sl[i], 1, pIni - 1) +
            'if GScriptState = ssInit then ' + Copy(sl[i], pIni, maxint);
        end;
      end;
      //Def
      pIni := PosIni(sl[i],'DEF');
      if pIni > 0 then begin
        pDelim := pIni;
        while (pDelim <= Length(sl[i])) and (Copy(sl[i], pDelim, 1) <> ',') do
          INC(pDelim);
        if Copy(sl[i], pDelim, 1) = ',' then begin
          sl[i] := Copy(sl[i], 1, pIni - 1) +
            'if (GScriptState = ssDefault) and (UpperCase(GScriptFieldName)=UpperCase(' +
            Copy(sl[i], pIni + 4, pDelim - pIni - 4) +
            ')) then ' + Copy(sl[i], pIni, maxint);
        end;
      end;
    end;
    Result := sl.Text;
  finally
    sl.Free;
  end;
end;


