procedure TfaMain.OpenAndPrintFile(const AFileName: string);
var
  reportSettings: TReportSettings;
  pomStr: string;

  procedure LoadAndSetReportSettings;
  var
    i: integer;
    prnName1, prnName2: string;
  begin
    if (ParamStr(3)<>'') and FileExists(ParamStr(3)) then
      reportSettings := LoadReportSettings(ParamStr(3))
    else
      reportSettings := LoadReportSettings(GetIniFileName);
    reportSettings := ApplyRestrictReportOptions(reportSettings);
    //vyber tiskarny
    if reportSettings.PrinterName<>'' then begin
      for i:=0 to Printer.Printers.Count-1 do begin
        prnName1:=ANSIUpperCase(Printer.Printers[i]);
        prnName2:=ANSIUpperCase(reportSettings.PrinterName);
        if prnName1=prnName2 then begin
          Printer.PrinterIndex:=i;
          BREAK;
        end;
      end;
    end
    else
      Printer.PrinterIndex := reportSettings.PrinterIndex;
  end; {LoadAndSetReportSettings}

  procedure PrintData(const ADataString: string);
  var
    pdfFileName,repDefFileName: string;
  begin
    FDataFileName := '';
    if OpenFileDataString(ADataString) then begin
      if mtDef.Active then begin
        if UpperCase(ParamStr(2)) = '/PC' then begin //zavolat Calculate
          DoCalculate;
          SetChangeFlag(FALSE);
        end;
        // nastaveni variant
        if (reportSettings.VariantName<>'') and
          (reportSettings.VariantName <> sReportVariantBasic) then begin
          if FReportVariantsTexts <> '' then
            repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
              mtDefID.Value + '#' +
              GetStringLineName(FReportVariantsTexts, reportSettings.VariantName) +
              cReportDefaultExt
          else
            repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
              mtDefID.Value + '#' + reportSettings.VariantName + cReportDefaultExt
        end
        else
          repDefFileName := NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
            mtDefID.Value + cReportDefaultExt;
        //vytvoreni PDF
        if (ParamStr(4)<>'') then begin
          FNestedPrepareReportState:=TRUE;
          pdfFileName := PreviewForm(repDefFileName,
            FALSE{APRint}, FALSE{AMail}, TRUE{AOnlyPrepare}, reportSettings, ParamStr(4));
          FNestedPrepareReportState:=FALSE;
          FileCopy(pdfFileName,GetUniqueFileName(ExtractFilePath(ParamStr(4)),
            ExtractFileName(ParamStr(4))),TRUE);
        end
        //tisk
        else
          PreviewForm(repDefFileName,
            TRUE{APRint}, FALSE{AMail}, FALSE{AOnlyPrepare}, reportSettings);
      end;
      reportSettings.PrintWithDialog:=FALSE;
    end;
  end; {PrintData}

  procedure PrintDataXML(const AXMLData: string; AXMLDoc: TXMLDocument);
  var
    strData: string;
  begin
    strData := XMLToData(AXMLData, XMLDoc);
    if strData <> '' then begin
      if GetStringLine(strData, 0) = cFormHeadLabel then
        PrintData(strData)
      else
        MessageErr(Caption, Format(sMsgBadFormXMLDataFile, [AFileName]), [MBOK]);
    end
    else
      MessageErr(Caption, Format(sMsgBadFormXMLDataFile, [AFileName]), [MBOK]);
  end; {PrintDataXML}

  procedure PrintMoreForm(const AXMLData: string; AXMLDoc: TXMLDocument);
  var
    node, node1: IXMLNode;
    i: integer;
    strXMLFirstLine: string;
  begin
    StartWait;
    try
      AXMLDoc.XML.Text := AXMLData;
      AXMLDoc.Active := TRUE;
      if AXMLDoc.DocumentElement.NodeName = cFormXMLFormsRootLabel then begin
        node := AXMLDoc.DocumentElement;
        strXMLFirstLine:=GetStringLine(AXMLData,0);
        for i := 0 to node.ChildNodes.Count - 1 do begin
          node1 := node.ChildNodes.Nodes[i];
          if node1.NodeName = cFormXMLRootLabel then begin
            PrintDataXML(strXMLFirstLine+#13#10+node1.XML,AXMLDoc);
          end;
        end;
      end
      else
        MessageErr(Caption, Format(sMsgBadFormXMLDataFile, [AFileName]), [MBOK]);
      AXMLDoc.Active := FALSE;
    finally
      StopWait;
    end;
  end; {PrintMoreForm}

begin
  LoadAndSetReportSettings;
  //pokud vystupni soubor (PDF) existuje, tak smazeme
  if (ParamStr(4)<>'') and FileExists(ParamStr(4)) then
    DeleteFile(ParamStr(4));
  //
  if AnsiSameText(ExtractFileExt(AFileName), cDataDefaultExt) then begin
    PrintData(LoadStringFromFile(AFileName));
  end
  else if (ExtractFileExt(AFileName)= cXMLDefaultExt) or (ExtractFileExt(AFileName)= cFRMXDefaultExt) then begin
    pomStr:= LoadStringFromFile(AFileName);
    if IsXMLOneForm(pomStr,XMLDoc) then
      PrintDataXML(pomStr,XMLDoc)
    else
      PrintMoreForm(pomStr,XMLDoc);
  end;
  //
  Close;
end; {OpenAndPrintFile}

procedure TfaMain.ImportEPO(const AEpoFilepath: string; AClose: boolean);
begin
  {$IFNDEF STANDALONE}
  GEPOFilePath := AEpoFilepath;
  if FNewScripter then
    ScripterT_ExecuteSubRoutine(sScriptProcName_ElFillingImport)
  else
