    if mtContentKey.Value <> FLastContentKey then
      //osetreni blikani pri presunu mezi stranou a prvni sekci
      LoadPage;
    SetDesignButtons;
    ApplyFormCaption;
    UpdateMenuFormItems;
    FLastContentKey := mtContentKey.Value;  
  end;
end; {mtContentAfterScroll}

