//ulozi definici do souboru

procedure TfaMain.SaveDef;
var
  isDesignMode, mtValReadOnly: boolean;
begin
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('SaveDef: START, FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
  
  if FDefReadOnly then
    MessageWarn(Caption,
      'Nelze uložit definici, soubor je pouze pro čtení. Můžete uložit definici volbou Uložit jako.',
      [MBOK])
  else begin
    isDesignMode := FIsDesignMode;
    mtValReadOnly := mtValues.ReadOnly;
    FIsDesignMode := TRUE;
      //aby pri ukladani definice mimo design modenebyl problem s nastavovanim check boxu
    try
      if Designer.Active then
        Designer.Active := FALSE;
      //ulozit do souboru
      if FDefFileName = '' then begin
        with SaveDialog1 do begin
          DefaultExt := cDefDefaultExt;
          Filter := cDefOpenSaveFilter;
          if Execute then begin
            if not FileExists(FileName) or
              (MessageAsk(Caption,Format(sMsgFileNotExistsAsk, [FileName]),
              [MBYES, MBNO]) = IDYES) then begin
              //ulozit do souboru
              SaveDataDef(FileName);
              //ulozit pouzite jmeno
              FDefFileName := FileName;
              //nastavit tlacitko
              SetChangeFlag(FALSE);
            end;
          end;
        end;
      end
      else begin
        SaveDataDef(FDefFileName);
        
        {$IFDEF UCURSOR}
        // WriteBridgeDebug('SaveDef: PŘED SetChangeFlag(FALSE), FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
        {$ENDIF UCURSOR}
        
        SetChangeFlag(FALSE);
        
        {$IFDEF UCURSOR}
        // WriteBridgeDebug('SaveDef: PO SetChangeFlag(FALSE), FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
        {$ENDIF UCURSOR}
      end;
      //
      ApplyMainCaption(FDefFileName);
    finally
      FIsDesignMode := isDesignMode;
      mtValues.ReadOnly := mtValReadOnly;
    end;
  end;
  
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('SaveDef: END, FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
end; {SaveDef}

