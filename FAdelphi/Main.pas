//Ulozi text do souboru
//- pokud je AInsertIndex < 0, tak prida text na konec souboru, v opacnem pripade na urcenou pozici
procedure SaveToLog(const AFileName, AText: string; AInsertIndex: integer);
var
  sl: TStringList;
  logFileName: string;
begin
  sl:=TStringList.Create;
  logFileName := AFileName;
  try
    if FileExists(logFileName) then
      sl.LoadFromFile(logFileName);
    if AInsertIndex < 0 then
      sl.Add(AText)
    else if (AInsertIndex >= 0) and (AInsertIndex < sl.Count) then
      sl.Insert(AInsertIndex, AText)
    else
      sl.Insert(0, AText);
    //
    sl.SaveToFile(logFileName);
  finally
    sl.Free;
  end;
end;

function IsTextVzor(const AFileName: string): boolean;
begin
  Result := (SameText(Copy(AFileName, 1, 3), 'dx_') or SameText(Copy(AFileName, 1, 5), 'dxsk_')) and
            (Pos('_NST_', AFileName) = 0);
end;

procedure TfaMain.ConvertDefFileToTMS(const AFileName, ALogName: string);
var
  logFileName, scrErrFileName: string;
begin
  if ALogName <> '' then
    logFileName := ALogName
  else
    logFileName := NormalPath(ExtractFilePath(AFileName)) + Format('ConvertDef2TMS_%s.log',
                   [FormatDateTime('dd.mm.yyyy hh-nn-ss',Now)]);
  scrErrFileName := ChangeFileExt(logFileName, '_Err.txt');
  //SaveToLog(logFileName, StrPadRight('', 50, '%'), 0);
  //
  if (ExtractFileExt(AFileName)=cDefDefaultExt) and (not IsTextVzor(ExtractFileName(AFileName))) then
    ConvertDefToTMS(AFileName, logFileName, scrErrFileName, False);
end;

procedure TfaMain.ConvertDefsToTMS(const AConvertOnlyScript: boolean);
var
  opt: TOpenOptions;
  i: integer;
  logFileName, scrErrFileName, zn: string;
  sl: TStringList;
  cntTTMS, cntSSCR, cntS100, cntS099, cntSNOT, cntSERR: integer;
  cntTSCR, cntTERR, cntT100, cntT10E: integer;
  cntRERR, cntPERR: integer;
  exOk: boolean;
begin
  with OpenDialog1 do begin
    DefaultExt := cDefDefaultExt;
    Filter := cDefOpenSaveFilter;
    opt := Options;
    Options := [ofAllowMultiSelect];
    exOk := False;
    try
      if Execute then begin
        exOk := True;
        logFileName := NormalPath(ExtractFilePath(Files[0])) + Format('Convert%s2TMS_%s.log',
                       [Cond(AConvertOnlyScript, 'Scr', 'Def'), FormatDateTime('dd.mm.yyyy hh-nn-ss',Now)]);
        scrErrFileName := ChangeFileExt(logFileName, '_Err.txt');
        SaveToLog(logFileName, StrPadRight('', 50, '%'), 0);
        for i := 0 to Files.Count - 1 do
          if (ExtractFileExt(Files[i])=cDefDefaultExt) and (not IsTextVzor(ExtractFileName(Files[i]))) then
            ConvertDefToTMS(Files[i], logFileName, scrErrFileName, AConvertOnlyScript);
      end;
    finally
      Options := opt;
    end;
  end;
  if not exOk then
    Exit;
  //kvuli prehlednosti provedeme souctovani na zacatek logu
  sl := TStringList.Create;
  sl.LoadFromFile(logFileName);
  sl.Sort;
  sl.SaveToFile(logFileName);  
  cntTTMS:=0; cntSSCR:=0; cntS100:=0; cntS099:=0; cntSNOT:=0; cntSERR:=0;
  cntTSCR:=0; cntTERR:=0; cntT100:=0; cntT10E:=0;
  cntRERR:=0; cntPERR:=0;
  try
    for i := 0 to sl.Count - 1 do begin
      zn := Copy(sl[i],1,4);
      if zn = cTTMS then
        Inc(cntTTMS)
      else if zn = cTSCR then
        Inc(cntTSCR)
      else if zn = cTERR then
        Inc(cntTERR)
      else if zn = cT100 then
        Inc(cntT100)
      else if zn = cT10E then
        Inc(cntT10E)
      else if zn = cSSCR then
        Inc(cntSSCR)
      else if zn = cS100 then
        Inc(cntS100)
      else if zn = cS099 then
        Inc(cntS099)
      else if zn = cSNOT then
        Inc(cntSNOT)
      else if zn = cSERR then
        Inc(cntSERR)
      else if zn = cRERR then
        Inc(cntRERR)
      else if zn = cPERR then
        Inc(cntPERR);
    end;
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cTTMS, IntToStr(cntTTMS), cTTMSTxt]), 0);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cSSCR, IntToStr(cntSSCR), cSSCRTxt]), 1);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cTSCR, IntToStr(cntTSCR), cTSCRTxt]), 2);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cTERR, IntToStr(cntTERR), cTERRTxt]), 3);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cS100, IntToStr(cntS100), cS100Txt]), 4);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cT100, IntToStr(cntT100), cT100Txt]), 5);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cT10E, IntToStr(cntT10E), cT10ETxt]), 6);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cS099, IntToStr(cntS099), cS099Txt]), 7);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cSNOT, IntToStr(cntSNOT), cSNOTTxt]), 8);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cSERR, IntToStr(cntSERR), cSERRTxt]), 9);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cRERR, IntToStr(cntRERR), cRERRTxt]), 10);
    SaveToLog(logFileName, Format('%s: %s  (%s)', [cPERR, IntToStr(cntPERR), cPERRTxt]), 11);
    SaveToLog(logFileName, Format('%s: %s', ['Celkem', IntToStr(cntTTMS+cntTSCR+cntTERR+cntT100+cntT10E+cntSSCR+cntS100+cntS099+cntSNOT+cntSERR+cntRERR+cntPERR)]), 12);
  finally
    sl.Free;
  end;
  //
  MsgBoxInfo(Caption, Format('Převod %s byl dokončen, více informací v souboru %s.',
                       [Cond(AConvertOnlyScript, 'skriptů', 'definic'), ExtractFileName(logFileName)]), MB_OK);
end;

function TfaMain.ConvertFDEtoFDEX: string;
type
  TComponentInfo = record
    Name: string;
    ZPosition: Integer;
  end;
var
  i, cnt, w, h: integer;
  c: TControl;
  defID, s, cs, s1: string;
  sl1: TStringList;

  function ColorToHex(Color: TColor): string;
  var
    RGB: Longint;
  begin
    RGB := ColorToRGB(Color); // Převede na standardní RGB hodnotu
    Result := Format('#%2.2X%2.2X%2.2X', [GetRValue(RGB), GetGValue(RGB), GetBValue(RGB)]);
  end;

  function JSONEscape(const S: string): string;
  var
    i: Integer;
    c: Char;
  begin
    Result := '';  // Výstupní řetězec
    for i := 1 to Length(S) do
    begin
      c := S[i];
      case c of
        '"': Result := Result + '\"';   // Uvozovky
        '\': Result := Result + '\\';   // Zpětné lomítko
        #13: Result := Result + '\r';    // Carriage Return
        #10: Result := Result + '\n';    // Line Feed
        #9:  Result := Result + '\t';    // Tabulátor
      else
        Result := Result + c;  // Ostatní znaky ponecháme
      end;
    end;
    Result := UTF8Encode(Result);
  end;

  function MemTableToJSONmtDef(MemTable: TkbmMemTable): string;
  var
    i: Integer;
    s: string;
  begin
    if not MemTable.Active then
      raise Exception.Create('Tabulka není otevřená!');

    if MemTable.IsEmpty then
      raise Exception.Create('Tabulka neobsahuje žádné záznamy!');

    s := '{' + cCRLF;
    s := s + '"Table": "' + 'FormDef' + '",' + cCRLF;

    // Přesun na první (a jediný) záznam
    MemTable.First;

    // Přidání jednotlivých polí do JSON objektu
    for i := 0 to MemTable.FieldCount - 1 do
    if (MemTable.Fields[i].FieldName <> 'CompiledScript') and
      (MemTable.Fields[i].FieldName <> 'Script') and
      (MemTable.Fields[i].FieldName <> 'Instructions') and
      (MemTable.Fields[i].FieldName <> 'ReportScript') then
      begin
        s := s + '"' + JSONEscape(MemTable.Fields[i].FieldName) + '": ';

        if (MemTable.Fields[i].FieldName = 'BkColor') then
            s := s + '"' + ColorToHex(StrToColor(MemTable.Fields[i].AsString)) + '"'
        else
        // Zpracování hodnoty pole podle datového typu
          case MemTable.Fields[i].DataType of
            ftString, ftMemo, ftWideString:
              s := s + '"' + JSONEscape(MemTable.Fields[i].AsString) + '"';
            ftInteger, ftSmallint, ftWord, ftAutoInc:
              s := s + IntToStr(MemTable.Fields[i].AsInteger);
            ftFloat, ftCurrency:
              s := s + FloatToStr(MemTable.Fields[i].AsFloat);
            ftBoolean:
              s := s + LowerCase(BoolToStr(MemTable.Fields[i].AsBoolean, True));
            else
              s := s + 'null';  // Neznámé typy nastavíme na null
          end;

        // Přidání čárky mezi hodnotami, ale ne za posledním polem
        if i < MemTable.FieldCount - 1 then
          s := s + ',';

        s := s + cCRLF;
      end;

    s := s + '}';  // Uzavření JSON objektu
    Result := s;
  end;

  function MemTableToJSONRowsMtContent(MemTable: TkbmMemTable): string;
  var
    i: Integer;
    s: string;
  begin
    if not MemTable.Active then
      raise Exception.Create('Tabulka není otevřená!');

    s := '{' + cCRLF + '"Table": "' + 'Content' + '",' + cCRLF +
    '"Records": [' + cCRLF;

    MemTable.First;
    while not MemTable.Eof do
    begin
      s := s + '{';

      // Přidání všech polí do JSON objektu
      for i := 0 to MemTable.FieldCount - 1 do
      if (MemTable.Fields[i].FieldName <> 'SectionForm') then
      begin
        s := s + '"' + JSONEscape(MemTable.Fields[i].FieldName) + '": ';

        // Zpracování hodnoty pole
        case MemTable.Fields[i].DataType of
          ftString, ftMemo, ftWideString:
            s := s + '"' + JSONEscape(MemTable.Fields[i].AsString) + '"';
          ftInteger, ftSmallint, ftWord, ftAutoInc:
            s := s + IntToStr(MemTable.Fields[i].AsInteger);
          ftFloat, ftCurrency:
            s := s + FloatToStr(MemTable.Fields[i].AsFloat);
          ftBoolean:
            s := s + LowerCase(BoolToStr(MemTable.Fields[i].AsBoolean, True));
          else
            s := s + 'null';  // Neznámé typy necháme jako null
        end;

        // Přidání čárky mezi hodnotami, ale ne za posledním polem
        if i < MemTable.FieldCount - 1 then
          s := s + ', ';

        s := s + cCRLF;
      end;

      s := s + '}' + cCRLF;

      // Přidání čárky mezi záznamy, ale ne za posledním
      MemTable.Next;
      if not MemTable.Eof then
        s := s + ', ';

      s := s + cCRLF;

    end;

    s := s + ']}';  // Uzavření JSON objektu
    Result := s;
  end;

  function FontStyleToString(Styles: TFontStyles): string;
  const
    StyleNames: array[TFontStyle] of string = ('Bold', 'Italic', 'Underline', 'StrikeOut');
  var
    Style: TFontStyle;
    ResultList: TStringList;
  begin
    ResultList := TStringList.Create;
    try
      for Style := Low(TFontStyle) to High(TFontStyle) do
        if Style in Styles then
          ResultList.Add(StyleNames[Style]);

      Result := ResultList.CommaText;  // Spojí seznam do jednoho řetězce
    finally
      ResultList.Free;
    end;
  end;

