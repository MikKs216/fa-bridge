procedure TfaMain.DoEditForm(AClientID: integer; AID: integer;
  AStreamForm: TMemoryStream; const AClientParams,
  ADatabaseCaption, AComment: string;
  AReadOnlyLan: boolean; AStoredStrings: TMemoryStream; const AFillMemo: string;
  ANewForm: boolean;
  const AReportVariants: string);
var
  sl: TstringList;
  lObj: TWinObj;
  changeFlg: boolean;
  i: integer;
{$IFNDEF STANDALONE}
  loadingStartTime, loadingFinishTime: TDateTime;
{$ENDIF STANDALONE}

begin
  gFormOpening:=True;
  sl := TstringList.Create;
  try
    loadingStartTime := now;
    {SaveStringToFile(AClientParams,ExtractFilePath(Application.ExeName)+
      cFormAsistentExeName+cClientParDefaultExt);}
    FFillMemo := AFillMemo;
    FDatabaseIDForm := AID;
    FDatabaseCaption := ADatabaseCaption;
    FClientID := AClientID;
    FStartTime := now;
    FReportVariants := AReportVariants;
    AStreamForm.Seek(0, soFromBeginning);
    sl.LoadFromStream(AStreamForm);
    SetProgressPos(10);
    if OpenFileDataString(sl.Text) then begin
      mtTskp.Edit;
      mtTskpID.Value := AID;
      {if AComment <> mtTskpComment.Value then
        mtTskpComment.Value := AComment;} // toto tady nemuze byt, v AComment je jen prvni radek, takze se ztrati zbytek
      mtTskp.Post;
      FDataFileName := '';
      FClientParam.Text := AClientParams;
      ApplyMainCaption(mtDefName.Value);
      ShowWarningPovinneEPO;
      LoadParamsFromClientParams;
      FStateFormReadOnlyLAN := AReadOnlyLan;
      if AReadOnlyLan then begin
        FStateFormLocked := TRUE;
        SetReadOnly(TRUE);
      end;
      FLastModifiedTime := mtTskpModifiedTime.Value;
      InitModifiedTime;
      FocusFirstControl;
      FFileOpened := TRUE;
      if (AStoredStrings.Size > 0) and not FNestedPrepareReportState then begin
        try
          mtStoredStrings.LoadFromStream(AStoredStrings);
        except
          mtStoredStrings.Close;
          mtStoredStrings.EmptyTable;
          mtStoredStrings.Open;
        end;
      end
      else begin
        mtStoredStrings.Close;
        mtStoredStrings.EmptyTable;
        mtStoredStrings.Open;
      end;
      //vytvoreni ikony v outlookbaru
      lObj := TWinObj.Create;
      lObj.Window := self;
      lObj.WindowIcon := 1;
      lObj.WindowText := FDatabaseCaption;
      lObj.WindowIconText := Copy(FDatabaseCaption, 1, Max(1,
        Pos(' ', FDatabaseCaption)));
      dmGlobObj.gFAllWindow.AddObj(lObj);
      Application.MainForm.Perform(Msg_UpdateListWindow, 1, 0);
      FSaveHistoryToDB := FALSE;
      SetChangeFlag(ANewForm);
      DoOnOpen;
      changeFlg := GetChangeFlag;
      DoEnable;
      SetChangeFlag(changeFlg);
      DisplayCheck; //po otevreni
      DoOnActivate; // musi se volat i tady, protoze pri otevitani z klientu se vykona AfterOpen ve FA kdyz je jeste prazdny bez dat formulare
    end;
  finally
    sl.Free;
    {$IFNDEF STANDALONE}
    loadingFinishTime := now;
    dmGlobObj.FrmTimesAdd(loadingFinishTime-loadingStartTime);
    {$ENDIF STANDALONE}
    gFormOpening:=False;
  end;
end; {DoEditForm}

procedure TfaMain.SaveFormToDatabase(AAddHistory: boolean);
var
  st, stSS: TMemoryStream;
  sl: TstringList;
  comment, commentAll, period, s, dt, charact, formData, txtDocName: string;
  periodFrom, periodTo: TDateTime;
  periodYear, i: integer;
begin
  if FStateFormWasChanged then
    DoBeforeSave;
  st := TMemoryStream.Create;
  stSS := TMemoryStream.Create;
  sl := TstringList.Create;
  try
    StopModifiedTime;
    SetTskpInfo;
    //
    reComment.SaveTextToStream('', st, 0, FALSE, FALSE);
    st.Seek(0, soFromBeginning);
    sl.LoadFromStream(st);
    comment := '';
    if sl.Count > 0 then begin
      for i := 0 to sl.Count - 1 do
      if Trim(sl[i])<>'' then begin
        comment := Trim(sl[i]);
        Break;
      end;
    end;
    commentAll := sl.Text;
    charact := GetCharacteristics;
    sl.Clear;
    st.Clear;
    //
    sl.Text := GetFormData;
    sl.SaveToStream(st);
    st.Seek(0, soFromBeginning);
    //StoredStrings
    mtStoredStrings.SaveToStream(stSS);
    stSS.Seek(0, soFromBeginning);
    //
    s := GetPeriod;
    periodYear := StrToIntSafe(GetListItem(s, 0));
    periodFrom := StrToDateSafe(GetListItem(s, 1));
    periodTo := StrToDateSafe(GetListItem(s, 2));
    period := GetListItem(s, 3);
    //
    if Pos(' ',mtTskpFillingDate.Value)>0 then
      dt:=Copy(mtTskpFillingDate.Value,1,Pos(' ',mtTskpFillingDate.Value)-1)
    else
      dt:=mtTskpFillingDate.Value;

    if mtDefID.Value = cDefIDTextDocument then begin
      formData := GetFormData;
      txtDocName := GetFormField(formData,'NAZEV');
    end;

    SaveFormToDB(FDatabaseIDForm, st, FStateFormLocked, StrToDateSafe(mtTskpExpirationDate.Value),
      comment, commentAll, GetSysComment, charact, period,
      mtTskpFillingNumber.AsString,StrToDateSafe(dt),
      periodFrom, periodTo, periodYear,
      mtTskpModifiedTime.Value - FLastModifiedTime,
      SecondsBetween(now, FStartTime), stSS, mtDefID.Value, txtDocName,
      mtTskpWorkState.AsInteger,
      AAddHistory);
    SetChangeFlag(FALSE);
  finally
    st.Free;
    stSS.Free;
    sl.Free;
  end;
end; {SaveFormToDatabase}

