//zjisti jestli existuje formular v databazi podle guidu nebo ve standalone podle cety na disku
function TfaMain.FormExists(const AFormName: string): boolean;
var
  sl: TStringList;
  st: TMemoryStream;
begin
  if AFormName='' then begin
    Result:=false;
    Exit;
  end;
  {$IFDEF STANDALONE}
  //Result:=FileExists(AFormName);  // nefungovalo pro slavestate
  Result := GetFormDataText(AFormName)<>'';
  {$ELSE STANDALONE}
  sl := TStringList.Create;
  st := TMemoryStream.Create;
  try
    Result:=GetFormFromDB(FClientID, AFormName, st)
  finally
    sl.Free;
    st.Free;
  end;
  {$ENDIF STANDALONE}
end; {FormExists}

//vraci data zadaneho formulare. Kdyz je AFormName prazdne, tak data vlastniho formulare
function TfaMain.GetFormDataText(const AFormName: string): string;
var
  sl: TStringList;
  st: TMemoryStream;
  fn: string;
begin
  if AFormName='' then
    Result:=GetFormData
  else begin
    Result := '';
  {$IFDEF STANDALONE}
    sl := TStringList.Create;
    st := TMemoryStream.Create;
    try
      if FSlaveState <> ssNone then begin
        if IsInteger(AFormName) then begin
          if GetFormFromTskps(StrToInt(AFormName), st) then begin
            st.Seek(0, soFromBeginning);
            sl.LoadFromStream(st);
            Result := sl.Text;
          end;
        end;
      end
      else begin
        fn:=StrTrimCharRight(AFormName,'"');
        fn:=StrTrimCharLeft(fn,'"');
        if FileExists(fn) then begin
          sl.LoadFromFile(fn);
          Result := sl.Text;
        end
        else
          Result := '';
      end;
    finally
      sl.Free;
      st.Free;
    end;
  {$ELSE STANDALONE}
    sl := TStringList.Create;
    st := TMemoryStream.Create;
    try
      if GetFormFromDB(FClientID, AFormName, st) then begin
        st.Seek(0, soFromBeginning);
        sl.LoadFromStream(st);
        Result := sl.Text;
      end;
      {else if IsInteger(AFormName) and // do dalsiho roku zrusit
        GetFormFromDB(StrToInt(AFormName), st) then begin
        st.Seek(0, soFromBeginning);
        sl.LoadFromStream(st);
        Result := sl.Text;
      end;}
    finally
      sl.Free;
      st.Free;
    end;
  {$ENDIF STANDALONE}
  end;
end; {GetFormDataText}

