const
  sMsgFillingStateNone = 'Neodesláno';
  sMsgFillingStateSent = 'Odesláno, ale nezjištěn stav';
  sMsgFillingStateErr = 'Odesláno, ale nepřijato z důvodu chyb';
  sMsgFillingStateFilled = 'Podáno';
  sMsgFillingStateFilledOffline = 'Podáno v režimu off-line';

procedure TfaMain.mtTskpCalcFields(DataSet: TDataSet);
begin
  if mtTskpFillingState.Value = cFillingStateNone then
    mtTskpcFillingStateCaption.Value:=sMsgFillingStateNone
  else if mtTskpFillingState.Value = cFillingStateSent then
    mtTskpcFillingStateCaption.Value:=sMsgFillingStateSent
  else if mtTskpFillingState.Value = cFillingStateError then
    mtTskpcFillingStateCaption.Value:=sMsgFillingStateErr
  else if mtTskpFillingState.Value = cFillingStateFilled then
    mtTskpcFillingStateCaption.Value:=sMsgFillingStateFilled
  else if mtTskpFillingState.Value = cFillingStateFilledOffline then
    mtTskpcFillingStateCaption.Value:=sMsgFillingStateFilledOffline
  else
    mtTskpcFillingStateCaption.Clear;
end;

{$IFNDEF STANDALONE}
procedure TfaMain.SetComponentStyleFA;
var
  i: integer;
  c: TComponent;
  useFtStyle: boolean;
  skinName: string;
  newStyle: boolean;
begin
  StartWait;
  try try
    if (Application.MainForm as IMainWindow <> nil) then
      skinName := (Application.MainForm as IMainWindow).SkinName;

    newStyle := skinName<>oldStyleName;

    if gMtParam<>nil then
      useFtStyle := gMtParam.FieldByName('UsedNativeStyle').AsBoolean
    else
      useFtStyle := FALSE;

    for i := 0 to ComponentCount - 1 do begin
      c := Components[i];

      if c is TcxCheckBox then begin
        TcxCheckBox(c).Transparent := true;
        if newStyle then begin
          TcxCheckBox(c).Style.LookAndFeel.Kind:=lfUltraFlat;
          TcxCheckBox(c).Style.LookAndFeel.NativeStyle:=False;
        end
        else begin
          TcxCheckBox(c).Style.LookAndFeel.Kind:=lfOffice11;
          TcxCheckBox(c).Style.LookAndFeel.NativeStyle:=true;
        end;
      end
      else if c is TdxRibbon then begin
        if newStyle then
          TdxRibbon(c).ColorSchemeName:=skinName
        else
          TdxRibbon(c).ColorSchemeName:=defaultOldSkinName;
      end
      else if c is TdxBarManager then begin
        if newStyle then
          TdxBarManager(c).Style:=bmsUseLookAndFeel
        else
          TdxBarManager(c).Style:=bmsOffice11;
      end;

      if c is TShape then begin
        if useFtStyle then begin
          TShape(c).Pen.Color:=clBtnShadow;
        end
        else begin
          TShape(c).Pen.Color:=clHighlight;
        end;
      end;

      // odstrani rámečky sekcí
      if c is TShape then begin
        if c<>ClientBorder then
          TShape(c).Visible := not newStyle;
      end;

    end;
  except //kvuli moznym problemum, treba pokud nejsou k dispozici parametry
  end;
  finally
    StopWait;
  end;
end;
{$ENDIF STANDALONE}

//zapise soubor PDF do archivu dokumentu ve FS
procedure TfaMain.WritePdfToDocs(const AName, AFileName: string;
  APodani: boolean; const ACommentMemo: string = '';
  ADoDatoveSchranky: boolean = FALSE);
var
  stateValue, slozka, typSlozky: string;
begin
  {$IFNDEF STANDALONE}
  if APodani then begin
    if ADoDatoveSchranky then
      stateValue:=sResValueOfStateDocOdeslano
    else
      stateValue:=sResValueOfStateDocPodano;
    if ExtractFileExt(AFileName)=cXMLDefaultExt then begin
      slozka:=cDocumentFolderSentEP;
      typSlozky:=cTypeFolderSentEP;
    end
    else begin
      slozka:=cDocumentFolderSentEPPot;
      typSlozky:=cTypeFolderSentEPPot;
    end;
    if FParamSave2DocElPodani then
      WriteDoc2Adr(FClientID,ExtractFileName(AFileName),'',ACommentMemo,'','',
        date,stateValue,'',FALSE,AName,AFileName,GetFormID,mtDefName.Value,
        '','',0,slozka,typSlozky);
  end
  else begin
    stateValue:=sResValueOfStateDocOdeslano;
    if ADoDatoveSchranky then begin
      slozka:=cDocumentFolderSentMessage;
      typSlozky:=cTypeFolderSentDS;
      if FParamSave2DocPodani and not FParamSave2DocPodaniPril then
        WriteDoc2Adr(FClientID,ExtractFileName(AFileName),'',ACommentMemo,'','',
          date,stateValue,'',FALSE,AName,AFileName,GetFormID,mtDefName.Value,
          '','',0,slozka,typSlozky);
    end
    else begin
      slozka:=cDocumentFolderSentMail;
      typSlozky:=cTypeFolderSentMail;
      if FParamSave2DocPodani then
        WriteDoc2Adr(FClientID,ExtractFileName(AFileName),'',ACommentMemo,'','',
          date,stateValue,'',FALSE,AName,AFileName,GetFormID,mtDefName.Value,
          '','',0,slozka,typSlozky);
    end;
  end;
  {$ENDIF STANDALONE}
end;

procedure TfaMain.dxBarSetExpirationDateClick(Sender: TObject);
var
  dateString, mailadr, strValue: string;
  dat: TDateTime;
begin
  if mtTskp.Active then begin
    if mtTskpExpirationDate.AsString<>'' then begin
      MessageInfo(Caption, sMsgExpirationDateInfoDelete, [MBOK]);
      dat := StrToDateSafe(mtTskpExpirationDate.Value);
    end
    else
      dat := date + 365;

    dateString := OpenCalendar(DateToStr(dat),paLeft.Left+5,Top+30);
    if dateString<>'' then begin
      if MessageAsk(Caption, Format(sMsgExpirationDateWasSetAsk,[dateString]),
        [MBYES, MBNO]) = IDYES then begin
        mtTskp.Edit;
        try
          mtTskpExpirationDate.Value:=dateString;
        finally
          mtTskp.Post;
          SetChangeFlag(TRUE);
        end;
      end
      else
        MessageInfo(Caption, sMsgExpirationDateWasNotSet, [MBOK])
    end
    else begin
      if mtTskpExpirationDate.Value='' then
        MessageInfo(Caption, sMsgExpirationDateWasNotSet, [MBOK])
      else begin
        if MessageAsk(Caption, Format(sMsgExpirationDateWasNotSetAsk,
          [mtTskpExpirationDate.Value]), [MBYES, MBNO]) = IDYES then begin
          mtTskp.Edit;
          try
            mtTskpExpirationDate.Value:='';
          finally
            mtTskp.Post;
            SetChangeFlag(TRUE);
          end;
        end;
      end;
    end;
  end
  else
    MessageWarn(Caption, sMsgExpirationDateCannotSet, [MBOK]);
end;

procedure TfaMain.dxBarSetFillingDateClick(Sender: TObject);
var
  dateString, mailadr, strValue: string;
begin
  if mtTskp.Active then begin
    if mtTskpFillingPassword.Value<>'' then begin
      if MessageWarn(Caption, sMsgFillingDateAskRewrite,
        [MBYES, MBNO]) = IDNO then
        EXIT;
    end;

    if mtTskpFillingDate.AsString<>'' then
      MessageInfo(Caption, sMsgFillingDateInfoDelete, [MBOK]);

    if (GetKeyState(VK_CONTROL) < 0) or (GetKeyState(VK_SHIFT) < 0) then begin
      if AskStr(Caption,sMsgFillingDateTimeCaption,strValue)=MROK then begin
        dateString := strValue;
      end;
    end
    else
      dateString := OpenCalendar(DateToStr(date),Left+5,Top+30);
    if dateString<>'' then begin
      if MessageAsk(Caption, Format(sMsgFillingDateWasSetAsk,[dateString]),
        [MBYES, MBNO]) = IDYES then begin
        mtTskp.Edit;
        try
          mtTskpFillingDate.Value:=dateString;
          mtTskpFillingNumber.Value:='';
          mtTskpFillingPassword.Value:='';
          mtTskpFillingURL.Value:='';
          mtTskpFillingState.Clear;
          mtTskpFillingTimeStampDate.Value:='';
          mtTskpFillingTimeStampSignature.Value:='';
        finally
          mtTskp.Post;
          SetChangeFlag(TRUE);
        end;
        {$IFNDEF STANDALONE}
        if FParamSave2DocElPodani then begin
          if mtDef.Active and (MessageAsk(Caption, Format(sMsgFillingDateWasSetAskWriteDoc,[dateString]),
            [MBYES, MBNO]) = IDYES) then begin
            mailadr := '@';
            SendFormViaEmail(NormalPath(ExtractFilePath(FDefFileName)) +
              mtDefID.Value + cReportDefaultExt,
              ApplyAllPages(ApplyRestrictReportOptions(
              LoadReportSettings(GetIniFileName))),mailadr,TRUE);
          end;
        end;
        {$ENDIF STANDALONE}
      end
      else
        MessageInfo(Caption, sMsgFillingDateWasNotSet, [MBOK])
    end
    else begin
      if mtTskpFillingDate.Value='' then
        MessageInfo(Caption, sMsgFillingDateWasNotSet, [MBOK])
      else begin
        if MessageAsk(Caption, Format(sMsgFillingDateWasNotSetAsk,
          [mtTskpFillingDate.Value]), [MBYES, MBNO]) = IDYES then begin
          mtTskp.Edit;
          try
            mtTskpFillingDate.Value:='';
            mtTskpFillingNumber.Value:='';
            mtTskpFillingPassword.Value:='';
            mtTskpFillingURL.Value:='';
            mtTskpFillingState.Clear;
            mtTskpFillingTimeStampDate.Value:='';
            mtTskpFillingTimeStampSignature.Value:='';
          finally
            mtTskp.Post;
            SetChangeFlag(TRUE);
          end;
        end;
      end;
    end;
  end
  else
    MessageWarn(Caption, sMsgFillingDateCannotSet, [MBOK]);
end;

procedure TfaMain.dxBarSetWorkStateClick(Sender: TObject);
var
  stv,mr: Integer;
begin
  if mtTskp.Active then begin
    stv:=mtTskpWorkState.AsInteger;
    if (stv<0)or(stv>100) then
      stv:=0;
    repeat
      mr:=AskInt(Caption,sMsgWorkStateSetAsk,stv);
      if (mr=mrOk)and((stv<0)or(stv>100)) then
        MessageInfo(Caption, sMsgWorkStateIsNotOK, [MBOK])
    until (mr<>mrOK)or((stv>=0)and(stv<=100));
    if mr = mrOk then begin
        mtTskp.Edit;
        try
          mtTskpWorkState.Value:=stv;
        finally
          mtTskp.Post;
          SetChangeFlag(TRUE);
        end;
      end
      else
        MessageInfo(Caption, sMsgWorkStateWasNotSet, [MBOK])
    end;
end;

procedure TfaMain.dxBarSaveAsPDFClick(Sender: TObject);
var
  st: TMemoryStream;
  resol: Integer;
begin
  with SaveDialog1 do begin
    DefaultExt := cPDFDefaultExt;
    Filter := cPDFOpenSaveFilter;
    if Execute then begin
      if not FileExists(FileName) or
        (MessageAsk(Caption,Format(sMsgFileNotExistsAsk, [FileName]),
        [MBYES, MBNO]) = IDYES) then begin
        //ulozit do souboru
        StartWait;
        try
          st := TMemoryStream.Create;
          try
            reNotes.RichViewEdit.SaveRVFToStream(st, FALSE);
            st.Seek(0, soFromBeginning);
            RVReportHelper.RichView.LoadRVFFromStream(st);
          finally
            st.Free;
          end;
          resol:=GetDPIForPDFrender;
          gtPDFEngine.InputXRes:=resol;
          gtPDFEngine.InputYRes:=resol;
          gtPDFEngine.Page.LeftMargin:=reNotes.PageProperty.LeftMargin*10;
          gtPDFEngine.Page.RightMargin:=reNotes.PageProperty.RightMargin*10;
          gtPDFEngine.Page.TopMargin:=reNotes.PageProperty.TopMargin*10;
          gtPDFEngine.Page.BottomMargin:=reNotes.PageProperty.BottomMargin*10;
          gtPDFEngine.FileName := FileName;
          gtRichViewInterface.RenderDocument(RVReportHelper);
        finally
          StopWait;
        end;
      end;
    end;
  end;
end;

function TfaMain.CreateAppendixToPDF: string;
var
  st: TMemoryStream;
  fldName, rtfString, rtfFileName: string;
  resol: Integer;
begin
  StartWait;
  Result:='';
  try
    if ActiveControl=reNotes then begin //musime opustit RichEdit aby se ulozil obsah do databaze
      if cxTvContent.CanFocus then
        cxTvContent.SetFocus
      else if cxContent.CanFocus then
        cxContent.SetFocus;
    end;
    if mtTskpAppendix.Value<>'' then begin
      st := TMemoryStream.Create;
      fldName:=reNotes.DataField;
      try
        reNotes.DataField := mtTskpAppendix.FieldName;
        reNotes.RichViewEdit.SaveRVFToStream(st, FALSE);
        st.Seek(0, soFromBeginning);
        RVReportHelper.RichView.LoadRVFFromStream(st);
      finally
        reNotes.DataField := fldName;
        st.Free;
      end;
      // nastaveni rozliseni
      resol:=GetDPIForPDFrender;
      gtPDFEngine.InputXRes:=resol;
      gtPDFEngine.InputYRes:=resol;
      gtPDFEngine.Page.LeftMargin:=reNotes.PageProperty.LeftMargin*10;
      gtPDFEngine.Page.RightMargin:=reNotes.PageProperty.RightMargin*10;
      gtPDFEngine.Page.TopMargin:=reNotes.PageProperty.TopMargin*10;
      gtPDFEngine.Page.BottomMargin:=reNotes.PageProperty.BottomMargin*10;
      Result := FindUnusedFileName(GetWorkPath+'AppTemp','Pdf','File');
      gtPDFEngine.FileName := Result;
      gtRichViewInterface.RenderDocument(RVReportHelper);
      RVReportHelper.Clear;
    end;
  finally
    StopWait;
  end;
end;

