 SaveData
   Ulozi data formulare do souboru se jmenem AFileName
 -----------------------------------------------------------------------------}

procedure TfaMain.SaveData(const AFileName: string);
var
  sl: TStringList;
begin
  DoBeforeSave;
  sl := TStringList.Create;
  try
    StopModifiedTime;
    SetTskpInfo;
    if ExtractFileExt(AFileName)=cFRMXDefaultExt then
      SaveDataFRMX(AFileName)
    else begin
      sl.Text := GetFormData;
      sl.SaveToFile(AFileName);
    end;
    SetChangeFlag(FALSE);
{$IFDEF STANDALONE}
    if (FSlaveState <> ssNone) and not FNestedState then
      FSlaveWasSaved := TRUE;
{$ENDIF STANDALONE}
  finally
    sl.Free;
  end;
end; {SaveData}

