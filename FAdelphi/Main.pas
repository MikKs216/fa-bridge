procedure TfaMain.DoCheck(AShowDifs: boolean); //parametr se zatim nepouziva
var
  differentDefVal: boolean;
  strDefaultValue, strActualValue, fldName: string;
  iniFile: TMemIniFile;
  changeFlag: Boolean;
begin
//  if FIsDesignMode or FIsChangingScript then
//    EXIT;
  //
  StartWait;
  if IsShowCheck then
    mtChecking.DisableControls;
  changeFlag := GetChangeFlag;
  try
    if not mtChecking.Active then  
      mtChecking.Open;
    mtChecking.EmptyTable;
    FScriptState := ssCheck;
    try
      if FNewScripter then
        ScripterT_ExecuteSubRoutine(sScriptProcName_Check)
      else
        Scripter.CallNoParamsMethod(sScriptProcName_Check);
    finally
      FScriptState := ssNoActive;
    end;
    // kontroly rozdilu oproti defvalue
    iniFile := TMemIniFile.Create(GetIniFileName);
    try
      {iniFile.WriteBool(cIniMtParam, cIniOpenCheckWithDif, AShowDifs);
      SaveMemIni(iniFile);}
      if {AShowDifs} iniFile.ReadBool(cIniMtParam, cIniOpenCheckWithDif, FALSE) then begin
        if not mtChecking.Active then
          mtChecking.Open;
        //
        if FStateFormWasChanged then begin
          DoCalculate;
          TryPostMtValues;
        end;
        //
        mtFields.First;
        while not mtFields.EOF do begin
          if mtFieldsHasDefault.Value then begin
            fldName:=mtFieldsName.Value;
            differentDefVal := GetFieldDefaultDifference(mtFieldsName.Value,
              strDefaultValue, strActualValue);
            if differentDefVal then begin
              mtChecking.Append;
              mtCheckingFieldName.Value := fldName;
              mtCheckingMessage.Value :=
                Format(sMsgDiferentDefVal,[strActualValue,strDefaultValue,
                mtCheckingFieldName.Value]);
              mtCheckingKind.Value := 3;
              mtChecking.Post;
            end;
          end;
          mtFields.Next;
        end;
      end;
    finally
      iniFile.Free;
    end;
    mtChecking.First;
  finally
    SetChangeFlag(changeFlag);
    mtChecking.EnableControls;
    StopWait;
  end;
end; {DoCheck}

//provede DoCheck pro zobrazeni v tabulce na formulari
procedure TfaMain.DisplayCheck(AForceDoCheck: boolean = false);
var
  t1, t2: TDateTime;
  aPoint: TPoint;
begin
  if IsShowCheck then begin
    if FLiveCheck or AForceDoCheck then begin
      t1:=Now;
      DoCheck(False);
      t2:=Now;
      if (t2-t1>cTimeOutLiveCheck) then begin //pokud trva vic nez pul vteriny tak vypneme zive kontrooly a zobrazime informaci
        SetLiveCheck(False);
      end;
      //ShowMessage(FloatToStr(t2-t1));
    end;
  end;
end;

