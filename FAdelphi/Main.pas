  function BitmapToBase64(Bitmap: TBitmap): string;
  var
    MemoryStream: TMemoryStream;
    Base64Stream: TStringStream;
  begin
    MemoryStream := TMemoryStream.Create;
    Base64Stream := TStringStream.Create('');
    try
      Bitmap.SaveToStream(MemoryStream);
      MemoryStream.Position := 0;

      EncodeStream(MemoryStream, Base64Stream);
      Result := Base64Stream.DataString;
    finally
      MemoryStream.Free;
      Base64Stream.Free;
    end;
  end;

  function ReplaceColor(const bmp: TBitmap; newColor: TColor): TBitmap;
  var
    x, y: Integer;
    targetColor: TColor;
  begin
    // Vytvoření kopie původního obrázku
    Result := TBitmap.Create;
    Result.Assign(bmp);

    // Získání barvy levého horního rohu
    targetColor := bmp.Canvas.Pixels[0, 0];

    // Procházení pixelů a nahrazení odpovídající barvy
    for x := 0 to bmp.Width - 1 do
    begin
      for y := 0 to bmp.Height - 1 do
      begin
        if Result.Canvas.Pixels[x, y] = targetColor then
          Result.Canvas.Pixels[x, y] := newColor;
      end;
    end;
  end;

  procedure CopyFDR(const BaseID: string);
  var
    SR: TSearchRec;
    SourcePath, DestPath, SourceFile, FileName: string;
  begin
    SourcePath := NormalPath(GetExePath) + 'DataPrg\Defs\';
    DestPath := NormalPath(GetExePath) + 'Export\';

    // Hledání souborů: BaseID.fdr nebo BaseID_*.fdr
    if FindFirst(SourcePath + '*.fdr', faAnyFile, SR) = 0 then
    try
      repeat
        FileName := SR.Name;
        // Kontrola, zda název odpovídá kritériím
        if (FileName = BaseID + '.fdr') or
           (Copy(FileName, 1, Length(BaseID) + 1) = BaseID + '_') then
        begin
          SourceFile := SourcePath + FileName;
          CopyFile(PChar(SourceFile), PChar(DestPath + FileName), False);
        end;
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  end;

