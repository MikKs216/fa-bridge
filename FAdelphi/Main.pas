procedure TfaMain.dxBarButtonFillingDSClick(Sender: TObject);
var
  wasLocked, wasChanged, ok: boolean;
  fillingDsResult, predmet, prilohy: string;
begin
  LogStat('e1');
  ok:=false;
  //Pokud uz byl formular podany tak dame dotaz
  if  mtTskpFillingTimeStampSignature.Value <> '' then begin
    if MessageAsk(Caption, 'Formulář byl již elektronicky podán. Chcete jej podat znovu?', [MBYES, MBNO]) = IDNO then
      EXIT;
  end;

  //Pokud je formular zamknuty tak dame dotaz
  if FStateFormLocked then begin
    if MessageAsk(Caption, sMsgFormLockedBeforeEP, [MBYES, MBNO]) = IDNO then
      EXIT;
  end;

  wasLocked:=FStateFormLocked;
  SetLockFlag(FALSE);
  try
    fillingDsResult := GetFillingDS;
    if (fillingDsResult<>'') and (FileExists(fillingDsResult)) then begin // pripraveny soubor pro podani pres DS (napr. PDFform pro VZP) - GetFillingDS vratila cestu k vytvorenemu souboru
      predmet := GetPredmetForDSEPO;
      prilohy := GetPrilohyForDSEPO;
      if SendFileViaDS(fillingDsResult,mtDefName.AsString,prilohy,predmet) then begin
        mtTskp.Edit;
        mtTskpFillingTimeStampSignature.Value:=cDSfilled+':'+gLastSentIDDS;
        mtTskpFillingDate.Value:=gLastSentDateDS;
        mtTskp.Post;
        SaveFormWithoutCheck;
        ok:=true;
        //MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání a formulář byl uložen.',MB_OK);
        ShowHintSb('Byly zapsány informace o podání a formulář byl uložen.');
      end;
    end
    else if HasFormFillingViaDS then begin // pouze existuje funkce GetFillingDS (nic nevraci)
      predmet := GetPredmetForDSEPO;
      prilohy := GetPrilohyForDSEPO;
      if ControlAndSendForm(True, prilohy, predmet) then begin
        mtTskp.Edit;
        mtTskpFillingTimeStampSignature.Value:=cDSfilled+':'+gLastSentIDDS;
        mtTskpFillingDate.Value:=gLastSentDateDS;
        mtTskp.Post;
        SaveFormWithoutCheck;
        ok:=true;
        //MsgBoxInfo(Caption,'Do formuláře byly zapsány informace o podání a formulář byl uložen.',MB_OK);
        ShowHintSb('Byly zapsány informace o podání a formulář byl uložen.');
      end;
    end
    else // jinak volame normalni EPO pres DS
      ok:=SendFillingDS;
  finally
    if ok and (wasLocked or GfaMain.FDoLockFormAfterFilling) then begin
      wasChanged := FStateFormWasChanged;
      SetLockFlag(true);
      SetChangeFlag(wasChanged);
    end;
  end;
end;

