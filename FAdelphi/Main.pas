 SetFormData
   Naplni kompletni data formulare (hodnoty mtTskp a mtValues)
 -----------------------------------------------------------------------------}

procedure TfaMain.SetFormData(const AData: string);
var
  dFldsC, dFldsE: string;
begin
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('SetFormData: START, FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
  
  SetTskpData(AData);
  FIsLoadingData := TRUE; //zakaz calculate
  try
    SetValuesData(AData);
    SetUserSettings(AData);
  finally
    FIsLoadingData := FALSE;
  end;
  if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
    dFldsC := GetFormUserSetting(cUSCalcDisabledForFlds);
    if dFldsC <> '' then
      SetCalculationsForFlds(dFldsC);
    dFldsE := GetFormUserSetting(cUSEnablingDisabledForFlds);
    if dFldsE <> '' then
      SetEnablingsForFlds(dFldsE);
    if StrToBoolSafe(GetFormUserSetting(cUSCalcDisabled)) then
      SetCalculations(TRUE, TRUE)
    else if dFldsC <> '' then
    begin //kdyz nejsou vypnute vsechny vypocty tak musime aktualizovat
      SetCalcEdits(FALSE);
      DoCalculate;
      SetLiveCheck(True);
      DisplayCheck; //po otevreni
      FocusActuallyControl;
    end;
  end;
  
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('SetFormData: PŘED SetChangeFlag(FALSE), FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
  
  SetChangeFlag(FALSE);
  
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('SetFormData: PO SetChangeFlag(FALSE), FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
end; {SetFormData}

{-----------------------------------------------------------------------------
 CreateFormDataHead
   Vraci retezec s identifikacnimi udaji formulare
 -----------------------------------------------------------------------------}

function TfaMain.CreateFormDataHead: string;
var
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    sl.Add(cFormHeadLabel);
    sl.Values[mtTskpID.FieldName] := mtTskpID.AsString;
    sl.Values[mtTskpGUID.FieldName] := mtTskpGUID.AsString;
    sl.Values[mtTskpMasterGuid.FieldName] := mtTskpMasterGuid.AsString;
    sl.Values[mtTskpDefID.FieldName] := mtTskpDefID.AsString;
    sl.Values['DefVersion'] := mtDefFormVersion.AsString;
    sl.Values[mtTskpPeriod.FieldName] := mtTskpPeriod.AsString;
    sl.Values[mtTskpGroup.FieldName] := mtTskpGroup.AsString;
    sl.Values[mtTskpSubGroup.FieldName] := mtTskpSubGroup.AsString;
    sl.Values[mtTskpCreateDate.FieldName] :=
      FieldToString(mtTskpCreateDate);
    sl.Values[mtTskpModifiedDate.FieldName] :=
      FieldToString(mtTskpModifiedDate);
    sl.Values[mtTskpModifiedTime.FieldName] := mtTskpModifiedTime.AsString;
    sl.Values[mtTskpAutor.FieldName] := mtTskpAutor.AsString;
    sl.Values[mtTskpLocked.FieldName] := FieldToString(mtTskpLocked);
    sl.Values[mtTskpFillingNumber.FieldName] :=
      FieldToString(mtTskpFillingNumber);
    sl.Values[mtTskpFillingPassword.FieldName] :=
      FieldToString(mtTskpFillingPassword);
    sl.Values[mtTskpFillingDate.FieldName] := FieldToString(mtTskpFillingDate);
    sl.Values[mtTskpFillingURL.FieldName] := FieldToString(mtTskpFillingURL);
    sl.Values[mtTskpFillingState.FieldName] := FieldToString(mtTskpFillingState);
    sl.Values[mtTskpFillingTimeStampDate.FieldName] :=
      FieldToString(mtTskpFillingTimeStampDate);
    sl.Values[mtTskpFillingTimeStampSignature.FieldName] :=
      Replace(#10,FieldToString(mtTskpFillingTimeStampSignature),'');
    sl.Values['DefVersion'] :=
      Replace(#10,FieldToString(mtDefFormVersion),'');
    sl.Values[mtTskpWorkState.FieldName] :=
      FieldToString(mtTskpWorkState);
    sl.Values[mtTskpExpirationDate.FieldName] := FieldToString(mtTskpExpirationDate);
    sl.Add('');
    Result := sl.Text;
  finally
    sl.Free;
  end;
