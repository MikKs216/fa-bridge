//pripoji mtValues k editacnim polim

procedure TfaMain.ConnectMtValues;
var
  i: integer;
  c: TControl;
begin
  StartWait;
  try
    if sbForm<>nil then begin
      for i := 0 to sbForm.ControlCount - 1 do begin
        c := sbForm.Controls[i];
        if GetMTVField(c.Name) <> nil then begin
          if c is TfaEdit then begin
            TfaEdit(c).DataSource := dsValues;
            TfaEdit(c).DataField := c.Name;
            TfaEdit(c).OnMouseDown := DoOnMouseDown;
            TfaEdit(c).OnMouseMove := DoOnMouseMove;
          end
          else if c is TcxDBCheckBox then begin
            TcxDBCheckBox(c).DataBinding.DataSource := dsValues;
            TcxDBCheckBox(c).DataBinding.DataField := c.Name;
            TcxDBCheckBox(c).OnMouseDown := DoOnMouseDown;
          end
          else if c is TcxDBMemo then begin
            TcxDBMemo(c).DataBinding.DataSource := dsValues;
            TcxDBMemo(c).DataBinding.DataField := c.Name;
            TcxDBMemo(c).OnMouseDown := DoOnMouseDown;
            TcxDBMemo(c).OnEnter := DoOnMemoEnter;
            TcxDBMemo(c).OnExit := DoOnMemoExit;
            TcxDBMemo(c).OnEditing := DoOnMemoEditing;
            TcxDBMemo(c).Style.LookAndFeel.Kind := lfFlat;
            TcxDBMemo(c).Style.LookAndFeel.NativeStyle := FALSE;
          end
          else if c is TcxListBoxEx then begin
            LoadListBoxData(TcxListBoxEx(c));
            TcxListBoxEx(c).OnMouseDown := DoOnMouseDown;
            TcxListBoxEx(c).Style.LookAndFeel.Kind := lfFlat;
            TcxListBoxEx(c).Style.LookAndFeel.NativeStyle := FALSE;
          end;
        end;
      end;
    end;
  finally
    StopWait;
  end;
end; {ConnectMtValues}

//pripoji mtValues k editacnim polim

procedure TfaMain.DisconnectMtValues;
var
  i: integer;
  c: TControl;
  isChangingScript: boolean;
  h, w: integer;
begin
  StartWait;
  isChangingScript:=FIsChangingScript;
  FIsChangingScript := TRUE; //aby se neprovadely vypocty
  try
    for i := 0 to sbForm.ControlCount - 1 do begin
      c := sbForm.Controls[i];
      if c is TfaEdit then begin
        TfaEdit(c).DataSource := nil;
        TfaEdit(c).DataField := '';
        TfaEdit(c).OnMouseDown := nil;
      end
      else if c is TcxDBCheckBox then begin
        //Marek 14.5.2025 - podminka (a nastaveni H a W) zajisti,
        //ze checkbox bude mit takovou vysku a sirku, jaka byla nastavena v kresleni.
        //Jde o to, ze kdyz si v kresleni nastavim vlastni velikost checkboxu,
        //tak pri opusteni rezimu kresleni vyvola nastaveni DataSource proceduru UpdateAutoWidth (ktera je v CxDBCheckBoxEx.pas)
        //a tim padem dojde k automaticke uprave velikosti.
        //V UpdateAutoWidth je sice podminka: if not (csDesigning in ComponentState) then Exit,
        //ale na tomto miste je stale: (csDesigning in ComponentState)
        if (csDesigning in ComponentState) then begin
          h := TcxDBCheckBox(c).Height;
          w := TcxDBCheckBox(c).Width;
          try
            TcxDBCheckBox(c).DataBinding.DataSource := nil;
          finally
            TcxDBCheckBox(c).Height := h;
            TcxDBCheckBox(c).Width := w;
          end;
        end
        else
          TcxDBCheckBox(c).DataBinding.DataSource := nil;
        TcxDBCheckBox(c).DataBinding.DataField := '';
        TcxDBCheckBox(c).OnMouseDown := nil;
      end
      else if c is TcxDBMemo then begin
        TcxDBMemo(c).DataBinding.DataSource := nil;
        TcxDBMemo(c).DataBinding.DataField := '';
        TcxDBMemo(c).OnMouseDown := nil;
      end
      else if c is TcxListBoxEx then begin
        TcxListBoxEx(c).OnMouseDown := nil;
      end;
    end;
  finally
    FIsChangingScript := isChangingScript;
    StopWait;
  end;
end; {DisconnectMtValues}

