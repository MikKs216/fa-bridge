  cRightFldBracketNumberStr = '=]';

  cLeftPartOfField = ' GetMTVField(''';
  cRightPartOfField = ''').Value ';
  cRightPartOfFieldAsString = ''').AsString ';

  cLeftPartOfFieldNumber = ' GetMTVFieldValue(''';
  cRightPartOfFieldNumber = ''',''*]'') ';
  cRightPartOfFieldNumberStr = ''',''=]'') ';

  //Marek: reseni, ktere se pouzivalo pro TMS scritper nez jsem zaradil tms_kbMTGetFieldValueProc
  //pred zarazenim totiz TField.Value vracel null
  //!!!POKUD SE SMAZE, MUZE SE SMAZAT I GetMTVFieldAsType!!!!
  {function DoTranslate: string;
  var
    i, y: integer;
    scr, scrNew: string;
    s, s1, oldFld, oldFldBrc: string;
  begin
    scr := AScript;
    scrNew := '';
    oldFld := '';
