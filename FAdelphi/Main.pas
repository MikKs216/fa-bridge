{$IFNDEF STANDALONE}
procedure TfaMain.LoadStoredStrings;
var
  stSS: TMemoryStream;
begin
  if FDoCloseAutomatic then
    EXIT;
  StartWait;
  stSS := TMemoryStream.Create;
  try
    GetStoredStrings(FClientID, stSS);
    if stSS.Size > 0 then begin
      try
        mtStoredStrings.Close;
        mtStoredStrings.EmptyTable;
        mtStoredStrings.Open;
        mtStoredStrings.LoadFromStream(stSS);
        mtStoredStrings.Refresh;
      except
        mtStoredStrings.Close;
        mtStoredStrings.EmptyTable;
        mtStoredStrings.Open;
      end;
    end
    else begin
      mtStoredStrings.Close;
      mtStoredStrings.EmptyTable;
      mtStoredStrings.Open;
    end;
  finally
    stSS.Free;
    stSS := nil;
    StopWait;
  end;
end;
{$ENDIF STANDALONE}

procedure TfaMain.FormActivate(Sender: TObject);
var
  cap, mess, scr, logEntry: string;
  stSS: TMemoryStream;
  wasFirstActivate: boolean;
  reportSettings: TReportSettings;
begin
  reportSettings := LoadReportSettings(GetIniFileName);
  logEntry := ReportSettingsToLog(reportSettings);
  LogStat('R:' + logEntry, true);

{$IFDEF PROFILER}TimeLog(' Start (Main FormActivate)'); {$ENDIF PROFILER}
  pbStart.Visible:=FALSE;

  {if (FNestedMainForm[FNestedLevel]<>nil) and
    (FNestedMainForm[FNestedLevel]<>Self) then begin
    FNestedMainForm[FNestedLevel].BringToFront;
    if FNestedMainForm[FNestedLevel].CanFocus then
      FNestedMainForm[FNestedLevel].SetFocus;
  end;}

  wasFirstActivate:=FFirstActivate;

  if FNestedState then begin
    //ve vlozenem formulari opustime proceduru protoze jinak zapomene ze byly udelany zmeny
    //  proc se FormActivate neopousti i v normanim formulari nevim, ale tam problemy nebyly zaznamenane
    if not wasFirstActivate then
      EXIT;

    dxBarButtonNew.Visible:=ivNever;
    dxBarButtonOpen.Visible:=ivNever;
    dxBarSubItemReopen.Visible:=ivNever;
    dxBarButtonClose.Visible:=ivNever;
    dxBarButtonSave.Visible:=ivNever;
    dxBarLargeButtonSave.Visible:=ivNever;
    dxBarButtonExit.Caption := sMsgCloseFANested;
    SetLiveCheck(False);
  end;

{$IFDEF FINALBUILD}
  dxBarSubItemDesign.Visible := ivNever;
  BarManager.Bars[2].Visible := FALSE;
  BarManager.Bars[2].Hidden := TRUE;
{$ENDIF FINALBUILD}
  //
  GFaMain := self;
{$IFNDEF STANDALONE}
  // nacteni StoredStrings - kdyz neni active provede se to pri otevreni
  if mtStoredStrings.Active and not FNestedPrepareReportState then
      LoadStoredStrings;
{$ENDIF STANDALONE}
  //
  if FFirstActivate then begin
    FFirstActivate := FALSE;

{$IFNDEF FINALBUILD}
  // aktualizace includu a ulozeni definice pro davkove volani ze seznamu formularu
  if (UpperCase(ParamStr(2)) = '/LOADINCLUDE') then begin
    if OpenFileDef(ParamStr(1)) then begin
      scr := '';
      if LoadIncludeScripts(TRUE, scr) then    //- ASilent=True and scr='', tzn. bude se zvedat verze
        SaveDef
      else
        FStateFormWasChanged := False;
      CloseDef;
      Close;
      Exit;
    end;
  end
  //export scriptu z definic, ktere lezi v ceste podle prvniho parametru, vysledek je v Scripts.txt tak kde je exe
  else if (UpperCase(ParamStr(2)) = '/EXPORTSCRIPT') then begin
    ScriptExp(ParamStr(1)); //zde se vola i CloseDef
    Close;
  end
  // konverze skriptu a designu, pri volani ze seznamu formularu
  else if (UpperCase(ParamStr(2)) = '/CONVERT2TMS') then begin
    ConvertDefFileToTMS(ParamStr(1), ParamStr(3));
    Close;
    Exit;
  end;
{$ENDIF FINALBUILD}

{$IFDEF STANDALONE}
    if ((UpperCase(ParamStr(2)) = '/P') or (UpperCase(ParamStr(2)) = '/PC'))
      and not FNestedState then begin //tisk formulare
      FSlaveState := ssNone;
      OpenAndPrintFile(ParamStr(1));
    end
    //spousteni v podrizenem rezimu z jineho software
    else if (UpperCase(ParamStr(2)) = '/N') and not FNestedState and
      not FOpenFromDoPrint then begin //vytvoreni noveho formulare
      FSlaveState := ssNew;
      FSlaveWasSaved := FALSE;
      NewForm(TRUE);

      if not FFileOpened then begin //kdyz neni vybran formular tak zavreme aplikaci
        SaveSlaveInfo(False);
        Close;
      end;

      if ExtractFileExt(ParamStr(1)) = cDataDefaultExt then
        FDataFileName := ParamStr(1);
          //data se budou ukladat do souboru podle 1. param.
      ApplyMainCaption(mtDefName.Value);

      dxBarButtonNew.Visible:=ivNever;
      dxBarButtonOpen.Visible:=ivNever;
      dxBarButtonClose.Visible:=ivNever;
      dxBarButtonSaveAs.Visible:=ivNever;
      dxBarSubItemReopen.Visible:=ivNever;

    end
    else if (Copy(UpperCase(ParamStr(2)), 1, 2) = '/O') and not FNestedState then
      begin //otevreni formulare
      FSlaveState := ssOpen;
      FSlaveWasSaved := FALSE;
      if ExtractFileExt(ParamStr(1)) = cDataDefaultExt then
        ReopenForm(ParamStr(1))
      else if ExtractFileExt(ParamStr(1)) = cXMLDefaultExt then begin
        SaveStringToFile('',ChangeFileExt(ParamStr(1),'.frm'));
        ImportFromXML(ParamStr(1));
        FDataFileName := ChangeFileExt(ParamStr(1),'.frm');
        FStateFormReadOnlyLAN := TRUE;
        SetReadOnly(TRUE);
        SetChangeFlag(FALSE);
      end;
      if GetStringLineValue(LoadStringFromFile(NormalPath(ExtractFilePath(
        ParamStr(1))) + 'DKresult.txt'), 'Locked') = 'TRUE' then begin
        SetLockFlag(TRUE);
        SetChangeFlag(FALSE);
      end;

      if UpperCase(ParamStr(2)) = '/ON' then begin
      // rozeditovat formulář
        SetChangeFlag(TRUE);
        DoCalculate;
        SetLiveCheck(True);
        DisplayCheck; //po otevreni
      end;

      if UpperCase(ParamStr(2)) = '/OI' then begin
      // rozeditovat formulář
        SetChangeFlag(TRUE);
        DoInit;
        SetLiveCheck(True);
        DisplayCheck; //po otevreni
      end;

      dxBarButtonNew.Visible:=ivNever;
      dxBarButtonOpen.Visible:=ivNever;
      dxBarButtonClose.Visible:=ivNever;
      dxBarButtonSaveAs.Visible:=ivNever;
      dxBarSubItemReopen.Visible:=ivNever;

      ApplyMainCaption(mtDefName.Value);
    end
    else begin
      FSlaveState := ssNone;
      //
      if (ParamStr(1) <> '') and not FNestedState and
        not FOpenFromDoPrint then begin
        if ExtractFileExt(ParamStr(1)) = cDefDefaultExt then begin
          ReopenDef(ParamStr(1));

          {$IFDEF STANDALONE}
           {$IFNDEF FINALBUILD}
           if FOpenNewFAOnStart = 'true' then begin
             ConvertFDEtoFDEX;
             dxBarButtonOpenFANewClick(nil);
           end;
           {$ENDIF FINALBUILD}
          {$ENDIF STANDALONE}

          SetLastFiles;
        end
        else if ExtractFileExt(ParamStr(1)) = cDataDefaultExt then begin
          ReopenForm(ParamStr(1));
          SetLastFiles;
        end
        else if ExtractFileExt(ParamStr(1)) = cFRMXDefaultExt then begin
          ImportFromXML(ParamStr(1));
          SetLastFiles;
        end
        //otevirani XFDF - data PDF v XML, nebo jakykoliv jiny soubor
        else begin
          ReopenForm(ParamStr(1));
          if UpperCase(ParamStr(2)) = '/C' then begin
            // spustit výpočty
            DoCalculate;
            SetLiveCheck(True);
            DisplayCheck; //po otevreni
          end;
        end;
      end
      else begin
{$IFNDEF FINALBUILD}
        //pokud se ulozila posledni definice, tak ji zkusime zase otevrit
        if dxBarButtonSaveDefAlways.Down and (FDefFileName <> '') and
          FileExists(FDefFileName) then
          ReopenDef(FDefFileName);
{$ENDIF FINALBUILD}
      end;
    end;
    ChDir(ExtractFilePath(Application.ExeName));
{$IFNDEF FINALBUILD}
    {WebUpdate1.DoUpdate;}
{$ENDIF FINALBUILD}
{$ELSE STANDALONE}
    BarManager.ShowHint := Application.ShowHint;
{$ENDIF STANDALONE}
  end
  else
    FocusActuallyControl;
  //
  //spousteni dalsich akci v nested state
  if FNestedState and (FNestedCommandSelector = nstSelOpen) then begin
    if FNestedInternalLevel=2 then
      cap:=sNestedCaptionL2To
    else
      cap:=sNestedCaptionTo;

    stSS := TMemoryStream.Create;
    try
      {$IFNDEF STANDALONE}
      if not FDoCloseAutomatic then
        GetStoredStrings(FNestedInternalIDKlient, stSS);
      {$ENDIF STANDALONE}
      if wasFirstActivate then
        DoEditNewForm(FNestedInternalIDKlient, FNestedInternalFormID,
          FNestedInternalDefID, '', FNestedInternalClientData,
          cap + ' ' + FNestedInternalDatabaseCaption, stSS, '', '',
          FNestedInternalData, FNestedInternalAddedData, mess);
    finally
      stSS.Free;
      stSS:=nil;
    end;
    SetReadOnlyNested(FNestedMainLocked,FNestedMainLocked);
    if FNestedMainLocked then
      LoadPage;
    SetChangeFlag(FALSE);
    if FNestedPrepareReportState then begin
      FNestedDstFileName:=PrepareReportFile(FNestedDstFileName);
      PostMessage(Handle, WM_USERCloseForm, 0, 0);
    end;
  end;
  UpdateBars;
  mxStatusBar1.Refresh;
  if mtDef.Active then
    ApplyMainCaption(mtDefName.Value);
  DoOnActivate; // on activate nenastava, resp. je potlacene kdyz se otevira uz vytvoreny formular z klientu
  SetVisibleAllBarsWhenLoading(false);
  //
{$IFNDEF FINALBUILD}
  //Marek (8.2.2019)
  //- pri vstupu do editoru skriptu se v FA zrusi klavesove zkratky Ctrl+Z a Ctrl+Y
  //  aby fungovaly ty v editoru skriptu (viz. fmScriptEditor.FormActivate)
  //- zde se opet nastavi, aby fungovaly v FA
  if faUndo1.ShortCut = 0 then
    faUndo1.ShortCut := ShortCut(Word('Z'), [ssCtrl]);
  if faRedo1.ShortCut = 0 then
    faRedo1.ShortCut := ShortCut(Word('Y'), [ssCtrl]);
{$ENDIF FINALBUILD}
  //
{$IFNDEF FINALBUILD}
  //pokud v fmScriptEditor ladime skript a stojime na breakpointu, tak nechceme, aby main mohl ziskat focus
  if (fmScriptEditor <> nil) and (fmScriptEditor.IsDebugMode) and
     ((ScripterT.Running) or fmScriptEditor.FIsChanged) then begin
    fmScriptEditor.BringToFront;
    if ScripterT.Running then
      MsgBoxWarn(Caption,'Probíhá ladění skriptu, nelze se přepnout do okna hlavního formuláře.',MB_OK)
    else
      MsgBoxWarn(Caption,'Ve skriptu byly provedeny změny, skript nejprve uložte.',MB_OK);
  end;
{$ENDIF FINALBUILD}
  //
{$IFDEF PROFILER}TimeLog(' End (Main FormActivate)'); {$ENDIF PROFILER}
end; {FormActivate}

