//Vraci cestu k souboru pdf pri volani s partametrem AOnlyPrepareFile=TRUE
//  jinak vraci cestu k pracovnimu souboru pdf
// B
procedure TfaMain.DoPrintForm(AStreamForm: TMemoryStream;
  ASendMail: boolean; AOnlyPrepareFile: boolean; var AOutPDFFileName: string);
var
  {$IFNDEF STANDALONE}
  lObj: TWinObj;
  {$ENDIF STANDALONE}
  reportSettings: TReportSettings;
  sl: TStringList;
begin
  StartWait;
  gFormOpening:=True;
  sl:=TStringList.Create;
  try
    FDoCloseAutomatic := TRUE;
    SetFocusContent;
    FDataFileName := '';
    {$IFNDEF STANDALONE}
    //vytvoreni ikony v outlookbaru
    lObj := TWinObj.Create;
    lObj.Window := self;
    lObj.WindowIcon := 1;
    lObj.WindowText := FDatabaseCaption;
    lObj.WindowIconText := Copy(FDatabaseCaption, 1, Max(1,
      Pos(' ', FDatabaseCaption)));
    dmGlobObj.gFAllWindow.AddObj(lObj);
    Application.MainForm.Perform(Msg_UpdateListWindow, 1, 0);
    {$ENDIF STANDALONE}

    FSaveHistoryToDB := FALSE;
    //
    AStreamForm.Seek(0, soFromBeginning);
    sl.LoadFromStream(AStreamForm);
    if OpenFileDataString(sl.Text) then begin
      ApplyMainCaption(mtDefName.Value);
      reportSettings := LoadReportSettings(GetIniFileName);
      reportSettings := ApplyRestrictReportOptions(reportSettings);
      reportSettings := ApplyAllPages(reportSettings);
      DoOnOpen;
      AOutPDFFileName := PreviewForm(NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
        mtDefID.Value + cReportDefaultExt,
        {TRUE} False, //MIPI - nesdoslo k podpisu pri odeslani frm emailem z klientu 
        ASendMail,AOnlyPrepareFile,
        reportSettings,AOutPDFFileName);
    end;
    while not FCanClose do
      Application.ProcessMessages;
    CloseForm;
  finally
    sl.Free;
    gFormOpening:=False;
    StopWait;
  end;
end; {DoPrintForm}

procedure TfaMain.DoImportEPO(const ADefID: string; const AEPOFilePath: string);
var
  {$IFNDEF STANDALONE}
  lObj: TWinObj;
