procedure TfaMain.pmRVPopup(Sender: TObject);
var
  s: string;
  n: integer;
  startItemNo, startItemOffs, endItemNo, endItemOffs: integer;

  function GetCurrentWord: string;
  var
    delims: string;
  begin
    with reNotes.RichViewEdit do begin
      GetSelectionBounds(startItemNo,startItemOffs,endItemNo,endItemOffs,FALSE);
      delims:=reNotes.RichViewEdit.Delimiters;
      Delimiters:=Replace('.',Delimiters,'');
      try
        SelectCurrentWord;
      finally
        Delimiters:=delims;
      end;
      Result:=GetSelText;
      SetSelectionBounds(startItemNo,startItemOffs,endItemNo,endItemOffs);
    end;
  end;

begin
  {$IFDEF STANDALONE}
  dxBarButtonRVInsertText.Visible:=ivNever;
  dxBarRVInsertClientParam.Visible:=ivNever;
  {$ELSE STANDALONE}
  dxBarButtonRVInsertText.Visible:=ivAlways;
  dxBarRVInsertClientParam.Visible:=ivAlways;
  {$ENDIF STANDALONE}

  dxBarRVPopupVybratText.Visible:=ivNever; //volba primo v rootu popup menu, zobrazujeme jen na teckach
  dxBarSpellCheckAdd.Visible:=ivNever;
  dxBtnPageSetup.Visible:=ivAlways;

  if IsDots(GetCurrentWord) then begin
  {$IFDEF STANDALONE}
    dxBarRVPopupVybratText.Visible:=ivAlways;
  {$ENDIF STANDALONE}
  end
  else if dxBarSpellCheck.Down then begin
    if reNotes.RichViewEdit.GetCurrentMisspelling(FALSE,s,n) then begin
      dxBarSpellCheckAdd.Caption:=Format(sMsgSpellCheckAddWord,[s]);
      FSpellCheckAddedWord:=s;
      dxBarSpellCheckAdd.Visible:=ivAlways;
    end
    else
      dxBarSpellCheckAdd.Visible:=ivNever;
  end
  else
    dxBarSpellCheckAdd.Visible:=ivNever;
end;

