procedure TfaMain.SetCalculationsForFlds(AFldsList: string);
var
  i: integer;
  fldName: string;
begin
  Assert(mtFields.Active, 'mtFields neni active v SetCalculationsForFlds');
  if mtFields.Active and (AFldsList <> '') then
    for i := 0 to CountListItems(AFldsList) - 1 do begin
      fldName := GetListItem(AFldsList, i);
      if mtFields.FindKey([UpperCase(fldName)])
        {mtFields.Locate(mtFieldsName.FieldName, fldName, //opt
        [loCaseInsensitive])}and
        mtFieldsHasCalc.Value then begin
        mtFields.Edit;
        mtFieldsIsCalculated.Value := FALSE;
        mtFields.Post;
      end;
    end;
end; {SetCalculationsForFlds}

