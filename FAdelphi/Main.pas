function TfaMain.GetPDFBgFileName(AShowMessage: boolean): string;
var
  pdfFileName, pdfBgFileName, reportDefName: string;
  sl: TStringList;
begin
  Result := '';
  if mtDefExportScript.Value <> '' then begin
    pdfFileName := GetPDFBgFromMtDef;
    //
    reportDefName := NormalPath(ExtractFilePath(FDefFileName)) +
                      mtDefID.Value + cReportDefaultExt;
    if PrepareDirWork then begin
      if FileExists(reportDefName) then begin
        UnzipReportDefs(reportDefName);
        pdfFileName := DirWorkPath + pdfFileName;
        if FileExists(pdfFileName) and
           (AnsiLowerCase(ExtractFileExt(pdfFileName)) = '.pdf') then begin
          pdfBgFileName := ExtractFilePath(pdfFileName)+
                            ChangeFileExt(ExtractFileName(pdfFileName),'')+cPdfBGPartFileName+
                            ExtractFileExt(pdfFileName);
          if CopyFile(PChar(pdfFileName), PChar(pdfBgFileName), FALSE) then
            Result := pdfBgFileName;
        end;
        if not FileExists(Result) then begin
          Result := '';
          if AShowMessage then
            MessageInfo(Caption,
              Format(sNotExistPdfBgFile,[ExtractFileName(pdfFileName)]), [MBOK]);
        end;
      end
      else if AShowMessage then
        MessageInfo(Caption, sNotExistReportDefFileForPdfBg, [MBOK]);
    end;
  end;
  FPDFBgFileName := Result;
end;

