procedure TfaMain.ScripterTMS_AddAllDefControls;
var
  des: TIDEFormDesigner;
  st: TMemoryStream;
  i,y: integer;
  sl: TStringList;
  c: TControl;
  la: TLabel;
  bl: TpsvBorderLabel;
  wl: TpsvWebLabel;
  hl: THTMLStaticText;
  ed: TfaEdit;
  ck: TcxDBCheckBoxEx;
  me: TcxDBMemoEx;
  bit: TBitBtn;
  bt: TButton;
  sh: TShape;
  img: TImage;
  lb: TcxListBoxEx;

  sb: TScrollBox;
  s: string;
  cName, cType: string;
begin
  if FControlsNamesList.Count > 0 then begin
    sl := TStringList.Create;
    //
    c := TControl.Create(nil);
    la := TLabel.Create(nil);
    bl := TpsvBorderLabel.Create(nil);
    wl := TpsvWebLabel.Create(nil);
    hl := THTMLStaticText.Create(nil);
    ed := TfaEdit.Create(nil);
    ck := TcxDBCheckBoxEx.Create(nil);
    me := TcxDBMemoEx.Create(nil);
    bit := TBitBtn.Create(nil);
    bt := TButton.Create(nil);
    sh := TShape.Create(nil);
    img := TImage.Create(nil);
    lb := TcxListBoxEx.Create(nil);
    try
      for i := 0 to FControlsNamesList.Count - 1 do begin
        sl.CommaText := FControlsNamesList[i];
        cName := sl[0];
        cType := sl[1];
        if cName <> '' then begin
          if SameText(cType, la.ClassName) then begin
            la.Name := cName;
            ScripterTMS_AddComponent(ScripterT, la);
            ScripterTMS_AddComponent(workScripterT, la);
          end
          else if SameText(cType, bl.ClassName) then begin
            bl.Name := cName;
            ScripterTMS_AddComponent(ScripterT, bl);
            ScripterTMS_AddComponent(workScripterT, bl);
          end
          else if SameText(cType, wl.ClassName) then begin
            wl.Name := cName;
            ScripterTMS_AddComponent(ScripterT, wl);
            ScripterTMS_AddComponent(workScripterT, wl);
          end
          else if SameText(cType, hl.ClassName) then begin
            hl.Name := cName;
            ScripterTMS_AddComponent(ScripterT, hl);
            ScripterTMS_AddComponent(workScripterT, hl);
          end
          else if SameText(cType, ed.ClassName) then begin
            ed.Name := cName;
            ScripterTMS_AddComponent(ScripterT, ed);
            ScripterTMS_AddComponent(workScripterT, ed);
          end
          else if SameText(cType, ck.ClassName) then begin
            ck.Name := cName;
            ScripterTMS_AddComponent(ScripterT, ck);
            ScripterTMS_AddComponent(workScripterT, ck);
          end
          else if SameText(cType, me.ClassName) then begin
            me.Name := cName;
            ScripterTMS_AddComponent(ScripterT, me);
            ScripterTMS_AddComponent(workScripterT, me);
          end
          else if SameText(cType, bt.ClassName) then begin
            bt.Name := cName;
            ScripterTMS_AddComponent(ScripterT, bt);
            ScripterTMS_AddComponent(workScripterT, bt);
          end
          else if SameText(cType, bit.ClassName) then begin
            bit.Name := cName;
            ScripterTMS_AddComponent(ScripterT, bit);
            ScripterTMS_AddComponent(workScripterT, bit);
          end
          else if SameText(cType, sh.ClassName) then begin
            sh.Name := cName;
            ScripterTMS_AddComponent(ScripterT, sh);
            ScripterTMS_AddComponent(workScripterT, sh);
          end
          else if SameText(cType, img.ClassName) then begin
            img.Name := cName;
            ScripterTMS_AddComponent(ScripterT, img);
            ScripterTMS_AddComponent(workScripterT, img);
          end
          else if SameText(cType, lb.ClassName) then begin
            lb.Name := cName;
            ScripterTMS_AddComponent(ScripterT, lb);
            ScripterTMS_AddComponent(workScripterT, lb);
          end
          else begin
            c.Name := cName;
            ScripterTMS_AddComponent(ScripterT, c);
            ScripterTMS_AddComponent(workScripterT, c);
          end;
        end;
      end;
    finally
      sl.Free;
      c.Free;
      la.Free;
      bl.Free;
      wl.Free;
      hl.Free;
      ed.Free;
      ck.Free;
      me.Free;
      bit.Free;
      bt.Free;
      sh.Free;
      img.Free;
      lb.Free;
    end;
  end
  else begin
    des := TIDEFormDesigner.Create(self);
    sb := TScrollBox.Create(faMain);
    with mtContent do begin
      DisableControls;
      AfterScroll := nil;
    end;
    try
      with mtContent do begin
        First;
        while not EOF do begin
          sb.Visible := FALSE;
          //nejprve odstranime vsechny controlsy ze scrollboxu
          for i := sb.ControlCount - 1 downto 0 do begin
            if sb.Controls[i] is TcxDBMemoEx then //osetreni AV ve Vistach
              TcxDBMemoEx(sb.Controls[i]).Visible:=FALSE;
            sb.Controls[i].Free;
          end;
          //a pak nacteme novou stranku a jednotlive controlsy pridame do ScripterT
          if mtContentSectionForm.Value <> '' then begin
            st := TMemoryStream.Create;
            try
              mtContentSectionForm.SaveToStream(st);
              st.Seek(0, soFromBeginning);
              //st.SaveToFile('D:\TMS10.TXT');
              des.LoadComponentFromStream(st, sb, dfmBinary);
              for i := 0 to sb.ControlCount - 1 do begin
                c := sb.Controls[i];
                ScripterTMS_AddComponent(ScripterT, c);
                ScripterTMS_AddComponent(workScripterT, c);
                //
                if not FControlsNamesList.Find(c.Name+','+c.ClassName, y) then
                  FControlsNamesList.Add(c.Name+','+c.ClassName);
              end;
            finally
              st.Free;
            end;
          end;
          Next;
        end;
      end;
    finally
      with mtContent do begin
        AfterScroll := mtContentAfterScroll;
        EnableControls;
      end;
      sb.Free;
      des.Free;
      des := nil;
    end;
  end;
  {s:='';
  for i := 0 to ScripterT.ComponentCount - 1 do
    AddStringLine(s, ScripterT.Components[i].Name);
  SaveStringToFile(s, 'd:\component.txt')}
end;

function TfaMain.LoadDataDef(const AFileName: string): boolean;
var
  res: boolean;
  scr: string;
begin
  StartWait;
  if not pbStart.Visible then
    SetProgressPos(0);
  mtDef.DisableControls;
  try
    mtDef.DefaultFormat := mtPrgTablesFormat;
    Result := LoadMtFromZip(mtDef, AFileName, dpsw);
    FNewScripter := (mtDefLinkedForm.AsString = 'tmsscript') or (mtDefLinkedForm.AsString = 'ok');
{$IFNDEF FINALBUILD}
    scr := '';
    //pri otevereni definice provadime aktualizaci sdilenych skriptu, ale
    if (UpperCase(ParamStr(2)) <> '/LOADINCLUDE') then     //- neprovadi se pri davkovem zpracovani (napr. ze seznamu formularu), v takovem pripade se jiz vola ve FormActivate
      if (UpperCase(ParamStr(2)) <> '/EXPORTSCRIPT') then  //- neprovadi se pri davkovem exportu definic
        if (UpperCase(ParamStr(2)) <> '/CONVERT2TMS') then //- neprovadi se pri davkove konverzi skriptu a designu
          LoadIncludeScripts(False, scr);                  //- ASilent=False, tzn. nebude se zvedat verze
{$ENDIF FINALBUILD}

{$IFDEF STANDALONE}
    FReportVariants:=GetReportVariants(mtDefID.Value);
{$ELSE STANDALONE}
    if FNestedState then
      FReportVariants:=GetReportVariants(mtDefID.Value);
{$ENDIF STANDALONE}
    //
    if Result then
      Result := LoadFields(AFileName);
    SetProgressPos(20);
    if Result then
      Result := LoadContent(AFileName);
{$ifdef profiler}timelog('--- start ScripterTMS_AddAllDefControls'); {$endif profiler}
    if Result and FNewScripter then begin
      FIsLoadingContent:=TRUE; //7.10.2021 (Marek, #4378) - osetreni chyby, ktera vznikala pri vytvoreni noveho formulare a naslednem stisku Alt+Tab, vic v redmine
      try
        LoadControlsNamesList(AFileName);
        ScripterTMS_AddAllDefControls;
      finally
        FIsLoadingContent:=FALSE;
      end;
    end;
{$ifdef profiler}timelog('--- stop ScripterTMS_AddAllDefControls'); {$endif profiler}
    SetProgressPos(30);
    if Result then begin
      Result := LoadFieldsInfo(AFileName);
      SetMaxContentKey;
    end;
    SetProgressPos(40);
    ApplyBkColor;
    DoOpenPDFBgFile(False);
    if Result then begin
      FDoEnableAfterCalculate := TRUE;
      FIsLoadingContent:=TRUE; //pri cteni mtValues z nejakeho duvodu nastava zmena tvContent, timto zabranime dusledkum
      //LoadScript;    //8.3.2011 presunuto z mista pred 2 radky. FIsLoadingContent true by melo zajistit aby pri natahovani scriptu nedoslo ke zmene stranky
      try
        res:=LoadMtValues(AFileName);
        SetProgressPos(50);
      finally
        FIsLoadingContent:=FALSE;
      end;
      {$ifdef profiler}timelog('--- start LoadScript'); {$endif profiler}
      LoadScript;
      {$ifdef profiler}timelog('--- stop LoadScript'); {$endif profiler}
      if res then begin
        InitMtValues;// Result neplnime, mtvalues tam nemusi byt
      end
      else begin
        GenMtValues(TRUE);
      end;
      SetProgressPos(60);
      InitHistTables;
      ConnectMtValues;
      SetProgressPos(70);
    end;
    SetWindowDimension;
    UpdateTreeViewContent;
    SetLockFlag(FALSE);
    SetChangeFlag(FALSE);
  finally
    mtDef.EnableControls;
    StopWait;
  end;
end; {LoadDataDef}

