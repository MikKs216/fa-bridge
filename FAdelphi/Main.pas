procedure TfaMain.LoadListBoxData(AListBox: TcxListBoxEx);
var
  fld: TField;
  sl: TStringList;
  i: integer;
begin
  if mtValues.Active then begin
    fld := GetMTVField(AListBox.Name);
    if fld <> nil then begin
      sl:= TStringList.Create;
      try
        AListBox.Clear;
        sl.Text:=Replace('['+sNestedSecID+']',fld.AsString,'');
        sl.Text:=Replace('[/'+sNestedSecID+']',sl.text,'');
        for i:= 0 to sl.Count-1 do
          AListBox.AddItem(sl[i],nil);
        AListBox.ItemIndex:=0;
      finally
        sl.Free;
      end;
    end;
  end;
end;

procedure TfaMain.ReloadListBoxes;
