{-----------------------------------------------------------------------------
 CreateMtTskp
   Pripravi mtTskp k pouziti.
 -----------------------------------------------------------------------------}

procedure TfaMain.CreateMtTskp(const ADefID: string = '';
  const AID: integer = 0;
  const AGUID: string = ''; const AMasterGuid: string = '';
  const AGroup: string = ''; const ASubGroup: string = '';
  const AFillingNumber: string = ''; const AFillingPassword: string = '';
  const AFillingDate: string = ''; const AFillingState: string = '';
  const AFillingURL: string = ''; const AFillingTimeStampDate: string = '';
  const AFillingTimeStampSignature: string = ''; const AWorkState: integer = 0;
  const AExpirationDate: string = '');
var
  fld: TField;
begin
  mtTskp.Close;
  mtTskp.EmptyTable;
  mtTskp.Open;
  mtTskp.Append;
  mtTskpID.Value := AID;
  if AGUID<>'' then
    mtTskpGUID.Value := AGUID
  else
    mtTskpGUID.Value := CreateGUIDString;
  mtTskpMasterGuid.Value := AMasterGuid;
  mtTskpDefID.Value := ADefID;
  mtTskpGroup.Value := AGroup;
  mtTskpSubGroup.Value := ASubGroup;
  mtTskpFillingNumber.Value := AFillingNumber;
  mtTskpFillingPassword.Value := AFillingPassword;
  mtTskpFillingDate.Value := AFillingDate;
  fld:=mtTskpFillingState;
  StringToField(AFillingState,fld);
  mtTskpFillingURL.Value := AFillingURL;
  mtTskpFillingTimeStampDate.Value := AFillingTimeStampDate;
  mtTskpFillingTimeStampSignature.Value := AFillingTimeStampSignature;
  mtTskpWorkState.Value := AWorkState;
  mtTskpExpirationDate.Value := AExpirationDate;
  mtTskp.Post;
end; {CreateMtTskp}

{-----------------------------------------------------------------------------
 SaveForm
   Ulozi data formulare do souboru jmena ulozeneho v FDataFileName,
   pokud je jmeno prazdne dotaze se uzivatele.
 -----------------------------------------------------------------------------}

procedure TfaMain.SaveForm(ADoChecking: Boolean = True);
begin
  //spustit kontroly
  if ADoChecking then begin
    if ShowChecking then
      EXIT;
  end;
{$IFDEF STANDALONE}
  //ulozit do souboru
  if FDataFileName = '' then begin
    with SaveDialog1 do begin
      DefaultExt := cDataDefaultExt;
      Filter := cFormOpenSaveFilter;
      if Execute then begin
        if not FileExists(FileName) or
          (MessageAsk(Caption,Format(sMsgFileNotExistsAsk, [FileName]),
          [MBYES, MBNO]) = IDYES) then begin
          //ulozit do souboru
          SaveData(FileName);
          //ulozit pouzite jmeno
          FDataFileName := FileName;
          //nastavit tlacitko
          SetChangeFlag(FALSE);
          SetLastFiles;
        end;
      end;
    end;
  end
  else begin
    if (GetFileInformation(FDataFileName).Attr and faReadOnly) <> 0 then
      MessageInfo(Caption, sMsgCannotSaveReadOnly, [MBOK])
    else begin
      SaveData(FDataFileName);
      if FSlaveState <> ssNone then
        SaveSlaveInfo(TRUE, TRUE);
      SetChangeFlag(FALSE);
    end;
  end;
  //
  ApplyMainCaption(FDataFileName);
{$ELSE STANDALONE}
  SaveFormToDatabase(FALSE);
  SetChangeFlag(FALSE);
  FSaveHistoryToDB := TRUE;
{$ENDIF STANDALONE}
end; {SaveForm}

//ulozi formular bez spusteni kontrol (ve standalone jen kdyz uz byl formular ulozeny)
procedure TfaMain.SaveFormWithoutCheck;
begin
{$IFDEF STANDALONE}
  //ulozit do souboru
  if FDataFileName <> '' then begin
    if (GetFileInformation(FDataFileName).Attr and faReadOnly) = 0 then begin
      SaveData(FDataFileName);
      if FSlaveState <> ssNone then
        SaveSlaveInfo(TRUE, TRUE);
      SetChangeFlag(FALSE);
    end;
  end;
{$ELSE STANDALONE}
  SaveFormToDatabase(FALSE);
  SetChangeFlag(FALSE);
  FSaveHistoryToDB := TRUE;
{$ENDIF STANDALONE}
end;

//ulozi data do jineho souboru

procedure TfaMain.SaveAsForm;
begin
  //spustit kontroly
  if ShowChecking then
    EXIT;
  with SaveDialog1 do begin
    DefaultExt := cDataDefaultExt;
    Filter := cFormOpenSaveFilter;
    FileName := FDataFileName;
    if Execute then begin
