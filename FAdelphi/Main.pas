//vytvori udaje v tabulce taValues
//  AForRunTimeMode
//    Ano ... vytvori udaje s typy odpovidajici runtime modu
//    Ne ... vytvori udaje s typy string pro design mod
//  AOnlySetMasks
//    Ano ... pouze nastavi masky a vynuluje udaje
//

procedure TfaMain.GenMtValues(AForRunTimeMode: boolean = FALSE;
  AOnlySetMasks: boolean = FALSE);
var
  i: integer;
  mask: string;
  ro: boolean;
begin
  StartWait;
  mtValues.DisableControls;
  DisconnectMtValues;
  ro := mtValues.ReadOnly;
  mtValues.ReadOnly := FALSE;
  try
    with mtValues do begin
      {Active := False; } // puvodni stav
      {EmptyTable;      }
      CEdit.DataBinding.DataField := '';
      if not AOnlySetMasks then begin
        Close;            // novy stav - presunuto sem
        EmptyTable;       // ...
        with FieldDefs do begin
          Clear;
          mtFields.First;
          for i := 1 to mtFields.RecordCount do begin
            with AddFieldDef do begin
              {AddFieldDef.Name := mtFieldsName.Value;}
              mtValues.FieldDefs[i - 1].Name := mtFieldsName.Value;
              //v modu navrhu
              if not AForRunTimeMode and dxBarButtonDesignMode.Down then begin
                DataType := ftString;
              end
              //v modu editace dat
              //s - string
              else if mtFieldsDataType.Value = cStringTypeValue then begin
                DataType := ftString;
                {if mtFieldsDataTypeLength.Value > 0 then
                  Size := mtFieldsDataTypeLength.Value
                else}// dovolime zadat jakoukoliv delku,
                     // na prekroceni kolonek jen upozornime
                Size := 255;
              end
              //n - number
              else if mtFieldsDataType.Value = cNumericTypeValue then begin
                if mtFieldsDataTypeLength.Value = 0 then
                  DataType := ftInteger
                else
                  DataType := ftFloat;
              end
              //c - currency
              else if mtFieldsDataType.Value = cCurrencyTypeValue then begin
                DataType := ftCurrency
              end
              //d - date
              else if mtFieldsDataType.Value = cDateTypeValue then
                DataType := ftDate
              //b - boolean
              else if mtFieldsDataType.Value = cBooleanTypeValue then
                DataType := ftBoolean
              //m - memo
              else if mtFieldsDataType.Value = cMemoTypeValue then
                DataType := ftMemo;
              //
              Required := FALSE;
            end;
            mtFields.Edit;
            mtFieldsFieldIndex.Value := i-1;
            mtFields.Post;
            mtFields.Next;
          end;
        end;
        //
        CreateTable;
        Open;               // novy stav - doplneno
      end;
      //nastaveni masek a napleneni udaju
      if Fields.Count > 0 then begin
        {Open;    }        // puvodni stav (omezujeme pocet otevirani protoze to trva u vice udaju dlouho)
        if not Active then // novy stav
          Open;            // ...
        EmptyTable;        // tady vyprazdnime, protoze prazdna nemusi byt
        //
        Append;
        for i := 0 to Fields.Count - 1 do begin
          if mtFields.FindKey([UpperCase(Fields[i].FieldName)])
            {mtFields.Locate(mtFieldsName.FieldName, //opt
            Fields[i].FieldName, [loCaseInsensitive])}then begin
            //string
            if Fields[i] is TStringField then begin
              if mtFieldsInvertAlignment.Value then
                TStringField(Fields[i]).Alignment := taRightJustify
              else
                TStringField(Fields[i]).Alignment := taLeftJustify;
            end
            //integer
            else if Fields[i] is TIntegerField then begin
              if mtFieldsDisplayFormat.Value <> '' then
                mask := mtFieldsDisplayFormat.Value
              else if FParamShowThousandSeparator then
                mask := ',0'
              else
                mask := '0';
              TIntegerField(Fields[i]).DisplayFormat := mask;
              TIntegerField(Fields[i]).EditFormat := mask;
              if mtFieldsInvertAlignment.Value then
                TIntegerField(Fields[i]).Alignment := taLeftJustify
              else
                TIntegerField(Fields[i]).Alignment := taRightJustify;
            end
            //float
            else if Fields[i] is TFloatField then begin
              if mtFieldsDisplayFormat.Value <> '' then
                mask := mtFieldsDisplayFormat.Value
              else begin
                if FParamShowThousandSeparator then
                  mask := ',0'
                else
                  mask := '0';
                if mtFieldsDataTypeLength.Value > 0 then
                  mask := mask + '.' + SpolFunkce.StrFillChar('0',
                    mtFieldsDataTypeLength.Value);
              end;
              TFloatField(Fields[i]).DisplayFormat := mask;
              TFloatField(Fields[i]).EditFormat := mask;
              if mtFieldsInvertAlignment.Value then
                TFloatField(Fields[i]).Alignment := taLeftJustify
              else
                TFloatField(Fields[i]).Alignment := taRightJustify;
            end
            //currency
            else if Fields[i] is TCurrencyField then begin
              if mtFieldsDisplayFormat.Value <> '' then
                mask := mtFieldsDisplayFormat.Value
              else begin
                if FParamShowThousandSeparator then
                  mask := ',0'
                else
                  mask := '0';
                if mtFieldsDataTypeLength.Value > 0 then
                  mask := mask + '.' + SpolFunkce.StrFillChar('0',
                    mtFieldsDataTypeLength.Value);
              end;
              TCurrencyField(Fields[i]).DisplayFormat := mask;
              TCurrencyField(Fields[i]).EditFormat := mask;
              if mtFieldsInvertAlignment.Value then
                TCurrencyField(Fields[i]).Alignment := taLeftJustify
              else
                TCurrencyField(Fields[i]).Alignment := taRightJustify;
            end
            //date
            else if Fields[i] is TDateField then begin
              if mtFieldsDisplayFormat.Value <> '' then
                mask := mtFieldsDisplayFormat.Value
              else
                mask := 'd.m.yyyy';
              TDateTimeField(Fields[i]).DisplayFormat := mask;
              if mtFieldsInvertAlignment.Value then
                TDateField(Fields[i]).Alignment := taRightJustify
              else
                TDateField(Fields[i]).Alignment := taLeftJustify;
            end;
          end;
          //plneni dat
          if not AForRunTimeMode and FIsDesignMode then begin //v modu navrhu
            if Fields[i] is TStringField then begin
              if mtFields.FindKey([UpperCase(Fields[i].FieldName)]) then
                Fields[i].Value := mtFieldsCaption.Value
              else
                Fields[i].Value := Fields[i].FieldName;
            end;
          end
          else begin //v modu editace
            if Fields[i] is TBooleanField then
              Fields[i].Value := FALSE;
          end;
        end;
        Post;
      end;
    end;
  finally
    mtValues.ReadOnly := ro;
    mtValues.EnableControls;
    ConnectMtValues;
    StopWait;
  end;
end; {GenMtValues}

function TfaMain.StoreMtValuesDef: string;
var
  i: integer;
  s: string;
begin
  StartWait;
  try
    with mtValues do begin
      for i := 0 to Fields.Count - 1 do begin
        s := Fields[i].FieldName + ',' +
          IntToStr(Integer(Fields[i].DataType)) + ',' +
          IntToStr(Fields[i].Size) + ',';

        if Fields[i] is TStringField then begin
          s := s + IntToStr(Integer(TStringField(Fields[i]).Alignment)) + ',' +
            '' + ',' +
            '';
        end else if Fields[i] is TIntegerField then begin
          s := s + IntToStr(Integer(TIntegerField(Fields[i]).Alignment)) + ',' +
            '"' + TIntegerField(Fields[i]).DisplayFormat + '",' +
            '"' + TIntegerField(Fields[i]).EditFormat + '"';
        end
        else if Fields[i] is TFloatField then begin
          s := s + IntToStr(Integer(TFloatField(Fields[i]).Alignment)) + ',' +
            '"' + TFloatField(Fields[i]).DisplayFormat + '",' +
            '"' + TFloatField(Fields[i]).EditFormat + '"';
        end
        else if Fields[i] is TDateTimeField then begin
          s := s + IntToStr(Integer(TDateTimeField(Fields[i]).Alignment)) + ','
            +
            '"' + TDateTimeField(Fields[i]).DisplayFormat + '",' +
            '';
        end
        else if Fields[i] is TCurrencyField then begin
          s := s + IntToStr(Integer(TCurrencyField(Fields[i]).Alignment)) + ','
            +
            '"' + TCurrencyField(Fields[i]).DisplayFormat + '",' +
            '"' + TCurrencyField(Fields[i]).EditFormat + '"';
        end
        else begin
          s := s + '0' + ',' +
            '' + ',' +
            '';
        end;
        AddStrLine(Result, s);
      end;
    end;
  finally
    StopWait;
  end;
end; {StoreMtValuesDef}

function TfaMain.RestoreMtValuesDef(const ADefString: string): boolean;
var
  i: integer;
  ro: boolean;
  sl, sl1: TStringList;
  fld: TField;
begin
  Result := FALSE;
  StartWait;
  CEdit.DataBinding.DataField := '';
  mtValues.DisableControls;
  ro := mtValues.ReadOnly;
  mtValues.ReadOnly := FALSE;
  sl := TStringList.Create;
  sl1 := TStringList.Create;
  try
    with mtValues do begin
      if Active then
        Close;
      DeleteTable;
      FieldDefs.Clear;
      sl.Text := ADefString;
      for i := 0 to sl.Count - 1 do begin
        sl1.CommaText := sl[i];
        FieldDefs.Add(sl1[0], TFieldType(StrToInt(sl1[1])),
          StrToInt(sl1[2]), FALSE);
        fld := FieldDefs.Items[i].CreateField(mtValues);
        with fld do begin
          if fld is TStringField then begin
            TStringField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
          end
          else if fld is TIntegerField then begin
            TIntegerField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TIntegerField(fld).DisplayFormat := sl1[4];
            TIntegerField(fld).EditFormat := sl1[5];
          end
          else if fld is TFloatField then begin
            TFloatField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TFloatField(fld).DisplayFormat := sl1[4];
            TFloatField(fld).EditFormat := sl1[5];
          end
          else if fld is TDateTimeField then begin
            TDateTimeField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TDateTimeField(fld).DisplayFormat := sl1[4];
          end
          else if fld is TCurrencyField then begin
            TCurrencyField(fld).Alignment := TAlignment(StrToInt(sl1[3]));
            TCurrencyField(fld).DisplayFormat := sl1[4];
            TCurrencyField(fld).EditFormat := sl1[5];
          end;
        end;
      end;
      Open;
      Append;
      //
      FIsLoadingData := TRUE; //aby se neprovadelo calculate
      try
        Post;
      finally
        FIsLoadingData := FALSE;
      end;
      //zapis indexu fieldu
      for i := 0 to FieldList.Count - 1 do begin
        if mtFields.FindKey([UpperCase(FieldList[i].FieldName)]) then begin
          mtFields.Edit;
          mtFieldsFieldIndex.Value := i;
          mtFields.Post;
        end;
      end;
    end;
    Result := TRUE;
  finally
    mtValues.EnableControls;
    mtValues.ReadOnly := ro;
    sl.Free;
    sl1.Free;
    StopWait;
  end;
end; {RestoreMtValuesDef}

