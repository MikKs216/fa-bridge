procedure TfaMain.OpenStringsFromAppendix;
{$IFNDEF STANDALONE}
const
  cTxtEditor = 'TXTEDITOR';
var
  resStr: Variant;
  s: string;
  curItemNo, offsetInCurItem: integer;
{$ENDIF STANDALONE}
begin
{$IFNDEF STANDALONE}
  curItemNo:=reNotes.RichViewEdit.CurItemNo;
  offsetInCurItem:=reNotes.RichViewEdit.OffsetInCurItem;
  SeletCurrentDotsWord;
  s:=reNotes.RichViewEdit.GetSelText;
  reNotes.RichViewEdit.SetSelectionBounds(curItemNo, offsetInCurItem,
    curItemNo, offsetInCurItem);
