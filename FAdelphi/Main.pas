{-----------------------------------------------------------------------------
 GetValuesData
   Transformuje neformatovane hodnoty udaju do textu ve tvaru
   nazev_udaje=textova_hodnota v normalizovanem tvaru (des.tecka,dateseparator)
 -----------------------------------------------------------------------------}

function TfaMain.GetValuesData(AWithEmptyValues: boolean = FALSE): string;
var
  sl: TStringList;
  i: integer;
  enableOutput: boolean;
begin
  sl := TStringList.Create;
  try
    with mtValues do begin
      if Active and (RecordCount > 0) then begin
        for i := 0 to Fields.Count - 1 do begin
          if AWithEmptyValues then
            enableOutput := TRUE
          else if Fields[i] is TStringField then
            enableOutput := TStringField(Fields[i]).Value <> ''
          else if Fields[i] is TIntegerField then
            enableOutput := TIntegerField(Fields[i]).AsString <> ''
          else if Fields[i] is TFloatField then
            enableOutput := TFloatField(Fields[i]).AsString <> ''
          else if Fields[i] is TDateField then
            enableOutput := TDateField(Fields[i]).AsString <> ''
          else if Fields[i] is TDateTimeField then
            enableOutput := TDateTimeField(Fields[i]).AsString <> ''
          else if Fields[i] is TBooleanField then
            enableOutput := TBooleanField(Fields[i]).Value
          else if Fields[i] is TMemoField then
            enableOutput := TMemoField(Fields[i]).AsString <> ''
          else
            enableOutput := TRUE;
          //
          if enableOutput then
            sl.Add(Fields[i].FieldName + '=' +
              FieldToString(Fields[i],
              VarToInt(mtFields.Lookup(mtFieldsName.FieldName,
              UpperCase(Fields[i].FieldName),
              mtFieldsDataTypeLength.FieldName))));
        end;
      end;
    end;
    Result := sl.Text;
  finally
    sl.Free;
  end;
end; {GetValuesData}

{-----------------------------------------------------------------------------
 GetDataForPrint
   Transformuje hodnoty udaju do textu ve tvaru nazev_udaje=textova_hodnota.
   Pouzije se oddelovani tisicu na zaklade parametru. Formatovani je
   dle nastaveni Windows.
 -----------------------------------------------------------------------------}

function TfaMain.GetDataForPrint(AZeroValueClear,
  ANulNumValueFillZero: boolean): string;
var
  sl: TStringList;
  i: integer;
begin
  GInternalDataForPrint := ''; //muze naplnit BeforePrint ve scriptu
  DoBeforePrint;
  //
  sl := TStringList.Create;
  try
    with mtValues do begin
      if Active and (RecordCount > 0) then begin
        for i := 0 to Fields.Count - 1 do
          sl.Add(Fields[i].FieldName + '=' +
            FieldToStringFmt(Fields[i], AZeroValueClear, ANulNumValueFillZero,
            VarToInt(mtFields.Lookup(mtFieldsName.FieldName,
            UpperCase(Fields[i].FieldName),
            mtFieldsDataTypeLength.FieldName)), FParamShowThousandSeparator));
      end;
    end;
    Result := sl.Text;
    if GInternalDataForPrint <> '' then
      Result := Result + cCRLF + GInternalDataForPrint;
        //pripojit pripadna dodatecna data
  finally
    sl.Free;
  end;
end; {GetDataForPrint}

{-----------------------------------------------------------------------------
 PreviewForm
   Otevre nahled
 -----------------------------------------------------------------------------}

function TfaMain.PreviewForm(const AReportDef: string;
  APrint, AMail, AOnlyPrepareFile: boolean;
  AReportSettings: TReportSettings;
  const ADstFileName: string = ''): string;
var
  dstFile, comm, clientName: string;
begin
  Result:='';
  if APrint then
    LogStat('P:t')
  else if AMail then
    LogStat('P:m')
  else if AOnlyPrepareFile then
    LogStat('P:o')
  else
    LogStat('P:n');

  if PrepareDirWork then begin
    if FileExists(AReportDef) or FReportVariantsIsFR3 then begin
      if FileExists(AReportDef) then
        UnzipReportDefs(AReportDef);
      if {FNestedPrepareReportState and} (ADstFileName<>'') then
        dstFile:=ADstFileName
      else begin
        {puvodne
        //upraven nazev vystupniho souboru na lidstejsi
        dstFile:=Str1250ToANSI(SetValidFileNameTrim(mtDefName.Value)) + '.pdf';
        }
        //popisny nazev souboru
        comm := GetListItem(GetPeriod, 3) + ' ' + GetSysComment;
        if comm <> '' then
          comm := ', ' + comm;
        clientName:=Copy(PrepareClientAdress,1,40);
        dstFile := SetValidFileNameTrim(Copy(mtDefName.Value,1,60) + comm + ' - ' +
          clientName + cPDFDefaultExt);
      end;
      Result:=OpenPDFReport(GetPdfFileNameCsvList, GetPdfNestedFileNameCsvList,
        GetDataForPrint(AReportSettings.ZeroValueClear,
        AReportSettings.NulNumValueFillZero), dstFile,
        APrint, AMail, AOnlyPrepareFile, AReportSettings, Caption);
    end
    else
      MessageInfo(Caption, sNotExistReportDefFile, [MBOK]);
  end;
end; {PreviewForm}

{-----------------------------------------------------------------------------
 PreviewSimpleReport
   Otevre nahled jednoduche sestavy jejiz nazev predlohy pdf je zadan
   v AReportName
 -----------------------------------------------------------------------------}

procedure TfaMain.PreviewSimpleReport(const AReportName: string);
var
  fdrFileName: string;
  reportSettings: TReportSettings;
begin
  if PrepareDirWork then begin
    fdrFileName := NormalPath(ExtractFilePath(FDefFileName)) +
      mtDefID.Value + cReportDefaultExt;
    if FileExists(fdrFileName) then begin
      UnzipReportDefs(fdrFileName);
      reportSettings := ApplyRestrictReportOptions(
        LoadReportSettings(GetIniFileName));
      reportSettings := ApplyAllPages(reportSettings);
      OpenPDFReport(ChangeFileExt(ExtractFileName(AReportName), '.pdf'),'',
        GetDataForPrint(reportSettings.ZeroValueClear,
        reportSettings.NulNumValueFillZero),
        ChangeFileExt(ExtractFileName(AReportName), '.pdf'),
        FALSE, FALSE, FALSE, reportSettings, Caption);
    end
    else
      MessageInfo(Caption, sNotExistReportDefFile, [MBOK]);
  end;
end; {PreviewSimpleReport}

{-----------------------------------------------------------------------------
 SendFormViaEmail
   Posle sestavu mailem
 -----------------------------------------------------------------------------}

//vraci true kdyz uzivatel odeslal do datove schranky
function TfaMain.SendFormViaEmail(const AReportDef: string;
  AReportSettings: TReportSettings; const AEmailAdr: string;
  AOnlyPreparePDF: boolean = FALSE;
  const APrilohy: string = ''; const APredmetZpravy: string = ''): boolean;
var
  reportSettings: TReportSettings;
  clientName, fn, txt, addText, predmet: string;
  doChangeFDFPrint: boolean;
begin
  Result:=false;
  if PrepareDirWork then begin
    if FileExists(AReportDef) then begin
      if not AReportSettings.PrintForm or not AReportSettings.PrintValues then begin
        if MessageAsk(Caption, sMsgSendViaEmailOnlyFormOrValues, [MBYES, MBNO])=ID_YES then begin
          AReportSettings.PrintForm:=True;
          AReportSettings.PrintValues:=True;
        end;
      end;
      UnzipReportDefs(AReportDef);
      {comm := GetSysComment;
      if comm <> '' then
        comm := ', ' + comm;}
      reportSettings := ApplyAllPages(AReportSettings);
      clientName:=Copy(PrepareClientAdress,1,40);
      txt:=GetListItem(GetPeriod, 3)+' ';
      if txt=' ' then
        txt:='';
      addText:=txt;
      txt:=GetSysComment+' ';
      if txt=' ' then
        txt:='';
      addText:=addText+txt;
      fn:=SetValidFileNameTrim(
        Copy(mtDefName.Value,1,60) + ', ' + addText + clientName + cPDFDefaultExt);
      if FLocalVersion = cLocalVersionSK then begin
        if StrToBoolSafe(GetStringLineValue(GetReportSettings,cRepIniKeyFDFPrint)) then begin
          doChangeFDFPrint:=true;
          SaveReportSettingsFDFPrint(false);
        end;
        try
        predmet := fn;
        if APredmetZpravy <> '' then
          predmet := APredmetZpravy;

          Result:=SendPDFReportViaEmail(GetPdfFileNameCsvList, GetPdfNestedFileNameCsvList,
            GetDataForPrint(AReportSettings.ZeroValueClear,
            AReportSettings.NulNumValueFillZero),
            SetValidFileNameTrim(mtDefName.Value) {+ comm} + cPDFDefaultExt,
            reportSettings, predmet, AEmailAdr, AOnlyPreparePDF, APrilohy);
        finally
          if doChangeFDFPrint then
            SaveReportSettingsFDFPrint(true);
        end;
      end
      else begin
        predmet := fn;
        if APredmetZpravy <> '' then
          predmet := APredmetZpravy;

        Result:=SendPDFReportViaEmail(GetPdfFileNameCsvList, GetPdfNestedFileNameCsvList,
          GetDataForPrint(AReportSettings.ZeroValueClear,
          AReportSettings.NulNumValueFillZero),
          SetValidFileNameTrim(mtDefName.Value) {+ comm} + cPDFDefaultExt,
          reportSettings, predmet, AEmailAdr, AOnlyPreparePDF, APrilohy);
      end;
    end
    else
      MessageInfo(Caption, sNotExistReportDefFile, [MBOK]);
  end;
end; {SendFormViaEmail}

function TfaMain.GetDefReportScript(AScriptProcName: string): string;
var
  scr: string;
begin
  Result := '';
  //
  scr := TranslateFieldNames(mtDefReportScript.Value);
  if FNewScripter then begin
    workScripterT.SourceCode.Text := scr;
    workScripterT.Compile;
    if workScripterT.ScriptInfo.RoutineByName(AScriptProcName) <> nil then
      Result := workScripterT.ExecuteSubroutine(AScriptProcName);
  end
  else begin
    WorkScripter.Script.Clear;
    WorkScripter.Script.Add(scr);
    Result := WorkScripter.CallNoParamsMethod(AScriptProcName);
  end;
end; {GetDefReportScript}

