                  mxstatusbar1.panels[4+i].hint := format(ssbhasreportvariantslng, [ssbreportvariantfr]);
                  mxstatusbar1.panels[4+i].onclick := previewrepvarfrclick;
                end
                else if getlistitem(replnglists, i) = crepvarit then begin
                  mxstatusbar1.panels[4+i].imageindex := 130;
                  mxstatusbar1.panels[4+i].hint := format(ssbhasreportvariantslng, [ssbreportvariantit]);
                  mxstatusbar1.panels[4+i].onclick := previewrepvaritclick;
