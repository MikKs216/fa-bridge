        {mtFieldsInfo.Locate(mtFieldsInfoName.FieldName, //opt
        fldName, [])}and (mtFieldsInfoInstruction.Value <> '') then begin
        TMemoField(mtFieldsInfoInstruction).SaveToStream(st);
        st.Seek(0, soFromBeginning);
        reInfo.Clear;
        reInfo.LoadRTFFromStream(st);
        reInfo.Format;
      end;
    finally
      st.Free;
    end;
  end;
end; {ShowFieldInstruction}

function TfaMain.ReleaseControlStrings(const AInstructStr: string;
  AForField: boolean = TRUE): string;
var
  isFldLab, isTextLab, isControlChar: boolean;
  i: integer;
  prevchar,curchar,nextchar: char;
begin
  StartWait;
  try
    Result := '';
    isFldLab := FALSE;
    isTextLab := FALSE;
    for i := 1 to Length(AInstructStr) - 1 do begin
      if i>1 then
        prevchar := AInstructStr[i - 1]
      else
        prevchar := #0; //neexistujici znak nahradime znakem #0
      curchar := AInstructStr[i];
      nextchar := AInstructStr[i+1];
      //
      if (curchar = '[') and (nextchar = '_') then
        isFldLab := TRUE;
      if (curchar = '[') and (nextchar = '=') then
        isFldLab := TRUE;
      //vypusteni casti, ktere nejsou pro urceny typ zobrazeni
      if AForField then begin
        if (curchar = '[') and (nextchar = '*') then
          isTextLab := TRUE;
      end
      else begin
        if (curchar = '[') and (nextchar = '+') then
          isTextLab := TRUE;
      end;
      isControlChar :=
        (curchar = '[') and (nextchar = '*') or
        (curchar = '[') and (nextchar = '+') or
        (prevchar = '[') and (curchar = '*') or
        (prevchar = '[') and (curchar = '+') or
        (curchar = '*') and (nextchar = ']') or
        (curchar = '+') and (nextchar = ']') or
        (prevchar = '*') and (curchar = ']') or
        (prevchar = '+') and (curchar = ']');
      //
      if not isFldLab and not isTextLab and not isControlChar then
        Result := Result + AInstructStr[i];
      //
      if (prevchar = '_') and (curchar = ']') then
        isFldLab := FALSE;
      if (prevchar = '=') and (curchar = ']') then
        isFldLab := FALSE;
      if (prevchar = '+') and (curchar = ']') then
        isTextLab := FALSE;
      if (prevchar = '*') and (curchar = ']') then
        isTextLab := FALSE;
    end;
    Result := Result + AInstructStr[Length(AInstructStr)];
  finally
    StopWait;
  end;
end; {ReleaseControlStrings}

//vytahne cast textu z pokynu k udaji

function TfaMain.ExtractFieldInstruction(const AFieldName: string): string;
const
  cParTag = '\par' + cCRLF;
var
  p: integer;
  s: string;
begin
  Result := '';
  s := mtDefInstructions.Value;
  repeat
    p := Pos(cBegFldInfoTagStart + AFieldName + cBegFldInfoTagStop, s);
    if p > 0 then begin
      s := Copy(s, p + Length(AFieldName) + Length(cBegFldInfoTagStart) +
        Length(cBegFldInfoTagStop), maxint);
      p := Pos(cEndFldInfoTag, s);
      if p > 0 then begin
        if Result <> '' then
          Result := Result + cParTag + cParTag + Copy(s, 1, p - 1)
            //vlozime novy odstavec
        else
          Result := Result + Copy(s, 1, p - 1);
        s := Copy(s, p + Length(cEndFldInfoTag), maxint);
      end
      else begin
        Result := Result + s;
        s := '';
      end;
    end;
  until p = 0;
  if Result <> '' then
    Result := ReleaseControlStrings(cBegRtf1 + cCRLF + cBegRtf2 + Result +
      cEndRtf, TRUE);
end; {ExtractFieldInstruction}

//naplni pokyny k udajum do mtFieldsInfo z celeho textu v mtDefInstruction

procedure TfaMain.CalcFieldInstructions;
var
  s, fldName: string;
begin
  StartWait;
  {controlsEnabled := not mtFields.ControlsDisabled;
  mtFields.DisableControls;}
  try
    mtFieldsInfo.Open;
    mtFieldsInfo.EmptyTable;
    mtFields.First;
    while not mtFields.EOF do begin
      fldName := mtFieldsCaption.Value;
      if IsTableField(fldName) then
        fldName := Copy(fldName, 6, maxint);
      s := ExtractFieldInstruction(fldName);
      if s <> '' then begin
        //kopie do mtFieldsInfo
        if not mtFieldsInfo.FindKey([UpperCase(fldName)])
          {mtFieldsInfo.Locate(mtFieldsInfoName.FieldName,
          fldname, [])}then begin
          mtFieldsInfo.Append;
          mtFieldsInfoName.Value := UpperCase(fldName);
          TMemoField(mtFieldsInfoInstruction).Value := s;
          mtFieldsInfo.Post;
        end;
      end;
      mtFields.Next;
    end;
  finally
    {if controlsEnabled then
      mtFields.EnableControls;}
    StopWait;
  end;
end; {CalcFieldInstructions}

