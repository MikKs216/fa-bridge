procedure TfaMain.ShowFormInfo;
var
  s, comm, char, period: string;
begin
  s := '';
  if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
    AddStringLine(s, FormatInfoString(sDefName, mtDefName.Value));
    AddStringLine(s, FormatInfoString(sDefVersion, mtDefFormVersion.AsString+' ('+mtDefReportVersion.AsString+')'));
    AddStringLine(s, FormatInfoString(sDefID, mtDefID.AsString + Cond(FNewScripter, '*', '')));
    AddStringLine(s, '');
    //
    if mtTskpCreateDate.Value > 0 then
      AddStringLine(s, FormatInfoString(sCreateDateCaption,
        mtTskpCreateDate.AsString));
    if mtTskpModifiedDate.Value > 0 then
      AddStringLine(s, FormatInfoString(sModifiedDateCaption,
        mtTskpModifiedDate.AsString));
    AddStringLine(s, FormatInfoString(sModifiedTimeCaption,
      Format(sModifiedTimeValueCaption,
      [mtTskpModifiedTime.Value div 60, mtTskpModifiedTime.Value mod 60])));
    AddStringLine(s, FormatInfoString(sWorkStateCaption,mtTskpWorkState.AsString+' %'));
    if mtTskpExpirationDate.Value <> '' then
      AddStringLine(s, FormatInfoString(sExpirationDateCaption,
        mtTskpExpirationDate.AsString));


    AddStringLine(s, FormatInfoString(sPageCountCaption,
      IntToStr(mtContent.RecordCount - 2)));
    AddStringLine(s, FormatInfoString(sFieldCountCaption,
      IntToStr(mtFields.RecordCount)));

    {$IFNDEF FINALBUILD}
    AddStringLine(s, FormatInfoString(sScriptLinesCountCaption,
      IntToStr(GetStringLinesCount(mtDefScript.AsString))));
    {$ENDIF FINALBUILD}

    if FStateFormLocked then
      AddStringLine(s, sFormLockedCaption);
    if FStateFormDisabledCalc then
      AddStringLine(s, sFormDisabledCalcCaption)
    else if IsSomeFldsDisabledCalc then
      AddStringLine(s, sFormDisabledCalcSomeFldsCaption);
    //s:=s+sAutorCaption+': '+mtTskpAutor.Value+cCRLF;
    //

    AddStringLine(s, '');
    if mtTskpFillingDate.Value <> '' then
      AddStringLine(s, FormatInfoString(sFillingDateCaption,
        mtTskpFillingDate.AsString));
    if mtTskpFillingNumber.Value <> '' then
      AddStringLine(s, FormatInfoString(sFillingNumberCaption,
        mtTskpFillingNumber.AsString));
    //U podani pres DS vypiseme info o podani
    if Pos(cDSfilled,mtTskpFillingTimeStampSignature.Value)>0 then
      AddStringLine(s, FormatInfoString(sFillingDatovaSchranka,
        Replace(cDSfilled+':',mtTskpFillingTimeStampSignature.Value,'')+' datovou schránkou'))
    //u EPO vypiseme id certifikatu
    else if Pos(cEPOfilled,mtTskpFillingTimeStampSignature.Value)>0 then
      AddStringLine(s, FormatInfoString(sFillingCertInfo,
        Replace(cEPOfilled+': ',Copy(mtTskpFillingTimeStampSignature.Value,
          Pos(cEPOfilled, mtTskpFillingTimeStampSignature.Value),
          Length(mtTskpFillingTimeStampSignature.Value)),'')));
    //
    if mtTskpFillingState.Value>0 then
      AddStringLine(s, FormatInfoString(sFillingStateCaption,
        mtTskpcFillingStateCaption.AsString));

    //informace z tiskopisu
    period := GetListItem(GetPeriod, 3);
    comm := GetSysComment;
    char := GetCharacteristics;
    if (period <> '') or (comm <> '') or (char <> '') then begin
      AddStringLine(s, '');
      AddStrLine(s, FormatInfoString(sCharacteristicCaption, ''));
    end;
    if period <> '' then
      AddStringLine(s, period);
    if comm <> '' then
      AddStringLine(s, comm);
    if char <> '' then begin
      AddStringLine(s, '');
      s := s + char;
    end;
    //
{$IFDEF STANDALONE}
    MessageInfo(sFormInfoCaption, s, [MBOK]);
{$ELSE STANDALONE}
    DoOpenMemo(sFormInfoCaption, s, true);
{$ENDIF STANDALONE}
  end
  else
    MessageInfo(Caption, sNotExistInfo, [MBOK]);
end; {ShowFormInfo}

