function TfaMain.GetMTVField(const AFieldName: string): TField;
var dataTypeLength: integer;
begin
  Result := GetMTVFieldAndType(AFieldName, dataTypeLength);
end;

function TfaMain.GetMTVFieldAndType(const AFieldName: string;
  out aDataTypeLength: integer): TField;
begin
  Result := nil;
  if not mtFields.Active then
    raise Exception.Create(Format(sMsgErrMTVField,[AFieldName,'mtFields not open']));
  if not mtValues.Active then
    raise Exception.Create(Format(sMsgErrMTVField,[AFieldName,'mtValues not open']));
  if mtFields.FindKey([UpperCase(AFieldName)]) then begin
    try
      Result := mtValues.FieldList[mtFieldsFieldIndex.Value];
      aDataTypeLength := mtFieldsDataTypeLength.Value;
    except
      on E: Exception do
        {raise Exception.Create(Format(sMsgErrMTVField,[AFieldName,E.Message]));}
        MessageErr(Caption,
          Format(sMsgErrMTVField,[AFieldName,E.Message]), [MBOK]);
    end;
  end;
end;

//zatim nepouzito
//mela by pro pouziti v TranslateFieldNames (v DoTranslate), ale ta je zakomentarovana
function TfaMain.GetMTVFieldAsType(const AFieldName: string): string;
var fld: TField;
  dataTypeLength: integer;
begin
  fld:=GetMTVFieldAndType(AFieldName,dataTypeLength);
  if fld<>nil then begin
    if fld.DataType = ftFloat then
      Result:=''').AsFloat '
    else if fld.DataType = ftCurrency then
      Result:=''').AsCurrency '
    else if fld.DataType = ftString then
      Result:=''').AsString '
    else if fld.DataType = ftInteger then
      Result:=''').AsInteger '
    else if fld.DataType = ftDate then
      Result:=''').AsDateTime '
    else if fld.DataType = ftBoolean then
      Result:=''').AsBoolean '
    else if fld.DataType = ftMemo then
      Result:=''').AsString '
    else
      Result:=''').Value ';
  end
  else
    Result:=''').Value ';
end;

function TfaMain.GetMTVFieldValue(const AFieldName: string; const AValueType: string): Variant;
var fld: TField;
  dataTypeLength: integer;
begin
  fld:=GetMTVFieldAndType(AFieldName,dataTypeLength);
  if fld<>nil then begin
    if (fld.DataType = ftFloat)or(fld.DataType = ftCurrency) then begin
      Result:=RoundAri(fld.AsFloat,-1*dataTypeLength);
      if AValueType = '=]' then
        Result:=FloatToStr(Result);
    end
    else begin
      if AValueType = '=]' then
        Result:=fld.AsString
      else begin
        if fld.DataType = ftString then
          Result:=fld.AsString
        else if fld.DataType = ftInteger then
          Result:=fld.AsInteger
        else if fld.DataType = ftDate then
          Result:=fld.AsDateTime
        else if fld.DataType = ftBoolean then
          Result:=fld.AsBoolean
        else if fld.DataType = ftMemo then
          Result:=fld.AsString
        else
          Result:=VarNull;
      end;
    end;
  end
  else
    Result:=VarNull;
end;

//Ulozi do souboru skripty z formularu, ktere jsou umisteny v APath nebo pokud je to soubor fde tak z nej
procedure TfaMain.ScriptExp(APath: string);
var
  i: integer;
  defFileName, scr: string;
  sl: TStringList;
begin
  StartWait;
  sl:=TStringList.Create;
  try
    scr:='';

    if not IsDirectory(APath) and (ExtractFileExt(APath)=cDefDefaultExt) then begin
      sl.Add(ExtractFileName(APath));
      APath:=NormalPath(ExtractFilePath(APath));
    end
    else
      BuildFileList(NormalPath(APath)+'*.fde',faAnyFile,sl);
    //
    for i:=0 to sl.Count-1 do begin
      defFileName:=sl[i];

      OpenFileDef(NormalPath(APath)+defFileName);

      ApplyMainCaption(FDefFileName);
      ShowHintSb(IntToStr(i)+'/'+IntToStr(sl.Count));

      scr:=scr+#13#10+
           '%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%'+#13#10+
           'IDDEF: '+mtDefID.Value+#13#10+
           'NAME: '+mtDefName.Value+#13#10+
           mtDefScript.Value+#13#10+
           'REPORT SCRIPT: '+#13#10+
           mtDefReportScript.Value+#13#10#13#10;

      FStateFormWasChanged:=FALSE;
      CloseDef;
    end;
    SaveStringToFile(scr,NormalPath(GetExePath)+'Scripts.txt');
  finally
    sl.Free;
    StopWait;
  end;
end;

// procedura na export definic formularu (puvodne na automaticky prevod struktur definic)
procedure TfaMain.ExportScriptu;
var
  i, n: integer;
  defFileName, scr, msg, aktfrm, fn: string;
  sl, sl1: TStringList;

begin
  with OpenDialog1 do begin
    DefaultExt := cDefDefaultExt;
    Filter := cDefOpenSaveFilter;
    Options := Options+[ofAllowMultiSelect];
    if Execute then begin
      SaveStringToFile('',NormalPath(GetExePath)+'ChangeStructLog.txt');
      sl:= TStringList.Create;
      sl1:= TStringList.Create;
      aktfrm:='';
      if FileExists(NormalPath(GetExePath)+'aktualnifrm.txt') then begin
        aktfrm := LoadStringFromFile(NormalPath(GetExePath)+'aktualnifrm.txt');
        sl1.Text := aktfrm;
        sl1.Sorted := true;
      end;
      scr:='';
      for i:=0 to GetStringLinesCount(Files.Text)-1 do begin
        defFileName:=GetStringLine(Files.Text, i);

        fn := ExtractFileName(defFileName);
        fn := Copy(fn, 1, Length(fn) - 4);
        if ((sl1.Count = 0) or (sl1.Find(fn,n))) and
          (Copy(ExtractFileName(defFileName),1,2) <> 'dx') then begin

          Caption := fn;
          OpenFileDef(defFileName);
          //ApplyMainCaption(FDefFileName);

          //{pro zmenu struktur povolit, jinak nastaveno jen pro ulozeni sriptu do scripts.txt
          {CreateMtTskp(mtDefID.Value);
          SaveDataDef(FDefFileName);}

          {pokud se meni struktura parametru klienta tak pro vypis starych pouzitych udaju
          if Pos('PNFromStreet',mtDefScript.Value)>0 then
            sl.Add(mtDefID.Value+' (PNFromStreet)');
          if Pos('taAdresfillDbl',mtDefScript.Value)>0 then
            sl.Add(mtDefID.Value+' (taAdresfillDbl)');
          if Pos('taAdresfillStr',mtDefScript.Value)>0 then
            sl.Add(mtDefID.Value+' (taAdresfillStr)');
          if Pos('taAdresfillStr2',mtDefScript.Value)>0 then
            sl.Add(mtDefID.Value+' (taAdresfillStr2)');
          if Pos('taAdresfillBool',mtDefScript.Value)>0 then
            sl.Add(mtDefID.Value+' (taAdresfillBool)');}

          ShowHintSb(IntToStr(i)+'/'+
            IntToStr(GetStringLinesCount(Files.Text)-1));

  {        scr:=scr+#13#10+
               '%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%'+#13#10+
               'IDDEF: '+mtDefID.Value+#13#10+
               'NAME: '+mtDefName.Value+#13#10+
               mtDefScript.Value+#13#10+
               'REPORT SCRIPT: '+#13#10+
               mtDefReportScript.Value+#13#10#13#10+
               ConvertDesigConvertFDEtoFDEXnToTxt+#13#10#13#10;
   }
            try
{$IFNDEF FINALBUILD}
              ConvertFDEtoFDEX;
{$ENDIF FINALBUILD}
            except
              on E: Exception do begin
                msg := msg + ' ' + mtDefID.Value + ' err: ' + E.Message + cCRLF;
              end;
            end;
        end;
      end;

      //SaveStringToFile(msg, NormalPath(GetExePath)+'Export\_exportDef-log.txt');

      SaveStringToFile(scr,NormalPath(GetExePath)+'Scripts.txt');
      sl.SaveToFile(NormalPath(GetExePath)+'ChangeStructLogUprav.txt');
      sl.Free;
      sl1.Free;
      FStateFormWasChanged:=FALSE;
      CloseDef;
      if Length(LoadStringFromFile(NormalPath(GetExePath)+
        'ChangeStructLog.txt'))>0 then
        MessageInfo('','Převod definic dokončen. Výpis chyb je v souboru '+
          NormalPath(GetExePath)+'ChangeStructLog.txt',[MBOK])
      else
        MessageInfo('','Hotovo. Vytvořen soubor '+NormalPath(GetExePath)+'Scripts.txt' + ' a export definic ve složce Export',[MBOK]);
    end;
  end;
end;

