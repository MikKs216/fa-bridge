function TfaMain.GetReportVariantsTexts(const AReportVariants: string): string;
var
  iniFileName, st: string;
  sl: TStringList;
  i: integer;
  iniFile: TMemIniFile;
begin
  Result := '';
  iniFileName := GetReportIniFileName;
  if FileExists(iniFileName) then begin
    iniFile := TMemIniFile.Create(iniFileName);
    sl := TStringList.Create;
    sl.CommaText := Replace(' ',AReportVariants,'_');
    try
      for i := 0 to sl.Count - 1 do begin
        st := iniFile.ReadString(cRepIniSectionRepVar, sl[i], '');
        if st <> '' then
          AddStringLine(Result, sl[i]+'='+st);
      end;
    finally
      sl.Free;
      iniFile.Free;
    end;
  end;
end;

function TfaMain.GetReportFDFPrint: Boolean;
