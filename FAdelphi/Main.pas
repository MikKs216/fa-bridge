//Prevezme vyjmenovane udaje z jineho formulare
//  (udaje se naplni primo do formulare podel setjneho jmena)
//  AFieldList ... seznam udaju oddelenych carkami
//                 nebo * ... vsechny udaje
//  AExcludeFieldList ... udaje, ktere se namji prebirat pokud je AFieldList=*

procedure TfaMain.TakeFormFields(const AFormName: string;
  const AFieldList: string; const AExcudeFieldList: string = '');
var
  sl: TStringList;
  txt: string;
  fld: TField;
  ro, lc: boolean;
{$IFNDEF STANDALONE}
  st: TMemoryStream;
{$ENDIF STANDALONE}

  procedure TakeFields;
  var
    i: integer;
  begin
    txt := GetSection(sl.Text, cFormValuesLabel);
    ro := mtValues.ReadOnly;
    mtValues.ReadOnly := FALSE;
    lc := FIsLoadingContent;
    try
      sl.Text := txt;
      with mtValues do begin
        Edit;
        FIsLoadingContent := TRUE;
        try
          if AFieldList = '*' then begin
            for i := 0 to Fields.Count - 1 do begin
              fld := Fields[i];
              if not IsItemInList(AExcudeFieldList, fld.FieldName) then begin
                TryEditMtValues;
                StringToField(sl.Values[fld.FieldName], fld);
              end;
            end;
          end
          else begin
            for i := 0 to CountListItems(AFieldList) - 1 do begin
              fld := GetMTVField(GetListItem(AFieldList, i));
              if fld <> nil then begin
                TryEditMtValues;
                StringToField(sl.Values[fld.FieldName], fld);
              end;
            end;
          end;
        finally
          FIsLoadingContent := lc;
        end;
        Post;
      end;
    finally
      mtValues.ReadOnly := ro;
    end;
  end;

begin
{$IFDEF STANDALONE}
  sl := TStringList.Create;
  try
    if FileExists(AFormName) and (ExtractFileExt(AFormName)=cFRMXDefaultExt) then begin //#2822
      sl.Text := GetFormXMLDataText(AFormName);
      TakeFields;
    end
    else if FileExists(AFormName) or IsInteger(AFormName) then begin
      sl.Text := GetFormDataText(AFormName);
      TakeFields;
    end;
  finally
    sl.Free;
  end;
{$ELSE STANDALONE}
  sl := TStringList.Create;
  st := TMemoryStream.Create;
  try
    if GetFormFromDB(FClientID, AFormName, st) then begin
      st.Seek(0, soFromBeginning);
      sl.LoadFromStream(st);
      TakeFields;
    end
    else if IsInteger(AFormName) and //do dalsiho roku zrusit
      GetFormFromDB(StrToInt(AFormName), st) then begin
      st.Seek(0, soFromBeginning);
      sl.LoadFromStream(st);
      TakeFields;
    end;
  finally
    sl.Free;
    st.Free;
  end;
  TryEditMtValues;
{$ENDIF STANDALONE}
end; {TakeFormFields}

