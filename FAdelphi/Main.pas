//CompleteText
//  Doplneni textu ze seznamu textu pri editaci.
//  Pouziva Tag pro zapamatovani stavu pri minulem OnChange.
//

procedure TfaMain.CompleteText(AEdit: TcxDBTextEditEx);
var
  l: integer;
  t: string;
const
  zkrPrefix = '*';

  //  Vstup: Astr ... zadana cast textu
  //  Vystup: True ... pokud se jedinecny text nasel
  //          AStr ... nalezeny text
  //
  function SearchText(const AFieldName: string; var AStr: string): boolean;
  var
    zkr: string;
  begin
    with mtStoredStrings do begin
      //uplne napred hledame podle zkratky
      if Copy(AStr,1,1)=zkrPrefix then begin
        zkr:=Copy(AStr,2,20);
        //napred zkusime najit text pro vsechny formulare
        Result := mtStoredStrings.Locate(
          mtStoredStringsForAllFields.FieldName + ';' +
          mtStoredStringsZkratka.FieldName,
          VarArrayOf([TRUE, zkr]),
          [loCaseInsensitive]);
        //pak zkusime pro text konkretniho formulare
        if not Result then begin
          Result := mtStoredStrings.Locate(
            mtStoredStringsFormDefID.FieldName + ';' +
            mtStoredStringsFieldName.FieldName + ';' +
            mtStoredStringsZkratka.FieldName, VarArrayOf([mtDefID.Value,
            AFieldName, zkr]),
              [loCaseInsensitive]);
        end;
        if Result and (AnsiUpperCase(Copy(mtStoredStringsZkratka.Value,1,Length(zkr)))=AnsiUpperCase(zkr)) then
          AStr := mtStoredStringsText.Value;
      end
      else begin
        //napred zkusime najit text pro vsechny formulare
        Result := mtStoredStrings.Locate(
          mtStoredStringsForAllFields.FieldName + ';' +
          mtStoredStringsText.FieldName,
          VarArrayOf([TRUE, AStr]),
          [loPartialKey, loCaseInsensitive]);
        //pak zkusime pro text konkretniho formulare
        if not Result then begin
          Result := mtStoredStrings.Locate(
            mtStoredStringsFormDefID.FieldName + ';' +
            mtStoredStringsFieldName.FieldName + ';' +
            mtStoredStringsText.FieldName, VarArrayOf([mtDefID.Value,
            AFieldName, AStr]),
              [loPartialKey, loCaseInsensitive]);
        end;
        if Result and (AnsiUpperCase(Copy(mtStoredStringsText.Value,1,Length(AStr)))=AnsiUpperCase(AStr)) then
          AStr := mtStoredStringsText.Value;
      end;
    end;
  end; {SearchText}

begin
  if mtStoredStrings.Active and (AEdit.FldType = fldtString) then begin
    if Copy(AEdit.EditingText,1,1)=zkrPrefix then begin //hledani podle zkratky
      with AEdit do begin
        t:=EditingText;
        if SearchText(Hint, t) then begin
          EditingText:=t;
          AEdit.SelStart:=Length(t);
          AEdit.SelLength:=0;
        end;
      end;
    end
    else if FParamUseCompleteText then
      with AEdit do begin
        if Length(EditingText) >= (FParamCompleteTextNumChars - 1) then begin
          l := Length(EditingText);
          if l = Tag + 1 then begin
            t := EditingText;
            if SearchText(Hint, t) then begin
              EditingText := EditingText + Copy(t, l + 1, maxint);
              SelStart := l;
              SelLength := Length(t);
            end;
          end;
          Tag := l;
        end;
      end;
  end;
end; {CompleteText}

//SaveText
//  Ulozi text pokud v tabulce neexistuje

procedure TfaMain.SaveText(AEdit: TcxDBTextEditEx);
var
  typLocate: integer;
begin
  //pozdeji upravit na jiny parametr - rozsirit
  if FParamStoreTexts and (AEdit.Text <> '') and
    (AEdit.FldType = fldtString) and not IsInteger(AEdit.Text) and
    (Length(AEdit.Text)>=FParamCompleteTextNumChars-1) then begin
    typLocate := 0;
    if mtStoredStrings.Locate(mtStoredStringsForAllFields.FieldName + ';' +
      mtStoredStringsText.FieldName,
      VarArrayOf([TRUE, AEdit.Text]),
      [loCaseInsensitive]) then
      typLocate := 2
    else if mtStoredStrings.Locate(mtStoredStringsFormDefID.FieldName + ';' +
      mtStoredStringsFieldName.FieldName + ';' +
      mtStoredStringsText.FieldName,
      VarArrayOf([mtDefID.Value, AEdit.Hint, AEdit.Text]),
      [loCaseInsensitive]) then
      typLocate := 1;
    //
    if typLocate = 0 then begin //nenalezeny text
      mtStoredStrings.Append;
      mtStoredStringsFormDefID.Value := mtDefID.Value;
      mtStoredStringsFieldName.Value := AEdit.Hint;
      mtStoredStringsText.Value := AEdit.Text;
      mtStoredStrings.Post;
    end
    else begin
      mtStoredStrings.Edit;
      mtStoredStringsPocetPouziti.Value :=
        mtStoredStringsPocetPouziti.Value + 1;
      mtStoredStrings.Post;
    end;
  end;
end;{SaveText}

