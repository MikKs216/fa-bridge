procedure TfaMain.SetCalcEdits(AReset: boolean; ASetBorderInfo: boolean =
  FALSE);
const
  cBorderInfoColor = clMaroon;
var
  i: integer;
  c: TControl;
begin
  if not FIsDesignMode and mtFields.Active then begin
    for i := 0 to sbForm.ControlCount - 1 do begin
      c := sbForm.Controls[i];
      if (c is TfaEdit) or (c is TcxDBCheckBox) or
        (c is TcxDBMemo) then begin
        if mtFields.FindKey([UpperCase(c.Name)])
          {mtFields.Locate(mtFieldsName.FieldName, c.Name, //opt
          [loCaseInsensitive])}then begin
          if mtFieldsHasCalc.Value then begin
            if AReset then
              SetCalcControl(c, AReset)
            else
              SetCalcControl(c, not (mtFieldsIsCalculated.Value and
                not mtFieldsCalcWithoutShowing.Value));
          end;
          if ASetBorderInfo and (c is TfaEdit) then begin
            TfaEdit(c).HighlightList := mtFieldsHasList.Value;
            TfaEdit(c).HighlightDefVal := mtFieldsHasDefault.Value;
            TfaEdit(c).HighlightListColor := DarkColor(clHighLight,20){cBorderInfoColor};
            TfaEdit(c).HighlightDefValColor := DarkColor(clHighLight,20);
          end
          else if ASetBorderInfo and (c is TCxDBMemoEx) then begin
            TCxDBMemoEx(c).HighlightList := mtFieldsHasList.Value;
            TCxDBMemoEx(c).HighlightDefVal := mtFieldsHasDefault.Value;
            TCxDBMemoEx(c).HighlightListColor := DarkColor(clHighLight,20){cBorderInfoColor};
            TCxDBMemoEx(c).HighlightDefValColor := DarkColor(clHighLight,20);
          end;
        end;
      end;
    end;
    DoEnable;//opt - tady to asi musime nechat
  end;
end; {SetCalcEdits}

//nastavi pro checkboxy obsluhu OnClick

procedure TfaMain.SetCbOnClick;
var
  i: integer;
  c: TControl;
begin
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if c is TcxDBCheckBox then begin
      TcxDBCheckBox(c).OnClick := CheckBoxClick;
      LinkFldPopupMenu(c);
    end
    else if c is TcxDBMemo then begin
      LinkFldPopupMenu(c);
      TcxDBMemo(c).OnEnter := DoOnMemoEnter;
      TcxDBMemo(c).OnPostEditValue := DoOnMemoExit;
    end
    else if c is TButton then begin
      if not FIsDesignMode then
        TButton(c).OnClick := ButtonClick;
    end
    else if c is TpsvWebLabel then begin
      if not FIsDesignMode then
        TpsvWebLabel(c).OnClick := WebLabelClick;
    end
    else if c is THTMLStaticText then begin
      if not FIsDesignMode then begin
        THTMLStaticText(c).OnClick := HTMLStaticTextClick;
        THTMLStaticText(c).OnAnchorClick := HTMLStaticTextAnchorClick;
      end;
    end;
  end;
end; {SetCbOnClick}

//zobrazi nasledujici stranu

procedure TfaMain.ShowNextPage;
var
  l1,l2,l3,l4, oldPos: integer;
begin
{$IFDEF PROFILER}TimeLog('+++ Start ShowNextPage'); {$ENDIF PROFILER}
  StartWait;
  try
    // Pokud je na pozadi obrazek a nejsme na konci tak jen scrolujeme
    if (mtContentImageHeight.Value>0) or (IsPaintBoxReadyForUse) then
    begin
      with sbForm.VertScrollBar do
      begin
        oldPos:=Position;
        Position := Position + sbForm.Height;
        if Position<>oldPos then
        EXIT;
      end;
    end;

    // Na dalsi stranku
    {TryPostMtValues;}
    if not mtContent.EOF then begin begin
        FIsLoadingContent := TRUE;
        try
          SetFocusContent;
        finally
          FIsLoadingContent := FALSE;
        end;
      end;
      HideEdit;
{$IFDEF PROFILER}TimeLog('HE'); {$ENDIF PROFILER}
      l1 := mtContentPage.Value;
      l2 := mtContentSection.Value;
      l3 := mtContentLevel3.Value;
      l4 := mtContentLevel4.Value;
      mtContent.Next;
      while not mtContent.EOF and
        (l1=mtContentPage.Value) and
        (l2=mtContentSection.Value) and
        (l3=mtContentLevel3.Value) and
        (l4=mtContentLevel4.Value)
        {not FieldIsEmpty(mtContentDefaultControlName)} do
        mtContent.Next;
      LocateTreeItem;
      if TRUE {not FParamFastScroll} then begin
        if mtContentDefaultControlName.Value='' then
          FocusFirstControl
        else
          TryFocusControlByName(mtContentDefaultControlName.Value);
      end;
      ApplyFormCaption;
    end;
  finally
    StopWait;
  end;
{$IFDEF PROFILER}TimeLog('+++ End ShowNextPage'); {$ENDIF PROFILER}
end; {ShowNextPage}

//zobrazi predchozi stranu

procedure TfaMain.ShowPriorPage;
var
  oldPos: integer;

  function HasPreviousRecordSameKeys: boolean;
  var
    l1,l2,l3,l4,k: integer;
  begin
    l1 := mtContentPage.Value;
    l2 := mtContentSection.Value;
    l3 := mtContentLevel3.Value;
    l4 := mtContentLevel4.Value;
    k := mtContentKey.Value;
    mtContent.Prior;
    Result :=
      (l1=mtContentPage.Value) and
      (l2=mtContentSection.Value) and
      (l3=mtContentLevel3.Value) and
      (l4=mtContentLevel4.Value) and
      (k<>mtContentKey.Value);
    if k<>mtContentKey.Value then
      mtContent.Next;
  end;

begin
  StartWait;
  try
    // Pokud je na pozadi obrazek (nebo PDF) a nejsme na zacatku tak jen scrolujeme
    if ((mtContentImageHeight.Value>0) or (IsPaintBoxReadyForUse)) and
      ((not mtContent.BOF) or (sbForm.VertScrollBar.Position>0)) then
    begin
      with sbForm.VertScrollBar do
      begin
        oldPos:=Position;
        Position := Position - sbForm.Height;
        if Position<>oldPos then
        EXIT;
      end;
    end;

    // Na dalsi stranku
    {TryPostMtValues;}
    if not mtContent.BOF then begin
      SetFocusContent;
      HideEdit;
      mtContent.Prior;
      while HasPreviousRecordSameKeys do
        mtContent.Prior;
      LocateTreeItem;
      ApplyFormCaption;

      // Pokud je na pozadi obrazek a neni zobrazeny cely tak posuneme na posledni cast
      if (mtContentImageHeight.Value>0) then
      begin
        with sbForm.VertScrollBar do
        begin
          Position := Position + mtContentImageHeight.Value;
          EXIT;
        end;
      end;
      // ---
      // Pokud je na pozadi PDF a neni zobrazeny cely tak posuneme na posledni cast
      if (IsPaintBoxReadyForUse)  then
      begin
        with sbForm.VertScrollBar do
        begin
          Position := Position + PaintBox.Height;
          EXIT;
        end;
      end;
      // ---

      if TRUE {not FParamFastScroll} then begin
        if mtContentDefaultControlName.Value='' then
          FocusFirstControl
        else
          TryFocusControlByName(mtContentDefaultControlName.Value);
      end;
    end;

  finally
    StopWait;
  end;
end;{ShowPriorPage}

