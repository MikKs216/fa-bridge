procedure TfaMain.SetDisableClacFlag(ACalcDisable, AFromSavedForm: boolean);
begin
  if ACalcDisable then begin
    if AFromSavedForm then begin
      if {$IFDEF STANDALONE} not FSilentMsgDisableCalc and {$ENDIF STANDALONE}
      (MessageAsk(Caption, sAskDisableCalcFromSaved, [MBYES, MBNO]) = IDNO) then
        ACalcDisable := FALSE;
    end;
  end;
  FStateFormDisabledCalc := ACalcDisable;
  dxBarButtonDisableFormCalculation.Down := FStateFormDisabledCalc;
  if ACalcDisable then begin
    mxStatusBar1.Panels[2].ImageIndex := 3;
    mxStatusBar1.Panels[2].Hint := sSbHintCalcDisabled;
  end
  else begin
    mxStatusBar1.Panels[2].ImageIndex := 2;
    mxStatusBar1.Panels[2].Hint := sSbHintCalcEnabled;
  end;
  if mtTskp.Active and (mtTskp.RecordCount > 0) then
    SetFormUserSetting(cUSCalcDisabled, BoolToStr(ACalcDisable, TRUE));
end; {SetDisableClacFlag}

function TfaMain.GetFormUserSetting(const ASetting: string): string;
var
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
      sl.Text := mtTskpUserSettings.Value;
      Result := sl.Values[ASetting];
    end
    else
      Result := '';
  finally
    sl.Free;
  end;
end; {GetFormUserSetting}

procedure TfaMain.SetFormUserSetting(const ASetting, AValue: string);
var
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    if mtTskp.Active and (mtTskp.RecordCount > 0) then begin
      sl.Text := mtTskpUserSettings.Value;
      sl.Values[ASetting] := AValue;
      mtTskp.Edit;
      mtTskpUserSettings.Value := sl.Text;
      mtTskp.Post;
    end;
  finally
    sl.Free;
  end;
end; {SetFormUserSetting}

