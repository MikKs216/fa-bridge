procedure TfaMain.DoCalculate;
begin
  if FIsDesignMode or FIsChangingScript or FIsLoadingData then
    EXIT;
  //
  StartWait;
  FCanClose := FALSE;
  try
    //nepocitat, kdyz jsou vypnute vypocty nebo kdyz je formular zamknuty
    if not FStateFormDisabledCalc and not FStateFormLocked and
      not mtValues.ReadOnly then begin
      if mtFields.Active and mtValues.Active and
        (mtValues.RecordCount > 0) then begin
        TryEditMtValues;
        FScriptState := ssCalculate;
        SetGScriptFieldName;
        try
          if FNewScripter then
            ScripterT_ExecuteSubRoutine(sScriptProcName_Calculate)
          else
            Scripter.CallNoParamsMethod(sScriptProcName_Calculate);
        finally
          FScriptState := ssNoActive;
        end;
      end;
    end;
    if FDoEnableAfterCalculate then
      DoEnable;
  finally
    FCanClose := TRUE;
    StopWait;
  end;
end; {DoCalculate}

//provede vypocet init

procedure TfaMain.DoInit;
var
  preparedLists: string;
  ok: boolean;
begin
  if FIsDesignMode or FIsChangingScript or
    (FNestedState and FNestedPrepareReportState) then
    EXIT;
  //
  StartWait;
  FCanClose := FALSE;
  try
    if mtFields.Active and mtValues.Active and
      (mtValues.RecordCount > 0) and not FStateFormLocked and
      not mtValues.ReadOnly then begin
      TryEditMtValues;
      FScriptState := ssInit;
      FScriptFieldName := '';
      FPreparedListsObject := nil;
      FScriptPreparedLists := '';
      try
        if FNewScripter then
          preparedLists :=
            ScripterT_ExecuteSubRoutine(sScriptProcName_PreparedLists)
        else
          preparedLists :=
            Scripter.CallNoParamsMethod(sScriptProcName_PreparedLists);
        if (preparedLists <> '') and (CountListItems(preparedLists) > 1) and
          IsDate(GetListItem(preparedLists, 0)) then begin
          FScriptPreparedLists := Copy(preparedLists, Pos(',', preparedLists) +
            1,
            maxint);
          ok := PrepareLists(FScriptPreparedLists,
            StrToDate(GetListItem(preparedLists, 0)), FPreparedListsObject);
          if not ok then
            FScriptPreparedLists := '';
        end;
        if FNewScripter then begin
          ScripterT_ExecuteSubRoutine(sScriptProcName_BeforeInit);
          ScripterT_ExecuteSubRoutine(sScriptProcName_Init);
        end
        else begin
          Scripter.CallNoParamsMethod(sScriptProcName_BeforeInit);
          Scripter.CallNoParamsMethod(sScriptProcName_Init);
        end;
      finally
        FScriptState := ssNoActive;
      end;
    end;
  finally
    FCanClose := TRUE;
    StopWait;
  end;
end; {DoInit}

