//nacte controlsy ze streamu a vlozi na sbForm
//- kazdy controls navic prida do TMS skriptu, viz. ScripterTMS_AddAllDefControls
//  (pridaji se jen nove controlsy)
procedure TfaMain.LoadComponentFromStream(Instance : TComponent; S : TStream);
begin
  if not LoadComponentFromStreamDC(Instance, S) then
    LoadComponentFromStreamTMS(Instance, S);
end;

//nahrazuje reseni od TMS (LoadComponentFromStreamTMS), protoze to je pomalejsi
//hlavni cast funkce prevzata z puvodnich Dreams component
function TfaMain.LoadComponentFromStreamDC(Instance : TComponent; S : TStream): boolean;
var
  cowner : TComponent;
  //CompFiler: TCompFilerX;
  BinStream, BinStreamS: TMemoryStream;
  StringStream: TStringStream;
  i: integer;

  //smaze vsechny controlsy z sbForm (asi je zbytecne, protoze my je mazeme v EmptyPage)
  procedure ClearComponent(AComponent: TComponent);
  begin
    if AComponent = nil then
      exit;

    AComponent.DestroyComponents;
    if AComponent is TWinControl then
      with TWinControl(AComponent) do
        while ControlCount > 0 do
          Controls[0].Free;
  end;

begin
  Result := True;
  try
    //CompFiler:=TCompFilerX.Create;
    BinStream:=TMemoryStream.Create;
    BinStreamS:=TMemoryStream.Create;
    StringStream := TStringStream.Create('');
    try
      //with CompFiler do
        begin
          //if DFMFormat=dfmText then
            //ObjectTextToBinary(S,BinStream1);
          //else
            BinStreamS.CopyFrom(S,0);
          //
          BinStreamS.Seek(0,soFromBeginning);
          StringStream.CopyFrom(BinStreamS,4);
          if StringStream.DataString = 'TPF0' then begin
            BinStreamS.Seek(4,soFromBeginning);
            BinStream.CopyFrom(BinStreamS,BinStreamS.Size-4);
          end
          else
            BinStream.CopyFrom(BinStreamS,0);
          BinStream.Seek(0,soFromBeginning);
          //BinStream.SaveToFile('D:\TMS8.TXT');
  ///////////////////////////////////////////////////////////////
  //prevzato z dcfdes/TCustomLiteDesigner.LoadComponentFromStream
  ///////////////////////////////////////////////////////////////
          ClearComponent(Instance);
          cowner := self;
          //BeginTrick(cowner, false);
          with TReader.Create(BinStream, 4096) do
            try
              Root := cowner;
              Parent := cowner;
              BeginReferences;
              //OnError := ReaderError;
              //OnFindMethod := ReaderOnMethod;

              ReadComponent(Instance);
              FixupReferences;
            finally
              EndReferences;
              Free;
              //EndTrick(cowner);
            end;
        end;
  ///////////////////////////////////////////////////////////////
        if Instance is TScrollBox then
          for i := TScrollBox(Instance).ControlCount -1 downto 0 do begin
            ScripterTMS_AddComponent(ScripterT, TScrollBox(Instance).Controls[i]);
            ScripterTMS_AddComponent(workScripterT, TScrollBox(Instance).Controls[i]);
          end;
    finally
      //CompFiler.Free;
      BinStream.Free;
      BinStreamS.Free;
      StringStream.Free;
    end;
  except
    Result := False;
  end;
end;

procedure TfaMain.LoadComponentFromStreamTMS(Instance : TComponent; S : TStream);
var
  des: TIDEFormDesigner;
  i: Integer;
  sb: TScrollBox;
  c: TControl;
begin
  des := TIDEFormDesigner.Create(self);
  sb := TScrollBox.Create(self);
  sb.Visible := False;
  try
    S.Seek(0, soFromBeginning);
    des.DesignControl := TScrollBox(Instance);
    des.LoadComponentFromStream(S, sb, dfmBinary);
    for i := sb.ControlCount -1 downto 0 do begin
      c := sb.Controls[i];
      c.Parent := TScrollBox(Instance);
      c.SendToBack;
      //
      ScripterTMS_AddComponent(ScripterT, c);
      ScripterTMS_AddComponent(workScripterT, c);
    end;
  finally
    sb.Free;
    des.Free;
    des := nil;
  end;
end;

{
//pri tomto reseni zpusobuje "Instance.Free" problikavani ve menu
procedure TfaMain.LoadComponentFromStreamTMSX(Instance : TComponent; S : TStream);
var
  des: TIDEFormDesigner;
  i: integer;
begin
  des := TIDEFormDesigner.Create(self);
  try
    S.Seek(0, soFromBeginning);
    Instance.Free;
    Instance := des.LoadComponentFromStream(S, nil, dfmBinary);
    if Instance is TScrollBox then
      for i := TScrollBox(Instance).ControlCount -1 downto 0 do begin
        ScripterTMS_AddComponent(ScripterT, TScrollBox(Instance).Controls[i]);
        ScripterTMS_AddComponent(workScripterT, TScrollBox(Instance).Controls[i]);
      end;
  finally
    des.Free;
    des := nil;
  end;
end;
}

