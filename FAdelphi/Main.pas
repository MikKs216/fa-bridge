var
  i, xmin, ymin: integer;
  c, chigh, cleft: TControl;
begin
  if sbNotes.Visible then begin
    Result := reNotes;
    EXIT;
  end;
  xmin := maxint; //nejmensi Left
  ymin := maxint; //nejmensi Top
  chigh := nil; //nejvyssi control
  cleft := nil; //nejlevejsi control v rakdu s nejvyssim
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //control ktery zacina nejvys
    if IsControlEditable(c) and (TopC(c) >= 0) and (TopC(c) < ymin) and
      (c.Left >= ALeft) then begin
      xmin := c.Left;
      ymin := TopC(c);
      chigh := c;
    end;
  end;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    //pokud je na stejnem radku jako nejvyssi jeste jiny control, tak bereme ten co je vlevo
    if IsControlEditable(c) and (TopC(c) >= 0) and
      IsControlInRow(chigh, c) and (c.Left < xmin) and
      (c.Left >= ALeft) then begin
      xmin := c.Left;
      cleft := c;
    end;
  end;
  if cleft <> nil then
    Result := TControl(cleft)
  else
    Result := TControl(chigh);
end; {GetFirstRightControl}

//najde control, ktery je nejblize vpravo od AC
//  kdyz je to posledni control vpravo, tak vraci AC

function TfaMain.GetRightControl(AC: TControl): TControl;
var
  i, xmin: integer;
  c, cmin: TControl;
begin
  xmin := maxint;
  cmin := AC;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if IsControlEditable(c) and (c <> AC) and IsControlInRow(AC, c) and
      (c.Left > AC.Left) and (c.Left < xmin) then begin
      xmin := c.Left;
      cmin := c;
    end;
  end;
  Result := TControl(cmin);
end; {GetRightControl}

//najde control, ktery je nejblize vlevo od AC

function TfaMain.GetLeftControl(AC: TControl): TControl;
var
  i, xmin: integer;
  c, cmin: TControl;
begin
  xmin := -maxint;
  cmin := AC;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if IsControlEditable(c) and (c <> AC) and IsControlInRow(AC, c) and
      (c.Left < AC.Left) and (c.Left > xmin) then begin
      xmin := c.Left;
      cmin := c;
    end;
  end;
  Result := TControl(cmin);
end; {GetLeftControl}

//najde control, ktery je nejblize pod AC

function TfaMain.GetDownControl(AC: TControl): TControl;
var
  i, ymin: integer;
  c, cmin: TControl;
begin
  ymin := maxint;
  cmin := AC;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if IsControlEditable(c) and (c <> AC) and IsControlInCol(AC, c) and
      (TopC(c) > TopC(AC)) and (TopC(c) < ymin) then begin
      ymin := TopC(c);
      cmin := c;
    end;
  end;
  Result := TControl(cmin);
end; {GetDownControl}

//najde control, ktery je nejblize nad AC

function TfaMain.GetUpControl(AC: TControl): TControl;
var
  i, ymin: integer;
  c, cmin: TControl;
begin
  ymin := -maxint;
  cmin := AC;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if IsControlEditable(c) and (c <> AC) and IsControlInCol(AC, c) and
      (TopC(c) < TopC(AC)) and (TopC(c) > ymin) then begin
      ymin := TopC(c);
      cmin := c;
    end;
  end;
  Result := TControl(cmin);
end; {GetDownControl}

//najde dalsi control vpravo nebo nize

function TfaMain.GetNextControl(AC: TControl): TControl;
var
  c: TControl;
begin
  c := GetRightControl(AC);
  if c <> AC then
    Result := c
  else
    Result := GetFirstControl(TopC(AC) + HeightC(AC) - 1);
  if Result = nil then
    Result := AC;
end; {GetNextControl}

//najde predchozi control vlevo nebo vyse

function TfaMain.GetPreviousControl(AC: TControl): TControl;
var
  c: TControl;
begin
  c := GetLeftControl(AC);
  if c <> AC then
    Result := c
  else
    Result := GetLastControl(TopC(AC));
  if Result = nil then
    Result := AC;
end; {GetPreviousControl}

function TfaMain.GetControlByName(const AControlName: string): TControl;
var
  i: integer;
  c: TControl;
begin
  Result := nil;
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if (AnsiUppercase(c.Name) = AnsiUppercase(AControlName)) and
      IsControlEditable(c) then begin
      Result := c;
      BREAK;
    end;
  end;
end; {GetControlByName}

function TfaMain.TryFocusControlByName(const AControlName: string): boolean;
var
  c: TControl;
begin
  c := GetControlByName(AControlName);
  if c <> nil then begin
    FActuallyControl := c;
    FocusActuallyControl;
    Result := TRUE;
  end
  else
    Result := FALSE;
end; {TryFocusControlByName}

//select udaje mysi

procedure TfaMain.DoOnMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Integer);
begin
  if (Sender is TCxDBCheckBoxEx) or (Sender is TCxDBMemoEx) or
    (Sender is TButton) or (Sender is TcxListBoxEx) then
    HideEdit;
  if Sender is TControl then begin
    FActuallyControl := TControl(Sender);
    FocusActuallyControl;
  end;
end; {DoOnMouseDown}

procedure TfaMain.DoOnMouseMove(Sender: TObject;
  Shift: TShiftState; X, Y: Integer);
begin
  if PtInRect(TfaEdit(Sender).HighlightListRect, Point(X, Y)) then
    TfaEdit(Sender).Hint := sFldHasLookup
  else if PtInRect(TfaEdit(Sender).HighlightDefValRect, Point(X, Y)) then
    TfaEdit(Sender).Hint := sFldHasDefVal
  else
    TfaEdit(Sender).Hint := '';
end;

procedure TfaMain.DoOnMemoEnter(Sender: TObject);
begin
  if Sender is TcxDBMemo then begin
    if FHistEditHasWrite then begin
      FHistEditLastValue := TcxDBMemo(Sender).EditingText;
      FHistMemoLastValue := FHistEditLastValue;
    end;
    //
    FMemoValue := TcxDBMemo(Sender).Text;
    TcxDBMemo(Sender).SelectAll;
    FEditingState := FALSE;
  end;
end; {DoOnMemoEnter}

procedure TfaMain.DoOnMemoExit(Sender: TObject);
begin
  if Sender is TcxDBMemo then begin
    if TcxDBMemo(Sender).EditingText<>FHistMemoLastValue then
      SetHistEdit(TcxDBMemo(Sender).Name, TcxDBMemo(Sender).EditingText, True);
  end;
  //
  FEditingState := FALSE;
  if (Sender is TcxDBMemo) and
    ((TcxDBMemo(Sender).Text <> FMemoValue)) or FEditWasModified then begin
    TryPostMtValues;
    DoFieldChangeExit(TControl(Sender).Name);
  end;
  FEditWasModified := FALSE;
  ShowFieldState;
  ShowHintSb('');
end; {DoOnMemoExit}

procedure TfaMain.DoOnMemoEditing(Sender: TObject; var CanEdit: Boolean);
begin
  FEditWasModified := TRUE;
  if CanEdit then
    SetChangeFlag(TRUE);
end; {DoOnMemoEditing}

procedure TfaMain.DoNavig;
var
  dateString: string;
  calcValue: double;
begin
  if CEdit.FldType = fldtDate then begin //kalendar
    dateString := CEdit.Text;
    LogStat('k4');
    if CorrectDateString(dateString) then
      dateString := OpenCalendar(dateString,Left+5,Top+30)
    else
      dateString := OpenCalendar('',Left+5,Top+30);
    if dateString <> '' then begin
      CEdit.Text := dateString;
      CEdit.EditingText := dateString;
      MoveToNextControl(CEdit.NextDirection, CEdit.NextField);
    end
    else
      if CEdit.CanFocus then
        CEdit.SetFocus;
  end
  else if (CEdit.FldType = fldtNumber) or // kalkulacka
    (CEdit.FldType = fldtCurrency) then begin
    if mtFields.FindKey([UpperCase(CEdit.Hint)])
      {mtFields.Locate(mtFieldsName.FieldName, CEdit.Hint, //opt
      [loCaseInsensitive])}and mtFieldsHasList.Value then
      DoLists(CEdit.Hint)
    else begin
      calcValue := FCommonUtils.StrToFloatSafe(Replace(
        ThousandSeparator, CEdit.Text, ''));
{$IFDEF STANDALONE}
      LogStat('k3');
      if OpenCalcModal(calcValue, GetIniFileName,
        Left + 5, Top + 30) then begin
{$ELSE STANDALONE}
      LogStat('k3');
      if DoOpenCalcModal(calcValue,
        Left + 5, Top + 30) then begin
{$ENDIF STANDALONE}
        if ((CEdit.FldType = fldtNumber) or (CEdit.FldType = fldtCurrency)) and
          (CEdit.FldTypeDecimalPlaces = 0) then
          CEdit.Text := FloatToStr(RoundAri(calcValue, 0))
        else
          CEdit.Text := FloatToStr(calcValue);
        CEdit.EditingText := CEdit.Text;
        FEditWasModified := TRUE;
        MoveToNextControl(CEdit.NextDirection, CEdit.NextField);
      end;
    end;
  end
  else begin
    if mtFields.FindKey([UpperCase(CEdit.Hint)])
      {mtFields.Locate(mtFieldsName.FieldName, CEdit.Hint, //opt
      [loCaseInsensitive])}and mtFieldsHasList.Value then
      DoLists(CEdit.Hint)
    else begin
      LogStat('k5');
      DoOpenStrings;
    end;
  end;
end;

procedure TfaMain.DoOpenStrings;
{$IFNDEF STANDALONE}
var
  resStr: variant;
{$ENDIF STANDALONE}
begin
{$IFNDEF STANDALONE}
  if (FActuallyControl <> nil) and (FActuallyControl is TcxDBMemoEx) then begin
    resStr := OpenStrings(TcxDBMemoEx(FActuallyControl).Name,
      TcxDBMemoEx(FActuallyControl).Text,'',Left+5,Top+30);
    if resStr <> null then begin
      TcxDBMemoEx(FActuallyControl).Text := resStr;
      TcxDBMemoEx(FActuallyControl).EditingText := resStr;
    end;
  end
  else if CEdit.FldType = fldtString then begin
    resStr := OpenStrings(CEdit.Hint, CEdit.Text, '', Left+5, Top+30);
    if resStr <> null then begin
      CEdit.Text := resStr;
      CEdit.EditingText := resStr;
    end;
  end;
{$ENDIF STANDALONE}
end;

procedure TfaMain.DoNavigFromControl(AControl: TWinControl);
begin
  if AControl <> nil then
    DoLists(AControl.Name);
end;

//Posun tabelatorem z edicnich prvku

procedure TfaMain.SetNextTabControl(const AFieldName: string; ABack: boolean);
var
  c: TControl;
begin
  if ABack then begin
    c := FActuallyControl;
    MoveActuallyControl(VK_LEFT);
    if c = FActuallyControl then begin
      if cxTvContent.Visible and cxTvContent.CanFocus then
        cxTvContent.SetFocus
      else if cxContent.Visible and cxContent.CanFocus then
        cxContent.SetFocus
      else if (paComment.Height > Panel1.Height + 5) and
        reComment.Visible and reComment.CanFocus then
        reComment.SetFocus
    end
    else
  end
  else begin
    c := FActuallyControl;
    MoveActuallyControl(VK_RIGHT);
    if c = FActuallyControl then begin
      if (paComment.Height > Panel1.Height + 5) and
        reComment.Visible and reComment.CanFocus then
        reComment.SetFocus
      else if cxTvContent.Visible and cxTvContent.CanFocus then
        cxTvContent.SetFocus
      else if cxContent.Visible and cxContent.CanFocus then
        cxContent.SetFocus
    end;
  end;
end;

//Posun tabelatorem z ostatnich controls

procedure TfaMain.FocusNextTabControl(AControl: TWinControl; ABack: boolean);
begin
  if AControl = reInfo then begin
    if cxTvContent.Visible and cxTvContent.CanFocus then
      cxTvContent.SetFocus
    else if cxContent.Visible and cxContent.CanFocus then
      cxContent.SetFocus
    else if sbNotes.Visible then begin
      if reNotes.Visible and reNotes.CanFocus then
        reNotes.SetFocus;
    end
    else
      FocusFirstControl;
  end
  else if ABack then begin
    if (AControl = cxTvContent) or (AControl = cxContent) then begin
      if (paComment.Height > Panel1.Height + 5) and
        reComment.Visible and reComment.CanFocus then
        reComment.SetFocus
      else begin
        if sbNotes.Visible then begin
          if reNotes.Visible and reNotes.CanFocus then
            reNotes.SetFocus;
        end
        else
          FocusFirstControl;
      end;
    end
    else if AControl = reComment then begin
      if sbNotes.Visible then begin
        if reNotes.Visible and reNotes.CanFocus then
          reNotes.SetFocus;
      end
      else
        FocusFirstControl;
    end
    else if AControl = reNotes then begin
      if cxTvContent.Visible and cxTvContent.CanFocus then
        cxTvContent.SetFocus
      else if cxContent.Visible and cxContent.CanFocus then
        cxContent.SetFocus
      else
        if (paComment.Height > Panel1.Height + 5) and
          reComment.Visible and reComment.CanFocus then
          reComment.SetFocus;
    end;
  end
  else begin
    if AControl = reNotes then begin
      if (paComment.Height > Panel1.Height + 5) and
        reComment.Visible and reComment.CanFocus then
        reComment.SetFocus
      else begin
        if cxTvContent.Visible and cxTvContent.CanFocus then
          cxTvContent.SetFocus
        else if cxContent.Visible and cxContent.CanFocus then
          cxContent.SetFocus;
      end;
    end
    else if (AControl = cxTvContent) or (AControl = cxContent) then begin
      if sbNotes.Visible then begin
        if reNotes.Visible and reNotes.CanFocus then
          reNotes.SetFocus;
      end
      else
        FocusFirstControl;
    end
    else if AControl = reComment then begin
      if cxTvContent.Visible and cxTvContent.CanFocus then
        cxTvContent.SetFocus
      else if cxContent.Visible and cxContent.CanFocus then
        cxContent.SetFocus
      else begin
        if sbNotes.Visible then begin
          if reNotes.Visible and reNotes.CanFocus then
            reNotes.SetFocus;
        end
        else
          FocusFirstControl;
      end;
    end;
  end;
end;

//obsluha udalosti
procedure TfaMain.ApplicationEventsMessage(var Msg: tagMSG;
  var Handled: Boolean);
var a,b: integer;
  valString: string;
  cMem: TCxDBMemoEx;

  function TestValue: boolean;
  begin
    Result:=FALSE;
    if FEditingState and (CEdit.FldType = fldtDate) then begin
      valString := CEdit.Text;
      if CorrectDateString(valString) then begin
        CEdit.Text := valString;
        CEdit.EditingText := valString;
        Result:=TRUE;
      end;
    end
    else if FEditingState and
      ((CEdit.FldType = fldtNumber) or
      (CEdit.FldType = fldtCurrency)) then begin
      valString := CEdit.Text;
      if CorrectNumberString(valString,
        CEdit.FldTypeDecimalPlaces=0) then begin
        CEdit.Text := valString;
        CEdit.EditingText := valString;
        Result:=TRUE;
      end;
    end
    else begin
      Result:=TRUE;
    end;
  end;

begin
{$IFNDEF FINALBUILD}
  if (tmsDesigner <> nil) then begin
    //
  end
  else
{$ENDIF FINALBUILD}
  if Active and ((fmChecking = nil) or (not fmChecking.Focused)) and (fmPrintDialog = nil) and
    (fmCalendar = nil) then
  begin //kdyz jsou zobrazeny jine modalni formultare tak Active u obou
    //MYS
    //klepnuti mysi ukoncuje help k udaji a ulozi mtValues
    if ((Msg.message = WM_LBUTTONDOWN) or (Msg.message = WM_RBUTTONDOWN)) and
      FIsActiveFieldInstruction then begin
      MakeInactiveFieldInstructionPanel;
    end
    //ListBox
    else if (Msg.message = WM_LBUTTONDBLCLK) and //otevre vlozeny formular
      (ActiveControl <> nil) and
      (ActiveControl.Parent is TcxListBoxEx) then begin
      NestedButtonClick(TcxListBoxEx(ActiveControl.Parent).Name+'Edit');
      Handled := TRUE;
    end;
    //Osetreni skoku na udaj
    if Msg.message = WM_USERGotoField then begin
      GotoField(FGotoFieldName);
    end
    //zavreni okna - pro prepare report v nested forms
    else if Msg.message = WM_USERCloseForm then begin
      Close;
    end;
    //Kolecko mysi
    if (Msg.message = WM_MOUSEWHEEL) and (GetKeyState(VK_CONTROL) < 0) then begin
      if Msg.WParam>0 then begin
        ZoomUp;
        Handled := TRUE;
      end
      else if Msg.WParam<0 then begin
        ZoomDown;
        Handled := TRUE;
      end
    end;
    //KLAVESY
    //Alt+ ...
    if Msg.message = WM_SYSKEYDOWN then begin
      if not dxBarButtonDesignMode.Down then begin
        //EDIT
        if (CEdit <> nil) and CEdit.Focused then begin
          case Msg.wParam of
            //Alt+Down
            VK_DOWN: begin
                DoNavig;
                Handled := TRUE;
              end;
          end;
        end
        else if (ActiveControl <> nil) and
          (ActiveControl.Parent is TCxDBMemoEx) then begin
          case Msg.wParam of
            //Alt+Down
            VK_DOWN: begin
                DoNavigFromControl(ActiveControl.Parent);
                Handled := TRUE;
              end;
          end;
        end;
      end;
      //Alt+Q - export do Cursor/VSCode
      {$IFNDEF FINALBUILD}
      if (Msg.wParam = Ord('Q')) and (GetKeyState(VK_MENU) < 0) then begin
        {$IFDEF UCURSOR}
        EditFormScriptCursor;
        {$ELSE UCURSOR}
        EditFormScriptUnModal;
        {$ENDIF UCURSOR}
        Handled := TRUE;
      end;
      {$ENDIF FINALBUILD}
    end; {WM_SYSKEYDOWN}
    //Ostatni klavesy
    if Msg.message = WM_KEYDOWN then begin
      //HELP - stisk lib. klavesy ukoncuje help k udaji
      if (Msg.wParam <> VK_F1) and FIsActiveFieldInstruction then begin
        MakeInactiveFieldInstructionPanel;
        //kdyz uzivatel stiskne Esc tak to nemuzeme pustit dal protoze by si
        //zrusil doposud zadanou hodnotu
        if Msg.wParam = VK_ESCAPE then begin
          Handled := TRUE;
          EXIT;
        end;
      end;
      //FORMULAR
      //UZIVATELSKY MOD
      if not dxBarButtonDesignMode.Down then begin
        //EDIT
        if (CEdit <> nil) and CEdit.Focused then begin
          FEditWasModified := CEdit.EditModified or FEditWasModified;
            //v onDefault se nastavuje FEditWasModified
          case Msg.wParam of
            //Tabelator
            VK_Tab: begin
                SetNextTabControl(CEdit.Hint, GetKeyState(VK_SHIFT) < 0);
                Handled := TRUE;
              end;
            //Enter
            VK_RETURN: begin
              if TestValue then
                MoveToNextControl(CEdit.NextDirection, CEdit.NextField);
              if FEditWasModified then begin
                TryPostMtValues;
                DisplayCheck; // enter na udaji
              end;
              Handled := TRUE;
              end;
            //Right, Left, Home, End
            VK_RIGHT, VK_LEFT, VK_HOME, VK_END: begin
                if FEditingState then
                  Handled := FALSE
                else begin
                  MoveActuallyControl(Msg.wParam);
                  Handled := TRUE;
                end;
              end;
            //Down
            VK_DOWN: begin
                if (GetKeyState(VK_CONTROL) >= 0) and
                  (GetKeyState(VK_SHIFT) >= 0) then begin
                  if TestValue then
                    MoveActuallyControl(Msg.wParam);
                  if FEditWasModified then begin
                    TryPostMtValues;
                    DisplayCheck; // sipku dolu na udaji
                  end;
                  Handled := TRUE;
                end;
              end;
            VK_UP: begin
                if GetKeyState(VK_SHIFT) >= 0 then begin
                  //Up
                  if GetKeyState(VK_CONTROL) >= 0 then begin
                    if TestValue then
                      MoveActuallyControl(Msg.wParam);
                    if FEditWasModified then begin
                      TryPostMtValues;
                      DisplayCheck; // sipku nahoru na udaji
                    end;
                    Handled := TRUE;
                  end
                  //Ctrl+Up - otevreni seznamu
                  else begin
                    DoNavig;
                    Handled := TRUE;
                  end;
                end
                else begin
                  if GetKeyState(VK_CONTROL) < 0 then begin
                    {$IFNDEF STANDALONE}
                    SelectTextFromClientParams;
                    {$ENDIF STANDALONE}
                    Handled:=TRUE;
                  end
                  else
                    DoOpenStrings;
                end;
              end;
            //Insert
            VK_INSERT, VK_F2: begin
                ScrollToActuallyControl;
                SetEditState(TRUE);
                if (CEdit.FldType = fldtNumber) or
                  (CEdit.FldType = fldtCurrency) then
                  CEdit.EditingText := Replace(ThousandSeparator,
                    CEdit.EditingText, '');//bylo zakazano nevim proc, tak jsem povolil 21.12.2006
                Handled := TRUE;
              end;
            //Esc
            VK_ESCAPE: begin
{$IFDEF STANDALONE}
                SetEditState(FALSE);
                Handled := FALSE;
{$ELSE STANDALONE}
                if FEditingState then begin
                  SetEditState(FALSE);
                  Handled := FALSE;
                end
                else begin
                  Close;
                  Handled := TRUE;
                end;
{$ENDIF STANDALONE}
              end;
            //PgDn
            VK_NEXT: begin
                if GetKeyState(VK_CONTROL) >= 0 then begin
                  if TestValue then
                    ShowNextPage;
                  if FEditWasModified then begin
                    TryPostMtValues;
                    DisplayCheck; // na pgdn
                  end;
                  Handled := TRUE;
                end;
              end;
            //PgUp
            VK_PRIOR: begin
                if GetKeyState(VK_CONTROL) >= 0 then begin
                  if TestValue then
                    ShowPriorPage;
                  if FEditWasModified then begin
                    TryPostMtValues;
                    DisplayCheck; // na pgup
                  end;
                  Handled := TRUE;
                end;
              end;
            //Space - zakladni hodnota
            VK_SPACE: begin
                if (CEdit.Text = '') or (CEdit.SelText = CEdit.Text) then
                begin
                  DoDefault(CEdit.Hint);
                  Handled := TRUE;
                end;
              end;
            //Shift+F4 - zakladni hodnota
            VK_F4: begin
                a := GetKeyState(VK_SHIFT) and not GetKeyState(VK_CONTROL);
                if a < 0 then begin
                  DoDefault(CEdit.Hint);
                  Handled := TRUE;
                end;
              end;
            //F12, Shift+F12, Ctrl+Shift+F12
            VK_F12: begin
                a := GetKeyState(VK_SHIFT);
                b := GetKeyState(VK_CONTROL);
                if (a<0) and (b<0) then
                {$IFNDEF STANDALONE}
                  SelectTextFromClientParams
                {$ENDIF STANDALONE}
                else if (a<0)and(GListPressedChar='') then // druha podminka aby se otevrel seznam kdyz ma udaj masku vykriznik
                  DoOpenStrings
                else
                  DoNavig;
                Handled := TRUE;
              end;
          else
            {ScrollToActuallyControl;} //to je divne, proc na lib klavesu scrolovat
            BlinkLockFlag;
          end;
        end
        //CHECKBOX
        else if (ActiveControl <> nil) and
          (ActiveControl is TCxDBCheckBoxEx) then
        begin
          case Msg.wParam of
            //Tabelator
            VK_Tab: begin
                SetNextTabControl(TCxDBCheckBoxEx(ActiveControl).Name,
                  GetKeyState(VK_SHIFT) < 0);
                Handled := TRUE;
              end;
            //Enter
            VK_RETURN: begin
                MoveToNextControl(TCxDBCheckBoxEx(ActiveControl).NextDirection,
                  TCxDBCheckBoxEx(ActiveControl).NextField);
                Handled := TRUE;
              end;
            //Left, Right, Down, Up, Home, End
            VK_RIGHT, VK_LEFT, VK_DOWN, VK_UP, VK_HOME, VK_END: begin
                MoveActuallyControl(Msg.wParam);
                Handled := TRUE;
              end;
{$IFNDEF STANDALONE}
            //Esc
            VK_ESCAPE: begin
                Close;
                Handled := TRUE;
              end;
{$ENDIF STANDALONE}
            //PgDn
            VK_NEXT: begin
                ShowNextPage;
                Handled := TRUE;
              end;
            //PgUp
            VK_PRIOR: begin
                ShowPriorPage;
                Handled := TRUE;
              end;
            //Shift+F4 - zakladni hodnota
            VK_F4: begin
                a := GetKeyState(VK_SHIFT);
                if a < 0 then begin
                  DoDefault(TCxDBCheckBoxEx(ActiveControl).Name);
                  Handled := TRUE;
                end;
              end;
          else
            {ScrollToActuallyControl;} //to je divne, proc na lib klavesu scrolovat
            BlinkLockFlag;
          end;
          {TryPostMtValues;}
        end
        //ListBox
        else if (ActiveControl <> nil) and
          (ActiveControl.Parent is TcxListBoxEx) then begin
          case Msg.wParam of
            //Left, Right
            VK_RIGHT, VK_LEFT: begin
                MoveActuallyControl(Msg.wParam);
                Handled := TRUE;
              end;
            //Down, Up, Home, End
            VK_DOWN, VK_UP, VK_HOME, VK_END: begin
                if (GetKeyState(VK_SHIFT) >= 0) and
                  (GetKeyState(VK_CONTROL) >= 0) then begin
                  if TcxListBoxEx(ActiveControl.Parent).Count=0 then begin
                    MoveActuallyControl(Msg.wParam);
                    Handled := TRUE;
                  end;
                end;
              end;
