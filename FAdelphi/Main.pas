procedure TfaMain.ApplyMainCaption(AName: string);
var
  clientName, nestedCap, tmsCap, scr: string;
  ro: boolean;
begin
  try
    SetProgressPos(-1); // tato funkce se vola vzdy kdyz je formular natazen, tak tady muzeme skryt progressbar
    //
    if FNestedState then
      nestedCap := AnsiUpperCase(sNestedCaption) + ' '
    else
      nestedCap := '';
    ro:=FALSE;
  {$IFDEF STANDALONE}
    try
      if FileExists(FDataFileName) then
        ro := (GetFileInformation(FDataFileName).Attr and faReadOnly) <> 0
      else
        ro := FALSE;
    except //osetreni chyby System Error Code 161 na W98
        ro := FALSE;
    end;
    if FSlaveState <> ssNone then begin //titulek ve FA ve slave rezimu
      if mtDef.Active then
        AName := mtDefName.Value;
      if (FSlaveState <> ssNone) and mtValues.ReadOnly then
        ro := TRUE;
      if AName = '' then
        Caption := cApplicationName + nestedCap
      else if ro or FStateFormReadOnlyLAN then begin
        if FNestedState then
          Caption := cApplicationName + ' - ' + nestedCap +
            ExtractFileName(AName) + ' ' +  sReadOnlyOrLocked
        else
          Caption := cApplicationName + ' - ' + nestedCap +
            ExtractFileName(AName) + ' ' +  sReadOnly;
      end
      else
        Caption := cApplicationName + ' - ' + nestedCap + ExtractFileName(AName);
    end
    else begin
  {$ENDIF STANDALONE}
      tmsCap := '';
      scr := '';
    {$IFNDEF FINALBUILD}
      if FNewScripter then
        tmsCap := ' TMS';
      if FDefFileName <> '' then
        scr := ' [' + ExtractFileName(FDefFileName) + ']';
      if FDataFileName <> '' then
        AName := FDataFileName
      else
        AName := mtDefName.Value;
    {$ENDIF FINALBUILD}
      //titulek ve FS nebo ve FA volanem z jineho programu
      clientName := ClientParam('Description');
      if Length(clientName) = 0 then
        if ExtractFileName(AName) <> '' then
          Caption := cApplicationName + tmsCap + ' -' + scr + nestedCap + ' ' + ExtractFileName(AName)
        else
          Caption := cApplicationName + tmsCap + nestedCap + scr
      else begin
        if Length(clientName) > 40 then
          clientName := Copy(clientName, 1, 40) + '...';
        if FStateFormReadOnlyLAN then begin
          if FNestedState then
            Caption := clientName + ' - ' + nestedCap + AName + ' ' +
              sReadOnlyOrLocked
          else
            Caption := clientName + ' - ' + nestedCap + AName + ' ' + sReadOnly;
        end
        else begin
          if ro then
            Caption := clientName + ' - ' + nestedCap + AName + ' ' +  sReadOnly
          else
            Caption := clientName + ' - ' + nestedCap + AName;
        end;
      end;
  {$IFDEF STANDALONE}
    end;
  {$ELSE STANDALONE}
    {$IFNDEF FINALBUILD}
    Caption:=Caption+' [testovací build'+tmsCap+']';
    {$ENDIF FINALBUILD}
  {$ENDIF STANDALONE}
  except //kdyz se neco nepovede, tak nevadi jen se nezaktualizuje caption; obsas nastal AV, nejde navodit opakovane
  end;
end; {ApplyMainCaption}

procedure TfaMain.DesignerAfterInsertComponent(Sender: TObject;
  AControl: TComponent);
begin
  if AControl is TLabel then begin
    if TLabel(AControl).Font.Size = 6 then
      TLabel(AControl).Font.Size := 8;
  end
  else if AControl is THTMLStaticText then begin
    if THTMLStaticText(AControl).Font.Size = 6 then
      THTMLStaticText(AControl).Font.Size := 8;
    if THTMLStaticText(AControl).Height = 20 then
      THTMLStaticText(AControl).Height := 13;
  end
  else if AControl is TcxDBCheckBoxEx then begin
    if TcxDBCheckBoxEx(AControl).Style.Font.Size = 6 then
      TcxDBCheckBoxEx(AControl).Style.Font.Size := 8;
  end;
end;

function VlozOdkazyNaZakony(const Vstup: string): string;
const
  // Přípustné předpony se skloňováním
  Prefixy: array[0..21] of string = (
    'zákon č.',     // 1. pád (neutrální tvar)
    'zákona č.',    // 2. pád
    'zákonu č.',    // 3. pád
    'zákoně č.',    // 6. pád
    'zákonem č.',   // 7. pád
    'o zákonu č.',  // např. "o zákonu č."
    'podle zákona č.', // typická fráze
    'zákon číslo',     // 1. pád (neutrální tvar)
    'zákona číslo',    // 2. pád
    'zákonu číslo',    // 3. pád
    'zákoně číslo',    // 6. pád
    'zákonem číslo',   // 7. pád
    'o zákonu číslo',  // např. "o zákonu č."
    'podle zákona číslo', // typická fráze
    //SK
    //'zákon č.', // 1. pád (neutrálny tvar)
    //'zákona č.', // 2. pád
    //'zákonu č.', // 3. pád
    'zákone č.', // 6. pád
    'zákonom č.', // 7. pád
    'o zákone č.', // napr. "o zákone č."
    'podľa zákona č.', // typická fráza
    //'zákon číslo', // 1. pád (neutrálny tvar)
    //'zákona číslo', // 2. pád
    //'zákonu číslo', // 3. pád
    'zákone číslo', // 6. pád
    'zákonom číslo', // 7. pád
    'o zákone číslo', // napr. "o zákone č."
    'podľa zákona číslo' // typická fráza
  );

var
  Vystup, Cislo, Rok, Paragraf, Odstavec, Pismeno: string;
  Nahrazeno, ZakonText, AktPrefix, PuvodniText, Oznaceni, CelyOdkaz: string;
  Pozice, Start, PosLomitko, PosSb, Konec, i, PosPar, EndPar, EndParAfterInsert: Integer;
  ParagrafyNahrazeno, ParagrafyDoplneno: Integer;
  TmpPos: Integer;
  RangeTo, RangeOdkaz: string;
  IsRange: Boolean;
  TextSb, LinkZakony: string;

  function PosLowerCase(const SubStr, S: string; Offset: Integer = 1): Integer;
  begin
    Result := Pos(LowerCase(SubStr), LowerCase(Copy(S, Offset, MaxInt)));
    if Result > 0 then
      Inc(Result, Offset - 1);
  end;

  function GetLinkZakony(const ASK: boolean): string;
  const
    cLinkZakonyCZ = 'https://www.zakonyprolidi.cz/cs/';
    cLinkZakonySK = 'https://www.zakonypreludi.sk/zz/';
  begin
    if ASK then
      Result := cLinkZakonySK
    else
      Result := cLinkZakonyCZ;
  end;

begin
  Vystup := Vstup;
  ParagrafyNahrazeno := 0;
  ParagrafyDoplneno := 0;

  // --- FÁZE 1: Vyhledání všech paragrafů včetně samostatného zpracování ---
  PosPar := Pos('§ ', Vystup);
  while PosPar > 0 do
  begin
    Paragraf := '';
    Odstavec := '';
    Pismeno := '';
    RangeTo := '';
    IsRange := False;
    EndPar := PosPar + 2;

    // Načti číslo paragrafu (např. 33)
    while (EndPar <= Length(Vystup)) and (Vystup[EndPar] in ['0'..'9']) do
    begin
      Paragraf := Paragraf + Vystup[EndPar];
      Inc(EndPar);
    end;

    // Případné písmeno paragrafu (např. 33a)
    while (EndPar <= Length(Vystup)) and (Vystup[EndPar] in ['a'..'z', 'A'..'Z']) do
    begin
      Paragraf := Paragraf + Vystup[EndPar];
      Inc(EndPar);
    end;

    PuvodniText := '§ ' + Paragraf;

    // Ulož pozici pro případné pokračování
    Start := EndPar;

    // Zjisti, jestli hned za paragrafem následuje odst. nebo písm.
    // Mezi paragrafem a odst. smí být max 1–2 mezery, žádné "a", "§", ",", ...
    while (Start <= Length(Vystup)) and (Vystup[Start] in [' ', ',', ';']) do Inc(Start);

    if LowerCase(Copy(Vystup, Start, 5)) = 'odst.' then
    begin
      EndPar := Start + 5;
      while (EndPar <= Length(Vystup)) and not (Vystup[EndPar] in ['0'..'9']) do Inc(EndPar);
      while (EndPar <= Length(Vystup)) and (Vystup[EndPar] in ['0'..'9']) do
      begin
        Odstavec := Odstavec + Vystup[EndPar];
        Inc(EndPar);
      end;
      PuvodniText := PuvodniText + ' odst. ' + Odstavec;

      // písmeno může následovat
      Start := EndPar;
      while (Start <= Length(Vystup)) and (Vystup[Start] in [' ', ',', ';']) do Inc(Start);

      TmpPos := Pos('písm', LowerCase(Copy(Vystup, Start, 20)));
      if TmpPos = 0 then
        TmpPos := Pos('písmeno', LowerCase(Copy(Vystup, Start, 20)));

      if TmpPos > 0 then
      begin
        Inc(TmpPos, Start - 1);
        EndPar := TmpPos + 5;

        while (EndPar <= Length(Vystup)) and not (Vystup[EndPar] in ['a'..'z', 'A'..'Z']) do Inc(EndPar);

        if (EndPar <= Length(Vystup)) and (Vystup[EndPar] in ['a'..'z', 'A'..'Z']) then
        begin
          Pismeno := LowerCase(Vystup[EndPar]);
          Inc(EndPar);
          PuvodniText := PuvodniText + ' písm. ' + Pismeno + ')';
          while (EndPar <= Length(Vystup)) and (Vystup[EndPar] in [' ', ')', '.']) do Inc(EndPar);
        end
        else
        begin
          // písmeno nenalezeno – nech písmeno mimo odkaz
          EndPar := TmpPos; // vrať se před "písm."
        end;
      end;
    end;

    // Sestavení odkazu
    Oznaceni := 'p' + Paragraf;
    if Odstavec <> '' then Oznaceni := Oznaceni + '-' + Odstavec;
    if Pismeno <> '' then Oznaceni := Oznaceni + '-' + Pismeno;

    CelyOdkaz := Format('<a href="§PLACEHOLDER#%s">%s</a>', [Oznaceni, PuvodniText]);

    Delete(Vystup, PosPar, EndPar - PosPar);
    Insert(CelyOdkaz, Vystup, PosPar);
    if (PosPar + Length(CelyOdkaz) <= Length(Vystup)) and
     (Vystup[PosPar + Length(CelyOdkaz)] in ['a'..'z', 'A'..'Z']) then
    Insert(' ', Vystup, PosPar + Length(CelyOdkaz));

    Inc(ParagrafyNahrazeno);

    EndParAfterInsert := PosPar + Length(CelyOdkaz);
    TmpPos := Pos('§ ', Copy(Vystup, EndParAfterInsert, MaxInt));
    if TmpPos > 0 then
      PosPar := EndParAfterInsert + TmpPos - 1
    else
      Break;
  end;

  // --- FÁZE 2: Nahrazení zákonů + doplnění §PLACEHOLDER ---
  for i := 0 to High(Prefixy) do
  begin
    AktPrefix := Prefixy[i];
    Pozice := Pos(LowerCase(AktPrefix), LowerCase(Vystup));
    while Pozice > 0 do
    begin
      Start := Pozice + Length(AktPrefix);
      PosLomitko := Pos('/', Copy(Vystup, Start, 15));
      if PosLomitko = 0 then Break;
      Inc(PosLomitko, Start - 1);

      //CZ
      TextSb := ' Sb.';
      PosSb := Pos(TextSb, Copy(Vystup, PosLomitko, 15));
      LinkZakony := GetLinkZakony(False);
      //SK
      if PosSb = 0 then begin
        TextSb := ' Z. z.';
        PosSb := Pos(TextSb, Copy(Vystup, PosLomitko, 15));
        LinkZakony := GetLinkZakony(TRUE);
      end;
      if PosSb = 0 then Break;
      Inc(PosSb, PosLomitko - 1);

      Cislo := Trim(Copy(Vystup, Start, PosLomitko - Start));
      Rok := Trim(Copy(Vystup, PosLomitko + 1, PosSb - (PosLomitko + 1)));

      Konec := PosSb + Length(TextSb);
      ZakonText := Copy(Vystup, Pozice, Konec - Pozice);

      Nahrazeno := Copy(Vystup, Pozice, Start - Pozice) +
        Format('<a href="%s%s-%s">%s/%s</a>%s', [LinkZakony, Rok, Cislo, Cislo, Rok, TextSb]);

      Delete(Vystup, Pozice, Length(ZakonText));
      Insert(Nahrazeno, Vystup, Pozice);

      if Pos('§PLACEHOLDER', Vystup) > 0 then
      begin
        Vystup := StringReplace(Vystup, '§PLACEHOLDER', LinkZakony + Rok + '-' + Cislo, [rfReplaceAll]);
        Inc(ParagrafyDoplneno);
      end;

      TmpPos := Pos(LowerCase(AktPrefix), LowerCase(Copy(Vystup, Pozice + Length(Nahrazeno), MaxInt)));
      if TmpPos > 0 then
        Pozice := Pozice + Length(Nahrazeno) + TmpPos - 1
      else
        Break;
    end;
  end;

  // --- FÁZE 3: Obnova původních paragrafů bez zákona
  if ParagrafyNahrazeno > ParagrafyDoplneno then
  begin
    repeat
      PosPar := Pos('<a href="§PLACEHOLDER#p', Vystup);
      if PosPar = 0 then Break;

      PosSb := Pos('</a>', Copy(Vystup, PosPar, Length(Vystup) - PosPar + 1));
      if PosSb = 0 then Break;
      Inc(PosSb, PosPar - 1);

      Start := Pos('>', Copy(Vystup, PosPar, PosSb - PosPar));
      if Start = 0 then Break;
      Inc(Start, PosPar - 1);

      PuvodniText := Copy(Vystup, Start + 1, PosSb - (Start + 1));
      Delete(Vystup, PosPar, PosSb + 4 - PosPar);
      Insert(PuvodniText, Vystup, PosPar);

      // Přidej mezeru, pokud za textem není žádná
      if (PosPar + Length(PuvodniText) <= Length(Vystup)) and
         (Vystup[PosPar + Length(PuvodniText)] <> ' ') then
        Insert(' ', Vystup, PosPar + Length(PuvodniText));
    until False;
  end;

  Result := Vystup;
end;

//vraci TRUE
// - pokud je v clipboardu "obyčejný" text - vytvari se HTMLStaticText komponenta
// - pokud je clipboard prazdny
//vraci FALSE:
// - pokud je v clipboardu nejaka komponenta - vlozi se systemove z cliboardu do kresleni
function TfaMain.InsertTextAsHTMLComponent: boolean;
var
  i,l,t,h,w: integer;
  sl: TStringList;
  c0: TControl;
  Pt: TPoint;
  comHtml: THTMLStaticText;
  clipboardText: string;

  function OdstranViceMezer(const VstupniRetezec: string): string;
  var
    i: Integer;
    Vysledek: string;
    BylaMezera: Boolean;
  begin
    Vysledek := ''; // Inicializace výsledného řetězce
    BylaMezera := False; // Příznak, zda předchozí znak byl mezera

    // Projdeme všechny znaky vstupního řetězce
    for i := 1 to Length(VstupniRetezec) do begin
      // Pokud aktuální znak není mezera
      if VstupniRetezec[i] <> ' ' then begin
        Vysledek := Vysledek + VstupniRetezec[i]; // Přidáme znak do výsledku
        BylaMezera := False; // Resetujeme příznak mezery
      end
      else begin// Pokud aktuální znak JE mezera
        // Pokud předchozí znak nebyla mezera (nebo je to první mezera v sekvenci)
        if not BylaMezera then begin
          Vysledek := Vysledek + ' '; // Přidáme jednu mezeru do výsledku
          BylaMezera := True; // Nastavíme příznak, že jsme právě přidali mezeru
        end;
        // Pokud předchozí znak již byla mezera, tuto další mezeru ignorujeme
      end;
    end;

    Result := Vysledek; // Funkce vrací upravený řetězec
  end;

  function GetComponentName: string;
  var
    Counter: Integer;
    Candidate: string;
    i: Integer;
    Exists: Boolean;
  begin
    Counter := 1;
    repeat
      Candidate := 'HTMLStaticText' + IntToStr(Counter);
      Exists := False;
      for i := 0 to sbForm.ControlCount - 1 do
      begin
        if SameText(sbForm.Controls[i].Name, Candidate) then
        begin
          Exists := True;
          Break;
        end;
      end;
      Inc(Counter);
    until not Exists;

    Result := Candidate;
  end;

  procedure GetWidthHeightText(const Text:String; Font:TFont;
                               out AWidth: integer; out AHeight: integer);
  var
    LBmp: TBitmap;
  begin
    LBmp := TBitmap.Create;
    try
      LBmp.Canvas.Font := Font;
      AWidth := LBmp.Canvas.TextWidth(Text);
      AHeight := LBmp.Canvas.TextHeight(Text);
    finally
      LBmp.Free;
    end;
  end;

  function GetWidthText(const Text:String; Font:TFont): Integer;
  var
    w,h: integer;
  begin
    GetWidthHeightText(Text, Font, w, h);
    Result := w;
  end;

  {function GetHeightText(const Text:String; Font:TFont): Integer;
  var
    w,h: integer;
  begin
    GetWidthHeightText(Text, Font, w, h);
    Result := h;
  end;}

  procedure GetWidthHeight(const Text:String; Font:TFont;
                           out AWidth: integer; out AHeight: integer);
  var
    sl: TStringList;
    j: integer;
  begin
    sl := TStringList.Create;
    try
      sl.Text := Text;
      AWidth := 0;
      AHeight := sl.Count * 13;
      for j := 0 to sl.Count - 1 do
        AWidth := Max(AWidth, GetWidthText(sl[j], Font));
    finally
      sl.Free;
    end;
  end;

begin
  Result := TRUE;
  //
  if not Clipboard.HasFormat(CF_TEXT) then
    Exit;
  //
  sl := TStringList.Create;
  try
    sl.Text :=Trim(Clipboard.AsText);
    if (sl.Count = 0) then
      Exit;
    //
    for i := 0 to sl.Count - 1 do begin
      if (sl[i] <> '') then begin
        if (Copy(sl[i], 1, 7) = 'object ') then begin
          Result := FALSE;
          Break;
        end;
      end;
    end;
    //
    if Result then begin
      l := -1;
      t := -1;
      c0:=FindDragTarget(FDesignerPopUpMenuPosition,False); //controls na pozici, kde jsme kliknuli (v FDesignerPopUpMenuPosition je pozice kliku)
      if (c0 <> nil) then begin
        if (c0 = sbForm) then begin
          pt := sbForm.ScreenToClient(FDesignerPopUpMenuPosition);
          l := Pt.X;
          t := pt.Y;
        end
        else if (c0.Name <> '') then begin  //edit, checkbox, button atd.
          l := c0.Left+8;
          t := c0.Top+8;
        end
        else if (c0.Parent.Name <> '') then begin  //memo
          l := c0.Parent.Left+8;
          t := c0.Parent.Top+8;
        end;
        //
        if (l = -1) then
          l := 100;
        if (t = -1) then
          t := 100;
        //
        clipboardText := OdstranViceMezer(Replace(cCRLF, Replace('''', Clipboard.AsText, ''), ' '));
        comHtml := THTMLStaticText.Create(self);
        comHtml.Name := GetComponentName;
        comHtml.Left := l;
        comHtml.Top := t;
        comHtml.Height := 13;
        comHtml.HTMLText.Text := VlozOdkazyNaZakony(clipboardText);
        comHtml.Parent := sbForm;
        comHtml.Font.Size := 8;        
        GetWidthHeight(comHtml.Text, comHtml.Font, w, h);
        comHtml.Width := w+1;
        comHtml.Height := h;
        Designer.Designer.SelectComponent(comHtml);
      end;
    end;
  finally
    sl.Free;
  end;
end;

procedure TfaMain.DesignerKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  if (GetKeyState(VK_CONTROL)<0) then begin
    //Ctrl+V
    if (Key = 86) then begin
      if InsertTextAsHTMLComponent then
        Key := 0; //aby se nevykonalo systemove Ctrl+V
    end;
  end;
end;

//neni plne funkci:
//1. potrebovali bychom automaticky menit velikost pro "AutoSizing",
//   jenze se deje to, ze manulani nastaveni velikosti vyvola znovu DesignerSizeChanged
//2. pokud bychom se rozhodli, ze budeme nastavovat vlastni velikost pri zmene vlastnosti HTMLText,
//   tak se to pro "male" zmene textu se DesignerSizeChanged nevyvola
procedure TfaMain.DesignerSizeChanged(Sender: TObject;
  ChangedControl: TControl);
var
  s: string;
  sl: TStringList;
  h: integer;

const
  cControlHeight = 13;
begin
{  if ChangedControl is THTMLStaticText then begin
    if not THTMLStaticText(ChangedControl).AutoSizing then begin
      sl := TStringList.Create;
      sl.Text := THTMLStaticText(ChangedControl).Text;
      try
        h := cControlHeight;
        if sl.Count > 1 then
          h := cControlHeight*sl.Count;
        if THTMLStaticText(ChangedControl).Height <> h then
          THTMLStaticText(ChangedControl).Height := h;

//        s := IntToStr(sl.Count);
//        s := IntToStr(THTMLStaticText(ChangedControl).HTMLText.Count);
      finally
        sl.Free;
      end;
    end;
  end;}
end;

