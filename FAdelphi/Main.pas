  //doslo ke zmene datasetu, povolit tlacitko pro ulozeni
  SetChangeFlag(TRUE);
  //povoleni navrhu formulare
  if mtContent.RecordCount > 0 then begin
    //2.12.2024 Marek - odstranena moznost vlezt do kresleni pomoci Ctrl+F12 (aktualni definice jsou prevedeny do TMS, takze stejne nefungovalo)
    {if not FNewScripter then begin
      //povoleni prepninani modu formulare klavesami Ctrl+F12
      Designer.StartHotKey := 16507;
      Designer.StopHotKey := 16507;
    end;}
    //zobrazeni tlacitka pro vyprazdneni formulare
    if dxBarButtonDesignMode.Down then begin //mod navrhu
      dxBarButtonEmptyForm.Visible := ivAlways;
    end;
  end;
  {if FIsDesignMode then
    FIsLoadingContent := FALSE;}
end; {mtContentAfterPost}

procedure TfaMain.mtContentAfterScroll(DataSet: TDataSet);
begin
//{$IFDEF PROFILER}TimeLog('*** Start AfterScroll'); {$ENDIF PROFILER}
