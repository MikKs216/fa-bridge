          FocusActuallyControl;
        end;
      end
      else if mtFields.FindKey([UpperCase(TControl(FActuallyControl).Name)]) then
        SetEnablingOfActuallyField(TControl(FActuallyControl).Name,
          mtFieldsIsSetForEnabling.Value);
    end;
  end;
end;

//zobrazi chyby a varovani
//  vraci TRUE kdyz uzivatel zvolil, ze chyby opravi

function TfaMain.ShowChecking(AShowOK: boolean = FALSE;
  AShowDifs: boolean = FALSE; AForceTipEP: Boolean = FALSE): boolean; //parametr AShowDifs se zatim nepouziva
var
  iniFile: TMemIniFile;
  err, warn, info, dif: integer;
  t1, t2: TDateTime;
begin
  if fmChecking<>nil then begin
    fmChecking.Show;
    fmChecking.BringToFront;
    fmChecking.SetFocus;
    Exit;
  end;
  Result := FALSE;
  if FStateFormWasChanged then begin
    DoCalculate;
    TryPostMtValues;
  end;
  {FIsLoadingData:=TRUE;
  try
    TryPostMtValues;
  finally
    FIsLoadingData:=FALSE;
  end;}
  t1:=Now;
  DoCheck(AShowDifs);
  t2:=Now;
  if (t2-t1>5E-6) then begin //pokud trva vic nez pul vteriny tak zobrazime tip
    SetLiveCheck(False);
  end;
  err := 0;
  warn := 0;
  info := 0;
  dif := 0;
  with mtChecking do begin
    First;
    while not EOF do begin
      if mtCheckingKind.Value = 0 then
        INC(err);
      if (mtCheckingKind.Value = 1)or(mtCheckingKind.Value = 2) then
        INC(warn);
      if (mtCheckingKind.Value = 4)or(mtCheckingKind.Value = 5) then
        INC(info);
      if mtCheckingKind.Value = 3 then
        INC(dif);
      Next;
    end;
  end;
  if mtChecking.RecordCount > 0 then begin
    iniFile := TMemIniFile.Create(GetIniFileName);
    try
      if not iniFile.ReadBool(cIniMtParam, cIniOpenCheckWithErr, TRUE) then
        err := 0;
      if not iniFile.ReadBool(cIniMtParam, cIniOpenCheckWithWarn, TRUE) then
        warn := 0;
      if not iniFile.ReadBool(cIniMtParam, cIniOpenCheckWithInfo, TRUE) then
        info := 0;
      if not iniFile.ReadBool(cIniMtParam, cIniOpenCheckWithDif, FALSE) then
        dif := 0;
      if AShowOK or (err > 0) or (warn > 0) or (info > 0) or (dif > 0)then begin
        mtChecking.First;
        Result := ShowMsgs(AForceTipEP,Left+5,Top+30);
        if Result and (mtCheckingFieldName.Value <> '') then
          GotoField(mtCheckingFieldName.Value)
        else
          FocusActuallyControl;
      end;
    finally
      iniFile.Free;
    end;
  end
  else begin
    if AShowOK then
      MessageInfo(Caption, sMsgCheckOK, [MBOK]);
  end;
end; {ShowChecking}

