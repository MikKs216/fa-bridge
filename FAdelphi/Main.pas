procedure TfaMain.OpenAndSaveFrm(ADoCalculate: boolean);
var
  dir, dirSave: string;
  sl: TStringList;
  i: integer;
begin
  if SelectDir('Vyberte složku s FRM soubory', '', dir) then begin
    sl := TStringList.Create;
    dxBarComboWorkState.OnChange := nil;
    try
      dirSave := NormalPath(dir)+'NewData\';
      if DirectoryExists(dirSave) then
        DeleteFiles(dirSave,'*.*')
      else
        ForceDirectories(dirSave);
      //
      sl.Text := SearchFiles(dir, '*.frm', False);
      for i := 0 to sl.Count - 1 do begin
        if OpenFileData(sl[i]) then begin
          if ADoCalculate then
            DoCalculate;
          SaveData(dirSave+ExtractFileName(sl[i]));
        end;
      end;
    finally
      sl.Free;
      dxBarComboWorkState.OnChange := dxBarComboWorkStateChange;
    end;
  end;
end;
{$ENDIF FINALBUILD}

