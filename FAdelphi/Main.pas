procedure TfaMain.SaveSlaveInfo(ADataSaved: boolean; ADataApply: boolean =
  FALSE);
{$IFDEF STANDALONE}
var
  s, comment, charact: string;
  ini: TMemIniFile;
  st: TMemoryStream;
  sl: TstringList;
  {$IFDEF  STEREONX}
    souborT,souborCh:string;  //#MR2025
    slozka:string;
  {$ENDIF}
const
  cIniFaResult = 'FaResult';
{$ENDIF STANDALONE}
begin
{$IFDEF STANDALONE}
{$IFDEF STEREONX}
   //#MR 2025
   slozka:= NormalPath(gFUserDataPath);
   souborT:= slozka + 'DKresult.txt';
   souborCh:= slozka + 'DKresultCh.txt';
{$ENDIF}
  if ADataSaved and not FNestedState then begin
    {$IFNDEF STEREONX}
      ini := TMemIniFile.Create(NormalPath(ExtractFilePath(
        Application.ExeName)) + 'DKresult.txt');
    {$ELSE}
      //  Predavame pres user slozku user/appdata/roaming/ksw/stereonx/Forms  #MR2025
      ini := TMemIniFile.Create(souborT);
    {$ENDIF}
    st := TMemoryStream.Create;
    sl := TstringList.Create;
    try
      if ADataApply then
        ini.WriteString(cIniFaResult, 'Result', 'DataApply')
      else
        ini.WriteString(cIniFaResult, 'Result', 'DataSave');
      ini.WriteString(cIniFaResult, 'DefID', mtDefID.Value);
      ini.WriteString(cIniFaResult, 'Caption', mtDefName.Value);
      ini.WriteBool(cIniFaResult, 'Locked', FStateFormLocked);
      reComment.SaveTextToStream('', st, 0, FALSE, FALSE);
      st.Seek(0, soFromBeginning);
      sl.LoadFromStream(st);
      if sl.Count > 0 then
        comment := sl[0]
      else
        comment := '';
      ini.WriteString(cIniFaResult, 'Comment', comment);
      ini.WriteString(cIniFaResult, 'SysComment', GetSysComment);
      if FTextDocumentName<>'' then
        ini.WriteString(cIniFaResult, 'TxtDocName', FTextDocumentName);
      s := GetPeriod;
      ini.WriteString(cIniFaResult, 'Period', s);
      ini.WriteInteger(cIniFaResult, 'PeriodYear',
        StrToIntSafe(GetListItem(s, 0)));
      SaveMemIni(ini);
      {$IFNDEF STEREONX}
        SaveStringToFile(GetCharacteristics,
          NormalPath(ExtractFilePath(Application.ExeName)) + 'DKresultCh.txt');
      {$ELSE}
         SaveStringToFile(GetCharacteristics,souborCh); //#MR 2025
      {$ENDIF}

    finally
      ini.Free;
      st.Free;
      sl.Free;
    end;
  end
  else
    {$IFNDEF STEREONX }
    SaveStringToFile('[FaResult]' + cCRLF + 'Result=DataCancel',
      NormalPath(ExtractFilePath(Application.ExeName)) + 'DKresult.txt');
    {$ELSE}
       //#MR 2025
       SaveStringToFile('[FaResult]' + cCRLF + 'Result=DataCancel',souborT);
    {$ENDIF}
{$ENDIF STANDALONE}
end; {SaveSlaveInfo}

//dotaz na ulozeni souboru pri zavirani programu

procedure TfaMain.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
var
  res: integer;
  s: string;
  {$IFDEF UCURSOR}
  CloseResult: TCursorCloseResult;
  ScriptContent: AnsiString;
  {$ENDIF UCURSOR}
begin

  {$IFDEF UCURSOR}
  // WriteBridgeDebug('FormCloseQuery: START, FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  
  // KROK 1: Zkontroluj neuložené změny v Cursoru
  if Assigned(FBridge) then
  begin
    CloseResult := FBridge.CheckUnsavedChanges;
    
    case CloseResult of
      ccrUnsaved:
      begin
        // Soubor má neuložené změny - upozorni uživatele a zastav zavírání
        MsgBoxWarn(Caption, 
          'Script v Cursoru má neuložené změny. Nejdříve uložte změny v Cursoru (Ctrl+S) a pak znovu zavřete FORM asistenta.', 
          MB_OK);
        FBridge.ActivateCursorWindow; // Přepni na Cursor okno
        CanClose := False;
        Exit;
      end;
      
      ccrError:
      begin
        // Chyba komunikace - pokud Cursor není spuštěný nebo neodpovídá, pokračuj bez hlášení
        // (běžná situace když uživatel zavřel Cursor před zavřením FA)
        // Pouze loguj, ale neblokuj zavírání FA
      end;
      
      ccrNotOpen:
      begin
        // Script není otevřený - OK, můžeme pokračovat
      end;
      
      ccrClosed:
      begin
        // Script je uložený - pokračuj dál
      end;
    end;
    
    // KROK 2: Načti a zkompiluj script (pokud je otevřený)
    if (CloseResult = ccrClosed) and Assigned(FBridge.OnExternalSave) and (FCurrentFormId <> '') then
    begin
      try
        // Načti aktuální stav souboru z disku
        ScriptContent := FBridge.ReadScriptFileContent;
        if ScriptContent <> '' then
        begin
          // Zavolej BridgeExternalSave, která načte změny a zkompiluje script
          // (stejná logika jako při Alt+Q z Cursoru)
          // Pokud je v scriptu chyba, vyvolá se výjimka (zachycena v BridgeExternalSave)
          BridgeExternalSave(ScriptContent);
        end;
      except
        // Pokud nastala chyba při kompilaci, nezavři FA
        // (BridgeExternalSave už zobrazil chybové hlášení díky try-except v CheckAndLoadScript)
        FBridge.ActivateCursorWindow; // Přepni na Cursor okno, aby uživatel mohl opravit chybu
        CanClose := False;
        Exit;
      end;
    end;
    
    // KROK 3: Zavři soubor v Cursoru (pokud byl otevřený)
    if CloseResult = ccrClosed then
    begin
      CloseResult := FBridge.CloseCursorFile;
      // Pokud bylo zavření úspěšné, aktualizuj FLastWrite
      if CloseResult = ccrClosed then
      begin
        // Pokud byl script úspěšně zavřen a změna byla vyvolaná pouze synchronizací z Cursoru,
        // resetuj FStateFormWasChanged
        if FStateFormWasChanged and FScriptChangedByCursor then
        begin
          // WriteBridgeDebug('FormCloseQuery: Reset FStateFormWasChanged (změna byla pouze z Cursor synchronizace)'); // ZAKOMENTOVÁNO
          SetChangeFlag(FALSE);
          FScriptChangedByCursor := False;
        end;
      end;
    end;
  end;
  {$ENDIF UCURSOR}
  //
  if FFileOpened and FIsOpenedPDFEditor then begin
    MsgBoxWarn(Caption, sMsgAskCloseIfPDFEditorOpen, MB_OK);
    CanClose:=false;
    Exit;
  end;
  //
 {$IFNDEF FINALBUILD}
  if tmsDesigner <> nil then begin
    CloseTMSDesigner;
    CanClose:=false;
    Exit;
  end;
 {$ENDIF FINALBUILD}
  //
 {$IFDEF STANDALONE}
 {$IFNDEF FINALBUILD}
  if mtDef.Active then begin
    s:=mtDefScript.Value;
    if (Pos('SaveCompiled',s)>0) and (Pos('{#SaveCompiled}',s)=0)then begin
      MsgBoxWarn(Caption, 'POZOR! - Je vypnutá direktiva {#SaveCompiled}. Nezapomeň ji před vydáním formuláře zapnout', MB_OK);
      CanClose:=true;
    end;
    if Pos('{#OFF ',s)>0then begin
      MsgBoxWarn(Caption, 'POZOR! - Je zapnutý podmíněný překlad {#OFF ...}. Nezapomeň jej před vydáním formuláře vypnout', MB_OK);
      CanClose:=true;
    end;
  end;
  if CanClose then
    if not FNestedState then    
      CanClose := CloseScriptEditor;
  {$IFDEF FR3DESIGNER}
  if CanClose then
    CanClose := CloseFR3Designer;
  {$ENDIF FR3DESIGNER}
  {$IFDEF PDSDESIGNER}
  if CanClose then
    CanClose := ClosePDSDesigner;
  {$ENDIF PDSDESIGNER}
  if CanClose then
      CanClose := CloseGridView;
  if not CanClose then
    EXIT;
 {$ENDIF FINALBUILD}
 {$ENDIF STANDALONE}
  //
  CanClose := FCanClose;
  if not CanClose then
    EXIT;
  //
  {$IFDEF UCURSOR}
  // WriteBridgeDebug('FormCloseQuery: PŘED kontrolou FStateFormWasChanged=' + BoolToStr(FStateFormWasChanged)); // ZAKOMENTOVÁNO
  {$ENDIF UCURSOR}
  
  //pokud neni soubor ulozen, zeptat se na ulozeni a ulozit
  if FStateFormWasChanged then begin
    //Design mod
    if FIsDesignMode or dxBarButtonSaveDefAlways.Down then begin
      res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
        FDataFileName + '?', [MBYES, MBNO, MBCANCEL]);
      if res = IDYES then begin
        SaveDef;
      end
      else
        CanClose := not (res = IDCANCEL);
    end
    //User mode
    else begin
{$IFDEF STANDALONE}
      if FNestedState or (FSlaveState <> ssNone) then
        res := MessageAsk(Caption, sMsgAskSaveChanges, [MBYES, MBNO, MBCANCEL])
      else begin
        if FOpenNewFAOnStart <> 'true' then
          res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
            FDataFileName + '?', [MBYES, MBNO, MBCANCEL])
        else
          res := IDNO;
      end;
{$ELSE STANDALONE}
      res := MessageAsk(Caption, sMsgAskSaveChanges, [MBYES, MBNO, MBCANCEL]);
{$ENDIF STANDALONE}
      if res = IDYES then begin
      //spustit kontroly
        if ShowChecking then begin
          CanClose := FALSE;
          EXIT;
        end;

        if FNestedState then
          SetFormNestedData
{$IFDEF STANDALONE}
        else if FDataFileName <> '' then
          SaveData(FDataFileName)
        else
          SaveForm;
        if FSlaveState <> ssNone then begin
          SaveSlaveInfo(TRUE);
        end;
{$ELSE STANDALONE}
        else
          SaveFormToDatabase(TRUE);
{$ENDIF STANDALONE}
      end
      else if res = IDNO then begin
{$IFDEF STANDALONE}
        if FSlaveState <> ssNone then
          if FSlaveWasSaved then
            SaveSlaveInfo(TRUE)
          else
            SaveSlaveInfo(FALSE);
{$ELSE STANDALONE}
        CanClose:=CancelEditForm;
{$ENDIF}
      end
      else
        CanClose := FALSE;
    end;
  end
  else begin //formular nebyl zmenen
{$IFDEF STANDALONE}
    if FSlaveState <> ssNone then begin
      if FSlaveWasSaved then
        SaveSlaveInfo(TRUE)
      else
        SaveSlaveInfo(FALSE);
    end;
{$ELSE STANDALONE}
    if FDoCloseAutomatic then
      CanClose := TRUE
    else begin
      if FSaveHistoryToDB then
        SaveFormToDatabase(TRUE)
      else
        CanClose:=CancelEditForm;
    end;
    FSaveHistoryToDB := FALSE;
{$ENDIF STANDALONE}
  end;
end; {FormCloseQuery}

