begin
  SaveStringToFile(DataToXML(GetFormData(FALSE), XMLDoc), AFileName);
end;

//otevre dialog pro vyber souboru a pak otevre formular

procedure TfaMain.OpenForm;
var
  res: integer;
  changeFlg: boolean;
begin
  FTextDocumentName:='';
{$IFDEF STANDALONE}
  FDoShowExpressInfo:=FALSE;
{$ENDIF STANDALONE}
  //pokud neni soubor ulozen, zeptat se na ulozeni a ulozit
  if FStateFormWasChanged then begin
    res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
      FDataFileName + '?', [MBYES, MBNO, MBCANCEL]);
    if res = IDYES then begin
      if FDataFileName = '' then begin
        with SaveDialog1 do begin
          DefaultExt := cDataDefaultExt;
          Filter := cFormOpenSaveFilter;
          if Execute then begin
            if not FileExists(FileName) or
              (MessageAsk(Caption,Format(sMsgFileNotExistsAsk, [FileName]),
              [MBYES, MBNO]) = IDYES) then begin
              //ulozit do souboru
              SaveData(FileName);
            end;
          end;
        end;
      end
      else
        SaveData(FDataFileName);
    end
    else if res = IDCANCEL then
      EXIT;
  end;
  with OpenDialog1 do begin
    DefaultExt := cDataDefaultExt;
    Filter := cFormOpenSaveFilter;
    if Execute then begin
      if ExtractFileExt(FileName)=cFRMXDefaultExt then
         ImportFromXML(FileName)
      else if OpenFileData(FileName) then begin
        SetLayout;
        SetDesignButtons;
        InitModifiedTime;
        SetChangeFlag(FALSE);
        DoOnOpen;
        changeFlg := GetChangeFlag;
        DoEnable;
        SetChangeFlag(changeFlg);
        FocusFirstControl;
      end;
    end;
  end;
end; {OpenForm}

//otevre soubor ze souboru zadaneho jmena

procedure TfaMain.ReopenForm(const AFileData: string);
var
  res: integer;
  changeFlg: boolean;
begin
  FTextDocumentName:='';
{$IFDEF STANDALONE}
  FDoShowExpressInfo:=FALSE;
{$ENDIF STANDALONE}
  if Designer.Active then
    Designer.Active := FALSE;
  //pokud neni soubor ulozen, zeptat se na ulozeni a ulozit
  if FStateFormWasChanged then begin
    res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
      FDataFileName + '?', [MBYES, MBNO, MBCANCEL]);
    if res = IDYES then
      SaveData(FDataFileName)
    else if res = IDCANCEL then
      EXIT;
  end;
  if FileExists(AFileData) then begin
    if ExtractFileExt(AFileData)=cFRMXDefaultExt then
       ImportFromXML(AFileData)
    else if OpenFileData(AFileData) then begin
      SetLayout;
      SetDesignButtons;
      InitModifiedTime;
      SetChangeFlag(FALSE);
      DoOnOpen;
      changeFlg := GetChangeFlag;
      DoEnable;
      SetChangeFlag(changeFlg);
      FocusFirstControl;
    end;
  end
  else
    MessageErr(Caption, Format(sMsgCannotOpenFile, [AFileData]), [MBOK]);
end; {ReopenForm}

//Kdyz je ADefID neprazdne, tak otevre jen pokud souhlasi s DefID ulozenem
//  v datech

function TfaMain.OpenFileDataString(const ADataString: string;
  const AFileName: string = ''; const ADefID: string = ''): boolean;
var
  sl, sl1: TstringList;
  defID, headStr, defFileName, guid, masterGuid,
  fillingNumber, fillingPassword, fillingDate, fillingURL, fillingState,
  fillingTimeStampDate, fillingTimeStampSignature, locked, workState,
  expirationDate: string;
begin
  SetProgressPos(10);
  InitScriptFVariables;
  InitScriptGVariables;
  //
{$IFDEF PROFILER}TimeLog('== Start OpenFileDataString'); {$ENDIF PROFILER}
  Result := FALSE;
  SetReadOnly(FALSE);
  sl := TstringList.Create;
  sl1 := TstringList.Create;
  Refresh;
  try
    sl.Text := ADataString;
    headStr := GetSection(sl.Text, cFormHeadLabel);
    sl1.Text := headStr;
    defID := sl1.Values[mtTskpDefID.FieldName];
    LogStat('O:'+GetFormKey(defID));
    guid := sl1.Values[mtTskpGUID.FieldName];
    masterGuid := sl1.Values[mtTskpMasterGuid.FieldName];
    locked := sl1.Values[mtTskpLocked.FieldName];
    workState := sl1.Values[mtTskpWorkState.FieldName];
    expirationDate := sl1.Values[mtTskpExpirationDate.FieldName];

    fillingNumber := sl1.Values[mtTskpFillingNumber.FieldName];
    fillingPassword := sl1.Values[mtTskpFillingPassword.FieldName];
    fillingDate := sl1.Values[mtTskpFillingDate.FieldName];
    fillingState := sl1.Values[mtTskpFillingState.FieldName];
    fillingURL := sl1.Values[mtTskpFillingURL.FieldName];
    fillingTimeStampDate := sl1.Values[mtTskpFillingTimeStampDate.FieldName];
    fillingTimeStampSignature :=
      sl1.Values[mtTskpFillingTimeStampSignature.FieldName];
    if (ADefID <> '') and (defID <> ADefID) then begin
      if MessageAsk(Caption, sMsgDiferentDef, [MBYES, MBNO])<>IDYES then
        EXIT;
    end;
    if defID <> '' then begin
      defFileName := FindDefFile(defID);
      {$IFNDEF STANDALONE}
      if defFileName = '' then begin //neexistuje definice
        DwnlFiles4Def(defID); // ve FS se ji pokusime stahnout
        GetDefFromDB(defID);
        defFileName := FindDefFile(defID);
      end;
      {$ENDIF STANDALONE}
      if defFileName <> '' then begin
        FIsLoadingData := TRUE; //zakaz calculate
        try
          Result := OpenFileDef(defFileName);
        finally
          FIsLoadingData := FALSE;
        end;
        if Result then begin
          CreateMtTskp(mtDefID.Value, 0, guid, masterGuid,
            mtDefGroup.Value, mtDefSubGroup.Value,
            fillingNumber, fillingPassword, fillingDate, fillingState,
            fillingURL, fillingTimeStampDate, fillingTimeStampSignature, StrToIntSafe(workState),
            expirationDate);
          SetProgressPos(90);
          if FStateFormLocked then
            MessageInfo(Caption, sSbFormLocked, [MBOK]);
          SetLockFlag(StrToBoolSafe(locked));
          SetFormData(sl.Text);
          SetProgressPos(100);
          ReloadListBoxes; //pri otevreni formulare musime aktualizovat list boxy na prvni strane, pokud tam jsou
          dxBarComboWorkState.Text:=workState;
          SetChangeFlag(FALSE); //musime provest jeste jednou po SetLockFlag
        end
        else  begin
          if FNeedVerNew then begin
            MessageInfo(Caption, sMsgNeedVer, [MBOK]);
            CloseForm;
          end
          else
            MessageErr(Caption, Format(sDataDefErrOpen,
              [ExtractFileName(AFileName)]), [MBOK]);
        end;
      end
      else
        MessageErr(Caption, Format(sDataDefNotFound,
          [DefID,ExtractFileName(AFileName)]), [MBOK]);
    end
    else
      MessageErr(Caption, Format(sDataDefIDInvalid,
        [ExtractFileName(AFileName)]), [MBOK]);
  finally
    SetProgressPos(-1);
    sl.Free;
    sl1.Free;
  end;
{$IFDEF PROFILER}TimeLog('== End OpenFileDataString'); {$ENDIF PROFILER}
end; {OpenFileDataString}

//Nove funkce pro import z UCTA
const
  cXFDFRootLabel = 'xfdf';
  cXFDFieldsLabel = 'fields';
  cXFDFFieldLabel = 'field';
  cXFDFFieldName = 'name';
  cXFDFFieldValue = 'value';

//Transformuje XFDF do TXT formatu ucta

function TfaMain.XFDFToIni(AImportSectionName, AXMLData: string): string;
var
  node, node1, node2: IXMLNode;
  i: integer;
begin
  StartWait;
  try
    Result := '';
    //uprava XFDF na XML
    AXMLData := Replace(
      '<xfdf xmlns="http://ns.adobe.com/xfdf/" xml:space="preserve">',
      AXMLData, '<xfdf>');
    XMLDoc.XML.Text := AXMLData;
    //
    XMLDoc.Active := TRUE;
    //XML v nativnim formatu
    if XMLDoc.DocumentElement.NodeName = cXFDFRootLabel then begin
      AddStrLine(Result, AImportSectionName);
      node := XMLDoc.DocumentElement.ChildNodes.Nodes[cXFDFieldsLabel];
      for i := 0 to node.ChildNodes.Count - 1 do begin
        node1 := node.ChildNodes.Nodes[i];
        node2 := node1.ChildNodes.Nodes[cXFDFFieldValue];
        AddStrLine(Result, '"' + VarToStr(node1.Attributes[cXFDFFieldName]) +
          '"' + ',' + '"' +
          Replace(#10, VarToStr(node2.NodeValue), '~') + '"');
      end;
    end;
    XMLDoc.Active := FALSE;
  finally
    StopWait;
  end;
end; {XFDFToIni}

function TfaMain.TranslateImportData(AData: string; ADoConversion: boolean;
  out ADefID: string): string;
var
  idf, sl: TStringList;
  kodovani,
    decimalSep, thousandSep, dateSep, trueVal,
    valueDelimiter, valueSeparator,
    dfID, value, defFileName, fldType: string;
  i: integer;
  convConstSec: string;

  function Str852To1250(const AStr: string): string;
  const
    c852To1250: array[128..255] of byte =
    //(128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,
    (199, 252, 233, 226, 228, 249, 230, 231, 179, 235, 213, 245, 238, 143, 196,
    // 143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,
      198, 201, 197, 229, 244, 246, 188, 190, 140, 156, 214, 220, 141, 157, 163,
    // 158,159,160,161,162,163,164,165,166,167,168,169,170,171,172,
      215, 232, 225, 237, 243, 250, 165, 185, 142, 158, 202, 234, 160, 159, 200,
    // 173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,
      186, 171, 187, 164, 164, 164, 164, 164, 193, 194, 204, 170, 164, 164, 164,
    // 188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,
      164, 175, 191, 164, 164, 164, 164, 164, 164, 164, 195, 227, 164, 164, 164,
    // 203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,
      164, 164, 164, 164, 164, 240, 208, 207, 203, 239, 210, 205, 206, 236, 164,
    // 218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,
      164, 164, 164, 222, 217, 164, 211, 223, 212, 209, 241, 242, 138, 154, 192,
    // 233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,
      218, 224, 219, 253, 221, 254, 180, 173, 189, 178, 161, 162, 167, 247, 184,
    // 248,249,250,251,252,253,254,255);
      176, 168, 183, 251, 216, 248, 164, 32);
  var
    i: integer;
  begin
    Result := AStr;
    for i := 1 to Length(Result) do
      if Ord(Result[i]) >= 128 then
        Result[i] := Chr(c852To1250[Ord(Result[i])]);
  end; {Str852To1250}

  function Left(const AStr: string): string;
  var
    p: integer;
  begin
    p := Pos('=', AStr);
    if p > 0 then
      Result := Copy(AStr, 1, p - 1)
    else
      Result := '';
  end;

  function Right(const AStr: string): string;
  var
    p: integer;
  begin
    p := Pos('=', AStr);
    if p > 0 then
      Result := Copy(AStr, p + 1, maxint)
    else
      Result := '';
  end;

  function TranslateExpr(const AExpr: string): string;
  var
    lpos, rpos: integer;
    rest: string;
  begin
    Result := '';
    rest := AExpr;
    lpos := Pos('{', rest);
    if lpos > 0 then begin
      while lpos > 0 do begin
        if lpos = 1 then begin //prevedeme udaj
          rpos := Pos('}', rest);
          if rpos = 0 then
            rpos := lpos;
          Result := Result + '''' + sl.Values[Copy(rest, lpos + 1, rpos - lpos -
            1)] + '''';
          rest := Copy(rest, rpos + 1, maxint);
          lpos := Pos('{', rest);
        end
        else begin
          Result := Result + Copy(rest, 1, lpos - 1);
          rest := Copy(rest, lpos, maxint);
          lpos := Pos('{', rest);
        end;
      end;
      Result := Result + rest;
    end
    else
      Result := rest;
  end;

  procedure LoadConversionConst(const AConvConstSec, ASec: string);
  var
    sl: TStringList;
  begin
    sl := TStringList.Create;
    try
      kodovani := '';
      decimalSep := '';
      thousandSep := '';
      dateSep := '';
      trueVal := '';
      valueDelimiter := '';
      valueSeparator := '';

      sl.Text := AConvConstSec;

      if sl.Values['$CodePage'] <> '' then
        kodovani := sl.Values['$CodePage'];
      if sl.Values['$DecimalSeparator'] <> '' then
        decimalSep := sl.Values['$DecimalSeparator'];
      if sl.Values['$ThousandSeparaor'] <> '' then
        thousandSep := sl.Values['$ThousandSeparaor'];
      if sl.Values['$DateSeparator'] <> '' then
        dateSep := sl.Values['$DateSeparator'];
      if sl.Values['$TrueValue'] <> '' then
        trueVal := sl.Values['$TrueValue'];
      if sl.Values['$ValueDelimiter'] <> '' then
        valueDelimiter := sl.Values['$ValueDelimiter'];
      if sl.Values['$ValueSeparator'] <> '' then
        valueSeparator := sl.Values['$ValueSeparator'];

      sl.Text := ASec;

      if sl.Values['$CodePage'] <> '' then
        kodovani := sl.Values['$CodePage'];
      if sl.Values['$DecimalSeparator'] <> '' then
        decimalSep := sl.Values['$DecimalSeparator'];
      if sl.Values['$ThousandSeparaor'] <> '' then
        thousandSep := sl.Values['$ThousandSeparaor'];
      if sl.Values['$DateSeparator'] <> '' then
        dateSep := sl.Values['$DateSeparator'];
      if sl.Values['$TrueValue'] <> '' then
        trueVal := sl.Values['$TrueValue'];
      if sl.Values['$ValueDelimiter'] <> '' then
        valueDelimiter := sl.Values['$ValueDelimiter'];
      if sl.Values['$ValueSeparator'] <> '' then
        valueSeparator := sl.Values['$ValueSeparator'];

      if Length(decimalSep) >= 2 then
        decimalSep := Copy(decimalSep, 2, 1);
      if Length(thousandSep) >= 2 then
        thousandSep := Copy(thousandSep, 2, 1);
      if Length(dateSep) >= 2 then
        dateSep := Copy(dateSep, 2, 1);
    finally
      sl.Free;
    end;
  end;

begin
  idf := TStringList.Create;
  sl := TStringList.Create;
  try
    Result := '';
    //nacist idf - rizeni konverze
    if FileExists(NormalPath(ExtractFilePath(Application.ExeName)) +
      'import.idf') then
      idf.LoadFromFile(NormalPath(ExtractFilePath(Application.ExeName)) +
        'import.idf');
    convConstSec := GetSection(AnsiUpperCase(idf.Text), '[CONVERSIONCONST]');
    LoadConversionConst(convConstSec, idf.Text);
    //prekodovani
    if ADoConversion and (kodovani = '852') then
      AData := Str852To1250(AData);
    //
    sl.Text := AData;
    //
    dfID := sl[0];
    dfID := Replace(valueDelimiter, dfID, '');
    if Pos(' ', dfID) > 0 then begin
      dfID := Copy(dfID, Pos(' ', dfID) + 1, maxint);
      dfID := Replace('"', dfID, '');
    end;
    //
    idf.Text := GetSection(AnsiUpperCase(idf.Text), '[' + AnsiUpperCase(dfID) +
      ']');
    LoadConversionConst(convConstSec, idf.Text);
    //zapis hlavicky [FormHead]
    AddStrLine(Result, cFormHeadLabel);
    ADefID := idf.Values['$DefID'];
    AddStrLine(Result, 'DefID=' + ADefID);
    AddStrLine(Result, '');
    //[UserSettings]
    AddStrLine(Result, cFormUserSettingsLabel);
    AddStrLine(Result, 'US_CalcDisabled=True');
    AddStrLine(Result, '');
    //otevreni definice
    if ADefID <> '' then begin
      defFileName := FindDefFile(ADefID);
      if defFileName <> '' then begin
        FStateFormWasChanged := FALSE;
        ReopenDef(defFileName);
        ApplyMainCaption('');
      end
      else begin
        MessageWarn(Caption, Format(sMsgErrImportFormat, ['']), [MBOK]);
        Result := '';
        EXIT;
      end;
    end
    else begin
      MessageWarn(Caption, Format(sMsgErrImportFormat, ['']), [MBOK]);
      Result := '';
      EXIT;
    end;
    //zapis hodnot [Values]
    AddStrLine(Result, cFormValuesLabel);
    // odstanime delimiter a nahradime separator
    for i := 0 to sl.Count - 1 do begin
      if Copy(sl[i], 1, 1) = valueDelimiter then
        sl[i] := Copy(sl[i], 2, Length(sl[i]) - 2);
          //odstranime pocatecni a koncovy delimiter
      sl[i] := Replace(valueDelimiter + valueSeparator + valueDelimiter, sl[i],
        '=');
    end;
    // v idf je sekce pouze pro aktualni formular
    for i := 0 to idf.Count - 1 do begin
      if (Copy(idf[i], 1, 1) <> ';') and (Copy(idf[i], 1, 1) <> '$') then begin
        //odstraneni slozene zavorky
        if (Copy(Right(idf[i]), 1, 1) = '{') and (Copy(idf[i], Length(idf[i]), 1)
          = '}') then
          idf[i] := Copy(idf[i], 1, Length(idf[i]) - 1);
        //# udaj z importovanych dat
        if (Copy(Right(idf[i]), 1, 1) = '#') or (Copy(Right(idf[i]), 1, 1) = '{')
          then begin
          value := sl.Values[Copy(Right(idf[i]), 2, maxint)];
          //konverze
          if mtFields.Active and
            mtFields.FindKey([UpperCase(Left(idf[i]))])
            {mtFields.Locate(mtFieldsName.FieldName,Left(idf[i]), //opt
            [loCaseInsensitive])}then begin
            fldType := mtFieldsDataType.AsString;
            if (fldType = cNumericTypeValue) or (fldType = cCurrencyTypeValue)
              then begin
              value := Replace(thousandSep, Value, '');
              value := Replace(decimalSep, Value, '.');
            end
            else if fldType = cDateTypeValue then begin
              value := Replace(dateSep, Value, '.');
            end
            else if fldType = cBooleanTypeValue then begin
              if AnsiUpperCase(value) = AnsiUpperCase(trueVal) then
                value := 'True'
              else
                value := 'False';
            end;
          end
          else
            value := '';
          //
          AddStrLine(Result, Left(idf[i]) + '=' + value);
        end //@vyraz
        else if Copy(Right(idf[i]), 1, 1) = '@' then
          AddStrLine(Result, Left(idf[i]) + '=' +
            Evaluate(TranslateExpr(Copy(Right(idf[i]), 2, maxint)),nil))
        //konstanta
        else
          AddStrLine(Result, idf[i]);
      end;
    end;
  finally
    idf.Free;
    sl.Free;
  end;
end; {TranslateImportData}

function TfaMain.OpenFileData(const AFileName: string): boolean;
var
  sl: TStringList;
  defID, defFileName: string;
  i: integer;
begin
  Result := FALSE;
  if not FileExists(AFileName) then begin
    MsgBoxWarn(Caption,Format(sMsgFileNotFound,[AFileName]),MB_OK);
    Exit;
  end;

  sl := TstringList.Create;
  try
    //nativni format FRM
    if AnsiSameText(ExtractFileExt(AFileName), cDataDefaultExt) then begin
      sl.LoadFromFile(AFileName);
      Result := OpenFileDataString(sl.Text, AFileName);
      FDataFileName := AFileName;
    end
    // XML FA
    else if AnsiSameText(ExtractFileExt(AFileName), cXMLDefaultExt) then begin
      sl.LoadFromFile(AFileName);
      sl.Text := XMLToData(sl.Text, XMLDoc);
      if sl.Text <> '' then begin
        if GetStringLine(sl.Text, 0) = cFormHeadLabel then begin
          InitTskpInfo;
          Result := OpenFileDataString(sl.Text, AFileName);
          if Result then begin
            FDataFileName := '';
            SetChangeFlag(TRUE);
          end;
        end;
      end;
    end
    //jiny soubor zkusime importovat
    else begin
      sl.LoadFromFile(AFileName);
      if AnsiUpperCase(ExtractFileExt(AFileName)) =
        AnsiUpperCase(cXFDFDefaultExt) then begin //data PDF v XML
        sl.Text := XFDFToIni(ChangeFileExt(ExtractFileName(AFileName), ''),
          sl.Text);
        sl.Text := TranslateImportData(sl.Text, FALSE, DefID);
      end
      else
        sl.Text := TranslateImportData(sl.Text, TRUE, DefID);
      if sl.Text <> '' then begin
        InitTskpInfo;

{$IFDEF STANDALONE}
        FSilentMsgDisableCalc := TRUE;
{$ENDIF STANDALONE}
        try
          SetDisableClacFlag(TRUE, TRUE);
          SetValuesData(sl.Text);
          FDataFileName := '';
          SetChangeFlag(TRUE);
          //SetDisableClacFlag(TRUE, TRUE);
        finally
{$IFDEF STANDALONE}
          FSilentMsgDisableCalc := FALSE;
{$ENDIF STANDALONE}
        end;

{        FSilentMsgDisableCalc := TRUE;
        try
          Result:=OpenFileDataString(sl.Text);
          if Result then begin
            FDataFileName := '';
            SetChangeFlag(TRUE);
          end;
        finally
          FSilentMsgDisableCalc := FALSE;
        end;}

      end;
    end;
{$IFDEF STANDALONE}
    if ((GetFileInformation(AFileName).Attr and faReadOnly) <> 0) then
      SetReadOnly(TRUE);
{$ENDIF STANDALONE}
    ApplyMainCaption(FDataFileName);
  finally
    sl.Free;
  end;
end; {OpenFileData}

