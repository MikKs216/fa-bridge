procedure TfaMain.ExportFillingDS;
var
  typDoc, doc, fn, clientName, mailadr, err, openBrowser, outfilename: string;
  sel, doDS, ok, useStdDlg: boolean;
  p: integer;
  sl: TStringList;
begin
  LogStat('e2');
  useStdDlg := TRUE;
{$IFDEF STANDALONE}
{$IFNDEF FINALBUILD}
  if (GetKeyState(VK_CONTROL) < 0) then
    useStdDlg := TRUE
  else
    useStdDlg := FALSE;
{$ENDIF FINALBUILD}
{$ENDIF STANDALONE}
  if not FFileOpened then
    EXIT;
  if ShowChecking then
    EXIT;
  if FStateFormWasChanged then begin
    DoCalculate;
    TryPostMtValues;
  end;
{$IFNDEF ELPODANITEST}
{$IFDEF FINALBUILD}
  if not IsLicenceForDefOk then
    MessageInfo(Caption, sMsgDisableElFillingLic, [MBOK])
  else
  {$ENDIF FINALBUILD}
{$ENDIF ELPODANITEST}
  begin
    doc := GetElFilling;

    if (Length(doc)=0) then begin
      MessageInfo(Caption,'Obsah podání je prázdný, podání se nevytvoří.',[MBOK]);
      EXIT;
    end
    else if Copy(doc,1,2)='-1' then // kdyz nechceme zobrazovat hlaseni zde - osetri si programator formulare
      Exit;

    clientName:=Copy(PrepareClientAdress,1,40);

    //CSSZ --------------------------------------------------------------------
    if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PVS:>') then begin
      fn:=SetValidFileNameTrim(
        Copy(mtDefName.Value,1,60) + ', ' +
        GetListItem(GetPeriod, 3) + ' ' +
        GetSysComment + ' EP - ' + clientName + cXMLDefaultExt);

      if useStdDlg then
        sel := SelectEmail(mailadr,True,True,True)
      else begin
        sel := True;
        mailadr := cSaveToDisk;
      end;
      doDS := false;
      if sel then begin
        if (FClientParam<>nil) then
          EIInitSaveDlgExport(SaveDialog1, FClientParam.Values['Description']);

        if mailadr=cSaveToDisk then begin
          ok:=ExportPVSElFilling(doc,SaveDialog1,fn);
          //nacteni na web
          if ok then
            OpenPortalCSSZ(fn);
        end
        else begin
          fn := GetWorkPath + fn; //Namet 1959
          if FileExists(fn) then  //Namet 1959
            DeleteFile(fn);

          if ExportPVSElFilling(doc,SaveDialog1, fn, true) then begin
            sl:= TStringList.Create;
            try
              sl.Text:=fn;
              doDS := SendISDSOrEmail(mailadr,mtDefName.AsString,'',sl,TRUE,err,outfilename);
              DeleteFile(fn);
              //
              WritePdfToDocs('Soubor XML pro el. podání '+GFaMain.mtDefName.Value,fn,FALSE,'',doDS);
            finally
              sl.Free;
            end;
          end;
        end;
      end;
    end
    //ZP ----------------------------------------------------------------------
    else if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PZP:>') then begin
      MessageErr(Caption,'Formulář nelze exportovat pro elektronické podání. Můžete jej podat funkcí "Podat elektronicky" nebo poslat v PDF do datové schránky.',[MBOK]);
    end
    //MF ----------------------------------------------------------------------
    else begin
      if Copy(UpperCase(doc),1,5)='<?XML' then begin
        fn:=SetValidFileNameTrim(
          Copy(mtDefName.Value,1,60) + ', ' +
          GetListItem(GetPeriod, 3) + ' ' +
          GetSysComment + ' EP - ' + clientName + cXMLDefaultExt);

        if useStdDlg then
          sel := SelectEmail(mailadr,True,True,True)
        else begin
          sel := True;
          mailadr := cSaveToDisk;
        end;
        if sel then begin
          if mailadr=cSaveToDisk then begin
            ok:=ExportElFilling(doc,SaveDialog1,fn);
            //nacteni na web
            openBrowser := ClientParam('FOExportXMLOpenEPO');
            if IsWebBrowser and ok and (ExtractFileExt(fn)=cXMLDefaultExt) and
              StrToBoolSafe(openBrowser) and
              (MessageAsk(Caption,'Chcete teď soubor načíst na web Finanční správy?', [MBYES, MBNO]) = IDYES) then
              OpenWebBrowser(
                '', //'https://adisepo.mfcr.cz/adistc/adis/idpr_epo/epo2/spol/soubor_vyber.faces' vezme se s distrib. ini
                GetStringLineValue(FClientParam.Text, 'ISDSUsrId'),
                GetStringLineValue(FClientParam.Text, 'ISDSPswd'),
                fn,'UPLOAD','Elektronické podání formuláře na Finanční správu');
          end
          else begin
            fn:=GetUniqueFileName(GetWorkPath,fn);
            if ExportElFilling(doc,SaveDialog1,fn,true) then begin
              sl:= TStringList.Create;
              try
                sl.Text:=fn;
                doDS:=SendISDSOrEmail(mailadr,mtDefName.AsString,'',sl,TRUE,err,outfilename);
                DeleteFile(fn);
                //
                WritePdfToDocs('Soubor XML pro el. podání '+GFaMain.mtDefName.Value,fn,FALSE,'',doDS);
              finally
                sl.Free;
              end;
            end;
          end;
        end;
      end
      else
        MessageErr(Caption,'Chyba definice předlohy: "function Fillig; invalid XML ('+
        Copy(doc,1,40)+
        '...)". Proveďte aktualizaci formulářů.',[MBOK]);
    end;
  end;
end;

procedure TfaMain.ElFilling;
const
  cGtcName = 'GovTalkClass';
  cEtName = 'EnvelopeType';
  cVsName = 'VarSym';
var
  typDoc, doc, gtc, et, vs: string;
  p,p1,p2,p3,p4,p5,p6,px: integer;
  wasLocked, wasChanged: boolean;
begin
  LogStat('5');
  if not FFileOpened then
    EXIT;
  if ShowChecking then
    EXIT;
  if FStateFormWasChanged then begin
    DoCalculate;
    TryPostMtValues;
  end;
{$IFNDEF ELPODANITEST}
{$IFDEF FINALBUILD}
  if not IsLicenceForDefOk then
    MessageInfo(Caption, sMsgDisableElFillingLic, [MBOK])
  else
  {$ENDIF FINALBUILD}
{$ENDIF ELPODANITEST}
  begin
    if FLocalVersion=cLocalVersionSK then begin
      //puvodni verze jen generovani XML
      doc := GetElFilling;
      if (Length(doc)=0) then begin
        MessageInfo(Caption,'Obsah podání je prázdný, podání se nevytvoří.',[MBOK]);
        EXIT;
      end
      else if Copy(doc,1,2)='-1' then // kdyz nechceme zobrazovat hlaseni zde - osetri si programator formulare
        Exit;

      if doc <> '' then with SaveDialog1 do begin
          FileName := SetValidFileNameTrim(mtDefName.Value + ', ' +
            GetListItem(GetPeriod, 3) + ' ' +
            GetSysComment + ' EP' + cXMLDefaultExt);
          DefaultExt := cXMLDefaultExt;
          Filter := cXMLOpenSaveFilter;
          if Execute then
            if not FileExists(FileName) or
              (MessageAsk(Caption,
              Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then
              SaveStringToFile(doc, FileName);
        end;
    end
    else begin
      //Pokud je formular zamknuty tak dame dotaz
      if FStateFormLocked then begin
        if MessageAsk(Caption, sMsgFormLockedBeforeEP, [MBYES, MBNO]) = IDNO then
          EXIT;
      end;
      
      doc := GetElFilling;
      if (Length(doc)=0) then begin
        MessageInfo(Caption,'Obsah podání je prázdný, podání se nevytvoří.',[MBOK]);
        EXIT;
      end
      else if Copy(doc,1,2)='-1' then // kdyz nechceme zobrazovat hlaseni zde - osetri si programator formulare
        Exit;
    end;

    wasLocked:=FStateFormLocked;
    SetLockFlag(FALSE);
    try
      //CSSZ
      if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PVS:>') then begin
        p:=Pos('</PVS:>',doc);
        if p>0 then begin
          typDoc:=Copy(doc,7,p-7);
          doc:=Copy(doc,p+7,maxint);

          if typDoc='PVS' then begin
            p1:=Pos('<'+cGtcName+':>',doc);
            p2:=Pos('</'+cGtcName+':>',doc);
            gtc:='';
            if (p1>0)and(p2<>0) then
              gtc:=Copy(doc,p1+Length(cGtcName)+3,p2-p1-Length(cGtcName)-3);

            p3:=Pos('<'+cEtName+':>',doc);
            p4:=Pos('</'+cEtName+':>',doc);
            et:='';
            if (p3>0)and(p4<>0) then
              et:=Copy(doc,p3+Length(cEtName)+3,p4-p3-Length(cEtName)-3);

            p5:=Pos('<'+cVsName+':>',doc);
            p6:=Pos('</'+cVsName+':>',doc);
            vs:='';
            if (p5>0)and(p6<>0) then
              vs:=Copy(doc,p5+Length(cVsName)+3,p6-p5-Length(cVsName)-3);

            if p2>p4 then
              px:=p2+Length(cGtcName)+4
            else
              px:=p4+Length(cEtName)+4;
            if p6>px then
              px:=p6+Length(cVsName)+4;

            if typDoc='' then
              typDoc:='PVS';
            doc:=Copy(doc,px,maxint);
          end;
        end
        else
          typDoc:='';
        if typDoc<>'' then
          OpenPVSElFilling(doc,typDoc,gtc,et,vs,Left+5,Top+30)
        else
          MessageErr(Caption,'Chyba definice předlohy: "function Fillig; undefined TypDoc (PVS)". Proveďte aktualizaci formulářů.',[MBOK]);
      end
      //ZP
      else if (Length(doc)>6) and (UpperCase(Copy(doc,1,6))='<PZP:>') then begin
        p:=Pos('</PZP:>',doc);
        if p>0 then begin
          typDoc:=Copy(doc,7,p-7);
          doc:=Copy(doc,p+7,maxint);
        end
        else
          typDoc:='';
        if typDoc<>'' then
          OpenElFilling(doc,typDoc,Left+5,Top+30)
        else
          MessageErr(Caption,'Chyba definice předlohy: "function Fillig; undefined TypDoc (PZP)". Proveďte aktualizaci formulářů.',[MBOK]);
      end
      //MF
      else begin
        if Copy(UpperCase(doc),1,5)='<?XML' then
          OpenElFilling(doc,'',Left+5,Top+30)
        else
          MessageErr(Caption,'Chyba definice předlohy: "function Fillig; invalid XML ('+
          Copy(doc,1,40)+
          '...)". Proveďte aktualizaci formulářů.',[MBOK]);
      end;
    finally
      if wasLocked and not FStateFormLocked then begin
        wasChanged := FStateFormWasChanged;
        SetLockFlag(wasLocked);
        SetChangeFlag(wasChanged);
      end;
    end;
  end;
end;

