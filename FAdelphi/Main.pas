procedure TfaMain.rvActionOpen1Execute(Sender: TObject);
begin
  if not FStateFormLocked then with OpenDialog1 do begin
    DefaultExt := cRTFDefaultExt;
    Filter := cRTFOpenSaveFilter;
    if Execute then begin
      if FileName<>'' then begin
        PostMessage(reNotes.Handle, WM_KEYDOWN, VK_END, 0);
        PostMessage(reNotes.Handle, WM_KEYDOWN, VK_SPACE, 0);
        reNotes.Clear;
        if AnsiSameText(ExtractFileExt(FileName),'.rtf') then
          reNotes.RichViewEdit.LoadRTF(FileName)
        else if AnsiSameText(ExtractFileExt(FileName),'.rvf') then
          reNotes.RichViewEdit.LoadRVF(FileName)
        else
          reNotes.RichViewEdit.LoadText(FileName,0,0,FALSE);
        reNotes.Format;
      end;
    end;
  end;
end;

procedure TfaMain.rvActionSaveAs1Execute(Sender: TObject);
begin
  if not FStateFormLocked then with SaveDialog1 do begin
    DefaultExt := cRTFDefaultExt;
    Filter := cRTFOpenSaveFilter;
    if Execute then begin
      if FileName<>'' then begin
        if AnsiSameText(ExtractFileExt(FileName),'.rtf') then
          reNotes.RichViewEdit.SaveRTF(FileName, FALSE)
        else if AnsiSameText(ExtractFileExt(FileName),'.rvf') then
          reNotes.RichViewEdit.SaveRVF(FileName, FALSE)
        else
          reNotes.RichViewEdit.SaveText(FileName,80);
      end;
    end;
  end;
end;

