procedure TFaMainScripterLibrary.tms_kbMTGetFieldValueProc(AMachine: TatVirtualMachine);
begin
  With AMachine do
    if TField(CurrentObject).Value = null then begin
      if (TField(CurrentObject).DataType = ftString) or
       (TField(CurrentObject).DataType = ftMemo) then
        ReturnOutputArg('')
      else if (TField(CurrentObject).DataType = ftFloat) or
        (TField(CurrentObject).DataType = ftCurrency) then
        ReturnOutputArg(0.0)
      else
        ReturnOutputArg(0);
    end
    else
      ReturnOutputArg(TField(CurrentObject).Value);
end;

procedure TFaMainScripterLibrary.tms_kbMTSetFieldValueProc(AMachine: TatVirtualMachine);
begin
