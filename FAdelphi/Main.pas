//vytvori novy formular podle definice AFileDef, pokud je neprazdny parametr
//  AData, naplni data do formulare. AData pokud je neprazdne tak musi obsahovat
//  data ve formatu souboru frm

procedure TfaMain.OpenNewForm(const ADefFileName: string;
  const AData: string = '');
begin
  StartWait;
  try
{$IFDEF PROFILER}TimeLog('======== Start OPEN FORM'); {$ENDIF PROFILER}
    if FFileOpened then
      CloseForm;
    SetReadOnly(FALSE);
    SetFocusContent;
    FDataFileName := '';
    InitScriptFVariables;
    InitScriptGVariables;
    EmptyPage;
    if OpenFileDef(ADefFileName) then begin
      CreateMtTskp(mtDefID.Value, 0, '', '', mtDefGroup.Value, mtDefSubGroup.Value);
{$IFDEF PROFILER}TimeLog('CreateMtTskp'); {$ENDIF PROFILER}
      InitTskpInfo;
{$IFDEF PROFILER}TimeLog('InitTskpInfo'); {$ENDIF PROFILER}
      if AData <> '' then
        SetFormData(AData)
      else begin
        GenMtValues(TRUE, TRUE);
        DoInit;
      end;
{$IFDEF PROFILER}TimeLog('DoInit'); {$ENDIF PROFILER}
      DoCalculate;
{$IFDEF PROFILER}TimeLog('DoCalculate'); {$ENDIF PROFILER}
      SetLiveCheck(True);
      DisplayCheck; //po otevreni
      ApplyMainCaption('');
      FFileOpened := TRUE;
      //inicializovat tlacitka
      dxBarButtonSaveAs.Enabled := TRUE;
      dxBarButtonClose.Enabled := TRUE;
      FocusFirstControl;
      LogStat('N:'+GetFormKey(mtDefID.Value));
    end
    else begin
      if FNeedVerNew then begin
        MessageInfo(Caption, sMsgNeedVer, [MBOK]);
        CloseForm;
      end
      else
        MessageErr(Caption, Format(sDataDefErrOpen,
          [ExtractFileName(ADefFileName)]), [MBOK]);
    end;
  finally
    StopWait;
  end;
{$IFDEF PROFILER}TimeLog('======== End OPEN FORM'); {$ENDIF PROFILER}
end; {OpenNewForm}

//vytvori novy formular

procedure TfaMain.NewForm(ASelectFromTable: boolean = FALSE);
var
  res: integer;
  selectedFileName,defName,txtDocument: string;
begin
  FTextDocumentName:='';
  //pokud neni soubor ulozen, zeptat se na ulozeni a ulozit
  if FStateFormWasChanged then begin
    res := MessageAsk(Caption, sMsgAskSaveFile +  ' ' +
      FDataFileName + '?', [MBYES, MBNO, MBCANCEL]);
    if res = IDYES then begin
      if FDataFileName = '' then begin
        with SaveDialog1 do begin
          DefaultExt := cDataDefaultExt;
          Filter := cFormOpenSaveFilter;
          if Execute then begin
            if not FileExists(FileName) or
              (MessageAsk(Caption,Format(sMsgFileNotExistsAsk, [FileName]),
              [MBYES, MBNO]) = IDYES) then begin
              //ulozit do souboru
              SaveData(FileName);
            end;
          end;
        end;
      end
      else
        SaveData(FDataFileName);
    end
    else if res = IDCANCEL then
      EXIT
    else
      CloseForm(FALSE);
  end;
  if ASelectFromTable then begin
{$IFDEF STANDALONE}
    selectedFileName := SelectDef(nil, Left + paLeft.Width + 5, Top + 80,
      FParamDefColor,FReportVariants,defName,txtDocument);
    if selectedFileName=cDefIDTextDocument then
      FTextDocumentName:=defName;
{$ELSE STANDALONE}
    selectedFileName := ''; //ve FS se tato funkce nepouziva
{$ENDIF STANDALONE}
    if selectedFileName <> '' then begin
      if txtDocument<>'' then begin
        OpenFileDataString(txtDocument);
        PostMessage(Self.Handle, WM_KEYDOWN, VK_NEXT, 0);
      end
      else {B}
        OpenNewForm(NormalPath(DirDefsPath) + selectedFileName + cDefDefaultExt);
    end;
  end
  else begin
    with OpenDialog1 do begin
      DefaultExt := cDefDefaultExt;
      Filter := cDefOpenSaveFilter;
      if Execute then
        OpenNewForm(FileName);
    end;
  end;
end; {NewForm}

