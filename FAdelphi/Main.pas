function TfaMain.TranslateFieldNames(const AScript: string): string;
//var
  //start: TDateTime;
const
  cLeftFldBracket = '[.';
  cRightFldBracket = '.]';
  cLeftFldBracketAsString = '[:';
  cRightFldBracketAsString = ':]';
  cLeftFldBracketNumber = '[*';
  cRightFldBracketNumber = '*]';
