//provede vypocet default value

procedure TfaMain.DoDefault(const AFieldName: string; ADoAlways: boolean =
  TRUE);
var
  aValue: variant;
  fld: TField;
  stateFormWasChanged: boolean;
begin
  if FIsDesignMode or FIsChangingScript or FStateFormLocked or
    mtValues.ReadOnly then
    EXIT;
  //
  StartWait;
  stateFormWasChanged := FStateFormWasChanged; //ulozit stav formulare
  try
    if mtFields.Active and mtValues.Active and
      (mtValues.RecordCount > 0) and not FStateFormLocked and
      not mtValues.ReadOnly then begin
      fld := GetMTVField(AFieldName);
      if mtFields.FindKey([UpperCase(AFieldName)])
        {mtFields.Locate(mtFieldsName.FieldName, AFieldName, [])}and //opt
        not mtFieldsHasDefault.Value then
        EXIT; //kdyz nema defaultvalue tak neprovadime
      if not ADoAlways and
        (fld <> nil) and (fld is TStringField) and
        (fld.Value <> '') and (fld.Value <> null) then
        EXIT; //u neprazdneho textoveho udaje neprovadime pri posunu kurzorem
      if fld <> nil then
        aValue := fld.AsVariant;
      FScriptState := ssDefault;
      FScriptFieldName := AFieldName;
      try
        if not FNestedPrepareReportState then
          if FNewScripter then
            ScripterT_ExecuteSubRoutine(sScriptProcName_Init)
          else
            Scripter.CallNoParamsMethod(sScriptProcName_Init);
      finally
        FScriptState := ssNoActive;
      end;
      if (fld <> nil) and (CEdit.Parent <> sbBackGround)
        and (CEdit.Hint = AFieldName) then begin
        FEditWasModified := aValue <> fld.AsVariant;
        FScriptOldFieldName := CEdit.Hint;
      end;
    end;
  finally
    //pokud se nezmenila hodnota udaje zrusime priznak zmen, ktery nastavilo rozeditovani
    SetChangeFlag(stateFormWasChanged or FEditWasModified);
    StopWait;
  end;
end; {DoDefault}

