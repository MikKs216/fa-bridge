//Transformuje data ve formatu FA do XML formatu FA

function DataToXML(const AData: string; AXMLDoc: TXMLDocument): string;
var
  firstLevelNode, node: IXMLNode;
  section: TStringList;
  i: integer;
  s: string;
begin
  StartWait;
  section := TStringList.Create;
  try
    AXMLDoc.XML.Clear;
    AXMLDoc.Active := TRUE;
    AXMLDoc.Version := '1.0';
    AXMLDoc.Encoding := 'windows-1250';
    AXMLDoc.DocumentElement := AXMLDoc.CreateNode(cFormXMLRootLabel);
    //Head
    firstLevelNode := AXMLDoc.DocumentElement.AddChild(cFormXMLHeadLabel);
    section.Text := GetSection(AData, cFormHeadLabel);
    for i := 0 to section.Count - 1 do begin
      if section.Names[i] <> '' then begin
        node := firstLevelNode.AddChild(section.Names[i]);
        node.Text := section.Values[section.Names[i]];
      end;
    end;
    //Values
    firstLevelNode := AXMLDoc.DocumentElement.AddChild(cFormXMLValuesLabel);
    section.Text := GetSection(AData, cFormValuesLabel);
    for i := 0 to section.Count - 1 do begin
      if section.Names[i] <> '' then begin
        node := firstLevelNode.AddChild(section.Names[i]);
        node.Text := section.Values[section.Names[i]];
      end;
    end;
    //UserSettings
    firstLevelNode := AXMLDoc.DocumentElement.AddChild(
      cFormXMLUserSettingsLabel);
    section.Text := GetSection(AData, cFormUserSettingsLabel);
    for i := 0 to section.Count - 1 do begin
      if section.Names[i] <> '' then begin
        node := firstLevelNode.AddChild(section.Names[i]);
        node.Text := section.Values[section.Names[i]];
      end;
    end;
    //Comment
    s := GetSection(AData, cFormCommentLabel);
    if s <> '' then begin
      firstLevelNode := AXMLDoc.DocumentElement.AddChild(cFormXMLCommentLabel);
      firstLevelNode.Text := RtfToXmlStr(s);
    end;
    //Notes
    s := GetSection(AData, cFormNotesLabel);
    if s <> '' then begin
      firstLevelNode := AXMLDoc.DocumentElement.AddChild(cFormXMLNotesLabel);
      firstLevelNode.Text := RtfToXmlStr(s);
    end;
    //Appendix
    s := GetSection(AData, cFormAppendixLabel);
    if s <> '' then begin
      firstLevelNode := AXMLDoc.DocumentElement.AddChild(cFormXMLAppendixLabel);
      firstLevelNode.Text := RtfToXmlStr(s);
    end;
    //
    Result := NormalizeXML(AXMLDoc.XML.Text);
    AXMLDoc.Active := FALSE;
  finally
    section.Free;
    StopWait;
  end;
end; {DataToXML}

//Transformuje XML ve formu FA nebo XML ve formatu DK do formatu dat FA

function XMLToData(const AXMLData: string; AXMLDoc: TXMLDocument;
  AXSLData: string = ''): string;
const
  hlavicka='<?xml version="1.0" encoding="windows-1250"?>';
var
  node, node1: IXMLNode;
  data, pozn, priloha: string;
  i, j: integer;
  transformString: widestring;
  XMLDocWork, XSLDocWork: TXMLDocument;
begin
  StartWait;
  try
    data := '';
    //
    if AXSLData<>'' then begin
      XMLDocWork:=TXMLDocument.Create(nil);
      XSLDocWork:=TXMLDocument.Create(nil);
      try
        XSLDocWork.XML.Text:=AXSLData;
        XSLDocWork.Active:=TRUE;
        XMLDocWork.XML.Text := UnnormalizeXML(AXMLData);
        XMLDocWork.Active := TRUE;
        XMLDocWork.Node.TransformNode(XSLDocWork.Node,transformString);
      finally
        XSLDocWork.Free;
        XMLDocWork.Free;
      end;
      AXMLDoc.XML.Text := hlavicka+#13#10+transformString;
      if GetKeyState(VK_SHIFT) < 0 then //pro ladeni
        EditRichText(AXMLDoc.XML.Text, 'Transformovaný soubor XML');
      AXMLDoc.Active := TRUE;
    end
    else begin
      AXMLDoc.XML.Text := UnnormalizeXML(AXMLData);
      AXMLDoc.Active := TRUE;
    end;
    //
    //XML v nativnim formatu
    if AXMLDoc.DocumentElement.NodeName = cFormXMLRootLabel then begin
      //Head
      node := AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLHeadLabel];
      AddStrLine(data, cFormHeadLabel);
      for i := 0 to node.ChildNodes.Count - 1 do begin
        try
          AddStrLine(data, node.ChildNodes.Nodes[i].NodeName + '=' +
            node.ChildNodes.Nodes[i].NodeValue);
        except
          //kdyz nelze nod nacist, tak jej necteme - dela chybu u starych XML z DK
        end;
      end;
      //Values
      node := AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLValuesLabel];
      AddStrLine(data, '');
      AddStrLine(data, cFormValuesLabel);
      for i := 0 to node.ChildNodes.Count - 1 do begin
        AddStrLine(data, node.ChildNodes.Nodes[i].NodeName + '=' +
          VarToStr(node.ChildNodes.Nodes[i].NodeValue));
      end;
      //UserSettings
      node :=
        AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLUserSettingsLabel];
      AddStrLine(data, '');
      AddStrLine(data, cFormUserSettingsLabel);
      for i := 0 to node.ChildNodes.Count - 1 do begin
        AddStrLine(data, node.ChildNodes.Nodes[i].NodeName + '=' +
          node.ChildNodes.Nodes[i].NodeValue);
      end;
      //Comment
      node :=
        AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLCommentLabel];
      AddStrLine(data, '');
      AddStrLine(data, cFormCommentLabel);
      AddStrLine(data, XmlStrToRtf(node.Text));
      //Notes
      node :=
        AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLNotesLabel];
      AddStrLine(data, '');
      AddStrLine(data, cFormNotesLabel);
      AddStrLine(data, XmlStrToRtf(node.Text));
      //Appendix
      node :=
        AXMLDoc.DocumentElement.ChildNodes.Nodes[cFormXMLAppendixLabel];
      AddStrLine(data, '');
      AddStrLine(data, cFormAppendixLabel);
      AddStrLine(data, XmlStrToRtf(node.Text));
    end
    //XML DK Stereo
    else if AXMLDoc.DocumentElement.NodeName = 'TskpPack' then begin
      pozn := '';
      priloha := '';
      AddStrLine(data, cFormValuesLabel);
      node := AXMLDoc.DocumentElement.ChildNodes.Nodes['Tskp'];
      for i := 0 to node.ChildNodes.Count - 1 do begin
        if node.ChildNodes.Nodes[i].NodeName = 'Field' then begin
          node1 := node.ChildNodes.Nodes[i];
          AddStrLine(data, node1.ChildNodes.Nodes['Id'].NodeValue + '=' +
            VarToStr(node1.ChildNodes.Nodes['Value'].NodeValue));
          if node1.ChildNodes.Nodes['Id'].Text = 'fedPoznamka' then
            pozn := node1.ChildNodes.Nodes['Value'].Text;
        end
        else if node.ChildNodes.Nodes[i].NodeName = 'Priloha' then begin
          node1 := node.ChildNodes.Nodes[i];
          for j := 0 to node1.ChildNodes.Count - 1 do
            AddStrLine(priloha, node1.ChildNodes[j].Text);
        end;
      end;
      //Comment
      AddStrLine(data, '');
      AddStrLine(data, cFormCommentLabel);
      AddStrLine(data, pozn);
      //Appendix
      AddStrLine(data, '');
      AddStrLine(data, cFormAppendixLabel);
      AddStrLine(data, '');
      data := data + priloha;
      AddStrLine(data, '');
      //zapis identifikace typu formulare
      node := AXMLDoc.DocumentElement.ChildNodes.Nodes['Tskp'];
      node1 := node.ChildNodes.Nodes['Typ'];
      AddStrLine(data, cFormXMLOldDefinition);
      AddStrLine(data, cFormXMLOldDefID + '=' + VarToStr(node1.NodeValue));
    end;
    AXMLDoc.Active := FALSE;
    Result := data;
  finally
    StopWait;
  end;
end; {XMLToData}

