procedure TfaMain.AppInit;
begin
  FBridge := TCursorBridge.Create;
  FBridge.ExportFolder := 'DataPrg\Scripts';
  FBridge.CursorCmdOrPath := 'cursor'; // nebo code nebo cesta 'C:\Users\...\Cursor.exe'
  FBridge.OnExternalSave := BridgeExternalSave;
  FBridge.OnCommand := ProcessFACommand;

  TimerPoll := TTimer.Create(Self);
  TimerPoll.Interval := 250; // 250 ms (sníženo z 500ms pro rychlejší odezvu při přepínání)
  TimerPoll.OnTimer  := TimerPollTimer;
  TimerPoll.Enabled := True;
end;

procedure TfaMain.FAToFront;
begin
  if WindowState = wsMinimized then
    WindowState := wsNormal;

  // Simulovat Alt (Windows pak povolí SetForegroundWindow)
  keybd_event(VK_MENU, 0, KEYEVENTF_EXTENDEDKEY or 0, 0);
  SetForegroundWindow(Application.Handle);
  keybd_event(VK_MENU, 0, KEYEVENTF_EXTENDEDKEY or KEYEVENTF_KEYUP, 0);

  Application.BringToFront;
  SetFocus;
end;

procedure TfaMain.AppDone;
begin
  TimerPoll.Enabled := False;
  FreeAndNil(FBridge);
end;

procedure TfaMain.TimerPollTimer(Sender: TObject);
begin
  if Assigned(FBridge) then
  begin
    FBridge.PollTick; // detekuje Ctrl+S v Cursoru a případně zavolá BridgeExternalSave
  end;
end;

procedure TfaMain.BridgeExternalSave(const Text: AnsiString);
var
  isChangingScript, btSaveEnabled: boolean;
begin
  if FCurrentFormId <> '' then
  begin
    FAToFront;
    btSaveEnabled:=dxBarButtonSave.Enabled;
    isChangingScript:=FIsChangingScript;
    FIsChangingScript:=TRUE; //aby se neprovadelo calculate
    try
      // Označ, že změna scriptu bude vyvolaná synchronizací z Cursoru
      // (nastav flag PŘED SaveCodeToDB, aby se správně detekovala změna)
      FScriptChangedByCursor := True;
      
      SaveCodeToDB(Text);

      SaveFormScript;
      
      CheckAndLoadScript;
      
      ReloadListBoxes;
      BringToFront;
    finally
      dxBarButtonSave.Enabled := btSaveEnabled;
      FIsChangingScript:=isChangingScript;
    end;
  end;
end;

