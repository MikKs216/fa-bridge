procedure TfaMain.ExportToFRMXPDF(AWithEmptyValues: boolean = FALSE);
var
  comm: string;
  reportSettings: TReportSettings;
  workFileName, clientName: string;
begin
  //spustit kontroly
  if ShowChecking then
    EXIT;
  //ulozit do souboru
  with SaveDialog1 do begin
    comm := GetListItem(GetPeriod, 3) + ' ' + GetSysComment;
    if comm <> '' then
      comm := ', ' + comm;

    clientName:=Copy(PrepareClientAdress,1,40);

    //FileName := SetValidFileNameTrim(Copy(mtDefName.Value,1,60) + comm + ' - ' + clientName+cFRMXDefaultExt);
    FileName := SetValidFileNameTrim(Copy(mtDefName.Value,1,60) + comm + ' - ' + clientName);
    DefaultExt := cFRMXDefaultExt;
    EIInitSaveDlgExport(SaveDialog1, ClientParam('Description'));

    Filter := cFRMX_FRM_PDF_ExportFilter; //cFRMX_PDF_ExportFilter;
    if Execute then
      if not FileExists(FileName) or
        (MessageAsk(Caption,
        Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then
        if ExtractFileExt(FileName)=cPDFDefaultExt then begin
          reportSettings := LoadReportSettings(GetIniFileName);
          reportSettings := ApplyRestrictReportOptions(reportSettings);
          reportSettings := ApplyAllPages(reportSettings);
          SaveReportSettingsVariantName('');
          reportSettings.VariantName := '';
          workFileName := PreviewForm(NormalPath(ExtractFilePath(GfaMain.FDefFileName)) +
            mtDefID.Value + cReportDefaultExt,TRUE,FALSE,TRUE,
            reportSettings,FileName);
          if FileExists(FileName) then
            DeleteFile(FileName);
          if FileExists(workFileName) then
            CopyFile(PChar(workFileName),PChar(FileName), FALSE);
        end
        else if (ExtractFileExt(FileName)=cDataDefaultExt) or (ExtractFileExt(FileName)=cFRMXDefaultExt) then
          SaveData(FileName);
  end;
end; {ExportToRFMXPDF}

function IsXMLEPO(const AFileName: string; AXMLDoc: TXMLDocument): boolean;
var
  XMLData: string;
  rootNode:IXMLNode;
  s: string;
  i: Integer;
const
  a: array[0..10] of string = ('PISEMNOST','RELDP','PVPOJ','ONZ','NEMPRI',
                              'PODANIVPDPP','PODANIHZUPN','PODANIZZVDPN', //Marek - #6030 - doplneno 6 novych EpoId
                              'PODANIOZUSPOJ','CIZINFORMACE','CIZSDELENI');

  //sem vyjmenovat všechny druhy root tagu pro EPO
begin
  Result:=false;
  try
  if (AFileName<>'') and FileExists(AFileName) then begin
    //XMLData := LoadStringFromFile(AFileName); //MiPi - namet 2581
    //AXMLDoc.XML.Text:=XMLData;
    AXMLDoc.FileName := AFileName; //MiPi - namet 2581
    AXMLDoc.Active:=TRUE;
    s:='';
    if AXMLDoc.DocumentElement<>nil then
      s:=UpperCase(AXMLDoc.DocumentElement.NodeName);
    AXMLDoc.Active:=FALSE;
    //
    for i := 0 to 10 do                                                   //Marek - #6030 - zmena z 4 na 10
      if s=a[i] then begin
        Result:=true;
        Break;
      end;
  end;
  except
  end;
end;

//importuje soubor XML v nativnim formatu, formatu DK nebo nacte soubor frm
procedure TfaMain.ImportFromXML(AFileName: string);
var
  XMLData, XSLData, data, defID, defFileName: string;
  translateList: TStringList;
  i, IDForm: integer;
  xslNode:IXMLNode;
  souborxsl:string;
  obsah:string;

  function GetDefIDForImportFromDK(const AOldDkIdForm: string): string;
  var
    sl: TStringList;
  begin
    sl := TStringList.Create;
{$I Konverze.inc}
    try
      Result := sl.Values[AOldDkIdForm];
    finally
      sl.Free;
    end;
  end;

begin
  with OpenDialog1 do begin
    DefaultExt := cDefDefaultExt;
    Filter := cDefOpenSaveFilter;
    DefaultExt := cFRMXDefaultExt;
    Filter := cFRMXFRMOpenSaveFilter;
    EIInitOpenDlgImport(OpenDialog1, ClientParam('Description'));

    if AFileName='' then begin
      if Execute then
        AFileName:=FileName;
    end;
    if (AFileName<>'') and not FileExists(AFileName) then begin
      MsgBoxWarn(Caption,Format(sMsgFileNotFound,[AFileName]),MB_OK);
      Exit;
    end;

    if AFileName<>'' then begin
      //data v nativnim formatu
      if ExtractFileExt(AFileName) = cDataDefaultExt then begin
        IDForm := FDatabaseIDForm;
        if OpenFileDataString(LoadStringFromFile(AFileName),
          AFileName, mtTskpDefID.Value) then begin
          ApplyMainCaption('');
          SetLayout;
          SetDesignButtons;
          FocusFirstControl;
          FDatabaseIDForm := IDForm;
          mtTskp.Edit;
          mtTskpID.Value := IDForm;
          mtTskp.Post;
          SetChangeFlag(TRUE);
          DoOnOpen;
        end;
      end
      //tady otestovat jestli je uvnitř XML, pokud je to vice formularu FS napsat, že to nejde importovat do formulare, pokud je to EPO tam naimportovat, pokud nic z toho tak nahlasit
      else if IsXMLEPO(AFileName, XMLDoc) then begin
        if dxBarButtonImportFilling.Enabled and (dxBarButtonImportFilling.Visible = ivAlways) then begin
      {$IFDEF STANDALONE}
          if MsgBoxAsk(Caption, sMsgErrXMLImportEPOStandalone, MB_YESNO) = mrYes then
      {$ELSE STANDALONE}
          if MsgBoxAsk(Caption, sMsgErrXMLImportEPO, MB_YESNO) = mrYes then
      {$ENDIF STANDALONE}
            dxBarButtonImportFillingClick(nil);
        end
        else
          MsgBoxInfo(Caption, sMsgErrXMLImportEPONothing, MB_OK);
      end
      //data formulare FS v XML
      else begin
        XMLData := LoadStringFromFile(AFileName);
        XMLDoc.XML.Text:=XMLData;
        XMLDoc.Active:=TRUE;
        xslNode := XMLDoc.Node.ChildNodes.FindNode('xml-stylesheet');
        XMLDoc.Active:=FALSE;
        XMLDoc.XML.Text:='';
        if xslNode<>nil then begin
          obsah:= xslNode.Text;
          i:= Pos('href',obsah);
          if i>0 then begin
            obsah:=Copy(obsah,i+4,Length(obsah));
            i:=Pos('"',obsah);
            obsah:= Copy(obsah,i+1,Length(obsah));
            souborXsl:=Copy(obsah, 1, Pos('"',obsah)-1);
            if FileExists(ExtractFilePath(AFileName)+souborxsl) then begin
              XSLData  := LoadStringFromFile(ExtractFilePath(AFileName)+souborxsl);
              data := XMLToData(XMLData, XMLDoc, XSLData);
            end
            else begin
              data := XMLToData(XMLData, XMLDoc);
            end;
          end;
        end
        else if FileExists(ChangeFileExt(AFileName,'.xsl')) then begin
          XSLData  := LoadStringFromFile(ChangeFileExt(AFileName,'.xsl'));
          data := XMLToData(XMLData, XMLDoc, XSLData);
        end
        else
          data := XMLToData(XMLData, XMLDoc);
        if data <> '' then begin
          //Soubor FA XML
          if GetStringLine(data, 0) = cFormHeadLabel then begin
            InitTskpInfo;
            if OpenFileDataString(data, AFileName, mtTskpDefID.Value) then begin
              {FDataFileName := '';}
              ApplyMainCaption('');
              SetChangeFlag(TRUE);
            end;
          end
          //Soubor DK Stereo XML
          else if GetStringLine(data, 0) = cFormValuesLabel then begin
            defID := GetDefIDForImportFromDK(GetStringLineValue(
              GetSection(data, cFormXMLOldDefinition), cFormXMLOldDefID));
            if defID <> '' then begin
              defFileName := FindDefFile(defID);
              if defFileName <> '' then begin
                ReopenDef(defFileName);
                InitTskpInfo;
                translateList := TStringList.Create;
                try
                  if FNewScripter then
                    translateList.Text :=
                      ScripterT_ExecuteSubRoutine(sScriptProcName_TransformNames)
                  else
                    translateList.Text :=
                      Scripter.CallNoParamsMethod(sScriptProcName_TransformNames);
                  for i := 0 to translateList.Count - 1 do
                    data := Replace(translateList.Names[i], data,
                      translateList.Values[translateList.Names[i]], TRUE);
                finally
                  translateList.Free;
                end;
                SetValuesData(data);
                //
                mtTskp.Edit;
                mtTskpAppendix.Value := GetSection(data, cFormAppendixLabel);
                mtTskp.Post;
                //
                reComment.Clear;
                reComment.Add(Replace(cCRLF, Replace(cCRLF,
                  GetSection(data, cFormCommentLabel), ''), ''), 0);
                reComment.Format;
                SetChangeFlag(TRUE);
                //
              end
              else
                MessageWarn(Caption, 'Nelze najít odpovídající definici formuláře'
                  {sMsgErrXMLImportOldVer}, [MBOK]);
            end
            else
              MessageWarn(Caption, 'Nelze najít odpovídající definici formuláře'
                {sMsgErrXMLImportOldVer}, [MBOK]);
          end;
          ApplyMainCaption('');
          DoOnOpen;
        end
        else
          MessageWarn(Caption, sMsgErrXMLImportFormat, [MBOK]);
      end;
      DisplayCheck; // po importu frm nebo xml
    end;
  end;
end; {ImportFromXML}

