procedure TfaMain.UpdateTreeViewContent;
var
  bm: TBookmarkStr;
  nodePage, nodeSec, nodeLevel3: TCxTreeListNode;
  page, sec, level3, level4: integer;
  fltrd, lc: boolean;
  procedure SetNodeValues(ANode: TCxTreeListNode; const AText: string);
  begin
    ANode.Values[0] := AText;
    ANode.Values[1] := mtContentKey.Value;
    ANode.Values[2] := mtContentPage.Value;
    ANode.Values[3] := mtContentSection.Value;
    ANode.Values[4] := mtContentLevel3.Value;
    ANode.Values[5] := mtContentLevel4.Value;
    ANode.Values[6] := mtContentDefaultControlName.Value;
    ANode.Values[7] := mtContentDefaultCollapsed.Value;
  end;
  function AddNode(const AText: string): TCxTreeListNode;
  begin
    Result := cxTvContent.Add;
    SetNodeValues(Result, AText);
  end;
  function AddChildNode(ANode: TCxTreeListNode; const AText: string):
      TCxTreeListNode;
  begin
    if ANode <> nil then begin
      Result := ANode.AddChild;
      SetNodeValues(Result, AText);
    end
    else
      Result := nil;
  end;
begin
  if mtContent.Active then begin
    StartWait;
    lc := FIsLoadingContent;
    FIsLoadingContent := TRUE;
    mtContent.DisableControls;
    bm := mtContent.Bookmark;
    fltrd := mtContent.Filtered;
    mtContent.Filtered := FALSE;
    cxTvContent.BeginUpdate;
    try
      mtContent.First;
      cxTvContent.Clear;
      page := 0;
      sec := 0;
      level3 := 0;
      level4 := 0;
      nodePage := nil;
      nodeSec := nil;
      nodeLevel3 := nil;
      while not mtContent.EOF do begin
        if (mtContentPage.Value > page) or
          (mtContentPage.Value = page) and
          (mtContentSection.Value = sec) and
          (mtContentLevel3.Value = level3) and
          (mtContentLevel4.Value = level4) and
          (mtContentPageCaption.Value <> '') then begin
          nodePage := AddNode(mtContentPageCaption.Value);
          page := mtContentPage.Value;
          sec := 0;
          level3 := 0;
          level4 := 0;
          if mtContentSection.Value > sec then begin
            nodeSec := AddChildNode(nodePage, mtContentCaption.Value);
            sec := mtContentSection.Value;
            level3 := 0;
            level4 := 0;
          end;
          if mtContentLevel3.Value > level3 then begin
            nodeLevel3 := AddChildNode(nodeSec, mtContentL3Caption.Value);
            level3 := mtContentLevel3.Value;
            level4 := 0;
          end;
          if mtContentLevel4.Value > level4 then begin
            AddChildNode(nodeLevel3, mtContentL4Caption.Value);
            level4 := mtContentLevel4.Value;
          end;
          if nodePage.Values[7] = 'True' then
            nodePage.Collapse(FALSE)
          else
            nodePage.Expand(FALSE);
        end
        else if (mtContentSection.Value > sec) or
          (mtContentPage.Value = page) and
          (mtContentSection.Value = sec) and
          (mtContentLevel3.Value = level3) and
          (mtContentLevel4.Value = level4) and
          (mtContentCaption.Value <> '') then begin
          nodeSec := AddChildNode(nodePage, mtContentCaption.Value);
          sec := mtContentSection.Value;
          level3 := 0;
          level4 := 0;
          if mtContentLevel3.Value > level3 then begin
            nodeLevel3 := AddChildNode(nodeSec, mtContentL3Caption.Value);
            level3 := mtContentLevel3.Value;
            level4 := 0;
          end;
          if mtContentLevel4.Value > level4 then begin
            AddChildNode(nodeLevel3, mtContentL4Caption.Value);
            level4 := mtContentLevel4.Value;
          end;
          if nodeSec.Values[7] = 'True' then
            nodeSec.Collapse(FALSE)
          else
            nodeSec.Expand(FALSE);
          if nodePage.Values[7] = 'True' then
            nodePage.Collapse(FALSE)
          else
            nodePage.Expand(FALSE);
        end
        else if (mtContentLevel3.Value > level3) or
          (mtContentPage.Value = page) and
          (mtContentSection.Value = sec) and
          (mtContentLevel3.Value = level3) and
          (mtContentLevel4.Value = level4) and
          (mtContentL3Caption.Value <> '') then begin
          nodeLevel3 := AddChildNode(nodeSec, mtContentL3Caption.Value);
          level3 := mtContentLevel3.Value;
          level4 := 0;
          if mtContentLevel4.Value > level4 then begin
            AddChildNode(nodeLevel3, mtContentL4Caption.Value);
            level4 := mtContentLevel4.Value;
          end;
          if nodeLevel3.Values[7] = 'True' then
            nodeLevel3.Collapse(FALSE)
          else
            nodeLevel3.Expand(FALSE);
          if nodeSec.Values[7] = 'True' then
            nodeSec.Collapse(FALSE)
          else
            nodeSec.Expand(FALSE);
        end
        else if (mtContentLevel4.Value > level4) or
          (mtContentPage.Value = page) and
          (mtContentSection.Value = sec) and
          (mtContentLevel3.Value = level3) and
          (mtContentLevel4.Value = level4) and
          (mtContentL4Caption.Value <> '') then begin
          AddChildNode(nodeLevel3, mtContentL4Caption.Value);
          level4 := mtContentLevel4.Value;
          if nodeLevel3.Values[7] = 'True' then
            nodeLevel3.Collapse(FALSE)
          else
            nodeLevel3.Expand(FALSE);
        end;
        mtContent.Next;
      end;
      //cxTvContent.FullExpand;
    finally
      mtContent.Filtered := fltrd;
      mtContent.Bookmark := bm;
      mtContent.EnableControls;
      cxTvContent.EndUpdate;
      FIsLoadingContent := lc;
      StopWait;
    end;
  end;
end; {UpdateTreeViewContent}

procedure TfaMain.mtContentCalcFields(DataSet: TDataSet);
begin
  if mtContentPage.Value = cNotesID then
    mtContentPageSecInfo.Value := sNotesShortCaption
  else if mtContentPage.Value = cAppendixID then
    mtContentPageSecInfo.Value := sAppendixShortCaption
  else begin
    mtContentPageSecInfo.Value := IntToStr(mtContentPage.Value);
    if mtContentSection.Value > 0 then
      mtContentPageSecInfo.Value := mtContentPageSecInfo.Value + '.' +
        IntToStr(mtContentSection.Value);
    if mtContentLevel3.Value > 0 then
      mtContentPageSecInfo.Value := mtContentPageSecInfo.Value + '.' +
        IntToStr(mtContentLevel3.Value);
    if mtContentLevel4.Value > 0 then
      mtContentPageSecInfo.Value := mtContentPageSecInfo.Value + '.' +
        IntToStr(mtContentLevel4.Value);
  end;
end; {mtContentCalcFields}

