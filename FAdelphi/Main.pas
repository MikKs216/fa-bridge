    FWorkData:=GetValuesData;
    if FActuallyControl<>nil then
      FWorkFieldName:=FActuallyControl.Name
    else
      FWorkFieldName:='';
  end;

  FIsLoadingContent := TRUE;
  FBookmark := mtContent.Bookmark;
  SetDesignContent(dxBarButtonDesignMode.Down);
  SetFocusContent;
  SetLayout;
  //povolit tlacitka navrhu
  SetDesignButtons;
  FIsDesignMode := dxBarButtonDesignMode.Down;
  //osetrit stisknuti kdyz neni jeste otevrena definice
  if mtFields.Active then
    GenMtValues;
  //vytvorit edit
  FIsLoadingContent := FALSE;

  if not dxBarButtonDesignMode.Down then begin //ukonceni modu navrhu
    paZoom.Enabled := True;
    if mtContent.Active then
      mtContent.First;
    CEdit.PopupMenu := pmForm;
    SetCbOnClick;
    if (FWorkData<>'') then
      SetValuesData(FWorkData);
    if FStateFormWasChanged and
      (MessageAsk(Caption, 'Uložit změny definice?', [MBYES, MBNO]) = IDYES) then begin
        data := GetFormData;
        SaveDef;
        SetFormData(data);
      end;
    SetChangeFlag(FALSE);
  end
  else begin // vstup do modu navrhu
    CEdit.PopupMenu := pmDesign;
  end;
  //skok na stejnou stranu

  if mtContent.Active then
    mtContent.Bookmark := FBookmark;
  LocateTreeItem;
  if not TryFocusControlByName(FWorkFieldName) then
    FocusFirstControl;
end; {dxBarButtonDesignModeClick}

