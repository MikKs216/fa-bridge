{$IFNDEF FINALBUILD}
{
Aktualizuje vsechny sdilene skripty
- ASilent - pokud je true, tak
  - zpracovani se provede v tichosti (bez dotaz)
  - na konci se zvedne verze formulare
    (ale jen pokud je AScr = '')
- AScr
  - pokud je AScr ruzny od '', tak se prevadi skript AScr, jinak se natahle z mtDefScript
  - pokud je AScr prazdny a prevadi se mtDefScript, tak se na konci zvedne verze formulare
    (ale jen pokud je ASilent = TRUE!!!!)
}
function TfaMain.LoadIncludeScripts(ASilent: boolean; var AScr: string): boolean;
const
  cINCStart = '{$INCSTART_';
  cINCStop = '{$INCSTOP_';

var
  sl, slS, slI, slF: TStringList;
  i: integer;
  inINC, updateINC,ask: boolean;
  incFileName: string;

begin
  Result := False;
  if not DirectoryExists(GetIncludePath) then
    Exit;
  //
  sl:=TStringList.Create;
  slS:=TStringList.Create;
  slI:=TStringList.Create;
  slF:=TStringList.Create;
  try
    if AScr <> '' then
      sl.Text:=AScr
    else
      sl.Text:=mtDefScript.Value;
    inINC:=FALSE;
    updateINC:=FALSE;
    ask:=TRUE;
    for i:=0 to sl.Count-1 do begin
      if Copy(Trim(sl[i]),1,Length(cINCStart))=cINCStart then begin
        slI.Clear;
        inINC:=TRUE;
        incFileName:=Copy(Trim(sl[i]),Length(cINCStart)+1, MaxInt);
        incFileName:=Replace('}', incFileName,'')+'.pas';
      end;
      if inINC then
        slI.Add(sl[i])
      else
        slS.Add(sl[i]);
      if Trim(sl[i])=cINCStop+ChangeFileExt(incFileName,'')+'}' then begin
        inINC:=FALSE;
        if FileExists(GetIncludePath+incFileName) then begin
          slF.LoadFromFile(GetIncludePath+incFileName);
          slF.Insert(0,cINCStart+ChangeFileExt(incFileName,'')+'}');
          slF.Add(cINCStop+ChangeFileExt(incFileName,'')+'}');
          if (slF.Text<>slI.Text) then begin
            if ASilent then
              updateINC:=TRUE
            else begin
              ask := (ask) and (MsgBoxAsk(Caption, 'Sdílená část skriptu není aktuální, '+
                'chcete ji zaktualizovat nyní?', MB_YESNO)=mrYes);
              updateINC:=ask or updateINC;
            end;
            //
            if updateINC then
              slS.Text:=slS.Text+slF.Text
            else
              slS.Text:=slS.Text+slI.Text;
            ask:=False;
          end
          else
            slS.Text:=slS.Text+slI.Text;
        end
        else
          slS.Text:=slS.Text+slI.Text;
      end;
    end;
    //
    Result := updateINC;
    //
    if updateINC then begin
      if AScr <> '' then
        AScr := slS.Text
      else begin
        mtDef.Edit;
        mtDefScript.Value:=slS.Text;
        if ASilent then
          mtDefFormVersion.AsString := IncDefVersion(mtDefFormVersion.AsString, False);
        mtDef.Post;
      end;
    end;
  finally
    sl.Free;
    slS.Free;
    slI.Free;
    slF.Free;
  end;
end;

procedure TfaMain.SaveIncludeScripts;
const
  cINCStart = '{$INCSTART_';
  cINCStop = '{$INCSTOP_';
var
  sl, slI: TStringList;
  i: integer;
  inINC: boolean;
  incFileName: string;
begin
  if not DirectoryExists(GetIncludePath) then
    ForceDirectories(GetIncludePath);
  //
  sl:=TStringList.Create;
  slI:=TStringList.Create;
  try
    sl.Text:=mtDefScript.Value;
    inINC:=FALSE;
    for i:=0 to sl.Count-1 do begin
      if Copy(Trim(sl[i]),1,Length(cINCStart))=cINCStart then begin
        inINC:=TRUE;
        incFileName:=Copy(Trim(sl[i]),Length(cINCStart)+1, MaxInt);
        incFileName:=Replace('}', incFileName,'')+'.pas';
      end;
      if inINC then
        if (Copy(Trim(sl[i]),1,Length(cINCStart))<>cINCStart) and
           (Trim(sl[i])<>cINCStop+ChangeFileExt(incFileName,'')+'}') then
          slI.Add(sl[i]);
      if Trim(sl[i])=cINCStop+ChangeFileExt(incFileName,'')+'}' then begin
        inINC:=FALSE;
        slI.SaveToFile(GetIncludePath+incFileName);
        slI.Clear;
      end;
    end;
  finally
    sl.Free;
    slI.Free;
  end;
end;
