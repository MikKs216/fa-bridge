procedure TfaMain.LoadScript;
var
  st: TMemoryStream;

  procedure CompileScript;
  var
    st1: TMemoryStream;
    ver: string;
    p: integer;

    procedure SetNeedVerIfError;
    begin
      ver := Copy(GetPrgVersion, 1, StrNPos(GetPrgVersion,'.', 3)-1);
      p := StrNPos(ver,'.', 2);
      ver := Copy(ver, 1, p) + IntToStr(StrToIntSafe(Copy(ver,p+1,maxint))+1);
      //
      mtDef.Edit;
      mtDefScript.Value := Format('{#NEEDVER-%s}', [ver]);
      mtDef.Post;
      //
      ScripterT.SourceCode.Text := mtDefScript.Value;
      ScripterT.SaveCodeToStream(st1);
    end;

  begin
    ShowHintSb(sSbCompilation);
    {Sleep(2000);}
    st1 := TMemoryStream.Create;
    try
      FScript := TranslateFieldNames(mtDefScript.Value);
      FScript := TranslateIniProcs(FScript);
      if FNewScripter then begin
        ScripterT.SourceCode.Text := AcceptScriptDirectives(FScript);
        try
          //pokud je ve skriptu chyba, vyvola vyjimku
          ScripterT.SaveCodeToStream(st1);
        except
          //15.12.2023 (Marek) - pokud dojde k chybe (napr kdyz je ve skriptu pouzita funkce, kterou FA nezna),
          // tak se cely skript vyprazdni a misto nej se vlozi direktiva "NEEDVER" (verze je zvednuta o 1 vic nez je verze FA).
          // Ta zajisti, ze se nasledne v OpenFileDef zobrazi hlaseni o potrebe aktualizace programu a formular se uzavre.
          on e: EatCompileError do begin
            {$IFDEF FINALBUILD}
            SetNeedVerIfError;         //ostra verze
            {$ELSE FINALBUILD}
            if ParamStr(2) <> '' then  //v designeru, pokud se provadi nejaka hromadne akce,
              SetNeedVerIfError        //tak skript vyprazdnime, aby nedoslo k chybe a probihajici akce se nezastavila
            else
              ShowMessage(E.Message);  //jinak zobrazime dialog s chybovym hlasenim
            {$ENDIF FINALBUILD}
          end;
        end;
        st1.Seek(0, soFromBeginning);
        ScripterT.LoadCodeFromStream(st1);
      end
      else begin
        Scripter.Script.Add(AcceptScriptDirectives(FScript));
        Scripter.SaveCompiledScriptToStream(st1);
        st1.Seek(0, soFromBeginning);
        Scripter.LoadCompiledScriptFromStream(st1);
      end;
    finally
      st1.Free;
      ShowHintSb('');
    end;
  end;

begin
  Scripter.Script.Clear;
  ScripterT.SourceCode.Clear;
  begin
    //pro rychlejsi provadeni scriptu jej prelozime
    if (mtDef.Active) and (mtDef.State = dsBrowse) then begin
      st := TMemoryStream.Create;
      try
        if mtDefCompiledScript.Value <> '' then begin
          //nacitani ulozeneho scriptu - ve verzi 3
          mtDefCompiledScript.SaveToStream(st); //opt
          st.Seek(0, soFromBeginning);
          try
            if FNewScripter then begin
              ScripterT.LoadCodeFromStream(st);
              ScripterT.Execute();  //15.12.2023 (Marek) - nema vyznam, vola se jen kvuli zjisteni, zda je skript v poradku. pokud neni, vola se v except kompilace (vice viz. popis v CompileScript)
            end
            else
              Scripter.LoadCompiledScriptFromStream(st);
          except
            //kdyz nastane chyba pri nacitani scriptu, tak jej zkusime prelozit
            //nastava to treba kdyz je script prelozen pri jinem lokalnim nastaveni Windows nez se pak spousti 
            CompileScript;
            if not FDefReadOnly then
              {$IFNDEF STANDALONE}
              if not dmGlobObj.gFRemoteServer then //pri sdileni dat neukladame do databaze
              {$ENDIF STANDALONE}
            begin
              mtDef.Edit;
              mtDefCompiledScript.Value := '';
              mtDef.Post;
            end;
          end;
        end
        else begin
          CompileScript;
        end;
      finally
        st.Free;
      end;
    end;
  end;
end; {LoadScript}

//Result:
//1  - definice je jiz prevedena
//0  - definice se podarilo prevest
//-1 - definici se nepodarilo prevest
//hlaseni (chybove i uspesne) je vraceno v AMsg
{$IFNDEF FINALBUILD}
function TfaMain.ConvertDesignToTMS(var AMsg: string): integer;
var
  des: TDCLiteDesigner;
  desTms: TIDEFormDesigner;
  st, stTms: TMemoryStream;
  i, y: integer;
  c: TControl;
  sb: TScrollBox;
  defID: string;
const
  cMsgStr = '%s: %s';
  cRes0 = 'Definice byla úspěšně převedena.';
  cRes1 = 'Definice je již převedena do TMS formátu.';
  cRes_1 = 'Chyba při převodu definice: %s.';
begin
  defID := ChangeFileExt(ExtractFileName(FDefFileName),'');
  Result := 0;
  AMsg := Format(cMsgStr,[defID, cRes0]);
  //
  des := TDCLiteDesigner.Create(self);
  desTms := TIDEFormDesigner.Create(self);
  sb := TScrollBox.Create(self);
  with mtContent do begin
    DisableControls;
    AfterScroll := nil;
  end;
  GfaMain.OnActivate := nil;
  try
    FNewScripter := (mtDefLinkedForm.AsString = 'tmsscript') or (mtDefLinkedForm.AsString = 'ok');
    if FNewScripter then begin
      Result := 1;
      AMsg := Format(cMsgStr,[defID, cRes1]);
      Exit;
    end;
    //
    mtDef.Edit;
    mtDefLinkedForm.Value := 'tmsscript';
    mtDef.Post;
    FNewScripter := (mtDefLinkedForm.AsString = 'tmsscript') or (mtDefLinkedForm.AsString = 'ok');
    //
    try
      with mtContent do begin
        First;
        while not EOF do begin
          sbForm.Visible := FALSE;
          //nejprve odstranime vsechny controlsy z sbForm
          EmptyPage;
          //a pak nacteme novou stranku a jednotlive controlsy pridame do ScripterT
          if mtContentSectionForm.Value <> '' then begin
            st := TMemoryStream.Create;
            stTms := TMemoryStream.Create;
            try
              mtContentSectionForm.SaveToStream(st);
              st.Seek(0, soFromBeginning);
              des.LoadComponentFromStream(sbForm, st);
              //SendToBack u shape zajisti, aby vsechny byly na pozadi
              for i := sbForm.ControlCount -1 downto 0 do begin
                c := sbForm.Controls[i];
                if c is TShape then
                  c.SendToBack;
              end;
              //
              desTms.SaveComponentToStream(stTms, sbForm, dfmBinary);
              //vstup do kresleni
              DoOpenTMSDesigner(stTms, true);
              DesActiveChanged(True);
              //opusteni kresleni, vola se SavePage (tzn. data se ulozi do mtContentSectionForm)
              CloseTMSDesigner;
            finally
              st.Free;
              stTms.Free;
            end;
          end;
          Next;
        end;
      end;
    except
      on E: Exception do begin
        Result := -1;
        AMsg := Format(cMsgStr,[defID, Format(cRes_1, [E.Message])]);
      end;
    end;
  finally
    with mtContent do begin
      AfterScroll := mtContentAfterScroll;
      EnableControls;
    end;
    GfaMain.OnActivate := FormActivate;
    sb.Free;
    des.Free;
    desTms.Free;
    desTms := nil;
  end;
end;
{$ENDIF FINALBUILD}

