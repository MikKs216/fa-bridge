function TfaMain.OpenFileDef(const AFileDef: string): boolean;
var
  st: TMemoryStream;
  sk, repLngLists, needVer: string;
  i: integer;
  forceClose: boolean;

  function IsInstParamNoCompile: boolean;
  var
    ini: TMemIniFile;
  begin
    Result:=FALSE;
    //Testujeme parametr, ze se nemaji ukladat prelozene FDE, nastaveni v "instparam.ini"
    if FileExists(ExtractFilePath(Application.ExeName)+'\'+cInstParamFileName) then begin
       ini:= TMemIniFile.Create(ExtractFilePath(Application.ExeName)+'\'+
           cInstParamFileName);
       try
         Result:=ini.ReadInteger(cInstParamSectionEditor,
           cInstParamNoSaveCompiledEditor, 0)=1;
       finally
         ini.Free;
       end;
    end
  end;

  function GetReportLanguageLists(const ARepVarText: string): string;
  var
    ii: integer;
    sl: TStringList;
    st: string;
  begin
    Result := '';
    if ARepVarText = '' then
      Exit;
    //
    sl := TStringList.Create;
    sl.Text := ARepVarText;
    st := '';
    try
      for ii := 0 to sl.Count - 1 do
        st := AddValueToList(st, Copy(sl[ii],1,Pos('=', sl[ii])-1));
      //
      if IsItemInList(st, cRepVarEN) then
        Result := AddValueToList(Result, cRepVarEN);
      if IsItemInList(st, cRepVarDE) then
        Result := AddValueToList(Result, cRepVarDE);
      if IsItemInList(st, cRepVarFR) then
        Result := AddValueToList(Result, cRepVarFR);
      if IsItemInList(st, cRepVarIT) then
        Result := AddValueToList(Result, cRepVarIT);
    finally
      sl.Free;
    end;
  end;

  procedure HideStatusBarPanels(const AFrom, ATo: integer);
  var
    ii: integer;
    sl: TStringList;
  begin
    for ii := AFrom to ATo do begin
      mxStatusBar1.Panels[ii].ImageIndex := -1;
      mxStatusBar1.Panels[ii].Hint := '';
      mxStatusBar1.Panels[ii].OnClick := nil;
    end;
  end;

  procedure SetStatusBarPanels4DefaultRepVar;
  begin
    mxStatusBar1.Panels[4].ImageIndex := 117;
    mxStatusBar1.Panels[4].Hint := sSbHasReportVariants;
    mxStatusBar1.Panels[4].OnClick := nil;
    HideStatusBarPanels(5,7);
  end;

begin
