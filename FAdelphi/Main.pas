procedure TfaMain.AddComponent2WorkScripter(const ALoadLastPage: boolean);
var
  ms: TMemoryStream;
  i, k: Integer;
  c: TControl;
begin
  k := mtContentKey.Value;
  with mtContent do begin
    DisableControls;
    AfterScroll := nil;
  end;
  try
    with mtContent do begin
      First;
      while not EOF do begin
        sbForm.Visible := FALSE;
        //nejprve odstranime vsechny controlsy ze scrollboxu
        EmptyPage;
        //a pak nacteme novou stranku a jednotlive controlsy pridame do ScripterT
        if mtContentSectionForm.Value <> '' then begin
          ms := TMemoryStream.Create;
          try
            mtContentSectionForm.SaveToStream(ms);
            ms.Seek(0, soFromBeginning);
            //
            GfaMain.Designer.LoadComponentFromStream(sbForm, ms);
            for i := 0 to sbForm.ControlCount - 1 do begin
              c := sbForm.Controls[i];
              ScripterTMS_AddComponent(ScripterT, c);
              ScripterTMS_AddComponent(workScripterT, c);
            end;
          finally
            ms.Free;
          end;
        end;
        Next;
      end;
    end;
  finally
    if ALoadLastPage then
      if mtContent.Locate(mtContentKey.FieldName, k, []) then
        LoadPage;
    with mtContent do begin
      AfterScroll := mtContentAfterScroll;
      EnableControls;
    end;
  end;
end;

function IncDefVersion(AVer: string; AIncMajVerToLast: boolean): string;
var
  n,p: Integer;
  exeVer, defVer: string;
  incVer: boolean;
begin
  Result := StrTrimCharRight(AVer,'.');
  incVer := True;
  if AIncMajVerToLast then begin
    exeVer := GetPrgVersion;
    defVer := Copy(exeVer, 1, Pos('.', exeVer) -1) + '.1.1.1';
    if CompareVersion(AVer, defVer) = -1 then begin
      incVer := False;
      Result := defVer;
    end;
  end;
  //
  if incVer then begin
    n:=StrStrCount(Result,'.');
    p:=StrNPos(Result,'.',n);
    Result := Copy(Result,1,p) + IntToStr(StrToIntSafe(Copy(Result,p+1,maxint))+1);
  end;
end;

function TfaMain.TryCompileScript(const AScript: string; var AErrExpression: string; ACompile: Boolean = TRUE; ANewScripter: Boolean = TRUE): boolean;
var
  s: string;
begin
  Result := False;
  AErrExpression := '';
  try
    s := TranslateFieldNames(AScript);
    s := TranslateIniProcs(s);
    //
    if ANewScripter then begin
      workScripterT.SourceCode.Clear;
      workScripterT.SourceCode.Text := s;
      if ACompile then
        workScripterT.Compile
      else
        workScripterT.Execute();
      //
      Result := True;
    end
    else begin
      workScripter.Script.Clear;
      workScripter.Script.Add(s);
      //
      Result := workScripter.CheckSyntax;
    end;
  except
      on E: Exception do begin
        AErrExpression := E.Message;
      end;
  end;
end;

function TfaMain.IsFDRValid(ADefFileName: string; var AErrExpression: string): boolean;
var
  fdrDefFN: string;
  slRepVar: TStringList;
  i: integer;
  errExp: string;

  function CheckFDR(AFDRFileName: string): Boolean;
  var
    guid, dir, pdsFN, vyraz: string;
    slPdfList, slPds: TStringList;
    j,k: Integer;

    function GetPdsLeftSide(AStr: string): string;
    var
      c,l,p: integer;
    begin
      c:= StrStrCount(AStr,'=');
      //zjistime text pred '=' (jmeno Fieldu, funkce apod)
      if c = 0 then
        Result := AStr
      else begin
        if c = 1 then begin
          Result := Copy(AStr,1,Pos('=',AStr)-1);
        end
        else begin
          //hledame od konce, protoze nekde ve funkci muze byt pouzito =
          //pozn.: problem by byl, kdyby bylo = pouzito ve Formatu, coz je pri pouziti funkce malo pravdepodobne
          for l := c downto 1 do begin
            p := StrNIPos(AStr,'=',l);
            if IsDigit(Copy(AStr,p+1,1)) then begin    //zapis je ve tvaru ABC=1,100,100
              Result := Copy(AStr,1,p-1);
              Break;
            end;
          end;
        end;
      end;
    end;

  begin
    Result := True;
    AErrExpression := '';
    errExp := '';
    guid := CreateGUIDString;
    dir := NormalPath(DirWorkPath+guid);
    if not DirectoryExists(dir) then
      ForceDirectories(dir);
    try
      if UnzipFile(AFDRFileName, dir) then begin
        slPds := TStringList.Create;
        slPdfList := TStringList.Create;
        try
          slPdfList.Text := SearchFiles(dir, '*.pdf', FALSE);
          for j := 0 to slPdfList.Count - 1 do begin
            if Result = False then
              Break;
            //
            pdsFN := ChangeFileExt(slPdfList[j], '.pds');
            if FileExists(pdsFN) then begin
              slPds.LoadFromFile(pdsFN);
              if Pos('#', slPds.Text) > 0 then begin
                for k := 0 to slPds.Count - 1 do begin
                  if Copy(slPds[k], 1, 1) = '#' then begin
                    vyraz := GetPdsLeftSide(Copy(slPds[k], 2, MaxInt));
                    if vyraz <> '' then begin
                      if not TryCompileScript('result :='+vyraz, errExp, False) then begin
                        Result := False;
                        AddStrLine(AErrExpression, 'FDR: '+ExtractFileName(AFDRFileName));
                        AddStrLine(AErrExpression, 'PDS: '+ExtractFileName(pdsFN)+cCRLF);
                        AddStrLine(AErrExpression, 'Expression:'+cCRLF+'#'+vyraz+cCRLF);
                        AddStrLine(AErrExpression, errExp);
                        Break;
                      end;
                    end;
                  end;
                end;
              end;
            end;
          end;
        finally
          slPds.Free;
          slPdfList.Free;
        end;
      end;
    finally
      DeleteDirectory(dir, False);
    end;
  end;

begin
  Result := True;
  fdrDefFN := ChangeFileExt(ADefFileName,cReportDefaultExt);
  if FileExists(fdrDefFN) then begin
    //defaultni sestava
    Result := CheckFDR(fdrDefFN);
    if Result then begin
      slRepVar := TStringList.Create;
      try
        //jazykove varianty
        slRepVar.Text := SearchFiles(NormalPath(ExtractFilePath(fdrDefFN)),
          ChangeFileExt(ExtractFileName(fdrDefFN),'#*' + cReportDefaultExt), FALSE);
        for i := 0 to slRepVar.Count - 1 do begin
          Result := CheckFDR(slRepVar[i]);
          if not Result then
            Break;
        end;
      finally
        slRepVar.Free;
      end;
    end;
  end;
end;

procedure TfaMain.ConvertDefToTMS(const AFileDef, ALogFileName, AScrErrFileName: string; const AConvertOnlyScript: boolean);
var
  defID, bckFileName, scrFileName, errMsg, scr, scrzal: string;
  n: Integer;
  st: TMemoryStream;
  scrOk, convertedNow: Boolean;
  errExp: string;

  //AUpVersion:
  //0 - nezveda verzi
  //1 - zvedne verzi, ale jen pokud je formular aktualni (PlatnostDo neni vyplnena)
  //2 - zvedne verzi vzdy
  procedure SaveScriptAndDef(AScript: string; AUpVersion: integer);
  var
    upVer: boolean;
  begin
    upVer := False;
    if AUpVersion = 1 then
      upVer := (fmDefs.mtDefsPlatnostDo.Value = null) or (fmDefs.mtDefsPlatnostDo.Value = 0)
    else if AUpVersion = 2 then
      upVer := True;
    //  
    mtDef.Edit;
    mtDefScript.AsString := AScript;   //zapiseme prevedeny skript
    if upVer then begin
      mtDefFormVersion.AsString := IncDefVersion(mtDefFormVersion.AsString, True);
      mtDefDate.Value := Date;
    end;
    mtDef.Post;
    SaveDef;                           //ulozime do FDE
  end;

  //koncerze designu z DC do TMS
  //- predpokladem je (a netestuje se):
  //  - design jeste neni preveden (tzn. je v DC formatu)
  //  - skript je jiz preveden do TMS formatu (jinak pri ulozeni FDE dojde k chybe)
  function ConvertDesignToTMSAndSave: boolean;
  begin
    Result := False;
    //vstup do Navrhoveho modu
    dxBarButtonDesignMode.Down := True;
    dxBarButtonDesignModeClick(nil);
    FWorkData:=''; //mazeme, protoze se v dxBarButtonDesignModeClick pri dxBarButtonDesignMode.Down naplni a pak nize, kdyz je dxBarButtonDesignMode.Down=False, tak se pta na uloizeni
    //konverze designu
    n := ConvertDesignToTMS(errMsg);
    //pokud prevod v poradku, tak pokracujeme s ulozenim do FDE
    if n = 0 then begin
      //ulozime FDE
      try
        SaveDef;
        Result := True;
      except
      end;
    end
    else
      FStateFormWasChanged := False;
    //opusteni Navrhoveho modu
    dxBarButtonDesignMode.Down := False;
    dxBarButtonDesignModeClick(nil);
  end;

begin
  StartWait;
  try
    //nadefinujeme si jmeno souboru pro ulozeni skriptu
    scrFileName :=  NormalPath(DirWorkPath) + cTmsScript;
    if FileExists(scrFileName) then
      DeleteFile(scrFileName);
    //vytvorime zalohu definice
    bckFileName := NormalPath(ExtractFilePath(AFileDef)) + ChangeFileExt(ExtractFileName(AFileDef), '.ORG');
    if FileExists(bckFileName) then
      DeleteFile(bckFileName);
    CopyFile(PChar(AFileDef),PChar(bckFileName), FALSE);
    //
    if OpenFileDef(AFileDef) then begin
      convertedNow := False;
      defID := ChangeFileExt(ExtractFileName(FDefFileName),'');
      //musime otevrit, jinak je problem s nastavenim bookmarku v dxBarButtonDesignModeClick
      CreateMtTskp(mtDefID.Value, 0, '', '', mtDefGroup.Value, mtDefSubGroup.Value);
      //Pouze konverze skriptu
      //if AConvertOnlyScript then begin
        FNewScripter := (mtDefLinkedForm.AsString = 'tmsscript') or (mtDefLinkedForm.AsString = 'ok');
        if FNewScripter then                        //definice (design + skript) je jiz prevedena do TMS formatu
          SaveToLog(ALogFileName, Format('%s|%s',[cTTMS, defID]), -1)                         //TTMS
        else begin
          FNewScripter := False;                   //nastavime na true, aby ...
          AddComponent2WorkScripter(False);        //pridame komponenty do TMS skripteru, aby pri kompilaci nevznikaly chyby
          //
          scr := mtDefReportScript.AsString;       //vlozime skript sestavy do promenne
          scr := fmScriptEditor.ConvertScript2TMS(scr); //provedeme upravy skriptu sestavy
          if not IsFDRValid(AFileDef, errExp) then begin  //otestujeme PDS v FDR (i jazykovych variantach), pokud je nekde chyba, tak dal nepokracujeme
            SaveToLog(ALogFileName, Format('%s|%s',[cPERR, defID]), -1);                //PERR
          end
          else if not TryCompileScript(scr, errExp) then begin  //a zkusime skript sestavy zkompilovat, pokud je False, tak dal nepokracujeme
            SaveToLog(ALogFileName, Format('%s|%s',[cRERR, defID]), -1);                //RERR
          end
          else begin                               //pokud je skript sestavy TRUE,
            mtDef.Edit;                            //tak ulozime
            mtDefReportScript.AsString := scr;
            mtDef.Post;
            //
            scr := mtDefScript.AsString;           //vlozime skript do promenne
            if TryCompileScript(scr, errExp) then begin    //a zkusime zkompilovat, pokud TRUE, tak je skript bud uz preveden, nebo je proste kompatibilni
              if AConvertOnlyScript then
                SaveToLog(ALogFileName, Format('%s|%s',[cSSCR, defID]), -1)                     //SSCR
              else begin
                if ConvertDesignToTMSAndSave then begin  //definici se povedlo prevest
                  SaveScriptAndDef(scr, 1);        //ulozime FDE (pro ulozeni nepouzivame SaveDef, kvuli zvednuti verze formulare)
                  //
                  convertedNow := True;
                  SaveToLog(ALogFileName, Format('%s|%s',[cTSCR, defID]), -1);                  //TSCR
                end
                else
                  SaveToLog(ALogFileName, Format('%s|%s',[cTERR, defID]), -1)                   //TERR
              end;
            end
            else begin                             //kompilace je FALSE, pokracujeme...
              scrzal := scr;
              scr := fmScriptEditor.ConvertScript2TMS(scr); //provedeme upravy skriptu tak, aby byl "vice" kompatibilni s TMS
              if TryCompileScript(scr, errExp) then begin  //zkusime znovu zkompilovat, pokud TRUE, tak po upravach vyse je skript 100% kompatibilni s TMS,
                SaveScriptAndDef(scr, 0);          //tak zapiseme prevedeny skript a ulozime FDE
                //
                convertedNow := True;
                if AConvertOnlyScript then
                  SaveToLog(ALogFileName, Format('%s|%s',[cS100, defID]), -1)                   //S100
                else begin
                  if ConvertDesignToTMSAndSave then begin//definici se povedlo prevest
                    SaveScriptAndDef(scr, 1);        //ulozime FDE (pro ulozeni nepouzivame SaveDef, kvuli zvednuti verze formulare)
                    SaveToLog(ALogFileName, Format('%s|%s',[cT100, defID]), -1);                //T100
                  end
                  else
                    SaveToLog(ALogFileName, Format('%s|%s',[cT10E, defID]), -1);                //T10E
                end;
              end
              else begin                             //pokud skript neni 100% kompatibilni,
                if AConvertOnlyScript then begin     //tak v pripade, ze prevadime pouze skript,
                  if scr <> scrzal then begin        //tak zkusime ulozit, ale jen v pripade, ze ve skriptu doslo ke zmene (skripty pred a po upravach jsou rozdilne).
                    if TryCompileScript(scr, errExp, True, False) then begin //zkusime puvodni DC skript zkompilovat, protoze v ojedinelych pripadech dojde pri prevodu k chybe (napr kdyz za procedure neni begin, ale hned end)
                      SaveScriptAndDef(scr, 0);      //pokud se kompilace povedla, tak zapiseme prevedeny skript a ulozime FDE
                      //
                      convertedNow := True;
                      SaveToLog(ALogFileName, Format('%s|%s',[cS099, defID]), -1);                //S099
                    end
                    else
                      SaveToLog(ALogFileName, Format('%s|%s',[cSERR, defID]), -1);                //SERR
                  end
                  else
                    SaveToLog(ALogFileName, Format('%s|%s',[cSNOT, defID]), -1);                  //SNOT
                  SaveToLog(AScrErrFileName, defID, -1);
                end
                else
                  SaveToLog(ALogFileName, Format('%s|%s',[cSERR, defID]), -1);                    //SERR
              end;
            end;
          end;
        end;
        //pokud nedoslo ke konverzi (at uz z duvodu chyb, nebo ze je skript jiz kompatibilni), tak "_Org" soubor smazeme
        if not convertedNow then
          DeleteFile(bckFileName);
      {end
      //Konverze definic a skriptu
      else begin
        //vstup do Navrhoveho modu
        dxBarButtonDesignMode.Down := True;
        dxBarButtonDesignModeClick(nil);
        //konverze designu
        n := ConvertDesignToTMS(errMsg);
        if n = -1 then //chyba
          SaveToLog(ALogFileName, errMsg, 0)
        else           //prevod v poradku, nebo je jiz prevedeno
          SaveToLog(ALogFileName, errMsg, -1);
        //pokud prevod v poradku, tak pokracujeme s prevodem skriptu
        if n = 0 then begin
          st := TMemoryStream.Create;
          try
            //vyjmuti skriptu, aby pri ulozeni prevedene definice nedoslo k chybe
            //(protoze predpokladam, ze skript bude na 99% nekompatibilni)
            mtDefScript.SaveToStream(st);
            mtDef.Edit;
            mtDefScript.Clear;
            mtDef.Post;
            //ulozime (tim ziskame FDE v TMS formatu, ale bez skriptu)
            SaveDef;
            //opusteni Navrhoveho modu
            dxBarButtonDesignMode.Down := False;
            dxBarButtonDesignModeClick(nil);
            //vlozime skript zpet
            st.Seek(0, soFromBeginning);
            mtDef.Edit;
            mtDefScript.LoadFromStream(st);
            mtDef.Post;
            //a zkusime znovu ulozit (jestli skript prece jen neni plne kompatibilni)
            try
              scrOk := True;
              SaveDef;
              SaveToLog(ALogFileName, Format('%s: Skript byl úspěšně převeden.',[defID]), -1);
            except
              scrOk := False;
              SaveToLog(ALogFileName, Format('%s: Skript obsahuje chyby a vyžaduje ruční úpravy.',[defID]), -1);
            end;
            //pokud pri ulozeni doslo k chybe, tzn. skript neni kompatibilni, tak ...
            if not scrOk then begin
              SaveToLog(AScrErrFileName, defID, 0);
              //skript ulozime do scrFileName,
              mtDefScript.SaveToFile(scrFileName);
              //znovy skript vyjmeme
              mtDef.Edit;
              mtDefScript.Clear;
              mtDef.Post;
              //a definici znovu ulozime (tim ziskame FDE v TMS formatu, bez skriptu, ktery je ale ulozen v souboru uvnitr FDE)
              SaveDef;
            end;
          finally
            st.Free;
          end;
        end
        else begin
          FStateFormWasChanged := False;
          //opusteni Navrhoveho modu
          dxBarButtonDesignMode.Down := False;
          dxBarButtonDesignModeClick(nil);
        end;
      end;}
      //smazeme prave vytvoreny bak soubor
      DeleteFile(ChangeFileExt(AFileDef, '.bak'));
      //
      FIsLoadingContent := True;
      FStateFormWasChanged := False;
      CloseDef;
    end;
  finally
    StopWait;
  end;
end;
{$ENDIF FINALBUILD}

