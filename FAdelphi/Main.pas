{-----------------------------------------------------------------------------
ExportFR3ToPDF
  Exportuje sestavu FastReportu do PDF
  Vraci nazev PDF souboru bez cesty (predpoklada se, ze lezi ve Worku)
-----------------------------------------------------------------------------}
function TfaMain.ExportFR3ToPDF(const ASrcFr3FileName: string): string;
var
  fn, fnPdf, s: string;
  i, p: integer;
  variable: TfrxVariable;
  frRep1: TfrxReport;
  frxPDFExport1: TfrxPDFExport;
begin
  fn := NormalPath(DirWorkPath) + ASrcFr3FileName;
  fnPdf := ChangeFileExt(fn, '.pdf');
  if FileExists(fnPdf) then
    if not DeleteFile(fnPdf) then
      fnPdf := GetUniqueFileName(NormalPath(DirWorkPath), ExtractFileName(fnPdf));
  //
  frRep1:= TfrxReport.Create(Self);
  frxPDFExport1 := TfrxPDFExport.Create(Self);
  try
    frxPDFExport1.ShowDialog := false;
    frxPDFExport1.ShowProgress := false;
    frxPDFExport1.DefaultPath := NormalPath(DirWorkPath);
    frxPDFExport1.FileName := fnPdf;
    frxPDFExport1.EmbeddedFonts := True;
    //
    frRep1.LoadFromFile(fn);
    frRep1.DataSets.Clear;
    frRep1.DataSets.Add(frDbDsMaster);
    frRep1.DataSets.Add(frDbDsWork);
    frRep1.DataSets.Add(frDbDsWt1);
    frRep1.DataSets.Add(frDbDsWt2);
    frRep1.DataSets.Add(frDbDsWt3);
    frRep1.DataSets.Add(frDbDsWt4);
    frRep1.DataSets.Add(frDbDsWt5);
    frRep1.DataSets.Add(frDbDsWt6);
    frRep1.DataSets.Add(frDbDsWt7);
    frRep1.DataSets.Add(frDbDsWt8);
    frRep1.DataSets.Add(frDbDsWt9);
    frRep1.EnabledDataSets.Add(frDbDsMaster);
    frRep1.EnabledDataSets.Add(frDbDsWt1);
    frRep1.EnabledDataSets.Add(frDbDsWt2);
    frRep1.EnabledDataSets.Add(frDbDsWt3);
    frRep1.EnabledDataSets.Add(frDbDsWt4);
    frRep1.EnabledDataSets.Add(frDbDsWt5);
    frRep1.EnabledDataSets.Add(frDbDsWt6);
    frRep1.EnabledDataSets.Add(frDbDsWt7);
    frRep1.EnabledDataSets.Add(frDbDsWt8);
    frRep1.EnabledDataSets.Add(frDbDsWt9);
    frRep1.EnabledDataSets.Add(frDbDsWork);
    //
    if Gsl.Count > 0 then
      for i:=0 to GSl.Count - 1 do begin
        p := Pos('=', Gsl[i]);
        if p > 0 then begin
          variable := frRep1.Variables.Add;
          variable.Name := Copy(Gsl[i], 1, p-1);
          s := Replace('''', Copy(Gsl[i], p+1, cMaxInt), '');
          if Pos(cCRLF, s) > 0 then
            variable.Value := s
          else
            variable.Value := ''''+s+'''';
        end;
      end;
    //osetruje chybu, ktera vznikala pri exportu fr3 sestavy (do pdf) u vlozeneho formulare
    //- chyba vznikla behem PrepareReport v pripade, ze byla mtValues hlavniho formular (faMain) rozeditovana,
    //  doslo totiz k Postu a tim se vyvolal calculate skriptu (hlavniho formulare),
    //  ale protoze jsme vlastne ve vlozenem formulari (ten je v GfaMain),
    //  tak nejsou k dispozici udaje hlavniho formulare (proto ta chyba)
    if faMain <> nil then
      if faMain.mtValues.State <> dsBrowse then
        faMain.mtValues.Cancel;
    //
    frRep1.PrepareReport(True);
    frRep1.Export(frxPDFExport1);
  finally
    frRep1.Free;
    frxPDFExport1.Free;
  end;

  SaveStringToFile('', ChangeFileExt(fnPdf, '.pds'));//vyrobime prazdny pds soubor se stejnym jmenem jako pdf soubor
  //
  Result := ExtractFileName(fnPdf);
end;


{-----------------------------------------------------------------------------
ConvertFR3ToPDF
  Prevede sestavu(y) ve FastReportu do PDF
  Prochazi AReportFileNameCsvList a pripadnou sestavu v FR3 prevede na PDF.
  Pokud se zadna FR3 sestave nevyskytuje, vraci puvodni seznam
-----------------------------------------------------------------------------}
function TfaMain.ConvertFR3ToPDF(const AReportFileNameCsvList: string): string;
var
  csvList, csvListNew: string;
  i: integer;
begin
  if Pos('.FR3', AnsiUpperCase(AReportFileNameCsvList)) > 0 then begin
    csvList := StrTrimCharRight(AReportFileNameCsvList, ',');
    csvListNew := '';
    for i := 0 to CountListItems(csvList) - 1 do begin
      if AnsiUpperCase(ExtractFileExt(GetListItem(csvList, i))) = '.FR3' then
        csvListNew := AddValueToList(csvListNew, ExportFR3ToPDF(GetListItem(csvList, i)))
      else
        csvListNew := AddValueToList(csvListNew, GetListItem(csvList, i));
    end;
  end
  else
    csvListNew := AReportFileNameCsvList;
  Result := csvListNew;
end;

