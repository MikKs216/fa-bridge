procedure TfaMain.FillTestValues(ANew: boolean);
var
  i, prec: integer;
  j: double;
  dat: TDateTime;
  y: integer;
  strIsInt: boolean;

  function GenerateRandomText(ALength: Integer; AGenNumber: boolean = False): string;
  const
    //Chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzÁČÉÍŇÓŘŠÝŽačéíňóřšýž';
    Chars = 'abcdefghijklmnopqrstuvwxyz';
    CharsN = '0123456789';
  var
    i: Integer;
    str: string;
  begin
    str := Chars;
    if AGenNumber then
      str := CharsN;
    //
    Randomize;
    Result := '';
    for i := 1 to ALength do
      Result := Result + str[Random(Length(str)) + 1];
  end;

begin
  with mtValues do begin
    if Active then begin
      if RecordCount = 0 then
        Append
      else
        Edit;
      j:=0.11;
      for i := 0 to Fields.Count - 1 do
        if FIsDesignMode or (Fields[i].AsString = '') then begin
          if Fields[i] is TStringField then begin
            if ANew and (mtFields.FindKey([UpperCase(Fields[i].FieldName)])) then begin
              strIsInt := (Pos('#', mtFieldsDisplayFormat.AsString) > 0);
              prec:=mtFieldsDataTypeLength.Value;
              if (prec = 0) then
                prec := 5;
              if strIsInt then
                Fields[i].Value := GenerateRandomText(prec, TRUE)
              else begin
                if (Pos('^', mtFieldsDisplayFormat.AsString) > 0) then
                  Fields[i].Value := AnsiUpperCase(GenerateRandomText(prec))
                else
                  Fields[i].Value := StringFirstUpperCase(GenerateRandomText(prec));
              end;
            end
            else
              Fields[i].Value := IntToStr(i + 1);
          end
          else if Fields[i] is TMemoField then begin
            if not FControlsNamesList.Find(Fields[i].FieldName+',TcxListBoxEx', y) then  //ListBox neplnime
              Fields[i].Value := IntToStr(i + 1) + #13#10+'memo';
          end
          else if Fields[i] is TFloatField then begin
            if mtFields.FindKey([UpperCase(Fields[i].FieldName)]) then
              prec:=mtFieldsDataTypeLength.Value
            else
              prec:=15;
            Fields[i].Value := RoundAri(i + 1 + j,-1*prec);
            j:=j + 0.01;
          end
          else if Fields[i] is TIntegerField then
            Fields[i].Value := i + 1
          else if Fields[i] is TDateField then begin
            dat:=Date;
            Fields[i].Value := dat + i + 1;
          end;
          {else if Fields[i] is TBooleanField then
            Fields[i].Value := TRUE;}
        end;
      Post;
    end;
  end;
end; {FillTestValues}

