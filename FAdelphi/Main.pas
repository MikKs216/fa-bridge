  try
    if ASaveWidth then 
      SavePaInfoWidth(iniFile);

    if (AShowInfo=false) and (AShowCheck=False) then begin
      paCheck.Visible := False;
      SplitterBottomM.Visible := False;
      paInfo.Visible := False;
      paBottom.Visible := False;
    end
    else if (AShowInfo=true) and (AShowCheck=true) then begin
      paInfoRightBevel.Width := 1;
      paBottom.Visible := True;
      SplitterBottomM.Visible := True;

      paInfo.Visible := False;
      paCheck.Visible := False;
      splitterBottom.Visible := False;
      paInfo.Align := alLeft;
      paCheck.Align := alClient;
      paInfo.Visible := True;
      splitterBottom.Visible := True;
      splitterBottom.Align := alRight;
      splitterBottom.Align := alLeft;
      paCheck.Visible := True;

      paInfo.Width := Max(150, Min(paBottom.Width-splitterBottom.Width-150,
        iniFile.ReadInteger(Name, 'PaInfoWidth', PaInfoDefaultWidth)));
    end
    else begin
      paBottom.Visible := True;
      SplitterBottomM.Visible := True;

      splitterBottom.Visible := false;
      paCheck.Visible := AShowCheck;
      paInfo.Visible := AShowInfo;
      paInfo.Align := alClient; //muzu vzdy pro jednoduchost
      paInfoRightBevel.Width := 3;
    end;

    if ((AShowInfo=true) or (AShowCheck=true)) and (paBottom.Height<=0) then begin
      paBottom.Height := cDefaultBottomPanelsHeight;
    end;

    UpdateMenuView;
  finally
    iniFile.Free;
  end;
end;

function TfaMain.DoSaveNewFormToDB: boolean;
var
  formID: integer;
  st, stSS: TMemoryStream;
  sl: TStringList;
  comment, period, s, dt, idDef, tskpGuid: string;
  periodFrom, periodTo: TDateTime;
  periodYear, tskpID: integer;
begin
{$IFDEF STANDALONE}
  Result := True;
{$ELSE STANDALONE}
  st := TMemoryStream.Create;
  sl := TStringList.Create;
  stSS := TMemoryStream.Create;
  try
    //
    reComment.SaveTextToStream('', st, 0, FALSE, FALSE);
    st.Seek(0, soFromBeginning);
    sl.LoadFromStream(st);
    if sl.Count > 0 then
      comment := sl[0]
    else
      comment := '';
    sl.Clear;
    st.Clear;
    //
    idDef := mtTskpDefID.Value;
    tskpID := mtTskpID.Value;
    tskpGuid := mtTskpGUID.Value;
    sl.Text := GetFormData;
    sl.SaveToStream(st);
    st.Seek(0, soFromBeginning);
    //
    s := GetPeriod;
    periodYear := StrToIntSafe(GetListItem(s, 0));
    periodFrom := StrToDateSafe(GetListItem(s, 1));
    periodTo := StrToDateSafe(GetListItem(s, 2));
    period := GetListItem(s, 3);
    //
    if Pos(' ',mtTskpFillingDate.Value)>0 then
      dt:=Copy(mtTskpFillingDate.Value,1,Pos(' ',mtTskpFillingDate.Value)-1)
    else
      dt:=mtTskpFillingDate.Value;
    //
    mtStoredStrings.SaveToStream(stSS);
    stSS.Seek(0, soFromBeginning);
  Result :=
    SaveFANewFormToDB(FClientID, tskpID, tskpGuid,
    idDef, st, FStateFormLocked, StrToDateSafe(mtTskpExpirationDate.Value),
    comment, GetSysComment, GetCharacteristics,
    mtTskpFillingNumber.AsString, period,
    periodFrom, periodTo, StrToDateSafe(dt), periodYear,
    mtTskpWorkState.AsInteger, 0, 0,
    False, stSS);
  finally
    stSS.Free;
    st.Free;
    sl.Free;
  end;
{$ENDIF STANDALONE}
end;

