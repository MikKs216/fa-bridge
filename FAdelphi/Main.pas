procedure TfaMain.MoveActuallyControl(AKey: Word);
var
  oldActuallyControl: TControl;
begin
  {TryPostMtValues;}
  if FActuallyControl <> nil then begin
    oldActuallyControl := FActuallyControl;
    case AKey of
      VK_RIGHT: FActuallyControl := GetNextControl(FActuallyControl);
      VK_LEFT: FActuallyControl := GetPreviousControl(FActuallyControl);
      VK_DOWN: FActuallyControl := GetDownControl(FActuallyControl);
      VK_UP: FActuallyControl := GetUpControl(FActuallyControl);
      VK_HOME: FActuallyControl := GetFirstControl;
      VK_END: FActuallyControl := GetLastControl;
    end;
    if oldActuallyControl <> FActuallyControl then
      FocusActuallyControl;
  end
  else
    FocusFirstControl;
end; {MoveActuallyControl}

//posune focus doprava nebo dolu podle vlastnosti NextDirection

procedure TfaMain.MoveToNextControl(ANextDirection: TNextDirection;
  const ANextField: string);
var
  oldActuallyControl: TControl;
begin
  {TryPostMtValues;}
  if ANextField <> '' then begin
    oldActuallyControl := FActuallyControl;
    FActuallyControl := GetControlByName(ANextField);
    if oldActuallyControl <> FActuallyControl then
      FocusActuallyControl;
  end
  else if FActuallyControl <> nil then begin
    oldActuallyControl := FActuallyControl;
    if ANextDirection = ndRight then begin
      FActuallyControl := GetNextControl(FActuallyControl);
    end
    else begin
      FActuallyControl := GetDownControl(FActuallyControl);
      if oldActuallyControl = FActuallyControl then
        FActuallyControl := GetFirstRightControl(FActuallyControl.Left +
          FActuallyControl.Width - 1);
    end;
    if oldActuallyControl <> FActuallyControl then
      FocusActuallyControl
    else if GetNextControl(FActuallyControl) = FActuallyControl then
      // kdyz je to
      FocusActuallyControl; //posledni udaj tak aktualizujeme
  end
  else
    FocusFirstControl;
end; {MoveActuallyControl}

procedure TfaMain.ApplyBkColor;
{const
  backColNew = $00C6E3F0;}
var
  bCol: TColor;
  isImageHigh: boolean;
begin
  isImageHigh:=(mtContentImageHeight.Value>0) or (FPDFBgFileName <> '');
  { if FNewStyle and not isImageHigh then // jinou barvu pozadi nemuzeme aplikovat, checkboxy s tim maji problem
    bCol:=clBtnFace //backColNew
  else}
  bCol:=clBtnFace;
  if mtDefBkColor.Value <> '' then
  try
    if GetDeviceCaps(Canvas.Handle, BITSPIXEL) > 8 then begin
      if FNewStyle and (StrToColor(mtDefBkColor.Value)=clBtnFace) and
        not isImageHigh then // v novem vzhledu zmenime default barvu pokud neni obrazek na pozadi
        sbBackground.Color := bCol
      else
        sbBackGround.Color := StrToColor(mtDefBkColor.Value);
      sbForm.Color := sbBackGround.Color;
      sbNotes.Color := sbBackGround.Color;
    end
    else begin
      sbBackground.Color := bCol; //StrToColor(mtDefBkColor256.Value);
      sbForm.Color := sbBackGround.Color;
      sbNotes.Color := sbBackGround.Color;
    end;
  except
    sbBackground.Color := bCol;
    sbForm.Color := sbBackGround.Color;
    sbNotes.Color := sbBackGround.Color;
  end
  else begin
    sbBackground.Color := bCol;
    sbForm.Color := sbBackGround.Color;
    sbNotes.Color := sbBackGround.Color;
  end;
end; {ApplyBkColor}

