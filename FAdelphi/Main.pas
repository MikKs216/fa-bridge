//test jestli neni nektere jmeno udaje pouzite na jine strane
//  vraci TRUE, pokud jsou nazvy udaju jedidnecne, jinak FALSE

function TfaMain.CheckUniqueFieldsDef(ASbForm: TScrollBox; out AEditName: string;
  out AContentKey: integer): boolean;
var
  i: integer;
  c: TControl;
begin
  StartWait;
  try
    Result := TRUE;
    for i := 0 to ASbForm.ControlCount - 1 do begin
      c := ASbForm.Controls[i];
      if (c is TfaEdit) or (c is TcxDBCheckBox) or
        (c is TcxDBMemo) or (c is TcxListBoxEx) then
        if mtFields.FindKey([UpperCase(c.Name)]) then
          {mtFields.Locate(mtFieldsName.FieldName, c.Name, //opt
          [loCaseInsensitive]) then}
          if (mtFieldsContentKey.Value <> mtContentKey.Value) then begin
            Result := FALSE;
            AEditName := c.Name;
            AContentKey := mtFieldsContentKey.Value;
            BREAK;
          end;
    end;
  finally
    StopWait;
  end;
end; {CheckUniqueFieldsDef}

//smazani zaznamu o strane z mtFields

procedure TfaMain.DeletePageFieldsDef;
begin
  with mtFields do begin
    First;
    while not EOF do begin
      if mtFieldsContentKey.Value = mtContentKey.Value then
        Delete
      else
        Next;
    end;
  end;
end; {DeletePageFieldsDef}

//ulozeni hodnot udaje do zaznamu taFields

procedure TfaMain.SetFieldsDef(AC: TControl);
begin
  if AC is TfaEdit then begin
    with TfaEdit(AC) do begin
      mtFieldsRepInfoPage.Value := RepPage;
      mtFieldsRepInfoPosX.Value := RepPosX;
      mtFieldsRepInfoPosY.Value := RepPosY;
      mtFieldsRepInfoFontSize.Value := RepFontSize;
      mtFieldsDisplayFormat.Value := DisplayFormat;
      mtFieldsInvertAlignment.Value := InvertAlignment;
      if RepAlignment = taRightJustify then
        mtFieldsRepInfoRightAlignment.Value := TRUE;
      //
      mtFieldsName.Value := UpperCase(TfaEdit(AC).Name);
      mtFieldsCaption.Value := TfaEdit(AC).Name;
      case FldType of
        fldtString: begin
            mtFieldsDataType.Value := cStringTypeValue;
            if FldTypeDecimalPlaces > 0 then
              mtFieldsDataTypeLength.Value := FldTypeDecimalPlaces;
            mtFieldsRepInfoLength.Value := RepLength;
          end;
        fldtNumber: begin
            mtFieldsDataType.Value := cNumericTypeValue;
            mtFieldsDataTypeLength.Value := FldTypeDecimalPlaces;
          end;
        fldtCurrency: begin
            mtFieldsDataType.Value := cCurrencyTypeValue;
            mtFieldsDataTypeLength.Value := FldTypeDecimalPlaces;
          end;
        fldtDate: begin
            mtFieldsDataType.Value := cDateTypeValue;
            mtFieldsRepInfoLength.Value := RepLength;
          end;
      end;
      mtFieldsContentKey.Value := mtContentKey.Value;
    end;
  end
  else if AC is TcxDBCheckBoxEx then begin
    mtFieldsName.Value := UpperCase(AC.Name);
    mtFieldsCaption.Value := AC.Name;
    mtFieldsDataType.Value := cBooleanTypeValue;
    mtFieldsContentKey.Value := mtContentKey.Value;
    with TcxDBCheckBoxEx(AC) do begin
      mtFieldsRepInfoPage.Value := RepPage;
      mtFieldsRepInfoPosX.Value := RepPosX;
      mtFieldsRepInfoPosY.Value := RepPosY;
      mtFieldsRepInfoFontSize.Value := RepFontSize;
      mtFieldsRepInfoTrueText.Value := RepTrueText;
      mtFieldsRepInfoFalseText.Value := RepFalseText;
    end;
  end
  else if AC is TcxDBMemoEx then begin
    mtFieldsName.Value := UpperCase(AC.Name);
    mtFieldsCaption.Value := AC.Name;
    mtFieldsDataType.Value := cMemoTypeValue;
    mtFieldsContentKey.Value := mtContentKey.Value;
    with TcxDBMemoEx(AC) do begin
      mtFieldsRepInfoPage.Value := RepPage;
      mtFieldsRepInfoPosX.Value := RepPosX;
      mtFieldsRepInfoPosY.Value := RepPosY;
      mtFieldsRepInfoFontSize.Value := RepFontSize;
    end;
  end
  else if AC is TcxListBoxEx then begin
    mtFieldsName.Value := UpperCase(AC.Name);
    mtFieldsCaption.Value := AC.Name;
    mtFieldsDataType.Value := cMemoTypeValue;
    mtFieldsContentKey.Value := mtContentKey.Value;
  end;
end; {SetFieldsDef}

//ulozeni udaju do taFields

procedure TfaMain.SavePageFieldsDef;
var
  i: integer;
  c: TControl;
begin
  DisconnectMtValues;
  DeletePageFieldsDef;
  //
  for i := 0 to sbForm.ControlCount - 1 do begin
    c := sbForm.Controls[i];
    if (c is TfaEdit) or (c is TcxDBCheckBox) or
      (c is TcxDBMemo) or (c is TcxListBoxEx)then begin
      if c.Name = '' then begin
        MessageErr(Caption, sMsgErrNoNameControl, [MBOK]);
        BREAK;
      end;
      if mtFields.FindKey([UpperCase(c.Name)]) then begin
        {mtFields.Locate(mtFieldsName.FieldName, c.Name,
        [loCaseInsensitive]) then begin}//opt
        mtFields.Edit;
        SetFieldsDef(c);
        mtFields.Post;
      end
      else begin
        mtFields.Append;
        mtFieldsIsCalculated.Value := FALSE;
        mtFieldsHasCalc.Value := FALSE;
        SetFieldsDef(c);
        mtFields.Post;
      end;
    end;
  end;
  //
  GenMtValues;
  ConnectMtValues;
end; {SavePageFieldsDef}

procedure TfaMain.SetReadOnlyControl(AC: TControl; AReadOnly: boolean;
  AColor: TColor = cDefaultCalcFldColor);
begin
  if AC is TfaEdit then begin
    with TfaEdit(AC) do begin
      if AReadOnly then begin
        Tag := 1;
        Color := AColor;
      end
      else begin
        Tag := 0;
        Color := clWindow;
      end;
    end;
  end
  else if AC is TcxDBCheckBoxEx then begin
    with TcxDBCheckBoxEx(AC) do begin
      Properties.ReadOnly := AReadOnly;
      if AReadOnly then begin
        Tag := 1;
        if Style.Font.Color = clWindowText then
          Style.Font.Color := clSilver;
        Style.BorderColor := clInactiveBorder;
      end
      else begin
        Tag := 0;
        if Style.Font.Color = clSilver then
          Style.Font.Color := clWindowText;
        Style.BorderColor := clHighlight;
      end;
    end;
  end
  else if AC is TcxDBMemoEx then begin
    with TcxDBMemoEx(AC) do begin
      if AReadOnly then begin
        Properties.ReadOnly := TRUE;
        Style.Color := AColor;
      end
      else begin
        Properties.ReadOnly := FALSE;
        Style.Color := clWindow;
      end;
    end;
  end;
end; {SetReadOnlyControl}

//nastaveni udaje jako vypocteneho
//  pri reset nastavuje natvrdo barvu pozadi na clWindows takze se neulozi
//  barva nastavena u editu

procedure TfaMain.SetCalcControl(AC: TControl; AReset: boolean);
begin
  SetReadOnlyControl(AC, not AReset);
end; {SetCalcControl}

