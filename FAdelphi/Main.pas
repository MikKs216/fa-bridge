procedure TfaMain.SetDefaultView;
var imgW,imgH: integer;
begin
  imgW:=0;
  imgH:=0;
  if mtContent.Active and (mtContent.RecordCount > 0) then begin
    imgW:=VarToInt(mtContent.Lookup(mtContentKey.FieldName,
    VarArrayOf([1]),mtContentImageWidth.FieldName));
    imgH:=VarToInt(mtContent.Lookup(mtContentKey.FieldName,
    VarArrayOf([1]),mtContentImageHeight.FieldName));
  end;
  if (imgH > 0) or (IsPaintBoxReadyForUse) then begin
    Width:=cDefaultWidthBgPicture;
    Height:=cDefaultHeightBgPicture;
  end
  else begin
    Width := cDefaultWidth;
    Height := cDefaultHeight;
  end;
  if FShowRibbon then
    Height:=Height+dxRibbon.Height-50;
  paLeft.Width := cDefaultPaLeftWidth;
  paComment.Height := cDefaultBottomPanelsHeight;
  paBottom.Height := cDefaultBottomPanelsHeight;
  paInfo.Width := PaInfoDefaultWidth;

  dxBarButtonViewInfo.Down := true;
  dxBarButtonViewCheck.Down := true;
  InitPaBottom(dxBarButtonViewInfo.Down, dxBarButtonViewCheck.Down);
  
  ZoomNormal;
end; {SetDefaultView}

procedure TfaMain.SetWindowDimension;
var imgW,imgH: integer;
begin
  imgW:=0;
  imgH:=0;
  if mtContent.Active and (mtContent.RecordCount > 0) then begin
    imgW:=VarToInt(mtContent.Lookup(mtContentKey.FieldName,
    VarArrayOf([1]),mtContentImageWidth.FieldName));
    imgH:=VarToInt(mtContent.Lookup(mtContentKey.FieldName,
    VarArrayOf([1]),mtContentImageHeight.FieldName));
  end;
  if ((imgW > 0) or (IsPaintBoxReadyForUse)) and (Width<cDefaultWidthBgPicture) then begin
    Width:=cDefaultWidthBgPicture;
    paLeft.Width := cDefaultPaLeftWidth;
    if Screen.Width < Width then begin
      Width:=Screen.Width;
      Left:=0;
    end;

    Height:=cDefaultHeightBgPicture;
    if FShowRibbon then
      Height:=Height+dxRibbon.Height-50;
    paComment.Height := cDefaultBottomPanelsHeight;
    paBottom.Height := cDefaultBottomPanelsHeight;
    if Screen.Height < Height then begin
      Height:=Screen.Height-29; //29 je dolni lista windows
      Top:=0;
    end;
  end;
end; {SetWindowDimension}

procedure TfaMain.ShowContentAsMinList;
var
  dxtFocused: boolean;
  isLoadingContent: boolean;
begin
  dxtFocused := cxTvContent.Focused;
  cxContent.Visible := TRUE;
  cxContentDBTableView1PageSecInfo.Visible := TRUE;
  cxContentDBTableView1Key.Visible := FALSE;
  cxContentDBTableView1Page.Visible := FALSE;
  cxContentDBTableView1Section.Visible := FALSE;
  cxContentDBTableView1PageCaption.Visible := FALSE;
  cxContentDBTableView1Caption.Visible := FALSE;
