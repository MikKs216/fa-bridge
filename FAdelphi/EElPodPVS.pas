procedure TfmElPodaniPVS.SaveFormStateToIni;
var iniFile: TRKSIniFile;

  function SettingsEpoPvsToLog: string;

    function BoolToStr(value: Boolean): string;
    begin
      if value then
        Result := '1'
      else
        Result := '0';
    end;

    function EscapeValue(const value: string): string;
    begin
      // Pokud øetìzec obsahuje èárku, teèku nebo dvojteèku, dej do uvozovek
      if (Pos(',', value) > 0) or (Pos('.', value) > 0) or (Pos(':', value) > 0) then
        Result := '"' + value + '"'
      else
        Result := value;
    end;

  var
    values: array[1..4] of string;
    i: Integer;
  begin
    try
      // Vytvoø pole hodnot v poøadí deklarace
      values[1] := BoolToStr(edProxyServer.Text <> '');
      values[2] := BoolToStr(edProxyPort.Text <> '');
      values[3] := BoolToStr(cxOpenSSLSendMode.Checked);
      values[4] := IntToStr(seServerTimeOut.Value);

      // Vytvoø výsledný øetìzec ve formátu 2xx:nn.hodnota,nn.hodnota,...
      Result := ':';
      for i := 1 to 4 do
      begin
        Result := Result + Format('%d.%s', [i, values[i]]);
        if i < 4 then
          Result := Result + ',';
      end;
    except
    end;
  end;

  function EncodePas(const AStr: string): string;
  var
    i: integer;
  begin
    Result := '';
    for i := 1 to Length(AStr) do begin
      Result := Result + Format('%.3d', [Ord(AStr[i]) * 2 + 11]);
    end
  end;
begin
  LogStat('e4:');
  LogStat('E4:' + SettingsEpoPvsToLog, true);

  if not GfaMain.CanWriteToIniFile then EXIT;
  iniFile := TRKSIniFile.Create(GfaMain.GetIniFileName);
  try
    iniFile.WriteInteger(Name, 'Left', Left);
    iniFile.WriteInteger(Name, 'Top', Top);
    iniFile.WriteString(Name, 'ProxyServer', edProxyServer.Text);
    iniFile.WriteString(Name, 'ProxyPort', edProxyPort.Text);
    iniFile.WriteString(Name, 'VarSym', edVarSym.Text);
    iniFile.WriteString(Name, 'UserID', edUserID.Text);
    iniFile.WriteString(Name, 'UserPX', EncodePas(edUserPassw.Text));
    iniFile.WriteBool(Name, 'Certificate', rbCertifikat.Checked);
    iniFile.WriteBool(Name, 'OpenSSLSendMode', cxOpenSSLSendMode.Checked);

    iniFile.WriteInteger(Name, 'ServerPVSTimeOut', seServerTimeOut.Value);
    if CbCertificates.Properties.Items.Count > 0 then
      iniFile.WriteString(Name, 'CertificateHash',
        CSSZModule.Certificates.GetCertificateThumbprint(
        CbCertificates.ItemIndex));
  finally
    iniFile.Free;
  end;
end;

procedure TfmElPodaniPVS.LoadFormStateFromIni;
var iniFile, iniFile1: TRKSIniFile;
  s, linksiniFileName, VSzastupce: string;
  l,t: integer;

  function DecodePas(const AStr: string): string;
  var
    i: integer;
  begin
    Result := '';
    for i := 0 to (Length(AStr) div 3) - 1 do begin
      Result := Result + Chr((StrToInt(Copy(AStr, i * 3 + 1, 3)) - 11) div 2);
    end
  end;
begin
  iniFile := TRKSIniFile.Create(GfaMain.GetIniFileName);
  linksiniFileName:=NormalPath(ExtractFilePath(Application.ExeName)) + 'specpar.ini';
  iniFile1 := TRKSIniFile.Create(linksiniFileName);
  try
    if Left=0 then
      Left := iniFile.ReadInteger(Name, 'Left', GfaMain.Left + 5);
    if Top=0 then
      Top := iniFile.ReadInteger(Name, 'Top', GfaMain.Top + 30);
    //CheckFormPosition(l,t,Width);
    //Left:=l;
    //Top:=t;

    edProxyServer.Text := iniFile.ReadString(Name, 'ProxyServer', '');
    edProxyPort.Text := iniFile.ReadString(Name, 'ProxyPort', '');
    seServerTimeOut.Value := iniFile.ReadInteger(Name, 'ServerPVSTimeOut', 90);
    rbCertifikat.Checked := iniFile.ReadBool(Name, 'Certificate', false);
    cxOpenSSLSendMode.Checked := iniFile.ReadBool(Name, 'OpenSSLSendMode', FALSE);

    FHash := iniFile.ReadString(Name, 'CertificateHash', '');

    if FileExists(linksiniFileName) then begin
      VSzastupce:=iniFile1.ReadString('CSSZEPO', 'VS', '');
      if VSzastupce<>'' then
        FVarSym:=VSzastupce;
    end;

    if FVarSym<>'' then //kdyz je zadan ve formulari, tak vezmeme a neresime nic jineho
      edVarSym.Text := FVarSym
    else begin
      if ClientParam('CSSAVarSymEmp') <> '' then
        edVarSym.Text := ClientParam('CSSAVarSymEmp')
      {$IFNDEF STANDALONE}
      ;
      {$ELSE STANDALONE}
      else
        edVarSym.Text := iniFile.ReadString(Name, 'VarSym', ''); // nenatahujeme prebiralo se to mezi klinty a to bylo spatne
      {$ENDIF STANDALONE}
    end;
    edUserID.Text := '';                                  //jmeno a heslo pro prihlaseni na socialku je jiz delsi dobu
    edUserPassw.Text := '';                               //z Nastaveni klienta odstraneno
    {if ClientParam('EPCSSZUsrId') <> '' then
      edUserID.Text := ClientParam('EPCSSZUsrId');
    else
      edUserID.Text := iniFile.ReadString(Name, 'UserID', '');}
    {if ClientParam('CSEPCSSZPswd') <> '' then
      edUserPassw.Text := ClientParam('CSEPCSSZPswd');
    else begin
      s := iniFile.ReadString(Name, 'UserPX', '');
      if s <> '' then
        edUserPassw.Text := DecodePas(s)
      else
        edUserPassw.Text := '';
    end;}
  finally
    iniFile.Free;
    iniFile1.Free;
  end;
end;

