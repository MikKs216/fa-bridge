procedure TfmElPodaniPVS.btSaveClick(Sender: TObject);
var
  doc: string;
begin
  if StartCounterZero then
    EXIT;

  if FileExists(NormalPath(GFaMain.DirWorkPath) + cElPodaniWorkFileName) then begin
    doc := LoadStringFromFile(NormalPath(GFaMain.DirWorkPath) +
      cElPodaniWorkFileName);
