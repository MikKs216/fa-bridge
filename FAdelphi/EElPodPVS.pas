//vraci true kdyz uzivatel skutecne odeslal pres DS
function SendPVSDSElFilling(const ADoc, AFormName: string): boolean;
var
  mailadr, err, doc, outfilename, comm: string;
  sl: TStringList;
  p: integer;
begin
  Result:=false;
  sl := TStringList.Create;
  try
    if StartCounterZero then
      EXIT;

    doc:=ADoc;
    p:=Pos('<?xml',doc);
    if p>0 then begin
      doc:=Copy(doc,p,maxint);
    end
    else begin
      MessageInfo('', 'Chybná struktura souboru el. podání podání pøes datovou schránku ÈSSZ. Zkuste aktualizovat formuláø nebo kontaktujte technickou podporu.' ,[MBOK]);
      EXIT;
    end;

    if GFaMain.mtTskpFillingState.Value = cFillingStateFilled then begin
      if MessageWarn('', 'Formuláø již byl elektronicky podán. ' +
        'Chcete jej nyní podat znovu?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;
    if (GFaMain.mtTskpFillingState.Value = cFillingStateSent) or
      (GFaMain.mtTskpFillingPassword.Value <> '') then begin
      if MessageWarn('', 'Formuláø již byl elektronicky odeslán. ' +
        'Chcete jej nyní podat znovu?',
        [MBYES, MBNO]) <> IDYES then
        EXIT;
    end;

    SaveStringToFile(doc,NormalPath(GFaMain.DirWorkPath) + cElPodaniPdpWorkFileName);
    sl.Text := NormalPath(GFaMain.DirWorkPath) + cElPodaniPdpWorkFileName;
    mailadr := '#IDDS#5ffu6xk#e-podání ÈSSZ (Èeská správa sociálního zabezpeèení)';

    comm := '';
    if GfaMain.mtValues.Active then begin
      comm := GetListItem(GfaMain.GetPeriod, 3) + ' ' + GfaMain.GetSysComment;
      if comm <> '' then
        comm := ', ' + comm;
    end;

    Result:=GfaMain.SendISDSOrEmail(mailadr,AFormName+comm,'',sl,TRUE,err,outfilename);
  finally
    sl.Free;
  end;
end; {SendPVSDSElFilling}

function ExportPVSElFilling(const ADoc: string; ASaveDialog: TSaveDialog;
  var OutFileName: string; AWithoutDialog: boolean = false): boolean;
var
  doc, fn: string;
  p: integer;
begin
  Result:=false;
  if StartCounterZero then
    EXIT;

  doc:=ADoc;
  p:=Pos('<?xml',doc);
  if p>0 then begin
    doc:=Copy(doc,p,maxint);
  end
  else begin
    MessageInfo('', 'Chybná struktura souboru el. podání podání pøes datovou schránku ÈSSZ. Zkuste aktualizovat formuláø nebo kontaktujte technickou podporu.' ,[MBOK]);
    EXIT;
  end;

  if GFaMain.mtTskpFillingState.Value = cFillingStateFilled then begin
    if MessageWarn('', 'Formuláø již byl elektronicky podán. ' +
      'Chcete jej nyní exportovat pro podání?',
      [MBYES, MBNO]) <> IDYES then
      EXIT;
  end;
  if (GFaMain.mtTskpFillingState.Value = cFillingStateSent) or
    (GFaMain.mtTskpFillingPassword.Value <> '') then begin
    if MessageWarn('', 'Formuláø již byl elektronicky odeslán. ' +
      'Chcete jej nyní exportovat pro podání?',
      [MBYES, MBNO]) <> IDYES then
      EXIT;
  end;

  with ASaveDialog do begin
    FileName := OutFileName;
    if GfaMain.FPdfPassword<>'' then begin
      DefaultExt := cCompressedZipDefaultExt;
      Filter := cZIPOpenSaveFilter;
      FileName := ExtractFilePath(FileName)+Copy(ExtractFileName(FileName),1,Length(ExtractFileName(FileName))-Length(ExtractFileExt(FileName)))+cAppDuverne+cCompressedZipDefaultExt;
    end
    else begin
      DefaultExt := cXMLDefaultExt;
      Filter := cXMLEPOpenSaveFilter;
    end;

    if AWithoutDialog or Execute then
      if not FileExists(FileName) or
        (MessageAsk('',
        Format(sMsgFileNotExistsAsk, [FileName]), [MBYES, MBNO]) = IDYES) then begin
          if GfaMain.FPdfPassword<>'' then begin
            fn:=GetUniqueFileName(GfaMain.DirWorkPath,ExtractFileName(ChangeFileExt(FileName,cXMLDefaultExt)));
            SaveStringToFile(doc, fn);
            if AWithoutDialog then
              FileName := GetUniqueFileName(GfaMain.DirWorkPath,ExtractFileName(FileName));
            ZipFile(fn,FileName,'',GfaMain.FPdfPassword);
            DeleteFile(fn);
            GfaMain.FPdfPassword:='';
          end
          else
            SaveStringToFile(doc, FileName);
          OutFileName:=FileName;
          Result:=True;
        end;
  end;
end; {ExportPVSElFilling}

// pripravi opis informaci do pdf a vrati jeho nazev
function TfmElPodaniPVS.SaveInfoToPDF(const AFileName: string = ''): string;
var
  fnrtf: string;
  st: TMemoryStream;
  resol: Integer;
begin
  StartWait;
  st := TMemoryStream.Create;
  try
    rvInfo.SaveRVFToStream(st, FALSE);
    st.Seek(0, soFromBeginning);
    RVReportHelper.RichView.LoadRVFFromStream(st);
    // nastaveni rozliseni
    resol:=GetDPIForPDFrender;
    gtPDFEngine.InputXRes:=resol;
    gtPDFEngine.InputYRes:=resol;
    //
    if AFileName<>'' then
      Result:=AFileName
    else
      Result := GetUniqueFileName(GfaMain.DirWorkPath, 'Informace o podání.pdf');
    gtPDFEngine.FileName := Result;
    gtRichViewInterface.RenderDocument(RVReportHelper);
    RVReportHelper.Clear;
  finally
    st.Free;
    StopWait;
  end;
end;

end.

