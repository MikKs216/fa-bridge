procedure OpenPVSElFilling(const ADoc: string; ATypPodani: string;
  AGovTalkClass: string; AEnvelopeType: string; AVarSym: string;
  ALeft: Integer; ATop: Integer);
begin
  fmElPodaniPVS:=TfmElPodaniPVS.Create(nil);
  try
    with fmElPodaniPVS do begin
      FDoc := ADoc;
      if ATypPodani<>'PVS' then
        SetTypPodaniParam(ATypPodani)
      else begin
        FTypPodani:=AGovTalkClass;
        FEtyp:=AEnvelopeType;
        FVarSym:=AVarSym;
      end;
      Left:=ALeft;
      Top:=ATop;
      ShowModal;
    end;
  finally
    fmElPodaniPVS.Free;
    fmElPodaniPVS := nil;
  end;
end; {OpenPVSElFilling}

//Nastavi parametry podani
procedure TfmElPodaniPVS.SetTypPodaniParam(ATypPodani:string);
begin

  if ATypPodani = cEFormTypRELDP then begin
     FTypPodani:=cGovTalkClassRELDP;
     FEtyp:=cEnvelopeTypeRELDP;
  end
  else if ATypPodani = cEFormTypPRIHL then begin
     FTypPodani:=cGovTalkClassPRIHL;
     FEtyp:=cEnvelopeTypePRIHL;
  end
  else if ATypPodani = cEFormTypONZ then begin
     FTypPodani:=cGovTalkClassONZ;
     FEtyp:=cEnvelopeTypeONZ;
  end
  else if ATypPodani = cEFormTypELDP09 then begin
     FTypPodani:=cGovTalkClassELDP09;
     FEtyp:=cEnvelopeTypeELDP09;
  end
  else if ATypPodani = cEFormTypOSVC then begin
     FTypPodani:=cGovTalkClassOSVC;
     FEtyp:=cEnvelopeTypeOSVC;
  end
  else if ATypPodani = cEFormTypOSVC08 then begin
     FTypPodani:=cGovTalkClassOSVC08;
     FEtyp:=cEnvelopeTypeOSVC08;
  end
  else if ATypPodani = cEFormTypPOSTP then begin
     FTypPodani:=cGovTalkClassPOSTP;
     FEtyp:=cEnvelopeTypePOSTP;
  end
  else if ATypPodani = cEFormTypJRF then begin
     FTypPodani:=cGovTalkClassJRF;
     FEtyp:=cEnvelopeTypeJRF;
  end
  else if ATypPodani = cEFormTypRZP then begin
     FTypPodani:=cGovTalkClassRZP;
     FEtyp:=cEnvelopeTypeRZP;
  end
  else if ATypPodani = cEFormTypPVPOJ then begin
     FTypPodani:=cGovTalkClassPVPOJ;
     FEtyp:=cEnvelopeTypePVPOJ;
  end
  else if ATypPodani = cEFormTypPVPOJ10 then begin
     FTypPodani:=cGovTalkClassPVPOJ;
     FEtyp:=cEnvelopeTypePVPOJ10;
  end
  else if ATypPodani = cEFormTypOSVC09 then begin
     FTypPodani:=cGovTalkClassOSVC08;
     FEtyp:=cEnvelopeTypeOSVC09;
  end
  else if ATypPodani = cEFormTypNEMPRI then begin
     FTypPodani:=cGovTalkClassNEMPRI;
     FEtyp:=cEnvelopeTypeNEMPRI;
  end
  else if ATypPodani = cEFormTypUSRCERTDP then begin
     FTypPodani:=cGovTalkClassRELDP;
     FEtyp:=cEnvelopeTypeUSRCERT;
  end
  else if ATypPodani = cEFormTypUSRCERTNP then begin
     FTypPodani:=cGovTalkClassONZ;
     FEtyp:=cEnvelopeTypeUSRCERT;
  end
  else begin
     FTypPodani:=cGovTalkClassRELDP;
     FEtyp:=cEnvelopeTypeRELDP;
  end

end;{SetTypPodaniParam}


