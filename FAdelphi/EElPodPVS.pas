function TfmElPodaniPVS.GetLocalErrMsg(const AErrNum, AErrText: string): string;
var
  s: string;
begin
  if IsInteger(AErrNum) then begin
    case StrToInt(AErrNum) of
      3001: begin
          s := 'Data nebyla pøijata z dùvodu: "' + AErrText + '"';
          Result := 'Chyba: ' + AErrNum + ' ' + s;
        end;
      1046: begin
          s :=
            'Chyba pøi autorizaci. Identifikaèní údaje nebyly akceptovány. Zkontrolujte a nastavte identifikaèní údaje podle registrace na ÈSSZ.';
          Result := 'Chyba: ' + AErrNum + ' ' + s;
        end;
    else
      Result := 'Chyba: ' + AErrNum + ' ' + AErrText;
    end;
  end
  else if (AErrNum = '') and (AErrText = '') then
    Result := ''
  else
    Result := 'Chyba: ' + AErrNum + ' ' + AErrText;
end;

function TfmElPodaniPVS.FormatErrMsgBody(AXMLMsg: string): string;
const
  cBody = 'Body';
  cErrorResponse = 'ErrorResponse';
  cApplication = 'Application';
  cError = 'Error';
  cNumber = 'Number';
  cText = 'Text';
var
  XMLDoc: TXMLDocument;
  node, node1: IXMLNode;
  i: integer;

begin
  Result := '';
  XMLDoc := TXMLDocument.Create(Self);
  try
    XMLDoc.XML.Text := AXMLMsg;
    XMLDoc.Active := TRUE;
    node := XMLDoc.DocumentElement;
    node := node.ChildNodes.FindNode(cBody);
    if node <> nil then begin
      node1 := nil;
      for i := 0 to node.ChildNodes.Count - 1 do
        if node.ChildNodes.Nodes[i].NodeName = cErrorResponse then
          node1 := node.ChildNodes.Nodes[i];
    end;
    node := node1;
    if node <> nil then begin
      node1 := nil;
      for i := 0 to node.ChildNodes.Count - 1 do
        if node.ChildNodes.Nodes[i].NodeName = cApplication then
          node1 := node.ChildNodes.Nodes[i];
    end;
    node := node1;
    if node <> nil then begin
      node1 := nil;
      for i := 0 to node.ChildNodes.Count - 1 do
        if node.ChildNodes.Nodes[i].NodeName = cError then
          node1 := node.ChildNodes.Nodes[i];
    end;
    node := node1;
    if node <> nil then begin
      node1 := nil;
      for i := 0 to node.ChildNodes.Count - 1 do
        if node.ChildNodes.Nodes[i].NodeName = cNumber then
          node1 := node.ChildNodes.Nodes[i];
      if node1 <> nil then
        Result := VarToStr(node1.NodeValue);
    end;
    if node <> nil then begin
      node1 := nil;
      for i := 0 to node.ChildNodes.Count - 1 do
        if node.ChildNodes.Nodes[i].NodeName = cText then
          node1 := node.ChildNodes.Nodes[i];
      if node1 <> nil then
        Result := Result + ' ' + VarToStr(node1.NodeValue);
    end;
  finally
    XMLDoc.Active := FALSE;
    XMLDoc.Free;
  end;


end;

function TfmElPodaniPVS.FormatDate(const ADateStr: string): string;
begin
  if Pos('-',ADateStr)>0 then
    Result := StrTrimCharLeft(Copy(ADateStr, 9, 2), '0') + DateSeparator +
      StrTrimCharLeft(Copy(ADateStr, 6, 2), '0') + DateSeparator +
      Copy(ADateStr, 1, 4) + ' ' + Copy(ADateStr, 12, 8)
    //2004-08-03T10:26:29
  else
    Result := StrTrimCharLeft(Copy(ADateStr, 7, 2), '0') + DateSeparator +
      StrTrimCharLeft(Copy(ADateStr, 5, 2), '0') + DateSeparator +
      Copy(ADateStr, 1, 4) + ' ' + Copy(ADateStr, 9, 8)
    //20040803
end;

// Zobrazeni detailu certifikatu na formular

procedure TfmElPodaniPVS.CerfificateComboDisplay;
var
  Cert: TCertificate;
begin
  if CbCertificates.Properties.Items.Count < 1 then begin
      // Pokud je combo box prazdny, nic se nezobrazuje
    LabelCertificate.Caption := '';
  end
  else begin
      // Nacteni certifikatu z combo boxu do promenne
    Cert :=
      TCertificate(CbCertificates.Properties.Items.Objects[CbCertificates.ItemIndex]);
      // Zobrazeni nekterych hodnot
    LabelCertificate.Caption :=
      'Sériové èíslo: ' + Cert.SerialNumber + #13#10 +
      'Subjekt: ' + Cert.SubjectFieldCommonName + #13#10 +
      'Organizace: '+ Cert.SubjectOrganization + #13#10 +
      'Vystavitel: ' + Cert.IssuerFieldCommonName + #13#10 +
      'Platnost od: ' + DateTimeToStr(Cert.ValidFromDate) + #13#10 +
      'Platnost do: ' + DateTimeToStr(Cert.ValidToDate) + #13#10;
  end;
end;

// Nacteni certifikatu do combo boxu

procedure TfmElPodaniPVS.CertificateComboLoad;
var
  CertCount: Integer;
  I, nSelect: Integer;
  org:string;
begin
  StartWait;
  try
    // Pocet certifikatu
    CertCount := CSSZModule.Certificates.Count;
    // Smazani hodnot
    CbCertificates.Clear;
    nSelect := 0;
    if CertCount > 0 then begin
        // Pokud existuji nejake certifikaty, povolit combo box
      CbCertificates.Enabled := TRUE;
        // Nacteni vsech certifikatu, obe Common Name jako text
      for I := 0 to CSSZModule.Certificates.Count - 1 do begin
        if CSSZModule.Certificates.Certificate(I).SubjectOrganization<>'' then
          org:=' - '+ CSSZModule.Certificates.Certificate(I).SubjectOrganization
        else
          org:='';

        CbCertificates.Properties.Items.AddObject(
          CSSZModule.Certificates.Certificate(I).SubjectFieldCommonName +org+ ' --- '
          +
          CSSZModule.Certificates.Certificate(I).IssuerFieldCommonName ,
          CSSZModule.Certificates.Certificate(I));
        if CSSZModule.Certificates.Certificate(I).Thumbprint = FHash then
          nSelect := I;
      end;
      // Nastaveni vyberu
      CbCertificates.ItemIndex := nSelect;
        // Zobrazeni prvniho certifikatu na formular
        //CerfificateComboDisplay;
    end
    else
      CbCertificates.Enabled := FALSE;
   //
    btShowCertificate.Enabled := CbCertificates.Properties.Items.Count > 0;
    btSend.Enabled := CertCount > 0;
    btAskState.Enabled := TRUE;
  finally
    btSave.Enabled := TRUE;
    StopWait;
  end;
end;

