# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf

# Delphi soubory - zachovat CRLF (BOM se nekonvertuje)
*.pas text eol=crlf
*.dfm text eol=crlf
*.dpr text eol=crlf

# Dokumentace - preferovat LF
*.md text eol=lf

# Binární soubory
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
